function _generate_bittersweet_completion {
  # _generate_bittersweet_completion OUTPUT_FILE
  #   Writes a #compdef file from BITTERSWEET_SUBCOMMANDS. Idempotent. Heredocs
  #   are quoted so every literal passes through verbatim.
  local output_file="${1}"
  local entry

  cat > "${output_file}" <<'EOF'
#compdef bittersweet

# Auto-generated by `bittersweet completions` — do not edit by hand.
# Source of truth: BITTERSWEET_SUBCOMMANDS in `bittersweet`.
# Drift between this file and the dispatch case statement is caught
# by `./test completions` and the .githooks/pre-commit hook.

local -a subcommands
subcommands=(
EOF

  for entry in "${BITTERSWEET_SUBCOMMANDS[@]}"; do
    printf "  '%s'\n" "${entry}" >> "${output_file}"
  done

  cat >> "${output_file}" <<'EOF'
)

_arguments -C \
  '1:subcommand:->subcmd'

case "${state}" in
  subcmd)
    _describe 'subcommand' subcommands
    ;;
esac
EOF
}


function _okf_concept_row {
  # _okf_concept_row FILE: echoes "type<TAB>title<TAB>filename<TAB>description"
  # from the YAML frontmatter; title falls back to the filename stem.
  local file="${1}"
  local name="${file##*/}"
  local type="" title="" desc="" line key val
  local -i fence=0
  while IFS= read -r line; do
    if [[ "${line}" == "---" ]]; then
      (( ++fence >= 2 )) && break
      continue
    fi
    (( fence == 1 )) || continue
    key="${line%%:*}"
    val="${line#*: }"
    val="${val##[\"\']}"
    val="${val%%[\"\']}"
    case "${key}" in
      type) type="${val}" ;;
      title) title="${val}" ;;
      description) desc="${val}" ;;
    esac
  done < "${file}"
  [[ -n "${title}" ]] || title="${name%.md}"
  printf '%s\t%s\t%s\t%s' "${type}" "${title}" "${name}" "${desc}"
}


function _generate_okf_index {
  # _generate_okf_index OUTPUT_FILE
  #   Regenerates the internals/ OKF bundle index.md: concepts grouped by
  #   `type` (alphabetical), each group by title (case-insensitive). The
  #   frontmatter is the source of truth; `./test okf` enforces freshness.
  local output_file="${1}"
  local bundle="${SCRIPT_DIR}/internals"
  local file name t rtitle rname rdesc
  local -a rows=()

  for file in "${bundle}"/*.md; do
    [[ -f "${file}" ]] || continue
    name="${file##*/}"
    [[ "${name}" == "index.md" || "${name}" == "log.md" ]] && continue
    rows+=("$(_okf_concept_row "${file}")")
  done

  cat > "${output_file}" <<'EOF'
---
okf_version: "0.1"
---

Internals knowledge bundle for the dotfiles repo, in Open Knowledge Format
([OKF v0.1](https://github.com/GoogleCloudPlatform/knowledge-catalog/blob/main/okf/SPEC.md)).
Each concept is one markdown file with YAML frontmatter; this index is the
progressive-disclosure entry point. Grouped by `type`.
EOF

  (( ${#rows[@]} )) || return 0

  while IFS= read -r t; do
    printf '\n# %s\n\n' "${t}" >> "${output_file}"
    printf '%s\n' "${rows[@]}" \
      | /usr/bin/awk -F'\t' -v t="${t}" '$1 == t' \
      | /usr/bin/sort -f -t$'\t' -k2 \
      | while IFS=$'\t' read -r _ rtitle rname rdesc; do
          if [[ -n "${rdesc}" ]]; then
            printf '* [%s](%s) - %s\n' "${rtitle}" "${rname}" "${rdesc}" >> "${output_file}"
          else
            printf '* [%s](%s)\n' "${rtitle}" "${rname}" >> "${output_file}"
          fi
        done
  done < <(printf '%s\n' "${rows[@]}" | /usr/bin/cut -f1 | /usr/bin/sort -u)
}


