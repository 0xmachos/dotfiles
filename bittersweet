### Dotfile Helpers ###
# Helpers for install_dotfiles; print only on failure. The counters
# (_dir_count, _link_count, ...) are declared there (zsh dynamic scope).

function _ensure_dir {
  local dir=${1:?dir not passed to _ensure_dir}
  local mode=${2:-}

  if mkdir -p "${dir}"; then
    (( _dir_count += 1 ))
    [[ -n "${mode}" ]] && chmod "${mode}" "${dir}"
  else
    echo "[❌] Failed to create ${dir}"
    (( _error_count += 1 ))
  fi
}

function _symlink {
  local src=${1:?src not passed to _symlink}
  local dest=${2:?dest not passed to _symlink}

  if [[ ! -e "${src}" ]]; then
    echo "[❌] Source missing: ${src}"
    (( _error_count += 1 ))
    return 0
  fi

  # ln -sfn onto a real directory links *inside* it and exits 0.
  if [[ -d "${dest}" && ! -L "${dest}" ]]; then
    echo "[❌] Cannot symlink ${dest##*/}: real directory exists (remove it first)"
    (( _error_count += 1 ))
    return 0
  fi

  if ln -sfn "${src}" "${dest}"; then
    (( _link_count += 1 ))
  else
    echo "[❌] Failed to link ${src} to ${dest}"
    (( _error_count += 1 ))
  fi
}

function _harden {
  local file=${1:?file not passed to _harden}

  if [[ ! -e "${file}" ]]; then
    echo "[❌] Cannot harden (missing): ${file##*/}"
    (( _error_count += 1 ))
    return 0
  fi

  local mode=600
  [[ -d "${file}" ]] && mode=700

  if chmod "${mode}" "${file}"; then
    (( _harden_count += 1 ))
  else
    echo "[❌] Failed to harden permissions on ${file##*/}"
    (( _error_count += 1 ))
  fi
}

function _install_git_exclude {
  # Merge the gitignored .extra_gitexclude into info/exclude so private
  # filenames are ignored per-clone without entering the tracked, public
  # .gitignore. Idempotent: a marker-delimited block is rewritten each run;
  # entries outside the markers (e.g. Claude Code's own) are preserved.
  local extra="${SCRIPT_DIR}/.extra_gitexclude"
  [[ -f "${extra}" ]] || return 0

  # Via git, so worktrees and --separate-git-dir clones (.git is a file) work.
  local exclude
  if ! exclude="$(git -C "${SCRIPT_DIR}" rev-parse --git-path info/exclude 2>/dev/null)"; then
    echo "[❌] Not a git repo: cannot resolve info/exclude"
    (( _error_count += 1 ))
    return 0
  fi
  [[ "${exclude}" == /* ]] || exclude="${SCRIPT_DIR}/${exclude}"
  local info_dir="${exclude%/*}"
  mkdir -p "${info_dir}"

  local begin="# >>> bittersweet private excludes (from .extra_gitexclude) — do not edit >>>"
  local end="# <<< bittersweet private excludes <<<"
  local tmp
  # Temp file inside info/ keeps the final mv on one filesystem (atomic).
  tmp="$(mktemp "${info_dir}/.exclude.XXXXXX")" || { (( _error_count += 1 )); return 0; }

  if [[ -f "${exclude}" ]]; then
    awk -v b="${begin}" -v e="${end}" '
      $0 == b { skip=1; next }
      $0 == e { skip=0; next }
      !skip   { print }
    ' "${exclude}" > "${tmp}"
  fi

  # Comments and blanks stripped; `|| true` so an empty list does not trip -e.
  {
    printf '%s\n' "${begin}"
    grep -vE '^[[:space:]]*(#|$)' "${extra}" || true
    printf '%s\n' "${end}"
  } >> "${tmp}"

  if mv "${tmp}" "${exclude}"; then
    echo "[✅] Synced .extra_gitexclude → ${exclude#"${SCRIPT_DIR}"/} (private, untracked)"
  else
    echo "[❌] Failed to write ${exclude}"
    (( _error_count += 1 ))
    rm -f "${tmp}"
  fi
}

### END Dotfile Helpers ###


function install_dotfiles {
  # Creates directories in $HOME and symlinks the repo's configs into them:
  # zsh, git, ssh, Claude Code, Codex, VirusTotal, uv, npm, 1Password, Ghostty,
  # Xcode.

  local _dir_count=0
  local _link_count=0
  local _harden_count=0
  local _error_count=0
  # null_glob (function-scoped): claude/ is gitignored and synced out of band,
  # so hosts/, skills/, rules/ and agents/ can be empty on a fresh clone, and
  # an unmatched glob would abort the deploy under set -e. setopt, not (N)
  # qualifiers: shellcheck --shell=bash cannot parse them. Set before the
  # arrays so their globs see it.
  setopt local_options null_glob

  local -ar dot_dirs=(.ssh .extra .codex .codex/rules .config/git .config/uv .config/herdr .claude .claude/skills .claude/rules .claude/agents)
  local -ar dot_files=(.zshrc .functions .completions .aliases)
  local -ar ssh_configs=(config .extra_ssh)
  local -ar git_configs=(config ignore allowed_signers)
  local -ar claude_files=(
    "claude/settings.json:settings.json"
    "claude/statusline-command:statusline-command"
    "claude/subagent-statusline:subagent-statusline"
    "claude/global-claude.md:CLAUDE.md"
    "claude/lint-hook:lint-hook"
    "claude/rm-redirect-hook:rm-redirect-hook"
    "claude/ssh-redirect-hook:ssh-redirect-hook"
    "claude/sudo-askpass-hook:sudo-askpass-hook"
    "claude/git-sign-hook:git-sign-hook"
    "claude/container-tmp-hook:container-tmp-hook"
    "claude/md5-guard-hook:md5-guard-hook"
    "claude/md5-write-hook:md5-write-hook"
    "claude/tmp-guard-hook:tmp-guard-hook"
    "claude/fetch-route-hook:fetch-route-hook"
    "claude/muse-exec-hook:muse-exec-hook"
    "claude/gh-publish-hook:gh-publish-hook"
    "claude/git-bypass-hook:git-bypass-hook"
    "claude/session-host-context:session-host-context"
    "claude/hosts:hosts"
    "claude/output-styles:output-styles"
  )
  local -ar sensitive_files=(
    "${SCRIPT_DIR}/.ssh/config"
    "${SCRIPT_DIR}/.ssh/.extra_ssh"
    "${SCRIPT_DIR}/.config/git/config"
    "${SCRIPT_DIR}/.config/git/ignore"
    "${SCRIPT_DIR}/.config/git/allowed_signers"
    "${SCRIPT_DIR}/.functions"
    "${SCRIPT_DIR}/.completions"
    "${SCRIPT_DIR}/.zshrc"
    "${SCRIPT_DIR}/.aliases"
    "${SCRIPT_DIR}/claude/settings.json"
    "${SCRIPT_DIR}/claude/global-claude.md"
    "${SCRIPT_DIR}/.config/1Password/ssh/agent.toml"
    "${SCRIPT_DIR}/.codex/config.toml"
    "${SCRIPT_DIR}/.codex/rules/default.rules"
    "${SCRIPT_DIR}/.codex/hooks.json"
    # Per-host rules files are named after private machines: a glob, never
    # literal names.
    "${SCRIPT_DIR}"/claude/hosts/*.md
  )

  local dot_dir dot_file ssh_config git_config claude_file sensitive_file
  local src dest

  for dot_dir in "${dot_dirs[@]}"; do
    _ensure_dir "${HOME}/${dot_dir}"
  done

  _ensure_dir "${HOME}/.ssh/sockets" 700

  for dot_file in "${dot_files[@]}"; do
    _symlink "${SCRIPT_DIR}/${dot_file}" "${HOME}/${dot_file}"
  done

  for ssh_config in "${ssh_configs[@]}"; do
    _symlink "${SCRIPT_DIR}/.ssh/${ssh_config}" "${HOME}/.ssh/${ssh_config}"
  done

  for git_config in "${git_configs[@]}"; do
    _symlink "${SCRIPT_DIR}/.config/git/${git_config}" "${HOME}/.config/git/${git_config}"
  done

  # The global pre-commit scanner needs no install step: core.hooksPath in
  # .config/git/config points at the repo's .config/git/hooks/, so the config
  # symlink activates it and a sync delivers hook + config atomically. Warn if
  # the per-clone PII pattern list is absent: the denylist silently loses
  # coverage.
  if [[ ! -s "${SCRIPT_DIR}/.githooks/pii-patterns" ]]; then
    echo "[⚠️ ] .githooks/pii-patterns missing or empty — PII denylist has no patterns (sync it from another clone)"
  fi

  _symlink "${SCRIPT_DIR}/.config/uv/uv.toml" "${HOME}/.config/uv/uv.toml"

  # herdr: link config.toml only, never the directory (herdr keeps its socket,
  # session state, machine identity and push registries beside it). herdr's own
  # writes go through the link (std::fs::write; the integration installer
  # resolves symlinks first — verified from source 2026-09-29). The binary is
  # installer-managed at ~/.local/bin/herdr (the fork's installer only writes
  # under $HOME).
  _symlink "${SCRIPT_DIR}/.config/herdr/config.toml" "${HOME}/.config/herdr/config.toml"

  # npm hardcodes ~/.npmrc
  _symlink "${SCRIPT_DIR}/.config/npm/.npmrc" "${HOME}/.npmrc"

  _symlink "${SCRIPT_DIR}/.codex/config.toml" "${HOME}/.codex/config.toml"

  # Codex reads ~/.codex/rules/*.rules as its own layer, apart from config.toml;
  # its `forbidden` prefix_rules are the only SSH guard that survives
  # --dangerously-bypass-approvals-and-sandbox.
  _symlink "${SCRIPT_DIR}/.codex/rules/default.rules" "${HOME}/.codex/rules/default.rules"

  # Global agent instructions: ONE source file, two symlinks. Claude Code reads
  # ~/.claude/CLAUDE.md (claude_files below), Codex ~/.codex/AGENTS.md; Muse
  # Code takes the first of ~/.claude/CLAUDE.md, then $CODEX_HOME/AGENTS.md, so
  # it never loads the Codex one while the Claude one exists (verified
  # 2026-09-06, Muse 1.0.3-R2198.1). Gitignored, so it may name hosts and
  # aliases. Keep under 32768 B: Codex truncates a project doc silently there.
  _symlink "${SCRIPT_DIR}/claude/global-claude.md" "${HOME}/.codex/AGENTS.md"

  # Copied, not linked: 1Password doesn't follow symlinks.
  _ensure_dir "${HOME}/.config/1Password/ssh"
  cp "${SCRIPT_DIR}/.config/1Password/ssh/agent.toml" "${HOME}/.config/1Password/ssh/agent.toml"
  chmod 600 "${HOME}/.config/1Password/ssh/agent.toml"

  for claude_file in "${claude_files[@]}"; do
    src="${claude_file%%:*}"
    dest="${claude_file##*:}"
    _symlink "${SCRIPT_DIR}/${src}" "${HOME}/.claude/${dest}"
  done

  local skill_dir skill_name
  for skill_dir in "${SCRIPT_DIR}"/claude/skills/*/; do
    skill_name="${skill_dir%/}"
    skill_name="${skill_name##*/}"
    _symlink "${skill_dir%/}" "${HOME}/.claude/skills/${skill_name}"
  done

  local rule_file rule_name
  for rule_file in "${SCRIPT_DIR}"/claude/rules/*.md; do
    [[ -f "${rule_file}" ]] || continue
    rule_name="${rule_file##*/}"
    _symlink "${rule_file}" "${HOME}/.claude/rules/${rule_name}"
  done

  # Per-file rather than a claude_files entry so agents sync independently.
  local agent_file agent_name
  for agent_file in "${SCRIPT_DIR}"/claude/agents/*.md; do
    [[ -f "${agent_file}" ]] || continue
    agent_name="${agent_file##*/}"
    _symlink "${agent_file}" "${HOME}/.claude/agents/${agent_name}"
  done

  # API wrappers go in ~/.local/bin/, ahead of /opt/homebrew/bin on PATH, so
  # they shadow Homebrew binaries and inject 1Password keys; that shadowing is
  # load-bearing for vt/urlscan/op-homelab. bao-mcp-env shadows nothing (every
  # consumer hardcodes its absolute path or resolves the bare name for
  # cross-machine portability), so install_scripts's bin_files owns it, in
  # /usr/local/bin (2026-09-18).
  _ensure_dir "${HOME}/.local/bin"
  local -ar op_wrapper_scripts=(vt urlscan op-homelab)
  local wrapper
  for wrapper in "${op_wrapper_scripts[@]}"; do
    _symlink "${SCRIPT_DIR}/bin/${wrapper}" "${HOME}/.local/bin/${wrapper}"
  done

  # install_scripts retires the old bao-mcp-env link only after its
  # replacement is installed; running dotfiles alone must preserve it.

  _ensure_dir "${HOME}/Library/Application Support/com.mitchellh.ghostty"
  _symlink "${SCRIPT_DIR}/config" "${HOME}/Library/Application Support/com.mitchellh.ghostty/config"

  _ensure_dir "${HOME}/Library/Developer/Xcode/UserData"
  _symlink "${SCRIPT_DIR}/IDETemplateMacros.plist" "${HOME}/Library/Developer/Xcode/UserData/IDETemplateMacros.plist"

  # Enable pre-commit secret scanning via gitleaks
  if git -C "${SCRIPT_DIR}" config --local core.hooksPath .githooks; then
    echo "[✅] Enabled .githooks/pre-commit (gitleaks secret scanning)"
  else
    echo "[❌] Failed to set core.hooksPath"
    (( _error_count += 1 ))
  fi

  _install_git_exclude

  # git clone sets 644; enforce 600 on sensitive files (chmod follows
  # symlinks, so source and linked paths are both covered)
  for sensitive_file in "${sensitive_files[@]}"; do
    _harden "${sensitive_file}"
  done

  echo "[✅] Dotfiles installed (${_link_count} symlinks, ${_dir_count} dirs, ${_harden_count} hardened)"
  if (( _error_count > 0 )); then
    echo "[⚠️] ${_error_count} operations failed (see above)"
  fi
}


function install_scripts {
  # Symlinks bin/ scripts into /usr/local/bin (creating it). launchd-invoked
  # scripts (jump-system, jump-user, scratch-sweep) are COPIED, not symlinked:
  # see the comment at each.

  local -ar bin_files=(dns mdview npm-audit-check claude-session-audit git-sign-unpushed bao-mcp-env)
  local -ar macos_script_bin_files=(c0design)
  
  if ! [[ -d "/usr/local/bin/" ]]; then 
    get_sudo "to create /usr/local/bin/"
    if sudo mkdir -m 755 -p "/usr/local/bin/"; then
      echo "[✅] Successfully created /usr/local/bin/"
    else
      echo "[❌] Failed to create /usr/local/bin/"
    fi
  fi

  get_sudo "to symlink scripts into /usr/local/bin/"
  
  # chmod -h after ln: umask 077 makes lrwx------, which blocks readlink(2) for
  # non-root (XNU checks KAUTH_VNODE_READ_DATA on symlinks despite symlink(7)).
  for bin_file in "${bin_files[@]}"; do
    if sudo ln -sfn "${SCRIPT_DIR}/bin/${bin_file}" "/usr/local/bin/${bin_file}"; then
      sudo chmod -h 755 "/usr/local/bin/${bin_file}"
      echo "[✅] Successfully linked ${bin_file} to /usr/local/bin/${bin_file}"
      if [[ "${bin_file}" == bao-mcp-env && -x "/usr/local/bin/${bin_file}" ]]; then
        _retire_bao_mcp_link "/usr/local/bin/${bin_file}"
      fi
    else
      echo "[❌] Failed to link ${bin_file} to /usr/local/bin/${bin_file}"
    fi
  done

  # Optional per-clone tools, one name per line in .extra_bin_files (gitignored
  # by .extra*, like .extra_test_suites for ./test): for a private tool that
  # must not be named in the tracked bin_files. Malformed names abort; a listed
  # file absent on this clone is reported, not fatal (pending sync).
  local extra_bin_registry="${SCRIPT_DIR}/.extra_bin_files" extra_bin
  if [[ -f "${extra_bin_registry}" ]]; then
    while IFS= read -r extra_bin || [[ -n "${extra_bin}" ]]; do
      [[ -z "${extra_bin}" || "${extra_bin}" == \#* ]] && continue
      if [[ ! "${extra_bin}" =~ ^[a-z0-9-]+$ ]]; then
        echo "[❌] .extra_bin_files: malformed tool name '${extra_bin}'"
        exit 1
      fi
      if [[ ! -f "${SCRIPT_DIR}/bin/${extra_bin}" ]]; then
        echo "[❌] .extra_bin_files: bin/${extra_bin} is absent on this clone (pending sync?)"
        continue
      fi
      if sudo ln -sfn "${SCRIPT_DIR}/bin/${extra_bin}" "/usr/local/bin/${extra_bin}"; then
        sudo chmod -h 755 "/usr/local/bin/${extra_bin}"
        echo "[✅] Successfully linked ${extra_bin} (per-clone) to /usr/local/bin/${extra_bin}"
      else
        echo "[❌] Failed to link ${extra_bin} to /usr/local/bin/${extra_bin}"
      fi
    done < "${extra_bin_registry}"
  fi

  # Copy jump-system as root-owned: the LaunchDaemon executes it, so it must not
  # be user-writable (a symlink would be a local privilege escalation).
  sudo rm -f "/usr/local/bin/jump-system"
  if sudo cp "${SCRIPT_DIR}/bin/jump-system" "/usr/local/bin/jump-system"; then
    sudo chown root:wheel "/usr/local/bin/jump-system"
    sudo chmod 700 "/usr/local/bin/jump-system"
    echo "[✅] Successfully installed jump-system to /usr/local/bin/jump-system (root:wheel 700)"
  else
    echo "[❌] Failed to install jump-system to /usr/local/bin/jump-system"
  fi

  # Copy jump-user rather than symlink: launchd cannot exec a program under
  # ~/Documents/ after a TCC grant reset (macOS 27) and fails with exit 127
  # before the script's first log line. Confirmed 2026-07-28 by controlled
  # probe. root:wheel 755 — the user's agent executes it, cannot modify it.
  sudo rm -f "/usr/local/bin/jump-user"
  if sudo cp "${SCRIPT_DIR}/bin/jump-user" "/usr/local/bin/jump-user"; then
    sudo chown root:wheel "/usr/local/bin/jump-user"
    sudo chmod 755 "/usr/local/bin/jump-user"
    echo "[✅] Successfully installed jump-user to /usr/local/bin/jump-user (root:wheel 755)"
  else
    echo "[❌] Failed to install jump-user to /usr/local/bin/jump-user"
  fi

  # Copy scratch-sweep rather than symlink, as for jump-user: its LaunchAgent
  # cannot exec a program that resolves under ~/Documents/.
  sudo rm -f "/usr/local/bin/scratch-sweep"
  if sudo cp "${SCRIPT_DIR}/bin/scratch-sweep" "/usr/local/bin/scratch-sweep"; then
    sudo chown root:wheel "/usr/local/bin/scratch-sweep"
    sudo chmod 755 "/usr/local/bin/scratch-sweep"
    echo "[✅] Successfully installed scratch-sweep to /usr/local/bin/scratch-sweep (root:wheel 755)"
  else
    echo "[❌] Failed to install scratch-sweep to /usr/local/bin/scratch-sweep"
  fi

  if sudo ln -sfn "${SCRIPT_DIR}/bittersweet" "/usr/local/bin"; then
    sudo chmod -h 755 "/usr/local/bin/bittersweet"
    echo "[✅] Successfully linked bittersweet to /usr/local/bin/bittersweet"
  else
    echo "[❌] Failed to link bittersweet to /usr/local/bin/bittersweet"
  fi

  for macos_script in "${macos_script_bin_files[@]}"; do
    if sudo ln -sfn "$HOME/Dev/macos-scripts/${macos_script}" "/usr/local/bin/${macos_script}"; then
      sudo chmod -h 755 "/usr/local/bin/${macos_script}"
      echo "[✅] Successfully linked ${macos_script} to /usr/local/bin/${macos_script}"
    else
      echo "[❌] Failed to link ${macos_script} to /usr/local/bin/${macos_script}"
    fi
  done
}


function enable_touchid_sudo {
  # Since macOS Sonoma (14.0) the setting persists OS updates in
  # /etc/pam.d/sudo_local. See: https://support.apple.com/en-us/HT213893
  # Warns if pam_tid is in /etc/pam.d/sudo (lost on update); creates
  # sudo_local if absent, then inserts the pam_tid line with ex.

  if grep -q 'pam_tid.so' "/etc/pam.d/sudo"; then
    logger -p user.warning -s "Enabling TouchID for sudo in /etc/pam.d/sudo does not persist across updates.\
                              See https://support.apple.com/en-us/HT213893"
  fi

  if [[ -e "/etc/pam.d/sudo_local" ]]; then
    if grep -q 'pam_tid.so' "/etc/pam.d/sudo_local"; then
      logger -p user.info -s "TouchID for sudo already enabled"
      return 0
    fi
  
  else

    get_sudo "to create /etc/pam.d/sudo_local"
    
    if sudo install -m "444" -g "wheel" -o "root" "/dev/null" "/etc/pam.d/sudo_local"; then
      # install from /dev/null: an empty, read-only, root:wheel file
      logger -p user.info -s "Created /etc/pam.d/sudo_local"
    else
      logger -p user.error -s "Failed to create /etc/pam.d/sudo_local"
      return 1
    fi

    if sudo ex -s -c '1i|auth       sufficient     pam_tid.so' -c x! -c x! "/etc/pam.d/sudo_local"; then
      # `x!` runs twice to get past the read-only file warning

      logger -p user.info -s "TouchID sudo Enabled"
      return 0
    else
      logger -p user.error -s "Failed to enable TouchID sudo"
      return 1
  fi
fi
}


