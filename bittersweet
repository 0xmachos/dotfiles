function install_herald {
  # Builds and installs the herald Bonjour/mDNS browser CLI, macOS companion to
  # the Herald iOS app (jessedc/herald-ios-bonjour-browser).
  #   Source: ~/Dev/herald-cli/HeraldCLI (Package.swift subdir)
  #   Destination: /usr/local/bin/herald, a root-owned COPY (2026-09-18): a
  #   symlink would point at a user-writable Swift build directory, the
  #   privilege-escalation shape jump-system/jump-user avoid (see
  #   install_scripts). rm -f + cp gives a fresh inode, which also sidesteps
  #   the per-inode signature-cache staleness the re-sign step exists for.
  # Cycle: clone if missing, fetch, fast-forward pull (refused if local
  # diverged), build, deploy, re-sign. The upstream commit range is logged
  # before each pull. No Sigstore/Homebrew attestation is available.

  local -r repo_url="https://github.com/jessedc/herald-ios-bonjour-browser.git"
  local -r src_dir="${HOME}/Dev/herald-cli"
  local -r pkg_dir="${src_dir}/HeraldCLI"
  local -r binary="/usr/local/bin/herald"
  local -r build_output="${pkg_dir}/.build/release/herald"

  if ! [[ -d "${src_dir}" ]]; then
    echo "[🍺] Cloning herald to ${src_dir}"
    if ! git clone --quiet "${repo_url}" "${src_dir}"; then
      echo "[❌] Failed to clone herald"
      return 1
    fi
    echo "[✅] Cloned herald at $(git -C "${src_dir}" rev-parse --short HEAD)"
  elif [[ -n "$(git -C "${src_dir}" status --porcelain)" ]]; then
    echo "[⚠️ ] Local uncommitted changes in ${src_dir} — skipping upstream sync"
  elif ! git -C "${src_dir}" fetch --quiet 2>/dev/null; then
    echo "[⚠️ ] git fetch failed (offline?) — building current checkout"
  else
    local ahead
    ahead="$(git -C "${src_dir}" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)"
    if [[ "${ahead}" -gt 0 ]]; then
      echo "[🍺] ${ahead} new commit(s) upstream:"
      git -C "${src_dir}" log --oneline 'HEAD..@{u}'
      if ! git -C "${src_dir}" pull --ff-only --quiet; then
        echo "[❌] git pull --ff-only failed — local branch may have diverged"
        return 1
      fi
      echo "[✅] Pulled to $(git -C "${src_dir}" rev-parse --short HEAD)"
    else
      echo "[✅] Already at upstream HEAD ($(git -C "${src_dir}" rev-parse --short HEAD))"
    fi
  fi

  if ! [[ -d "${pkg_dir}" ]]; then
    echo "[❌] herald package dir not found at ${pkg_dir}"
    return 1
  fi

  local head_sha
  head_sha="$(git -C "${src_dir}" rev-parse --short HEAD 2>/dev/null || echo 'unknown')"
  echo "[🍺] Building herald (source at ${head_sha})"

  if ! swift build --package-path "${pkg_dir}" -c release --quiet 2>&1; then
    echo "[❌] Failed to build herald"
    return 1
  fi

  echo "[✅] Successfully built herald"

  # Old ~/.local/bin symlink: PATH order could keep resolving a copy that no
  # longer tracks the source build.
  if [[ -L "${HOME}/.local/bin/herald" ]]; then
    rm -f "${HOME}/.local/bin/herald"
    echo "[✅] Removed stale ~/.local/bin/herald (now at /usr/local/bin, root-owned copy)"
  fi

  get_sudo "to install herald into /usr/local/bin"
  sudo mkdir -m 755 -p "/usr/local/bin"
  sudo rm -f "${binary}"
  if sudo cp "${build_output}" "${binary}"; then
    sudo chown root:wheel "${binary}"
    sudo chmod 755 "${binary}"
    echo "[✅] Installed herald to ${binary} (root:wheel 755)"
  else
    echo "[❌] Failed to install herald to ${binary}"
    return 1
  fi

  # Ad-hoc re-sign after each rebuild: the *kernel*, not Gatekeeper, caches
  # signature info per inode and does not flush it when the contents change, so
  # an overwritten binary can crash on next launch. Signs the deployed copy,
  # not the build output.
  if sudo codesign --sign - --force "${binary}" 2>/dev/null; then
    echo "[✅] Ad-hoc signed herald"
  else
    echo "[⚠️ ] codesign --sign - failed (non-fatal; binary remains usable)"
  fi
}


