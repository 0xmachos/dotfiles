#!/usr/bin/env zsh
# dotfiles/bittersweet

# Configures macOS just the way I like it

set -euo pipefail
umask 077

IFS=$'\n\t'
# Only newlines and tabs separate words
# See: http://redsymbol.net/articles/unofficial-bash-strict-mode/

readonly SCRIPT_DIR="${0:A:h}"
# Absolute script directory, independent of $PWD (:A resolves symlinks)

if [[ ! -f "${SCRIPT_DIR}/bittersweet" ]]; then
  echo "[❌] SCRIPT_DIR failed to resolve (got: ${SCRIPT_DIR})"
  echo "    zsh :A cannot follow symlinks with restricted permissions."
  echo "    Run directly from the repo: ~/dotfiles/bittersweet"
  exit 1
fi

### Define Colours ###

# tput without a terminal type (CI runner, non-tty ssh) exits 2 and, under -e,
# killed the script (2026-09-29): fall back to no colour.
if [[ -n "${TERM:-}" ]] && /usr/bin/tput sgr0 2>/dev/null; then
  RESET=$(/usr/bin/tput sgr0)
  BOLD=$(/usr/bin/tput bold)
  RED=$(/usr/bin/tput setaf 1)
else
  RESET=''
  BOLD=''
  RED=''
fi
readonly RESET BOLD RED

### END Colours ###


### Subcommand Source of Truth ###
# Ordered `subcommand:description` pairs in `_describe` format; the order is
# kept in usage() and in completions. Feeds usage(),
# _generate_bittersweet_completion (.completions/_bittersweet) and the
# tests/completions parity check. A new subcommand needs an entry here AND a
# dispatch arm at the bottom of main(); tests/completions enforces both.
#
# shellcheck disable=SC2016
# Descriptions contain a literal `$HOME` (documentation, not a reference).
typeset -ra BITTERSWEET_SUBCOMMANDS=(
  'defaults:Write new system and application default settings'
  'dotfiles:Symlink various config files into $HOME'
  'scripts:Symlink scripts in bin into /usr/local/bin'
  'sudotouch:Enable TouchID to sudo'
  'secretive:Install Secretive'
  'sublimetext:Install Sublime Text'
  'tower:Install Tower'
  'deckset:Install Deckset'
  'maccy:Install Maccy'
  'texpad:Install Texpad (Texifier) and BasicTeX'
  'basictex:Install MacTeX BasicTeX Distribution'
  'latex:Install LaTeX packages via tlmgr'
  'blockblock:Install BlockBlock'
  'oversight:Install OverSight'
  'herald:Build and install herald (Bonjour/mDNS browser for Matter/Thread debugging)'
  'claude:Install Claude Code'
  'brew:Install Homebrew'
  'brewfile:Install Homebrew packages from Brewfile'
  'compinit:Fix permissions on zsh completion directory'
  'mdmprofile:Open System Preferences to install MDM Profile'
  'launchagents:Install and load LaunchAgents and LaunchDaemon'
  'completions:Regenerate .completions/_bittersweet from BITTERSWEET_SUBCOMMANDS'
  'okf-index:Regenerate internals/index.md from OKF concept frontmatter'
  'test:Run test suite'
  'hailmary:Run every function in order'
)
### END Subcommand SOT ###

# One list drives both install_launchagents (copy) and load_launchagents;
# tests exercise both consumers.
typeset -ra LAUNCHAGENT_PLISTS=(
  com.0xmachos.jump-user
  com.0xmachos.imageio-oop
  com.0xmachos.retrieval-metrics
  com.0xmachos.container-start
  com.0xmachos.scratch-sweep
)

# shellcheck source=lib/zsh-sidebar disable=SC1091
source "${SCRIPT_DIR}/lib/zsh-sidebar"


function usage {

  echo -e "\\nConfigures macOS just the way I like it 🤓\\n"
  echo "Usage:"

  local entry name desc
  for entry in "${BITTERSWEET_SUBCOMMANDS[@]}"; do
    name="${entry%%:*}"
    desc="${entry#*:}"
    if [[ "${name}" == "hailmary" ]]; then
      echo -e "\\n  ${RED}${name}${RESET}              - ${BOLD}${desc}${RESET}"
    else
      printf '  %-22s- %s\n' "${name}" "${desc}"
    fi
  done

  exit 0
}


### Utility Functions ###


function check_os_compatibility {
  # Exits unless Darwin; only warns on a different major macOS version.

  local os
  local current_macos_version
  local -r supported_major_macos_version="27"
  local -r supported_macos_name="Golden Gate"
  os="$(uname -s)"

  if [[ "${os}" != "Darwin" ]]; then 
    echo "[❌] This script was written for macOS"
    exit 1
  fi
  
  current_macos_version="$(sw_vers -productVersion | awk -F '.' '{print $1}')";
  
  if [[ "${current_macos_version}" != "${supported_major_macos_version}" ]]; then
    echo "[⚠️ ] This script was written for macOS ${supported_macos_name} (${supported_major_macos_version})"
    sleep 3
  fi 
}


function check_developer_tools {
  if ! xcode-select -p >/dev/null 2>&1; then 
    echo "[❌] Command line developer tools required"
    echo "[🍺] Install via: xcode-select --install"
    exit 1
  fi
}


function download_application {
  # download_application DOWNLOAD_PATH URL (curl, follows redirects)

  local download_path=${1:?download_path not passed to download_application}
  local url=${2:?url not passed to download_application}
  local file_name
  file_name=$(awk -F '/' '{print $(NF)}' <<< "${download_path}")

  echo "[🍺] Downloading ${file_name}"
  
  if curl --location --silent "${url}" --output "${download_path}"; then 
    echo "[✅] Successfully downloaded ${file_name}"
  else
    echo "[❌] Failed to download ${file_name}"
    return 1
  fi
}


function verify_signature {
  # verify_signature FILE_PATH APPLICATION_NAME (a .app or .pkg; e.g. Maccy)
  #   Check that .app and .pkg files are signed, if not hard exit
  #   Check that .app and .pkg files are notarised, if not print warning

  local file_path=${1:?file_path not passed to verify_signature}
  local application_name=${2:?application_name not passed to verify_signature}

  if [[ "${file_path}" =~ \.pkg$ ]]; then

    local package_name
    package_name="$(basename "${file_path}")"

    echo "[🍺] Attempting to validated the signature on ${package_name}"
    
    if /usr/sbin/pkgutil --check-signature "${file_path}" >/dev/null; then 
      echo "[✅] Successfully validated the signaturee on ${package_name}"
    else
      echo "[❌] Failed to validate the signature on ${package_name}"
      exit 1
    fi

    if /usr/sbin/spctl --assess --type install "${file_path}"; then
      echo "[✅] ${package_name} is notarised"
      return 0
    else
      echo "[❌] ${package_name} is NOT notarised"
      exit 1
    fi
  fi


  if [[ "${file_path}" =~ \.app$ ]]; then

    echo "[🍺] Attempting to validated the signature on ${application_name}.app"

    if /usr/bin/codesign --verify --deep --strict "${file_path}"; then
      echo "[✅] Successfully validated the signaturee on ${application_name}.app"
    else
      echo "[❌] Failed to validate the signature on ${application_name}.app"
      exit 1
    fi

    if /usr/sbin/spctl --assess --type execute "${file_path}"; then
      echo "[✅] ${application_name}.app is notarised"
      return 0
    else
      echo "[❌] ${application_name}.app is NOT notarised"
      exit 1
    fi

  else
    echo "[❌] ${file_path} is not a .app or .pkg file"
    exit 1
  fi
}


function install_application {
  # Installs apps packaged as .dmg or .zip, not .pkg installers; verifies the
  # .app signature before installing.

  local application_name=${1:?application_name not passed}
  local downloaded_file_path=${2:?downloaded_file_path not passed}
  local downloaded_file_name
  local dmg_mount_path
  downloaded_file_name="$(awk -F '/' '{print $NF}' <<< "${downloaded_file_path}")"


  if file "${downloaded_file_path}" | grep --quiet 'Zip'; then

    echo "[🍺] Attempting to unzip ${downloaded_file_name}"
    if ditto -x -k "${downloaded_file_path}" "${HOME}/Downloads"; then
      echo "[✅] Successfully unzipped ${downloaded_file_name}"
    else
      echo "[❌] Failed to unzip ${downloaded_file_name}"
      exit 1
    fi

    verify_signature "${HOME}/Downloads/${application_name}.app" "${application_name}"

    echo "[🍺] Attempting to copy ${application_name}.app into /Applications"
    if cp -Ri "${HOME}/Downloads/${application_name}.app" "/Applications"; then
      echo "[✅] Successfully installed ${application_name}"
    else
      echo "[❌] Failed to install ${application_name}"
      exit 1
    fi

    echo "[🍺] Deleting ${downloaded_file_path}"
    rm "${downloaded_file_path:?}"

    echo "[🍺] Deleting ${HOME}/Downloads/${application_name}.app"
    rm -r "${HOME:?}/Downloads/${application_name:?}.app"


  elif file "${downloaded_file_path}" | grep --quiet 'dmg'; then
    
    echo "[🍺] Attempting to mount ${downloaded_file_path}"
    dmg_mount_path="$(hdiutil attach -nobrowse "${downloaded_file_path}" | grep -o '/Volumes/.*')"

    if [[ -z "${dmg_mount_path}" ]]; then
      echo "[❌] Failed to mount ${downloaded_file_path}"
      exit 1
    fi

    echo "[✅] Successfully mounted ${downloaded_file_name} at ${dmg_mount_path}"

    verify_signature "${dmg_mount_path}/${application_name}.app" "${application_name}"

    echo "[🍺] Attempting to copy ${application_name}.app into /Applications"
    if cp -Ri "${dmg_mount_path}/${application_name}.app" "/Applications"; then
      echo "[✅] Successfully installed ${application_name}"
    else
      echo "[❌] Failed to install ${application_name}"
      exit 1
    fi

    echo "[🍺] Unmounting ${dmg_mount_path}"
    hdiutil detach -quiet "${dmg_mount_path}"
    
    echo "[🍺] Deleting ${downloaded_file_path}"
    rm "${downloaded_file_path:?}"

  fi  
}


function get_sudo {

  # get_sudo PURPOSE: PURPOSE says why sudo is needed, in the prompt. -v
  # refreshes cached credentials, adding five minutes to the sudo timeout.

  local purpose_string=${1:?purpose_string not passed to get_sudo}
  
  if sudo --prompt="[⚠️ ] Password required ${purpose_string}: " -v; then
    return 0
  else 
    return 1
  fi
}


function ctrl_c {
  echo -e "\\n[❌] ${USER} has chosen to quit!"
  exit 1
}


