function install_basictex {
  # BasicTeX via Homebrew cask, then pin the tlmgr repository mirror.

  # A named mirror, not the CTAN redirector (mirror.ctan.org): it GeoIP-routes
  # UK clients to Cambridge (mirror.apps.cam.ac.uk), unreachable since 2026-03.
  # A fresh BasicTeX / annual TeX Live install resets the option to the http://
  # redirector default, so re-pin on every install. https:// preserves
  # transport integrity, the only authenticity check left with
  # --verify-repo=none.
  local -r TLMGR_REPOSITORY="https://mirror.ox.ac.uk/sites/ctan.org/systems/texlive/tlnet"

  if [[ -x "$(command -v tlmgr)" ]]; then
    echo "[🍺] MacTeX already installed"
  else
    echo "[🍺] Installing BasicTeX via Homebrew..."

    if brew install --cask basictex; then
      echo "[✅] Successfully installed BasicTeX"
    else
      echo "[❌] Failed to install BasicTeX"
      exit 1
    fi
  fi

  get_sudo "to pin the tlmgr package repository mirror"
  if sudo tlmgr option repository "${TLMGR_REPOSITORY}" >/dev/null; then
    echo "[✅] Pinned tlmgr repository to ${TLMGR_REPOSITORY}"
  else
    echo "[❌] Failed to pin tlmgr repository"
  fi
}


function install_latex_packages {
  # Updates tlmgr and all installed packages first, then installs the extras.

  echo "[🍺] Updating tlmgr, all installed packages and installing packages..."
  sleep 2

  get_sudo "to update tlmgr, update installed packages and install packages"

  # GPG repo verification is off (gnupg not installed); SHA-512 checksums and
  # HTTPS still protect package integrity.

  if sudo tlmgr --verify-repo=none update --self >/dev/null; then
    echo "[✅] Successfully updated tlmgr"
