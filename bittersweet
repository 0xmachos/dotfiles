      local okf_out="${2:-${SCRIPT_DIR}/internals/index.md}"
      _generate_okf_index "${okf_out}"
      echo "[✅] Regenerated ${okf_out}"
      ;;
    test)
      shift
      "${SCRIPT_DIR}/test" "$@"
      ;;
    hailmary)
      # Order matters: system config (no dependencies), security tools (curl +
      # plutil, no brew needed), Homebrew + Brewfile (installs shellcheck, etc.),
      # then everything else.
      echo -e "[🍺] ${RED}Hailmary${RESET} engaged"
      sleep 3

      write_defaults
      install_dotfiles
      install_scripts
      enable_touchid_sudo
      install_blockblock
      install_oversight
