# ~/.ssh/config
# ssh_config(5)
# https://man.openbsd.org/ssh_config

# https://stribika.github.io/2015/01/04/secure-secure-shell.html 

# Configuration values are only changed the first time they are set
# Host-specific definitions should be at the beginning and defaults at the end

Include ~/.ssh/.extra_ssh

Match exec "test -S %d/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh"

    IdentityAgent ~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh
    # Only where Secretive's agent socket exists; otherwise fall back to
    # $SSH_AUTH_SOCK (e.g. a forwarded agent), not a dead socket path.
    # test -S stats the socket without reading the container, so macOS 27's
    # container-read denial doesn't break it (verified 2026-09-25, macOS 27.0).

Host *

    IdentitiesOnly yes
    PubkeyAuthentication yes
    HashKnownHosts yes
    # ssh-keygen -R hostname

    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h-%p
    ControlPersist 30s

    ServerAliveInterval 15
    ServerAliveCountMax 3
    # Probes go through the encrypted channel: after 3 missed (~45s) the
    # ControlMaster exits instead of lingering on a dead TCP, which caused
    # stale-master "PTY allocation request failed" over Tailscale.

    UseKeychain yes
    # Search the user's keychain for key passphrases; store a correct one there.
    # https://developer.apple.com/library/content/technotes/tn2449/_index.html

    ForwardAgent no
    # Never forward the authentication agent to the remote machine.
    # http://www.unixwiz.net/techtips/ssh-agent-forwarding.html#fwd

    # Cryptography

    # Values ending @openssh.com are OpenSSH-defined algorithms that deviate
    # from the published SSH protocol or algorithm RFC.
    #  See: https://security.stackexchange.com/a/231117
    #  See: https://www.rfc-editor.org/rfc/rfc4251#section-6
    #  See: https://github.com/openssh/openssh-portable/blob/V_8_2/PROTOCOL

    KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512@openssh.com,curve25519-sha256
    # Hybrid PQ (ML-KEM or NTRU Prime + X25519), classical X25519 as fallback

    HostKeyAlgorithms ssh-ed25519
    # ed25519 only
    # TODO: Add ssh-mldsa-87 when it lands

    Ciphers chacha20-poly1305@openssh.com
    # AEAD only: ChaCha20 stream cipher with Poly1305 MAC. AES-GCM and EtM
    # leave message sizes unencrypted, allowing traffic analysis without
    # decrypting the data.
    #   See: http://blog.djm.net.au/2013/11/chacha20-and-poly1305-in-openssh.html
    # Fast in software, an advantage on hardware that lacks AES-NI.

    MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,umac-128-etm@openssh.com
    # Encrypt-then-MAC only: HMAC-SHA2-512/256 or UMAC-128
    #   https://crypto.stackexchange.com/a/56432
    # Defence in depth: the only cipher, chacha20-poly1305, has a built-in MAC
    # (Poly1305). Kept in case another cipher is added to reach a system
    # without chacha20-poly1305.
    #  See: https://github.com/openssh/openssh-portable/blob/V_8_2/PROTOCOL.chacha20poly1305

    PubkeyAcceptedAlgorithms ssh-ed25519,ecdsa-sha2-nistp256
    # ed25519 is the preferred key type
    # ECDSA for Secretive/ Secure Enclave generated keys
    # TODO: Add ssh-mldsa-87 when it lands
