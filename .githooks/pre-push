#!/usr/bin/env zsh
# .githooks/pre-push
#
# Chains to the global signature gate, .config/git/hooks/pre-push: a
# repo-local core.hooksPath (.githooks/) SHADOWS the global one entirely, so
# the gate never fires here unless this stub chains. Repo-relative, as in
# .githooks/pre-commit (fresh clone, no configuration).
#
# `exec` passes stdin (git's <local-ref> <local-sha> <remote-ref> <remote-sha>
# quads), argv and exit status through untouched; the global hook
# materialises and replays stdin to any repo-level hook of its own.
#
# ShellCheck: lint with `shellcheck --shell=bash .githooks/pre-push`.

set -euo pipefail

exec "${0:A:h:h}/.config/git/hooks/pre-push" "$@"
