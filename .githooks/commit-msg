#!/usr/bin/env zsh
# .githooks/commit-msg
# Chains to the global commit-message PII gate: this repo's core.hooksPath
# (.githooks/) shadows the global hooks dir, so it would never fire here.
# Repo-relative path, so a fresh clone needs no configuration.

set -euo pipefail

"$(git rev-parse --show-toplevel)/.config/git/hooks/commit-msg" "$@"
