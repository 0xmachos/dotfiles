#!/usr/bin/env zsh
# .githooks/pre-commit
# Scan staged changes for secrets/PII, then enforce bittersweet parity

set -euo pipefail

# When bittersweet is staged, keep .completions/_bittersweet locked to
# BITTERSWEET_SUBCOMMANDS and hard-fail the commit on parity drift:
#  1. Regenerate the completion from the array and auto-stage it (catches an
#     array edit without `bittersweet completions`).
#  2. Run `./test completions`: regen alone cannot see a dispatch arm with no
#     array entry (the generator reads only the array); the test compares
#     case arms against array keys.
# --no-verify bypasses both. CI is the only unbypassable layer.
completion_test_output=""
# Materialise before matching: grep -q could exit early and SIGPIPE git,
# making pipefail silently skip the completion gate on a large staged set.
staged_paths="$(git diff --cached --name-only --diff-filter=d)"
if [[ $'\n'"${staged_paths}"$'\n' == *$'\n'bittersweet$'\n'* ]]; then
  if [[ -x ./bittersweet ]]; then
    ./bittersweet completions >/dev/null
    if ! git diff --quiet -- .completions/_bittersweet; then
      git add .completions/_bittersweet
      echo "[ℹ️ ] Regenerated and staged .completions/_bittersweet"
    fi
  fi
  if ! completion_test_output=$(./test completions 2>&1); then
    echo "[❌] bittersweet subcommand drift detected — commit blocked:"
    echo "${completion_test_output}"
    exit 1
  fi
fi

# Scanning layers (gitleaks, PII denylist, MAC/UUID detector) live in the
# global hook. This repo's core.hooksPath shadows it, so run it by
# repo-relative path (fresh clone, no configuration). LAST, so content this
# hook auto-stages is scanned too.
"${0:A:h:h}/.config/git/hooks/pre-commit"
