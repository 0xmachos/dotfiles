[user]
	name = 0xmachos
	# Full name recorded in newly created commits
	email = 0xmachos@gmail.com
	# Email address recorded in newly created commits
	signingkey = ~/.ssh/id_ecdsa-sha2-nistp256_quantum.pub
	# Secure Enclave key via Secretive
	# TODO: Switch to ssh-mldsa-87 when:
	#   1. IETF drafts (draft-sfluhrer-ssh-mldsa, draft-rpe-ssh-mldsa) become RFCs
	#   2. OpenSSH adds ML-DSA signature support (currently only ML-KEM for key exchange)
	#   3. GitHub accepts ML-DSA SSH keys for commit signature verification

[core]
	hooksPath = ~/Documents/Projects/dotfiles/.config/git/hooks
	# Global hooks for every repo: pre-commit scanner (gitleaks + PII denylist
	# + MAC/UUID token detector) plus forwarder stubs for the other hook types,
	# each of which execs the repo's own .git/hooks/<name> — so no repo hook is
	# shadowed. Deliberately the repo path, not a ~/.config symlink: a sync
	# delivers hooks and this config together, with no install step or window
	# where hooksPath points at nothing. A repo-local core.hooksPath (e.g.
	# dotfiles' .githooks/) still wins over this.

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

