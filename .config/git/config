[user]
	name = 0xmachos
	email = 0xmachos@gmail.com
	signingkey = ~/.ssh/id_ecdsa-sha2-nistp256_quantum.pub
	# Secure Enclave key via Secretive
	# TODO: switch to ssh-mldsa-87 when draft-sfluhrer-ssh-mldsa and
	# draft-rpe-ssh-mldsa are RFCs, OpenSSH signs with ML-DSA (only ML-KEM for
	# key exchange today), and GitHub verifies ML-DSA SSH commit signatures.

[core]
	hooksPath = ~/dotfiles/.config/git/hooks
	# Global hooks for every repo: pre-commit scanner (gitleaks + PII denylist
	# + MAC/UUID token detector) plus forwarder stubs for the other hook types
	# that exec the repo's own .git/hooks/<name>, so no repo hook is shadowed.
	# Repo path, not a ~/.config symlink: a sync delivers hooks and config
	# together, with no window where hooksPath points at nothing.
	# A repo-local core.hooksPath (e.g. dotfiles' .githooks/) still wins.

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
	# gh is the only git credential helper for GitHub over HTTPS (2026-09-21);
	# tests/gh-auth asserts this. The blank first line clears the chain:
	# Xcode's git ships a system-level credential.helper = osxkeychain.
	# One token serves git and gh: `gh auth refresh` narrows both, `gh auth
	# logout` ends both. Absolute path: launchd never sees /opt/homebrew/bin
	# on PATH, and a wrong path fails loud.

[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
