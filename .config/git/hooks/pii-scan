#!/usr/bin/env zsh
# .config/git/hooks/pii-scan
#
# Shared PII scan core (extracted 2026-08-17 from pre-commit so messages get
# the same implementation): layer 2 literal denylist, layer 3 MAC/UUID tokens.
# Callers and targets:
#   pre-commit  — staged added content + staged pathnames
#   commit-msg  — normalised candidate message (also via the applypatch-msg
#                 symlink for `git am`)
#   pre-push    — every outgoing commit/tag message in the pushed range
#
# Usage: pii-scan <target-file> <label>
#   <target-file>  materialised scan target (caller creates and cleans up)
#   <label>        phrase for failure output, e.g. "Staged changes"
# Exit 0 = clean, exempted or bypassed; 1 = hit or hard-block.
#
# Layer 2: grep -E patterns from the gitignored per-clone .githooks/pii-patterns
# plus SSH Host aliases derived from ~/.ssh/.extra_ssh at run time.
# Layer 3: MAC (colon/dash/mixed) and UUID tokens, even embedded in labels/URLs.
# Only placeholder_re (aa:bb:cc:dd:ee:ff, RFC 7042 00:00:5e:00:53:xx,
# broadcast/nil MAC, 01234567-89ab-cdef-0123-456789abcdef, nil/max UUID) and
# .pii-allowlist entries pass; a false positive means "use a placeholder".
#
# Allowlist <repo>/.pii-allowlist: read from the INDEX (staged), so an unstaged
# edit cannot exempt anything. One case-insensitive grep -E pattern per line
# (# comments and blanks skipped). A pattern must match the WHOLE layer-3 token
# or the WHOLE layer-2 hit line ("lineno:content"; write `.*<pattern>.*`), so a
# bare token never launders another hit on its line. A single `.*` line opts
# the repo out of layers 2+3. In a public repo keep name-shaped entries out
# (an allowlist of deanonymisers is itself a leak).
#
# No pipelines: under pipefail an early-exiting consumer SIGPIPEs the producer
# into exit 141, fail-OPEN for a scanner. Targets arrive materialised; grep
# output is captured, never piped.
#
# Bypass (2026-09-25): PII_HOOK_BYPASS=1 skips both layers loudly, only with a
# controlling terminal. --check-terminal is the one shared test, also called by
# commit-msg (MSG_POLICY_SKIP) and pre-push (GIT_SIGN_SKIP, MSG_POLICY_SKIP).
# Without one (verified 2026-09-25 for an agent tool call: stdio not TTYs,
# /dev/tty cannot be opened) the variable is IGNORED, the scan runs, and one
# line tells the agent to hand the user the command for their OWN terminal.
# No env seam may re-enable the check. A pty around git (`script`, `expect`)
# would satisfy it; Claude Code's Bash guard denies that shape. gitleaks is
# unaffected; --no-verify skips the hook silently and cannot be refused here.
# Test seams: PII_HOOK_PATTERNS / PII_HOOK_SSH_CONFIG override the pattern-list
# and ssh-config paths (./test pii-hook); both warn when active.
#
# ShellCheck: lint with `shellcheck --shell=bash .config/git/hooks/pii-scan`.

set -euo pipefail

# --check-terminal: exit 0 with a controlling terminal, 1 without. /dev/tty
# names the process's own controlling terminal, so unlike `[[ -t 0 ]]` it is
# not fooled by redirected I/O; opening it fails only for an agent tool call or
# a daemonised/launchd process.
if [[ "${1:-}" == --check-terminal ]]; then
  ( exec 3</dev/tty ) 2>/dev/null
  exit $?
fi

target="$1"
label="${2:-Scanned content}"

if [[ "${PII_HOOK_BYPASS:-0}" == "1" ]]; then
  if "${0:A}" --check-terminal; then
    echo "[⚠️ ] PII_HOOK_BYPASS=1 — PII denylist and token scans SKIPPED." >&2
    exit 0
  fi
  echo "[❌] PII_HOOK_BYPASS=1 ignored: no controlling terminal; give the user the exact command to run in their OWN terminal." >&2
fi

# Checkout found from the script's own location. If :A fails to resolve
# (EACCES on a parent) the pattern list reads as missing and warns below.
DOTFILES="${0:A:h:h:h:h}"
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || echo .)"

# ${TMPDIR:-/tmp}/ not the house ${TMPDIR}… idiom: this runs wherever git does,
# and a slashless TMPDIR would make /tmppii-… and block every commit.
pii_allow="$(mktemp "${TMPDIR:-/tmp}/pii-allow.XXXXXX")"
trap '/bin/rm -f "${pii_allow}"' EXIT

# Index, never the working tree (an unstaged `.*` must not disable scanning).
# Validated once: an invalid regex must hard-block, or a later grep rc >= 2
# would read as "nothing exempted".
allow_active=0
if git show :.pii-allowlist 2>/dev/null \
     | grep -vE '^[[:space:]]*(#|$)' > "${pii_allow}"; then
  set +e
  grep -qiE -f "${pii_allow}" /dev/null
  allow_rc=$?
  set -e
  if (( allow_rc >= 2 )); then
    echo "[❌] .pii-allowlist (staged) has an invalid grep -E pattern (exit ${allow_rc}). Fix it before committing." >&2
    exit 1
  fi
  allow_active=1
fi

# --- Layer 2: literal PII denylist -------------------------------------------

if [[ -n "${PII_HOOK_PATTERNS:-}" ]]; then
  echo "[⚠️ ] PII_HOOK_PATTERNS seam active — denylist is NOT the real pattern list." >&2
fi
pii_file="${PII_HOOK_PATTERNS:-${DOTFILES}/.githooks/pii-patterns}"
pii_patterns=""
if [[ ! -r "${pii_file}" ]]; then
  # Warn, don't block (a fresh clone could never make its first commit); a
  # failed private sync would otherwise drop the backstop silently.
  echo "[⚠️ ] PII pattern list unreadable (${pii_file}); denylist scan degraded." >&2
else
  # `|| [[ -n ]]`: read returns non-zero on a final line with no newline,
  # which would drop the newest pattern.
  while IFS= read -r line || [[ -n "${line}" ]]; do
    [[ -z "${line}" || "${line}" == \#* ]] && continue
    pii_patterns="${pii_patterns:+${pii_patterns}|}${line}"
  done < "${pii_file}"
  if [[ -z "${pii_patterns}" ]]; then
    # Independent of the SSH aliases below: warns even if aliases fill it.
    echo "[⚠️ ] PII pattern list has no active patterns (${pii_file})." >&2
  fi
fi

# SSH Host aliases are deanonymisers too. Word-bounded; any containing
# characters outside [A-Za-z0-9_-] (wildcards, regex metacharacters) is skipped.
if [[ -n "${PII_HOOK_SSH_CONFIG:-}" ]]; then
  echo "[⚠️ ] PII_HOOK_SSH_CONFIG seam active — alias derivation is NOT reading the real ssh config." >&2
fi
ssh_config="${PII_HOOK_SSH_CONFIG:-${HOME}/.ssh/.extra_ssh}"
if [[ -r "${ssh_config}" ]]; then
  while read -r key rest || [[ -n "${key}" ]]; do
    [[ "${key:l}" == "host" ]] || continue
    for host_alias in ${=rest}; do
      [[ "${host_alias}" == *[^[:alnum:]_-]* ]] && continue
      pii_patterns="${pii_patterns:+${pii_patterns}|}(^|[^[:alnum:]_])${host_alias}([^[:alnum:]_]|$)"
    done
  done < "${ssh_config}"
fi

if [[ -z "${pii_patterns}" ]]; then
  echo "[⚠️ ] No active PII patterns at all; denylist scan SKIPPED." >&2
else
  # grep exit: 0 match, 1 clean, >= 2 invalid regex (block, so a malformed
  # pattern cannot silently disable the scanner).
  set +e
  pii_hits="$(grep -inE -e "${pii_patterns}" "${target}")"
  pii_rc=$?
  set -e
  if (( pii_rc >= 2 )); then
    echo "[❌] PII scan aborted: ${pii_file} has an invalid grep -E pattern (exit ${pii_rc}). Fix it before committing." >&2
    exit 1
  fi
  if (( pii_rc == 0 )); then
    if (( allow_active )); then
      # -x: whole hit line, so a bare allowlisted token never launders an
      # unrelated denylist hit sharing its line.
      pii_hits="$(grep -vixE -f "${pii_allow}" <<< "${pii_hits}" || true)"
    fi
    if [[ -n "${pii_hits}" ]]; then
      echo "[❌] ${label}: PII pattern hit. Redact before committing:"
      head -5 <<< "${pii_hits}"
      exit 1
    fi
    echo "[ℹ️ ] PII denylist hits exempted by .pii-allowlist"
  fi
fi

# --- Layer 3: regex-shaped token detector (allowlist-by-default) -------------

# Plain grep -o, no word-boundary guards or tokenisation: ERE guard classes
# CONSUME their boundary char (a real token one separator after a placeholder
# would be skipped), and maximal-run tokenisation rejects identifiers joined to
# labels (mac:<mac>, id:<uuid>, urn:uuid:…). Occasional extraction from longer
# hex runs errs toward blocking, the designed direction.
# [:-] covers colon, dash and mixed-separator MACs.
mac_re='([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}'
uuid_re='[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}'
# Static patterns: rc >= 2 cannot occur, so || true is safe.
tokens="$(grep -oE -e "${mac_re}" -e "${uuid_re}" "${target}" \
            | sort -fu || true)"

if [[ -n "${tokens}" ]]; then
  placeholder_re='^(aa([:-]bb)([:-]cc)([:-]dd)([:-]ee)([:-]ff)|ff([:-]ff){5}|00([:-]00){5}|00[:-]00[:-]5e[:-]00[:-]53[:-][0-9A-Fa-f]{2}|01234567-89ab-cdef-0123-456789abcdef|0{8}-0{4}-0{4}-0{4}-0{12}|[Ff]{8}-[Ff]{4}-[Ff]{4}-[Ff]{4}-[Ff]{12})$'
  tokens="$(grep -viE "${placeholder_re}" <<< "${tokens}" || true)"
fi
if [[ -n "${tokens}" ]] && (( allow_active )); then
  # -x: whole-token exemption only.
  tokens="$(grep -vixE -f "${pii_allow}" <<< "${tokens}" || true)"
fi
if [[ -n "${tokens}" ]]; then
  echo "[❌] ${label}: real-looking MAC/UUID tokens. Replace with"
  echo "     placeholders (aa:bb:cc:dd:ee:ff, 01234567-89ab-cdef-0123-456789abcdef)"
  echo "     or add known-public values to ${repo_root}/.pii-allowlist (staged):"
  head -5 <<< "${tokens}"
  exit 1
fi
