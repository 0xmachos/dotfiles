#!/usr/bin/env zsh
# .config/git/hooks/repo-visibility
#
# Prints the visibility of the current repository's `origin` as one word on
# stdout — public, private, or unknown — for the sibling hooks that apply a
# stricter policy to public repositories (commit-msg and pre-push message
# policy, pre-push tracked-tree scan). Always exits 0; the CALLER decides
# what unknown means, and every caller here treats it as public, because a
# gate that opens on a lookup failure is not a gate.
#
# Resolution order:
#   1. `git config hooks.repoVisibility` (public|private) — the explicit,
#      per-repo override. Set it for a non-GitHub remote, an offline machine,
#      or a repository whose visibility gh cannot see.
#   2. A github.com `origin` URL (https or ssh) → `gh api repos/<o>/<r>`,
#      read through gh's own response cache (--cache 168h) so one lookup a
#      week serves every hook run and an offline week still answers.
#   3. Anything else → unknown.
#
# Why a separate script and not a function inside each hook: three hooks
# need the same answer, the seams below must be shared for the tests, and a
# script can be exercised on its own (`repo-visibility` in any repo).
#
# Test seams: REPO_VISIBILITY_GH overrides the gh binary (a fixture that
# prints a JSON body or fails); REPO_VISIBILITY_FORCE=public|private|unknown
# short-circuits everything (used by suites that only care about the
# downstream policy).
#
# ShellCheck: lint with `shellcheck --shell=bash .config/git/hooks/repo-visibility`.

set -uo pipefail

if [[ -n "${REPO_VISIBILITY_FORCE:-}" ]]; then
  case "${REPO_VISIBILITY_FORCE}" in
    public|private|unknown) print -r -- "${REPO_VISIBILITY_FORCE}"; exit 0 ;;
  esac
fi

configured="$(git config --get hooks.repoVisibility 2>/dev/null || true)"
case "${configured:l}" in
  public|private) print -r -- "${configured:l}"; exit 0 ;;
esac

url="$(git config --get remote.origin.url 2>/dev/null || true)"
slug=""
case "${url}" in
  https://github.com/*)      slug="${url#https://github.com/}" ;;
  https://*@github.com/*)    slug="${url#https://*@github.com/}" ;;
  git@github.com:*)          slug="${url#git@github.com:}" ;;
  ssh://git@github.com/*)    slug="${url#ssh://git@github.com/}" ;;
esac
slug="${slug%.git}"
slug="${slug%/}"

if [[ -z "${slug}" || "${slug}" != */* ]]; then
  print -r -- unknown
  exit 0
fi

gh_bin="${REPO_VISIBILITY_GH:-gh}"
if ! command -v "${gh_bin}" >/dev/null 2>&1; then
  print -r -- unknown
  exit 0
fi

# `.private` is a boolean; `.visibility` also exists (public|private|internal)
# but only on newer API versions. Read the boolean and map it.
private=""
private="$("${gh_bin}" api --cache 168h "repos/${slug}" --jq '.private' 2>/dev/null || true)"
case "${private}" in
  true)  print -r -- private ;;
  false) print -r -- public ;;
  *)     print -r -- unknown ;;
esac
exit 0
