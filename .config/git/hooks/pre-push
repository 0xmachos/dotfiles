#!/usr/bin/env zsh
# .config/git/hooks/pre-push
#
# Global pre-push signature gate AND outgoing-message PII gate for EVERY
# repo, activated by the global core.hooksPath declared in .config/git/config.
# Blocks a push that would publish (a) a commit with no `gpgsig` header, in
# any repo where commit.gpgsign is on, or (b) — since 2026-08-17, in every
# repo — an outgoing commit or annotated-tag MESSAGE containing a PII
# pattern, a real-looking MAC/UUID token, or a gitleaks secret. This is the
# LAST gate before a message becomes permanent: commit-msg is only fast
# feedback — it
# never fires for cherry-pick, revert, plain rebase replay, plumbing, or
# --no-verify commits, and it cannot see `#`-prefixed lines that `-m`
# messages keep (all verified 2026-08-17). Scanning the STORED message of
# every outgoing commit closes every one of those paths at once. For PII
# there is no post-leak rotation — prevention here is the entire control.
#
# WHY THIS EXISTS RATHER THAN THE CLAUDE HOOK ALONE (2026-08-08). The
# PreToolUse `claude/git-sign-hook` used to be the only barrier. A Codex
# adversarial review showed a command-string parser cannot hold that line, and
# every case reproduced:
#   * `'git' push`, `git 'push'`, `g\it push`, `{ git push; }`, `! git push`
#     and `if true; then git push; fi` all sailed past the matcher, while a
#     heredoc body containing the words `git push` was falsely denied.
#   * `git -C <other-repo> push` was judged against the WRONG repository.
#   * A signing failure on `git commit -m x && git push` produced a retry that
#     recreated the whole compound command with signing disabled: the gate saw
#     a still-clean range, then the same shell made the unsigned commit and
#     pushed it before any hook ran again.
# git hands this hook the exact <local-ref> <local-sha> <remote-ref>
# <remote-sha> quads on stdin, after all argument parsing, refspec expansion
# and `-C` resolution. There is no spelling to get wrong and no state to race:
# what is on stdin is what is about to be transferred. The Claude hook stays
# as early guidance; THIS is the invariant.
#
# Order mirrors the pre-commit scanner: chain to the repo's own
# default-location pre-push FIRST (it may run tests or amend refs), then scan.
# stdin is consumable once, so it is materialised and replayed to both.
#
# Fail-CLOSED on an unreadable commit, unlike the rest of the hook stack: this
# is the last barrier before a permanent, public SHA. Everything else here
# fails open.
#
# Bypass: `git push --no-verify` (silent, git-level) skips everything;
# GIT_SIGN_SKIP=1 (loud) skips the signature layer ONLY; PII_HOOK_BYPASS=1
# (loud, inside pii-scan) skips the PII layers of the message scan while
# gitleaks still runs — mirroring pre-commit; MSG_POLICY_SKIP=1 (loud) skips
# Layers 3 and 4 only.
#
# Layers 3 and 4 (added 2026-09-22) apply to PUBLIC repositories only, as
# decided by the sibling `repo-visibility` script (explicit
# `hooks.repoVisibility`, else a gh lookup of the github.com origin; unknown
# counts as public, because a gate that opens on a lookup failure is not a
# gate). Layer 3 is the message POLICY: no `Ledger-Event:` or
# `Claude-Session:` trailer, no empty commit (a single parent with the same
# tree), no body over `hooks.maxBodyWords` words (default 120). Layer 4
# materialises the tracked tree of every pushed tip and runs pii-scan over
# it, so a value that entered a file before its denylist pattern existed is
# caught at the boundary and not only by ./test pii-tree.
#
# The outgoing walk now runs in every repo (it used to be skipped when
# signing was off), so a diverged remote whose tip is not held locally
# fail-closes every push, not just signing ones — `git fetch` first.
#
# ShellCheck: lint with `shellcheck --shell=bash .config/git/hooks/pre-push`.

set -euo pipefail
IFS=$'\n\t'

# Sentinel scoped to hook name AND repo (see hook-forward): a hook in repo A
# running git operations in repo B must not skip B's hooks.
#
# On re-entry the sentinel suppresses the CHAINING ONLY — never the scan
# (Codex finding, 2026-08-08). It used to `exit 0` here, which meant a repo
# pre-push hook that itself pushed the same repo inherited the exported
# sentinel and published unsigned commits unexamined; reproduced by invoking
# the hook with the sentinel pre-set (exit 0 against an unsigned tip that
# otherwise exits 1). The scan is read-only and runs no hooks, so repeating it
# cannot recurse.
sentinel="pre-push@$(git rev-parse --absolute-git-dir)"
sentinel="${sentinel// /_}"
typeset -i reentered=0
case " ${GIT_GLOBAL_HOOKS_SEEN:-} " in
  (*" ${sentinel} "*) reentered=1 ;;
esac
export GIT_GLOBAL_HOOKS_SEEN="${GIT_GLOBAL_HOOKS_SEEN:-} ${sentinel}"

# stdin is a stream, and both the chained hook and the scan below need it.
UPDATES="$(cat)"

# --- Layer 0: chain to the repo's own default-location hook -----------------

repo_hook="$(git rev-parse --git-common-dir)/hooks/pre-push"
if (( ! reentered )) && [[ -x "${repo_hook}" && "${repo_hook:A}" != "${0:A}" ]]; then
  # Here-string, never a pipeline: under `pipefail` a chained hook that exits
  # without draining a large ref stream SIGPIPEs the producer, the pipeline
  # reports 141, and a push the repo hook ALLOWED is blocked. Reproduced
  # 2026-08-08 with 4000 refs (462 KB) and a repo hook of `exit 0` — global
  # hook 141 with it enabled, 0 with it disabled. A here-string is a file, so
  # an unread stream is free. `$?` is then the hook's own status, no `||`
  # needed to unwrap it.
  "${repo_hook}" "$@" <<< "${UPDATES}" || exit $?
fi

# --- Layer 1: signature gate ------------------------------------------------

# Only signature-gate repos that sign. `--bool` normalises yes/on/1/true; a
# literal string compare read `yes` as "not signing" and let the push through
# (Codex finding, 2026-08-08). The message gate below runs regardless — no
# early exit for non-signing repos any more.
typeset -i sign_commits=0 sign_tags=0
[[ "$(git config --bool --get commit.gpgsign 2>/dev/null || true)" == "true" ]] && sign_commits=1
[[ "$(git config --bool --get tag.gpgsign 2>/dev/null || true)" == "true" ]] && sign_tags=1

if [[ -n "${GIT_SIGN_SKIP:-}" ]]; then
  print -u2 "[⚠️ ] GIT_SIGN_SKIP=1 — pre-push signature gate skipped (message scan still runs)"
  sign_commits=0
  sign_tags=0
fi

# Commit signature presence is checked by the shared commit-signatures helper
# after collecting every range, so overlapping refs read each object once.
# It preserves the header-only check and fail-closed object parsing.

# Annotated tags carry their signature in the tag OBJECT, appended after the
# message rather than as a header, so the commit walk below can never see it:
# an unsigned tag over a signed commit passed the gate while `git tag -v` said
# "error: no signature found" (verified 2026-08-08). Exit 0 signed, 1 unsigned,
# 2 unreadable.
function _tag_is_signed {
  local out
  out="$(git cat-file tag "$1" 2>/dev/null)" || return 2
  [[ $'\n'"${out}" == *$'\n'-----BEGIN*SIGNATURE-----* ]]
}

typeset -a unsigned=() unsigned_tags=()
typeset -Ua outgoing=() tag_objs=() tips=()
typeset -i unreadable=0

# Gate the tag OBJECT when the ref being pushed is an annotated tag. Peeling to
# commits (below) cannot see a tag's own signature — nor its own MESSAGE, so
# annotated tags are collected for the message scan here too.
function _check_tag {
  local ref="$1" obj="$2" objtype rc=0
  objtype="$(git cat-file -t "${obj}" 2>/dev/null || true)"
  if [[ "${objtype}" != tag ]]; then
    return 0
  fi
  tag_objs+=("${obj}")
  (( sign_tags )) || return 0
  _tag_is_signed "${obj}" || rc=$?
  if (( rc == 2 )); then
    unreadable=1
  elif (( rc != 0 )); then
    unsigned_tags+=("${ref}")
  fi
  return 0
}

# Annotated-tag message: `git cat-file tag` prints headers, a blank line,
# then the message with any signature block appended after it. Drop the
# header block and the signature (base64 armour would only feed the token
# detector noise); a malformed object falls through unmodified, which errs
# toward scanning MORE, not less.
function _tag_message {
  local out
  out="$(git cat-file tag "$1" 2>/dev/null)" || return 0
  out="${out#*$'\n\n'}"
  out="${out%%-----BEGIN*}"
  print -r -- "${out}"
}

# Walk each range fail-closed; signature and message scans consume the
# deduplicated outgoing list after all refs have been collected.
#
# The walk's exit status is captured, NOT discarded. `for sha in $(git rev-list
# …)` swallowed it: an empty expansion ran the loop zero times and the hook
# exited 0, so any failed walk was a silent PASS in the one hook documented as
# fail-closed. git computes remote_sha from the remote's LIVE advertised refs,
# not the remote-tracking cache, so a push whose remote tip is not held locally
# yields `fatal: bad object` — reproduced 2026-08-08: exit 0 for an unsigned
# tip that exits 1 in both controls (force-push over a diverged remote is the
# live case; --force-with-lease is safe because the lease requires the object).
function _scan_range {
  local revs sha rl_rc=0
  # shellcheck disable=SC2034  # read via `${=revs}`, zsh word-splitting that --shell=bash cannot see
  revs="$(git rev-list "$@" 2>/dev/null)" || rl_rc=$?
  if (( rl_rc )); then
    unreadable=1
    return 0
  fi
  for sha in ${=revs}; do
    outgoing+=("${sha}")
  done
  return 0
}

# shellcheck disable=SC2034  # remote_ref is a positional placeholder in git's quad
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  [[ -n "${local_sha:-}" ]] || continue
  # All-zero local sha = branch deletion; nothing is being published.
  [[ "${local_sha}" == *[^0]* ]] || continue

  # Scoped to refs/tags/*: the object-type probe is a fork per ref, and git
  # only ever puts a tag object under refs/tags. Measured 2026-08-08 at ~55 ms
  # per ref end to end, so an unconditional probe doubled the cost of a
  # many-ref push (`--mirror`, `--all`) for refs that can never be tags.
  # No longer gated on sign_tags: the message scan needs annotated tags in
  # every repo.
  if [[ "${local_ref}" == refs/tags/* ]]; then
    _check_tag "${local_ref}" "${local_sha}"
  fi

  typeset -a range
  if [[ "${remote_sha}" == *[^0]* ]]; then
    range=("${remote_sha}..${local_sha}")
  else
    # New ref on the remote: exclude everything already known on any remote,
    # so a fresh branch off pushed history does not rescan all of it.
    range=("${local_sha}" --not --remotes)
  fi

  _scan_range "${range[@]}"
  [[ "${local_ref}" == refs/tags/* ]] || tips+=("${local_sha}")
done <<< "${UPDATES}"

if (( ! unreadable && sign_commits && ${#outgoing} )); then
  unsigned_text=""
  # shellcheck disable=SC2296  # zsh newline join and split
  if unsigned_text="$("${0:A:h}/commit-signatures" <<< "${(F)outgoing}")"; then
    [[ -z "${unsigned_text}" ]] || unsigned=("${(@f)unsigned_text}")
  else
    unreadable=1
  fi
fi

if (( unreadable )); then
  print -u2 "[❌] pre-push: an object could not be read, or a revision walk failed."
  print -u2 "     Refusing to push. This gate fails closed; a pushed SHA is permanent."
  print -u2 "     If the remote tip is simply not held locally, run \`git fetch\` first."
  exit 1
fi

if (( ${#unsigned_tags} )); then
  print -u2 "[❌] pre-push: ${#unsigned_tags} annotated tag(s) in this push carry no signature:"
  typeset t
  for t in "${unsigned_tags[@]}"; do
    print -u2 "       ${t}"
  done
  print -u2 "     Re-create with \`git tag -s -f <name> <commit>\`, then push again."
  print -u2 "     Override: GIT_SIGN_SKIP=1 git push …   (or git push --no-verify)"
  exit 1
fi

if (( ${#unsigned} )); then
  print -u2 "[❌] pre-push: ${#unsigned} commit(s) in this push carry no signature:"
  typeset s
  for s in "${unsigned[@]}"; do
    print -u2 "       $(git log --no-walk --format='%h %s' "${s}" 2>/dev/null || print -r -- "${s}")"
  done
  print -u2 "     Re-signing rewrites SHAs and a pushed SHA is permanent, so this is"
  print -u2 "     blocked. Run \`git-sign-unpushed\` in the repo, then push again."
  print -u2 "     Override: GIT_SIGN_SKIP=1 git push …   (or git push --no-verify)"
  exit 1
fi

# --- Layer 2: outgoing-message PII/secret gate ------------------------------

if (( ${#outgoing} || ${#tag_objs} )); then
  msgs="$(mktemp "${TMPDIR:-/tmp}/pii-push-msgs.XXXXXX")"
  trap '/bin/rm -f "${msgs}"' EXIT

  # Stored messages, batched: one `git log --stdin` call however many commits
  # are outgoing (a 1000-commit first push must not fork per sha), fed by
  # here-string — a file, so an unread stream cannot SIGPIPE (see Layer 0).
  # `commit <sha>` marker lines attribute hits; their hex cannot match either
  # token shape or a hostname pattern.
  {
    if (( ${#outgoing} )); then
      # shellcheck disable=SC2296  # ${(F)…} newline-join, zsh flag syntax --shell=bash cannot parse
      git log --no-walk=unsorted --stdin --format='commit %H%n%B' \
        <<< "${(F)outgoing}"
    fi
    typeset t
    for t in "${tag_objs[@]}"; do
      print -r -- "tag ${t}"
      _tag_message "${t}"
    done
  } > "${msgs}"

  # gitleaks over the messages — the pattern blessed in gitleaks issue #800
  # (`git log --format=%B | gitleaks stdin`); gitleaks itself never scans
  # message text in any git mode. Output captured, shown only on failure.
  # Any nonzero rc blocks: 1 = leak found, >=2 = broken config — this gate
  # fails closed either way.
  if ! command -v gitleaks &>/dev/null; then
    print -u2 "[❌] pre-push: gitleaks not found (brew install gitleaks); refusing to push unscanned messages."
    exit 1
  fi
  typeset -i gl_rc=0
  gl_out="$(gitleaks stdin < "${msgs}" 2>&1)" || gl_rc=$?
  if (( gl_rc )); then
    print -u2 "[❌] pre-push: gitleaks flagged outgoing commit/tag messages (rc=${gl_rc}):"
    print -u2 "${gl_out}"
    exit 1
  fi

  # PII layers (denylist + MAC/UUID tokens), shared with pre-commit and
  # commit-msg. Failure means rewriting the unpushed range — that is the
  # point: nothing here has been published yet.
  if ! "${0:A:h}/pii-scan" "${msgs}" "Outgoing commit/tag messages"; then
    print -u2 "     Rewrite the unpushed message(s) (git commit --amend / rebase -i reword),"
    print -u2 "     re-sign if needed, then push again. Nothing has been published."
    exit 1
  fi
fi

# --- Layer 3: public-repository message policy ------------------------------

visibility="$("${0:A:h}/repo-visibility" 2>/dev/null || print unknown)"
typeset -i public_repo=1
[[ "${visibility}" == private ]] && public_repo=0
if [[ -n "${MSG_POLICY_SKIP:-}" ]]; then
  print -u2 "[⚠️ ] MSG_POLICY_SKIP=1 — public-repo message policy and tree scan skipped"
  public_repo=0
fi

if (( public_repo && ${#outgoing} )); then
  max_words="$(git config --get hooks.maxBodyWords 2>/dev/null || true)"
  [[ "${max_words}" =~ ^[0-9]+$ ]] || max_words=120
  typeset -a policy_hits=()
  typeset sha full body parents ptree n
  for sha in "${outgoing[@]}"; do
    full="$(git log -1 --format=%B "${sha}" 2>/dev/null || true)"
    if [[ $'\n'"${full}" == *$'\n'Ledger-Event:* || $'\n'"${full}" == *$'\n'Claude-Session:* ]]; then
      policy_hits+=("${sha} carries a Ledger-Event or Claude-Session trailer")
    fi
    parents="$(git rev-list --parents -n 1 "${sha}" 2>/dev/null || true)"
    # "sha parent" = exactly one parent; a root or a merge is never "empty".
    if [[ "${parents}" == *" "* && "${parents#* }" != *" "* ]]; then
      ptree="$(git rev-parse "${parents#* }^{tree}" 2>/dev/null || true)"
      if [[ -n "${ptree}" && "${ptree}" == "$(git rev-parse "${sha}^{tree}" 2>/dev/null)" ]]; then
        policy_hits+=("${sha} is an empty commit (same tree as its parent)")
      fi
    fi
    body="$(git log -1 --format=%b "${sha}" 2>/dev/null || true)"
    n="$(wc -w <<< "${body}")"
    n="${n// /}"
    if (( n > max_words )); then
      policy_hits+=("${sha} body is ${n} words (limit ${max_words})")
    fi
  done
  if (( ${#policy_hits} )); then
    print -u2 "[❌] pre-push: this repository is ${visibility}; ${#policy_hits} commit(s) break the public-repo message policy:"
    typeset h
    for h in "${policy_hits[@]}"; do
      print -u2 "       $(git log --no-walk --format='%h %s' "${h%% *}" 2>/dev/null || print -r -- "${h%% *}") — ${h#* }"
    done
    print -u2 "     A public commit message says WHAT changed, in a subject and at most a short body."
    print -u2 "     Reword (git commit --amend / rebase -i), drop empty commits, then push again."
    print -u2 "     Override: MSG_POLICY_SKIP=1 git push …   (private repo: git config hooks.repoVisibility private)"
    exit 1
  fi
fi

# --- Layer 4: public-repository tracked-tree scan ---------------------------

# Per-repo deferral for a public repo whose tracked files predate the
# denylist and have not been cleaned yet: `git config hooks.treeScan false`.
# Loud, so a deferred repo is never mistaken for a clean one.
typeset -i tree_scan_on=1
if [[ "$(git config --bool --get hooks.treeScan 2>/dev/null || true)" == "false" ]]; then
  print -u2 "[⚠️ ] hooks.treeScan=false — public-repo tracked-tree scan deferred for this repository"
  tree_scan_on=0
fi

if (( public_repo && tree_scan_on && ${#tips} )); then
  tree_tmp="$(mktemp -d "${TMPDIR:-/tmp}/pii-push-tree.XXXXXX")"
  tree_scan="$(mktemp "${TMPDIR:-/tmp}/pii-push-treescan.XXXXXX")"
  trap '/bin/rm -rf "${tree_tmp}" "${tree_scan}" "${msgs:-}"' EXIT
  typeset tip tpath tar_file
  for tip in "${tips[@]}"; do
    /usr/bin/find "${tree_tmp:?}" -mindepth 1 -delete
    tar_file="${tree_tmp}/tree.tar"
    # Two steps, never a pipeline (hook rule: a SIGPIPE'd producer fails open).
    if ! git archive --format=tar -o "${tar_file}" "${tip}" 2>/dev/null; then
      print -u2 "[❌] pre-push: could not materialise the tree of ${tip} for the PII scan; refusing to push."
      exit 1
    fi
    /usr/bin/tar -xf "${tar_file}" -C "${tree_tmp}"
    /bin/rm -f "${tar_file}"
    : > "${tree_scan}"
    while IFS= read -r tpath || [[ -n "${tpath}" ]]; do
      [[ -f "${tree_tmp}/${tpath}" && ! -L "${tree_tmp}/${tpath}" ]] || continue
      /usr/bin/grep -qI '' "${tree_tmp}/${tpath}" 2>/dev/null || continue
      { print -r -- "file ${tpath}"; /bin/cat "${tree_tmp}/${tpath}"; print; } >> "${tree_scan}"
    done <<< "$(git ls-tree -r --name-only "${tip}" 2>/dev/null)"
    if ! "${0:A:h}/pii-scan" "${tree_scan}" "Tracked tree of $(git rev-parse --short "${tip}") (public repo)"; then
      print -u2 "     A tracked file at the pushed tip carries a denylisted value or a real-looking token."
      print -u2 "     Remove it from the file (and from the unpushed history that added it), then push again."
      exit 1
    fi
  done
fi

exit 0
