#!/usr/bin/env zsh
# .config/git/hooks/pre-push
#
# Global pre-push gate for EVERY repo (core.hooksPath in .config/git/config):
# signature check plus outgoing-message scan. Blocks a push carrying (a) a
# commit with no `gpgsig` header, where commit.gpgsign is on, or (b) since
# 2026-08-17, in every repo, a commit or annotated-tag MESSAGE with a PII
# pattern, a real-looking MAC/UUID token or a gitleaks secret.
# This is the LAST gate: commit-msg is fast feedback only (never fires for
# cherry-pick, revert, plain rebase replay, plumbing or --no-verify; cannot
# see the `#` lines `-m` keeps; verified 2026-08-17). Scanning the STORED
# message of every outgoing commit closes all of those. PII has no rotation.
#
# Why not the Claude hook alone (2026-08-08): claude/git-sign-hook parses the
# command string, so quoted or wrapped `git push` spellings pass it, a heredoc
# mentioning `git push` is denied, `git -C <other-repo> push` is judged against
# the wrong repo, and a signing-failure retry can recreate `commit && push`
# with signing disabled. Git hands this hook the exact <local-ref> <local-sha>
# <remote-ref> <remote-sha> quads on stdin: nothing is left to parse.
#
# Order: chain to the repo's own default-location pre-push FIRST (it may run
# tests or amend refs), then scan; stdin is materialised and replayed to both.
# Fail-CLOSED on an unreadable commit or failed revision walk (last barrier
# before a permanent public SHA); the rest of the hook stack fails open. The
# walk runs in every repo, so a diverged remote tip not held locally blocks
# every push: `git fetch` first.
#
# Bypass (2026-09-25): `git push --no-verify` (silent, git's own, cannot be
# refused from a hook) skips everything. Loud: GIT_SIGN_SKIP=1 skips the
# signature layer ONLY; PII_HOOK_BYPASS=1 (pii-scan's) skips the PII layers
# while gitleaks still runs; MSG_POLICY_SKIP=1 skips Layers 3 and 4 only. All
# three are honoured ONLY with a controlling terminal, tested by a pii-scan
# --check-terminal subprocess (as commit-msg does). From an agent's tool call
# the variable is ignored, the layer still runs, and one refusal line names
# the command to hand the user. A pty around git (`script`, `expect`) would
# pass the test; for Claude Code, claude/git-bypass-hook denies that shape.
#
# Layers 3 and 4 (added 2026-09-22) apply to PUBLIC repos only, per the
# sibling `repo-visibility` (`hooks.repoVisibility`, else a gh lookup of the
# github.com origin; unknown counts as public: a gate must not open on a
# lookup failure). Layer 3, message POLICY: no `Ledger-Event:` or
# `Claude-Session:` trailer, no empty commit (one parent, same tree), no body
# over `hooks.maxBodyWords` words (default 120). Layer 4: pii-scan over the
# tracked tree of every pushed tip, catching a value that predates its
# denylist pattern (./test pii-tree covers the same at test time).
#
# ShellCheck: lint with `shellcheck --shell=bash .config/git/hooks/pre-push`.

set -euo pipefail
IFS=$'\n\t'

# Sentinel scoped to hook name AND repo (see hook-forward): a hook in repo A
# running git in repo B must not skip B's hooks. Re-entry suppresses the
# CHAINING ONLY, never the scan (2026-08-08): an `exit 0` here let a repo hook
# that pushed the same repo publish unsigned commits unexamined. The scan is
# read-only and runs no hooks, so repeating it cannot recurse.
sentinel="pre-push@$(git rev-parse --absolute-git-dir)"
sentinel="${sentinel// /_}"
typeset -i reentered=0
case " ${GIT_GLOBAL_HOOKS_SEEN:-} " in
  (*" ${sentinel} "*) reentered=1 ;;
esac
export GIT_GLOBAL_HOOKS_SEEN="${GIT_GLOBAL_HOOKS_SEEN:-} ${sentinel}"

UPDATES="$(cat)"

# --- Layer 0: chain to the repo's own default-location hook -----------------

repo_hook="$(git rev-parse --git-common-dir)/hooks/pre-push"
if (( ! reentered )) && [[ -x "${repo_hook}" && "${repo_hook:A}" != "${0:A}" ]]; then
  # Here-string, never a pipeline: under `pipefail` a chained hook that exits
  # without draining a large ref stream SIGPIPEs the producer, the pipeline
  # reports 141, and a push the hook ALLOWED is blocked (reproduced 2026-08-08,
  # 4000 refs, 462 KB). A here-string is a file; `$?` is the hook's own status.
  "${repo_hook}" "$@" <<< "${UPDATES}" || exit $?
fi

# --- Layer 1: signature gate ------------------------------------------------

# Only signature-gate repos that sign. `--bool` normalises yes/on/1/true (a
# string compare read `yes` as not signing). The message gate runs regardless.
typeset -i sign_commits=0 sign_tags=0
[[ "$(git config --bool --get commit.gpgsign 2>/dev/null || true)" == "true" ]] && sign_commits=1
[[ "$(git config --bool --get tag.gpgsign 2>/dev/null || true)" == "true" ]] && sign_tags=1

if [[ -n "${GIT_SIGN_SKIP:-}" ]]; then
  if "${0:A:h}/pii-scan" --check-terminal; then
    print -u2 "[⚠️ ] GIT_SIGN_SKIP=1 — pre-push signature gate skipped (message scan still runs)"
    sign_commits=0
    sign_tags=0
  else
    print -u2 "[❌] GIT_SIGN_SKIP=1 ignored: no controlling terminal; give the user the exact command to run in their OWN terminal."
  fi
fi

# Commit signatures are checked by the commit-signatures helper after every
# range is collected (each object read once; header-only, fail-closed parsing).

# An annotated tag's signature sits in the tag OBJECT after the message, not in
# a header, so the commit walk never sees it: an unsigned tag over a signed
# commit passed while `git tag -v` said "error: no signature found" (verified
# 2026-08-08). Exit 0 signed, 1 unsigned, 2 unreadable.
function _tag_is_signed {
  local out
  out="$(git cat-file tag "$1" 2>/dev/null)" || return 2
  [[ $'\n'"${out}" == *$'\n'-----BEGIN*SIGNATURE-----* ]]
}

typeset -a unsigned=() unsigned_tags=()
typeset -Ua outgoing=() tag_objs=() tips=()
typeset -i unreadable=0

# Peeling to commits cannot see a tag's signature or MESSAGE, so annotated tags
# are gated here and collected for the message scan.
function _check_tag {
  local ref="$1" obj="$2" objtype rc=0
  objtype="$(git cat-file -t "${obj}" 2>/dev/null || true)"
  if [[ "${objtype}" != tag ]]; then
    return 0
  fi
  tag_objs+=("${obj}")
  (( sign_tags )) || return 0
  _tag_is_signed "${obj}" || rc=$?
  if (( rc == 2 )); then
    unreadable=1
  elif (( rc != 0 )); then
    unsigned_tags+=("${ref}")
  fi
  return 0
}

# Drop the tag's header block and signature (base64 armour is token-detector
# noise); a malformed object falls through unmodified, erring toward scanning
# MORE.
function _tag_message {
  local out
  out="$(git cat-file tag "$1" 2>/dev/null)" || return 0
  out="${out#*$'\n\n'}"
  out="${out%%-----BEGIN*}"
  print -r -- "${out}"
}

# The walk's exit status is captured, NOT discarded: `for sha in $(git rev-list
# …)` swallows it, an empty expansion runs zero times, and a failed walk
# becomes a silent PASS. git takes remote_sha from the remote's LIVE advertised
# refs, not the tracking cache, so a remote tip not held locally yields `fatal:
# bad object` (reproduced 2026-08-08; force-push over a diverged remote is the
# live case; --force-with-lease is safe because the lease requires the object).
function _scan_range {
  local revs sha rl_rc=0
  # shellcheck disable=SC2034  # read via `${=revs}`, zsh word-splitting that --shell=bash cannot see
  revs="$(git rev-list "$@" 2>/dev/null)" || rl_rc=$?
  if (( rl_rc )); then
    unreadable=1
    return 0
  fi
  for sha in ${=revs}; do
    outgoing+=("${sha}")
  done
  return 0
}

# shellcheck disable=SC2034  # remote_ref is a positional placeholder in git's quad
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  [[ -n "${local_sha:-}" ]] || continue
  # All-zero local sha = branch deletion; nothing is published.
  [[ "${local_sha}" == *[^0]* ]] || continue

  # Scoped to refs/tags/*: the type probe forks per ref (~55 ms measured
  # 2026-08-08, doubling a `--mirror`/`--all` push) and tag objects live only
  # there. Not gated on sign_tags: the message scan needs tags in every repo.
  if [[ "${local_ref}" == refs/tags/* ]]; then
    _check_tag "${local_ref}" "${local_sha}"
  fi

  typeset -a range
  if [[ "${remote_sha}" == *[^0]* ]]; then
    range=("${remote_sha}..${local_sha}")
  else
    # New ref: exclude everything any remote already has, so a fresh branch
    # off pushed history does not rescan it.
    range=("${local_sha}" --not --remotes)
  fi

  _scan_range "${range[@]}"
  [[ "${local_ref}" == refs/tags/* ]] || tips+=("${local_sha}")
done <<< "${UPDATES}"

if (( ! unreadable && sign_commits && ${#outgoing} )); then
  unsigned_text=""
  # shellcheck disable=SC2296  # zsh newline join and split
  if unsigned_text="$("${0:A:h}/commit-signatures" <<< "${(F)outgoing}")"; then
    [[ -z "${unsigned_text}" ]] || unsigned=("${(@f)unsigned_text}")
  else
    unreadable=1
  fi
fi

if (( unreadable )); then
  print -u2 "[❌] pre-push: an object could not be read, or a revision walk failed."
  print -u2 "     Refusing to push. This gate fails closed; a pushed SHA is permanent."
  print -u2 "     If the remote tip is simply not held locally, run \`git fetch\` first."
  exit 1
fi

if (( ${#unsigned_tags} )); then
  print -u2 "[❌] pre-push: ${#unsigned_tags} annotated tag(s) in this push carry no signature:"
  typeset t
  for t in "${unsigned_tags[@]}"; do
    print -u2 "       ${t}"
  done
  print -u2 "     Re-create with \`git tag -s -f <name> <commit>\`, then push again."
  print -u2 "     Override (the user, in their OWN terminal): GIT_SIGN_SKIP=1 git push …"
  exit 1
fi

if (( ${#unsigned} )); then
  print -u2 "[❌] pre-push: ${#unsigned} commit(s) in this push carry no signature:"
  typeset s
  for s in "${unsigned[@]}"; do
    print -u2 "       $(git log --no-walk --format='%h %s' "${s}" 2>/dev/null || print -r -- "${s}")"
  done
  print -u2 "     Re-signing rewrites SHAs and a pushed SHA is permanent, so this is"
  print -u2 "     blocked. Run \`git-sign-unpushed\` in the repo, then push again."
  print -u2 "     Override (the user, in their OWN terminal): GIT_SIGN_SKIP=1 git push …"
  exit 1
fi

# --- Layer 2: outgoing-message PII/secret gate ------------------------------

if (( ${#outgoing} || ${#tag_objs} )); then
  msgs="$(mktemp "${TMPDIR:-/tmp}/pii-push-msgs.XXXXXX")"
  trap '/bin/rm -f "${msgs}"' EXIT

  # One `git log --stdin` however many commits are outgoing (a 1000-commit
  # first push must not fork per sha), fed by here-string (see Layer 0).
  # `commit <sha>` marker lines attribute hits; their hex cannot match either
  # token shape or a hostname pattern.
  {
    if (( ${#outgoing} )); then
      # shellcheck disable=SC2296  # ${(F)…} newline-join, zsh flag syntax --shell=bash cannot parse
      git log --no-walk=unsorted --stdin --format='commit %H%n%B' \
        <<< "${(F)outgoing}"
    fi
    typeset t
    for t in "${tag_objs[@]}"; do
      print -r -- "tag ${t}"
      _tag_message "${t}"
    done
  } > "${msgs}"

  # gitleaks over the messages, the pattern from gitleaks issue #800
  # (`git log --format=%B | gitleaks stdin`); it never scans message text in
  # any git mode. Output shown only on failure. Any nonzero rc blocks: 1 = leak,
  # >=2 = broken config.
  if ! command -v gitleaks &>/dev/null; then
    print -u2 "[❌] pre-push: gitleaks not found (brew install gitleaks); refusing to push unscanned messages."
    exit 1
  fi
  typeset -i gl_rc=0
  gl_out="$(gitleaks stdin < "${msgs}" 2>&1)" || gl_rc=$?
  if (( gl_rc )); then
    print -u2 "[❌] pre-push: gitleaks flagged outgoing commit/tag messages (rc=${gl_rc}):"
    print -u2 "${gl_out}"
    exit 1
  fi

  # PII layers (denylist + MAC/UUID tokens), shared with pre-commit and
  # commit-msg. Failure means rewriting the unpushed range.
  if ! "${0:A:h}/pii-scan" "${msgs}" "Outgoing commit/tag messages"; then
    print -u2 "     Rewrite the unpushed message(s) (git commit --amend / rebase -i reword),"
    print -u2 "     re-sign if needed, then push again. Nothing has been published."
    exit 1
  fi
fi

# --- Layer 3: public-repository message policy ------------------------------

visibility="$("${0:A:h}/repo-visibility" 2>/dev/null || print unknown)"
typeset -i public_repo=1
[[ "${visibility}" == private ]] && public_repo=0
if [[ -n "${MSG_POLICY_SKIP:-}" ]]; then
  if "${0:A:h}/pii-scan" --check-terminal; then
    print -u2 "[⚠️ ] MSG_POLICY_SKIP=1 — public-repo message policy and tree scan skipped"
    public_repo=0
  else
    print -u2 "[❌] MSG_POLICY_SKIP=1 ignored: no controlling terminal; give the user the exact command to run in their OWN terminal."
  fi
fi

if (( public_repo && ${#outgoing} )); then
  max_words="$(git config --get hooks.maxBodyWords 2>/dev/null || true)"
  [[ "${max_words}" =~ ^[0-9]+$ ]] || max_words=120
  typeset -a policy_hits=()
  typeset sha full body parents ptree n
  for sha in "${outgoing[@]}"; do
    full="$(git log -1 --format=%B "${sha}" 2>/dev/null || true)"
    if [[ $'\n'"${full}" == *$'\n'Ledger-Event:* || $'\n'"${full}" == *$'\n'Claude-Session:* ]]; then
      policy_hits+=("${sha} carries a Ledger-Event or Claude-Session trailer")
    fi
    parents="$(git rev-list --parents -n 1 "${sha}" 2>/dev/null || true)"
    # "sha parent" = exactly one parent; a root or a merge is never "empty".
    if [[ "${parents}" == *" "* && "${parents#* }" != *" "* ]]; then
      ptree="$(git rev-parse "${parents#* }^{tree}" 2>/dev/null || true)"
      if [[ -n "${ptree}" && "${ptree}" == "$(git rev-parse "${sha}^{tree}" 2>/dev/null)" ]]; then
        policy_hits+=("${sha} is an empty commit (same tree as its parent)")
      fi
    fi
    body="$(git log -1 --format=%b "${sha}" 2>/dev/null || true)"
    n="$(wc -w <<< "${body}")"
    n="${n// /}"
    if (( n > max_words )); then
      policy_hits+=("${sha} body is ${n} words (limit ${max_words})")
    fi
  done
  if (( ${#policy_hits} )); then
    print -u2 "[❌] pre-push: this repository is ${visibility}; ${#policy_hits} commit(s) break the public-repo message policy:"
    typeset h
    for h in "${policy_hits[@]}"; do
      print -u2 "       $(git log --no-walk --format='%h %s' "${h%% *}" 2>/dev/null || print -r -- "${h%% *}") — ${h#* }"
    done
    print -u2 "     A public commit message says WHAT changed, in a subject and at most a short body."
    print -u2 "     Reword (git commit --amend / rebase -i), drop empty commits, then push again."
    print -u2 "     Override (the user, in their OWN terminal): MSG_POLICY_SKIP=1 git push …"
    exit 1
  fi
fi

# --- Layer 4: public-repository tracked-tree scan ---------------------------

# Per-repo deferral for a public repo whose tracked files predate the denylist:
# `git config hooks.treeScan false`. Loud, so it is never mistaken for clean.
typeset -i tree_scan_on=1
if [[ "$(git config --bool --get hooks.treeScan 2>/dev/null || true)" == "false" ]]; then
  print -u2 "[⚠️ ] hooks.treeScan=false — public-repo tracked-tree scan deferred for this repository"
  tree_scan_on=0
fi

if (( public_repo && tree_scan_on && ${#tips} )); then
  tree_tmp="$(mktemp -d "${TMPDIR:-/tmp}/pii-push-tree.XXXXXX")"
  tree_scan="$(mktemp "${TMPDIR:-/tmp}/pii-push-treescan.XXXXXX")"
  trap '/bin/rm -rf "${tree_tmp}" "${tree_scan}" "${msgs:-}"' EXIT
  typeset tip tpath tar_file
  for tip in "${tips[@]}"; do
    /usr/bin/find "${tree_tmp:?}" -mindepth 1 -delete
    tar_file="${tree_tmp}/tree.tar"
    # Two steps, never a pipeline (a SIGPIPE'd producer fails open).
    if ! git archive --format=tar -o "${tar_file}" "${tip}" 2>/dev/null; then
      print -u2 "[❌] pre-push: could not materialise the tree of ${tip} for the PII scan; refusing to push."
      exit 1
    fi
    /usr/bin/tar -xf "${tar_file}" -C "${tree_tmp}"
    /bin/rm -f "${tar_file}"
    : > "${tree_scan}"
    while IFS= read -r tpath || [[ -n "${tpath}" ]]; do
      [[ -f "${tree_tmp}/${tpath}" && ! -L "${tree_tmp}/${tpath}" ]] || continue
      /usr/bin/grep -qI '' "${tree_tmp}/${tpath}" 2>/dev/null || continue
      { print -r -- "file ${tpath}"; /bin/cat "${tree_tmp}/${tpath}"; print; } >> "${tree_scan}"
    done <<< "$(git ls-tree -r --name-only "${tip}" 2>/dev/null)"
    if ! "${0:A:h}/pii-scan" "${tree_scan}" "Tracked tree of $(git rev-parse --short "${tip}") (public repo)"; then
      print -u2 "     A tracked file at the pushed tip carries a denylisted value or a real-looking token."
      print -u2 "     Remove it from the file (and from the unpushed history that added it), then push again."
      exit 1
    fi
  done
fi

exit 0
