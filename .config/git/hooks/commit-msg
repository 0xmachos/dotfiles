#!/usr/bin/env zsh
# .config/git/hooks/commit-msg
#
# Global commit-MESSAGE PII gate for EVERY repo, via the global core.hooksPath
# in .config/git/config. Added 2026-08-17: nothing else scanned message text
# (pre-commit never sees it) and a hostname in a message becomes permanent
# signed history.
#
# `applypatch-msg` is a symlink to this file: `git am` never runs commit-msg
# (githooks(5)). ${0:t} keeps the sentinel and chain target per hook type.
#
# Scans the NORMALISED message. commit-msg runs BEFORE --cleanup (verified
# 2026-08-17, git 2.54), so on `git commit -v` $1 still holds the status
# template, scissors line and whole diff; a raw scan would re-flag staged
# content, and allowlisted lines would not match with their diff prefixes.
# Normalise = truncate at the scissors line (stripspace does not), then
# `git stripspace --strip-comments` (honours core.commentChar/commentString;
# auto falls back to `#`, which scans more, not less).
#
# Known gap, closed downstream: `git commit -m/-F` keeps `#` lines but they
# are stripped here, so PII behind a `#` passes. Same for paths that skip this
# hook: cherry-pick, revert, plain rebase replay, commit-tree plumbing (all
# verified not to fire it) and --no-verify. Fast feedback only: pre-push scans
# the stored message of every outgoing commit and is the boundary.
# Secrets (gitleaks) are not checked here: pre-push runs it over the whole
# range; per commit would double gitleaks latency machine-wide.
#
# Bypass (2026-09-25): --no-verify (whole hook, silent, git's own, cannot be
# refused from inside a hook); PII_HOOK_BYPASS=1 (scan layers, loud, handled
# in pii-scan); MSG_POLICY_SKIP=1 (public-repo policy layer only, loud,
# handled below). The latter two are honoured ONLY with a controlling
# terminal (pii-scan --check-terminal); from an agent the layer runs anyway
# and one refusal line names the command to hand the user.
#
# Public-repo message policy (added 2026-09-22; fast feedback for pre-push
# Layer 3): when `repo-visibility` says public or unknown, no `Ledger-Event:`
# or `Claude-Session:` trailer and a body of at most `hooks.maxBodyWords`
# words (default 120). Empty commits are NOT judged here: `--allow-empty` and
# `--amend` both arrive with nothing staged; pre-push Layer 3 owns that rule.
#
# ShellCheck: lint with `shellcheck --shell=bash .config/git/hooks/commit-msg`.

set -euo pipefail

msgfile="$1"
hook_type="${0:t}"

# Re-entry guard, same as the sibling hooks: scoped to hook name AND repo (a
# repo-A hook committing in repo B must not skip B's scan).
sentinel="${hook_type}@$(git rev-parse --absolute-git-dir)"
sentinel="${sentinel// /_}"
case " ${GIT_GLOBAL_HOOKS_SEEN:-} " in
  (*" ${sentinel} "*) exit 0 ;;
esac
export GIT_GLOBAL_HOOKS_SEEN="${GIT_GLOBAL_HOOKS_SEEN:-} ${sentinel}"

# --- Layer 0: chain to the repo's own default-location hook -----------------

# Runs BEFORE scanning: a repo hook may rewrite the message, and the final
# text is what must be scanned. Common git dir for linked worktrees; not
# --git-path, which resolves core.hooksPath and re-enters this hook.
repo_hook="$(git rev-parse --git-common-dir)/hooks/${hook_type}"
if [[ -x "${repo_hook}" && "${repo_hook:A}" != "${0:A}" ]]; then
  "${repo_hook}" "$@" || exit $?
fi

# --- Normalise to what git will store ---------------------------------------

scan_tmp="$(mktemp "${TMPDIR:-/tmp}/pii-msg.XXXXXX")"
raw_tmp="$(mktemp "${TMPDIR:-/tmp}/pii-msg-raw.XXXXXX")"
trap '/bin/rm -f "${scan_tmp}" "${raw_tmp}"' EXIT

cchar="$(git config --get core.commentString 2>/dev/null \
           || git config --get core.commentChar 2>/dev/null \
           || echo '#')"
[[ "${cchar}" == "auto" ]] && cchar='#'

# Scissors truncation by hand: no pipeline; the read loop keeps a final
# unterminated line via `|| [[ -n ]]`.
scissors="${cchar} ------------------------ >8 ------------------------"
while IFS= read -r line || [[ -n "${line}" ]]; do
  [[ "${line}" == "${scissors}" ]] && break
  print -r -- "${line}"
done < "${msgfile}" > "${raw_tmp}"

git stripspace --strip-comments < "${raw_tmp}" > "${scan_tmp}"

# --- Layers 2+3: shared PII scanner -----------------------------------------

if ! "${0:A:h}/pii-scan" "${scan_tmp}" "Commit message"; then
  echo "     The message text is preserved in $(git rev-parse --git-dir)/COMMIT_EDITMSG." >&2
  exit 1
fi

# --- Layer 4: public-repository message policy (fast feedback) --------------

if [[ -n "${MSG_POLICY_SKIP:-}" ]]; then
  if "${0:A:h}/pii-scan" --check-terminal; then
    echo "[⚠️ ] MSG_POLICY_SKIP=1 — public-repo message policy skipped for this commit" >&2
    exit 0
  fi
  echo "[❌] MSG_POLICY_SKIP=1 ignored: no controlling terminal; give the user the exact command to run in their OWN terminal." >&2
fi
visibility="$("${0:A:h}/repo-visibility" 2>/dev/null || echo unknown)"
if [[ "${visibility}" != private ]]; then
  msg="$(< "${scan_tmp}")"
  max_words="$(git config --get hooks.maxBodyWords 2>/dev/null || true)"
  [[ "${max_words}" =~ ^[0-9]+$ ]] || max_words=120
  typeset -a policy_hits=()
  if [[ $'\n'"${msg}" == *$'\n'Ledger-Event:* || $'\n'"${msg}" == *$'\n'Claude-Session:* ]]; then
    policy_hits+=("carries a Ledger-Event or Claude-Session trailer")
  fi
  body="${msg#*$'\n'}"
  [[ "${body}" == "${msg}" ]] && body=""
  n="$(wc -w <<< "${body}")"
  n="${n// /}"
  (( n > max_words )) && policy_hits+=("body is ${n} words (limit ${max_words})")
  git_dir="$(git rev-parse --git-dir 2>/dev/null || true)"
  if (( ${#policy_hits} )); then
    echo "[❌] commit-msg: this repository is ${visibility}; the message breaks the public-repo policy:" >&2
    typeset h
    for h in "${policy_hits[@]}"; do echo "       ${h}" >&2; done
    echo "     A public commit message says WHAT changed: a subject and at most a short body." >&2
    echo "     The message text is preserved in ${git_dir:-.git}/COMMIT_EDITMSG." >&2
    echo "     Override (the user, in their OWN terminal): MSG_POLICY_SKIP=1 git commit …" >&2
    exit 1
  fi
fi
