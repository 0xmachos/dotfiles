#!/usr/bin/env zsh
# .config/git/hooks/pre-commit
#
# Global pre-commit scanner for EVERY repo, via the global core.hooksPath in
# .config/git/config, which points at this directory in the dotfiles repo, so
# a sync delivers hooks and config atomically. The dotfiles repo's own local
# core.hooksPath (.githooks/) shadows it; its pre-commit chains here. Sibling
# hook types are pass-through symlinks to hook-forward.
#
# Order: the repo's own default-location pre-commit runs FIRST (hooks
# commonly format and `git add`; anything staged after scanning would enter
# the commit unscanned), so scanning sees the final index.
#
#   0. Chain      — the repo's .git/hooks/pre-commit (common dir); its failure
#                   aborts with its exit status
#   1. gitleaks   — secret scan of the staged diff
#   2+3. pii-scan — literal PII denylist + MAC/UUID token detector over the
#                   staged additions and pathnames. The core, allowlist
#                   semantics, seams and PII_HOOK_BYPASS live in pii-scan
#                   (extracted 2026-08-17; shared with commit-msg and the
#                   pre-push message gate).
#
# Known gaps: binary files produce no diff hunks, so their CONTENT passes
# layers 1-3 unscanned (pathname only); reference-transaction and
# post-index-change are deliberately not forwarded (they fire on every
# ref/index write).
#
# Bypass (2026-09-25): PII_HOOK_BYPASS=1 skips layers 2+3 loudly, ONLY with a
# controlling terminal (pii-scan --check-terminal); from an agent it is
# ignored and the scan runs. gitleaks runs either way. --no-verify skips the
# whole hook silently and, being git's own, cannot be refused from inside it.

set -euo pipefail

# Re-entry guard, shared with hook-forward: a chained hook dispatching back
# into the global hooks (e.g. `git hook run pre-commit`) exits instead of
# looping. Scoped to hook name AND repo: a repo-A hook that commits in repo B
# must not skip B's scan. Spaces in the git-dir path fold to `_` so the token
# stays one word in the space-delimited list (a split token would break the
# guard and allow a loop; a collision only over-skips).
# One rev-parse answers both questions, one line each: [1] the absolute git
# dir (sentinel), [2] the common dir (repo-hook chain). A path holding a
# newline would misalign the lines, so such a repo falls back to one call per
# answer.
typeset -a git_dirs
# shellcheck disable=SC2296  # (@f) line-split flag is zsh syntax --shell=bash cannot parse
git_dirs=("${(@f)$(git rev-parse --absolute-git-dir --git-common-dir)}")
if (( ${#git_dirs} != 2 )); then
  git_dirs=("$(git rev-parse --absolute-git-dir)" "$(git rev-parse --git-common-dir)")
fi
sentinel="pre-commit@${git_dirs[1]}"
sentinel="${sentinel// /_}"
case " ${GIT_GLOBAL_HOOKS_SEEN:-} " in
  (*" ${sentinel} "*) exit 0 ;;
esac
export GIT_GLOBAL_HOOKS_SEEN="${GIT_GLOBAL_HOOKS_SEEN:-} ${sentinel}"

# --- Layer 0: chain to the repo's own default-location hook -----------------

# Runs BEFORE scanning so anything the repo hook stages is scanned too.
# --git-common-dir: linked worktrees share the main repo's .git/hooks. Not
# `git rev-parse --git-path hooks`: that resolves core.hooksPath and would
# re-enter this script forever; the sentinel above is the second guard.
repo_hook="${git_dirs[2]}/hooks/pre-commit"
if [[ -x "${repo_hook}" && "${repo_hook:A}" != "${0:A}" ]]; then
  # In `cmd || exit $?`, $? on the right of || is cmd's own status.
  "${repo_hook}" || exit $?
fi

# --- Layer 1: gitleaks ------------------------------------------------------

if ! command -v gitleaks &>/dev/null; then
  echo "[❌] gitleaks not found. Install via: brew install gitleaks"
  exit 1
fi

gitleaks protect --staged --verbose

# ${TMPDIR:-/tmp}/ not the house ${TMPDIR}… idiom: this hook runs wherever
# git does, and a slashless TMPDIR would make the template /tmppii-… and
# block every commit (macOS guarantees the slash).
pii_scan="$(mktemp "${TMPDIR:-/tmp}/pii-scan.XXXXXX")"
trap '/bin/rm -f "${pii_scan}"' EXIT

# Target = added CONTENT (leading `+` stripped so a line beginning `++` is
# not mistaken for the `+++` header) plus staged PATHNAMES (a private
# filename added via `git add -f` is caught even when its content is clean).
# Materialised into a file, not piped into `grep -q`: under pipefail an early
# match SIGPIPEs `git diff` (141) and a real match would read as no-match, a
# fail-OPEN leak. The diff must be config-invariant (repo-local
# color.ui=always, diff.external or textconv would break the awk anchors and
# empty the target), hence the -c override and --no-* flags.
{
  git -c color.ui=false diff --cached --no-color --no-ext-diff --no-textconv \
      --diff-filter=d -U0 | awk '
    /^diff --git/   { inhunk = 0; next }
    /^@@/           { inhunk = 1; next }
    inhunk && /^\+/ { print substr($0, 2) }
  '
  git -c color.ui=false diff --cached --no-color --name-only --diff-filter=d
} > "${pii_scan}"

"${0:A:h}/pii-scan" "${pii_scan}" "Staged changes (content or filename)" || exit $?
