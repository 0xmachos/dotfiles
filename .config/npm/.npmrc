# .npmrc
# https://docs.npmjs.com/cli/v11/using-npm/config

# Skip packages published less than 3 days ago (uv's exclude-newer); integer
# days. Override: --min-release-age=0
min-release-age=3

# Block preinstall/postinstall/install lifecycle scripts (Node's setup.py
# attacks). Override: --ignore-scripts=false or per-project .npmrc
ignore-scripts=true

# Save exact versions (no ^ or ~): no range drift into a compromised
# minor/patch release
save-exact=true

# "none" blocks all git dependencies; override --allow-git=root for direct
# deps. Becomes the default in npm 12.
allow-git=none

# Default is true; explicit so a project-level .npmrc can't downgrade it to
# false (WTFpkg npmrc-manipulation attack class).
strict-ssl=true

# Prefer cached packages; remote only when not cached. Reduces exposure to
# registry compromise and npx typosquatting.
prefer-offline=true

# Minimum vulnerability level for npm audit to exit non-zero. "low" adds noise
# (informational prototype pollution, ReDoS in unused transitive deps);
# moderate catches everything actionable.
# bin/npm-audit-check runs audit and audit signatures on demand (manual,
# whole-tree, not scheduled); the signatures audit passes --userconfig=/dev/null
# so min-release-age / prefer-offline don't abort it with ETARGET on a
# freshly-updated tree.
audit-level=moderate
