#!/bin/zsh
# dotfiles/tests/gh-auth
#
# Live assertions on THIS machine's GitHub auth: the real global git config,
# ~/.ssh/config, gh state and login keychain (the tests/okf pattern, not a
# hermetic sandbox). Three groups, reported apart:
#   signing — gpg.format=ssh, commit/tag gpgsign on, user.signingkey set,
#     ~/.ssh/config routes IdentityAgent to Secretive's socket (every
#     signature is a Secure Enclave operation).
#   push credential — gh token scopes within GH_AUTH_ALLOWED_SCOPES (repo,
#     read:org, gist are gh's minimum; workflow pushes under
#     .github/workflows/); credential.helper for github.com and
#     gist.github.com is [blank, gh] per .config/git/config; no keychain
#     internet password for either host (metadata only, secret never read);
#     no token line in hosts.yml; no ~/.git-credentials or ~/.netrc.
#   server — an active required_signatures ruleset on the default branch,
#     no bypass actors, read through gh.
# Skips, not fails: gh missing or logged out, no network. A skip is "could
# not check", never "checked and fine".
#
# Run: ./test gh-auth    (or ./test for the full suite)
# ShellCheck: lint with `shellcheck --shell=bash tests/gh-auth`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

# Any other scope fails, with the removal command in the message.
readonly -a GH_AUTH_ALLOWED_SCOPES=(repo read:org gist workflow)

function _gha_signing {
  _section "gh-auth — signing is Secretive-gated"

  local val

  val="$(git config --global --get gpg.format 2>/dev/null || true)"
  if [[ "${val}" == "ssh" ]]; then
    _pass "gpg.format is ssh"
  else
    _fail "gpg.format is '${val:-unset}', expected ssh"
  fi

  val="$(git config --global --get commit.gpgsign 2>/dev/null || true)"
  if [[ "${val}" == "true" ]]; then
    _pass "commit.gpgsign is true"
  else
    _fail "commit.gpgsign is '${val:-unset}', expected true"
  fi

  val="$(git config --global --get tag.gpgsign 2>/dev/null || true)"
  if [[ "${val}" == "true" ]]; then
    _pass "tag.gpgsign is true"
  else
    _fail "tag.gpgsign is '${val:-unset}', expected true"
  fi

  val="$(git config --global --get user.signingkey 2>/dev/null || true)"
  if [[ -n "${val}" ]]; then
    _pass "user.signingkey is set (${val})"
  else
    _fail "user.signingkey is unset"
  fi

  # `ssh -G`, not a grep: IdentityAgent sits in a `Match exec "test -S …"`
  # block, so only the effective value shows whether it fires.
  local sock="${HOME}/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh"
  local agent
  if [[ ! -f ${HOME}/.ssh/config ]]; then
    _skip "${HOME}/.ssh/config absent on this machine"
  elif [[ ! -S ${sock} ]]; then
    _skip "Secretive's agent socket absent on this machine"
  else
    agent=$(/usr/bin/ssh -G github.com </dev/null 2>/dev/null) || agent=""
    if [[ ${agent} == *$'\n'"identityagent ${sock}"$'\n'* ]]; then
      _pass "${HOME}/.ssh/config routes the agent socket to Secretive"
    else
      _fail "${HOME}/.ssh/config does not route IdentityAgent to Secretive's socket"
    fi
  fi
}

function _gha_token_scopes {
  # `gh auth status` validates over the network and prints `- Token scopes:
  # 'repo', 'read:org', ...`. Output is never echoed (carries the masked token).
  local out line scope bad="" extra=""
  local -a scopes

  out="$(gh auth status -h github.com 2>&1 || true)"

  if [[ "${out}" == *"not logged in"* || "${out}" == *"You are not logged into"* ]]; then
    _skip "gh is logged out — no token to check"
    return
  fi

  line=""
  # shellcheck disable=SC2066,SC2296  # zsh (@f) line split
  for line in "${(@f)out}"; do
    [[ "${line}" == *"Token scopes:"* ]] && break
    line=""
  done
  if [[ -z "${line}" ]]; then
    _skip "gh auth status gave no scope line (offline, or the login keychain is locked — e.g. over SSH) — token scopes NOT checked"
    return
  fi

  line="${line#*Token scopes:}"
  line="${line//\'/}"
  line="${line//,/ }"
  # shellcheck disable=SC2206  # zsh ${=} word split is the intent
  scopes=(${=line})

  # A fine-grained PAT has no OAuth scopes; its permissions are visible only
  # on the web (settings/personal-access-tokens), so the check stops here.
  if (( ${#scopes[@]} == 0 )) || [[ "${scopes[1]}" == "none" ]]; then
    _pass "gh token has no OAuth scopes (fine-grained PAT) — review its permissions at github.com/settings/personal-access-tokens"
    return
  fi

  for scope in "${scopes[@]}"; do
    if (( ${GH_AUTH_ALLOWED_SCOPES[(Ie)${scope}]} == 0 )); then
      extra+="${scope},"
    fi
  done
  extra="${extra%,}"

  if [[ -z "${extra}" ]]; then
    _pass "gh token scopes are within {${GH_AUTH_ALLOWED_SCOPES[*]}}: ${scopes[*]}"
  else
    bad="gh token carries scope(s) outside the allow-list: ${extra}"
    _fail "${bad} — drop with: gh auth refresh -h github.com --remove-scopes ${extra}"
  fi
}

function _gha_credential_helper {
  # The blank first entry clears osxkeychain from Xcode's system config;
  # anything else means git can push with a credential gh does not manage.
  local host chain
  local -a entries

  for host in github.com gist.github.com; do
    chain="$(git -C "${SCRIPT_DIR}" config --get-all "credential.https://${host}.helper" 2>/dev/null || true)"
    # shellcheck disable=SC2296  # zsh (@f) line split
    entries=("${(@f)chain}")
    if (( ${#entries[@]} == 2 )) && [[ -z "${entries[1]}" && "${entries[2]}" == *"gh auth git-credential" ]]; then
      _pass "credential helper for https://${host} is gh alone (chain cleared first)"
    else
      _fail "credential helper chain for https://${host} is not [blank, gh]: '${chain//$'\n'/ | }'"
    fi
  done
}

function _gha_no_stray_credentials {
  # Without -w, find-internet-password never prints the secret. Exit 44
  # (not found) is the pass.
  local host

  for host in github.com gist.github.com; do
    if /usr/bin/security find-internet-password -s "${host}" >/dev/null 2>&1; then
      _fail "login keychain still holds an internet password for ${host} — a second push credential outside gh's control (delete: security delete-internet-password -s ${host})"
    else
      _pass "no internet password for ${host} in the login keychain"
    fi
  done

  if [[ ! -f ${HOME}/.config/gh/hosts.yml ]]; then
    _skip "${HOME}/.config/gh/hosts.yml absent"
  elif grep -q 'oauth_token' "${HOME}/.config/gh/hosts.yml"; then
    _fail "hosts.yml holds an oauth_token line — token is on disk, not in the keyring"
  else
    _pass "hosts.yml holds no token (keyring storage)"
  fi

  local f
  for f in "${HOME}/.git-credentials" "${HOME}/.netrc"; do
    if [[ -e "${f}" ]]; then
      _fail "${f} exists — a plaintext credential store git or curl will read"
    else
      _pass "no ${f}"
    fi
  done
}

function _gha_server_ruleset {
  # Read through gh so the check uses the same token the push does.
  local nwo result

  nwo="$(cd "${SCRIPT_DIR}" && gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null || true)"
  if [[ -z "${nwo}" ]]; then
    _skip "could not resolve this repo on GitHub (offline, or gh cannot read its token — locked keychain over SSH) — ruleset NOT checked"
    return
  fi

  # shellcheck disable=SC2016  # $ids is jq's, not the shell's
  result="$(gh api "repos/${nwo}/rulesets" --paginate --jq '
    [ .[] | select(.enforcement == "active") | .id ] as $ids
    | if ($ids | length) == 0 then "none" else ($ids | map(tostring) | join(" ")) end' 2>/dev/null || true)"
  if [[ -z "${result}" ]]; then
    _skip "gh api rulesets failed (offline, or gh cannot read its token — locked keychain over SSH) — ruleset NOT checked"
    return
  fi
  if [[ "${result}" == "none" ]]; then
    _fail "${nwo} has no active ruleset — an unsigned commit can land on the default branch"
    return
  fi

  local id ok=0
  for id in ${=result}; do
    if [[ "$(gh api "repos/${nwo}/rulesets/${id}" --jq '
        ([.rules[].type] | index("required_signatures")) != null
        and (.conditions.ref_name.include | index("~DEFAULT_BRANCH")) != null
        and ((.bypass_actors // []) | length) == 0' 2>/dev/null)" == "true" ]]; then
      ok=1
      break
    fi
  done

  if (( ok )); then
    _pass "${nwo}: active required_signatures ruleset on the default branch, no bypass actors"
  else
    _fail "${nwo}: no active ruleset requires signatures on the default branch with zero bypass actors"
  fi
}

function run_gh_auth {
  # Signing and helper checks read the global git config that `bittersweet
  # dotfiles` symlinks from this repo. Where that link is absent (CI runner,
  # scratch clone) an empty config would read as a posture failure: skip.
  local live_cfg="${HOME}/.config/git/config"
  if [[ "${live_cfg:A}" != "${SCRIPT_DIR:A}/.config/git/config" ]]; then
    _section "gh-auth — signing is Secretive-gated"
    _skip "${live_cfg} is not this repo's .config/git/config — global git config not deployed here, signing and helper checks skipped"
    GHA_CONFIG_DEPLOYED=0
  else
    GHA_CONFIG_DEPLOYED=1
    _gha_signing
  fi

  _section "gh-auth — push credential is gh's narrowed token, nothing else"
  if ! [[ -x "$(command -v gh)" ]]; then
    _skip "gh not installed — token, helper and ruleset checks need it"
    return
  fi

  _gha_token_scopes
  if (( GHA_CONFIG_DEPLOYED )); then
    _gha_credential_helper
  fi
  _gha_no_stray_credentials

  _section "gh-auth — server refuses unsigned commits on this repo's default branch"
  _gha_server_ruleset
}
