#!/bin/zsh
# Regression tests for the shared test harness; no deployed hooks are required.
# One case per harness contract: _pass prints a backslash as written, an allow
# response reads INVALID through the seam and _hook_verdict, the seam hands a
# guard its variables and keeps the exported env inside its subshell, a guard's
# non-zero exit reads INVALID, a guard's readonly and set -e stay in its
# subshell, _json_str round-trips through jq, a DENY assertion fails on an
# allow response from other suites' helpers, the okf frontmatter validator
# flags each bad doc, a suite that aborts or calls exit ends the run with a
# FAIL naming it, and a full run waits for the full-run lock.
# shellcheck source=tests/lib

function run_test_helpers {
  _section "Hook verdict and frontmatter regressions"
  local out expected i

  # A message prints as written: a backslash in it is no escape, so `\u`
  # stays text and never becomes a NUL byte in the run log.
  out="$(_pass 'a \u-escaped \n name')"
  if [[ "${out}" == *'a \u-escaped \n name' && "${out}" != *$'\0'* ]]; then
    _pass "a message with backslashes prints as written"
  else
    _fail "a message with backslashes changed in output: ${out//$'\0'/<NUL>}"
  fi

  # _hook_run_seam: stub guards in a sandbox exercise each verdict class and
  # the seam contract (variables, exported env, `set --`, trailing-newline
  # strip, isolation of exit and readonly). US is 0x1f, as in the dispatcher.
  local seam_dir us=$'\x1f'
  seam_dir="$(mktemp -d "${TMPDIR:-/tmp}/seam-stubs.XXXXXX")"
  # shellcheck disable=SC2016  # the stub's own expansions, run by the guard
  print -r -- 'print -rn -- "DENY${us}cmd=[${HOOK_PRE_COMMAND}] tool=${HOOK_PRE_TOOL} path=${HOOK_PRE_PATH} content=${HOOK_PRE_CONTENT} cwd=${HOOK_PRE_CWD} env=${SEAM_PROBE-unset} argc=$# ctx=${ZSH_EVAL_CONTEXT}"' \
    | sed "s/\${us}/${us}/" > "${seam_dir}/deny"
  print -r -- 'print -r -- '\''{"hookSpecificOutput":{"permissionDecision":"allow"}}'\' > "${seam_dir}/allow"
  print -r -- 'print -u2 -- boom; exit 3' > "${seam_dir}/exit3"
  print -r -- 'readonly JQ=/usr/bin/jq; set -euo pipefail; umask 022' > "${seam_dir}/readonly"

  _hook_run_seam SEAM_PROBE=set -- "${seam_dir}/deny" Bash $'touch /tmp/x\n\n' '/p' $'body\n' '/work'
  expected='cmd=[touch /tmp/x] tool=Bash path=/p content=body cwd=/work env=set argc=0 ctx='
  if [[ "${HOOK_SEAM_VERDICT}" == DENY && "${HOOK_SEAM_REASON}" == "${expected}"*:file* && -z "${SEAM_PROBE-}" ]]; then
    _pass "seam: DENY line reads DENY; the guard saw the seam variables, the exported env, no arguments and a :file context, and the env did not leak"
  else
    _fail "seam: DENY stub read ${HOOK_SEAM_VERDICT}, reason '${HOOK_SEAM_REASON}', SEAM_PROBE='${SEAM_PROBE-}'"
  fi

  _hook_run_seam "${seam_dir}/allow" Bash 'ls'
  out="$(_hook_verdict '{"hookSpecificOutput":{"permissionDecision":"allow"}}')"
  if [[ "${HOOK_SEAM_VERDICT}" == INVALID && "${out}" == INVALID ]]; then
    _pass "an allow object reads INVALID through the seam and through _hook_verdict"
  else
    _fail "seam: allow object read ${HOOK_SEAM_VERDICT} (seam) and ${out} (standalone)"
  fi

  _hook_run_seam "${seam_dir}/exit3" Bash 'ls'
  # shellcheck disable=SC2153  # HOOK_SEAM_RC is set by tests/lib
  if [[ "${HOOK_SEAM_VERDICT}" == INVALID && "${HOOK_SEAM_RC}" == 3 && "${HOOK_SEAM_ERR}" == boom ]]; then
    _pass "seam: a guard's exit 3 reads INVALID, rc and stderr captured, the test shell survives"
  else
    _fail "seam: exit 3 stub read ${HOOK_SEAM_VERDICT} rc=${HOOK_SEAM_RC} err='${HOOK_SEAM_ERR}'"
  fi

  _hook_run_seam "${seam_dir}/readonly" Bash 'ls'
  _hook_run_seam "${seam_dir}/readonly" Bash 'ls'
  if [[ "${HOOK_SEAM_VERDICT}" == PASS && -z "${HOOK_SEAM_ERR}" && -z "${JQ-}" ]]; then
    _pass "seam: a guard's readonly, set -e and umask stay in its subshell (sourced twice)"
  else
    _fail "seam: readonly stub twice read ${HOOK_SEAM_VERDICT} err='${HOOK_SEAM_ERR}' JQ='${JQ-}'"
  fi

  /bin/rm -rf "${seam_dir}"

  # _json_str output must decode with jq back to the exact input: one string
  # takes the pure zsh escapes, the others carry a control character that only
  # the jq fallback escapes.
  local json_input=$'back\\slash "quote" new\nline\ttab cr\r ctl\x01 end'
  _json_str "${json_input}"
  if jq -e --arg s "${json_input}" '. == $s' >/dev/null 2>&1 <<< "${REPLY}"; then
    _pass "_json_str round-trips through jq: backslash, quote, newline, tab, CR and a control byte"
  else
    _fail "_json_str round-trip — got ${REPLY}"
  fi

  # Exercise the actual expectation functions with an allow mutant. The
  # counters are isolated, so the expected assertion failure does not leak.
  local suite runner assertion
  local -a expectations=(
    rm-redirect _hook_run_seam _rm_redirect_one
    gh-publish _gp_test_run _gp_test_expect
  )
  for (( i=1; i<=${#expectations}; i+=3 )); do
    suite="${expectations[i]}"
    runner="${expectations[i+1]}"
    assertion="${expectations[i+2]}"
    if (
      # shellcheck source=/dev/null
      source "${SCRIPT_DIR}/tests/${suite}"
      # zsh's function table installs a mock without evaluating user input.
      # Both runner shapes are mocked: a standalone runner prints the allow
      # object; a seam runner feeds it through the real classification.
      # shellcheck disable=SC2034,SC2004  # functions is an associative zsh table
      functions[${runner}]='print -r -- '\''{"hookSpecificOutput":{"permissionDecision":"allow"}}'\'
      # shellcheck disable=SC2034,SC2004,SC2154
      functions[_hook_run_seam]='_hook_seam_classify 0 '\''{"hookSpecificOutput":{"permissionDecision":"allow"}}'\'
      # shellcheck disable=SC2154  # shared counter from tests/lib
      local before=${fail_count}
      "${assertion}" DENY fixture fixture >/dev/null
      (( fail_count == before + 1 ))
    ); then
      _pass "${suite}: an allow response fails the DENY assertion"
    else
      _fail "${suite}: allow mutant escaped the assertion"
    fi
  done

  # shellcheck source=tests/okf disable=SC1091
  source "${SCRIPT_DIR}/tests/okf"
  # One awk run checks the whole bundle: a bad file must not leak state into
  # the files after it, each required key must be enforced, and the reserved
  # index and log are skipped.
  local bundle key k rc
  bundle="$(mktemp -d "${TMPDIR}okf-bundle.XXXXXX")"
  local good=$'---\ntype: reference\ntitle: fixture\ndescription: test\ntimestamp: today\n---\n'
  print -rn -- "${good}" > "${bundle}/a-good.md"
  print -rn -- "${good}" > "${bundle}/c-good.md"
  print -rn -- "${good}" > "${bundle}/f-good.md"
  for key in type title description timestamp; do
    {
      print -r -- '---'
      for k in type title description timestamp; do
        if [[ "${k}" != "${key}" ]]; then print -r -- "${k}: fixture"; fi
      done
      print -r -- '---'
    } > "${bundle}/b-no-${key}.md"
  done
  : > "${bundle}/d-empty.md"
  print -rn -- $'---\ntype: reference\n' > "${bundle}/e-unterminated.md"
  print -rn -- $'preface\n'"${good}" > "${bundle}/e-preface.md"
  : > "${bundle}/index.md"
  : > "${bundle}/log.md"
  out="$(_okf_check_conformance "${bundle}")"
  local line nfail=0 named=1
  while IFS= read -r line; do
    if [[ "${line}" == *FAIL* ]]; then (( nfail += 1 )); fi
  done <<< "${out}"
  for key in type title description timestamp; do
    if [[ "${out}" != *"b-no-${key}.md missing/empty frontmatter: ${key}"* ]]; then named=0; fi
  done
  local unterminated="missing/empty frontmatter: missing or unterminated leading frontmatter"
  if (( nfail == 7 && named )) &&
      [[ "${out}" == *"d-empty.md ${unterminated}"* && "${out}" == *"e-unterminated.md ${unterminated}"* &&
      "${out}" == *"e-preface.md ${unterminated}"* &&
      "${out}" != *PASS* && "${out}" != *"index.md"* && "${out}" != *"log.md"* ]]; then
    _pass "okf conformance flags each bad concept doc and only those"
  else
    _fail "okf conformance over a mixed bundle: ${out}"
  fi
  /bin/rm -rf "${bundle}"

  # A suite that aborts under `set -e` must end the run with a FAIL naming it,
  # in every run mode. The runner is copied beside a fixture suite so the real
  # suite list is untouched; the copy's own suite list is emptied for -j runs.
  local rdir mode label want
  rdir="$(mktemp -d "${TMPDIR}runner-abort.XXXXXX")"
  /bin/mkdir "${rdir}/tests"
  /bin/cp "${SCRIPT_DIR}/tests/lib" "${rdir}/tests/lib"
  /usr/bin/sed 's/^readonly -a SUITES=(.*/readonly -a SUITES=()/' "${SCRIPT_DIR}/test" > "${rdir}/test"
  print -r -- zz-abort > "${rdir}/.extra_test_suites"
  print -r -- zz-exit >> "${rdir}/.extra_test_suites"
  print -r -- 'function run_zz_abort { _pass before; ( false ) || :; false || :; false; _pass after }' \
    > "${rdir}/tests/zz-abort"
  print -r -- 'function run_zz_exit { _pass before; exit 0 }' > "${rdir}/tests/zz-exit"
  if [[ "$(<"${rdir}/test")" != *$'\nreadonly -a SUITES=()\n'* ]]; then
    _fail "runner: the copied runner kept its suite list, so the abort cases did not run"
    /bin/rm -rf "${rdir}"
    return 0
  fi
  for mode in "zz-abort" "zz-exit"; do
    label="${mode/zz-abort/one suite}"
    label="${label/zz-exit/stray exit}"
    want="${mode}"
    rc=0
    # shellcheck disable=SC2086  # $mode splits into the runner's arguments
    out="$(/usr/bin/env -u DOTFILES_TEST_CHILD DOTFILES_TEST_LOCK="${rdir}/full-run.lock" \
      "${ZSH_BIN}" "${rdir}/test" ${=mode} 2>&1)" || rc=$?
    if (( rc != 0 )) && [[ "${out}" == *"FAIL"*"${want}: suite aborted"* && "${out}" != *"PASS"*after* ]]; then
      _pass "runner: an aborted suite is a FAIL naming it and a nonzero exit (${label})"
    else
      _fail "runner: aborted suite (${label}) exit ${rc}: ${out}"
    fi
  done

  # A full run waits while another full run holds the lock, then runs. A
  # fixture holds the sandbox lock until the release file exists. Every poll
  # stops after 20 s.
  local lock="${rdir}/full-run.lock" release="${rdir}/release" holder_pid
  print -r -- zz-pass > "${rdir}/.extra_test_suites"
  print -r -- 'function run_zz_pass { _pass ok }' > "${rdir}/tests/zz-pass"
  : > "${lock}"
  : > "${lock}.holder"
  # shellcheck disable=SC2016  # the fixture shell expands $1, $2 and $$
  "${ZSH_BIN}" -c 'zmodload zsh/system zsh/zselect; zsystem flock -f fd "$1"
    print -r -- "pid $$ started fixture" > "$1.holder"
    for (( i = 0; i < 200; i++ )); do [[ -e "$2" ]] && break; zselect -t 10 || :; done' \
    _ "${lock}" "${release}" &
  holder_pid=$!
  for (( i = 0; i < 200; i++ )); do
    [[ -s "${lock}.holder" ]] && break
    zselect -t 10 || :
  done
  # shellcheck disable=SC2016  # the child shell expands $1..$3 and $?
  /usr/bin/env -u DOTFILES_TEST_CHILD DOTFILES_TEST_LOCK="${lock}" \
    "${ZSH_BIN}" -c '"$1" "$2" -j 1 > "$3/full.out" 2>&1; print -r -- $? > "$3/full.rc"' \
    _ "${ZSH_BIN}" "${rdir}/test" "${rdir}" &
  for (( i = 0; i < 200; i++ )); do
    [[ "$(<"${rdir}/full.out")" == *"holds the lock"* ]] 2>/dev/null && break
    zselect -t 10 || :
  done
  local waited=0
  [[ ! -e "${rdir}/full.rc" && "$(<"${rdir}/full.out")" != *"PASS"*ok* ]] && waited=1
  : > "${release}"
  for (( i = 0; i < 200; i++ )); do
    [[ -s "${rdir}/full.rc" ]] && break
    zselect -t 10 || :
  done
  rc="$(<"${rdir}/full.rc")" 2>/dev/null || rc=none
  out="$(<"${rdir}/full.out")"
  if (( waited )) && [[ "${rc}" == 0 && "${out}" == *"holds the lock (pid "*" started fixture)"*"PASS"*ok* ]]; then
    _pass "runner: a full run waits for the holder of the full-run lock, then runs"
  else
    _fail "runner: full run under a held lock, waited ${waited}, exit ${rc}: ${out}"
  fi
  wait "${holder_pid}" 2>/dev/null || :

  /bin/rm -rf "${rdir}"
}
