#!/bin/zsh
# dotfiles/tests/rex-remote-bridge
#
# Behavioural test for bin/rex-remote-bridge, the inetd-mode bridge from a
# local Unix socket to the Rex server on the remote Rex host. It covers the
# good connection (exact ssh argv, signature requirement, clean fd 1 and fd 2),
# the refusals (unsigned peer, failed pid lookup, kill switch, bad alias file),
# the server-only host skip, the real getsockopt pid lookup, the install step
# that creates the 0700 socket folder, the static plist and code contract, the
# mux path limit and the master-start lock. Every run uses a
# fake HOME under the suite sandbox and stub binaries (codesign, ssh, launchctl,
# peerpid) that record their calls, so nothing touches the real network, ssh,
# Rex or $HOME. The script runs with fd 1 and fd 2 on files that stand in for
# the socket. One case gives it a real Unix socket on fd 0 and the real perl
# pid lookup.
#
# Scenarios are set through the BR_* globals read by the stubs.
# One case runs bittersweet's install_launchagents against the fake HOME in its
# own zsh process under the script's strict mode, with only sudo and get_sudo
# stubbed, so a deploy step that aborts before the plist copy goes red here.
#
# REX_REMOTE_BRIDGE_UNDER_TEST, REX_REMOTE_BRIDGE_PLIST_UNDER_TEST and
# BITTERSWEET_UNDER_TEST point the suite at other copies of the script, the
# plist and bittersweet (used to prove the suite goes red when a check is
# broken).
#
# Run: ./test rex-remote-bridge
#
# ShellCheck: lint with `shellcheck --shell=bash tests/rex-remote-bridge`.
# This file is sourced, not executed - chmod 644.
#
# shellcheck source=tests/lib

typeset -g BR_T_BOX='' BR_T_STUBS='' BR_T_SCRIPT='' BR_T_PLIST='' BR_T_BITTERSWEET='' BR_T_HOME='' BR_T_CALLS='' BR_T_OUT='' BR_T_ERR=''
typeset -gi BR_T_RC=0 BR_T_SEQ=0 BR_T_ELAPSED_MS=0

# Scenario knobs, read by the stubs (see _br_t_reset for the defaults).
typeset -g BR_SERVER_JOB='' BR_LAUNCHCTL_HANG='' BR_PEER_PID='' BR_PEER_MODE=''
typeset -g BR_CS_MODE='' BR_CS_TEAM='' BR_T_DEADLINE='' BR_T_REAL_PEERPID='' BR_T_STDIN_FD='' BR_T_MUX_DIR='' BR_SSH_MASTER_FAIL=''
# The ssh argv after -T for the default mux folder (BR_T_MUX_DIR) and alias.
typeset -g BR_T_MUX_OPTS='-o ControlMaster=auto -o ControlPersist=2m -o ServerAliveInterval=15 -o ServerAliveCountMax=3'
# The master-start argv after -S <socket> -E <log>.
typeset -g BR_T_MASTER_OPTS='-o ControlPersist=2m -o ServerAliveInterval=15 -o ServerAliveCountMax=3'

function _br_t_make_stubs {
  local d="${BR_T_STUBS}"
  /bin/mkdir -p "${d}"

  # Stands in for the perl getsockopt lookup: prints BR_PEER_PID, or fails or
  # hangs by mode.
  cat > "${d}/peerpid" <<'MOCK'
#!/bin/zsh
print -r -- "peerpid" >> "${BR_CALLS}"
case "${BR_PEER_MODE}" in
  fail) exit 1 ;;
  hang) exec /bin/sleep 30 ;;
esac
print -r -- "${BR_PEER_PID}"
exit 0
MOCK

  # Passes only when the requirement names the team in BR_CS_TEAM.
  cat > "${d}/codesign" <<'MOCK'
#!/bin/zsh
print -r -- "codesign $*" >> "${BR_CALLS}"
[[ "${BR_CS_MODE}" == unsigned ]] && exit 1
[[ "$*" == *"\"${BR_CS_TEAM}\""* ]] || exit 3
exit 0
MOCK

  # Records its argv. A master start (-M) binds the -S socket and writes
  # nothing, or fails when BR_SSH_MASTER_FAIL is set. A control command (-O)
  # writes nothing. Any other call writes one line to fd 2 and one to fd 1.
  cat > "${d}/ssh" <<'MOCK'
#!/bin/zsh
print -r -- "ssh $*" >> "${BR_CALLS}"
local -a argv_copy=("$@")
local sock='' i
for (( i = 1; i < ${#argv_copy}; i++ )); do
  [[ "${argv_copy[i]}" == -S ]] && sock="${argv_copy[i+1]}"
done
if (( ${argv_copy[(Ie)-M]} )); then
  [[ -n "${BR_SSH_MASTER_FAIL}" ]] && exit 255
  zmodload zsh/net/socket
  zsocket -l "${sock}" || exit 255
  exit 0
fi
(( ${argv_copy[(Ie)-O]} )) && exit 0
print -r -- "ssh-warning" >&2
print -r -- "ssh-data"
exit 0
MOCK

  # `launchctl print gui/<uid>/<job>` exits 0 when the job exists (a server-only
  # host) and 113 when it does not.
  cat > "${d}/launchctl" <<'MOCK'
#!/bin/zsh
print -r -- "launchctl $*" >> "${BR_CALLS}"
[[ -n "${BR_LAUNCHCTL_HANG}" ]] && exec /bin/sleep 30
[[ -n "${BR_SERVER_JOB}" ]] && exit 0
exit 113
MOCK

  # Runs bittersweet's install_launchagents against $HOME under the script's
  # own strict mode. $1 = bittersweet, $2 = SCRIPT_DIR. Only sudo and get_sudo
  # are stubbed; the real _ensure_dir, mkdir, chmod, sed, plutil, mv and xattr
  # run. A separate process, never a forked `( )` subshell: on the left of `||`
  # or inside `if`, zsh does not abort a forked subshell on a fatal error such
  # as an unset parameter under set -u, so the case could never go red there.
  cat > "${d}/install-driver" <<'MOCK'
#!/bin/zsh
set -euo pipefail
SCRIPT_DIR="$2"
source <(/usr/bin/awk '
  /^function / || /^typeset -ra LAUNCHAGENT_PLISTS=\(/ { block = 1 }
  block { print }
  /^}$/ || /^\)$/ { block = 0 }
' "$1")
get_sudo() { :; }
sudo() { return 0; }
install_launchagents
MOCK

  /bin/chmod 755 "${d}/peerpid" "${d}/codesign" "${d}/ssh" "${d}/launchctl"
}

# Fresh fake HOME and call log; default scenario: a good, signed peer.
function _br_t_reset {
  BR_T_SEQ+=1
  BR_T_HOME="${BR_T_BOX}/case${BR_T_SEQ}/home"
  BR_T_CALLS="${BR_T_BOX}/case${BR_T_SEQ}/calls"
  BR_T_OUT="${BR_T_BOX}/case${BR_T_SEQ}/out"
  BR_T_ERR="${BR_T_BOX}/case${BR_T_SEQ}/err"
  /bin/mkdir -p "${BR_T_HOME}/Library/Logs" "${BR_T_HOME}/Library/Application Support/rex-remote-bridge"
  print -r -- test-host > "${BR_T_HOME}/Library/Application Support/rex-remote-bridge/ssh-host"
  : > "${BR_T_CALLS}"
  : > "${BR_T_OUT}"
  : > "${BR_T_ERR}"
  BR_SERVER_JOB=''
  BR_LAUNCHCTL_HANG=''
  BR_PEER_PID=4242
  BR_PEER_MODE=ok
  BR_CS_MODE=ok
  BR_CS_TEAM=AG92C3PT77
  BR_T_DEADLINE=5
  BR_T_REAL_PEERPID=''
  BR_T_STDIN_FD=''
  # A short relative folder: the script runs in the case folder, because an
  # absolute sandbox path is too long for a Unix socket.
  BR_T_MUX_DIR=m
  /bin/mkdir -p "${BR_T_BOX}/case${BR_T_SEQ}/m"
  BR_SSH_MASTER_FAIL=
}

# _br_t_run: run the script once with fd 1 and fd 2 on files (the socket
# stand-ins). fd 0 is /dev/null, or the fd in BR_T_STDIN_FD. Sets BR_T_RC and
# BR_T_ELAPSED_MS.
function _br_t_run {
  local -F start end
  local -i _br_t_in
  local -a peer_env=("RDB_PEERPID=${BR_T_STUBS}/peerpid")
  [[ -n "${BR_T_REAL_PEERPID}" ]] && peer_env=()
  local -a mux_env=("RDB_MUX_DIR=${BR_T_MUX_DIR}")
  [[ -z "${BR_T_MUX_DIR}" ]] && mux_env=()
  start="${EPOCHREALTIME}"
  if [[ -n "${BR_T_STDIN_FD}" ]]; then
    exec {_br_t_in}<&"${BR_T_STDIN_FD}"
  else
    exec {_br_t_in}</dev/null
  fi
  (cd "${BR_T_HOME:h}" && exec /usr/bin/env -i \
    PATH=/usr/bin:/bin \
    HOME="${BR_T_HOME}" \
    RDB_CODESIGN="${BR_T_STUBS}/codesign" \
    RDB_SSH="${BR_T_STUBS}/ssh" \
    RDB_LAUNCHCTL="${BR_T_STUBS}/launchctl" \
    "${peer_env[@]}" \
    "${mux_env[@]}" \
    RDB_DEADLINE="${BR_T_DEADLINE}" \
    BR_CALLS="${BR_T_CALLS}" \
    BR_SERVER_JOB="${BR_SERVER_JOB}" \
    BR_LAUNCHCTL_HANG="${BR_LAUNCHCTL_HANG}" \
    BR_PEER_PID="${BR_PEER_PID}" \
    BR_PEER_MODE="${BR_PEER_MODE}" \
    BR_CS_MODE="${BR_CS_MODE}" \
    BR_CS_TEAM="${BR_CS_TEAM}" \
    BR_SSH_MASTER_FAIL="${BR_SSH_MASTER_FAIL}" \
    /bin/zsh "${BR_T_SCRIPT}") <&"${_br_t_in}" > "${BR_T_OUT}" 2> "${BR_T_ERR}" && BR_T_RC=0 || BR_T_RC=$?
  exec {_br_t_in}<&-
  end="${EPOCHREALTIME}"
  BR_T_ELAPSED_MS=$(( (end - start) * 1000 ))
}

# Number of recorded calls whose line starts with $1 (result in REPLY).
function _br_t_count {
  local line
  local -i n=0
  while IFS= read -r line || [[ -n "${line}" ]]; do
    [[ "${line}" == "$1"* ]] && n+=1
  done < "${BR_T_CALLS}"
  REPLY="${n}"
}

function _br_t_call_has {
  local line
  while IFS= read -r line || [[ -n "${line}" ]]; do
    [[ "${line}" == "$1"* && "${line}" == *"$2"* ]] && return 0
  done < "${BR_T_CALLS}"
  return 1
}

# True if some recorded call line equals $1 exactly.
function _br_t_line_is {
  local line
  while IFS= read -r line || [[ -n "${line}" ]]; do
    [[ "${line}" == "$1" ]] && return 0
  done < "${BR_T_CALLS}"
  return 1
}

function _br_t_log_has {
  local line
  [[ -r "${BR_T_HOME}/Library/Logs/rex-remote-bridge.log" ]] || return 1
  while IFS= read -r line || [[ -n "${line}" ]]; do
    [[ "${line}" == *"$1"* ]] && return 0
  done < "${BR_T_HOME}/Library/Logs/rex-remote-bridge.log"
  return 1
}

# True for a refused connection: exit 1, no ssh, nothing on the socket
# stand-ins (fd 1 and fd 2), and a log line with the reason $1.
function _br_t_refused {
  (( BR_T_RC == 1 )) || return 1
  _br_t_count "ssh"
  [[ "${REPLY}" == 0 ]] || return 1
  [[ -z "$(<"${BR_T_OUT}")" && -z "$(<"${BR_T_ERR}")" ]] || return 1
  _br_t_log_has "$1"
}

# --- Cases ---------------------------------------------------------------

# Code and plist contract with no input: fd 2 leaves the socket first, ssh -N
# appears only on the master start, the plist is inetd no-wait on a 0600 Unix
# socket with no TCP listener and no StandardOutPath (fd 1 stays the socket).
function _br_t_static {
  _section "rex-remote-bridge: static contract"

  local first line code_first='' v ok=1
  local -i bad=0
  IFS= read -r first < "${BR_T_SCRIPT}"
  local re_comment='^[[:space:]]*(#|$)'
  local re_noN='(^|[[:space:]])-[A-Za-z]*N'
  while IFS= read -r line || [[ -n "${line}" ]]; do
    [[ "${line}" =~ $re_comment ]] && continue
    if [[ -z "${code_first}" && "${line}" != 'umask 077' ]]; then code_first="${line}"; fi
    if [[ "${line}" =~ $re_noN && "${line}" != *' -M -N -f '* ]]; then (( bad += 1 )); fi
  done < "${BR_T_SCRIPT}"
  [[ -x "${BR_T_SCRIPT}" && "${first}" == '#!/bin/zsh' && "${code_first}" == 'exec 2>>'* ]] || ok=0
  (( bad == 0 )) || ok=0

  local plist="${BR_T_PLIST}"
  /usr/bin/plutil -lint "${plist}" >/dev/null 2>&1 || ok=0
  v="$(/usr/libexec/PlistBuddy -c 'Print :inetdCompatibility:Wait' "${plist}" 2>/dev/null)"; [[ "${v}" == false ]] || ok=0
  v="$(/usr/libexec/PlistBuddy -c 'Print :Sockets:Listeners:SockPathMode' "${plist}" 2>/dev/null)"; [[ "${v}" == 384 ]] || ok=0
  v="$(/usr/libexec/PlistBuddy -c 'Print :Sockets:Listeners:SockType' "${plist}" 2>/dev/null)"; [[ "${v}" == stream ]] || ok=0
  /usr/bin/grep -q -E 'SockServiceName|SockNodeName|SockFamily' "${plist}" && ok=0
  v="$(/usr/libexec/PlistBuddy -c 'Print :StandardOutPath' "${plist}" 2>&1)" || :
  [[ "${v}" == *"Does Not Exist"* ]] || ok=0
  if (( ok )); then
    _pass "static: fd 2 moves to the log first, no -N outside the master start, plist is no-wait 0600 Unix socket with no TCP listener and no StandardOutPath"
  else
    _fail "static contract broken (code_first='${code_first}', -N lines ${bad})"
  fi
}

# bittersweet's install_launchagents against the fake HOME, in its own zsh
# process under strict mode. The folder starts at 755, so only the installer's
# chmod can bring it to 700.
function _br_t_installer {
  _section "rex-remote-bridge: install_launchagents creates the socket folder"

  _br_t_reset
  local folder="${BR_T_HOME}/Library/Application Support/rex-remote-bridge"
  /bin/chmod 755 "${folder}"
  local -i rc=0
  /usr/bin/env -i PATH=/usr/bin:/bin HOME="${BR_T_HOME}" \
    /bin/zsh "${BR_T_STUBS}/install-driver" "${BR_T_BITTERSWEET}" "${SCRIPT_DIR}" \
    >/dev/null 2> "${BR_T_ERR}" && rc=0 || rc=$?
  local mode
  mode="$(/usr/bin/stat -f %Lp "${folder}" 2>/dev/null)" || mode=''
  if (( rc == 0 )) && [[ "${mode}" == 700 && -f "${BR_T_HOME}/Library/LaunchAgents/com.0xmachos.rex-remote-bridge.plist" ]]; then
    _pass "install_launchagents: exits 0 under set -u, socket folder 700, plist copied"
  else
    _fail "install_launchagents wrong (rc ${rc}, folder mode '${mode}'): $(<"${BR_T_ERR}")"
  fi
}

# A good peer. The ssh-host file has a second line that must not matter.
function _br_t_good {
  _section "rex-remote-bridge: good peer"

  _br_t_reset
  print -r -- $'test-host\nsecond-line' > "${BR_T_HOME}/Library/Application Support/rex-remote-bridge/ssh-host"
  _br_t_run
  local ok=1 n_ssh
  _br_t_count "ssh"; n_ssh="${REPLY}"
  (( BR_T_RC == 0 && n_ssh == 2 )) || ok=0
  _br_t_line_is "ssh -M -N -f -S m/mux-test-host -E ${BR_T_HOME}/Library/Logs/rex-remote-bridge.log ${BR_T_MASTER_OPTS} test-host" || ok=0
  _br_t_line_is "ssh -T -S m/mux-test-host ${BR_T_MUX_OPTS} test-host" || ok=0
  # shellcheck disable=SC2016  # literal requirement text, not an expansion
  _br_t_call_has "codesign " '-R=anchor apple generic and certificate leaf[subject.OU] = "AG92C3PT77"' || ok=0
  [[ "$(<"${BR_T_CALLS}")" == *'" 4242'* ]] || ok=0
  _br_t_log_has "pid=4242 connect" || ok=0
  [[ "$(<"${BR_T_OUT}")" == "ssh-data" && -z "$(<"${BR_T_ERR}")" ]] || ok=0
  _br_t_log_has "ssh-warning" || ok=0
  if (( ok )); then
    _pass "good peer: exact master and session argv from the first alias line, Apple anchor and team on the peer pid, fd 1 is ssh data, fd 2 is the log"
  else
    _fail "good peer wrong (rc ${BR_T_RC}, ssh calls ${n_ssh}): $(<"${BR_T_CALLS}")"
  fi
}

# An unsigned peer is refused: no ssh, nothing on the socket.
function _br_t_unsigned {
  _section "rex-remote-bridge: unsigned peer"

  _br_t_reset
  BR_CS_MODE=unsigned
  _br_t_run
  if _br_t_refused "running process fails the signature requirement" && _br_t_log_has "pid=4242 refused"; then
    _pass "unsigned peer: refused with exit 1, no ssh, nothing on the socket, pid logged"
  else
    _fail "unsigned peer wrong (rc ${BR_T_RC}): $(<"${BR_T_CALLS}")"
  fi
}

# The real perl pid lookup on a real Unix socket names the connecting process,
# and on a non-socket fd 0 it fails closed.
function _br_t_real_socket {
  _section "rex-remote-bridge: real Unix socket"

  if ! zmodload zsh/net/socket 2>/dev/null; then
    _skip "zsh/net/socket unavailable"
    return 0
  fi
  local sock="${BR_T_BOX}/s.sock"
  local -i lfd afd ncpid
  if ! zsocket -l "${sock}"; then _fail "real socket: cannot listen"; return 0; fi
  lfd="${REPLY}"
  /usr/bin/nc -U "${sock}" < <(/bin/sleep 5) >/dev/null 2>&1 &
  ncpid=$!
  if ! zsocket -a "${lfd}"; then _fail "real socket: accept failed"; exec {lfd}<&-; return 0; fi
  afd="${REPLY}"

  _br_t_reset
  BR_T_REAL_PEERPID=1
  BR_T_STDIN_FD="${afd}"
  _br_t_run
  if (( BR_T_RC == 0 )) && _br_t_log_has "pid=${ncpid} connect" && _br_t_call_has "codesign " " ${ncpid}"; then
    _pass "real socket: the perl lookup names the connecting process and codesign checks that pid"
  else
    _fail "real socket wrong (rc ${BR_T_RC}, nc pid ${ncpid}): $(<"${BR_T_CALLS}")"
  fi

  exec {afd}<&- {lfd}<&-
  kill "${ncpid}" 2>/dev/null || :
  wait "${ncpid}" 2>/dev/null || :
}

# fd 0 is not a socket: the real lookup fails closed.
function _br_t_real_nonsocket {
  _section "rex-remote-bridge: real lookup on a non-socket"

  _br_t_reset
  BR_T_REAL_PEERPID=1
  _br_t_run
  if _br_t_refused "peer pid lookup failed"; then
    _pass "real pid lookup on a non-socket: refused with exit 1, no ssh"
  else
    _fail "non-socket lookup wrong (rc ${BR_T_RC}): $(<"${BR_T_CALLS}")"
  fi
}

# Kill switch while a master runs: the master is told to exit, the connection
# is refused and nothing else starts.
function _br_t_kill_switch {
  _section "rex-remote-bridge: kill switch"

  _br_t_reset
  : > "${BR_T_HOME}/Library/Application Support/rex-remote-bridge/disabled"
  (cd "${BR_T_HOME:h}" && /bin/zsh -c 'zmodload zsh/net/socket; zsocket -l m/mux-test-host')
  _br_t_run
  local n_ssh n_peer ok=1
  _br_t_count "ssh"; n_ssh="${REPLY}"
  _br_t_count "peerpid"; n_peer="${REPLY}"
  (( BR_T_RC == 1 && n_ssh == 1 && n_peer == 0 )) || ok=0
  _br_t_line_is "ssh -S m/mux-test-host -O exit test-host" || ok=0
  [[ -z "$(<"${BR_T_OUT}")" ]] || ok=0
  _br_t_log_has "kill switch told the master to exit rc=0" || ok=0
  if (( ok )); then
    _pass "kill switch: exit 1, the running master is told to exit, no peer lookup, nothing on the socket"
  else
    _fail "kill switch wrong (rc ${BR_T_RC}): $(<"${BR_T_CALLS}")"
  fi
}

# A launchd job owns the Rex server on this host: exit 0, silent, no bridge.
function _br_t_server_host {
  _section "rex-remote-bridge: server-only host"

  _br_t_reset
  BR_SERVER_JOB=1
  _br_t_run
  local n_peer n_ssh ok=1
  _br_t_count "peerpid"; n_peer="${REPLY}"
  _br_t_count "ssh"; n_ssh="${REPLY}"
  (( BR_T_RC == 0 && n_peer == 0 && n_ssh == 0 )) || ok=0
  _br_t_call_has "launchctl print gui/" "/com.local.rex-server" || ok=0
  [[ -z "$(<"${BR_T_OUT}")" && -z "$(<"${BR_T_ERR}")" && -z "$(<"${BR_T_HOME}/Library/Logs/rex-remote-bridge.log")" ]] || ok=0
  if (( ok )); then
    _pass "server-only host: exit 0, no peer lookup, no ssh, nothing on the socket, no log line"
  else
    _fail "server-only host wrong (rc ${BR_T_RC}, peer ${n_peer}, ssh ${n_ssh})"
  fi
}

# An alias that starts with a dash could be an ssh option: refused before any
# lookup.
function _br_t_bad_alias {
  _section "rex-remote-bridge: option-shaped alias"

  _br_t_reset
  print -rn -- '-oProxyCommand=sh' > "${BR_T_HOME}/Library/Application Support/rex-remote-bridge/ssh-host"
  _br_t_run
  _br_t_count "peerpid"
  if _br_t_refused "no valid ssh-host file" && [[ "${REPLY}" == 0 ]]; then
    _pass "alias -oProxyCommand=sh: refused with exit 1, no peer lookup, no ssh"
  else
    _fail "bad alias wrong (rc ${BR_T_RC}): $(<"${BR_T_CALLS}")"
  fi
}

# The mux socket path limit: 87 characters fall back to a plain login.
function _br_t_mux_long {
  _section "rex-remote-bridge: mux socket path too long"

  local fill dir87
  fill="$(/usr/bin/printf 'a%.0s' {1..70})"
  dir87="/x${fill}a"
  _br_t_reset
  BR_T_MUX_DIR="${dir87}"
  _br_t_run
  local n_ssh
  _br_t_count "ssh"; n_ssh="${REPLY}"
  if (( BR_T_RC == 0 && n_ssh == 1 )) && _br_t_line_is "ssh -T test-host" && _br_t_log_has "mux: socket path too long, plain login"; then
    _pass "87-character mux socket path: logged, falls back to plain ssh -T <alias>"
  else
    _fail "long mux path wrong (rc ${BR_T_RC}, ssh calls ${n_ssh}): $(<"${BR_T_CALLS}")"
  fi
}

# A failed master start is logged and the connection still goes on through
# ControlMaster=auto.
function _br_t_mux_fail {
  _section "rex-remote-bridge: master start fails"

  _br_t_reset
  BR_SSH_MASTER_FAIL=1
  _br_t_run
  if (( BR_T_RC == 0 )) && _br_t_log_has "mux: master start rc=255" \
      && _br_t_line_is "ssh -T -S m/mux-test-host ${BR_T_MUX_OPTS} test-host"; then
    _pass "master start fails: logged with rc, the session still starts with ControlMaster=auto"
  else
    _fail "master fail wrong (rc ${BR_T_RC}): $(<"${BR_T_CALLS}")"
  fi
}

# A burst: a second connection waits on the lock while the first starts the
# master. After the lock it must see the new socket and start no master.
function _br_t_mux_burst {
  _section "rex-remote-bridge: connection that waited on the lock"

  _br_t_reset
  local box="${BR_T_HOME:h}"
  : > "${box}/m/mux-test-host.lock"
  # The holder takes the lock, makes the socket after 1 s, then exits.
  (cd "${box}" && /bin/zsh -c 'zmodload zsh/system zsh/net/socket
    zsystem flock -f fd m/mux-test-host.lock || exit 1
    : > m/holding
    sleep 1
    zsocket -l m/mux-test-host') &
  local -i holder=$! n=0
  while [[ ! -e "${box}/m/holding" ]] && (( n < 50 )); do sleep 0.1; (( n += 1 )); done
  _br_t_run
  wait "${holder}"
  local n_master n_session
  _br_t_count "ssh -M"; n_master="${REPLY}"
  _br_t_count "ssh -T"; n_session="${REPLY}"
  if (( BR_T_ELAPSED_MS >= 500 && n_master == 0 && n_session == 1 )); then
    _pass "burst: the connection waited on the lock, started no second master, joined the new one"
  else
    _fail "burst wrong (${BR_T_ELAPSED_MS} ms, masters ${n_master}, sessions ${n_session})"
  fi
}

function run_rex_remote_bridge {
  zmodload zsh/datetime

  BR_T_SCRIPT="${REX_REMOTE_BRIDGE_UNDER_TEST:-${SCRIPT_DIR}/bin/rex-remote-bridge}"
  BR_T_PLIST="${REX_REMOTE_BRIDGE_PLIST_UNDER_TEST:-${SCRIPT_DIR}/LaunchAgents/com.0xmachos.rex-remote-bridge.plist}"
