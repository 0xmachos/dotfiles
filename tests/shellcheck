#!/bin/zsh
# dotfiles/tests/shellcheck
#
# Lints shell scripts in the repo root, .functions/, bin/, lib/, tests/, both
# git hook directories, claude/ and claude/hooks/, in bash mode (shellcheck has
# no native Zsh support; the ~95% overlap catches real issues, Zsh-only syntax
# is suppressed inline in each script).
#
# ShellCheck: lint with `shellcheck --shell=bash tests/shellcheck`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

function run_shellcheck {
  _section "ShellCheck"

  if ! command -v shellcheck >/dev/null 2>&1; then
    _fail "shellcheck not installed (brew install shellcheck)"
    return
  fi

  local -a shell_files=()
  local file desc
  # claude/ is gitignored, so a clean clone has no such directory.
  local -a claude_dir=()
  [[ -d ./claude ]] && claude_dir=(./claude)
  [[ -d ./claude/hooks ]] && claude_dir+=(./claude/hooks)
  # Only regular files are collected, so hook symlinks are not linted twice.
  # shellcheck disable=SC2296  # zsh (@f) line split
  local -a candidates=("${(@f)$(/usr/bin/find . ./.functions ./bin ./lib ./tests ./.githooks ./.config/git/hooks \
            "${claude_dir[@]}" -maxdepth 1 -type f \
            -not -iwholename '*venv*'   \
            -not -iwholename '*.tar.xz' \
            | /usr/bin/sort -u)}")

  # Preserve file(1)'s dialect check: agent-reset is deliberately Python. One
  # file(1) run covers every candidate; each output line is "path<TAB> type".
  while IFS=$'\n' read -r file; do
    desc="${file#*$'\t'}"
    if [[ "${desc}" == *(shell|bash|zsh)* ]]; then
      shell_files+=("${file%%$'\t'*}")
    fi
  done < <(/usr/bin/file -F $'\t' -- "${candidates[@]}")

  if (( ${#shell_files[@]} == 0 )); then
    _fail "No shell scripts found"
  elif shellcheck --shell=bash "${shell_files[@]}"; then
    _pass "All ${#shell_files[@]} shell scripts pass ShellCheck"
  else
    _fail "ShellCheck reported errors (see file diagnostics above)"
  fi
}
