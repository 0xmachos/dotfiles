#!/bin/zsh
# dotfiles/tests/shellcheck
#
# ShellCheck suite — lints shell scripts in the repo root, .functions/, bin/,
# lib/, tests/, and both hook directories. Uses bash mode (shellcheck has no
# native Zsh support — the ~95% overlap catches real issues, Zsh-only syntax
# is suppressed inline in each script).
#
# ShellCheck: lint with `shellcheck --shell=bash tests/shellcheck`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

function run_shellcheck {
  _section "ShellCheck"

  if ! command -v shellcheck >/dev/null 2>&1; then
    _fail "shellcheck not installed (brew install shellcheck)"
    return
  fi

  local -a shell_files=()
  local file
  while IFS=$'\n' read -r file; do
    # Preserve file(1)'s dialect check: agent-reset is deliberately Python.
    # Only regular files are collected, so hook symlinks are not linted twice.
    if /usr/bin/file "${file}" | /usr/bin/grep --quiet -E "shell|bash|zsh"; then
      shell_files+=("${file}")
    fi
  done < <(/usr/bin/find . ./.functions ./bin ./lib ./tests ./.githooks ./.config/git/hooks \
            -maxdepth 1 -type f \
            -not -iwholename '*venv*'   \
            -not -iwholename '*.tar.xz' \
            | /usr/bin/sort -u)

  if (( ${#shell_files[@]} == 0 )); then
    _fail "No shell scripts found"
  elif shellcheck --shell=bash "${shell_files[@]}"; then
    _pass "All ${#shell_files[@]} shell scripts pass ShellCheck"
  else
    _fail "ShellCheck reported errors (see file diagnostics above)"
  fi
}
