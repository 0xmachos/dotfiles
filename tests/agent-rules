#!/bin/zsh
# dotfiles/tests/agent-rules
#
# Guards the skills that carry the language rule files. Tools without a rules
# directory cannot read claude/rules/*.md, and subagents are not handed
# path-gated rules, so each rule N.md has a twin skill
# claude/skills/N-conventions/SKILL.md whose body is the rule body, byte for
# byte. Nothing else keeps the two in step.
#   * every skill's frontmatter parses (an unquoted ': ' in a description makes
#     the skill load with no description) and its name matches its directory
#   * every rule's frontmatter parses as a mapping with a closed fence, and a
#     paths: key is a non-empty list of strings (unparseable frontmatter loads
#     as if the rule had no paths:, so a lazy rule silently turns eager)
#   * each twin skill body equals its rule body
#   * every name in bittersweet's shared_skills array exists under claude/skills
#   * the twin list above names every rules/N.md that has a N-conventions skill
# Each check is one whole-tree scan with one summary result: a fault in any file
# fails with a line that names the file. Line caps and size caps are
# tests/agents-md's job.
#
# One ruby run parses every skill's frontmatter and a second parses every rule's; file reads are in-process.
#
# The real-tree checks skip whole when claude/ is absent (gitignored, synced out
# of band).
#
# Run: ./test agent-rules
#
# ShellCheck: lint with `shellcheck --shell=bash tests/agent-rules`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib
# shellcheck disable=SC2154  # fail_count comes from tests/lib

readonly -a _AGENT_RULES_TWINS=(swift rust npm python objc ci)

# Splits $1 in one pass, no process start. Sets: _AR_FIRST (line 1), _AR_FM
# (lines between the first two '---' fences, empty unless line 1 is exactly
# '---'), _AR_CLOSED (1 when a closing fence exists) and _AR_BODY (everything
# after the closing fence, unchanged).
function _agent_rules_split {
  local line n=0
  _AR_FIRST="" _AR_FM="" _AR_BODY="" _AR_CLOSED=0
  while IFS= read -r line || [[ -n "${line}" ]]; do
    if (( n++ == 0 )); then
      _AR_FIRST="${line}"
    elif (( _AR_CLOSED )); then
      _AR_BODY+="${line}"$'\n'
    elif [[ "${line}" =~ ^---[[:space:]]*$ ]]; then
      _AR_CLOSED=1
    elif [[ "${_AR_FIRST}" == "---" ]]; then
      _AR_FM+="${line}"$'\n'
    fi
  done < "$1"
}

# Ruby parses each frontmatter (one per argument) and prints one line per
# argument: "ok", or "err <first line of the message>". A skill needs a mapping
# with a non-empty string description.
readonly _AGENT_RULES_RUBY='
ARGV.each do |doc|
  begin
    d = YAML.safe_load(doc)
    raise "frontmatter is not a mapping" unless d.is_a?(Hash)
    desc = d["description"]
    raise "description is missing or empty" unless desc.is_a?(String) && !desc.strip.empty?
    puts "ok"
  rescue Exception => e
    puts "err #{e.message.lines.first.to_s.strip}"
  end
end
'

# Rules: frontmatter is optional (none = eager). When line 1 opens a fence it
# must be exactly '---', the fence must close, and the YAML must be a mapping
# whose paths: (if present) is a non-empty list of non-empty strings.
readonly _AGENT_RULES_RULE_RUBY='
ARGV.each do |doc|
  begin
    d = YAML.safe_load(doc)
    raise "frontmatter is not a mapping" unless d.is_a?(Hash)
    if d.key?("paths")
      p = d["paths"]
      raise "paths: is not a non-empty list" unless p.is_a?(Array) && !p.empty?
      raise "paths: has a non-string or empty item" unless p.all? { |x| x.is_a?(String) && !x.strip.empty? }
    end
    puts "ok"
  rescue Exception => e
    puts "err #{e.message.lines.first.to_s.strip}"
  end
end
'

# $1 ruby program, then one frontmatter per argument. Sets _AR_YAML, one result
# line per frontmatter. A ruby that dies leaves lines missing, which the
# caller reports as a failure.
function _agent_rules_yaml_batch {
  local program="$1" out line
  shift
  out="$(/usr/bin/ruby -ryaml -e "${program}" -- "$@" 2>/dev/null)" || out=""
  _AR_YAML=()
  while IFS= read -r line; do
    _AR_YAML+=("${line}")
  done <<< "${out}"
}

# $@ SKILL.md paths. Phase 1 reads every file and queues the frontmatter of
# each whose line 1 is a fence. One ruby run parses the queue. Phase 2 reports
# each skill in order.
function _agent_rules_check_skills {
  local file dir i k=1 res have_ruby=0
  local -i before=${fail_count}
  local -r desc_re=$'(^|\n)description:[ \t\r\f\v]*[^ \t\r\f\v\n]'
  local -a dirs=() firsts=() name_ok=() desc_ok=() fms=()
  [[ -x /usr/bin/ruby ]] && have_ruby=1
  for file in "$@"; do
    _agent_rules_split "${file}"
    dirs+=("${file:h:t}")
    firsts+=("${_AR_FIRST}")
    if [[ $'\n'"${_AR_FM}" == *$'\n'"name: ${file:h:t}"$'\n'* ]]; then
      name_ok+=(1)
    else
      name_ok+=(0)
    fi
    # Used only when ruby is missing.
    if [[ "${_AR_FM}" =~ ${desc_re} ]]; then
      desc_ok+=(1)
    else
      desc_ok+=(0)
    fi
    [[ "${_AR_FIRST}" == "---" ]] && fms+=("${_AR_FM}")
  done
  (( have_ruby && ${#fms[@]} )) && _agent_rules_yaml_batch "${_AGENT_RULES_RUBY}" "${fms[@]}"
  for (( i = 1; i <= ${#dirs[@]}; i++ )); do
    dir="${dirs[i]}"
    if [[ "${firsts[i]}" != "---" ]]; then
      _fail "skills/${dir}/SKILL.md: line 1 is not '---'"
      continue
    fi
    (( name_ok[i] )) || _fail "skills/${dir}/SKILL.md: 'name:' is not '${dir}'"
    if (( have_ruby )); then
      res="${_AR_YAML[k]:-err no result from ruby}"
      [[ "${res}" == ok ]] || _fail "skills/${dir}/SKILL.md: frontmatter invalid: ${res#err }"
    elif (( ! desc_ok[i] )); then
      _fail "skills/${dir}/SKILL.md: no non-empty 'description:'"
    fi
    (( k++ ))
  done
  (( have_ruby )) || _skip "/usr/bin/ruby missing — skill YAML parse skipped"
  if (( fail_count == before )); then
    _pass "all ${#dirs[@]} skills: name matches the directory, frontmatter parses, description non-empty"
  fi
}

# $@ rule paths, same two phases as the skills.
function _agent_rules_check_rules {
  local file name i k=1 res
  local -i before=${fail_count}
  local -a names=() outcome=() fms=()
  for file in "$@"; do
    name="${file:t}"
    names+=("${name}")
    _agent_rules_split "${file}"
    if [[ "${_AR_FIRST}" != ---* ]]; then
      outcome+=("pass")
    elif [[ "${_AR_FIRST}" != "---" ]]; then
      outcome+=("fail rules/${name}: line 1 is '${_AR_FIRST}', not exactly '---' — the fence is not recognised and the rule loads eagerly")
    elif (( ! _AR_CLOSED )); then
      outcome+=("fail rules/${name}: frontmatter fence never closes")
    elif [[ ! -x /usr/bin/ruby ]]; then
      outcome+=("skip rules/${name}: /usr/bin/ruby missing — YAML parse skipped")
    else
      outcome+=("yaml")
      fms+=("${_AR_FM}")
    fi
  done
  (( ${#fms[@]} )) && _agent_rules_yaml_batch "${_AGENT_RULES_RULE_RUBY}" "${fms[@]}"
  for (( i = 1; i <= ${#names[@]}; i++ )); do
    case "${outcome[i]}" in
      "pass") ;;
      "fail "*) _fail "${outcome[i]#fail }" ;;
      "skip "*) _skip "${outcome[i]#skip }" ;;
      *)
        res="${_AR_YAML[k]:-err no result from ruby}"
        (( k++ ))
        [[ "${res}" == ok ]] || _fail "rules/${names[i]}: frontmatter invalid: ${res#err }"
        ;;
    esac
  done
  if (( fail_count == before )); then
    _pass "all ${#names[@]} rules: frontmatter closes and parses, paths: is a list or absent"
  fi
}

function _agent_rules_check_twin {
  local n="$1" rule skill rule_body
  rule="${SCRIPT_DIR}/claude/rules/${n}.md"
  skill="${SCRIPT_DIR}/claude/skills/${n}-conventions/SKILL.md"
  if [[ ! -f "${rule}" || ! -f "${skill}" ]]; then
    _fail "claude/rules/${n}.md and claude/skills/${n}-conventions/SKILL.md: one of the pair is missing"
    return
  fi
  _agent_rules_split "${rule}"
  rule_body="${_AR_BODY}"
  _agent_rules_split "${skill}"
  if [[ "${rule_body}" != "${_AR_BODY}" ]]; then
    _fail "claude/skills/${n}-conventions/SKILL.md body differs from claude/rules/${n}.md — the skill must carry the rule text byte for byte"
  fi
}

function _agent_rules_check_shared {
  local line found="" name
  local -i before=${fail_count}
  while IFS= read -r line || [[ -n "${line}" ]]; do
    if [[ "${line}" == *'shared_skills=('* ]]; then
      found="${line}"
      break
    fi
  done < "${SCRIPT_DIR}/bittersweet"
  if [[ -z "${found}" ]]; then
    _fail "bittersweet: no shared_skills array found"
    return
  fi
  # Pattern in variables: a literal '(' in ${..#pat} is a zsh glob error.
  local open='shared_skills=(' close=')'
  found="${found#*"${open}"}"
  found="${found%"${close}"*}"
  for name in ${=found}; do
    if [[ ! -f "${SCRIPT_DIR}/claude/skills/${name}/SKILL.md" ]]; then
      _fail "bittersweet shared_skills lists '${name}' but claude/skills/${name}/SKILL.md is missing"
    fi
  done
  if (( fail_count == before )); then
    _pass "every shared_skills name exists under claude/skills"
  fi
}

# Names N for which claude/rules/N.md and claude/skills/N-conventions/ both
# exist under $1, sorted, into _AR_DERIVED.
function _agent_rules_derive_twins {
  setopt local_options null_glob
  local f n
  _AR_DERIVED=()
  for f in "$1"/claude/rules/*.md; do
    n="${f:t:r}"
    [[ -d "$1/claude/skills/${n}-conventions" ]] && _AR_DERIVED+=("${n}")
  done
}

# $1 root, then the listed twins. A pair on disk but not in the list would
# have its skill body unchecked, so each is a failure, and so is a listed name
# with no pair on disk.
function _agent_rules_check_twin_list {
  local root="$1" n bad=0
  local -A listed=() derived=()
  shift
  for n in "$@"; do
    listed[${n}]=1
  done
  _agent_rules_derive_twins "${root}"
  for n in "${_AR_DERIVED[@]}"; do
    derived[${n}]=1
    if [[ -z "${listed[${n}]:-}" ]]; then
      _fail "claude/rules/${n}.md has a ${n}-conventions skill but ${n} is not in _AGENT_RULES_TWINS — its body is never compared"
      bad=1
    fi
  done
  for n in "$@"; do
    if [[ -z "${derived[${n}]:-}" ]]; then
      _fail "_AGENT_RULES_TWINS lists '${n}' but claude/rules/${n}.md and claude/skills/${n}-conventions/ are not both present"
      bad=1
    fi
  done
  return "${bad}"
}

# The twin list equals the rule/skill pairs on disk, and every twin skill body
# equals its rule body.
function _agent_rules_check_twins {
  local n
  local -i before=${fail_count}
  _agent_rules_check_twin_list "${SCRIPT_DIR}" "${_AGENT_RULES_TWINS[@]}" || :
  for n in "${_AGENT_RULES_TWINS[@]}"; do
    _agent_rules_check_twin "${n}"
  done
  if (( fail_count == before )); then
    _pass "twin list equals the rule/skill pairs on disk and each skill body equals its rule body"
  fi
}

function run_agent_rules {
  # null_glob: an empty skills/ is a no-op, not a glob error.
  setopt local_options null_glob
  _section "Agent rules: skill frontmatter and rule twins"

  if [[ ! -d "${SCRIPT_DIR}/claude" ]]; then
    _skip "claude/ absent — pending out-of-band sync"
    return
  fi

  local -a skills=("${SCRIPT_DIR}"/claude/skills/*/SKILL.md)
  local -a rules=("${SCRIPT_DIR}"/claude/rules/*.md)
  (( ${#skills[@]} )) && _agent_rules_check_skills "${skills[@]}"
  (( ${#rules[@]} )) && _agent_rules_check_rules "${rules[@]}"
  _agent_rules_check_twins
  _agent_rules_check_shared
}
