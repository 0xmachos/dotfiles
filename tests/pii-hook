#!/bin/zsh
# dotfiles/tests/pii-hook
#
# Pins the global pre-commit scanner (.config/git/hooks/pre-commit), the
# commit-msg gate (both on the shared pii-scan core since 2026-08-17) and the
# hook-forward stub, in a sandbox repo: denylist (content, filename, message
# title/body), MAC/UUID detector (colon and dash forms, placeholder and staged
# .pii-allowlist exemptions, adjacency and cross-layer-bleed regressions),
# SSH-alias derivation, PII_HOOK_BYPASS, invalid-regex hard-blocks, TMPDIR
# normalisation, message normalisation (comment stripping, scissors
# truncation), the applypatch-msg symlink, the --no-verify hole the pre-push
# message gate closes, and the .git/hooks chain (direct, linked worktree,
# message rewrite, forwarder).
#
# Fixture tokens are assembled at run time (string concatenation): a literal
# regex-shaped token would trip the detector when this file is committed.
# The PII_HOOK_PATTERNS / PII_HOOK_SSH_CONFIG seams isolate every case from
# the machine's real pattern list and ssh config.
#
# PII_HOOK_BYPASS is honoured only with a controlling terminal (2026-09-25;
# pii-scan's --check-terminal). Cases expecting it to WORK run under
# /usr/bin/script -q /dev/null (_pii_hook_run_tty / _pii_msg_run_tty), a real
# pty however the suite was invoked. Cases expecting REFUSAL run under
# tests/lib's _run_no_tty (_pii_hook_run_notty / _pii_msg_run_notty), which
# detaches via POSIX setsid: an agent's tool call has no terminal but an
# interactive `./test` does. Neither depends on the caller's tty, so both
# hold under `./test` and `script -q /dev/null zsh test pii-hook`.
#
# Run: ./test pii-hook
# ShellCheck: lint with `shellcheck --shell=bash tests/pii-hook`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

function _pii_hook_run {
  # Stage the sandbox, run the global hook in it. Extra KEY=VALUE args follow
  # the default seams, so they override (env: last wins). Sets hook_rc/hook_out.
  git -C "${pii_sandbox}" add -A
  hook_rc=0
  hook_out="$(cd "${pii_sandbox}" && \
    env PII_HOOK_PATTERNS="${pii_seam_patterns}" PII_HOOK_SSH_CONFIG=/dev/null \
        "$@" "${pii_hook}" 2>&1)" || hook_rc=$?
}

function _pii_hook_run_tty {
  # _pii_hook_run under script (real tty): PII_HOOK_BYPASS honoured.
  git -C "${pii_sandbox}" add -A
  hook_rc=0
  hook_out="$(cd "${pii_sandbox}" && \
    /usr/bin/script -q /dev/null env PII_HOOK_PATTERNS="${pii_seam_patterns}" PII_HOOK_SSH_CONFIG=/dev/null \
        "$@" "${pii_hook}" </dev/null 2>&1)" || hook_rc=$?
}

function _pii_hook_run_notty {
  # _pii_hook_run under _run_no_tty (no tty): PII_HOOK_BYPASS refused.
  git -C "${pii_sandbox}" add -A
  hook_rc=0
  hook_out="$(cd "${pii_sandbox}" && \
    _run_no_tty env PII_HOOK_PATTERNS="${pii_seam_patterns}" PII_HOOK_SSH_CONFIG=/dev/null \
        "$@" "${pii_hook}" 2>&1)" || hook_rc=$?
}

function _pii_reset {
  # Unstage and empty the sandbox working tree (keep .git).
  git -C "${pii_sandbox}" reset -q
  /usr/bin/find "${pii_sandbox}" -mindepth 1 -maxdepth 1 -not -name '.git' \
    -exec /bin/rm -rf {} +
}

function _pii_expect_block {
  local desc="$1" needle="$2"
  if (( hook_rc == 0 )); then
    _fail "${desc} — expected block, hook passed"
    return
  fi
  if [[ "${hook_out}" == *"${needle}"* ]]; then
    _pass "${desc}"
  else
    _fail "${desc} — blocked, but output missing '${needle}'"
  fi
}

function _pii_expect_pass {
  local desc="$1"
  if (( hook_rc == 0 )); then
    _pass "${desc}"
  else
    _fail "${desc} — expected pass, hook blocked: ${hook_out}"
  fi
}

function _pii_msg_run {
  # Run message hook $1 on ${pii_msgfile} in the sandbox. Extra KEY=VALUE args
  # override the default seams (env: last wins). Sets hook_rc/hook_out.
  local hook="$1"; shift
  hook_rc=0
  hook_out="$(cd "${pii_sandbox}" && \
    env PII_HOOK_PATTERNS="${pii_seam_patterns}" PII_HOOK_SSH_CONFIG=/dev/null \
        "$@" "${hook}" "${pii_msgfile}" 2>&1)" || hook_rc=$?
}

function _pii_msg_run_tty {
  # _pii_msg_run under script (real tty): PII_HOOK_BYPASS honoured.
  local hook="$1"; shift
  hook_rc=0
  hook_out="$(cd "${pii_sandbox}" && \
    /usr/bin/script -q /dev/null env PII_HOOK_PATTERNS="${pii_seam_patterns}" PII_HOOK_SSH_CONFIG=/dev/null \
        "$@" "${hook}" "${pii_msgfile}" </dev/null 2>&1)" || hook_rc=$?
}

function _pii_msg_run_notty {
  # _pii_msg_run under _run_no_tty (no tty): PII_HOOK_BYPASS refused.
  local hook="$1"; shift
  hook_rc=0
  hook_out="$(cd "${pii_sandbox}" && \
    _run_no_tty env PII_HOOK_PATTERNS="${pii_seam_patterns}" PII_HOOK_SSH_CONFIG=/dev/null \
        "$@" "${hook}" "${pii_msgfile}" 2>&1)" || hook_rc=$?
}

function _pii_forward_cases {
  # hook-forward bookkeeping: one `git rev-parse` answers both the sentinel
  # (absolute git dir) and the repo-hook path (common dir). Pins: the
  # re-entry sentinel (scoped to hook name AND repo, spaces folded to `_`),
  # the common dir from a linked worktree, a repo path holding a newline
  # (the two answers fall back to separate calls), and git's own failure
  # status outside a repository.
  local fwd="$1" work repo gd marker rc
  work="$(mktemp -d "${TMPDIR:-/tmp}/pii-fwd-cases.XXXXXX")"
  repo="${work}/repo"
  git init -q "${repo}"
  marker="${repo}/fwd-marker"
  printf '#!/bin/zsh\ntouch fwd-marker\nexit 3\n' > "${repo}/.git/hooks/commit-msg"
  chmod 755 "${repo}/.git/hooks/commit-msg"
  gd="$(git -C "${repo}" rev-parse --absolute-git-dir)"

  rc=0
  (cd "${repo}" && env GIT_GLOBAL_HOOKS_SEEN="commit-msg@${gd}" "${fwd}/commit-msg" >/dev/null 2>&1) || rc=$?
  if (( rc == 0 )) && [[ ! -e "${marker}" ]]; then
    _pass "hook-forward: a sentinel for this hook and repo exits 0 without running the repo hook"
  else
    _fail "hook-forward: seen sentinel — rc=${rc} marker=$([[ -e ${marker} ]] && echo yes || echo no)"
  fi
  /bin/rm -f "${marker}"

  rc=0
  (cd "${repo}" && env GIT_GLOBAL_HOOKS_SEEN="commit-msg@/elsewhere/.git pre-push@${gd}" "${fwd}/commit-msg" >/dev/null 2>&1) || rc=$?
  if (( rc == 3 )) && [[ -e "${marker}" ]]; then
    _pass "hook-forward: a sentinel for another repo or another hook does not skip this one"
  else
    _fail "hook-forward: foreign sentinel — rc=${rc} marker=$([[ -e ${marker} ]] && echo yes || echo no)"
  fi
  /bin/rm -f "${marker}"

  # Linked worktree: the hook lives in the COMMON dir.
  local wt="${work}/wt-fwd"
  git -C "${repo}" worktree add -q "${wt}" -b fwd-wt 2>/dev/null
  rc=0
  (cd "${wt}" && "${fwd}/commit-msg" >/dev/null 2>&1) || rc=$?
  if (( rc == 3 )) && [[ -e "${wt}/fwd-marker" ]]; then
    _pass "hook-forward: a linked worktree reaches the common-dir hook"
  else
    _fail "hook-forward: worktree — rc=${rc} marker=$([[ -e ${wt}/fwd-marker ]] && echo yes || echo no)"
  fi
  # ...and its sentinel is the worktree's own git dir, not the main one.
  gd="$(git -C "${wt}" rev-parse --absolute-git-dir)"
  /bin/rm -f "${wt}/fwd-marker"
  rc=0
  (cd "${wt}" && env GIT_GLOBAL_HOOKS_SEEN="commit-msg@${gd}" "${fwd}/commit-msg" >/dev/null 2>&1) || rc=$?
  if (( rc == 0 )) && [[ ! -e "${wt}/fwd-marker" ]]; then
    _pass "hook-forward: the worktree's sentinel skips the worktree"
  else
    _fail "hook-forward: worktree sentinel — rc=${rc}"
  fi

  # The real commit-msg gate chains to the same common-dir hook from a linked
  # worktree; the chained hook's status (3) aborts before any scan.
  local cmsg="${work}/msgfile"
  print 'clean subject' > "${cmsg}"
  rc=0
  (cd "${wt}" && "${SCRIPT_DIR}/.config/git/hooks/commit-msg" "${cmsg}" >/dev/null 2>&1) || rc=$?
  if (( rc == 3 )) && [[ -e "${wt}/fwd-marker" ]]; then
    _pass "commit-msg: a linked worktree reaches the common-dir repo hook"
  else
    _fail "commit-msg: worktree chain — rc=${rc} marker=$([[ -e ${wt}/fwd-marker ]] && echo yes || echo no)"
  fi

  # Spaces in the git dir fold to `_` in the sentinel.
  local sp="${work}/with space"
  git init -q "${sp}"
  printf '#!/bin/zsh\ntouch fwd-marker\nexit 3\n' > "${sp}/.git/hooks/commit-msg"
  chmod 755 "${sp}/.git/hooks/commit-msg"
  gd="$(git -C "${sp}" rev-parse --absolute-git-dir)"
  rc=0
  (cd "${sp}" && env GIT_GLOBAL_HOOKS_SEEN="commit-msg@${gd// /_}" "${fwd}/commit-msg" >/dev/null 2>&1) || rc=$?
  if (( rc == 0 )) && [[ ! -e "${sp}/fwd-marker" ]]; then
    _pass "hook-forward: a git dir with a space matches its underscore-folded sentinel"
  else
    _fail "hook-forward: spaced path sentinel — rc=${rc}"
  fi
  rc=0
  (cd "${sp}" && "${fwd}/commit-msg" >/dev/null 2>&1) || rc=$?
  if (( rc == 3 )) && [[ -e "${sp}/fwd-marker" ]]; then
    _pass "hook-forward: a repo path with a space runs the repo hook"
  else
    _fail "hook-forward: spaced path — rc=${rc}"
  fi

  # A newline in the path misaligns the one-call answer: separate calls.
  local nl="${work}/new"$'\n'"line"
  git init -q "${nl}"
  printf '#!/bin/zsh\ntouch fwd-marker\nexit 3\n' > "${nl}/.git/hooks/commit-msg"
  chmod 755 "${nl}/.git/hooks/commit-msg"
  rc=0
  (cd "${nl}" && "${fwd}/commit-msg" >/dev/null 2>&1) || rc=$?
  if (( rc == 3 )) && [[ -e "${nl}/fwd-marker" ]]; then
    _pass "hook-forward: a repo path with a newline still runs the repo hook"
  else
    _fail "hook-forward: newline path — rc=${rc}"
  fi

  # Outside a repository git's own status (128) propagates; nothing runs.
  local nogit="${work}/nogit"
  mkdir -p "${nogit}"
  rc=0
  (cd "${nogit}" && env GIT_CEILING_DIRECTORIES="${nogit:h}" "${fwd}/commit-msg" >/dev/null 2>&1) || rc=$?
  if (( rc == 128 )); then
    _pass "hook-forward: outside a repository exits with git's status"
  else
    _fail "hook-forward: outside a repository — expected 128, got ${rc}"
  fi
  /bin/rm -rf "${work}"
}

function _pii_scan_sentinel_cases {
  # The re-entry sentinel in the real scanners: a sentinel for this hook and
  # repo exits 0 BEFORE scanning (pre-commit, commit-msg); one for another
  # repo or hook does not.
  local gd
  gd="$(git -C "${pii_sandbox}" rev-parse --absolute-git-dir)"
  _pii_reset   # drops the linked worktree an earlier case left inside the sandbox
  echo "zorblefrobnicate" > "${pii_sandbox}/notes.md"
  _pii_hook_run GIT_GLOBAL_HOOKS_SEEN="pre-commit@${gd}"
  _pii_expect_pass "pre-commit: a sentinel for this repo exits 0 before scanning"
  _pii_hook_run GIT_GLOBAL_HOOKS_SEEN="pre-commit@/elsewhere/.git commit-msg@${gd}"
  _pii_expect_block "pre-commit: a sentinel for another repo or hook does not skip the scan" "PII pattern"
  _pii_reset

  printf 'deployed to zorblefrobnicate\n' > "${pii_msgfile}"
  _pii_msg_run "${SCRIPT_DIR}/.config/git/hooks/commit-msg" GIT_GLOBAL_HOOKS_SEEN="commit-msg@${gd}"
  _pii_expect_pass "commit-msg: a sentinel for this repo exits 0 before scanning"
  _pii_msg_run "${SCRIPT_DIR}/.config/git/hooks/commit-msg" GIT_GLOBAL_HOOKS_SEEN="pre-commit@${gd}"
  _pii_expect_block "commit-msg: a sentinel for another hook does not skip the scan" "PII pattern"

  # Message normalisation without a scratch copy of the raw text: an
  # unterminated last line is still scanned, an empty file passes, and the
  # scissors cut keeps what precedes it.
  printf 'subject\n\nbody then zorblefrobnicate' > "${pii_msgfile}"
  _pii_msg_run "${SCRIPT_DIR}/.config/git/hooks/commit-msg"
  _pii_expect_block "commit-msg: a final line with no newline is scanned" "PII pattern"
  : > "${pii_msgfile}"
  _pii_msg_run "${SCRIPT_DIR}/.config/git/hooks/commit-msg"
  _pii_expect_pass "commit-msg: an empty message file passes"
  printf 'zorblefrobnicate subject\n# ------------------------ >8 ------------------------\nrest' > "${pii_msgfile}"
  _pii_msg_run "${SCRIPT_DIR}/.config/git/hooks/commit-msg"
  _pii_expect_block "commit-msg: text before the scissors line is scanned" "PII pattern"
  printf 'clean\n\n\n\nstill clean   \n\n\n' > "${pii_msgfile}"
  _pii_msg_run "${SCRIPT_DIR}/.config/git/hooks/commit-msg"
  _pii_expect_pass "commit-msg: blank-line runs and trailing blanks pass"
}

function _pii_stub_chain_cases {
  # The .githooks stubs find the repo root from their own path, not from git,
  # and hand arguments, stdin and exit status to the global hook there. The
  # fixture global hooks print the root they sit under, their argv and stdin.
  local root="$1" kind wt out want rc
  local -a stubs=(commit-msg pre-commit pre-push)
  mkdir -p "${root}/.githooks" "${root}/.config/git/hooks" "${root}/lib" "${root}/sub/dir"
  for kind in "${stubs[@]}"; do
    cp "${SCRIPT_DIR}/.githooks/${kind}" "${root}/.githooks/${kind}"
    # SC2016: single quotes deliberate; expands when the fixture runs.
    # shellcheck disable=SC2016
    printf '#!/bin/zsh\nprint -r -- "root=${0:A:h:h:h:h} args=$* stdin=$(cat)"\nexit 5\n' \
      > "${root}/.config/git/hooks/${kind}"
    chmod 755 "${root}/.githooks/${kind}" "${root}/.config/git/hooks/${kind}"
  done
  cp "${SCRIPT_DIR}/.githooks/post-commit" "${root}/.githooks/post-commit"
  chmod 755 "${root}/.githooks/post-commit"
  # SC2016: single quotes deliberate; written verbatim into the fixture.
  # shellcheck disable=SC2016
  printf '_generate_zsh_sidebar_syntax() { print -r -- "root=$1" > "$2"; }\n' > "${root}/lib/zsh-sidebar"
  : > "${root}/sub/dir/.keep"
  git -C "${root}" add -A
  git -C "${root}" -c core.hooksPath=/dev/null -c commit.gpgsign=false \
    -c user.name=t -c user.email=t@example.invalid commit -q -m fixtures
  wt="${root:h}/wt-stubs"
  git -C "${root}" worktree add -q "${wt}" -b stub-wt 2>/dev/null

  local where
  for where in "${root}" "${wt}"; do
    for kind in commit-msg pre-commit pre-push; do
      # The pre-commit stub passes no arguments (git gives pre-commit none).
      want="root=${where:A} args=one two stdin=quad line"
      [[ "${kind}" == pre-commit ]] && want="root=${where:A} args= stdin=quad line"
      rc=0
      # Absolute stub path from a subdirectory, as a hook run from a deep cwd.
      out="$(cd "${where}/sub/dir" && print 'quad line' | "${where}/.githooks/${kind}" one two 2>&1)" || rc=$?
      if (( rc == 5 )) && [[ "${out}" == "${want}" ]]; then
        _pass ".githooks/${kind} chains to its own tree's global hook ($([[ ${where} == "${root}" ]] && echo main || echo worktree), from a subdirectory)"
      else
        _fail ".githooks/${kind} chain — rc=${rc} out='${out}' want='${want}'"
      fi
      rc=0
      # Relative stub path from the root, as git runs core.hooksPath=.githooks.
      out="$(cd "${where}" && print 'quad line' | ./.githooks/${kind} one two 2>&1)" || rc=$?
      if (( rc == 5 )) && [[ "${out}" == "${want}" ]]; then
        _pass ".githooks/${kind} chains from a relative invocation too"
      else
        _fail ".githooks/${kind} relative chain — rc=${rc} out='${out}' want='${want}'"
      fi
    done
  done

  # post-commit: repo_dir comes from the stub's own path.
  local home="${root:h}/home" f
  mkdir -p "${home}/Library/Application Support/Sublime Text/Packages/User"
  f="${home}/Library/Application Support/Sublime Text/Packages/User/Zsh (Dotfiles).sublime-syntax"
  for where in "${root}" "${wt}"; do
    /bin/rm -f "${f}"
    rc=0
    (cd "${where}/sub/dir" && env HOME="${home}" "${where}/.githooks/post-commit" >/dev/null 2>&1) || rc=$?
    if (( rc == 0 )) && [[ "$(<"${f}")" == "root=${where:A}" ]]; then
      _pass ".githooks/post-commit regenerates from its own tree ($([[ ${where} == "${root}" ]] && echo main || echo worktree))"
    else
      _fail ".githooks/post-commit — rc=${rc} wrote '$(<"${f}" 2>/dev/null)' want 'root=${where:A}'"
    fi
  done
}

function run_pii_hook {
  _section "Global PII Hook"

  if ! command -v gitleaks &>/dev/null; then
    _fail "gitleaks not installed (brew install gitleaks)"
    return
  fi

  # SC2154: SCRIPT_DIR is set by the ./test dispatcher.
  # shellcheck disable=SC2154
  pii_hook="${SCRIPT_DIR}/.config/git/hooks/pre-commit"
  if [[ ! -x "${pii_hook}" ]]; then
    _fail "global hook missing or not executable: ${pii_hook}"
    return
  fi

  pii_sandbox="$(mktemp -d "${TMPDIR:-/tmp}/pii-hook-test.XXXXXX")"
  pii_seam_patterns="$(mktemp "${TMPDIR:-/tmp}/pii-hook-patterns.XXXXXX")"
  echo "zorblefrobnicate" > "${pii_seam_patterns}"

  git -C "${pii_sandbox}" init -q
  git -C "${pii_sandbox}" config commit.gpgsign false
  git -C "${pii_sandbox}" config user.name test
  git -C "${pii_sandbox}" config user.email test@example.invalid
  git -C "${pii_sandbox}" commit -q --allow-empty --no-verify -m init

  # Regex-shaped fixtures, assembled so they never appear in this source file
  local mac="0f:1e:2d:3c:4b" uuid="cafe0123-4567-89ab"
  mac="${mac}:5a"
  uuid="${uuid}-cdef-0123456789ab"

  # 1. Clean content passes
  echo "hello world" > "${pii_sandbox}/notes.md"
  _pii_hook_run
  _pii_expect_pass "clean staged content passes"
  _pii_reset

  # 2. Denylist match in content blocks
  echo "deployed at zorblefrobnicate today" > "${pii_sandbox}/notes.md"
  _pii_hook_run
  _pii_expect_block "denylist match in content blocks" "PII pattern"
  _pii_reset

  # 3. Denylist match in a staged FILENAME blocks (content clean)
  echo "clean" > "${pii_sandbox}/zorblefrobnicate-notes.md"
  _pii_hook_run
  _pii_expect_block "denylist match in filename blocks" "PII pattern"
  _pii_reset

  # 4. Invalid denylist regex hard-blocks (must not silently disable the scan)
  local bad_patterns
  bad_patterns="$(mktemp "${TMPDIR:-/tmp}/pii-hook-bad.XXXXXX")"
  echo "([" > "${bad_patterns}"
  echo "anything" > "${pii_sandbox}/notes.md"
  _pii_hook_run PII_HOOK_PATTERNS="${bad_patterns}"
  _pii_expect_block "invalid denylist regex hard-blocks" "invalid grep -E"
  /bin/rm -f "${bad_patterns}"
  _pii_reset

  # 5. Real-looking MAC token blocks
  echo "mgmt iface at ${mac} on vlan" > "${pii_sandbox}/notes.md"
  _pii_hook_run
  _pii_expect_block "MAC-shaped token blocks" "MAC/UUID"
  _pii_reset

  # 6. Documentation MAC placeholder passes
  echo "example: aa:bb:cc:dd:ee:ff" > "${pii_sandbox}/notes.md"
  _pii_hook_run
  _pii_expect_pass "placeholder MAC passes"
  _pii_reset

  # 7. Real-looking UUID token blocks
  echo "resource id ${uuid} returned" > "${pii_sandbox}/notes.md"
  _pii_hook_run
  _pii_expect_block "UUID-shaped token blocks" "MAC/UUID"
  _pii_reset

  # 8. Documentation UUID placeholder passes
  echo "example: 01234567-89ab-cdef-0123-456789abcdef" > "${pii_sandbox}/notes.md"
  _pii_hook_run
  _pii_expect_pass "placeholder UUID passes"
  _pii_reset

  # 8b. Adjacency: a real token one separator char after a placeholder blocks
  echo "ids: 01234567-89ab-cdef-0123-456789abcdef,${uuid}" > "${pii_sandbox}/notes.md"
  _pii_hook_run
  _pii_expect_block "real token adjacent to placeholder blocks" "MAC/UUID"
  _pii_reset

  # 8c. Dash-separated MAC blocks (Windows ipconfig form)
  local dmac="0f-1e-2d-3c-4b"
  dmac="${dmac}-5a"
  echo "device at ${dmac}" > "${pii_sandbox}/notes.md"
  _pii_hook_run
  _pii_expect_block "dash-separated MAC blocks" "MAC/UUID"
  _pii_reset

  # 8d. Dash-separated placeholder MAC passes
  echo "example: aa-bb-cc-dd-ee-ff" > "${pii_sandbox}/notes.md"
  _pii_hook_run
  _pii_expect_pass "dash-separated placeholder MAC passes"
  _pii_reset

  # 8d2. Mixed-separator MAC blocks (evades the two single-separator regexes)
  local mmac="0f:1e-2d:3c"
  mmac="${mmac}-4b:5a"
  echo "device at ${mmac}" > "${pii_sandbox}/notes.md"
  _pii_hook_run
  _pii_expect_block "mixed-separator MAC blocks" "MAC/UUID"
  _pii_reset

  # 8e. TMPDIR without a trailing slash must not break the hook
  echo "hello again" > "${pii_sandbox}/notes.md"
  _pii_hook_run TMPDIR=/tmp
  _pii_expect_pass "TMPDIR without trailing slash works"
  _pii_reset

  # 8f. Labeled identifiers block: mac:<mac> / id:<uuid> forms
  {
    echo "id:${uuid}"
    echo "mac:${mac}"
  } > "${pii_sandbox}/notes.md"
  _pii_hook_run
  _pii_expect_block "labeled MAC/UUID identifiers block" "MAC/UUID"
  _pii_reset

  # 8g. color.ui=always must not empty the scan target (breaks awk anchors)
  git -C "${pii_sandbox}" config color.ui always
  echo "device at ${mac}" > "${pii_sandbox}/notes.md"
  _pii_hook_run
  _pii_expect_block "color.ui=always does not disable content scanning" "MAC/UUID"
  git -C "${pii_sandbox}" config --unset color.ui
  _pii_reset

  # 8h. An unterminated final pattern line stays active (a bare `read` drops it)
  local nl_patterns
  nl_patterns="$(mktemp "${TMPDIR:-/tmp}/pii-hook-nonl.XXXXXX")"
  printf 'unusedfirst\nzorblefrobnicate' > "${nl_patterns}"
  echo "hit zorblefrobnicate here" > "${pii_sandbox}/notes.md"
  _pii_hook_run PII_HOOK_PATTERNS="${nl_patterns}"
  _pii_expect_block "unterminated final pattern line still scans" "PII pattern"
  /bin/rm -f "${nl_patterns}"
  _pii_reset

  # 9. .pii-allowlist exempts a token (it is staged too, so exempts itself)
  echo "mgmt iface at ${mac}" > "${pii_sandbox}/notes.md"
  echo "${mac}" > "${pii_sandbox}/.pii-allowlist"
  _pii_hook_run
  _pii_expect_pass ".pii-allowlist exempts a token"
  _pii_reset

  # 10. A denylist hit is exempt only via a full-line pattern (see 10b)
  echo "deployed at zorblefrobnicate today" > "${pii_sandbox}/notes.md"
  echo ".*zorble.*" > "${pii_sandbox}/.pii-allowlist"
  _pii_hook_run
  _pii_expect_pass ".pii-allowlist full-line pattern exempts a denylist hit"
  _pii_reset

  # 10b. Cross-layer bleed: a bare allowlisted token must NOT launder a
  #      denylist hit on its line
  local pubuuid="c5c2bc3f-b8bd-49a2"
  pubuuid="${pubuuid}-af7f-feecbffc6411"
  echo "zorblefrobnicate was at ${pubuuid}" > "${pii_sandbox}/notes.md"
  echo "${pubuuid}" > "${pii_sandbox}/.pii-allowlist"
  _pii_hook_run
  _pii_expect_block "allowlisted token does not launder a denylist hit" "PII pattern"
  _pii_reset

  # 10c. Unstaged .pii-allowlist is ignored (read from the index)
  echo "mgmt iface at ${mac}" > "${pii_sandbox}/notes.md"
  git -C "${pii_sandbox}" add notes.md
  echo ".*" > "${pii_sandbox}/.pii-allowlist"
  hook_rc=0
  hook_out="$(cd "${pii_sandbox}" && \
    env PII_HOOK_PATTERNS="${pii_seam_patterns}" PII_HOOK_SSH_CONFIG=/dev/null \
        "${pii_hook}" 2>&1)" || hook_rc=$?
  _pii_expect_block "unstaged .pii-allowlist is ignored" "MAC/UUID"
  _pii_reset

  # 11. Invalid .pii-allowlist regex hard-blocks
  echo "clean" > "${pii_sandbox}/notes.md"
  echo "([" > "${pii_sandbox}/.pii-allowlist"
  _pii_hook_run
  _pii_expect_block "invalid .pii-allowlist regex hard-blocks" ".pii-allowlist (staged) has an invalid"
  _pii_reset

  # 11b. Sentinel is repo-scoped: another repo's must not skip this scan…
  echo "mgmt iface at ${mac}" > "${pii_sandbox}/notes.md"
  _pii_hook_run GIT_GLOBAL_HOOKS_SEEN=" pre-commit@/somewhere/else/.git "
  _pii_expect_block "foreign-repo sentinel does not skip the scan" "MAC/UUID"
  _pii_reset

  # 11c. …while same-repo re-entry still short-circuits (recursion guard)
  local own_sentinel
  own_sentinel="pre-commit@$(git -C "${pii_sandbox}" rev-parse --absolute-git-dir)"
  echo "mgmt iface at ${mac}" > "${pii_sandbox}/notes.md"
  _pii_hook_run GIT_GLOBAL_HOOKS_SEEN=" ${own_sentinel} "
  _pii_expect_pass "same-repo sentinel short-circuits re-entry"
  _pii_reset

  # 12. PII_HOOK_BYPASS=1 skips PII layers, loudly; needs a tty (via script)
  echo "zorblefrobnicate and ${mac}" > "${pii_sandbox}/notes.md"
  _pii_hook_run_tty PII_HOOK_BYPASS=1
  _pii_expect_pass "PII_HOOK_BYPASS=1 passes (with a terminal)"
  if [[ "${hook_out}" == *"SKIPPED"* ]]; then
    _pass "bypass warns loudly"
  else
    _fail "bypass warns loudly — no SKIPPED warning in output"
  fi
  _pii_reset

  # 12b. With no tty the variable is IGNORED: the scan still blocks, with a
  #      refusal line naming the user's own terminal.
  echo "zorblefrobnicate and ${mac}" > "${pii_sandbox}/notes.md"
  _pii_hook_run_notty PII_HOOK_BYPASS=1
  _pii_expect_block "PII_HOOK_BYPASS=1 is refused without a controlling terminal" "PII pattern"
  if [[ "${hook_out}" == *"ignored: no controlling terminal"* && "${hook_out}" == *"OWN terminal"* ]]; then
    _pass "refusal names the missing terminal and points at the user's own"
  else
    _fail "refusal line missing or malformed: ${hook_out}"
  fi
  _pii_reset

  # 13. SSH Host aliases derived from the ssh-config seam block
  local ssh_seam
  ssh_seam="$(mktemp "${TMPDIR:-/tmp}/pii-hook-ssh.XXXXXX")"
  printf 'Host zorblehost otherhost\n  HostName ignored\n' > "${ssh_seam}"
  echo "ssh zorblehost uptime" > "${pii_sandbox}/notes.md"
  _pii_hook_run PII_HOOK_SSH_CONFIG="${ssh_seam}"
  _pii_expect_block "derived SSH alias blocks" "PII pattern"
  /bin/rm -f "${ssh_seam}"
  _pii_reset

  # 14. Chain: the repo's .git/hooks/pre-commit runs and its exit status
  #     propagates (exec: the global hook becomes the chained hook)
  mkdir -p "${pii_sandbox}/.git/hooks"
  printf '#!/bin/zsh\ntouch chained-marker\n' > "${pii_sandbox}/.git/hooks/pre-commit"
  chmod 755 "${pii_sandbox}/.git/hooks/pre-commit"
  echo "clean" > "${pii_sandbox}/notes.md"
  _pii_hook_run
  if [[ -f "${pii_sandbox}/chained-marker" ]]; then
    _pass "chains to the repo's .git/hooks/pre-commit"
  else
    _fail "chains to the repo's .git/hooks/pre-commit — marker not created"
  fi
  printf '#!/bin/zsh\nexit 7\n' > "${pii_sandbox}/.git/hooks/pre-commit"
  _pii_hook_run
  if (( hook_rc == 7 )); then
    _pass "chained hook exit status propagates"
  else
    _fail "chained hook exit status propagates — expected 7, got ${hook_rc}"
  fi
  # 14b. Content the chained hook stages is scanned (chain runs FIRST, else
  #      post-scan staging enters commits unscanned)
  # SC2016: single quotes deliberate; expands when the generated hook runs.
  # shellcheck disable=SC2016
  printf '#!/bin/zsh\nm="0f:1e:2d:3c:4b"\necho "late leak ${m}:5a" > late.txt\ngit add late.txt\n' \
    > "${pii_sandbox}/.git/hooks/pre-commit"
  chmod 755 "${pii_sandbox}/.git/hooks/pre-commit"
  echo "clean" > "${pii_sandbox}/notes.md"
  _pii_hook_run
  _pii_expect_block "content staged by the chained hook is scanned" "MAC/UUID"
  /bin/rm -f "${pii_sandbox}/.git/hooks/pre-commit"
  _pii_reset

  # 15. Chain works from a linked worktree (--git-common-dir; --git-dir
  #     points at .git/worktrees/<name>, which has no hooks/)
  # SC2016: single quotes deliberate; expands when the generated hook runs.
  # shellcheck disable=SC2016
  printf '#!/bin/zsh\ntouch "$(git rev-parse --show-toplevel)/wt-marker"\n' \
    > "${pii_sandbox}/.git/hooks/pre-commit"
  chmod 755 "${pii_sandbox}/.git/hooks/pre-commit"
  git -C "${pii_sandbox}" worktree add -q "${pii_sandbox}/wt" -b pii-wt 2>/dev/null
  echo "clean" > "${pii_sandbox}/wt/notes.md"
  git -C "${pii_sandbox}/wt" add -A
  hook_rc=0
  hook_out="$(cd "${pii_sandbox}/wt" && \
    env PII_HOOK_PATTERNS="${pii_seam_patterns}" PII_HOOK_SSH_CONFIG=/dev/null \
        "${pii_hook}" 2>&1)" || hook_rc=$?
  if [[ -f "${pii_sandbox}/wt/wt-marker" ]]; then
    _pass "chain reaches the common-dir hook from a linked worktree"
  else
    _fail "chain reaches the common-dir hook from a linked worktree — marker missing (rc=${hook_rc})"
  fi

  # 16. hook-forward passes args and exit status for non-pre-commit hooks;
  #     exits 0 when the repo has no such hook
  local fwd_dir
  fwd_dir="$(mktemp -d "${TMPDIR:-/tmp}/pii-fwd.XXXXXX")"
  ln -s "${SCRIPT_DIR}/.config/git/hooks/hook-forward" "${fwd_dir}/commit-msg"
  printf '#!/bin/zsh\ntouch fwd-marker\nexit 3\n' > "${pii_sandbox}/.git/hooks/commit-msg"
  chmod 755 "${pii_sandbox}/.git/hooks/commit-msg"
  hook_rc=0
  (cd "${pii_sandbox}" && "${fwd_dir}/commit-msg" MSGFILE >/dev/null 2>&1) || hook_rc=$?
  if [[ -f "${pii_sandbox}/fwd-marker" ]] && (( hook_rc == 3 )); then
    _pass "hook-forward runs the repo hook and propagates its exit"
  else
    _fail "hook-forward runs the repo hook — marker=$([[ -f ${pii_sandbox}/fwd-marker ]] && echo yes || echo no) rc=${hook_rc}"
  fi
  /bin/rm -f "${pii_sandbox}/.git/hooks/commit-msg" "${pii_sandbox}/fwd-marker"
  hook_rc=0
  (cd "${pii_sandbox}" && "${fwd_dir}/commit-msg" >/dev/null 2>&1) || hook_rc=$?
  if (( hook_rc == 0 )); then
    _pass "hook-forward exits 0 when the repo has no hook"
  else
    _fail "hook-forward exits 0 when the repo has no hook — rc=${hook_rc}"
  fi

  # --- commit-msg message gate (real global hook since 2026-08-17) ---

  local msg_hook="${SCRIPT_DIR}/.config/git/hooks/commit-msg"
  pii_msgfile="$(mktemp "${TMPDIR:-/tmp}/pii-hook-msg.XXXXXX")"

  # 17. Clean message passes
  printf 'retire the ledger\n\nBody prose.\n' > "${pii_msgfile}"
  _pii_msg_run "${msg_hook}"
  _pii_expect_pass "clean commit message passes"

  # 18. Denylist hit in the title blocks (line one; no separate field)
  printf 'deployed to zorblefrobnicate\n' > "${pii_msgfile}"
  _pii_msg_run "${msg_hook}"
  _pii_expect_block "denylist hit in message title blocks" "PII pattern"

  # 19. MAC-shaped token in the body blocks
  printf 'swap NIC\n\nnew iface at %s\n' "${mac}" > "${pii_msgfile}"
  _pii_msg_run "${msg_hook}"
  _pii_expect_block "MAC token in message body blocks" "MAC/UUID"

  # 20. Comment lines are stripped before scanning: the hook sees the
  #     PRE-cleanup file (2026-08-17), so the status template and `commit -v`
  #     diffs arrive as `#` lines. The `-m`-keeps-`#`-lines gap this opens is
  #     closed by the pre-push stored-message scan (tests/git-sign).
  printf 'clean subject\n# on branch zorblefrobnicate\n' > "${pii_msgfile}"
  _pii_msg_run "${msg_hook}"
  _pii_expect_pass "comment lines are not scanned"

  # 21. Content below the scissors line is ignored (the hook truncates it;
  #     git stripspace does not)
  printf 'clean subject\n# ------------------------ >8 ------------------------\ndiff mentioning zorblefrobnicate\n' > "${pii_msgfile}"
  _pii_msg_run "${msg_hook}"
  _pii_expect_pass "content below the scissors line is not scanned"

  # 22. PII_HOOK_BYPASS=1 skips the message scan, loudly; needs a tty (script)
  printf 'deployed to zorblefrobnicate\n' > "${pii_msgfile}"
  _pii_msg_run_tty "${msg_hook}" PII_HOOK_BYPASS=1
  _pii_expect_pass "PII_HOOK_BYPASS=1 passes the message gate (with a terminal)"
  if [[ "${hook_out}" == *"SKIPPED"* ]]; then
    _pass "message-gate bypass warns loudly"
  else
    _fail "message-gate bypass warns loudly — no SKIPPED warning in output"
  fi

  # 22b. With no tty the message gate ignores the variable, still blocks and
  #      names the user's own terminal.
  printf 'deployed to zorblefrobnicate\n' > "${pii_msgfile}"
  _pii_msg_run_notty "${msg_hook}" PII_HOOK_BYPASS=1
  _pii_expect_block "PII_HOOK_BYPASS=1 is refused without a terminal on the message gate" "PII pattern"
  if [[ "${hook_out}" == *"ignored: no controlling terminal"* && "${hook_out}" == *"OWN terminal"* ]]; then
    _pass "message-gate refusal names the missing terminal and the user's own"
  else
    _fail "message-gate refusal line missing or malformed: ${hook_out}"
  fi

  # 23. applypatch-msg symlinks to commit-msg (git never runs a custom
  #     commit-msg for `git am` — githooks(5))
  printf 'am-applied zorblefrobnicate patch\n' > "${pii_msgfile}"
  _pii_msg_run "${SCRIPT_DIR}/.config/git/hooks/applypatch-msg"
  _pii_expect_block "applypatch-msg symlink scans too" "PII pattern"

  # 24. Chain: the repo's commit-msg runs FIRST, its exit propagates, and a
  #     message it REWRITES is scanned in rewritten form
  printf '#!/bin/zsh\nexit 7\n' > "${pii_sandbox}/.git/hooks/commit-msg"
  chmod 755 "${pii_sandbox}/.git/hooks/commit-msg"
  printf 'clean subject\n' > "${pii_msgfile}"
  _pii_msg_run "${msg_hook}"
  if (( hook_rc == 7 )); then
    _pass "chained commit-msg exit status propagates"
  else
    _fail "chained commit-msg exit status propagates — expected 7, got ${hook_rc}"
  fi
  # SC2016: single quotes deliberate; expands when the generated hook runs.
  # shellcheck disable=SC2016
  printf '#!/bin/zsh\necho "ps: ran on zorblefrobnicate" >> "$1"\n' \
    > "${pii_sandbox}/.git/hooks/commit-msg"
  chmod 755 "${pii_sandbox}/.git/hooks/commit-msg"
  printf 'clean subject\n' > "${pii_msgfile}"
  _pii_msg_run "${msg_hook}"
  _pii_expect_block "message rewritten by the chained hook is scanned" "PII pattern"
  /bin/rm -f "${pii_sandbox}/.git/hooks/commit-msg"

  # 25. End to end through real git: commit-msg fires on --allow-empty;
  #     --no-verify is the documented hole
  local ge=(env PII_HOOK_PATTERNS="${pii_seam_patterns}" PII_HOOK_SSH_CONFIG=/dev/null
            git -C "${pii_sandbox}" -c core.hooksPath="${SCRIPT_DIR}/.config/git/hooks")
  if "${ge[@]}" commit -q --allow-empty -m "ledger event, clean" 2>/dev/null; then
    _pass "real --allow-empty commit passes the gate"
  else
    _fail "real --allow-empty commit passes the gate — blocked"
  fi
  if "${ge[@]}" commit -q --allow-empty -m "event on zorblefrobnicate" 2>/dev/null; then
    _fail "real commit with PII message — expected block, committed"
  else
    _pass "real commit with PII message blocks"
  fi
  if "${ge[@]}" commit -q --no-verify --allow-empty -m "event on zorblefrobnicate" 2>/dev/null; then
    _pass "--no-verify bypasses commit-msg (pre-push message gate is the backstop)"
  else
    _fail "--no-verify bypasses commit-msg — unexpectedly blocked"
  fi

  # --- bookkeeping pins: sentinel, common dir, stub path maths ---

  _pii_forward_cases "${fwd_dir}"
  _pii_scan_sentinel_cases
  local stub_root
  stub_root="$(mktemp -d "${TMPDIR:-/tmp}/pii-stubs.XXXXXX")/repo"
  git init -q "${stub_root}"
  _pii_stub_chain_cases "${stub_root}"

  /bin/rm -rf "${pii_sandbox}" "${fwd_dir}" "${stub_root:h}"
  /bin/rm -f "${pii_seam_patterns}" "${pii_msgfile}"
}
