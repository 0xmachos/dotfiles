#!/bin/zsh
# dotfiles/tests/bao-mcp-env
#
# Hermetic suite for bin/bao-mcp-env: no network, no secret. The
# BAO_MCP_ENV_BAO seam points at tests/fixtures/bao-mcp-env/fake-bao, which
# records every call and serves scripted responses. HOME points at a per-test
# fixture dir, so the tool's own path construction runs unmodified against a
# fake ~/Library/Application Support/openbao/claude/ (space included; path
# moved 2026-09-18).
#
# Pins:
#   - the path with its space resolves and is read (2026-09-18 regression);
#   - role_id/secret_id reach auth/approle/login only as "@<path>" file
#     references, never literal argv values or in the login call's env;
#   - the exec'd child gets exactly the secret's fields verbatim, never
#     BAO_TOKEN, and a NAME="$F" prefix at the start of an argument passes;
#   - `token revoke -self` fires exactly once, on success and on kv failure;
#   - a malformed field name aborts rather than reaching `eval`;
#   - exit 1 on a missing credential, a non-https address, a login failure and
#     a kv failure: kv is never read after a login failure, revoke is never
#     skipped after a kv one;
#   - exit 65 and no exec when a field would reach argv, as a $F reference or
#     a pasted literal of 8 or more characters (2026-10-10).
#
# Run: ./test bao-mcp-env
# ShellCheck: lint with `shellcheck --shell=bash tests/bao-mcp-env`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib
# shellcheck disable=SC2016,SC2329

typeset -g BME_T='' BME_REC='' BME_HOME='' BME_CRED_DIR='' BME_BIN='' BME_FX=''
typeset -g BME_RC=0 BME_CHILD='' BME_KEY_VALUE='' BME_BAD=''
typeset -ga BME_EXTRA=()

function _bme_setup {
  # zf_* builtins: no rm, mkdir or chmod process per case.
  zmodload -F zsh/files b:zf_rm b:zf_mkdir b:zf_chmod b:zf_rmdir
  BME_T="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/bao-mcp-env-test.XXXXXX")"
  BME_REC="${BME_T}/rec"
  # The space in "Application Support" is the point.
  BME_HOME="${BME_T}/home"
  BME_CRED_DIR="${BME_HOME}/Library/Application Support/openbao/claude"
  zf_mkdir -p "${BME_REC}" "${BME_CRED_DIR}"
  BME_BIN="${SCRIPT_DIR}/bin/bao-mcp-env"
  BME_FX="${SCRIPT_DIR}/tests/fixtures/bao-mcp-env"
}

function _bme_teardown {
  [[ -n "${BME_T}" && -d "${BME_T}" ]] && zf_rm -rf "${BME_T}"
}

# Writes role_id, secret_id and addr into the fixture credential dir. The
# missing-credentials/address tests skip it or remove a file after it.
function _bme_write_creds {
  printf 'fake-role-id-0000\n' > "${BME_CRED_DIR}/role_id"
  printf 'fake-secret-id-0000\n' > "${BME_CRED_DIR}/secret_id"
  printf 'https://fake-bao.invalid:8200\n' > "${BME_CRED_DIR}/addr"
  zf_chmod 600 "${BME_CRED_DIR}/role_id" "${BME_CRED_DIR}/secret_id" "${BME_CRED_DIR}/addr"
}

# Real jq is used (pure filter). The child starts from an empty environment
# (env -i) plus fixture values, so a case that prints the child's env (the
# /usr/bin/env child below) can never echo the caller's variables into test
# output or a CI log. Extra env pairs come from BME_EXTRA, cleared
# afterwards.
function _bme_run {
  BME_RC=0
  zf_rm -rf "${BME_REC}"
  zf_mkdir -p "${BME_REC}"
  /usr/bin/env -i \
    PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin" TMPDIR="${TMPDIR:-/tmp}" \
    HOME="${BME_HOME}" \
    BAO_MCP_ENV_BAO="${BME_FX}/fake-bao" FAKE_BAO_DIR="${BME_REC}" \
    "${BME_EXTRA[@]}" \
    "${BME_BIN}" "$@" > "${BME_T}/out" 2> "${BME_T}/err" || BME_RC=$?
  BME_EXTRA=()
}

function _bme_calls {
  if [[ -f "${BME_REC}/calls" ]]; then print -r -- "$(<"${BME_REC}/calls")"; else print 0; fi
}

# grep -q without the spawn: <pattern> is a literal, `^` and `$` anchor a line
# start and end. A missing file never matches (like grep -q ... 2>/dev/null).
function _bme_has {
  local file="$1" pat="$2" at_start=0 at_end=0 line
  [[ -r "${file}" ]] || return 1
  if [[ "${pat}" == '^'* ]]; then at_start=1; pat="${pat#^}"; fi
  if [[ "${pat}" == *'$' ]]; then at_end=1; pat="${pat%$}"; fi
  while IFS= read -r line || [[ -n "${line}" ]]; do
    if (( at_start && at_end )); then
      [[ "${line}" == "${pat}" ]] && return 0
    elif (( at_start )); then
      [[ "${line}" == "${pat}"* ]] && return 0
    elif (( at_end )); then
      [[ "${line}" == *"${pat}" ]] && return 0
    else
      [[ "${line}" == *"${pat}"* ]] && return 0
    fi
  done < "${file}"
  return 1
}

# Runs a command that must be refused as a field reaching argv and leaves the
# problems in BME_BAD (empty when all hold): exit 65, the message names the field
# and the fix, stdout empty, the child never ran, no value echoed, and login +
# kv + exactly one revoke. Usage: <field> <command and args...>.
function _bme_refusal_problems {
  local field="$1"
  shift
  BME_BAD=''
  _bme_run mcp/example-service "$@"
  (( BME_RC == 65 )) || BME_BAD+=" rc=${BME_RC}"
  _bme_has "${BME_T}/err" "bao-mcp-env: field ${field} would reach argv; pass it as an env prefix" \
    || BME_BAD+=" message"
  [[ -s "${BME_T}/out" ]] && BME_BAD+=" stdout-not-empty"
  [[ -e "${BME_REC}/child-ran" ]] && BME_BAD+=" child-ran"
  _bme_has "${BME_T}/err" "${BME_KEY_VALUE}" && BME_BAD+=" value-echoed"
  [[ "$(_bme_calls)" == 3 ]] && _bme_has "${BME_REC}/argv.3" '^revoke$' \
    || BME_BAD+=" revoke(calls=$(_bme_calls))"
  return 0
}

# A child that records its start in the record dir and prints its environment.
# A refusal case proves "the child never ran" by the absent marker.
function _bme_write_child {
  BME_CHILD="${BME_T}/child"
  printf '%s\n' '#!/bin/sh' ": > \"${BME_REC}/child-ran\"" '/usr/bin/env' > "${BME_CHILD}"
  zf_chmod 700 "${BME_CHILD}"
}

# --- test cases --------------------------------------------------------------

function _bme_test_cases {
  local bad

  # 1. Success, through an env prefix NAME="$F" (the sanctioned way to use a
  #    field). Fields reach the child verbatim, BAO_TOKEN does not, the token
  #    is revoked before exec, and the credentials reach bao only as @file
  #    references.
  _section "bao-mcp-env: success path"
  _bme_write_creds
  _bme_run mcp/example-service /bin/sh -c 'X_PREFIXED="$FAKE_FIELD_ONE" exec /usr/bin/env'
  bad=''
  (( BME_RC == 0 )) || bad+=" rc=${BME_RC}"
  _bme_has "${BME_T}/out" '^FAKE_FIELD_ONE=one-value$' || bad+=" field-one"
  _bme_has "${BME_T}/out" '^FAKE_FIELD_TWO=two-value$' || bad+=" field-two"
  _bme_has "${BME_T}/out" '^X_PREFIXED=one-value$' || bad+=" prefix"
  _bme_has "${BME_T}/out" '^BAO_TOKEN=' && bad+=" BAO_TOKEN-leaked"
  _bme_has "${BME_T}/out" '^BAO_ADDR=' || bad+=" BAO_ADDR-missing"
  [[ "$(_bme_calls)" == 3 ]] && _bme_has "${BME_REC}/argv.3" '^revoke$' \
    || bad+=" revoke(calls=$(_bme_calls))"
  _bme_has "${BME_REC}/argv.1" 'role_id=@' && _bme_has "${BME_REC}/argv.1" 'secret_id=@' \
    || bad+=" no-@file-refs"
  _bme_has "${BME_REC}/argv.1" "$(<"${BME_CRED_DIR}/role_id")" && bad+=" role_id-in-argv"
  _bme_has "${BME_REC}/argv.1" "$(<"${BME_CRED_DIR}/secret_id")" && bad+=" secret_id-in-argv"
  local envfile
  for envfile in "${BME_REC}"/env.*(N); do
    _bme_has "${envfile}" "$(<"${BME_CRED_DIR}/secret_id")" && bad+=" secret_id-in-env"
  done
  if [[ -z "${bad}" ]]; then
    _pass "success: fields and prefix reach the child, no BAO_TOKEN, credentials only as @file, token revoked"
  else
    _fail "success path wrong:${bad}; stderr: $(/usr/bin/head -c 200 "${BME_T}/err")"
  fi

  # 2. Missing credentials: exit 1, bao never invoked, message names the
  #    migrated path (space included).
  _section "bao-mcp-env: failure contracts"
  zf_rm -f "${BME_CRED_DIR}/role_id" "${BME_CRED_DIR}/secret_id"
  _bme_run mcp/example-service /usr/bin/env
  if (( BME_RC == 1 )) && [[ "$(_bme_calls)" == 0 ]] \
     && _bme_has "${BME_T}/err" 'AppRole credentials missing or unreadable' \
     && _bme_has "${BME_T}/err" 'Library/Application Support/openbao/claude'; then
    _pass "credentials absent: exit 1, bao never invoked, message names the real path"
  else
    _fail "credentials absent: rc=${BME_RC}, bao calls $(_bme_calls)"
  fi

  # 3. A non-https address is refused, bao never invoked. The address is
  #    private wiring and never falls back to a default.
  _bme_write_creds
  printf 'http://fake-bao.invalid:8200\n' > "${BME_CRED_DIR}/addr"
  _bme_run mcp/example-service /usr/bin/env
  if (( BME_RC == 1 )) && [[ "$(_bme_calls)" == 0 ]] \
     && _bme_has "${BME_T}/err" 'must hold one https:// URL'; then
    _pass "address not https: exit 1, bao never invoked"
  else
    _fail "address not https: rc=${BME_RC}, bao calls $(_bme_calls)"
  fi

  # 4. Login failure: exit 1 and kv is never read.
  _bme_write_creds
  BME_EXTRA=(FAKE_BAO_LOGIN_FAIL=1)
  _bme_run mcp/example-service /usr/bin/env
  if (( BME_RC == 1 )) && [[ "$(_bme_calls)" == 1 ]] \
     && _bme_has "${BME_T}/err" 'AppRole login failed'; then
    _pass "login denied: exit 1, exactly one bao call (kv never attempted)"
  else
    _fail "login denied: rc=${BME_RC}, bao calls $(_bme_calls)"
  fi

  # 5. kv failure: exit 1 and the token is still revoked.
  BME_EXTRA=(FAKE_BAO_KV_FAIL=1)
  _bme_run mcp/example-service /usr/bin/env
  if (( BME_RC == 1 )) && [[ "$(_bme_calls)" == 3 ]] \
     && _bme_has "${BME_REC}/argv.3" '^revoke$' \
     && _bme_has "${BME_T}/err" 'read of kv/mcp/example-service failed'; then
    _pass "kv read denied: exit 1, token revoked even on failure"
  else
    _fail "kv read denied: rc=${BME_RC}, bao calls $(_bme_calls)"
  fi

  # 6. A malformed field name aborts rather than reaching eval.
  printf '{"data":{"data":{"not a valid name":"x"}}}' > "${BME_T}/malformed.json"
  BME_EXTRA=(FAKE_BAO_KV_JSON="${BME_T}/malformed.json")
  _bme_run mcp/example-service /usr/bin/env
  if (( BME_RC != 0 )) && ! _bme_has "${BME_T}/out" '^not a valid name='; then
    _pass "malformed field name aborts (rc ${BME_RC}) and is never exported"
  else
    _fail "malformed field name did not abort cleanly (rc ${BME_RC})"
  fi

  # 7 and 8. A field that would reach argv is refused with exit 65 and no
  #    exec. MCP_API_KEY holds 8 or more characters. Fixture values are fakes.
  _section "bao-mcp-env: refuses a field that would reach argv"
  _bme_write_child
  BME_KEY_VALUE='fake-key-value-1'
  printf '{"data":{"data":{"MCP_API_KEY":"%s","MCP_PORT":"8200"}}}' "${BME_KEY_VALUE}" > "${BME_T}/argv.json"
  local json="FAKE_BAO_KV_JSON=${BME_T}/argv.json"

  BME_EXTRA=("${json}")
  _bme_refusal_problems MCP_API_KEY /bin/sh -c "exec \"${BME_CHILD}\" -H x \"\$MCP_API_KEY\""
  if [[ -z "${BME_BAD}" ]]; then
    _pass "a \$F reference in an argument is refused (65), child never ran, token revoked once"
  else
    _fail "\$F reference refusal wrong:${BME_BAD}"
  fi

  BME_EXTRA=("${json}")
  _bme_refusal_problems MCP_API_KEY "${BME_CHILD}" "--key=${BME_KEY_VALUE}"
  if [[ -z "${BME_BAD}" ]]; then
    _pass "a pasted literal of 8 or more characters is refused (65), child never ran, token revoked once"
  else
    _fail "pasted literal refusal wrong:${BME_BAD}"
  fi
}

function run_bao_mcp_env {
  if [[ ! -x "${SCRIPT_DIR}/bin/bao-mcp-env" || ! -x "${SCRIPT_DIR}/tests/fixtures/bao-mcp-env/fake-bao" ]]; then
    _skip "bao-mcp-env: bin/bao-mcp-env or its fake-bao fixture is missing"
    return
  fi
  if ! command -v jq >/dev/null 2>&1; then
    _skip "bao-mcp-env: jq not installed"
    return
  fi

  _bme_setup
  _bme_test_cases
  _bme_teardown
}
