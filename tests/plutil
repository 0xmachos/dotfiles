#!/bin/zsh
# dotfiles/tests/plutil
#
# Validate plist and mobileconfig files with plutil(1).
#
# ShellCheck: lint with `shellcheck --shell=bash tests/plutil`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

function run_plutil {
  _section "Plutil"

  local -a files
  local file
  while IFS=$'\n' read -r file; do
    files+=("${file}")
  done < <(/usr/bin/find . -maxdepth 4 \
            -type f \
            \( -name "*.plist" -o -name "*.mobileconfig" \))

  (( ${#files} )) || return 0

  # One plutil run covers the common all-valid case; a failure falls back to
  # per-file runs so each diagnostic names its file.
  local output
  if /usr/bin/plutil -lint "${files[@]}" >/dev/null 2>&1; then
    for file in "${files[@]}"; do
      _pass "${file:t}"
    done
    return
  fi
  for file in "${files[@]}"; do
    output=""
    if output="$(/usr/bin/plutil -lint "${file}" 2>&1)"; then
      _pass "${file:t}"
    else
      _fail "${file:t}: ${output}"
    fi
  done
}
