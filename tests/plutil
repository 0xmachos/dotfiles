#!/bin/zsh
# dotfiles/tests/plutil
#
# Validate every plist and mobileconfig file with plutil(1): one scan over the
# whole tree, one summary result. A failure falls back to per-file runs so each
# diagnostic names its file.
#
# ShellCheck: lint with `shellcheck --shell=bash tests/plutil`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

function run_plutil {
  _section "Plutil"

  local -a files
  local file
  while IFS=$'\n' read -r file; do
    files+=("${file}")
  done < <(/usr/bin/find . -maxdepth 4 \
            -type f -not -path "./.claude/*" \
            \( -name "*.plist" -o -name "*.mobileconfig" \))

  (( ${#files} )) || return 0

  # One plutil run covers the common all-valid case; a failure falls back to
  # per-file runs so each diagnostic names its file.
  local output
  if /usr/bin/plutil -lint "${files[@]}" >/dev/null 2>&1; then
    _pass "all ${#files[@]} plist and mobileconfig files pass plutil"
    return
  fi
  local -i bad=0
  for file in "${files[@]}"; do
    output=""
    output="$(/usr/bin/plutil -lint "${file}" 2>&1)" || { _fail "${file:t}: ${output}"; bad+=1; }
  done
  (( bad )) || _fail "plutil rejected the combined scan but no single file"
}
