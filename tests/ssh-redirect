#!/bin/zsh
# dotfiles/tests/ssh-redirect
#
# Behavioural test for claude/hooks/ssh-redirect-hook (PreToolUse): denies
# ssh/scp/sftp/rsync/sshfs/mosh to the user's SSH alias (or its `tail-`
# variant) and points at the `<host>-claude` twin. Asserts DENY vs PASS.
#
# The alias/twin map is derived at run time from the fixture config under
# tests/fixtures/ssh-redirect/ via the hook's SSH_REDIRECT_CONFIG (and HOME,
# for the Include cases) seam. Placeholder names only: hosta (+tail-hosta)
# base pair; hostb no twin; hostc from a relative glob Include; hosth from a
# tilde Include; hostd/hoste/hostf extra pairs; hostg-claude with no bare
# hostg; hostw* a wildcard Host line paired with a real hostw-claude.
# hosta-herdr and hosta-rex app aliases beside hosta-claude (DENY); hostb-herdr
# and hostb-rex with no hostb-claude (PASS).
#
# Covers, one input each: the exact deny reason and twin for each alias kind
# (plain, tail- derived, -herdr, -rex); the Rex bridge shared login socket; a
# ProxyJump hop; a wrapper, a shell -c string and a sibling tool across several
# segments; the PASS guard (no twin, -claude alias, raw IP); the segment cap;
# the Include file cap and an Include cycle; no bypass through SSH_REDIRECT_SKIP
# or an exported HOOK_PRE_DISPATCH, with the one-line JSON deny; and fail-open
# on a malformed payload and on a /dev/null config.
# Verdict cases run the guard through the pretool-dispatch seam
# (_hook_run_seam in tests/lib). The process-path cases run the hook as
# `/bin/zsh <hook>` with JSON on stdin.
#
# Run: ./test ssh-redirect
# ShellCheck: lint with `shellcheck --shell=bash tests/ssh-redirect`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

typeset -g SSHR_T_HOME=''
typeset -g SSHR_T_CONFIG=''

# Hook output of the last _ssh_redirect_hook call.
typeset -g SSHR_T_OUT=''

# Verdict of the last _ssh_redirect_seam call.
typeset -g SSHR_T_VERDICT=''

function _ssh_redirect_hook {
  # Set SSHR_T_OUT to the hook's stdout+stderr for command $3 under
  # SSH_REDIRECT_CONFIG=$1 and HOME=$2.
  # stderr is merged on purpose: a bare `local` re-declared in a loop prints
  # `name=value` to STDOUT, which must fail via _hook_verdict's INVALID.
  _json_str "$3"
  SSHR_T_OUT="$(print -r -- "{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":${REPLY}}}" \
    | SSH_REDIRECT_CONFIG="$1" HOME="$2" \
      /bin/zsh "${SCRIPT_DIR}/claude/hooks/ssh-redirect-hook" 2>&1)"
}

function _ssh_redirect_seam {
  # Seam run of command $3 under SSH_REDIRECT_CONFIG=$1 and HOME=$2. Sets
  # HOOK_SEAM_* and SSHR_T_VERDICT: the seam verdict, forced to INVALID when
  # the guard wrote to stderr (the standalone path merged stderr into stdout).
  _hook_run_seam SSH_REDIRECT_CONFIG="$1" HOME="$2" -- \
    "${SCRIPT_DIR}/claude/hooks/ssh-redirect-hook" Bash "$3"
  SSHR_T_VERDICT="${HOOK_SEAM_VERDICT}"
  if [[ -n "${HOOK_SEAM_ERR}" ]]; then SSHR_T_VERDICT=INVALID; fi
}

function _ssh_redirect_one {
  # One input, one case. $1 want, $2 command, $3 label, $4 optional exact
  # deny reason. Runs the seam against the fixture config.
  _ssh_redirect_seam "${SSHR_T_CONFIG}" "${SSHR_T_HOME}" "$2"
  if [[ "${SSHR_T_VERDICT}" != "$1" ]]; then
    _fail "$3 — expected $1, got ${SSHR_T_VERDICT} (${HOOK_SEAM_OUT:0:100}${HOOK_SEAM_ERR:0:100})"
  elif [[ -n "${4:-}" && "${HOOK_SEAM_REASON}" != "$4" ]]; then
    _fail "$3 — reason '${HOOK_SEAM_REASON}'"
  else
    _pass "$1: $3"
  fi
}

function _ssh_redirect_bounded {
  # Verdict of command $3 under config $1 and HOME $2, with the hook run under
  # a 60 s alarm. A killed or failing hook gives a marker, never the empty
  # output a PASS is made of. Sets SSHR_T_VERDICT.
  local raw rc out
  _json_str "$3"
  # shellcheck disable=SC2154  # zsh pipestatus array
  raw="$(print -r -- "{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":${REPLY}}}" \
    | SSH_REDIRECT_CONFIG="$1" HOME="$2" \
      /usr/bin/perl -e 'alarm 60; exec @ARGV or die "exec: $!"' \
        /bin/zsh "${SCRIPT_DIR}/claude/hooks/ssh-redirect-hook" 2>&1
    print -rn -- "@rc=${pipestatus[-1]}")" || raw='@rc=unknown'
  rc="${raw##*@rc=}"
  out="${raw%@rc=*}"
  out="${out%$'\n'}"
  if [[ "${rc}" != 0 ]]; then
    SSHR_T_VERDICT="INVALID(status ${rc})"
  else
    SSHR_T_VERDICT="$(_hook_verdict "${out}")"
  fi
}

function run_ssh_redirect {
  _section "ssh → claude-alias redirect hook"

  # claude/ is gitignored: an absent hook skips the suite.
  if [[ ! -f "${SCRIPT_DIR}/claude/hooks/ssh-redirect-hook" ]]; then
    _skip "claude/hooks/ssh-redirect-hook absent — claude/ not yet synced to this machine"
    return 0
  fi

  if ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
    return
  fi

  SSHR_T_HOME="${SCRIPT_DIR}/tests/fixtures/ssh-redirect/home"
  SSHR_T_CONFIG="${SSHR_T_HOME}/.ssh/config"

  if [[ ! -f "${SSHR_T_CONFIG}" ]]; then
    _fail "fixture config missing at ${SSHR_T_CONFIG}"
    return
  fi

  # Each alias kind denies with its exact reason and the right twin.
  _ssh_redirect_one DENY 'ssh hosta' 'the user alias' "hosta is the user's SSH alias: use hosta-claude instead."
  _ssh_redirect_one DENY 'ssh tail-hostc' 'a tail- alias derived from an Include-declared host' \
    "tail-hostc is the user's SSH alias: use hostc-claude instead."
  _ssh_redirect_one DENY 'ssh hosta-herdr' 'a -herdr app alias beside a -claude twin' \
    "hosta-herdr is Herdr.app's SSH alias: use hosta-claude instead."
  _ssh_redirect_one DENY 'ssh -T hosta-rex' 'a -rex app alias beside a -claude twin' \
    "hosta-rex is Rex's SSH alias: use hosta-claude instead."
  _ssh_redirect_one DENY 'ssh -Smux-hosta-rex anyword' "the Rex bridge's shared login socket" \
    "That control socket is the Rex bridge's shared SSH login: use the host's -claude alias instead."
  _ssh_redirect_one DENY 'ssh -J hosta hostb-claude' 'a ProxyJump hop to a human alias'

  # A wrapper, a shell -c string and scp, behind several segments, one input
  # (a repeated local in the segment loop once leaked name=value to stdout).
  _ssh_redirect_one DENY "echo ok; ssh hostb uptime; sudo timeout 5 sh -c 'scp f hosta:/x'" \
    'wrapper walk, -c string and scp across several segments'

  # PASS guard.
  _ssh_redirect_one PASS 'ssh hostb' 'a host with no -claude twin'
  _ssh_redirect_one PASS 'ssh hosta-claude' 'the -claude alias itself'
  _ssh_redirect_one PASS 'ssh 192.0.2.1' 'a raw IP literal'

  # Segment cap: the hook scans the first 500 segments and fails open past them.
  local seg_cmd='' seg_i
  for (( seg_i = 0; seg_i < 499; seg_i++ )); do seg_cmd+='true; '; done
  _ssh_redirect_one PASS "${seg_cmd}true; ssh hosta" 'ssh at segment 501, past the segment cap, fails open'

  # Include limits, on trees built under a scratch directory: the 4096-file
  # cap, and a file that includes itself twice beside a deep chain (without the
  # visited set its copies fill the queue ahead of chain16).
  local sshr_scratch sshr_home sshr_i
  sshr_scratch="$(mktemp -d "${TMPDIR:-/tmp}/ssh-redirect.XXXXXX")" || sshr_scratch=''
  if [[ -z "${sshr_scratch}" ]]; then
    _fail "could not create a scratch directory for the Include cases"
  else
    # Files c2..c4097 chain onward from the config: c4096 is read, c4097 is not.
    sshr_home="${sshr_scratch}/depth"
    /bin/mkdir -p "${sshr_home}/.ssh"
    print -r -- 'Include c2' > "${sshr_home}/.ssh/config"
    for (( sshr_i = 2; sshr_i <= 4097; sshr_i++ )); do
      case "${sshr_i}" in
        4096) print -r -- $'Host deepa\nHost deepa-claude\nInclude c4097' ;;
        4097) print -r -- $'Host deepb\nHost deepb-claude' ;;
        *) print -r -- "Include c$(( sshr_i + 1 ))" ;;
      esac > "${sshr_home}/.ssh/c${sshr_i}"
    done
    _ssh_redirect_bounded "${sshr_home}/.ssh/config" "${sshr_home}" 'ssh deepb'
    if [[ "${SSHR_T_VERDICT}" == PASS ]]; then
      _pass "PASS: a host in the 4097th config file is past the file cap"
    else
      _fail "a host in the 4097th config file — expected PASS, got ${SSHR_T_VERDICT}"
    fi

    sshr_home="${sshr_scratch}/cycle"
    /bin/mkdir -p "${sshr_home}/.ssh"
    print -r -- $'Include loop\nInclude chain1' > "${sshr_home}/.ssh/config"
    print -r -- 'Include loop loop' > "${sshr_home}/.ssh/loop"
    for (( sshr_i = 1; sshr_i < 16; sshr_i++ )); do
      print -r -- "Include chain$(( sshr_i + 1 ))" > "${sshr_home}/.ssh/chain${sshr_i}"
    done
    print -r -- $'Host cyca\nHost cyca-claude' > "${sshr_home}/.ssh/chain16"
    _ssh_redirect_bounded "${sshr_home}/.ssh/config" "${sshr_home}" 'ssh cyca'
    if [[ "${SSHR_T_VERDICT}" == DENY ]]; then
      _pass "DENY: a self-including file does not starve the files behind it"
    else
      _fail "a host behind a self-including file — expected DENY, got ${SSHR_T_VERDICT}"
    fi
    /bin/rm -rf "${sshr_scratch}"
  fi

  # No bypass: SSH_REDIRECT_SKIP is read nowhere, and an exported
  # HOOK_PRE_DISPATCH=1 does not make a standalone hook skip (ZSH_EVAL_CONTEXT
  # lacks :file, so it reads stdin). The deny is the one-line JSON object.
  local one_want
  one_want="$(jq -cn --arg r "hosta is the user's SSH alias: use hosta-claude instead." \
    '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$r}}')"
  SSH_REDIRECT_SKIP=1 HOOK_PRE_DISPATCH=1 _ssh_redirect_hook "${SSHR_T_CONFIG}" "${SSHR_T_HOME}" 'ssh hosta'
  if [[ "${SSHR_T_OUT}" == "${one_want}" ]]; then
    _pass "no bypass: SSH_REDIRECT_SKIP and an exported HOOK_PRE_DISPATCH still give the one-line JSON deny"
  else
    _fail "standalone run with the skip variables — unexpected output: ${SSHR_T_OUT:0:200}"
  fi

  # Fail-open: a malformed payload, and a /dev/null config (over budget by one,
  # class 4: the missing-config kind of the fail-open contract).
  local shape_out
  shape_out="$(print -r -- '{not json' | SSH_REDIRECT_CONFIG="${SSHR_T_CONFIG}" HOME="${SSHR_T_HOME}" \
    /bin/zsh "${SCRIPT_DIR}/claude/hooks/ssh-redirect-hook" 2>&1)" || shape_out="rc=$?"
  if [[ -z "${shape_out}" ]]; then
    _pass "PASS: a malformed JSON payload fails open"
  else
    _fail "malformed JSON payload gave output: ${shape_out:0:100}"
  fi
  _ssh_redirect_seam /dev/null "${SSHR_T_HOME}" 'ssh hosta'
  if [[ "${SSHR_T_VERDICT}" == PASS ]]; then
    _pass "PASS: a /dev/null config fails open"
  else
    _fail "/dev/null config — expected PASS, got ${SSHR_T_VERDICT}"
  fi
}
