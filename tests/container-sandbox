#!/bin/zsh
# The container() wrapper default-mounts ~/Sandbox at /sandbox on `run` (and
# creates the host dir), and leaves an explicit /sandbox mount untouched. The
# real binary is stubbed via CONTAINER_BIN and HOME is redirected to a fixture.
# shellcheck source=tests/lib

function run_container_sandbox {
  _section "container sandbox wrapper"
  local fixture
  fixture="$(mktemp -d "${TMPDIR}container-sandbox.XXXXXX")"
  local fake="${fixture}/fake-container"
  printf '#!/bin/zsh\nprintf "%%s\\n" "$@"\n' > "${fake}"
  chmod +x "${fake}"

  # _csbx <argstring> [no_sandbox]: run the wrapper against the stub, in an
  # isolated HOME. ${=1} is zsh word-splitting of the arg string.
  _csbx() {
    (
      export HOME="${fixture}" CONTAINER_BIN="${fake}"
      [[ -n "${2:-}" ]] && export CONTAINER_NO_SANDBOX=1
      # shellcheck source=.functions/container disable=SC1091
      source "${SCRIPT_DIR}/.functions/container"
      # shellcheck disable=SC2086
      container ${=1}
    )
  }

  local out
  # Default mount on `run`, and the host dir is created when absent.
  out="$(_csbx 'run alpine')"
  if [[ "${out}" == *"--volume"* \
     && "${out}" == *"${fixture}/Sandbox:/sandbox"* \
     && "${out}" == *"alpine"* \
     && -d "${fixture}/Sandbox" ]]; then
    _pass "run: auto-mounts ~/Sandbox at /sandbox and creates the host dir"
  else
    _fail "run did not get the default mount or the host dir: ${out//$'\n'/ }"
  fi

  # The stub prints one argument per line: equality proves the caller's
  # arguments reach the binary untouched, with no mount added.
  out="$(_csbx 'run -v /x:/sandbox alpine')"
  if [[ "${out}" == $'run\n-v\n/x:/sandbox\nalpine' ]]; then
    _pass "explicit /sandbox mount is not doubled"
  else
    _fail "wrapper altered an explicit /sandbox mount: ${out//$'\n'/ }"
  fi
  /bin/rm -rf "${fixture}"
}
