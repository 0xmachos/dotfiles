#!/bin/zsh
# dotfiles/tests/zshrc-start-dir
#
# Checks the "Change into Initial Directory" section at the end of .zshrc. A
# Rex shell and a herdr-core terminal (HC_TERMINAL_ID set) keep a project start
# folder. A Rex shell that starts in / moves to INITIAL_DIR, and so does a
# shell outside Rex with an empty HC_TERMINAL_ID. The section runs in a
# subshell with a fixture HOME, never the real one.
#
# Run: ./test zshrc-start-dir
# ShellCheck: lint with `shellcheck --shell=bash tests/zshrc-start-dir`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

# _zshrc_start_dir_case <term_program> <start dir> [hc_terminal_id] — prints
# the folder the shell is in after the section runs. The third argument sets
# HC_TERMINAL_ID (a herdr-core terminal); empty or absent leaves it unset.
# shellcheck disable=SC2034  # INITIAL_DIR, TERM_PROGRAM, HC_TERMINAL_ID: read by the eval
function _zshrc_start_dir_case {
  (
    local section
    section="$(/usr/bin/awk '
      /^### Change into Initial Directory ###$/ { block = 1 }
      block { print }
    ' "${SCRIPT_DIR}/.zshrc")"
    [[ -n "${section}" ]] || { print -r -- 'section-missing'; return 0; }
    HOME="${_zsd_fixture}/home"
    INITIAL_DIR="${HOME}"
    TERM_PROGRAM="$1"
    HC_TERMINAL_ID="${3:-}"
    cd "$2" || return 1
    eval "${section}"
    print -r -- "${PWD}"
  )
}

function run_zshrc_start_dir {
  _section ".zshrc start folder: Rex and herdr-core keep the start folder"

  local _zsd_fixture home proj out
  _zsd_fixture="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/zshrc-start-dir.XXXXXX")" || {
    _fail "zshrc-start-dir: mktemp failed"
    return 0
  }
  _zsd_fixture="${_zsd_fixture:A}"
  home="${_zsd_fixture}/home"
  proj="${_zsd_fixture}/proj"
  /bin/mkdir -p "${home}" "${proj}"

  out="$(_zshrc_start_dir_case rex "${proj}")"
  if [[ "${out}" == "${proj}" ]]; then
    _pass "Rex shell started in a project folder stays there"
  else
    _fail "Rex shell in a project folder: expected '${proj}', got '${out}'"
  fi

  out="$(_zshrc_start_dir_case rex /)"
  if [[ "${out}" == "${home}" ]]; then
    _pass "Rex shell started in / moves to INITIAL_DIR"
  else
    _fail "Rex shell in /: expected '${home}', got '${out}'"
  fi

  # herdr-core: the Herdr app's launcher is a login shell with HC_TERMINAL_ID
  # set and TERM_PROGRAM another terminal's.
  out="$(_zshrc_start_dir_case Apple_Terminal "${proj}" t9)"
  if [[ "${out}" == "${proj}" ]]; then
    _pass "herdr-core terminal started in a project folder stays there"
  else
    _fail "herdr-core terminal in a project folder: expected '${proj}', got '${out}'"
  fi

  out="$(_zshrc_start_dir_case Apple_Terminal "${proj}" '')"
  if [[ "${out}" == "${home}" ]]; then
    _pass "a shell outside Rex with an empty HC_TERMINAL_ID moves to INITIAL_DIR"
  else
    _fail "empty HC_TERMINAL_ID: expected '${home}', got '${out}'"
  fi

  /bin/rm -rf -- "${_zsd_fixture}"
}
