#!/bin/zsh
# dotfiles/tests/mcp-secret-hook
#
# Behavioural test for claude/hooks/mcp-secret-hook, the PreToolUse hook that
# DENIES a Bash command or a file write that puts an MCP server key into argv
# or into a config file. Feeds tool payloads as stdin JSON and asserts the
# verdict through _hook_verdict: DENY for a key flag or a $VAR in a -c string
# on `claude mcp add` / `add-json`, for mcp-proxy with -H, and for the same
# shapes in a written config; PASS for the env-prefix form
# (API_ACCESS_TOKEN="$VAR" exec mcp-proxy ...), read-only `claude mcp`
# subcommands, curl -H, ${VAR} header values and prose that merely names
# mcp-proxy. Also checks the pretool-dispatch seam (HOOK_PRE_*), that no
# environment variable or content marker overrides the hook, and fail-open.
#
# MSH_BIN points the suite at another copy of the hook (a scratch copy with a
# check removed proves the cases go red).
#
# Run: ./test mcp-secret-hook    (or ./test for the full suite)
#
# ShellCheck: lint with `shellcheck --shell=bash tests/mcp-secret-hook`.
# This file is sourced, not executed: chmod 644.
#
# shellcheck source=tests/lib
# shellcheck disable=SC2016  # fixtures are literal command and file text

function _msh_hook {
  printf '%s' "${MSH_BIN:-${SCRIPT_DIR}/claude/hooks/mcp-secret-hook}"
}

function _msh_run_bash {
  # The command goes through stdin: a 1 MiB argument would pass ARG_MAX.
  printf '%s' "$1" | jq -Rs '{tool_name:"Bash", tool_input:{command:.}}' \
    | /bin/zsh "$(_msh_hook)"
}

# Write: $1 path, $2 content.
function _msh_run_write {
  jq -n --arg f "$1" --arg c "$2" \
    '{tool_name:"Write", tool_input:{file_path:$f, content:$c}}' \
    | /bin/zsh "$(_msh_hook)"
}

# Edit: $1 path, $2 new_string.
function _msh_run_edit {
  jq -n --arg f "$1" --arg c "$2" \
    '{tool_name:"Edit", tool_input:{file_path:$f, old_string:"x", new_string:$c}}' \
    | /bin/zsh "$(_msh_hook)"
}

# Source the hook the way pretool-dispatch does: inside a function, with the
# HOOK_PRE_* variables set as plain shell variables. $1 tool, $2 command,
# $3 content, $4 path.
function _msh_run_seam {
  /bin/zsh -c '
    function runit {
      HOOK_PRE_DISPATCH=1
      HOOK_PRE_TOOL="$1"
      HOOK_PRE_COMMAND="$2"
      HOOK_PRE_CONTENT="$3"
      HOOK_PRE_PATH="$4"
      source "$5" </dev/null
    }
    runit "$@"' zsh "$1" "$2" "$3" "$4" "$(_msh_hook)"
}

function _msh_bash {
  # $1 want, $2 command, $3 label.
  local out got
  out="$(_msh_run_bash "$2")"
  got="$(_hook_verdict "${out}")"
  if [[ "${got}" == "$1" ]]; then
    _pass "$1: ${3}"
  else
    _fail "${3} — expected $1, got ${got}"
  fi
}

function _msh_file {
  # $1 want, $2 path, $3 content, $4 label, $5 runner (default Write).
  local runner="${5:-_msh_run_write}" out got
  out="$("${runner}" "$2" "$3")"
  got="$(_hook_verdict "${out}")"
  if [[ "${got}" == "$1" ]]; then
    _pass "$1: ${4}"
  else
    _fail "${4} — expected $1, got ${got}"
  fi
}

function run_mcp_secret_hook {
  _section "MCP secret in argv or config hook"

  # claude/ is gitignored and synced out of band: an absent hook is pending
  # sync, not a regression.
  if [[ ! -f "$(_msh_hook)" ]]; then
    _skip "claude/hooks/mcp-secret-hook absent — claude/ not yet synced to this machine"
    return 0
  fi
  if ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
    return
  fi

  # An exported override would turn DENY into PASS with the suite green.
  unset MCP_SECRET_SKIP MCP_SECRET_HOOK_SKIP

  local sq="'"

  # ── Bash: claude mcp add with a key flag → DENY ─────────────────────────
  _msh_bash DENY 'claude mcp add exa -- sh -c '"${sq}"'exec mcp-proxy -H x-api-key "$EXA_API_KEY" https://h.example/mcp'"${sq}" \
    'add, sh -c with mcp-proxy -H and the key expanded'
  _msh_bash DENY 'claude mcp add --transport http exa https://h.example/mcp --header "x-api-key: ${EXA_API_KEY}"' \
    'add, --header flag'
  _msh_bash DENY 'claude mcp add --transport http exa https://h.example/mcp --headers "x: y"' \
    'add, --headers flag'
  _msh_bash DENY 'claude mcp add -s user -H "x: y" exa https://h.example/mcp' \
    'add, -H flag after a scope flag'
  _msh_bash DENY 'claude mcp add exa --api-key "$EXA_API_KEY" -- prog' 'add, --api-key flag'
  _msh_bash DENY 'claude mcp add exa --token "$T" -- prog' 'add, --token flag'
  _msh_bash DENY 'claude mcp add exa --bearer "$T" -- prog' 'add, --bearer flag'
  _msh_bash DENY 'claude mcp add exa --token=abc -- prog' 'add, --token=value form'
  _msh_bash DENY 'claude mcp add-json exa '"${sq}"'{"command":"mcp-proxy","args":["-H","x-api-key","k","https://h.example/mcp"]}'"${sq}" \
    'add-json, -H in the args array'
  _msh_bash DENY 'claude mcp add-json exa '"${sq}"'{"command":"mcp-proxy","args":["--headers","x","k"]}'"${sq}" \
    'add-json, --headers in the args array'
  _msh_bash DENY 'claude "mcp" '"${sq}"'add'"${sq}"' exa "-H" "x: y" -- prog' 'quoted subcommand words and quoted flag'
  _msh_bash DENY '/Users/x/.local/bin/claude mcp add exa -H "x: y" -- prog' 'path-qualified claude'
  _msh_bash DENY 'claude mcp add exa -- /usr/local/bin/bao-mcp-env exa sh -c '"${sq}"'exec mcp-proxy -H x "$EXA_API_KEY" u'"${sq}" \
    'add through bao-mcp-env with -H'
  _msh_bash DENY 'cd /tmp && claude mcp add exa -H "x: y" -- prog' 'add after a separator'

  # ── Bash: claude mcp add with $VAR in a -c string → DENY ───────────────
  _msh_bash DENY 'claude mcp add exa -- sh -c '"${sq}"'exec mcp-proxy https://h.example/mcp "$EXA_API_KEY"'"${sq}" \
    'add, $VAR as a positional in the -c string'
  _msh_bash DENY 'claude mcp add exa -- sh -c '"${sq}"'exec mcp-proxy https://h.example/${EXA_KEY}'"${sq}" \
    'add, ${VAR} form in the -c string'
  _msh_bash DENY 'claude mcp add exa -- sh -c '"${sq}"'exec mcp-proxy $(cat /x/key) u'"${sq}" \
    'add, $(...) in the -c string'
  _msh_bash DENY 'claude mcp add exa -- sh -c '"${sq}"'API_ACCESS_TOKEN="$K" exec prog "$K"'"${sq}" \
    'add, prefix present but $VAR also in argv'
  _msh_bash DENY 'claude mcp add exa -- sh -c '"${sq}"'exec env API_ACCESS_TOKEN="$K" prog'"${sq}" \
    'add, assignment not at the start of the -c string'
  _msh_bash DENY 'claude mcp add exa -- sh -c "exec prog $K"' \
    'add, double-quoted -c string (the outer shell expands the key)'
  _msh_bash DENY 'claude mcp add exa -- bash -c '"${sq}"'A=1 B=2 exec prog "$K"'"${sq}" \
    'add, two prefixes then $VAR in argv'
  _msh_bash DENY 'claude mcp add-json exa '"${sq}"'{"command":"sh","args":["-c","exec mcp-proxy u \"$K\""]}'"${sq}" \
    'add-json, $VAR in the -c element'
  _msh_bash DENY 'claude mcp add-json exa "{\"command\":\"sh\",\"args\":[\"-c\",\"exec mcp-proxy u \\\"\$K\\\"\"]}"' \
    'add-json, double-quoted JSON with escaped quotes'
  _msh_bash DENY 'claude mcp add-json exa '"${sq}"'{"command":"/usr/local/bin/bao-mcp-env","args":["exa","sh","-c","exec mcp-proxy u ${K}"]}'"${sq}" \
    'add-json through bao-mcp-env, ${VAR} in the -c element'
  _msh_bash DENY 'claude mcp add exa -- sh -c '"${sq}"'true'"${sq}"' && claude mcp add y -- sh -c '"${sq}"'exec p "$K"'"${sq}" \
    'a second add later in the command line'
  _msh_bash DENY 'claude mcp add exa -- sh -c '"${sq}"'echo ok'"${sq}"'
claude mcp add y -- sh -c '"${sq}"'exec p "$K"'"${sq}" 'a second add on the next line'

  # ── Bash: add-json with a literal header value → DENY ──────────────────
  _msh_bash DENY 'claude mcp add-json exa '"${sq}"'{"type":"http","url":"https://h.example/mcp","headers":{"x-api-key":"abc"}}'"${sq}" \
    'add-json, literal headers value'

  # ── Bash: mcp-proxy with -H anywhere → DENY ─────────────────────────────
  _msh_bash DENY 'mcp-proxy -H x-api-key "$K" https://h.example/mcp' 'mcp-proxy -H'
  _msh_bash DENY 'mcp-proxy --headers x-api-key k https://h.example/mcp' 'mcp-proxy --headers'
  _msh_bash DENY 'mcp-proxy --header x k https://h.example/mcp' 'mcp-proxy --header'
  _msh_bash DENY '/opt/homebrew/bin/mcp-proxy --transport=streamablehttp -H x k u' 'path-qualified mcp-proxy'
  _msh_bash DENY 'uvx mcp-proxy "-H" x k u' 'uvx mcp-proxy with a quoted flag'
  _msh_bash DENY 'sh -c '"${sq}"'exec mcp-proxy -H x "$K" u'"${sq}" 'mcp-proxy -H inside a sh -c string'
  _msh_bash DENY '/usr/local/bin/bao-mcp-env exa sh -c '"${sq}"'exec /opt/homebrew/bin/mcp-proxy -H x "$K" u'"${sq}" \
    'mcp-proxy -H under bao-mcp-env'
  _msh_bash DENY 'echo start
mcp-proxy -H x k u' 'mcp-proxy -H on a later line'

  # ── Bash: PASS ──────────────────────────────────────────────────────────
  _msh_bash PASS 'claude mcp add exa -- /usr/local/bin/bao-mcp-env exa sh -c '"${sq}"'API_ACCESS_TOKEN="$EXA_API_KEY" exec /opt/homebrew/bin/mcp-proxy --transport=streamablehttp https://h.example/mcp'"${sq}" \
    'add with the env-prefix form'
  _msh_bash PASS 'claude mcp add-json exa '"${sq}"'{"command":"/usr/local/bin/bao-mcp-env","args":["exa","sh","-c","API_ACCESS_TOKEN=\"$EXA_API_KEY\" exec /opt/homebrew/bin/mcp-proxy --transport=streamablehttp https://h.example/mcp"]}'"${sq}" \
    'add-json with the env-prefix form'
  _msh_bash PASS 'claude mcp add exa -- sh -c '"${sq}"'A=1 API_ACCESS_TOKEN="$K" exec mcp-proxy u'"${sq}" \
    'add with two assignment prefixes'
  _msh_bash PASS 'claude mcp add exa -- sh -c '"${sq}"'API_ACCESS_TOKEN="$K" exec mcp-proxy u'"${sq}"' ; echo "$HOME"' \
    'a $VAR after the end of the -c string is not in that string'
  _msh_bash PASS 'claude mcp add-json exa '"${sq}"'{"type":"http","url":"https://h.example/mcp","headers":{"x-api-key":"${EXA_API_KEY}"}}'"${sq}" \
    'add-json, http entry with a ${VAR} header value'
  _msh_bash PASS 'claude mcp add-json exa "{\"command\":\"sh\",\"args\":[\"-c\",\"API_ACCESS_TOKEN=\\\"\$K\\\" exec mcp-proxy u\"]}"' \
    'add-json, double-quoted JSON with the env-prefix form'
  _msh_bash PASS 'claude mcp add exa -s user -- /usr/local/bin/mcp-foo --port 8080' 'add, plain stdio entry'
  _msh_bash PASS 'claude mcp list' 'claude mcp list'
  _msh_bash PASS 'claude mcp get exa' 'claude mcp get'
  _msh_bash PASS 'claude mcp remove exa -s user' 'claude mcp remove'
  _msh_bash PASS 'curl -H "Authorization: Bearer $T" https://h.example/' 'curl -H, no mcp-proxy and no claude mcp'
  _msh_bash PASS 'curl -H "x: y" https://h.example/mcp' 'curl -H against an /mcp URL'
  _msh_bash PASS 'grep -H mcp-proxy /x/notes' 'grep -H before the mcp-proxy word'
  _msh_bash PASS 'ps aux | grep mcp-proxy' 'ps and grep for mcp-proxy'
  _msh_bash PASS 'API_ACCESS_TOKEN="$K" exec /opt/homebrew/bin/mcp-proxy --transport=streamablehttp https://h.example/mcp' \
    'mcp-proxy with the env prefix and no -H'
  _msh_bash PASS 'ls /x/mcp' 'ls of an mcp directory'
  _msh_bash PASS 'bash -c '"${sq}"'echo "$HOME"'"${sq}" 'sh -c with $VAR, no claude mcp add'
  _msh_bash PASS 'git mcp add -H x' 'mcp add without a claude word'
  _msh_bash PASS 'mcp-proxy --help' 'mcp-proxy without a header flag'
  _msh_bash PASS 'ls' 'unrelated command'

  # ── Write and Edit: DENY ────────────────────────────────────────────────
  _msh_file DENY /x/.mcp.json '{"mcpServers":{"a":{"command":"mcp-proxy","args":["-H","x-api-key","k","https://h.example/mcp"]}}}' \
    '.mcp.json, mcp-proxy args with -H'
  _msh_file DENY /x/.mcp.json '{"mcpServers":{"a":{"command":"mcp-proxy","args":["--headers","x","k","u"]}}}' \
    '.mcp.json, mcp-proxy args with --headers'
  _msh_file DENY /x/.mcp.json '{"mcpServers":{"a":{"command":"sh","args":["-c","exec mcp-proxy u \"$K\""]}}}' \
    '.mcp.json, $VAR in the -c element'
  _msh_file DENY /x/.mcp.json '{"mcpServers":{"a":{"command":"sh","args":["-c","exec mcp-proxy u ${K}"]}}}' \
    '.mcp.json, ${VAR} in the -c element'
  _msh_file DENY /x/.mcp.json '{"mcpServers":{"a":{"command":"sh","args":["-c","API_ACCESS_TOKEN=\"$K\" exec prog \"$K\""]}}}' \
    '.mcp.json, prefix present but $VAR also in argv'
  _msh_file DENY /x/.mcp.json '{"mcpServers":{"a":{"type":"http","url":"https://h.example/mcp","headers":{"x-api-key":"abc"}}}}' \
    '.mcp.json, literal header value'
  _msh_file DENY /x/.mcp.json '{
  "mcpServers": {
    "a": {
      "type": "http",
      "headers": {
        "Authorization": "Bearer abc"
      }
    }
  }
}' '.mcp.json, literal header value over several lines'
  _msh_file DENY /x/.claude.json '{"projects":{"/p":{"mcpServers":{"a":{"command":"sh","args":["-c","exec mcp-proxy u \"$K\""]}}}}}' \
    '.claude.json, project scope'
  _msh_file DENY /x/mcp.json '{"servers":{"a":{"type":"http","url":"u","headers":{"x":"y"}}}}' \
    'mcp.json, basename gate without an mcpServers key'
  _msh_file DENY /x/config.toml '[mcp_servers.a]
command = "sh"
args = ["-c", "exec mcp-proxy u \"$K\""]' 'config.toml, $VAR in the -c element'
  _msh_file DENY /x/config.toml '[mcp_servers.a]
command = "mcp-proxy"
args = ["-H", "x", "k", "u"]' 'config.toml, mcp-proxy -H'
  _msh_file DENY /x/config.toml '[mcp_servers.a]
command = "sh"
args = ["-c", '"${sq}"'exec mcp-proxy u "$K"'"${sq}"']' 'config.toml, single-quoted -c literal string'
  _msh_file DENY /x/config.toml '[mcp_servers.a]
url = "https://h.example/mcp"
http_headers = { "x-api-key" = "abc" }' 'config.toml, literal http_headers'
  _msh_file DENY /x/settings.json '{"x":1,"headers":{"a":"b"}}' 'settings.json basename gate, literal headers map'
  _msh_file DENY /x/settings.local.json '{"headers":{"a":"b"}}' 'settings.local.json basename gate'
  _msh_file DENY /x/run.sh 'exec mcp-proxy -H x "$K" https://h.example/mcp' \
    'content gate: a script that runs mcp-proxy -H'
  _msh_file DENY /x/run.sh 'sh -c '"${sq}"'exec mcp-proxy u "$K"'"${sq}" \
    'content gate: a script with a shell -c string and mcp-proxy'
  _msh_file DENY /x/notes.mdx 'run: mcp-proxy -H x k u' 'a .mdx path is not a prose file'
  _msh_file DENY /x/notes 'run: mcp-proxy -H x k u' 'a path with no extension is not a prose file'
  _msh_file DENY /x/notes.md.sh 'run: mcp-proxy -H x k u' 'a .md.sh path is not a prose file'
  _msh_file DENY /x/a.sh '# mcp-proxy -H x k u' 'comments are not exempt'
  _msh_file DENY /x/.mcp.json '{"mcpServers":{"a":{"command":"mcp-proxy","args":["-H","x","k"]}}}' \
    'Edit new_string with mcp-proxy and -H' _msh_run_edit
  _msh_file DENY /x/.mcp.json '"headers":{"x":"literal"}' 'Edit new_string, literal header, basename gate' _msh_run_edit
  _msh_file DENY /x/.mcp.json '"args":["-c","exec p \"$K\""]' 'Edit new_string, $VAR in the -c element' _msh_run_edit

  # ── Write and Edit: PASS ────────────────────────────────────────────────
  _msh_file PASS /x/.mcp.json '{"mcpServers":{"a":{"command":"/usr/local/bin/bao-mcp-env","args":["exa","sh","-c","API_ACCESS_TOKEN=\"$EXA_API_KEY\" exec /opt/homebrew/bin/mcp-proxy --transport=streamablehttp https://h.example/mcp"]}}}' \
    '.mcp.json, env-prefix form'
  _msh_file PASS /x/run.sh 'API_ACCESS_TOKEN="$K" exec mcp-proxy --transport=streamablehttp https://h.example/mcp' \
    'script with the env-prefix form'
  _msh_file PASS /x/config.toml '[mcp_servers.a]
command = "sh"
args = ["-c", "API_ACCESS_TOKEN=\"$K\" exec mcp-proxy u"]' 'config.toml, env-prefix form'
  _msh_file PASS /x/.mcp.json '{"mcpServers":{"a":{"type":"http","url":"https://h.example/mcp","headers":{"x-api-key":"${EXA_API_KEY}"}}}}' \
    '.mcp.json, http entry with a ${VAR} header value'
  _msh_file PASS /x/.mcp.json '{"mcpServers":{"a":{"type":"http","url":"u","headers":{}}}}' '.mcp.json, empty headers map'
  _msh_file PASS /x/config.toml '[mcp_servers.a]
url = "u"
env_http_headers = { "x-api-key" = "EXA_API_KEY" }' 'config.toml, env_http_headers names an env var'
  _msh_file PASS /x/.mcp.json '{"mcpServers":{"a":{"command":"/usr/local/bin/mcp-foo","args":["--port","8080"]}}}' \
    '.mcp.json, plain stdio entry'
  _msh_file PASS /x/notes.md 'mcp-proxy turns API_ACCESS_TOKEN into an Authorization header.' \
    'prose file naming mcp-proxy without -H'
  # Prose exemption: docs may quote the bad mcp-proxy and -c shapes.
  _msh_file PASS /x/notes.md 'Never run: mcp-proxy -H x-api-key k https://h.example/mcp' '.md quoting mcp-proxy -H'
  _msh_file PASS /x/notes.txt 'Never run: mcp-proxy --headers x k u' '.txt quoting mcp-proxy --headers'
  _msh_file PASS /x/NOTES.MARKDOWN 'Never run: mcp-proxy -H x k u' '.markdown, uppercase path'
  _msh_file PASS /x/notes.md '"args":["-c","exec mcp-proxy u \"$K\""]' '.md quoting a $VAR in a -c element'
  _msh_file PASS /x/notes.txt 'sh -c '"${sq}"'exec mcp-proxy u "$K"'"${sq}" '.txt quoting a shell -c string'
  _msh_file PASS /x/notes.md 'Never run: mcp-proxy -H x k u' 'Edit of a .md quoting mcp-proxy -H' _msh_run_edit
  _msh_file DENY /x/notes.md '{"mcpServers":{"a":{"headers":{"x":"literal"}}}}' \
    'the literal-headers rule still runs on a .md'
  _msh_file PASS /x/a.sh 'curl -H "x: y" https://h.example/mcp' 'curl -H in a script, no mcp-proxy'
  _msh_file PASS /x/a.py 'subprocess.run(["sh", "-c", "echo $HOME"])' 'unrelated file with a -c string'
  _msh_file PASS /x/a.py 'headers = {"a": "b"}' 'unrelated file with a headers dict'
  _msh_file PASS /x/settings.json '{"model":"x"}' 'settings.json without headers or -c'
  _msh_file PASS /x/.mcp.json '"args":["-c","API_ACCESS_TOKEN=\"$K\" exec p"]' 'Edit new_string, env-prefix form' _msh_run_edit
  _msh_file PASS /x/a.md '' 'empty content'

  # ── No override ─────────────────────────────────────────────────────────
  _msh_file DENY /x/.mcp.json '{"note":"MCP_SECRET_SKIP","mcpServers":{"a":{"args":["mcp-proxy","-H","x","k"]}}}' \
    'a skip marker in the content exempts nothing'
  _msh_bash DENY 'MCP_SECRET_SKIP=1 mcp-proxy -H x k u' 'a skip token as a command prefix exempts nothing'
  local skip_out
  skip_out="$(jq -n '{tool_name:"Bash", tool_input:{command:"mcp-proxy -H x k u"}}' \
    | env MCP_SECRET_SKIP=1 HOOK_PRE_DISPATCH=1 /bin/zsh "$(_msh_hook)")"
  if [[ "$(_hook_verdict "${skip_out}")" == DENY ]]; then
    _pass "DENY: exported skip variable and HOOK_PRE_DISPATCH=1 exempt nothing"
  else
    _fail "an exported variable exempted the Bash command"
  fi

  # ── Deny reason: one line, names the fix, valid JSON ───────────────────
  local out reason
  out="$(_msh_run_bash 'mcp-proxy -H x "$K" u')"
  reason="$(printf '%s' "${out}" | jq -er '.hookSpecificOutput.permissionDecisionReason' 2>/dev/null)" || reason=""
  if [[ "${reason}" == mcp-secret-hook:* && "${reason}" == *API_ACCESS_TOKEN* \
     && "${reason}" != *$'\n'* ]]; then
    _pass "Bash deny reason is one line and names API_ACCESS_TOKEN"
  else
    _fail "Bash deny reason is not one line naming API_ACCESS_TOKEN"
  fi
  out="$(_msh_run_write /x/.mcp.json '{"mcpServers":{"a":{"args":["mcp-proxy","-H","x","k"]}}}')"
  reason="$(printf '%s' "${out}" | jq -er '.hookSpecificOutput.permissionDecisionReason' 2>/dev/null)" || reason=""
  if [[ "${reason}" == mcp-secret-hook:* && "${reason}" == *"NOT made"* \
     && "${reason}" == *API_ACCESS_TOKEN* && "${reason}" != *$'\n'* ]]; then
    _pass "Write deny reason is one line, says the write was not made, names the fix"
  else
    _fail "Write deny reason is not one line saying NOT made and naming the fix"
  fi
  out="$(_msh_run_bash 'claude mcp add x --token "$T" -- prog')"
  if printf '%s' "${out}" | jq -e '.hookSpecificOutput.hookEventName == "PreToolUse"' >/dev/null 2>&1; then
    _pass "deny JSON carries hookEventName PreToolUse"
  else
    _fail "deny JSON lacks hookEventName PreToolUse"
  fi

  # ── pretool-dispatch seam ───────────────────────────────────────────────
  local us=$'\x1f' seam
  seam="$(_msh_run_seam Bash 'claude mcp add x --token "$T" -- prog' '' '')"
  if [[ "${seam}" == "DENY${us}mcp-secret-hook:"* && "${seam}" != *$'\n'* ]]; then
    _pass "seam: Bash deny prints DENY<US>reason, no JSON"
  else
    _fail "seam: Bash deny output is not DENY<US>reason"
  fi
  seam="$(_msh_run_seam Write '' '"headers":{"a":"b"}' /x/.mcp.json)"
  if [[ "${seam}" == "DENY${us}mcp-secret-hook:"* ]]; then
    _pass "seam: Write deny prints DENY<US>reason"
  else
    _fail "seam: Write deny output is not DENY<US>reason"
  fi
  seam="$(_msh_run_seam Edit '' 'mcp-proxy -H x k' /x/a.sh)"
  if [[ "${seam}" == "DENY${us}"* ]]; then
    _pass "seam: Edit deny prints DENY<US>reason"
  else
    _fail "seam: Edit deny output is not DENY<US>reason"
  fi
  seam="$(_msh_run_seam Bash 'claude mcp list' '' '')"
  if [[ -z "${seam}" ]]; then
    _pass "seam: a clean Bash command prints nothing"
  else
    _fail "seam: a clean Bash command printed output"
  fi
  seam="$(_msh_run_seam Write '' '{"mcpServers":{}}' /x/.mcp.json)"
  if [[ -z "${seam}" ]]; then
    _pass "seam: a clean Write prints nothing"
  else
    _fail "seam: a clean Write printed output"
  fi

  # ── Fail-open ───────────────────────────────────────────────────────────
  if [[ -z "$(printf '%s' '{}' | /bin/zsh "$(_msh_hook)")" ]]; then
    _pass "fail-open: payload with no tool input allows the call"
  else
    _fail "fail-open: payload with no tool input produced a verdict"
  fi
  if [[ -z "$(printf '%s' 'not json' | /bin/zsh "$(_msh_hook)")" ]]; then
    _pass "fail-open: unparseable payload allows the call"
  else
    _fail "fail-open: unparseable payload produced a verdict"
  fi
  if [[ -z "$(/bin/zsh "$(_msh_hook)" < /dev/null)" ]]; then
    _pass "fail-open: empty stdin allows the call"
  else
    _fail "fail-open: empty stdin produced a verdict"
  fi
  # A payload over the 1 MiB cap is a data payload: the hook allows it.
  local big
  big="mcp-proxy -H x k u $(printf 'a%.0s' {1..1100000})"
  out="$(_msh_run_bash "${big}")"
  if [[ -z "${out}" ]]; then
    _pass "fail-open: a command over 1 MiB is allowed"
  else
    _fail "fail-open: a command over 1 MiB produced a verdict"
  fi
}
