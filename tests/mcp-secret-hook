#!/bin/zsh
# dotfiles/tests/mcp-secret-hook
#
# Behavioural test for claude/hooks/mcp-secret-hook, the PreToolUse hook that
# DENIES a Bash command or a file write that puts an MCP server key into argv
# or into a config file. One input is one case. DENY for a key flag, for a
# $VAR in a -c string and for a literal add-json header on `claude mcp add` /
# `add-json`, for the proxy command with a header flag, and for a literal
# header in a written config; PASS for the env-prefix form
# (API_ACCESS_TOKEN="$VAR" exec <proxy> ...) and for curl -H. One standalone
# run (the hook as a process, JSON on stdin) checks that an exported skip
# variable with HOOK_PRE_DISPATCH=1 overrides nothing and that the deny JSON
# names the fix. Two cases cover fail-open: unparseable JSON and a command
# over 1 MiB.
#
# MSH_BIN points the suite at another copy of the hook (a scratch copy with a
# check removed proves the cases go red).
#
# Run: ./test mcp-secret-hook
#
# ShellCheck: lint with `shellcheck --shell=bash tests/mcp-secret-hook`.
# This file is sourced, not executed: chmod 644.
#
# shellcheck source=tests/lib
# shellcheck disable=SC2016  # fixtures are literal command and file text

function _msh_hook {
  printf '%s' "${MSH_BIN:-${SCRIPT_DIR}/claude/hooks/mcp-secret-hook}"
}

# Seam runs: the guard sourced the dispatcher's way by _hook_run_seam (tests/lib).
# $1 want, $2 command, $3 label.
function _msh_bash {
  _hook_run_seam "$(_msh_hook)" Bash "$2"
  if [[ "${HOOK_SEAM_VERDICT}" == "$1" ]]; then
    _pass "$1: $3"
  else
    _fail "$3 — expected $1, got ${HOOK_SEAM_VERDICT} (${HOOK_SEAM_OUT:0:120})"
  fi
}

# $1 want, $2 path, $3 content, $4 label.
function _msh_file {
  _hook_run_seam "$(_msh_hook)" Write '' "$2" "$3"
  if [[ "${HOOK_SEAM_VERDICT}" == "$1" ]]; then
    _pass "$1: $4"
  else
    _fail "$4 — expected $1, got ${HOOK_SEAM_VERDICT} (${HOOK_SEAM_OUT:0:120})"
  fi
}

function run_mcp_secret_hook {
  _section "MCP secret in argv or config hook"

  # claude/ is gitignored and synced out of band: an absent hook is pending
  # sync, not a regression.
  if [[ ! -f "$(_msh_hook)" ]]; then
    _skip "claude/hooks/mcp-secret-hook absent — claude/ not yet synced to this machine"
    return 0
  fi
  if ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
    return
  fi

  # An exported override would turn DENY into PASS with the suite green.
  unset MCP_SECRET_SKIP MCP_SECRET_HOOK_SKIP

  local sq="'"

  _msh_bash DENY 'claude mcp add --transport http exa https://h.example/mcp --header "x-api-key: ${EXA_API_KEY}"' \
    'add with a --header key flag'
  _msh_bash DENY 'claude mcp add exa -- sh -c '"${sq}"'exec mcp-proxy https://h.example/mcp "$EXA_API_KEY"'"${sq}" \
    'add with a $VAR in the -c string'
  _msh_bash DENY 'claude mcp add-json exa '"${sq}"'{"type":"http","url":"https://h.example/mcp","headers":{"x-api-key":"abc"}}'"${sq}" \
    'add-json with a literal headers value'
  _msh_bash DENY 'mcp-proxy -H x-api-key "$K" https://h.example/mcp' 'the proxy command with -H'
  _msh_file DENY /x/.mcp.json '{"mcpServers":{"a":{"type":"http","url":"https://h.example/mcp","headers":{"x-api-key":"abc"}}}}' \
    'a written .mcp.json with a literal header value'

  _msh_bash PASS 'claude mcp add exa -- /usr/local/bin/bao-mcp-env exa sh -c '"${sq}"'API_ACCESS_TOKEN="$EXA_API_KEY" exec /opt/homebrew/bin/mcp-proxy --transport=streamablehttp https://h.example/mcp'"${sq}" \
    'add with the env-prefix form'
  _msh_bash PASS 'curl -H "Authorization: Bearer $T" https://h.example/' 'curl -H, no proxy and no claude mcp'

  # The exported skip variable and HOOK_PRE_DISPATCH=1 exempt nothing, and the
  # deny is one JSON line that names the fix.
  local skip_out reason
  skip_out="$(jq -n '{tool_name:"Bash", tool_input:{command:"mcp-proxy -H x k u"}}' \
    | env MCP_SECRET_SKIP=1 HOOK_PRE_DISPATCH=1 /bin/zsh "$(_msh_hook)")"
  reason="$(printf '%s' "${skip_out}" | jq -er '.hookSpecificOutput.permissionDecisionReason' 2>/dev/null)" || reason=""
  if [[ "$(_hook_verdict "${skip_out}")" == DENY && "${reason}" == mcp-secret-hook:* \
      && "${reason}" == *API_ACCESS_TOKEN* && "${reason}" != *$'\n'* ]]; then
    _pass "DENY: an exported skip variable and HOOK_PRE_DISPATCH=1 exempt nothing, the deny names the fix"
  else
    _fail "exported skip variable — verdict $(_hook_verdict "${skip_out}"), reason ${reason:0:120}"
  fi

  # Fail-open: unparseable JSON, and a command over the 1 MiB cap.
  if [[ -z "$(printf '%s' 'not json' | /bin/zsh "$(_msh_hook)")" ]]; then
    _pass "fail-open: unparseable payload allows the call"
  else
    _fail "fail-open: unparseable payload produced a verdict"
  fi
  local big
  big="mcp-proxy -H x k u $(printf 'a%.0s' {1..1100000})"
  _msh_bash PASS "${big}" 'fail-open: a command over 1 MiB is allowed'
}
