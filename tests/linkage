#!/bin/zsh
# dotfiles/tests/linkage
#
# Fails on any repo file no bittersweet subcommand owns. Owner maps below are
# checked against the real installer functions, run with filesystem, sudo,
# git and launchctl writes mocked: registering a name here cannot substitute
# for wiring it up.
#
# ShellCheck: lint with `shellcheck --shell=bash tests/linkage`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib
# shellcheck disable=SC2030,SC2031  # fixture HOME and installer mocks stay in subshells

function _linkage_deployments {
  (
    local fixture_home
    fixture_home="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/linkage-home.XXXXXX")" || return 1
    trap '/bin/rm -rf -- "${fixture_home}"' EXIT
    # HOME is overridden only here: real shell redirects cannot be mocked.
    export HOME="${fixture_home}"
    /bin/mkdir -p "${HOME}/Library/LaunchAgents"
    # Declarations only, never bittersweet's top-level setup/main.
    # shellcheck disable=SC1090,SC1091
    source <(/usr/bin/awk '
      /^function / || /^typeset -ra LAUNCHAGENT_PLISTS=\(/ { block = 1 }
      block { print }
      /^}$/ || /^\)$/ { block = 0 }
    ' "${SCRIPT_DIR}/bittersweet")
    /bin/mkdir -p "${HOME}/.local/bin"
    /bin/ln -s "${SCRIPT_DIR}/bin/bao-mcp-env" "${HOME}/.local/bin/bao-mcp-env"

    # fd 3 carries operations; installer chatter is discarded.
    # shellcheck disable=SC2329
    _linkage_record() { printf '%s\t%s\n' "${owner}" "$1" >&3; }
    # shellcheck disable=SC2329
    _symlink() { _linkage_record "$1"; }
    # shellcheck disable=SC2329
    # Records the source (last-but-one argument, right for `cp SRC DEST` and
    # `cp -R SRC DEST`). A ~/.agents/skills destination is also recorded, with
    # the fixture HOME masked so step 7 can match it outside the subshell.
    cp() {
      local dest="${*: -1}"
      _linkage_record "${@: -2:1}"
      if [[ "${dest}" == "${HOME}/.agents/skills/"* ]]; then
        _linkage_record "@HOME@${dest#"${HOME}"}"
      fi
    }
    # shellcheck disable=SC2329
    # install_launchagents runs `sed ... SRC > TMP`, `plutil -lint TMP`,
    # `mv TMP DEST`. The `> TMP` redirect cannot be mocked, so it makes a real
    # empty file; plutil passes so the chain reaches mv, which deletes TMP.
    # Records SRC (sed's last arg), as cp records its source.
    sed() { _linkage_record "${@: -1}"; }
    # shellcheck disable=SC2329
    plutil() { return 0; }
    # shellcheck disable=SC2329
    mv() { rm -f "$1"; }
    # shellcheck disable=SC2329
    _ensure_dir() { :; }
    # shellcheck disable=SC2329
    _harden() { :; }
    # shellcheck disable=SC2329
    get_sudo() { :; }
    # shellcheck disable=SC2329
    chmod() { :; }
    # shellcheck disable=SC2329
    mkdir() { :; }
    # shellcheck disable=SC2329
    git() { _linkage_record "${SCRIPT_DIR}/.githooks"; }
    # shellcheck disable=SC2329
    _install_git_exclude() { _linkage_record "${SCRIPT_DIR}/.extra_gitexclude"; }
    # shellcheck disable=SC2329
    sudo() {
      case "$1" in
        cp) _linkage_record "$2" ;;
        ln) _linkage_record "$3" ;;
      esac
      return 0
    }
    # shellcheck disable=SC2329
    launchctl() {
      case "$1" in
        getenv) print 1 ;;
        bootstrap) _linkage_record "${SCRIPT_DIR}/LaunchAgents/${3##*/}" ;;
      esac
      return 0
    }
    local owner
    for owner in install_dotfiles install_scripts install_launchagents load_launchagents; do
      "${owner}"
      if [[ "${owner}" == install_dotfiles && ! -L "${HOME}/.local/bin/bao-mcp-env" ]]; then
        print -u2 'dotfiles removed bao-mcp-env before scripts installed its replacement'
        return 1
      fi
    done
  ) 3>&1 >/dev/null
}

function _linkage_check_deployed {
  local owner="$1" relative="$2"
  [[ "${owner}" == repo ]] && return 0
  local prefix=$'\n'"${owner}"$'\t'"${SCRIPT_DIR}/${relative}"
  if [[ $'\n'"${deployments}"$'\n' != *"${prefix}"$'\n'* &&
        $'\n'"${deployments}"$'\n' != *"${prefix}/"* ]]; then
    _fail "${relative}: registered to ${owner}, but that function does not deploy it"
  fi
}

# core.hooksPath must stay the RELATIVE .githooks (git resolves it against each
# worktree's own root) and resolve to the tracked hook set. An absolute value
# breaks silently on a repo move, and git runs no hooks and says nothing when
# the directory is missing. Pure: takes the effective value and the resolved
# directory, so the failure branches can be driven without a config write.
function _linkage_hooks_path {
  local value="$1" dir="$2" hook
  if [[ "${value}" == /* ]]; then
    _fail "core.hooksPath is absolute (${value}); keep the relative .githooks (internals/worktrees.md)"
    return
  fi
  if [[ "${value}" != .githooks ]]; then
    _fail "core.hooksPath is '${value}', not .githooks"
    return
  fi
  for hook in pre-commit commit-msg post-commit pre-push; do
    if [[ ! -x "${dir}/${hook}" ]]; then
      _fail "hooks path ${dir} lacks an executable ${hook}"
      return
    fi
  done
  _pass "core.hooksPath .githooks resolves to ${dir} with all four hooks"
}

# Drives each branch of _linkage_hooks_path against a fixture hooks directory.
# The helper's own _fail runs in a command substitution, so it cannot count
# against this suite: the captured FAIL/PASS line is what each case checks.
function _linkage_test_hooks_path {
  local fixture hook out
  fixture="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/linkage-hooks.XXXXXX")" || {
    _fail "hooks path cases: cannot create a fixture directory"
    return
  }
  for hook in pre-commit commit-msg post-commit pre-push; do
    : > "${fixture}/${hook}"
    chmod 755 "${fixture}/${hook}"
  done

  out="$(_linkage_hooks_path .githooks "${fixture}")" || out=""
  if [[ "${out}" == *PASS* && "${out}" != *FAIL* ]]; then
    _pass "hooks path: relative .githooks with all four executable hooks passes"
  else
    _fail "hooks path: valid fixture was not accepted: ${out}"
  fi

  out="$(_linkage_hooks_path "${SCRIPT_DIR}/.githooks" "${fixture}")" || out=""
  if [[ "${out}" == *FAIL*'is absolute'* ]]; then
    _pass "hooks path: an absolute value fails"
  else
    _fail "hooks path: absolute value not rejected: ${out}"
  fi

  out="$(_linkage_hooks_path .git/hooks "${fixture}")" || out=""
  if [[ "${out}" == *FAIL*'not .githooks'* ]]; then
    _pass "hooks path: a relative value other than .githooks fails"
  else
    _fail "hooks path: wrong relative value not rejected: ${out}"
  fi

  for hook in pre-commit commit-msg post-commit pre-push; do
    chmod 644 "${fixture}/${hook}"
    out="$(_linkage_hooks_path .githooks "${fixture}")" || out=""
    if [[ "${out}" == *FAIL*"lacks an executable ${hook}"* ]]; then
      _pass "hooks path: a non-executable ${hook} fails"
    else
      _fail "hooks path: non-executable ${hook} not rejected: ${out}"
    fi
    chmod 755 "${fixture}/${hook}"
  done

  /bin/rm -f "${fixture}/pre-push"
  out="$(_linkage_hooks_path .githooks "${fixture}")" || out=""
  if [[ "${out}" == *FAIL*'lacks an executable pre-push'* ]]; then
    _pass "hooks path: a missing hook fails"
  else
    _fail "hooks path: missing hook not rejected: ${out}"
  fi

  /bin/rm -rf "${fixture}"
}

function _linkage_foreign_bin_target {
  # _bin_target_is_foreign: a regular file at a bin_files target belongs to
  # another installation and must be left alone; a link or nothing is ours to
  # (re)create. Sourced from bittersweet the same way as the bao migration.
  (
    local fixture
    fixture="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/linkage-foreign.XXXXXX")" || return 1
    trap '/bin/rm -rf -- "${fixture}"' EXIT
    # shellcheck disable=SC1090,SC1091
    source <(/usr/bin/awk '
      /^function _bin_target_is_foreign / { block = 1 }
      block { print }
      /^}$/ { block = 0 }
    ' "${SCRIPT_DIR}/bittersweet")
    print '#!/bin/sh' > "${fixture}/copy"
    /bin/chmod 755 "${fixture}/copy"
    /bin/ln -s "${SCRIPT_DIR}/bin/dns" "${fixture}/link"
    /bin/ln -s "${fixture}/nowhere" "${fixture}/dangling"
    _bin_target_is_foreign "${fixture}/copy" || return 1          # regular file: foreign
    ! _bin_target_is_foreign "${fixture}/link" || return 1        # our kind of link: not foreign
    ! _bin_target_is_foreign "${fixture}/dangling" || return 1    # dangling link: not foreign
    ! _bin_target_is_foreign "${fixture}/absent" || return 1      # nothing there: not foreign
    return 0
  )
}

function _linkage_bao_migration {
  (
    local fixture_home replacement legacy
    fixture_home="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/linkage-bao.XXXXXX")" || return 1
    trap '/bin/rm -rf -- "${fixture_home}"' EXIT
    export HOME="${fixture_home}"
    replacement="${fixture_home}/new/bao-mcp-env"
    legacy="${HOME}/.local/bin/bao-mcp-env"
    /bin/mkdir -p "${HOME}/.local/bin" "${fixture_home}/new"
    # shellcheck disable=SC1090,SC1091
    source <(/usr/bin/awk '
      /^function _retire_bao_mcp_link / { block = 1 }
      block { print }
      /^}$/ { block = 0 }
    ' "${SCRIPT_DIR}/bittersweet")
    /bin/ln -s "${SCRIPT_DIR}/bin/bao-mcp-env" "${legacy}"
    _retire_bao_mcp_link "${replacement}"
    [[ -L "${legacy}" ]] || return 1
    print '#!/bin/sh' > "${replacement}"
    _retire_bao_mcp_link "${replacement}"
    [[ -L "${legacy}" ]] || return 1
    /bin/chmod 755 "${replacement}"
    _retire_bao_mcp_link "${replacement}"
    [[ ! -L "${legacy}" ]] || return 1
    # An unrelated installation and a regular file are never removed.
    /bin/ln -s "${replacement}" "${legacy}"
    _retire_bao_mcp_link "${replacement}"
    [[ -L "${legacy}" ]] || return 1
    /bin/rm "${legacy}"
    print sentinel > "${legacy}"
    _retire_bao_mcp_link "${replacement}"
    [[ "$(<"${legacy}")" == sentinel ]] || return 1
  ) >/dev/null
}

# Fills the caller's `ignored` map with the gitignored items under .config/,
# bin/ and LaunchAgents/, using one batched `git check-ignore`.
function _linkage_load_ignored {
  setopt local_options null_glob
  local -a candidates=(.config/* bin/* LaunchAgents/*.plist)
  local ignored_path
  # `-z` keeps non-ASCII names unquoted.
  while IFS= read -r -d '' ignored_path; do
    ignored[${ignored_path}]=1
  done < <(print -rN -- "${candidates[@]}" | git check-ignore -z --stdin)
}

function run_linkage {
  _section "Dotfile Coverage"

  if _linkage_bao_migration; then
    _pass "bao migration preserves legacy paths until an executable replacement exists"
  else
    _fail "bao migration removed an unready or unrelated installation"
  fi

  if _linkage_foreign_bin_target; then
    _pass "install_scripts leaves a regular file at a bin target alone and relinks links or empty paths"
  else
    _fail "a regular file at a bin target would be replaced, or a link or empty path would be skipped"
  fi

  _linkage_test_hooks_path

  # SC2154: fail_count is declared in tests/lib, sourced by the dispatcher.
  # shellcheck disable=SC2154
  local before_fails=${fail_count}
  # Read by _linkage_check_deployed via zsh dynamic scope.
  # shellcheck disable=SC2034
  local deployments
  if ! deployments="$(_linkage_deployments)"; then
    _fail "could not inspect deployment operations"
    return
  fi

  # Top-level item → owning subcommand; "repo" = docs, metadata, test infra,
  # intentionally not installed.
  local -A top_level=(
    # Repo metadata
    [.mcp.json]=repo                         # Host-local MCP config (gitignored)
    [.ignore]=repo                           # ripgrep whitelist for gitignored docs (gitignored)
    [.worktreeinclude]=repo                  # Claude Code worktree copy list (gitignored: .extra_gitexclude)
    [LICENSE]=repo
    [README.md]=repo
    [REVIEW.md]=repo                         # Review rulebook for every reviewer (tracked)
    [SECURITY.md]=repo
    [TODOs.md]=repo
    [AGENTS.md]=repo                         # Repo agent guidance, all 3 harnesses (untracked: .extra_gitexclude)
    [CLAUDE.md]=repo                         # Symlink -> AGENTS.md (untracked: global *claude* ignore)
    [.gitignore]=repo
    [.gitleaksignore]=repo
    [.pii-allowlist]=repo                    # Read in-place by the global pre-commit hook

    # Script + test infra
    [bittersweet]=install_scripts
    [test]=repo
    [tests]=repo
    [lib]=repo

    # install_dotfiles — config files symlinked into HOME
    [.zshrc]=install_dotfiles
    [.aliases]=install_dotfiles
    [.codex]=install_dotfiles
    [.functions]=install_dotfiles
    [.completions]=install_dotfiles
    [.ssh]=install_dotfiles
    [.config]=install_dotfiles
    [config]=install_dotfiles              # Ghostty
    [IDETemplateMacros.plist]=install_dotfiles  # Xcode
    [claude]=install_dotfiles              # Dynamic (skills, rules, settings)
    [.githooks]=install_dotfiles           # core.hooksPath
    [.extra_gitexclude]=install_dotfiles   # .git/info/exclude (gitignored source)
    [.extra_test_suites]=repo              # per-clone optional suites, read by ./test (gitignored)
    [.extra_bin_files]=repo                # per-clone bin tools, read by install_scripts (gitignored)

    # Other bittersweet subcommands
    [bin]=install_scripts
    [profiles]=mdmprofile
    [LaunchAgents]=install_launchagents
    [LaunchDaemons]=install_launchagents
    ["Sublime Text"]=sublimetext
    [.extra]=extra
    [.github]=repo
    [internals]=repo
    [templates]=repo
    [poc]=repo
  )

  # .config/ subdirs must each be wired in install_dotfiles
  local -A config_subdirs=(
    [git]=install_dotfiles
    [uv]=install_dotfiles
    [npm]=install_dotfiles
    [1Password]=install_dotfiles
    [herdr]=install_dotfiles
  )

  # bin/ scripts → owning subcommand
  local -A bin_scripts=(
    # install_scripts → /usr/local/bin/
    [dns]=install_scripts
    [jump-user]=install_scripts
    [jump-system]=install_scripts
    [scratch-sweep]=install_scripts
    [mdview]=install_scripts
    [npm-audit-check]=install_scripts
    [claude-session-audit]=install_scripts
    [git-sign-unpushed]=install_scripts
    [bao-mcp-env]=install_scripts               # moved from ~/.local/bin 2026-09-18, internals/linux-path-audit.md
    [mcp-proxy-env]=install_scripts             # mcp-proxy with its URL from the environment
    [papercut]=install_scripts                  # status-line and log CLI
    [spawnprof]=install_scripts                 # spawn-cost profiler for zsh scripts
    [agent-reset]=repo                          # backup/verify/wipe ritual; run from the repo, installed nowhere

    # install_dotfiles → ~/.local/bin/ (op wrappers)
    [vt]=install_dotfiles
    [urlscan]=install_dotfiles
    [op-homelab]=install_dotfiles
  )

  # claude/ files → owning subcommand (hooks/, rules/, skills/ and agents/ are
  # dynamic)
  local -A claude_items=(
    [settings.json]=install_dotfiles
    [global-claude.md]=install_dotfiles
    [statusline-command]=install_dotfiles
    [subagent-statusline]=install_dotfiles
    [hosts]=install_dotfiles                 # Dynamic (per-host context files)
    [output-styles]=install_dotfiles         # Dynamic (custom output styles)
    [hooks]=install_dotfiles                 # Dynamic (individual hooks)
    [rules]=install_dotfiles                 # Dynamic (individual rules)
    [skills]=install_dotfiles                # Dynamic (individual skills)
    [agents]=install_dotfiles                # Dynamic (individual subagents)
    [mods]=install_dotfiles                  # Dynamic (function-hook plugins)
  )

  local name

  # 1. Top-level items
  local item
  for item in ./* ./.[!.]*; do
    [[ -e "${item}" ]] || continue
    name="${item##*/}"
    [[ "${name}" == ".git" || "${name}" == ".DS_Store" || "${name}" == ".claude" ]] && continue
    if [[ -z "${top_level[${name}]+_}" ]]; then
      _fail "Untracked top-level: ${name} (add to install_dotfiles or top_level map)"
    elif [[ "${top_level[${name}]}" == install_* ]]; then
      _linkage_check_deployed "${top_level[${name}]}" "${name}"
    fi
  done

  # Gitignored per-clone items are skipped in steps 2-4: their names must not
  # enter the tracked map (it would leak them).
  # Read by steps 2-4 via zsh dynamic scope.
  # shellcheck disable=SC2034
  local -A ignored=()
  _linkage_load_ignored

  # 2. .config/ subdirectories
  local subdir
  for subdir in .config/*/; do
    [[ -d "${subdir}" ]] || continue
    if [[ -n "${ignored[${subdir%/}]+_}" ]]; then continue; fi
    name="${subdir%/}"
    name="${name##*/}"
    if [[ -z "${config_subdirs[${name}]+_}" ]]; then
      _fail "Untracked .config/ subdir: ${name} (add symlink to install_dotfiles and config_subdirs map)"
    else
      _linkage_check_deployed "${config_subdirs[${name}]}" ".config/${name}"
    fi
  done

  # 3. bin/ scripts
  local script
  for script in bin/*; do
    [[ -f "${script}" ]] || continue
    if [[ -n "${ignored[${script}]+_}" ]]; then continue; fi
    name="${script##*/}"
    if [[ -z "${bin_scripts[${name}]+_}" ]]; then
      _fail "Untracked bin/ script: ${name} (add to install_scripts or bin_scripts map)"
    else
      _linkage_check_deployed "${bin_scripts[${name}]}" "bin/${name}"
    fi
  done

  # 4. LaunchAgent plists
  local plist
  for plist in LaunchAgents/*.plist; do
    [[ -f "${plist}" ]] || continue
    if [[ -n "${ignored[${plist}]+_}" ]]; then continue; fi  # skip gitignored private agents
    name="${plist##*/}"
    _linkage_check_deployed install_launchagents "LaunchAgents/${name}"
    _linkage_check_deployed load_launchagents "LaunchAgents/${name}"
  done

  # 5. LaunchDaemon plists
  for plist in LaunchDaemons/*.plist; do
    [[ -f "${plist}" ]] || continue
    name="${plist##*/}"
    _linkage_check_deployed install_launchagents "LaunchDaemons/${name}"
  done

  # 6. claude/ items. claude/ is gitignored and synced out of band, so a fresh
  # clone has none: skip the walk, since an empty glob aborts under nomatch
  # (2026-09-29).
  local claude_item
  if [[ ! -d claude ]]; then
    _skip "claude/ absent — pending out-of-band sync, claude/ manifest walk skipped"
  fi
  for claude_item in claude/*(N); do
    [[ -e "${claude_item}" ]] || continue
    name="${claude_item##*/}"
    [[ "${name}" == ".DS_Store" ]] && continue
    if [[ -z "${claude_items[${name}]+_}" ]]; then
      _fail "Untracked claude/ item: ${name} (add a claude_items entry; a single file also needs a claude_files entry, a directory of items a per-item loop in install_dotfiles)"
    elif [[ "${name}" != skills && "${name}" != rules && "${name}" != agents ]]; then
      _linkage_check_deployed "${claude_items[${name}]}" "claude/${name}"
    fi
  done
  local hook_file
  for hook_file in claude/hooks/*(N); do
    [[ -f "${hook_file}" ]] || continue
    _linkage_check_deployed install_dotfiles "${hook_file}"
  done

  # 7. ~/.agents/skills copies: only the shared allowlist, nothing else. The
  # manifest is hardcoded like the maps above: the forward check proves each
  # shared skill is copied, the reverse check proves nothing else is.
  local -ar shared_skills=(git-history-repair zsh-style ste100 macos-security-footguns bao-admin swift-conventions rust-conventions npm-conventions python-conventions objc-conventions ci-conventions papercuts)
  local shared_skill dest_line
  if [[ -d claude/skills ]]; then
    for shared_skill in "${shared_skills[@]}"; do
      [[ -d "claude/skills/${shared_skill}" ]] ||
        _fail "claude/skills/${shared_skill}: listed as shared, but the skill is missing"
      [[ $'\n'"${deployments}"$'\n' == *$'\n'"install_dotfiles"$'\t'"@HOME@/.agents/skills/${shared_skill}"$'\n'* ]] ||
        _fail "${shared_skill}: shared skill, but install_dotfiles does not copy it into ~/.agents/skills"
    done
    while IFS= read -r dest_line; do
      [[ "${dest_line}" == install_dotfiles$'\t'@HOME@/.agents/skills/* ]] || continue
      name="${dest_line##*/}"
      [[ " ${shared_skills[*]} " == *" ${name} "* ]] ||
        _fail "${name}: copied into ~/.agents/skills but not in the shared-skill manifest"
    done <<< "${deployments}"
  else
    _skip "claude/ absent — ~/.agents/skills manifest check skipped"
  fi

  # Live hooks path of this clone; a clean clone (CI) has none set: skip.
  local hooks_value hooks_dir
  hooks_value="$(git config --get core.hooksPath 2>/dev/null || true)"
  if [[ -z "${hooks_value}" ]]; then
    _skip "core.hooksPath unset on this clone — hooks path check skipped"
  else
    hooks_dir="$(git rev-parse --git-path hooks)"
    _linkage_hooks_path "${hooks_value}" "${hooks_dir}"
  fi

  if (( fail_count == before_fails )); then
    _pass "All repo files accounted for"
  fi
}
