#!/bin/zsh
# dotfiles/tests/linkage
#
# Detect repo files not managed by any bittersweet subcommand.
# Prevents "forgot to wire up" bugs — e.g. Ghostty config sat in the
# repo without a symlink in install_dotfiles until it was caught manually.
#
# Maintains registration for repo files and checks deployment owners against
# the actual installer functions. Filesystem, sudo, Git and launchctl writes
# are mocked: recording a filename here cannot substitute for wiring it up.
#
# ShellCheck: lint with `shellcheck --shell=bash tests/linkage`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib
# shellcheck disable=SC2030,SC2031  # fixture HOME and installer mocks stay in subshells

function _linkage_deployments {
  (
    local fixture_home
    fixture_home="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/linkage-home.XXXXXX")" || return 1
    trap '/bin/rm -rf -- "${fixture_home}"' EXIT
    # HOME is intentionally overridden only in this fixture subshell: real
    # shell redirects cannot be mocked and must never reach the user's home.
    export HOME="${fixture_home}"
    /bin/mkdir -p "${HOME}/Library/LaunchAgents"
    # Load declarations only, never the orchestrator's top-level setup/main.
    # shellcheck disable=SC1090,SC1091
    source <(/usr/bin/awk '
      /^function / || /^typeset -ra LAUNCHAGENT_PLISTS=\(/ { block = 1 }
      block { print }
      /^}$/ || /^\)$/ { block = 0 }
    ' "${SCRIPT_DIR}/bittersweet")
    /bin/mkdir -p "${HOME}/.local/bin"
    /bin/ln -s "${SCRIPT_DIR}/bin/bao-mcp-env" "${HOME}/.local/bin/bao-mcp-env"

    # Descriptor 3 carries operations; normal installer chatter is discarded.
    # shellcheck disable=SC2329
    _linkage_record() { printf '%s\t%s\n' "${owner}" "$1" >&3; }
    # shellcheck disable=SC2329
    _symlink() { _linkage_record "$1"; }
    # shellcheck disable=SC2329
    cp() { _linkage_record "$1"; }
    # shellcheck disable=SC2329
    # install_launchagents's __HOME__ substitution: `sed "..." SRC > TMP`,
    # `plutil -lint TMP`, `mv TMP DEST`. The `> TMP` redirect is the caller's,
    # not something a mock can intercept, so it still creates a real (empty,
    # since the mocked sed prints nothing) file at TMP — plutil is stubbed to
    # pass so the chain reaches mv, and mv deletes TMP instead of moving it
    # within the fixture home, so no real plist is ever touched.
    # SRC (sed's last arg) is what gets recorded, matching what cp's mock
    # recorded from its own first (source) arg.
    sed() { _linkage_record "${@: -1}"; }
    # shellcheck disable=SC2329
    plutil() { return 0; }
    # shellcheck disable=SC2329
    mv() { rm -f "$1"; }
    # shellcheck disable=SC2329
    _ensure_dir() { :; }
    # shellcheck disable=SC2329
    _harden() { :; }
    # shellcheck disable=SC2329
    get_sudo() { :; }
    # shellcheck disable=SC2329
    chmod() { :; }
    # shellcheck disable=SC2329
    mkdir() { :; }
    # shellcheck disable=SC2329
    git() { _linkage_record "${SCRIPT_DIR}/.githooks"; }
    # shellcheck disable=SC2329
    _install_git_exclude() { _linkage_record "${SCRIPT_DIR}/.extra_gitexclude"; }
    # shellcheck disable=SC2329
    sudo() {
      case "$1" in
        cp) _linkage_record "$2" ;;
        ln) _linkage_record "$3" ;;
      esac
      return 0
    }
    # shellcheck disable=SC2329
    launchctl() {
      case "$1" in
        getenv) print 1 ;;
        bootstrap) _linkage_record "${SCRIPT_DIR}/LaunchAgents/${3##*/}" ;;
      esac
      return 0
    }
    local owner
    for owner in install_dotfiles install_scripts install_launchagents load_launchagents; do
      "${owner}"
      if [[ "${owner}" == install_dotfiles && ! -L "${HOME}/.local/bin/bao-mcp-env" ]]; then
        print -u2 'dotfiles removed bao-mcp-env before scripts installed its replacement'
        return 1
      fi
    done
  ) 3>&1 >/dev/null
}

function _linkage_check_deployed {
  local owner="$1" relative="$2"
  [[ "${owner}" == repo ]] && return 0
  local prefix=$'\n'"${owner}"$'\t'"${SCRIPT_DIR}/${relative}"
  if [[ $'\n'"${deployments}"$'\n' != *"${prefix}"$'\n'* &&
        $'\n'"${deployments}"$'\n' != *"${prefix}/"* ]]; then
    _fail "${relative}: registered to ${owner}, but that function does not deploy it"
  fi
}

function _linkage_bao_migration {
  (
    local fixture_home replacement legacy
    fixture_home="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/linkage-bao.XXXXXX")" || return 1
    trap '/bin/rm -rf -- "${fixture_home}"' EXIT
    export HOME="${fixture_home}"
    replacement="${fixture_home}/new/bao-mcp-env"
    legacy="${HOME}/.local/bin/bao-mcp-env"
    /bin/mkdir -p "${HOME}/.local/bin" "${fixture_home}/new"
    # shellcheck disable=SC1090,SC1091
    source <(/usr/bin/awk '
      /^function _retire_bao_mcp_link / { block = 1 }
      block { print }
      /^}$/ { block = 0 }
    ' "${SCRIPT_DIR}/bittersweet")
    /bin/ln -s "${SCRIPT_DIR}/bin/bao-mcp-env" "${legacy}"
    _retire_bao_mcp_link "${replacement}"
    [[ -L "${legacy}" ]] || return 1
    print '#!/bin/sh' > "${replacement}"
    _retire_bao_mcp_link "${replacement}"
    [[ -L "${legacy}" ]] || return 1
    /bin/chmod 755 "${replacement}"
    _retire_bao_mcp_link "${replacement}"
    [[ ! -L "${legacy}" ]] || return 1
    # An unrelated installation and a regular file are never removed.
    /bin/ln -s "${replacement}" "${legacy}"
    _retire_bao_mcp_link "${replacement}"
    [[ -L "${legacy}" ]] || return 1
    /bin/rm "${legacy}"
    print sentinel > "${legacy}"
    _retire_bao_mcp_link "${replacement}"
    [[ "$(<"${legacy}")" == sentinel ]] || return 1
  ) >/dev/null
}

function run_linkage {
  _section "Dotfile Coverage"

  if _linkage_bao_migration; then
    _pass "bao migration preserves legacy paths until an executable replacement exists"
  else
    _fail "bao migration removed an unready or unrelated installation"
  fi

  # SC2154: fail_count is declared in tests/lib, sourced by the dispatcher.
  # shellcheck disable=SC2154
  local before_fails=${fail_count}
  # Read by _linkage_check_deployed through zsh's dynamic function scope.
  # shellcheck disable=SC2034
  local deployments
  if ! deployments="$(_linkage_deployments)"; then
    _fail "could not inspect deployment operations"
    return
  fi

  # Every top-level item → owning bittersweet subcommand.
  # "repo" = docs, metadata, test infra — intentionally not installed.
  local -A top_level=(
    # Repo metadata
    [.mcp.json]=repo                         # Host-local MCP config (gitignored)
    [.ignore]=repo                           # ripgrep whitelist for gitignored docs (gitignored)
    [LICENSE]=repo
    [README.md]=repo
    [SECURITY.md]=repo
    [TODOs.md]=repo
    [AGENTS.md]=repo                         # Repo agent guidance, all 3 harnesses (untracked: .extra_gitexclude)
    [CLAUDE.md]=repo                         # Symlink -> AGENTS.md (untracked: global *claude* ignore)
    [.gitignore]=repo
    [.gitleaksignore]=repo
    [.pii-allowlist]=repo                    # Read in-place by the global pre-commit hook

    # Script + test infra
    [bittersweet]=install_scripts
    [test]=repo
    [tests]=repo
    [lib]=repo

    # install_dotfiles — config files symlinked into HOME
    [.zshrc]=install_dotfiles
    [.aliases]=install_dotfiles
    [.codex]=install_dotfiles
    [.functions]=install_dotfiles
    [.completions]=install_dotfiles
    [.ssh]=install_dotfiles
    [.config]=install_dotfiles
    [config]=install_dotfiles              # Ghostty
    [IDETemplateMacros.plist]=install_dotfiles  # Xcode
    [claude]=install_dotfiles              # Dynamic (skills, rules, settings)
    [.githooks]=install_dotfiles           # core.hooksPath
    [.extra_gitexclude]=install_dotfiles   # .git/info/exclude (gitignored source)
    [.extra_test_suites]=repo              # per-clone optional suites, read by ./test (gitignored)
    [.extra_bin_files]=repo                # per-clone bin tools, read by install_scripts (gitignored)

    # Other bittersweet subcommands
    [bin]=install_scripts
    [profiles]=mdmprofile
    [LaunchAgents]=install_launchagents
    [LaunchDaemons]=install_launchagents
    ["Sublime Text"]=sublimetext
    [.extra]=extra
    [.github]=repo
    [internals]=repo
    [templates]=repo
    [poc]=repo
  )

  # .config/ subdirs must each be wired in install_dotfiles
  local -A config_subdirs=(
    [git]=install_dotfiles
    [uv]=install_dotfiles
    [npm]=install_dotfiles
    [1Password]=install_dotfiles
  )

  # bin/ scripts → owning subcommand
  local -A bin_scripts=(
    # install_scripts → /usr/local/bin/
    [dns]=install_scripts
    [jump-user]=install_scripts
    [jump-system]=install_scripts
    [mdview]=install_scripts
    [npm-audit-check]=install_scripts
    [claude-session-audit]=install_scripts
    [git-sign-unpushed]=install_scripts
    [papercut]=install_scripts
    [bao-mcp-env]=install_scripts               # moved from ~/.local/bin 2026-09-18, internals/linux-path-audit.md
    [agent-reset]=repo                          # backup/verify/wipe ritual; run from the repo, installed nowhere

    # install_dotfiles → ~/.local/bin/ (op wrappers)
    [vt]=install_dotfiles
    [urlscan]=install_dotfiles
    [op-homelab]=install_dotfiles
  )

  # claude/ files → owning subcommand (rules/, skills/ and agents/ are dynamic)
  local -A claude_items=(
    [settings.json]=install_dotfiles
    [global-claude.md]=install_dotfiles
    [statusline-command]=install_dotfiles
    [subagent-statusline]=install_dotfiles
    [lint-hook]=install_dotfiles
    [exa-redirect-hook]=install_dotfiles
    [rm-redirect-hook]=install_dotfiles
    [npm-attest-hook]=install_dotfiles
    [ssh-redirect-hook]=install_dotfiles
    [git-sign-hook]=install_dotfiles
    [container-tmp-hook]=install_dotfiles
    [md5-guard-hook]=install_dotfiles
    [md5-write-hook]=install_dotfiles
    [gh-publish-hook]=install_dotfiles
    [session-host-context]=install_dotfiles
    [hosts]=install_dotfiles                 # Dynamic (per-host context files)
    [output-styles]=install_dotfiles         # Dynamic (custom output styles)
    [rules]=install_dotfiles                 # Dynamic (individual rules)
    [skills]=install_dotfiles                # Dynamic (individual skills)
    [agents]=install_dotfiles                # Dynamic (individual subagents)
  )

  local name

  # 1. Top-level items
  local item
  for item in ./* ./.[!.]*; do
    [[ -e "${item}" ]] || continue
    name="${item##*/}"
    [[ "${name}" == ".git" || "${name}" == ".DS_Store" || "${name}" == ".claude" ]] && continue
    if [[ -z "${top_level[${name}]+_}" ]]; then
      _fail "Untracked top-level: ${name} (add to install_dotfiles or top_level map)"
    elif [[ "${top_level[${name}]}" == install_* ]]; then
      _linkage_check_deployed "${top_level[${name}]}" "${name}"
    fi
  done

  # 2. .config/ subdirectories
  local subdir
  for subdir in .config/*/; do
    [[ -d "${subdir}" ]] || continue
    # Private per-clone config must not force its name into the public map.
    if git check-ignore -q "${subdir%/}"; then continue; fi
    name="${subdir%/}"
    name="${name##*/}"
    if [[ -z "${config_subdirs[${name}]+_}" ]]; then
      _fail "Untracked .config/ subdir: ${name} (add symlink to install_dotfiles and config_subdirs map)"
    else
      _linkage_check_deployed "${config_subdirs[${name}]}" ".config/${name}"
    fi
  done

  # 3. bin/ scripts
  local script
  for script in bin/*; do
    [[ -f "${script}" ]] || continue
    # Skip gitignored files: a private, per-clone tool must never be forced
    # into the tracked manifest — doing so would leak the private filename.
    if git check-ignore -q "${script}"; then continue; fi
    name="${script##*/}"
    if [[ -z "${bin_scripts[${name}]+_}" ]]; then
      _fail "Untracked bin/ script: ${name} (add to install_scripts or bin_scripts map)"
    else
      _linkage_check_deployed "${bin_scripts[${name}]}" "bin/${name}"
    fi
  done

  # 4. LaunchAgent plists
  local plist
  for plist in LaunchAgents/*.plist; do
    [[ -f "${plist}" ]] || continue
    if git check-ignore -q "${plist}"; then continue; fi  # skip gitignored private agents
    name="${plist##*/}"
    _linkage_check_deployed install_launchagents "LaunchAgents/${name}"
    _linkage_check_deployed load_launchagents "LaunchAgents/${name}"
  done

  # 5. LaunchDaemon plists
  for plist in LaunchDaemons/*.plist; do
    [[ -f "${plist}" ]] || continue
    name="${plist##*/}"
    _linkage_check_deployed install_launchagents "LaunchDaemons/${name}"
  done

  # 6. claude/ items (files and subdirs, skip .DS_Store)
  local claude_item
  for claude_item in claude/*; do
    [[ -e "${claude_item}" ]] || continue
    name="${claude_item##*/}"
    [[ "${name}" == ".DS_Store" ]] && continue
    if [[ -z "${claude_items[${name}]+_}" ]]; then
      _fail "Untracked claude/ item: ${name} (add to claude_files in install_dotfiles and claude_items map)"
    elif [[ "${name}" != skills && "${name}" != rules && "${name}" != agents ]]; then
      _linkage_check_deployed "${claude_items[${name}]}" "claude/${name}"
    fi
  done

  if (( fail_count == before_fails )); then
    _pass "All repo files accounted for"
  fi
}
