  _tmp_guard_expect PASS "${hd}" 'escaped substitution in an unquoted body is a literal'
  hd=$'python3 - <<EOF\nx = "$(touch /tmp/x)"\nEOF'
  _tmp_guard_expect DENY "${hd}" 'substitution inside a quoted program string'
  hd=$'cat <<EOF\nplain\nEOF\ncp a /tmp/b'
  _tmp_guard_expect DENY "${hd}" 'command after the heredoc terminator'
