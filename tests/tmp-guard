  _tmp_guard_expect DENY "${hd}" 'write after the message on the same line'
  hd=$'git commit -m "$(cat <<\'EOF\'\nmsg\nEOF\n)"\ncp a /tmp/b'
  _tmp_guard_expect DENY "${hd}" 'write on the line after the message'
  hd=$'echo "a\nb" > /tmp/x'
  _tmp_guard_expect DENY "${hd}" 'redirect after a multi-line quoted argument'
  hd=$'echo "line\n$(cp a /tmp/b)\nend"'
  _tmp_guard_expect DENY "${hd}" 'substitution inside a multi-line quoted argument'
  hd=$'git commit -m "$(cp a /tmp/b; echo msg)"'
  _tmp_guard_expect DENY "${hd}" 'writing command inside the message substitution'
  hd=$'x="$(bash <<\'EOF\'\ncp a /tmp/b\nEOF\n)"'
  _tmp_guard_expect DENY "${hd}" 'shell heredoc inside a substitution is scanned'
  hd=$'x="$(cat <<EOF\n$(cp a /tmp/b)\nEOF\n)"'
  _tmp_guard_expect DENY "${hd}" 'expansion in an unquoted heredoc inside a substitution'
  _tmp_guard_expect DENY 'echo $(echo $(echo $(cp a /tmp/b)))' 'three nested substitutions'
  _tmp_guard_expect DENY 'echo "$(echo "$(cp a /tmp/b)")"' 'nested substitutions in double quotes'
  _tmp_guard_expect DENY 'echo `echo \`cp a /tmp/b\``' 'nested backticks'
  _tmp_guard_expect DENY 'echo $( (cp a /tmp/b) )' 'subshell inside a substitution'
  _tmp_guard_expect DENY 'echo $((1+2)) > /tmp/x' 'redirect after arithmetic expansion'
  _tmp_guard_expect DENY 'echo <(cp a /tmp/b)' 'process substitution body'
  hd=$'echo $(echo $(echo $(echo $(echo $(echo $(echo $(echo $(echo $(echo $(echo $(echo $(echo $(echo hi))))))))))))))'
  _tmp_guard_expect PASS "${hd}" 'fourteen nested substitutions (past the depth limit)'

  # --- cd into a root: only relative writes count, and a later cd clears it ---
  _tmp_guard_expect PASS 'cd /tmp/x && cp out.log ~/y' 'copy out of the root'
