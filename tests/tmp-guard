  _tmp_guard_expect PASS 'cd /tmp && ls | tee ~/list.txt' 'tee target elsewhere'
  _tmp_guard_expect PASS 'cd /tmp && curl -o ~/x u' 'download written elsewhere'
  _tmp_guard_expect PASS 'cd /tmp && sed -i "" s/a/b/ ~/f' 'in-place edit elsewhere'
