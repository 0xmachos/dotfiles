#!/bin/zsh
# dotfiles/tests/tmp-guard
#
# Behavioural test for claude/hooks/tmp-guard-hook, the PreToolUse hook that denies
# writes into /tmp, /private/tmp, /var/tmp, /private/var/tmp, /var/folders and
# /private/var/folders and points at ~/Library/Caches/tint/<repo>-<job>/.
# One input per case. Covers:
#   DENY: a path tool under a root (with the one-line deny reason, another
#         root, a `..` traversal, a notebook_path through the hook's own jq);
#         Bash writes (redirect, cp, tee, mkdir with the root as a later
#         operand, curl, tar, git clone, sed -i, mktemp); a cd into a root
#         then a relative write; a wrapper, a shell string, a substitution, a
#         shell heredoc body and an expanding heredoc body; a write that
#         follows a commit message heredoc
#   PASS: a read, a root used only as a source, a variable target and a
#         commit message that names a write (the false-positive guards)
#   fail-open: an unparseable payload
# Both directions are pinned (`cat /tmp/x` must pass, `cp a /tmp/b` must deny).
#
# Run: ./test tmp-guard
#
# ShellCheck: lint with `shellcheck --shell=bash tests/tmp-guard`.
# This file is sourced, not executed - chmod 644.
#
# shellcheck source=tests/lib
# shellcheck disable=SC2016  # literal $ in fixtures: they are the hook's input

# Seam check: the verdict of the last _hook_run_seam call against $1.
function _tmp_guard_seam_check {
  local want="$1" label="$2"
  if [[ "${HOOK_SEAM_VERDICT}" == "${want}" ]]; then
    _pass "${want}: ${label}"
  else
    _fail "${label} - expected ${want}, got ${HOOK_SEAM_VERDICT} (${HOOK_SEAM_OUT:0:120})"
  fi
}

# Seam run of Bash command $2. The verdict lands in HOOK_SEAM_VERDICT.
function _tmp_guard_expect {
  local want="$1" cmd="$2" label="${3:-$2}"
  _hook_run_seam "${SCRIPT_DIR}/claude/hooks/tmp-guard-hook" Bash "${cmd}"
  _tmp_guard_seam_check "${want}" "${label}"
}

# Seam run of a path tool.
function _tmp_guard_expect_path {
  local want="$1" tool="$2" target="$3"
  _hook_run_seam "${SCRIPT_DIR}/claude/hooks/tmp-guard-hook" "${tool}" '' "${target}"
  _tmp_guard_seam_check "${want}" "${tool} ${target}"
}

function run_tmp_guard {
  _section "tmp scratch write guard hook"

  # claude/ is gitignored, so the hook is absent on a clean clone and in CI.
  if [[ ! -f "${SCRIPT_DIR}/claude/hooks/tmp-guard-hook" ]]; then
    _skip "claude/hooks/tmp-guard-hook absent - claude/ not yet synced to this machine"
    return 0
  fi

  if ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
    return
  fi

  local hd out

  # 1. A path tool under a root denies, and the reason is the one-line message.
  _hook_run_seam "${SCRIPT_DIR}/claude/hooks/tmp-guard-hook" Write '' /tmp/x
  if [[ "${HOOK_SEAM_VERDICT}" == DENY \
     && "${HOOK_SEAM_REASON}" == 'write to /tmp blocked: use ~/Library/Caches/tint/<repo>-<job>/ instead.' \
     && "${HOOK_SEAM_REASON}" != *[Bb]ypass* && "${HOOK_SEAM_REASON}" != *SKIP* ]]; then
    _pass "DENY: Write /tmp/x, one-line reason that names the root and the tint cache, no bypass"
  else
    _fail "Write /tmp/x: ${HOOK_SEAM_VERDICT} ${HOOK_SEAM_OUT:0:200}"
  fi

  # 2. Another root.
  _tmp_guard_expect_path DENY Write /private/var/folders/ab/x

  # 3. A NotebookEdit notebook_path through the hook's own jq, JSON deny.
  out="$(jq -cn '{tool_name:"NotebookEdit", tool_input:{notebook_path:"/tmp/n.ipynb", content:"x"}}' \
    | /bin/zsh "${SCRIPT_DIR}/claude/hooks/tmp-guard-hook")"
  if [[ "$(_hook_verdict "${out}")" == DENY ]]; then
    _pass "DENY: NotebookEdit notebook_path /tmp/n.ipynb (process path, JSON deny)"
  else
    _fail "NotebookEdit notebook_path /tmp/n.ipynb: ${out:0:200}"
  fi

  # 4. A traversal into a root.
  _tmp_guard_expect_path DENY Write /Users/x/../../tmp/y

  # 5 to 13. Bash writes into a root.
  _tmp_guard_expect DENY 'echo hi > /tmp/x'
  _tmp_guard_expect DENY 'cp a /tmp/b'
  _tmp_guard_expect DENY 'echo a | tee -a /tmp/x'
  _tmp_guard_expect DENY 'mkdir -p ~/ok /tmp/x' 'mkdir with the root as the second operand'
  _tmp_guard_expect DENY 'curl -o /tmp/x url'
  _tmp_guard_expect DENY 'tar -xzf a.tgz -C /tmp/x'
  _tmp_guard_expect DENY 'git clone url /tmp/repo'
  _tmp_guard_expect DENY "sed -i '' 's/a/b/' /tmp/f"
  _tmp_guard_expect DENY 'mktemp -d /tmp/foo.XXXX'

  # 14. A cd into a root, then a relative write.
  _tmp_guard_expect DENY 'cd /tmp && echo x > out'

  # 15 to 17. A wrapper chain, a shell string with a cd, a substitution.
  _tmp_guard_expect DENY 'sudo -u root nice -n 5 timeout 9 cp a /tmp/b' 'several wrappers'
  _tmp_guard_expect DENY "bash -lc 'cd /tmp && touch x'" 'bash -lc string with a cd'
  _tmp_guard_expect DENY 'echo "$(cp a /tmp/b)"' 'command substitution in double quotes'

  # 18 and 19. A heredoc body fed to a shell, and an expanding heredoc body.
  hd=$'bash <<EOF\ntouch /tmp/x\nEOF'
  _tmp_guard_expect DENY "${hd}" 'heredoc body fed to bash is scanned'
  hd=$'cat <<EOF\n$(cp a /tmp/b)\nEOF'
  _tmp_guard_expect DENY "${hd}" 'unquoted delimiter expands a substitution in the body'

  # 20. A write after a commit message heredoc still counts.
  hd=$'git commit -m "$(cat <<\'EOF\'\nmsg\nEOF\n)" && cp a /tmp/b'
  _tmp_guard_expect DENY "${hd}" 'write after the message on the same line'

  # 21 to 24. False-positive guards: a read, a root as a source, a variable
  # target, a commit message that names a write.
  _tmp_guard_expect PASS 'cat /tmp/x'
  _tmp_guard_expect PASS 'cp /tmp/a ~/b'
  _tmp_guard_expect PASS 'echo hi > $TMPDIR/x'
  hd=$'git commit -m "$(cat <<\'EOF\'\nsubject\n\ncp a /tmp/b\nEOF\n)"'
  _tmp_guard_expect PASS "${hd}" 'commit message body that names a write'

  # 25. Fail-open: an unparseable payload produces no output.
  if [[ -z "$(printf '%s' 'not json' | /bin/zsh "${SCRIPT_DIR}/claude/hooks/tmp-guard-hook" 2>/dev/null)" ]]; then
    _pass "fail-open: unparseable payload produces no output"
  else
    _fail "fail-open: unparseable payload produced output"
  fi
}
