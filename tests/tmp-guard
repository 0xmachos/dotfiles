#!/bin/zsh
# dotfiles/tests/tmp-guard
#
# Behavioural test for claude/hooks/tmp-guard-hook, the PreToolUse hook that denies
# writes into /tmp, /private/tmp, /var/tmp, /private/var/tmp, /var/folders and
# /private/var/folders and points at ~/Library/Caches/tint/<repo>-<job>/.
# Feeds tool calls as stdin JSON and asserts the verdict:
#   DENY: Write/Edit/NotebookEdit targets and Bash write positions under a root
#   PASS: reads, devices, lookalike and variable-based paths, text mentions,
#         heredoc data, multi-line commit/PR message bodies
# Both directions are pinned (`cat /tmp/x` must pass, `cp a /tmp/b` must deny).
# Every loop in the hook is driven more than once, and the hook source is
# checked for a `local` below function level (a repeated untyped `local NAME`
# in one zsh scope prints NAME=value to stdout and corrupts the deny JSON).
#
# Run: ./test tmp-guard    (or ./test for the full suite)
#
# ShellCheck: lint with `shellcheck --shell=bash tests/tmp-guard`.
# This file is sourced, not executed - chmod 644.
#
# shellcheck source=tests/lib
# shellcheck disable=SC2016  # literal $ in fixtures: they are the hook's input

# Payloads for the Bash and path cases are built in zsh. Each payload and the
# text it carries are recorded, and one jq call decodes them all at the end
# (_tmp_guard_payloads_ok), so a bad escape fails loudly instead of reaching the
# hook as fail-open invalid JSON.
typeset -ga TG_SENT TG_PAYLOADS

function _tmp_guard_json {
  # Set REPLY to $1 escaped for the inside of a JSON string.
  local s="$1"
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  REPLY=${s//$'\t'/\\t}
}

function _tmp_guard_run {
  # Set TG_OUT to the hook's stdout for Bash command $1.
  _tmp_guard_json "$1"
  TG_SENT+=("$1")
  TG_PAYLOADS+=("{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"${REPLY}\"}}")
  TG_OUT="$(/bin/zsh "${SCRIPT_DIR}/claude/hooks/tmp-guard-hook" <<< "${TG_PAYLOADS[-1]}" || true)"
}

function _tmp_guard_run_path {
  # Set TG_OUT to the hook's stdout for tool $1 with input key $2 set to path $3.
  _tmp_guard_json "$3"
  TG_SENT+=("$3")
  TG_PAYLOADS+=("{\"tool_name\":\"$1\",\"tool_input\":{\"$2\":\"${REPLY}\",\"content\":\"x\"}}")
  TG_OUT="$(/bin/zsh "${SCRIPT_DIR}/claude/hooks/tmp-guard-hook" <<< "${TG_PAYLOADS[-1]}" || true)"
}

function _tmp_guard_payloads_ok {
  # True when jq decodes every recorded payload back to the text it was built from.
  local dir="$1"
  printf '%s\x1e' "${TG_SENT[@]}" > "${dir}/sent"
  printf '%s\n' "${TG_PAYLOADS[@]}" \
    | jq -j '(.tool_input.command // .tool_input.file_path // .tool_input.notebook_path), "\u001e"' > "${dir}/decoded" 2>/dev/null
  [[ "$(<"${dir}/sent")" == "$(<"${dir}/decoded")" ]]
}

function _tmp_guard_run_file {
  # Feed a command string held in a file (too large for argv).
  jq -Rs '{tool_name:"Bash", tool_input:{command:.}}' < "$1" \
    | /bin/zsh "${SCRIPT_DIR}/claude/hooks/tmp-guard-hook"
}

function _tmp_guard_run_env {
  # Set TG_OUT to the hook's stdout for Bash command $1 run by a zsh that reads
  # the startup file directory $2 (ZDOTDIR), stderr folded in.
  _tmp_guard_json "$1"
  TG_SENT+=("$1")
  TG_PAYLOADS+=("{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"${REPLY}\"}}")
  TG_OUT="$(ZDOTDIR="$2" /bin/zsh "${SCRIPT_DIR}/claude/hooks/tmp-guard-hook" <<< "${TG_PAYLOADS[-1]}" 2>&1 || true)"
}

function _tmp_guard_copy_hook {
  # Copy the hook to $1/hook with ONE literal changed: $2 becomes $3. Returns 1
  # (and says why) when the copy is unchanged or lacks the new literal, so a
  # drifted pattern cannot give a green case. The hook reads no file relative
  # to its own path, so the copy runs the same as the original.
  local dir="$1" old="$2" new="$3" body changed
  body="$(<"${SCRIPT_DIR}/claude/hooks/tmp-guard-hook")" || body=''
  changed="${body/"${old}"/"${new}"}"
  if [[ -z "${body}" || "${changed}" == "${body}" || "${changed}" != *"${new}"* ]]; then
    _fail "hook copy: literal not found or not changed: ${old}"
    return 1
  fi
  print -r -- "${changed}" > "${dir}/hook"
}

function _tmp_guard_check {
  local want="$1" out="$2" label="$3" got
  got="$(_hook_verdict "${out}")"
  if [[ "${got}" == "${want}" ]]; then
    _pass "${want}: ${label}"
  else
    _fail "${label} - expected ${want}, got ${got}"
  fi
}

function _tmp_guard_expect {
  local want="$1" cmd="$2" label="${3:-$2}"
  _tmp_guard_run "${cmd}"
  _tmp_guard_check "${want}" "${TG_OUT}" "${label}"
}

function _tmp_guard_expect_path {
  local want="$1" tool="$2" key="$3" target="$4"
  _tmp_guard_run_path "${tool}" "${key}" "${target}"
  _tmp_guard_check "${want}" "${TG_OUT}" "${tool} ${target}"
}

function _tmp_guard_expect_file {
  local want="$1" file="$2" label="$3"
  _tmp_guard_check "${want}" "$(_tmp_guard_run_file "${file}")" "${label}"
}

function run_tmp_guard {
  _section "tmp scratch write guard hook"

  TG_SENT=()
  TG_PAYLOADS=()

  # claude/ is gitignored, so the hook is absent on a clean clone and in CI.
  if [[ ! -f "${SCRIPT_DIR}/claude/hooks/tmp-guard-hook" ]]; then
    _skip "claude/hooks/tmp-guard-hook absent - claude/ not yet synced to this machine"
    return 0
  fi

  if ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
    return
  fi

  local hd fixture_dir pad
  local -i n

  # --- Write / Edit / NotebookEdit: lexical path check ---------------------
  _tmp_guard_expect_path DENY Write file_path /tmp/x
  _tmp_guard_expect_path DENY Write file_path /tmp
  _tmp_guard_expect_path DENY Write file_path /private/tmp/a/b
  _tmp_guard_expect_path DENY Write file_path /var/tmp/x
  _tmp_guard_expect_path DENY Write file_path /private/var/tmp/x
  _tmp_guard_expect_path DENY Write file_path /var/folders/ab/cd_ef/T/x
  _tmp_guard_expect_path DENY Write file_path /private/var/folders/ab/x
  _tmp_guard_expect_path DENY Edit file_path /tmp/x
  _tmp_guard_expect_path DENY NotebookEdit notebook_path /tmp/n.ipynb
  _tmp_guard_expect_path DENY Write file_path //tmp/x
  _tmp_guard_expect_path DENY Write file_path /tmp//x
  _tmp_guard_expect_path DENY Write file_path /tmp/./x
  _tmp_guard_expect_path DENY Write file_path /Users/x/../../tmp/y
  _tmp_guard_expect_path DENY Write file_path /var/../tmp/x
  _tmp_guard_expect_path DENY Write file_path /tmp/../tmp/x
  _tmp_guard_expect_path DENY Write file_path /TMP/x
  _tmp_guard_expect_path DENY Write file_path /Private/Var/Folders/x
  _tmp_guard_expect_path PASS Write file_path /Users/x/tmp/y
  _tmp_guard_expect_path PASS Write file_path /Users/x/Library/Caches/tint/a/b
  _tmp_guard_expect_path PASS Write file_path /tmpfoo/x
  _tmp_guard_expect_path PASS Write file_path /var/tmpx/y
  _tmp_guard_expect_path PASS Write file_path /var/folder/x
  _tmp_guard_expect_path PASS Write file_path /private/tmpx
  _tmp_guard_expect_path PASS Write file_path tmp/x
  # shellcheck disable=SC2088  # literal tilde: the hook receives it unexpanded
  _tmp_guard_expect_path PASS Write file_path '~/tmp/x'
  _tmp_guard_expect_path PASS Write file_path ./tmp/x
  _tmp_guard_expect_path PASS Write file_path /tmp/../Users/x/y
  _tmp_guard_expect_path PASS Write file_path /var/tmp/../../Users/x
  _tmp_guard_expect_path PASS Edit file_path /Users/x/repo/tmp/f
  _tmp_guard_expect_path PASS NotebookEdit notebook_path /Users/x/n.ipynb

  # --- Bash: write redirects ----------------------------------------------
