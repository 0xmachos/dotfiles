  _tmp_guard_expect DENY 'cd /tmp && tar czf out.tgz .' 'relative archive'
  _tmp_guard_expect DENY 'cd /tmp && tar xf a' 'extract into the working directory'
  _tmp_guard_expect DENY 'cd /tmp && curl -o out u' 'relative -o'
  _tmp_guard_expect DENY 'cd /tmp && cp a ~/y /tmp/z' 'absolute destination under the root still counts'
  _tmp_guard_expect DENY $'cd /tmp\nls\ntouch x' 'cd, then a write two lines later'
  _tmp_guard_expect DENY $'cd /tmp\ncd sub\necho hi > out' 'relative cd across lines'

  # --- git -C: the last -C wins; only a relative or missing target is in the root
