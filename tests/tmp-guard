  _tmp_guard_expect DENY 'git -C /tmp/x clone url dest' 'relative clone target'
  _tmp_guard_expect DENY 'cd /tmp && git -C sub init' 'relative -C after cd'
  _tmp_guard_expect PASS 'cd /tmp && git -C ~/repo init' '-C to a non-root overrides the cd'
  _tmp_guard_expect DENY 'cd /tmp && git -C ~/repo init; touch x' 'the cd state survives a git -C'

  # --- Spellings of a root: line joins, empty substitutions, ~ traversal --------
  _tmp_guard_expect DENY $'echo hi > /tm\\\np/x' 'backslash-newline inside the path'
  _tmp_guard_expect DENY $'cp a /tm\\\np/b' 'backslash-newline inside a copy destination'
  _tmp_guard_expect DENY 'echo hi > /t$()mp/x' 'empty substitution inside the path'
  _tmp_guard_expect DENY 'cp a /t$()mp/b' 'empty substitution inside a copy destination'
  _tmp_guard_expect DENY 'cp a /t``mp/b' 'empty backticks inside a copy destination'
  _tmp_guard_expect DENY 'cp a ~/../../tmp/b' 'home-relative escape to /tmp'
  _tmp_guard_expect DENY 'cp a ~/../../../tmp/b' 'home-relative escape, extra dot-dot'
  _tmp_guard_expect DENY 'cp a ~someuser/../../tmp/b' 'named-home escape to /tmp'
  _tmp_guard_expect DENY 'cp a ~/../../var/folders/x/b' 'home-relative escape to /var/folders'
  _tmp_guard_expect PASS 'cp a ~/tmp/b' 'a directory called tmp under home'
  _tmp_guard_expect PASS 'cp a ~/../x' 'home-relative path that is not a root'
  _tmp_guard_expect PASS 'cp a ~/Library/Caches/tint/b'

  # --- More wrappers and env -S ---------------------------------------------
  _tmp_guard_expect DENY 'exec -a x cp a /tmp/x' 'exec -a name'
  _tmp_guard_expect DENY 'caffeinate cp a /tmp/x' 'caffeinate'
  _tmp_guard_expect DENY 'caffeinate -t 5 cp a /tmp/x' 'caffeinate -t N'
  _tmp_guard_expect DENY 'caffeinate -dimsu cp a /tmp/x' 'caffeinate flag cluster'
  _tmp_guard_expect DENY 'arch -arm64 cp a /tmp/x' 'arch -arm64'
  _tmp_guard_expect DENY 'arch -x86_64 cp a /tmp/x' 'arch -x86_64'
  _tmp_guard_expect DENY 'chronic cp a /tmp/x' 'chronic'
  _tmp_guard_expect DENY 'watch -n 1 cp a /tmp/x' 'watch -n N'
  _tmp_guard_expect DENY 'ionice -c 3 cp a /tmp/x' 'ionice -c N'
  _tmp_guard_expect DENY 'coproc cp a /tmp/x' 'coproc'
  _tmp_guard_expect DENY 'env -S "cp a /tmp/x"' 'env -S string'
  _tmp_guard_expect DENY 'env -S"cp a /tmp/x"' 'env -S attached string'
  _tmp_guard_expect DENY 'env --split-string="cp a /tmp/x"' 'env --split-string='
  _tmp_guard_expect DENY 'env --split-string "cp a /tmp/x"' 'env --split-string string'
  _tmp_guard_expect DENY 'env -i -S "cp a /tmp/x"' 'env -i -S string'
  _tmp_guard_expect DENY $'env -S "cd /tmp\ntouch x"' 'env -S string with a cd and a write'
  _tmp_guard_expect PASS 'env -S "ls /tmp"' 'env -S string that only reads'
  _tmp_guard_expect PASS 'caffeinate -t 5 ls /tmp'
  _tmp_guard_expect PASS 'arch -arm64 ls /tmp'
  _tmp_guard_expect PASS 'exec -a x ls /tmp'
  _tmp_guard_expect PASS 'watch -n 1 ls /tmp'

  # --- Scan limits: no line cap, no queue cap ---------------------------------
  fixture_dir="$(mktemp -d "${TMPDIR:-/tmp}/tmp-guard-fixtures.XXXXXX")"
  { for (( n = 1; n <= 450; n++ )); do print "echo x${n}"; done; print 'echo $(cp a /tmp/b)'; } > "${fixture_dir}/many"
  _tmp_guard_expect_file DENY "${fixture_dir}/many" '451 lines, substitution on the last one'
  { for (( n = 1; n <= 500; n++ )); do print "echo \$(echo /tmp/x${n})"; done; print 'cp a /tmp/b'; } > "${fixture_dir}/subs"
  _tmp_guard_expect_file DENY "${fixture_dir}/subs" '500 substitution lines, then a write'
  { for (( n = 1; n <= 300; n++ )); do print "echo \$(cp a /tmp/b${n})"; done; } > "${fixture_dir}/subw"
  _tmp_guard_expect_file DENY "${fixture_dir}/subw" '300 lines whose substitutions write'
  { for (( n = 1; n <= 40; n++ )); do print "bash -c 'echo ${n}'"; done; print "bash -c 'cp a /tmp/b'"; } > "${fixture_dir}/shells"
  _tmp_guard_expect_file DENY "${fixture_dir}/shells" '41 shell strings, the last one writes'
  pad="$(printf 'x%.0s' {1..30000})"
  printf '%s\n' "echo ${pad} > /tmp/b" > "${fixture_dir}/line30k"
  _tmp_guard_expect_file DENY "${fixture_dir}/line30k" '30KB line is still scanned'
  pad="$(printf 'x%.0s' {1..70000})"
  printf '%s\n' "echo ${pad} > /tmp/b" > "${fixture_dir}/over"
  _tmp_guard_expect_file PASS "${fixture_dir}/over" 'write after the scan budget (fail-open)'
  printf '%s\n' "echo hi > /tmp/b; echo ${pad}" > "${fixture_dir}/before"
  _tmp_guard_expect_file DENY "${fixture_dir}/before" 'write before the scan budget runs out'
  /bin/rm -rf "${fixture_dir}"

  # --- Regressions: every loop driven more than once ------------------------
  # Two heredocs on one line, then a real write after them.
  hd=$'cat <<A; cat <<B\nx\nA\ny\nB\ncp a /tmp/b'
  _tmp_guard_expect DENY "${hd}" 'two heredocs on one line, deny stays a single JSON object'
  hd=$'cat <<A; cat <<B\nx\nA\ny\nB'
  _tmp_guard_expect PASS "${hd}" 'two heredocs on one line, pass stays empty'
  hd=$'cat <<A; cat <<B; cat <<C\nx\nA\ny\nB\nz\nC'
  _tmp_guard_expect PASS "${hd}" 'three heredocs on one line'
  # Two substitution spans on one body line and on two body lines.
  hd=$'cat <<EOF\n$(date) $(cp a /tmp/b)\nEOF'
  _tmp_guard_expect DENY "${hd}" 'two substitutions on one body line'
  hd=$'cat <<EOF\n$(date)\n$(cp a /tmp/b)\nEOF'
  _tmp_guard_expect DENY "${hd}" 'two substitution lines in a body'
  hd=$'cat <<EOF\n`date` `cp a /tmp/b`\nEOF'
  _tmp_guard_expect DENY "${hd}" 'two backtick spans on one body line'
  hd=$'cat <<EOF\n$(date)\n$(uname)\nEOF'
  _tmp_guard_expect PASS "${hd}" 'two harmless substitution lines'
  # Tokeniser and parser run on many lines, words, redirects and operands.
  hd=$'echo "a" > o1\necho \'b\' >> o2\nls $(pwd) 2>&1\ncp x y\nmkdir -p a b c\ncp a /tmp/b'
  _tmp_guard_expect DENY "${hd}" 'six lines, then the write'
  hd=$'echo "a" > o1\necho \'b\' >> o2\nls $(pwd) 2>&1\ncp x y\nmkdir -p a b c'
  _tmp_guard_expect PASS "${hd}" 'six lines, no write to a root'
  _tmp_guard_expect DENY 'echo $(a) $(b) $(c) `d` `e` > /tmp/x' 'many substitutions before the target'
  _tmp_guard_expect DENY 'cp a b; cp c d; cp e f; mkdir /tmp/x' 'four verbs, last one writes'
  _tmp_guard_expect PASS 'cp a b; cp c d; cp e f; mkdir ~/x' 'four verbs, none writes'
  _tmp_guard_expect DENY 'touch ~/a ~/b ~/c /tmp/d' 'operand loop, last operand'
  _tmp_guard_expect PASS 'touch ~/a ~/b ~/c ~/d'
  _tmp_guard_expect DENY 'curl -o ~/a -o ~/b -o /tmp/c u' 'option loop, last value'
  _tmp_guard_expect DENY 'mktemp -p ~/a -p /tmp' 'repeated -p'
  _tmp_guard_expect DENY 'mktemp --tmpdir=~/a --tmpdir=/tmp'
  _tmp_guard_expect DENY 'dd if=a of=~/x of=/tmp/y' 'repeated of='
  _tmp_guard_expect DENY 'bash -c "cd /tmp; touch a; touch b"' 'shell string with several commands'
  _tmp_guard_expect DENY 'eval "echo a"; eval "cp a /tmp/b"' 'two evals'
  _tmp_guard_expect PASS 'eval "echo a"; eval "echo b"'
  _tmp_guard_expect DENY 'tar -xf a -C ~/x -C /tmp/y' 'repeated -C'
  _tmp_guard_expect DENY 'tar -cf ~/a.tar -f /tmp/b.tar x' 'repeated -f'
  _tmp_guard_expect DENY 'cd ~/a; cd /tmp/b; touch x' 'second cd is the root one'
  _tmp_guard_expect DENY 'FOO=1 BAR=2 BAZ=3 cp a /tmp/b' 'several assignments'
  _tmp_guard_expect DENY 'sudo -u root nice -n 5 timeout 9 cp a /tmp/b' 'several wrappers'

  # A `local` below function level is a regression even if no fixture hits it.
  if /usr/bin/grep -nE '^ {3,}local ' "${SCRIPT_DIR}/claude/hooks/tmp-guard-hook" >/dev/null; then
    _fail "hook source declares a local below function level"
  else
    _pass "hook source declares every local at function level"
  fi
  if [[ "$(<"${SCRIPT_DIR}/claude/hooks/tmp-guard-hook")" == *_SKIP* ]]; then
    _fail "hook source mentions a skip variable"
  else
    _pass "hook source has no skip variable"
  fi

  # --- Verdict shape --------------------------------------------------------
  local reason rc root length
  _tmp_guard_run 'echo hi > /tmp/x'
  reason="$(jq -r '.hookSpecificOutput.permissionDecisionReason' <<< "${TG_OUT}")"
  if [[ "${reason}" == 'write to /tmp blocked: use ~/Library/Caches/tint/<repo>-<job>/ instead.' ]]; then
    _pass "deny reason is the one-line message"
  else
    _fail "deny reason unexpected: ${reason}"
  fi
  if [[ "$(jq -r '.hookSpecificOutput.hookEventName' <<< "${TG_OUT}")" == PreToolUse ]]; then
    _pass "deny names the PreToolUse event"
  else
    _fail "deny does not name the PreToolUse event"
  fi
  for root in /tmp /private/tmp /var/tmp /private/var/tmp /var/folders /private/var/folders; do
    _tmp_guard_run_path Write file_path "${root}/x"
    reason="$(jq -r '.hookSpecificOutput.permissionDecisionReason' <<< "${TG_OUT}")"
    length=${#reason}
    if [[ "${reason}" == "write to ${root} blocked: "* ]] && (( length <= 120 )); then
      _pass "reason names ${root} (${length} chars)"
    else
      _fail "reason for ${root} wrong or over 120 chars: ${reason}"
    fi
  done
  if [[ "${reason}" == *$'\n'* ]]; then
    _fail "deny reason is not one line"
  else
    _pass "deny reason is one line"
  fi
  if [[ "${reason}" == *[Bb]ypass* || "${reason}" == *SKIP* || "${reason}" == *export* ]]; then
    _fail "deny reason offers a bypass"
  else
    _pass "deny reason offers no bypass"
  fi
  printf '%s' '{"tool_name":"Bash","tool_input":{"command":"echo hi > /tmp/x"}}' \
    | /bin/zsh "${SCRIPT_DIR}/claude/hooks/tmp-guard-hook" >/dev/null
  rc=$?
  if (( rc == 0 )); then
    _pass "exit status 0 on deny"
  else
    _fail "exit status ${rc} on deny"
  fi
  printf '%s' '{"tool_name":"Bash","tool_input":{"command":"ls"}}' \
    | /bin/zsh "${SCRIPT_DIR}/claude/hooks/tmp-guard-hook" >/dev/null
  rc=$?
  if (( rc == 0 )); then
    _pass "exit status 0 on pass"
  else
    _fail "exit status ${rc} on pass"
  fi

  # --- Malformed payloads fail open, never block ---------------------------
  local payload
  for payload in '{}' 'not json' '' '[]' 'null' '{"tool_input":null}' \
      '{"tool_input":{"command":5}}' '{"tool_input":{"command":""}}' \
      '{"tool_input":{"command":null}}' '{"tool_input":{"file_path":5}}' \
      '{"tool_input":{"file_path":""}}' '{"tool_input":"x"}' '{"tool_name":"Bash"}'; do
    if [[ -z "$(printf '%s' "${payload}" | /bin/zsh "${SCRIPT_DIR}/claude/hooks/tmp-guard-hook" 2>/dev/null)" ]]; then
      _pass "fail-open: payload ${payload:-<empty>} allowed through"
    else
      _fail "fail-open: payload ${payload:-<empty>} produced output"
    fi
  done

  # --- Size and budget limits fail open --------------------------------------
  fixture_dir="$(mktemp -d "${TMPDIR:-/tmp}/tmp-guard-fixtures.XXXXXX")"
  pad="$(printf 'x%.0s' {1..120000})"
  printf '%s\n' "echo ${pad}" "cp a /tmp/b" > "${fixture_dir}/huge"
  _tmp_guard_expect_file PASS "${fixture_dir}/huge" 'command over the size cap (fail-open)'
  pad="$(printf 'x%.0s' {1..15000})"
  printf '%s\n' "echo ${pad} > /tmp/b" > "${fixture_dir}/okline"
  _tmp_guard_expect_file DENY "${fixture_dir}/okline" '15KB line is still scanned'
  /bin/rm -rf "${fixture_dir}"

  # --- jq absent fails open ------------------------------------------------
  # A hook copy whose readonly JQ path is missing allows a command the real
  # hook denies.
  local copy_dir copy_out
  local -i copy_rc
  copy_dir="$(mktemp -d "${TMPDIR:-/tmp}/tmp-guard-copy.XXXXXX")"
  if _tmp_guard_copy_hook "${copy_dir}" 'readonly JQ=/usr/bin/jq' 'readonly JQ=/nonexistent/jq'; then
    copy_rc=0
    copy_out="$(printf '%s' '{"tool_name":"Bash","tool_input":{"command":"cp a /tmp/b"}}' | /bin/zsh "${copy_dir}/hook" 2>/dev/null)" || copy_rc=$?
    _tmp_guard_check PASS "${copy_out}" 'jq missing: a command that DENYs fails open'
    if (( copy_rc == 0 )); then
      _pass "jq missing: exit status 0"
    else
      _fail "jq missing: exit status ${copy_rc}"
    fi
  fi
  /bin/rm -rf "${copy_dir}"

  # --- Shell options from the user's startup files do not change a verdict -----
  # zsh reads $ZDOTDIR/.zshenv for every invocation, scripts included.
  local zdir
  zdir="$(mktemp -d "${TMPDIR:-/tmp}/tmp-guard-zdotdir.XXXXXX")"
  print -r -- 'setopt ksharrays shwordsplit nobareglobqual nounset errexit noglob nomatch' > "${zdir}/.zshenv"
  _tmp_guard_run_env 'cp a /tmp/b' "${zdir}"
  _tmp_guard_check DENY "${TG_OUT}" 'deny under ksharrays, shwordsplit and errexit'
  _tmp_guard_run_env $'git commit -m "$(cat <<\'EOF\'\nmkdir /tmp/x\nEOF\n)"' "${zdir}"
  _tmp_guard_check PASS "${TG_OUT}" 'pass under ksharrays, shwordsplit and errexit, stdout and stderr empty'
  _tmp_guard_run_env 'cat /tmp/x' "${zdir}"
  _tmp_guard_check PASS "${TG_OUT}" 'read passes under ksharrays'

  # Every payload above was built in zsh, not by jq: decode them all once.
  if _tmp_guard_payloads_ok "${zdir}"; then
    _pass "all ${#TG_PAYLOADS} zsh-built payloads decode to the command or path sent"
  else
    _fail "a zsh-built payload does not decode to the command or path sent"
  fi
  /bin/rm -rf "${zdir}"
}
