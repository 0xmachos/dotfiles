  _tmp_guard_expect DENY 'mv a /tmp/b'
  _tmp_guard_expect DENY 'ln -s a /tmp/l'
  _tmp_guard_expect DENY 'ln -sfn a /tmp/l'
  _tmp_guard_expect DENY 'install -m 755 a /tmp/b'
  _tmp_guard_expect DENY 'install -d /tmp/x /tmp/y'
  _tmp_guard_expect DENY 'install -d ~/x /tmp/y'
  _tmp_guard_expect DENY 'rsync -av a/ /tmp/dest/'
  _tmp_guard_expect DENY 'rsync -e ssh a /private/tmp/d'
  _tmp_guard_expect DENY 'ditto a /tmp/b'
  _tmp_guard_expect DENY 'gcp a /tmp/b' 'GNU-prefixed name'
  _tmp_guard_expect DENY 'CP a /tmp/b' 'upper-case command word'
  _tmp_guard_expect DENY '/bin/cp a /tmp/b' 'absolute command path'
  _tmp_guard_expect DENY 'cp "$(pwd)/f" /tmp/y' 'substitution inside an earlier argument'
  _tmp_guard_expect DENY 'mkdir -p "$(dirname x)" /tmp/z' 'substitution before the root operand'
  _tmp_guard_expect DENY 'cp a "/tmp/my dir/b"' 'quoted destination with a space'
  _tmp_guard_expect DENY "cp a '/tmp/b'" 'single-quoted destination'
  _tmp_guard_expect DENY 'cp a \/tmp/b' 'escaped destination'
  _tmp_guard_expect DENY 'cp a b c /var/folders/xx/T/d' 'several sources'

  # --- Bash: wrappers and command positions --------------------------------
  _tmp_guard_expect DENY 'sudo cp a /tmp/b'
  _tmp_guard_expect DENY 'sudo -u root cp a /tmp/b'
  _tmp_guard_expect DENY 'env FOO=1 cp a /tmp/b'
  _tmp_guard_expect DENY 'env -u FOO cp a /tmp/b'
  _tmp_guard_expect DENY 'FOO=1 touch /tmp/x'
  _tmp_guard_expect DENY 'timeout 5 curl -o /tmp/x u'
  _tmp_guard_expect DENY 'timeout -k 5 12 touch /tmp/x'
  _tmp_guard_expect DENY 'nohup cp a /tmp/b'
  _tmp_guard_expect DENY 'nice -n 10 cp a /tmp/b'
  _tmp_guard_expect DENY 'command mkdir /tmp/x'
  _tmp_guard_expect DENY 'builtin cd /tmp && touch x'
  _tmp_guard_expect DENY 'find . -name x | xargs -I{} cp {} /tmp/'
  _tmp_guard_expect DENY '2>/dev/null cp a /tmp/b' 'leading redirection'
  _tmp_guard_expect DENY 'ls && touch /tmp/x'
  _tmp_guard_expect DENY 'a; b > /tmp/x'
  _tmp_guard_expect DENY 'a || touch /tmp/x'
  _tmp_guard_expect DENY '(cp a /tmp/b)'
  _tmp_guard_expect DENY '{ cp a /tmp/b; }'
  _tmp_guard_expect DENY 'if true; then cp a /tmp/b; fi'
  _tmp_guard_expect DENY 'for f in a b; do cp $f /tmp/; done'
  _tmp_guard_expect DENY 'while read l; do echo $l >> /tmp/x; done < in'
  _tmp_guard_expect DENY 'echo $(cp a /tmp/b)' 'command substitution'
  _tmp_guard_expect DENY 'echo "$(cp a /tmp/b)"' 'command substitution in double quotes'
  _tmp_guard_expect DENY 'echo `cp a /tmp/b`' 'backtick substitution'
  _tmp_guard_expect DENY 'X=$(cp a /tmp/b)' 'substitution assigned to a variable'
  _tmp_guard_expect DENY 'cat <(cp a /tmp/b)' 'process substitution'
  _tmp_guard_expect DENY 'echo a | tee >(cat > /tmp/x)' 'process substitution body writes'
  _tmp_guard_expect DENY $'echo a\ncp a /tmp/b' 'second line of a multi-line command'
  _tmp_guard_expect DENY $'echo a # c\ncp a /tmp/b' 'command after a comment line'
  _tmp_guard_expect DENY $'cp a \\\n/tmp/b' 'backslash-newline continuation'
  _tmp_guard_expect DENY "bash -c 'cp a /tmp/b'" 'bash -c string is scanned'
  _tmp_guard_expect DENY 'sh -c "echo hi > /tmp/x"' 'sh -c string is scanned'
  _tmp_guard_expect DENY "bash -lc 'cd /tmp && touch x'" 'bash -lc cluster'
  _tmp_guard_expect DENY 'eval "cp a /tmp/b"' 'eval argument is scanned'
  _tmp_guard_expect DENY "bash -c \"bash -c 'cp a /tmp/b'\"" 'nested shell -c'

  # --- Bash: mktemp ---------------------------------------------------------
  _tmp_guard_expect DENY 'mktemp /tmp/foo.XXXXXX'
  _tmp_guard_expect DENY 'mktemp -d /tmp/foo.XXXX'
  _tmp_guard_expect DENY 'mktemp -p /tmp'
  _tmp_guard_expect DENY 'mktemp -d -p /var/folders/x'
  _tmp_guard_expect DENY 'mktemp --tmpdir=/tmp'
  _tmp_guard_expect DENY 'mktemp -d -t /tmp/foo'
  _tmp_guard_expect PASS 'mktemp'
  _tmp_guard_expect PASS 'mktemp -d'
  _tmp_guard_expect PASS 'mktemp -d -t foo'
  _tmp_guard_expect PASS 'mktemp -p ~/x'
  _tmp_guard_expect PASS 'mktemp --tmpdir'
  _tmp_guard_expect PASS 'mktemp foo.XXXX'

  # --- Bash: curl / wget / tar / git / unzip / sed / perl / dd ------------
  _tmp_guard_expect DENY 'curl -o /tmp/x url'
  _tmp_guard_expect DENY 'curl -sSLo /tmp/x url'
  _tmp_guard_expect DENY 'curl -o/tmp/x url'
  _tmp_guard_expect DENY 'curl --output /tmp/x url'
  _tmp_guard_expect DENY 'curl --output=/tmp/x url'
  _tmp_guard_expect DENY 'curl --output-dir /tmp -O url'
  _tmp_guard_expect DENY 'curl -D /tmp/h url'
  _tmp_guard_expect DENY 'curl -c /tmp/jar url'
  _tmp_guard_expect DENY 'curl --dump-header /tmp/h url'
  _tmp_guard_expect DENY 'curl --cookie-jar /tmp/jar url'
