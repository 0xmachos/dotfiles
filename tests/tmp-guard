  _tmp_guard_expect DENY 'a > o1 2> o2 >> o3 > /tmp/x' 'several redirects on one command'
  _tmp_guard_expect DENY 'echo a >/tmp/x #comment' 'comment after the redirect'
  _tmp_guard_expect DENY 'echo ${#x} > /tmp/y' 'hash inside a parameter expansion is not a comment'
  _tmp_guard_expect DENY 'echo ${x:-a b} > /tmp/y' 'space inside a parameter expansion'
  _tmp_guard_expect DENY 'echo a > "/tmp/my file"' 'quoted target with a space'
  _tmp_guard_expect DENY 'echo a > /tmp/$name' 'literal root prefix, variable tail'
  _tmp_guard_expect DENY 'echo a > "/tm"p/x' 'root split across quotes'
  _tmp_guard_expect DENY 'echo a > \/tmp/x' 'escaped first slash'
  _tmp_guard_expect DENY 'echo a > /tmp/../tmp/x' 'dot-dot inside the target'
  _tmp_guard_expect DENY 'echo a > //tmp/x' 'doubled leading slash'
  _tmp_guard_expect DENY 'echo hi>/tmp/x' 'no space around the operator'
  _tmp_guard_expect DENY 'echo 1>/tmp/x' 'fd digit before the operator'
  _tmp_guard_expect DENY "echo a > \$'/tmp/x'" 'ANSI-C quoted target'
  _tmp_guard_expect DENY 'exec > /tmp/log' 'exec with only a redirect'
  _tmp_guard_expect DENY '{ echo a; } > /tmp/x' 'redirect after a brace group'
  _tmp_guard_expect DENY '(echo a) > /tmp/x' 'redirect after a subshell'
  _tmp_guard_expect DENY 'echo a | { cat > /tmp/x; }' 'redirect inside a brace group'
  _tmp_guard_expect DENY 'cp -a src/. /tmp/x/' 'trailing-dot source'
  _tmp_guard_expect DENY 'sudo -u root -- cp a /tmp/b' 'double dash after wrapper flags'
  _tmp_guard_expect DENY 'echo a > /TMP/x' 'case-insensitive root'

  # --- Bash: tee ----------------------------------------------------------
  _tmp_guard_expect DENY 'echo a | tee /tmp/x'
  _tmp_guard_expect DENY 'echo a | tee -a /tmp/x'
  _tmp_guard_expect DENY 'echo a | tee ~/ok /tmp/z' 'tee with the root as the second operand'
  _tmp_guard_expect DENY 'echo a | tee /tmp/a /tmp/b'
  _tmp_guard_expect DENY 'echo a | sudo tee /tmp/x'
  _tmp_guard_expect PASS 'echo a | tee ~/x'
  _tmp_guard_expect PASS 'echo a | tee'

  # --- Bash: mkdir / touch / cp / mv / ln / install / rsync / ditto ---------
  _tmp_guard_expect DENY 'mkdir /tmp/x'
  _tmp_guard_expect DENY 'mkdir -p /tmp/a/b'
  _tmp_guard_expect DENY 'mkdir -p ~/ok /tmp/x' 'mkdir with the root as the second operand'
  _tmp_guard_expect DENY 'mkdir -m 755 /tmp/x'
  _tmp_guard_expect DENY 'mkdir /tmp/a /tmp/b'
