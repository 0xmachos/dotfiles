  _tmp_guard_expect PASS "${hd}" 'unterminated heredoc, non-shell consumer: rest is data'
  hd=$'bash <<EOF\ncp a /tmp/b'
  _tmp_guard_expect DENY "${hd}" 'unterminated heredoc, shell consumer: body scanned'
  _tmp_guard_expect PASS 'cat <<< x' 'here-string opens no body'
  _tmp_guard_expect DENY 'cat <<< x > /tmp/y' 'redirect after a here-string'
  hd=$'bash 2>&1 <<EOF\ntouch /tmp/x\nEOF'
  _tmp_guard_expect DENY "${hd}" 'consumer behind 2>&1'
  hd=$'bash <<A <<B\necho hi\nA\ntouch /tmp/x\nB'
  _tmp_guard_expect DENY "${hd}" 'second heredoc of the same consumer'
  hd=$'docker exec -i c sh <<EOF\ntouch /tmp/x\nEOF'
  _tmp_guard_expect PASS "${hd}" 'docker exec sh heredoc: accepted gap'

  # --- Multi-line messages: quotes, substitutions and heredocs carry across lines
  # A commit or PR body that names a write verb and a root is data.
  hd=$'git commit -m "$(cat <<\'EOF\'\ntmp-guard: deny writes under /tmp\n\nmkdir /tmp/x is now refused; cat /tmp/x still passes.\nEOF\n)"'
  _tmp_guard_expect PASS "${hd}" 'commit body line that starts with a write verb'
  hd=$'git commit -m "$(cat <<\'EOF\'\nAdd the tmp guard\n\n- mkdir /tmp/x: denied\n- cat /tmp/x: allowed\nEOF\n)"'
  _tmp_guard_expect PASS "${hd}" 'commit body bullets'
  hd=$'git commit -m "$(cat <<\'EOF\'\nAdd the tmp guard\n\n  touch /tmp/x  -> denied\nEOF\n)"'
  _tmp_guard_expect PASS "${hd}" 'commit body, indented verb line'
  hd=$'git commit -m "$(cat <<\'EOF\'\nsubject\n\ntee /tmp/x is blocked\nEOF\n)"'
  _tmp_guard_expect PASS "${hd}" 'commit body, tee line'
  hd=$'git commit -m "$(cat <<\'EOF\'\nsubject\n\ncurl -o /tmp/x is blocked\nEOF\n)"'
  _tmp_guard_expect PASS "${hd}" 'commit body, curl line'
  hd=$'git commit -m "$(cat <<\'EOF\'\nsubject\n\ncp a /tmp/b\nEOF\n)"'
  _tmp_guard_expect PASS "${hd}" 'commit body, cp line'
  hd=$'git commit -m "$(cat <<\'EOF\'\nsubject\n\ngit clone url /tmp/x is blocked\nEOF\n)"'
  _tmp_guard_expect PASS "${hd}" 'commit body, git clone line'
  hd=$'git commit -m "$(cat <<\'EOF\'\nsubject\n\ncd /tmp && make no longer works\nEOF\n)"'
  _tmp_guard_expect PASS "${hd}" 'commit body, cd line'
  hd=$'git commit -m "$(cat <<EOF\nsubject\n\nmkdir /tmp/x is refused\nEOF\n)"'
  _tmp_guard_expect PASS "${hd}" 'commit body, unquoted delimiter'
  hd=$'git commit -S -m "$(cat <<\'EOF\'\nsubject\n\nmkdir /tmp/x is refused\nEOF\n)" -- tests/tmp-guard'
  _tmp_guard_expect PASS "${hd}" 'commit body followed by a pathspec'
  hd=$'git commit -m "$(cat <<\'EOF\'\nit\'s a body ) with ( unbalanced \\" marks\nmkdir /tmp/x\nEOF\n)"'
  _tmp_guard_expect PASS "${hd}" 'apostrophe, parentheses and a quote in the body'
  hd=$'gh pr create --title t --body "$(cat <<\'EOF\'\n## Summary\n\n- mkdir /tmp/x: denied\nEOF\n)"'
  _tmp_guard_expect PASS "${hd}" 'gh pr create body'
  hd=$'gh issue comment 1 --body "$(cat <<\'EOF\'\ntouch /tmp/x still works here\nEOF\n)"'
  _tmp_guard_expect PASS "${hd}" 'gh issue comment body'
  hd=$'MSG="$(cat <<\'EOF\'\nmkdir /tmp/x\nEOF\n)"; git commit -m "$MSG"'
  _tmp_guard_expect PASS "${hd}" 'variable assigned from a heredoc substitution'
  hd=$'echo "$(cat <<\'EOF\'\nmkdir /tmp/x\nEOF\n)"'
  _tmp_guard_expect PASS "${hd}" 'echo of a heredoc substitution'
  hd=$'jq -n --arg c "$(cat <<\'EOF\'\nmkdir /tmp/x\nEOF\n)" \'{c:$c}\''
  _tmp_guard_expect PASS "${hd}" 'jq --arg from a heredoc substitution'
  hd=$'git commit -F <(cat <<\'EOF\'\nmkdir /tmp/x\nEOF\n)'
  _tmp_guard_expect PASS "${hd}" 'heredoc inside a process substitution'
  hd=$'cat <<\'EOF\' | git commit -F -\nmkdir /tmp/x\nEOF'
  _tmp_guard_expect PASS "${hd}" 'heredoc piped to commit -F -'
  hd=$'git commit -m "subject\n\ntouch /tmp/x"'
  _tmp_guard_expect PASS "${hd}" 'verb line inside a multi-line double-quoted -m'
  hd=$'git commit -m \'subject\n\ntouch /tmp/x\''
  _tmp_guard_expect PASS "${hd}" 'verb line inside a multi-line single-quoted -m'
  hd=$'echo "a\nmkdir /tmp/x"'
  _tmp_guard_expect PASS "${hd}" 'multi-line double-quoted echo argument'
  hd=$'echo $\'a\nmkdir /tmp/x\''
  _tmp_guard_expect PASS "${hd}" 'multi-line ANSI-C quoted argument'
  hd=$'python3 -c "\nimport os\nopen(\'/tmp/x\', \'w\')\n"'
  _tmp_guard_expect PASS "${hd}" 'multi-line python -c program'
  hd=$'echo ${x:-a\nmkdir /tmp/y}'
  _tmp_guard_expect PASS "${hd}" 'newline inside a parameter expansion'
  hd=$'echo \\\nhi'
  _tmp_guard_expect PASS "${hd}" 'backslash-newline continuation of a harmless command'
  # A write outside the message still counts.
