  _tmp_guard_expect DENY 'wget --output-document=/tmp/x url'
  _tmp_guard_expect DENY 'wget --directory-prefix /tmp url'
  _tmp_guard_expect PASS 'wget -O ~/x url'
  _tmp_guard_expect PASS 'wget -O - url'
  _tmp_guard_expect DENY 'tar -xzf a.tgz -C /tmp/x'
  _tmp_guard_expect DENY 'tar xzf a.tgz -C /tmp'
