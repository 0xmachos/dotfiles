  _tmp_guard_expect PASS 'cd /tmp && cp x "$(mktemp -d)/y"' 'destination from a substitution'
  _tmp_guard_expect PASS 'cd /tmp; cd ~/repo; echo hi > out' 'later cd to a non-root clears'
