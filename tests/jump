#!/bin/zsh
# dotfiles/tests/jump
#
# Pins jump-user and jump-system: connectivity checks, binary detection,
# logging, and the launchd-path rules below.
#
# ShellCheck: lint with `shellcheck --shell=bash tests/jump`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

function _jump_test_scripts_exist {
  _section "script existence"

  local bindir="bin"

  if [[ -x "${bindir}/jump-user" ]]; then
    _pass "jump-user is executable"
  else
    _fail "jump-user missing or not executable"
  fi

  if [[ -x "${bindir}/jump-system" ]]; then
    _pass "jump-system is executable"
  else
    _fail "jump-system missing or not executable"
  fi

  if [[ -x "${bindir}/npm-audit-check" ]]; then
    _pass "npm-audit-check is executable"
  else
    _fail "npm-audit-check missing or not executable"
  fi
}

# Real connectivity gate against scutil fixtures: no network or updater runs.
# The optional command argument keeps main's fixed /usr/sbin/scutil intact.
function _jump_test_reachability {
  _section "reachability (real functions, offline fixtures)"

  local fixture
  fixture="$(mktemp -d "${TMPDIR}test-jump-reachability.XXXXXX")"
  cat > "${fixture}/scutil" <<'MOCK'
#!/bin/zsh
print -r -- "$2" >> "${JUMP_TEST_CALLS}"
if [[ "$2" == "${JUMP_TEST_REACHABLE_DOMAIN}" ]]; then
  print -r -- "${JUMP_TEST_OUTPUT}"
  exit "${JUMP_TEST_STATUS}"
fi
print -r -- 'Not Reachable'
MOCK
  chmod 700 "${fixture}/scutil"

  local script name output expected_calls expected_rc actual
  local -a calls
  local -a formats=(
    'Reachable' 'Reachable,Transient Connection' 'Reachable,Direct'
    'Reachable,Directly Reachable Address' 'Not Reachable' '' 'Transient Connection'
  )
  local reachable_domain probe_status
  for script in bin/jump-user bin/jump-system; do
    name="${script##*/}"
    # First-host success, rejection, fallback success, and a failed scutil
    # that printed Reachable before exiting.
    for output in "${formats[@]}" fallback command-error; do
      reachable_domain=captive.apple.com
      probe_status=0
      expected_calls=1
      expected_rc=0
      case "${output}" in
        'Not Reachable'|''|'Transient Connection')
          expected_calls=3; expected_rc=1 ;;
        fallback)
          reachable_domain=google.com; expected_calls=2 ;;
        command-error)
          probe_status=7; expected_calls=3; expected_rc=1 ;;
      esac
      : > "${fixture}/calls"
      : > "${fixture}/log"
      # shellcheck disable=SC1090,SC1091,SC2034,SC2329
      actual=$(
        set +e
        source <(/usr/bin/grep -v '^main "\$@"' "${script}")
        export JUMP_TEST_CALLS="${fixture}/calls"
        export JUMP_TEST_REACHABLE_DOMAIN="${reachable_domain}"
        export JUMP_TEST_STATUS="${probe_status}"
        export JUMP_TEST_OUTPUT="${output}"
        [[ "${output}" == fallback || "${output}" == command-error ]] && JUMP_TEST_OUTPUT=Reachable
        logger() { print -r -- "$*" >> "${fixture}/log"; }
        check_internet_connection "${fixture}/scutil"
        print -r -- "$?"
      )
      # shellcheck disable=SC2296  # zsh newline split
      calls=("${(@f)$(<"${fixture}/calls")}")
      if [[ "${actual}" == "${expected_rc}" ]] && (( ${#calls[@]} == expected_calls )); then
        _pass "${name}: '${output:-<empty>}' returns ${expected_rc} after ${expected_calls} probe(s)"
      else
        _fail "${name}: '${output:-<empty>}' returned ${actual} after ${#calls[@]} probe(s)"
      fi
      if (( expected_rc )); then
        if [[ "$(<"${fixture}/log")" == *'[FAIL]'* ]]; then
          _pass "${name}: failed reachability logs its failure"
        else
          _fail "${name}: failed reachability did not log its failure"
        fi
      elif [[ -s "${fixture}/log" ]]; then
        _fail "${name}: successful reachability logged a failure"
      fi
    done
  done
  /bin/rm -rf "${fixture}"
}

# Every *_BINARY/*_APP path the scripts declare exists. Derived from the
# scripts, not listed here: a parallel list drifts silently.
function _jump_test_binary_paths {
  _section "binary paths (derived from scripts)"

  # brew is the one hard requirement: jump-user aborts without it
  if [[ -x "/opt/homebrew/bin/brew" ]]; then
    _pass "brew exists at /opt/homebrew/bin/brew"
  else
    _fail "brew not found at /opt/homebrew/bin/brew"
  fi

  local -a scripts=(bin/jump-user bin/jump-system bin/npm-audit-check .functions/jump)
  local -A seen=()
  local line name path
  while IFS= read -r line; do
    name="${line%%=*}"
    name="${name##* }"
    path="${line#*=}"
    path="${path#\"}"
    path="${path%\"}"
    path="${path//\$\{HOME\}/${HOME}}"
    if [[ -n "${seen[${path}]:-}" ]]; then
      continue
    fi
    seen[${path}]=1
    if [[ -x "${path}" ]]; then
      _pass "${name} exists at ${path}"
    else
      _skip "${name} not found at ${path}"
    fi
  done < <(/usr/bin/grep -hoE '(local -r|readonly) [A-Z_]+(_BINARY|_APP)="[^"]+"' "${scripts[@]}" | /usr/bin/sort -u)

  if (( ${#seen[@]} == 0 )); then
    _fail "no *_BINARY declarations extracted — pattern or scripts changed"
  fi
}

# zsh -n: the shellcheck suite lints in bash mode and misses zsh-only errors.
function _jump_test_zsh_syntax {
  _section "zsh syntax"

  local script
  for script in bin/jump-user bin/jump-system bin/npm-audit-check; do
    if /bin/zsh -n "${script}" 2>/dev/null; then
      _pass "${script} parses (zsh -n)"
    else
      _fail "${script} has zsh syntax errors"
    fi
  done

  if /bin/zsh -c 'source .functions/jump && typeset -f jump >/dev/null' 2>/dev/null; then
    _pass ".functions/jump sources and defines jump()"
  else
    _fail ".functions/jump failed to source or define jump()"
  fi
}

function _jump_test_log_file {
  _section "log file"

  local log_file="${HOME}/Library/Logs/jump.log"

  if [[ -f "${log_file}" ]]; then
    _pass "jump.log exists"
  else
    _skip "jump.log not found (no failures logged yet)"
    return
  fi

  # jump-user's log; jump-system writes to /var/log. A root-owned file left
  # by the retired shared-log setup can still block jump-user's appends.
  if [[ -w "${log_file}" ]]; then
    _pass "jump.log is writable by the console user"
  else
    _fail "jump.log not writable by console user — jump-user appends are dropped"
  fi
}

# The real run_and_log from each driver; asserts the RETURN CODE, not just the
# log side effect, so a swallowed non-zero exit is caught.
function _jump_test_run_and_log {
  _section "run_and_log (real functions)"

  local script name test_log rc_true rc_false
  for script in bin/jump-system bin/jump-user; do
    name="${script##*/}"
    test_log="${TMPDIR}test-jump-$$-${name}.log"
    /bin/rm -f "${test_log}"

    # Sourced without `main "$@"`, in a subshell so definitions don't leak.
    # `set +e`: the runner uses `set -e` and the failure case returns non-zero
    # on purpose, which would abort the subshell before `echo "$?"`.
    # SC2034: LOG_FILE is read by the sourced run_and_log; SC1090/SC1091:
    # dynamic process-substitution source.
    # shellcheck disable=SC1090,SC1091,SC2034
    rc_true=$(set +e; source <(/usr/bin/grep -v '^main "\$@"' "${script}"); LOG_FILE="${test_log}"; run_and_log "ok step" /usr/bin/true >/dev/null 2>&1; echo "$?")
    if [[ "${rc_true}" == "0" ]]; then
      _pass "${name}: run_and_log returns 0 on success"
    else
      _fail "${name}: run_and_log returned '${rc_true}' on success (expected 0)"
    fi
    if [[ ! -f "${test_log}" ]] || ! grep -q "ok step" "${test_log}" 2>/dev/null; then
      _pass "${name}: success does not write to log file"
    else
      _fail "${name}: success should not write to log file"
    fi

    # shellcheck disable=SC1090,SC1091,SC2034
    rc_false=$(set +e; source <(/usr/bin/grep -v '^main "\$@"' "${script}"); LOG_FILE="${test_log}"; run_and_log "bad step" /usr/bin/false >/dev/null 2>&1; echo "$?")
    if [[ "${rc_false}" != "0" ]]; then
      _pass "${name}: run_and_log returns non-zero on failure"
    else
      _fail "${name}: run_and_log swallowed the failure (returned 0)"
    fi
    if grep -q "FAIL.*bad step" "${test_log}" 2>/dev/null; then
      _pass "${name}: failure writes [FAIL] to log file"
    else
      _fail "${name}: failure should write [FAIL] to log file"
    fi

    /bin/rm -f "${test_log}"
  done
}

# The launchd-path tests guard a class: a launchd program resolving under
# ~/Documents/ cannot be exec'd once the TCC grant resets. launchd reports a
# bare 127 (same as "command not found") and the program dies before logging.
# Hit by jump-user 2026-07-28 (5 runs, 5 failures, 0 log lines) via
# /usr/local/bin/jump-user symlinked into the repo.

# Static half: edit-time, needs nothing installed (fresh clone is fine).
function _jump_test_launchd_not_in_symlink_array {
  _section "launchd programs vs install_scripts symlink array"

  local raw
  # `|| true` is load-bearing: under the dispatcher's `set -e` a non-matching
  # grep would abort the whole run, later suites silently skipped.
  raw=$(/usr/bin/grep -oE 'local -ar bin_files=\([^)]*\)' bittersweet 2>/dev/null || true)
  if [[ -z "${raw}" ]]; then
    _fail "could not extract bin_files from bittersweet — pattern changed"
    return
  fi
  raw="${raw#*\(}"
  raw="${raw%\)}"
  # SC2296/SC2206: zsh word-splitting flag, not valid bash.
  # shellcheck disable=SC2296,SC2206
  local -a bin_files=(${=raw})

  local plist prog base
  for plist in LaunchAgents/*.plist LaunchDaemons/*.plist; do
    [[ -f "${plist}" ]] || continue
    prog=$(/usr/libexec/PlistBuddy -c "Print :ProgramArguments:0" "${plist}" 2>/dev/null) || continue
    base="${prog##*/}"
    if (( ${bin_files[(Ie)${base}]} )); then
      _fail "${plist##*/}: ${base} is launchd-invoked but in install_scripts' symlink array — must be copied, not symlinked"
    else
      _pass "${plist##*/}: ${base} not in the symlink array"
    fi
  done
}

# Live half: installed-state drift, e.g. a stale symlink from a bittersweet
# run that predates the copy change.
function _jump_test_launchd_program_outside_documents {
  _section "launchd programs resolve outside ~/Documents"

  local plist prog real
  local -i checked=0
  for plist in LaunchAgents/*.plist LaunchDaemons/*.plist; do
    [[ -f "${plist}" ]] || continue
    prog=$(/usr/libexec/PlistBuddy -c "Print :ProgramArguments:0" "${plist}" 2>/dev/null) || continue
    if [[ ! -e "${prog}" ]]; then
      _skip "${plist##*/}: ${prog} not installed"
      continue
    fi
    checked+=1
    # SC2296: zsh :A resolves symlinks, not valid bash.
    # shellcheck disable=SC2296
    real="${prog:A}"
    if [[ "${real}" == "${HOME}/Documents/"* ]]; then
      _fail "${plist##*/}: ${prog} resolves to ${real} — under ~/Documents, launchd exec fails with 127"
    else
      _pass "${plist##*/}: ${prog} resolves outside ~/Documents"
    fi
  done

  if (( checked == 0 )); then
    _skip "no launchd programs installed to check"
  fi
}

# argv[0] is the exec target and must never sit under ~/Documents (the hard
# failure above). Later arguments are payloads for an interpreter, e.g.
# /bin/zsh -c '... retrieval-metrics.py': a READ, not an exec, so no 127. They
# rely on the interpreter's Documents grant and hang on an invisible consent
# dialog when it resets. Reported, not failed: the /bin/zsh wrapper is
# deliberate.
function _jump_test_launchd_payloads_under_documents {
  _section "launchd payload paths under ~/Documents (informational)"

  local plist args tok
  local -i found=0
  for plist in LaunchAgents/*.plist LaunchDaemons/*.plist; do
    [[ -f "${plist}" ]] || continue
    args=$(/usr/libexec/PlistBuddy -c "Print :ProgramArguments" "${plist}" 2>/dev/null | /usr/bin/sed '1d;$d' || true)
    [[ -n "${args}" ]] || continue
    # SC2296/SC2206: zsh word-splitting flag, not valid bash.
    # shellcheck disable=SC2296,SC2206
    for tok in ${=args}; do
      [[ "${tok}" == "${HOME}/Documents/"* ]] || continue
      found+=1
      _skip "${plist##*/}: payload ${tok##*/} is under ~/Documents — relies on the interpreter's Documents grant"
    done
  done

  if (( found == 0 )); then
    _pass "no launchd payload paths under ~/Documents"
  fi
}

# Copies go stale silently: a repo edit does not reach /usr/local/bin until
# the next `bittersweet scripts` (2026-07-29: deployed jump-user missed a guard
# committed minutes earlier).
function _jump_test_copied_programs_current {
  _section "copied launchd programs match their repo source"

  local -a copied=(jump-user jump-system)
  local name src installed
  for name in "${copied[@]}"; do
    src="bin/${name}"
    installed="/usr/local/bin/${name}"
    if [[ ! -f "${src}" ]]; then
      _fail "${src} missing from repo"
    elif [[ ! -e "${installed}" ]]; then
      _skip "${name}: not installed at ${installed}"
    elif [[ -L "${installed}" ]]; then
      _fail "${name}: ${installed} is a symlink — must be a copy, launchd cannot exec under ~/Documents"
    elif [[ ! -r "${installed}" ]]; then
      # jump-system is deliberately root:wheel 700; not a failure.
      _skip "${name}: ${installed} not readable by this user"
    elif cmp -s "${src}" "${installed}"; then
      _pass "${name}: deployed copy matches ${src}"
    else
      _fail "${name}: deployed copy is STALE vs ${src} — re-run 'bittersweet scripts'"
    fi
  done
}

# Unwritable-log branch (2026-07-28). `logger` is shadowed by a function so
# the syslog call is captured.
function _jump_test_run_and_log_unwritable {
  _section "run_and_log reports an unwritable log"

  local script name locked capture rc
  for script in bin/jump-system bin/jump-user; do
    name="${script##*/}"
    locked="${TMPDIR}test-jump-$$-${name}-locked.log"
    capture="${TMPDIR}test-jump-$$-${name}-logger.txt"
    /bin/rm -f "${locked}" "${capture}"
    : > "${locked}"
    chmod 444 "${locked}"

    # SC1090/SC1091: dynamic source. SC2034: LOG_FILE is read by the sourced
    # function. SC2329: the logger shim is invoked only from the sourced
    # run_and_log, which shellcheck cannot follow.
    # shellcheck disable=SC1090,SC1091,SC2034,SC2329
    rc=$(set +e; source <(/usr/bin/grep -v '^main "\$@"' "${script}"); LOG_FILE="${locked}"; logger() { echo "$@" >> "${capture}"; }; run_and_log "bad step" /usr/bin/false >/dev/null 2>&1; echo "$?")

    if [[ "${rc}" != "0" ]]; then
      _pass "${name}: preserves the command's exit code when the log is unwritable"
    else
      _fail "${name}: swallowed the failure (returned 0) when the log was unwritable"
    fi

    if grep -q "cannot write" "${capture}" 2>/dev/null; then
      _pass "${name}: reports the failed log write to syslog"
    else
      _fail "${name}: failed log write was silent — detail lost with no signal"
    fi

    chmod 644 "${locked}"
    /bin/rm -f "${locked}" "${capture}"
  done
}

function run_jump {
  _jump_test_scripts_exist
  _jump_test_zsh_syntax
  _jump_test_reachability
  _jump_test_binary_paths
  _jump_test_log_file
  _jump_test_run_and_log
  _jump_test_run_and_log_unwritable
  _jump_test_launchd_not_in_symlink_array
  _jump_test_launchd_program_outside_documents
  _jump_test_launchd_payloads_under_documents
  _jump_test_copied_programs_current
}
