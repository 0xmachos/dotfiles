#!/bin/zsh
# dotfiles/tests/jump
#
# Tests for jump-user and jump-system scripts. Verifies internet
# connectivity checks, binary detection, and logging behaviour.
#
# ShellCheck: lint with `shellcheck --shell=bash tests/jump`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

function _jump_test_scripts_exist {
  _section "script existence"

  local bindir="bin"

  if [[ -x "${bindir}/jump-user" ]]; then
    _pass "jump-user is executable"
  else
    _fail "jump-user missing or not executable"
  fi

  if [[ -x "${bindir}/jump-system" ]]; then
    _pass "jump-system is executable"
  else
    _fail "jump-system missing or not executable"
  fi

  if [[ -x "${bindir}/npm-audit-check" ]]; then
    _pass "npm-audit-check is executable"
  else
    _fail "npm-audit-check missing or not executable"
  fi
}

function _jump_test_shellcheck {
  _section "shellcheck (jump scripts)"

  if ! command -v shellcheck >/dev/null 2>&1; then
    _skip "shellcheck not installed"
    return
  fi

  local bindir="bin"
  local script output
  for script in jump-user jump-system npm-audit-check; do
    if output=$(shellcheck --shell=bash "${bindir}/${script}" 2>&1); then
      _pass "${script} passes shellcheck"
    else
      _fail "${script} shellcheck errors: ${output}"
    fi
  done
}

# Verifies the grep pattern matches all known scutil -r output formats
function _jump_test_reachability_patterns {
  _section "reachability pattern"

  # root returns "Reachable", user returns "Reachable,Transient Connection"
  local -a reachable_outputs=(
    "Reachable"
    "Reachable,Transient Connection"
    "Reachable,Direct"
    "Reachable,Directly Reachable Address"
  )
  local -a unreachable_outputs=(
    "Not Reachable"
    ""
    "Transient Connection"
  )

  local pattern='^Reachable'

  local output
  for output in "${reachable_outputs[@]}"; do
    if echo "${output}" | grep "${pattern}" >/dev/null 2>&1; then
      _pass "pattern matches: '${output}'"
    else
      _fail "pattern should match: '${output}'"
    fi
  done

  # Live check: verify pattern matches this system's actual scutil output
  local live_output
  live_output="$(/usr/sbin/scutil -r "captive.apple.com" 2>&1)"
  if echo "${live_output}" | grep "${pattern}" >/dev/null 2>&1; then
    _pass "live scutil output matches: '${live_output}'"
  else
    _fail "live scutil output rejected: '${live_output}'"
  fi

  for output in "${unreachable_outputs[@]}"; do
    if echo "${output}" | grep "${pattern}" >/dev/null 2>&1; then
      _fail "pattern should NOT match: '${output}'"
    else
      _pass "pattern rejects: '${output:-<empty>}'"
    fi
  done
}

# Verifies every *_BINARY/*_APP path declared in the jump-suite scripts
# exists on this system. The list is derived from the scripts themselves
# rather than hand-maintained here — a parallel list drifts silently when
# a script gains a new updater.
function _jump_test_binary_paths {
  _section "binary paths (derived from scripts)"

  # brew is the one hard requirement — jump-user aborts without it
  if [[ -x "/opt/homebrew/bin/brew" ]]; then
    _pass "brew exists at /opt/homebrew/bin/brew"
  else
    _fail "brew not found at /opt/homebrew/bin/brew"
  fi

  local -a scripts=(bin/jump-user bin/jump-system bin/npm-audit-check .functions/jump)
  local -A seen=()
  local line name path
  while IFS= read -r line; do
    name="${line%%=*}"
    name="${name##* }"
    path="${line#*=}"
    path="${path#\"}"
    path="${path%\"}"
    path="${path//\$\{HOME\}/${HOME}}"
    if [[ -n "${seen[${path}]:-}" ]]; then
      continue
    fi
    seen[${path}]=1
    if [[ -x "${path}" ]]; then
      _pass "${name} exists at ${path}"
    else
      _skip "${name} not found at ${path}"
    fi
  done < <(/usr/bin/grep -hoE '(local -r|readonly) [A-Z_]+(_BINARY|_APP)="[^"]+"' "${scripts[@]}" | /usr/bin/sort -u)

  if (( ${#seen[@]} == 0 )); then
    _fail "no *_BINARY declarations extracted — pattern or scripts changed"
  fi
}

# Verifies the scripts parse under real zsh — the shellcheck suite lints in
# bash mode, which cannot catch zsh-only syntax errors.
function _jump_test_zsh_syntax {
  _section "zsh syntax"

  local script
  for script in bin/jump-user bin/jump-system bin/npm-audit-check; do
    if /bin/zsh -n "${script}" 2>/dev/null; then
      _pass "${script} parses (zsh -n)"
    else
      _fail "${script} has zsh syntax errors"
    fi
  done

  if /bin/zsh -c 'source .functions/jump && typeset -f jump >/dev/null' 2>/dev/null; then
    _pass ".functions/jump sources and defines jump()"
  else
    _fail ".functions/jump failed to source or define jump()"
  fi
}

function _jump_test_log_file {
  _section "log file"

  local log_file="${HOME}/Library/Logs/jump.log"

  if [[ -f "${log_file}" ]]; then
    _pass "jump.log exists"
  else
    _skip "jump.log not found (no failures logged yet)"
    return
  fi

  # This is the SHARED log: jump-system (root) and jump-user (the console user)
  # both append to it. Root writes it regardless of owner, so only the user's
  # access is ever in question — a root-owned file silently drops every
  # jump-user append. The previous assertion accepted uid 0 here and therefore
  # passed for the whole time that bug was live (found 2026-07-28).
  if [[ -w "${log_file}" ]]; then
    _pass "jump.log is writable by the console user"
  else
    _fail "jump.log not writable by console user — jump-user appends are dropped"
  fi
}

# Exercises the REAL run_and_log from each driver and asserts its RETURN CODE,
# not just the log side-effect. The previous version reimplemented the function
# body inline and only checked the log file, so it could not have caught a
# run_and_log that swallowed a non-zero exit — the exact B1/B2 exit-swallow bug.
function _jump_test_run_and_log {
  _section "run_and_log (real functions)"

  local script name test_log rc_true rc_false
  for script in bin/jump-system bin/jump-user; do
    name="${script##*/}"
    test_log="${TMPDIR}test-jump-$$-${name}.log"
    /bin/rm -f "${test_log}"

    # Source the real function without triggering `main "$@"`, in a subshell so
    # its definitions don't leak into the test shell, and capture the code it
    # returns. `set +e` because the runner (test) uses `set -e` and the failure
    # case below runs a command that returns non-zero on purpose — without it
    # the subshell would abort before `echo "$?"`. LOG_FILE is redirected to a
    # temp file the failure branch appends.
    # SC2034: LOG_FILE is read by the sourced run_and_log; SC1090/SC1091: the
    # source target is a dynamic process substitution.
    # shellcheck disable=SC1090,SC1091,SC2034
    rc_true=$(set +e; source <(/usr/bin/grep -v '^main "\$@"' "${script}"); LOG_FILE="${test_log}"; run_and_log "ok step" /usr/bin/true >/dev/null 2>&1; echo "$?")
    if [[ "${rc_true}" == "0" ]]; then
      _pass "${name}: run_and_log returns 0 on success"
    else
      _fail "${name}: run_and_log returned '${rc_true}' on success (expected 0)"
    fi
    if [[ ! -f "${test_log}" ]] || ! grep -q "ok step" "${test_log}" 2>/dev/null; then
      _pass "${name}: success does not write to log file"
    else
      _fail "${name}: success should not write to log file"
    fi

    # shellcheck disable=SC1090,SC1091,SC2034
    rc_false=$(set +e; source <(/usr/bin/grep -v '^main "\$@"' "${script}"); LOG_FILE="${test_log}"; run_and_log "bad step" /usr/bin/false >/dev/null 2>&1; echo "$?")
    if [[ "${rc_false}" != "0" ]]; then
      _pass "${name}: run_and_log returns non-zero on failure"
    else
      _fail "${name}: run_and_log swallowed the failure (returned 0)"
    fi
    if grep -q "FAIL.*bad step" "${test_log}" 2>/dev/null; then
      _pass "${name}: failure writes [FAIL] to log file"
    else
      _fail "${name}: failure should write [FAIL] to log file"
    fi

    /bin/rm -f "${test_log}"
  done
}

# The two launchd-path tests below guard a class, not an instance: a program
# invoked by launchd that resolves under ~/Documents/ cannot be exec'd once the
# TCC grant resets. launchd reports a bare 127 — indistinguishable from
# "command not found" — and the program dies before it can log anything, so the
# failure is near-silent. Hit live by jump-user 2026-07-28 (5 runs, 5 failures,
# 0 log lines) via /usr/local/bin/jump-user symlinked into the repo.
# These generalise past jump; promote to their own suite when `test` is free to
# edit (its SUITES array is hardcoded).

# Static half: catches reintroduction at edit time, needs nothing installed, so
# it works on a fresh clone or an unprovisioned machine.
function _jump_test_launchd_not_in_symlink_array {
  _section "launchd programs vs install_scripts symlink array"

  local raw
  # `|| true` is load-bearing: the dispatcher runs under `set -e`, so a
  # non-matching grep would abort the entire run — every later suite silently
  # skipped — and the _fail below could never report the drift it exists for.
  raw=$(/usr/bin/grep -oE 'local -ar bin_files=\([^)]*\)' bittersweet 2>/dev/null || true)
  if [[ -z "${raw}" ]]; then
    _fail "could not extract bin_files from bittersweet — pattern changed"
    return
  fi
  raw="${raw#*\(}"
  raw="${raw%\)}"
  # SC2296/SC2206: zsh word-splitting flag, not valid bash.
  # shellcheck disable=SC2296,SC2206
  local -a bin_files=(${=raw})

  local plist prog base
  for plist in LaunchAgents/*.plist LaunchDaemons/*.plist; do
    [[ -f "${plist}" ]] || continue
    prog=$(/usr/libexec/PlistBuddy -c "Print :ProgramArguments:0" "${plist}" 2>/dev/null) || continue
    base="${prog##*/}"
    if (( ${bin_files[(Ie)${base}]} )); then
      _fail "${plist##*/}: ${base} is launchd-invoked but in install_scripts' symlink array — must be copied, not symlinked"
    else
      _pass "${plist##*/}: ${base} not in the symlink array"
    fi
  done
}

# Live half: catches installed-state drift the static check cannot see, e.g. a
# stale symlink left by a bittersweet run that predates the copy change.
function _jump_test_launchd_program_outside_documents {
  _section "launchd programs resolve outside ~/Documents"

  local plist prog real
  local -i checked=0
  for plist in LaunchAgents/*.plist LaunchDaemons/*.plist; do
    [[ -f "${plist}" ]] || continue
    prog=$(/usr/libexec/PlistBuddy -c "Print :ProgramArguments:0" "${plist}" 2>/dev/null) || continue
    if [[ ! -e "${prog}" ]]; then
      _skip "${plist##*/}: ${prog} not installed"
      continue
    fi
    checked+=1
    # SC2296: zsh :A resolves symlinks, not valid bash.
    # shellcheck disable=SC2296
    real="${prog:A}"
    if [[ "${real}" == "${HOME}/Documents/"* ]]; then
      _fail "${plist##*/}: ${prog} resolves to ${real} — under ~/Documents, launchd exec fails with 127"
    else
      _pass "${plist##*/}: ${prog} resolves outside ~/Documents"
    fi
  done

  if (( checked == 0 )); then
    _skip "no launchd programs installed to check"
  fi
}

# argv[0] is the exec target and must never sit under ~/Documents — that is the
# hard failure above. Later arguments are payloads handed to an interpreter,
# e.g. second-brain-metrics runs /bin/zsh -c '... retrieval-metrics.py'. Those
# are a READ under ~/Documents rather than an exec, so they do not 127; they
# depend on the interpreter holding the Documents grant, and when that grant
# resets they fail by hanging on an invisible consent dialog instead. Reported,
# not failed, because the /bin/zsh wrapper is a deliberate design choice here.
function _jump_test_launchd_payloads_under_documents {
  _section "launchd payload paths under ~/Documents (informational)"

  local plist args tok
  local -i found=0
  for plist in LaunchAgents/*.plist LaunchDaemons/*.plist; do
    [[ -f "${plist}" ]] || continue
    args=$(/usr/libexec/PlistBuddy -c "Print :ProgramArguments" "${plist}" 2>/dev/null | /usr/bin/sed '1d;$d' || true)
    [[ -n "${args}" ]] || continue
    # SC2296/SC2206: zsh word-splitting flag, not valid bash.
    # shellcheck disable=SC2296,SC2206
    for tok in ${=args}; do
      [[ "${tok}" == "${HOME}/Documents/"* ]] || continue
      found+=1
      _skip "${plist##*/}: payload ${tok##*/} is under ~/Documents — relies on the interpreter's Documents grant"
    done
  done

  if (( found == 0 )); then
    _pass "no launchd payload paths under ~/Documents"
  fi
}

# Copying rather than symlinking trades live-edit for silent staleness: a repo
# edit does not reach /usr/local/bin until the next `bittersweet scripts`.
# Caught live 2026-07-29 — the deployed jump-user was missing a guard that had
# been committed minutes earlier.
function _jump_test_copied_programs_current {
  _section "copied launchd programs match their repo source"

  local -a copied=(jump-user jump-system)
  local name src installed
  for name in "${copied[@]}"; do
    src="bin/${name}"
    installed="/usr/local/bin/${name}"
    if [[ ! -f "${src}" ]]; then
      _fail "${src} missing from repo"
    elif [[ ! -e "${installed}" ]]; then
      _skip "${name}: not installed at ${installed}"
    elif [[ -L "${installed}" ]]; then
      _fail "${name}: ${installed} is a symlink — must be a copy, launchd cannot exec under ~/Documents"
    elif [[ ! -r "${installed}" ]]; then
      # jump-system is deliberately root:wheel 700, so an unprivileged run
      # cannot read it to compare. Not a failure.
      _skip "${name}: ${installed} not readable by this user"
    elif cmp -s "${src}" "${installed}"; then
      _pass "${name}: deployed copy matches ${src}"
    else
      _fail "${name}: deployed copy is STALE vs ${src} — re-run 'bittersweet scripts'"
    fi
  done
}

# Exercises the branch added 2026-07-28. `logger` is shadowed by a shell
# function so the syslog call is captured rather than emitted. On the
# pre-hardening code the failed redirect was completely silent, so the
# "cannot write" assertion below fails there — which is the point.
function _jump_test_run_and_log_unwritable {
  _section "run_and_log reports an unwritable log"

  local script name locked capture rc
  for script in bin/jump-system bin/jump-user; do
    name="${script##*/}"
    locked="${TMPDIR}test-jump-$$-${name}-locked.log"
    capture="${TMPDIR}test-jump-$$-${name}-logger.txt"
    /bin/rm -f "${locked}" "${capture}"
    : > "${locked}"
    chmod 444 "${locked}"

    # SC1090/SC1091: dynamic source target. SC2034: LOG_FILE is read by the
    # sourced function. SC2329: the logger shim IS invoked, but only from the
    # sourced run_and_log, which shellcheck cannot follow — that indirection is
    # the whole mechanism of this test.
    # shellcheck disable=SC1090,SC1091,SC2034,SC2329
    rc=$(set +e; source <(/usr/bin/grep -v '^main "\$@"' "${script}"); LOG_FILE="${locked}"; logger() { echo "$@" >> "${capture}"; }; run_and_log "bad step" /usr/bin/false >/dev/null 2>&1; echo "$?")

    if [[ "${rc}" != "0" ]]; then
      _pass "${name}: preserves the command's exit code when the log is unwritable"
    else
      _fail "${name}: swallowed the failure (returned 0) when the log was unwritable"
    fi

    if grep -q "cannot write" "${capture}" 2>/dev/null; then
      _pass "${name}: reports the failed log write to syslog"
    else
      _fail "${name}: failed log write was silent — detail lost with no signal"
    fi

    chmod 644 "${locked}"
    /bin/rm -f "${locked}" "${capture}"
  done
}

function run_jump {
  _jump_test_scripts_exist
  _jump_test_shellcheck
  _jump_test_zsh_syntax
  _jump_test_reachability_patterns
  _jump_test_binary_paths
  _jump_test_log_file
  _jump_test_run_and_log
  _jump_test_run_and_log_unwritable
  _jump_test_launchd_not_in_symlink_array
  _jump_test_launchd_program_outside_documents
  _jump_test_launchd_payloads_under_documents
  _jump_test_copied_programs_current
}
