#!/bin/zsh
# dotfiles/tests/jump
#
# Pins jump-user and jump-system: the connectivity gate fails closed and logs,
# run_and_log keeps a failing command's exit code and reports an unwritable log,
# and the launchd-path rules below (a launchd program is copied, never
# symlinked, never resolves under ~/Documents, and the deployed copy is not
# stale).
#
# ShellCheck: lint with `shellcheck --shell=bash tests/jump`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

# Each driver's text without its trailing `main "$@"`, so a case can eval the functions in a subshell.
typeset -gA _JUMP_BODY=()
function _jump_load_bodies {
  local script
  local -a lines
  local main_call='main "$@"'
  for script in bin/jump-user bin/jump-system; do
    # shellcheck disable=SC2296  # zsh (@f) line split
    lines=("${(@f)$(<"${script}")}")
    # shellcheck disable=SC2296  # zsh array pattern removal
    _JUMP_BODY[${script}]="${(F)${(@)lines:#${main_call}*}}"
  done
}

# True when a line of file $1 matches glob $2 (grep -q on one line at a time).
function _jump_log_has {
  local line
  [[ -r "$1" ]] || return 1
  while IFS= read -r line || [[ -n "${line}" ]]; do
    # shellcheck disable=SC2053,SC2296  # zsh ${~} makes the glob in $2 live
    [[ "${line}" == ${~2} ]] && return 0
  done < "$1"
  return 1
}

# argv[0] and the payload for each launchd plist, from one PlistBuddy dump per plist.
typeset -ga _JUMP_PLISTS=()
typeset -gA _JUMP_PLIST_PROG=() _JUMP_PLIST_PAYLOAD=()
function _jump_load_plists {
  local plist dump
  local -a lines
  setopt local_options null_glob
  _JUMP_PLISTS=()
  _JUMP_PLIST_PROG=()
  _JUMP_PLIST_PAYLOAD=()
  for plist in LaunchAgents/*.plist LaunchDaemons/*.plist; do
    [[ -f "${plist}" ]] || continue
    # SC2034: dump is read by the zsh (@f) split below, which shellcheck cannot parse.
    # shellcheck disable=SC2034
    dump=$(/usr/libexec/PlistBuddy -c "Print :ProgramArguments" "${plist}" 2>/dev/null) || continue
    # shellcheck disable=SC2296  # zsh (@f) line split
    lines=("${(@f)dump}")
    # `Array {`, one 4-space-indented element per argument, `}`.
    (( ${#lines[@]} >= 3 )) || continue
    _JUMP_PLISTS+=("${plist}")
    _JUMP_PLIST_PROG[${plist}]="${lines[2]#    }"
    # shellcheck disable=SC2296  # zsh (F) join
    _JUMP_PLIST_PAYLOAD[${plist}]="${(F)lines[2,-2]}"
  done
}

# The launchd-path checks guard a class: a launchd program resolving under
# ~/Documents/ cannot be exec'd once the TCC grant resets. launchd reports a
# bare 127 (same as "command not found") and the program dies before logging.
# Hit by jump-user 2026-07-28 (5 runs, 5 failures, 0 log lines) via
# /usr/local/bin/jump-user symlinked into the repo.

function _jump_test_cases {
  zmodload -F zsh/files b:zf_rm b:zf_chmod
  _section "jump"

  local fixture rc actual log
  fixture="$(mktemp -d "${TMPDIR}test-jump.XXXXXX")"

  # 1. Real connectivity gate against a scutil fixture: a host that is Not
  #    Reachable fails closed after all three probes and logs [FAIL]. The
  #    optional command argument keeps main's fixed /usr/sbin/scutil intact.
  cat > "${fixture}/scutil" <<'MOCK'
#!/bin/zsh
print -r -- "$2" >> "${JUMP_TEST_CALLS}"
print -r -- 'Not Reachable'
MOCK
  zf_chmod 700 "${fixture}/scutil"
  : > "${fixture}/calls"
  : > "${fixture}/log"
  local -a calls
  # shellcheck disable=SC1090,SC1091,SC2034,SC2329
  actual=$(
    set +e
    eval "${_JUMP_BODY[bin/jump-user]}"
    export JUMP_TEST_CALLS="${fixture}/calls"
    logger() { print -r -- "$*" >> "${fixture}/log"; }
    check_internet_connection "${fixture}/scutil"
    print -r -- "$?"
  )
  # shellcheck disable=SC2296  # zsh newline split
  calls=("${(@f)$(<"${fixture}/calls")}")
  if [[ "${actual}" == 1 ]] && (( ${#calls[@]} == 3 )) && [[ "$(<"${fixture}/log")" == *'[FAIL]'* ]]; then
    _pass "jump-user: 'Not Reachable' returns 1 after 3 probes and logs its failure"
  else
    _fail "jump-user: 'Not Reachable' returned ${actual} after ${#calls[@]} probe(s)"
  fi

  # 2. run_and_log returns the failing command's code, not just the log side
  #    effect (a swallowed non-zero exit is caught), and writes [FAIL]. Evaled
  #    without `main "$@"`, in a subshell, with `set +e` so the non-zero return
  #    does not abort it before `echo "$?"`.
  log="${fixture}/run.log"
  # shellcheck disable=SC2034  # LOG_FILE is read by the evaled run_and_log
  rc=$(set +e; eval "${_JUMP_BODY[bin/jump-system]}"; LOG_FILE="${log}"; run_and_log "bad step" /usr/bin/false >/dev/null 2>&1; echo "$?")
  if [[ "${rc}" != "0" ]] && _jump_log_has "${log}" '*FAIL*bad step*'; then
    _pass "jump-system: run_and_log returns non-zero on failure and writes [FAIL] to the log"
  else
    _fail "jump-system: run_and_log returned '${rc}' on failure or wrote no [FAIL] line"
  fi

  # 3. Unwritable-log branch (2026-07-28). The exit code survives and the
  #    failed write reaches syslog. `logger` is shadowed to capture it.
  local locked="${fixture}/locked.log" capture="${fixture}/logger.txt"
  : > "${locked}"
  zf_chmod 444 "${locked}"
  # SC2034: LOG_FILE is read by the evaled function. SC2329: the logger shim is
  # invoked only from the evaled run_and_log, which shellcheck cannot follow.
  # shellcheck disable=SC2034,SC2329
  rc=$(set +e; eval "${_JUMP_BODY[bin/jump-user]}"; LOG_FILE="${locked}"; logger() { echo "$@" >> "${capture}"; }; run_and_log "bad step" /usr/bin/false >/dev/null 2>&1; echo "$?")
  if [[ "${rc}" != "0" ]] && _jump_log_has "${capture}" '*cannot write*'; then
    _pass "jump-user: an unwritable log keeps the exit code and reports the failed write to syslog"
  else
    _fail "jump-user: unwritable log: rc '${rc}', or the failed write was silent"
  fi
  zf_chmod 644 "${locked}"
  zf_rm -rf "${fixture}"

  # 4. Static half, needs nothing installed: no launchd-invoked program sits
  #    in install_scripts' symlink array.
  local raw plist prog base bad=''
  # `|| true` is load-bearing: under the dispatcher's `set -e` a non-matching
  # grep would abort the whole run, later suites silently skipped.
  raw=$(/usr/bin/grep -oE 'local -ar bin_files=\([^)]*\)' bittersweet 2>/dev/null || true)
  if [[ -z "${raw}" ]]; then
    _fail "could not extract bin_files from bittersweet — pattern changed"
  else
    raw="${raw#*\(}"
    raw="${raw%\)}"
    # SC2296/SC2206: zsh word-splitting flag, not valid bash.
    # shellcheck disable=SC2296,SC2206
    local -a bin_files=(${=raw})
    for plist in "${_JUMP_PLISTS[@]}"; do
      base="${_JUMP_PLIST_PROG[${plist}]##*/}"
      (( ${bin_files[(Ie)${base}]} )) && bad+=" ${plist##*/}(${base})"
    done
    if [[ -z "${bad}" ]]; then
      _pass "no launchd program is in the install_scripts symlink array (${#_JUMP_PLISTS[@]} plists)"
    else
      _fail "launchd-invoked but in the symlink array — must be copied, not symlinked:${bad}"
    fi
  fi

  # 5. Live half, installed-state drift: every installed launchd program
  #    resolves outside ~/Documents, and the deployed copies of jump-user and
  #    jump-system are real files that match the repo (2026-07-29: a deployed
  #    copy missed a guard committed minutes earlier). Skipped when nothing
  #    is installed.
  local real name installed
  local -i checked=0
  bad=''
  for plist in "${_JUMP_PLISTS[@]}"; do
    prog="${_JUMP_PLIST_PROG[${plist}]}"
    [[ -e "${prog}" ]] || continue
    checked+=1
    # SC2296: zsh :A resolves symlinks, not valid bash.
    # shellcheck disable=SC2296
    real="${prog:A}"
    [[ "${real}" == "${HOME}/Documents/"* ]] && bad+=" ${prog}(under-Documents)"
  done
  for name in jump-user jump-system; do
    installed="/usr/local/bin/${name}"
    [[ -e "${installed}" ]] || continue
    if [[ -L "${installed}" ]]; then
      bad+=" ${name}(symlink)"
    elif [[ -r "${installed}" ]]; then
      checked+=1
      cmp -s "bin/${name}" "${installed}" || bad+=" ${name}(STALE: re-run 'bittersweet scripts')"
    fi
  done
  if (( checked == 0 )); then
    _skip "no installed launchd program to check"
  elif [[ -z "${bad}" ]]; then
    _pass "installed launchd programs resolve outside ~/Documents and the deployed copies are current"
  else
    _fail "installed launchd state wrong:${bad}"
  fi
}

function run_jump {
  # Builtin rm and chmod: the zf_ prefix leaves the external commands alone.
  zmodload -F zsh/files b:zf_rm b:zf_chmod
  _jump_load_bodies
  _jump_load_plists
  _jump_test_cases
}
