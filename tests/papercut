#!/bin/zsh
# dotfiles/tests/papercut
#
# Hermetic suite for bin/papercut: no network, no real $HOME. Every case runs
# the tool with /bin/zsh and HOME pointed at a fresh per-test sandbox, so the
# tool's own path construction runs unmodified against a fake
# ~/Library/Application Support/papercuts/ (space included). Git discovery is
# fenced with GIT_CEILING_DIRECTORIES and the inherited GIT_* variables are
# removed, so a surrounding repo or a hook environment cannot change the result.
#
# Pins:
#   - first use creates the directory 0700 and the file 0600 with the skeleton
#     and one entry in the pinned format;
#   - resolve rewrites the entry under "## Resolved" and removes it from Open;
#   - a refused append (missing "Fix:", a bad --repo value) exits 64 and leaves
#     an existing log byte-identical;
#   - a malformed log fails an append with exit 1 and stays byte-identical,
#     while count fails open with "0 0 -" and exit 0;
#   - one append resolves agent (PAPERCUT_AGENT over CLAUDECODE), repo (git
#     toplevel, sanitised) and collapses a newline and a tab to one line;
#   - the lock: a held lock fails an append with exit 1 after about 5 s and
#     leaves the file byte-identical; concurrent appends all land.
#
# Run: ./test papercut
# ShellCheck: lint with `shellcheck --shell=bash tests/papercut`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib
# shellcheck disable=SC2016,SC2034,SC2154,SC2329
# shellcheck disable=SC2296,SC2051,SC2015,SC2079  # zsh-only syntax: (@f) flags, {1..$n}, float (( )), A && B || C reporting

zmodload zsh/datetime 2>/dev/null
zmodload zsh/zselect 2>/dev/null

typeset -g PC_T='' PC_HOME='' PC_CWD='' PC_BIN='' PC_LOG='' PC_LOCK=''
typeset -gi PC_RC=0
typeset -ga PC_EXTRA=() PC_LINES=()

readonly PC_ENTRY_RE='^- \[ \] [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z · [A-Za-z0-9._-]+ · [A-Za-z0-9._-]+ · .*Fix:.*$'
readonly PC_RESOLVED_RE='^- \[x\] [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z · shell · b · two Fix: y → resolved [0-9]{4}-[0-9]{2}-[0-9]{2} : fixed it$'
readonly PC_FIELDS_RE='^- \[ \] ([^ ]+) · ([^ ]+) · ([^ ]+) · (.*)$'

function _pc_setup {
  PC_T="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/papercut-test.XXXXXX")"
  PC_BIN="${SCRIPT_DIR}/bin/papercut"
}

function _pc_teardown {
  [[ -n "${PC_T}" && -d "${PC_T}" ]] && /bin/rm -rf "${PC_T:?}"
}

# A fresh HOME and working directory for each test; the space in "Application
# Support" is the point.
function _pc_fresh {
  /bin/rm -rf "${PC_T:?}/home" "${PC_T:?}/work"
  PC_HOME="${PC_T}/home"
  PC_CWD="${PC_T}/work"
  PC_LOG="${PC_HOME}/Library/Application Support/papercuts/PAPERCUTS.md"
  PC_LOCK="${PC_LOG}.lock"
  /bin/mkdir -p "${PC_HOME}" "${PC_CWD}"
}

# Runs a command in directory $1 under the tool's own environment: no agent
# hints unless the case adds them through PC_EXTRA (cleared after each run).
# It ends in exec, so call it inside a ( subshell ).
function _pc_exec {
  local dir="$1"
  shift
  cd "${dir}" || return 1
  unset -v CLAUDECODE PAPERCUT_AGENT GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
  export HOME="${PC_HOME}" GIT_CEILING_DIRECTORIES="${PC_T}"
  (( ${#PC_EXTRA[@]} == 0 )) || export "${PC_EXTRA[@]}"
  exec "$@"
}

function _pc_run {
  PC_RC=0
  ( _pc_exec "${PC_CWD}" /bin/zsh "${PC_BIN}" "$@" ) > "${PC_T}/out" 2> "${PC_T}/err" || PC_RC=$?
  PC_EXTRA=()
}

function _pc_sha {
  /usr/bin/shasum -a 256 "${PC_LOG}"
}

# Loads the log into PC_LINES (1-based; blank lines kept).
function _pc_load {
  PC_LINES=("${(@f)"$(<"${PC_LOG}")"}")
}

# Index of the first line equal to $1, or 0.
function _pc_index {
  local i
  for i in {1..${#PC_LINES[@]}}; do
    if [[ "${PC_LINES[i]}" == "$1" ]]; then print -r -- "${i}"; return; fi
  done
  print 0
}

function _pc_count_entries {
  local line n=0
  for line in "${PC_LINES[@]}"; do
    [[ "${line}" == '- [ ] '* ]] && n=$(( n + 1 ))
  done
  print "${n}"
}

# The last Open entry line in the log file.
function _pc_last_entry {
  local line last=''
  while IFS= read -r line; do
    [[ "${line}" == '- [ ] '* ]] && last="${line}"
  done < "${PC_LOG}"
  print -r -- "${last}"
}

function _pc_field {
  local line="$1" idx="$2"
  [[ "${line}" =~ ${PC_FIELDS_RE} ]] && print -r -- "${match[idx]}"
}

# Writes a log holding the given entry lines (full "- [ ] ..." text) under Open.
function _pc_seed {
  local line
  /bin/mkdir -p "${PC_LOG:h}"
  {
    printf '# Papercuts\n\nSmall frictions this estate can fix, logged in the moment by `papercut`.\n'
    printf 'Open entries are drained by the `papercuts` skill; resolved ones move below.\n\n## Open\n\n'
    for line in "$@"; do printf '%s\n' "${line}"; done
    printf '\n## Resolved\n'
  } > "${PC_LOG}"
}

# --- test cases --------------------------------------------------------------

function _pc_test_first_use {
  _section "papercut: first use"
  _pc_fresh

  _pc_run 'First cut. Fix: do the thing'
  _pc_load
  if (( PC_RC == 0 && ${#PC_LINES[@]} == 10 )) \
      && [[ "$(/usr/bin/stat -f %Lp "${PC_LOG:h}")" == 700 && "$(/usr/bin/stat -f %Lp "${PC_LOG}")" == 600 ]] \
      && [[ "${PC_LINES[1]}" == '# Papercuts' && "${PC_LINES[6]}" == '## Open' \
      && -z "${PC_LINES[7]}" && -z "${PC_LINES[9]}" && "${PC_LINES[10]}" == '## Resolved' ]] \
      && [[ "${PC_LINES[8]}" =~ ${PC_ENTRY_RE} && "${PC_LINES[8]}" == *' · shell · none · First cut. Fix: do the thing' ]]; then
    _pass "first append: directory 0700, file 0600, skeleton, one entry in the pinned format"
  else
    _fail "first append wrong (rc ${PC_RC}, ${#PC_LINES[@]} lines): ${PC_LINES[*]}"
  fi
}

function _pc_test_resolve {
  local i
  _section "papercut: resolve"
  _pc_fresh

  _pc_seed '- [ ] 2026-09-25T10:00:00Z · shell · a · one Fix: x' \
           '- [ ] 2026-09-25T10:01:00Z · shell · b · two Fix: y' \
           '- [ ] 2026-09-25T10:02:00Z · shell · c · three Fix: z'
  _pc_run resolve 2 $'fixed\tit'
  _pc_load
  i="$(_pc_index '## Resolved')"
  if (( PC_RC == 0 && i > 2 )) && [[ "${PC_LINES[i+2]}" =~ ${PC_RESOLVED_RE} \
      && -z "${PC_LINES[i+1]}" && ${#PC_LINES[@]} == $(( i + 2 )) \
      && -z "${PC_LINES[i-1]}" && "${PC_LINES[i-2]}" == *' · c · three Fix: z' \
      && "${PC_LINES[i-3]}" == *' · a · one Fix: x' ]] && (( $(_pc_count_entries) == 2 )); then
    _pass "resolve: entry rewritten under Resolved, removed from Open, the others kept in order"
  else
    _fail "resolve wrong (rc ${PC_RC}): ${PC_LINES[*]}"
  fi
}

function _pc_test_refused_missing_fix {
  local before
  _section "papercut: refused append, missing Fix"
  _pc_fresh

  _pc_seed '- [ ] 2026-09-25T10:00:00Z · shell · a · seed Fix: x'
  before="$(_pc_sha)"
  _pc_run 'no remedy here'
  if (( PC_RC == 64 )) && /usr/bin/grep -q 'Fix: <smallest change>' "${PC_T}/err" && [[ "$(_pc_sha)" == "${before}" ]]; then
    _pass "message without Fix: exits 64, names the clause, log byte-identical"
  else
    _fail "missing Fix: wrong (rc ${PC_RC}): $(/usr/bin/head -c 200 "${PC_T}/err")"
  fi
}

function _pc_test_refused_bad_repo {
  local before
  _section "papercut: refused append, bad --repo"
  _pc_fresh

  _pc_seed '- [ ] 2026-09-25T10:00:00Z · shell · a · seed Fix: x'
  before="$(_pc_sha)"
  _pc_run --repo 'bad repo!' 'x Fix: y'
  if (( PC_RC == 64 )) && /usr/bin/grep -q "invalid repo 'bad repo!'" "${PC_T}/err" && [[ "$(_pc_sha)" == "${before}" ]]; then
    _pass "bad --repo value exits 64, names the field, log byte-identical"
  else
    _fail "bad --repo wrong (rc ${PC_RC}): $(/usr/bin/head -c 200 "${PC_T}/err")"
  fi
}

function _pc_test_malformed {
  local before
  _section "papercut: malformed log"
  _pc_fresh

  /bin/mkdir -p "${PC_LOG:h}"
  printf 'not a papercut log\n' > "${PC_LOG}"
  before="$(_pc_sha)"
  _pc_run 'x Fix: y'
  if (( PC_RC == 1 )) && /usr/bin/grep -q "lacks '## Open'" "${PC_T}/err" && [[ "$(_pc_sha)" == "${before}" ]]; then
    _pass "append to a malformed log exits 1 and leaves it byte-identical"
  else
    _fail "malformed append wrong (rc ${PC_RC}): $(/usr/bin/head -c 200 "${PC_T}/err")"
  fi

  _pc_run count
  if (( PC_RC == 0 )) && [[ "$(<"${PC_T}/out")" == '0 0 -' ]]; then
    _pass "count on a malformed log fails open: 0 0 - and exit 0"
  else
    _fail "malformed count wrong (rc ${PC_RC}): $(<"${PC_T}/out")"
  fi
}

# One append through a git repo whose name has unsafe characters, with both
# agent hints set and a newline and a tab in the message.
function _pc_test_fields {
  local line
  _section "papercut: agent, repo and collapse"
  _pc_fresh

  /bin/mkdir -p "${PC_T}/work/my repo+x"
  ( _pc_exec "${PC_CWD}" /usr/bin/git init -q "${PC_T}/work/my repo+x" ) >/dev/null 2>&1
  PC_CWD="${PC_T}/work/my repo+x"
  PC_EXTRA=(CLAUDECODE=1 PAPERCUT_AGENT=envbot)
  _pc_run $'one\ntwo\tthree Fix: four'
  _pc_load
  line="$(_pc_last_entry)"
  if (( PC_RC == 0 )) && [[ "$(_pc_field "${line}" 2)" == envbot && "$(_pc_field "${line}" 3)" == my_repo_x \
      && "${line}" == *' · one two three Fix: four' ]] && (( $(_pc_count_entries) == 1 )); then
    _pass "append: PAPERCUT_AGENT beats CLAUDECODE, repo name sanitised, newline and tab collapse to one line"
  else
    _fail "fields wrong (rc ${PC_RC}): ${line}"
  fi
}

# Waits up to 5 s for the holder to write its pid, which means it has the lock.
function _pc_wait_held {
  local i
  for i in {1..50}; do
    [[ -s "${PC_T}/held" ]] && return 0
    zselect -t 10 || :
  done
  return 1
}

function _pc_test_lock {
  local before holder hpid
  _section "papercut: lock contention"
  _pc_fresh

  _pc_seed '- [ ] 2026-09-25T10:00:00Z · shell · a · seed Fix: x'
  before="$(_pc_sha)"
  /bin/rm -f "${PC_T:?}/held"
  # The holder execs sleep so that killing its pid drops the lock at once.
  /usr/bin/lockf -k -t 10 "${PC_LOCK}" /bin/sh -c 'echo $$ > "$1"; exec /bin/sleep 60' sh "${PC_T}/held" &
  holder=$!
  if ! _pc_wait_held; then
    _fail "lock holder never acquired the lock"
    kill "${holder}" 2>/dev/null || :
    wait "${holder}" 2>/dev/null || :
    return
  fi
  hpid="$(<"${PC_T}/held")"

  _pc_run 'blocked Fix: x'
  if (( PC_RC == 1 )) && /usr/bin/grep -q 'lock' "${PC_T}/err" && [[ "$(_pc_sha)" == "${before}" ]]; then
    _pass "append under a held lock exits 1 naming the lock, log byte-identical"
  else
    _fail "held lock wrong (rc ${PC_RC}): $(/usr/bin/head -c 200 "${PC_T}/err")"
  fi

  kill "${hpid}" 2>/dev/null || :
  wait "${holder}" 2>/dev/null || :
}

function _pc_test_concurrent {
  local n i
  local -a pids=()
  _section "papercut: concurrent appends"
  _pc_fresh

  _pc_seed '- [ ] 2026-09-25T10:00:00Z · shell · a · seed Fix: x'
  for i in {1..3}; do
    ( _pc_exec "${PC_CWD}" /bin/zsh "${PC_BIN}" "concurrent ${i} Fix: x" ) > "${PC_T}/out.${i}" 2> "${PC_T}/err.${i}" &
    pids+=($!)
  done
  n=0
  for i in {1..3}; do
    wait "${pids[i]}" || n=$(( n + 1 ))
  done
  _pc_load
  i="$(_pc_index '## Resolved')"
  if (( n == 0 && $(_pc_count_entries) == 4 )) && /usr/bin/grep -q ' · concurrent 1 Fix: x$' "${PC_LOG}" \
      && /usr/bin/grep -q ' · concurrent 2 Fix: x$' "${PC_LOG}" && /usr/bin/grep -q ' · concurrent 3 Fix: x$' "${PC_LOG}" \
      && [[ -z "${PC_LINES[i-1]}" && -n "${PC_LINES[i-2]}" ]]; then
    _pass "concurrent appends: no lost entry, layout intact"
  else
    _fail "lost update or damage (${n} failed, $(_pc_count_entries) entries): ${PC_LINES[*]}"
  fi
}

function run_papercut {
  if [[ ! -x "${SCRIPT_DIR}/bin/papercut" ]]; then
    _skip "papercut: bin/papercut is missing"
    return
  fi
  if [[ ! -x /usr/bin/lockf || ! -x /usr/bin/git ]]; then
    _skip "papercut: /usr/bin/lockf or /usr/bin/git is missing"
    return
  fi

  _pc_setup
  _pc_test_first_use
  _pc_test_resolve
  _pc_test_refused_missing_fix
  _pc_test_refused_bad_repo
  _pc_test_malformed
  _pc_test_fields
  _pc_test_lock
  _pc_test_concurrent
  _pc_teardown
}
