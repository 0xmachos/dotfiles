# Fixture ssh_config for tests/ssh-redirect. Placeholder names only.
#
# hosta / hosta-claude / tail-hosta: the base DENY contract; HostName and the
# other per-host detail must never be echoed back by the hook.
Host hosta
  HostName 192.0.2.10
  User rootfixture
  Port 2222
  IdentityFile ~/.ssh/id_fixture_hosta

Host hosta-claude
  HostName 192.0.2.10

Host tail-hosta

# hostb: no -claude twin, must PASS.
Host hostb

# hostd / hoste / hostf: one Host line per pair (wrapper/option cases).
Host hostd
Host hostd-claude
Host hoste
Host hoste-claude
Host hostf
Host hostf-claude

# hostg-claude with no bare hostg: "twin exists, base does not" stays PASS
# (documented gap in the hook's header).
Host hostg-claude

# A wildcarded Host line never manufactures a literal name.
Host hostw*
Host hostw-claude

Include config.d/*
Include ~/.ssh/extra-hosts
