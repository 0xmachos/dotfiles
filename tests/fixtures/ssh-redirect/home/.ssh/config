# Fixture ssh_config for tests/ssh-redirect. Placeholder names only.
#
# hosta / hosta-claude / tail-hosta: the base DENY contract, plus a HostName
# and other per-host detail that the hook must never echo back.
Host hosta
  HostName 192.0.2.10
  User rootfixture
  Port 2222
  IdentityFile ~/.ssh/id_fixture_hosta

Host hosta-claude
  HostName 192.0.2.10

Host tail-hosta

# hostb: declared with no -claude twin — must PASS.
Host hostb

# hostd / hoste / hostf: one Host line per pair, wrapper/option test cases.
Host hostd
Host hostd-claude
Host hoste
Host hoste-claude
Host hostf
Host hostf-claude

# hostg-claude with no bare hostg declared — "twin exists, base does not"
# stays PASS (documented gap in the hook's header).
Host hostg-claude

# A wildcarded Host line never manufactures a literal name.
Host hostw*
Host hostw-claude

Include config.d/*
Include ~/.ssh/extra-hosts
