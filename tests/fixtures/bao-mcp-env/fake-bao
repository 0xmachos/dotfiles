#!/bin/zsh
# dotfiles/tests/fixtures/bao-mcp-env/fake-bao
#
# Stand-in for `bao`, used by tests/bao-mcp-env via the BAO_MCP_ENV_BAO seam.
# No network, no real OpenBao. Every call is recorded (calls, argv.N, env.N)
# so the suite can prove:
#   1. role_id/secret_id reach `auth/approle/login` as "@<path>" file
#      references, never literal in argv or this script's environment;
#   2. `token revoke -self` runs exactly once per bao-mcp-env invocation, on
#      the success and the kv-read-failure path;
#   3. no served secret value appears in argv (`kv get` gets only the subpath).
#
# Environment (set by the suite):
#   FAKE_BAO_DIR         record directory
#   FAKE_BAO_TOKEN       token emitted on login (default: fixed synthetic)
#   FAKE_BAO_LOGIN_FAIL  any value: `auth/approle/login` fails
#   FAKE_BAO_KV_FAIL     any value: `kv get` fails
#   FAKE_BAO_KV_JSON     JSON file printed verbatim for `kv get -format=json`
#                        (default: a 2-field fixture)
# Subcommands: `write -field=token auth/approle/login role_id=@F secret_id=@F`,
# `kv get -format=json -mount=kv PATH`, `token revoke -self`.
#
# ShellCheck: lint with `shellcheck --shell=bash tests/fixtures/bao-mcp-env/fake-bao`.

set -euo pipefail
umask 077

: "${FAKE_BAO_DIR:?FAKE_BAO_DIR unset}"

# --- record the call ---------------------------------------------------------
counter="${FAKE_BAO_DIR}/calls"
n=0
[[ -f "${counter}" ]] && n="$(<"${counter}")"
n=$(( n + 1 ))
printf '%s' "${n}" > "${counter}"
printf '%s\n' "$@" > "${FAKE_BAO_DIR}/argv.${n}"
/usr/bin/env > "${FAKE_BAO_DIR}/env.${n}"

# --- dispatch ------------------------------------------------------------
case "${1:-}" in
  write)
    if [[ -n "${FAKE_BAO_LOGIN_FAIL:-}" ]]; then
      echo "fake-bao: login denied (scripted failure)" >&2
      exit 1
    fi
    role_id_arg="" secret_id_arg=""
    for arg in "$@"; do
      case "${arg}" in
        role_id=@*)   role_id_arg="${arg#role_id=@}" ;;
        secret_id=@*) secret_id_arg="${arg#secret_id=@}" ;;
      esac
    done
    printf '%s\n' "${role_id_arg}" > "${FAKE_BAO_DIR}/login-role-id-path.${n}"
    printf '%s\n' "${secret_id_arg}" > "${FAKE_BAO_DIR}/login-secret-id-path.${n}"
    if [[ -z "${role_id_arg}" || ! -r "${role_id_arg}" ]]; then
      echo "fake-bao: role_id file reference missing or unreadable" >&2
      exit 1
    fi
    if [[ -z "${secret_id_arg}" || ! -r "${secret_id_arg}" ]]; then
      echo "fake-bao: secret_id file reference missing or unreadable" >&2
      exit 1
    fi
    printf '%s' "${FAKE_BAO_TOKEN:-fake-token-0000000000000000}"
    ;;

  kv)
    if [[ -n "${FAKE_BAO_KV_FAIL:-}" ]]; then
      echo "fake-bao: kv read denied (scripted failure)" >&2
      exit 1
    fi
    if [[ -n "${FAKE_BAO_KV_JSON:-}" ]]; then
      /bin/cat "${FAKE_BAO_KV_JSON}"
    else
      printf '{"data":{"data":{"FAKE_FIELD_ONE":"one-value","FAKE_FIELD_TWO":"two-value"}}}'
    fi
    ;;

  token)
    :
    ;;

  *)
    echo "fake-bao: unhandled subcommand: $*" >&2
    exit 2
    ;;
esac
