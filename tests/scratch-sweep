#!/bin/zsh
# dotfiles/tests/scratch-sweep
#
# Behavioural test for bin/scratch-sweep, the unattended job that deletes idle
# scratch under ~/Library/Caches/tint. It deletes recursively, so the
# suite pins what must SURVIVE: recent entries, an old entry holding one recent
# file, symlink targets, exempt names, a live lock holder, and everything under
# a refused root (wrong basename, symlink, foreign owner, swapped after the
# checks). It also pins what must go (idle entries, awkward names), the dry run,
# the re-check before a delete, and the real main under hostile shell options.
#
# Hermetic: each case builds <tmp>/Caches/tint, sources the script in a
# child zsh (`main` does not run when sourced) and calls _sweep_root_dir on it.
# The real main runs only with HOME pointed at a fixture.
#
# Run: ./test scratch-sweep
#
# ShellCheck: lint with `shellcheck --shell=bash tests/scratch-sweep`.
# This file is sourced, not executed - chmod 644.
#
# shellcheck source=tests/lib

typeset -g SWEEP_T_OUT=''
typeset -gi SWEEP_T_RC=0 SWEEP_T_SEQ=0
typeset -g SWEEP_T_BOX=''

function _sweep_t_run {
  # Run _sweep_root_dir "$@" in a child zsh: both streams to SWEEP_T_OUT, status
  # to SWEEP_T_RC. SWEEP_T_OWNER replaces the owner lookup; SWEEP_T_SETUP is zsh
  # code run after sourcing (to redefine a seam) and before the sweep.
  # The if/else keeps a non-zero child status from tripping errexit.
  if SWEEP_T_OUT="$(/bin/zsh -c '
    source "$1"; shift
    if [[ -n "${SWEEP_T_OWNER:-}" ]]; then
      _sweep_uid_of() { print -r -- "${SWEEP_T_OWNER}"; }
    fi
    if [[ -n "${SWEEP_T_SETUP:-}" ]]; then
      eval "${SWEEP_T_SETUP}"
    fi
    _sweep_root_dir "$@"' -- "${SCRIPT_DIR}/bin/scratch-sweep" "$@" 2>&1)"; then
    SWEEP_T_RC=0
  else
    SWEEP_T_RC=$?
  fi
}

function _sweep_t_age {
  # Give $1 and everything under it (symlinks included, not followed) an old mtime.
  # shellcheck disable=SC2231,SC2296  # zsh recursive glob and (DN) qualifiers
  /usr/bin/touch -h -t 202001010000 "$1" "$1"/**/*(DN)
}

function _sweep_t_exists {
  [[ -e "$1" || -L "$1" ]]
}

function _sweep_t_fixture {
  # Make a fresh fixture holding Caches/tint under the suite sandbox and set the
  # caller's `fx` (physical path) and `root` (its Caches/tint) by dynamic scope.
  # The sandbox is removed once, at the end of the run.
  SWEEP_T_SEQ+=1
  fx="${SWEEP_T_BOX}/${SWEEP_T_SEQ}"
  root="${fx}/Caches/tint"
  /bin/mkdir -p "${root}"
}

# Idle entries go, recent ones stay, one recent file deep keeps its old tree
# whole, and the boundary sits at 14 days. One sweep of one root.
function _sweep_t_core {
  local fx root d13 d15 ok=1
  _sweep_t_fixture
  d13="$(/bin/date -v-13d '+%Y%m%d%H%M')"
  d15="$(/bin/date -v-15d '+%Y%m%d%H%M')"
  /bin/mkdir -p "${root}/idle-dir/sub" "${root}/recent-dir/sub" "${root}/deep/a/b/c" "${root}/d13" "${root}/d15"
  : > "${root}/idle-dir/sub/f"
  : > "${root}/recent-dir/sub/f"
  : > "${root}/idle-file"
  : > "${root}/deep/a/b/c/fresh"
  : > "${root}/deep/a/old-file"
  _sweep_t_age "${root}/idle-dir"
  _sweep_t_age "${root}/idle-file"
  /usr/bin/find -P "${root}/deep" -type d -exec /usr/bin/touch -t 202001010000 {} +
  /usr/bin/touch -t 202001010000 "${root}/deep/a/old-file"
  /usr/bin/touch -t "${d13}" "${root}/d13"
  /usr/bin/touch -t "${d15}" "${root}/d15"
  _sweep_t_run "${root}"
  (( SWEEP_T_RC == 0 )) || ok=0
  ! _sweep_t_exists "${root}/idle-dir" && ! _sweep_t_exists "${root}/idle-file" && ! _sweep_t_exists "${root}/d15" || ok=0
  _sweep_t_exists "${root}/recent-dir/sub/f" && _sweep_t_exists "${root}/deep/a/b/c/fresh" \
    && _sweep_t_exists "${root}/deep/a/old-file" && _sweep_t_exists "${root}/d13" || ok=0
  [[ "${SWEEP_T_OUT}" == *"summary: removed=3 kept=3 exempt=0 skipped=0 failed=0 dry_run=0"* ]] || ok=0
  _sweep_t_exists "${root}/.sweep.lock" && ok=0
  if (( ok )); then
    _pass "sweep: idle entries removed, recent and deep-recent trees kept, 13 days kept and 15 days removed, lock released"
  else
    _fail "core sweep wrong: rc=${SWEEP_T_RC} out=${SWEEP_T_OUT}"
  fi
}

# Old symlinks are unlinked and never followed, and awkward names go whole.
function _sweep_t_links_names {
  local fx root outside name ok=1
  _sweep_t_fixture
  outside="${fx}/outside"
  /bin/mkdir -p "${outside}/keep"
  : > "${outside}/keep/precious"
  : > "${outside}/precious-file"
  /bin/ln -s "${outside}" "${root}/old-link-dir"
  /bin/ln -s "${outside}/precious-file" "${root}/old-link-file"
  /usr/bin/touch -h -t 202001010000 "${root}/old-link-dir" "${root}/old-link-file"
  /bin/ln -s "${outside}" "${root}/recent-link"
  /bin/mkdir -p "${root}/entry-with-link"
  /bin/ln -s "${outside}/keep" "${root}/entry-with-link/out"
  _sweep_t_age "${root}/entry-with-link"
  /bin/mkdir -p -- "${root}/has space" "${root}/nl"$'\n'"name" "${root}/-rf" "${root}/--" "${root}/glob*[x]"
  for name in "has space" "nl"$'\n'"name" "-rf" "--" "glob*[x]"; do
    : > "${root}/${name}/f"
    _sweep_t_age "${root}/${name}"
  done
  _sweep_t_run "${root}"
  (( SWEEP_T_RC == 0 )) || ok=0
  for name in old-link-dir old-link-file entry-with-link "has space" "nl"$'\n'"name" "-rf" "--" "glob*[x]"; do
    ! _sweep_t_exists "${root}/${name}" || ok=0
  done
  _sweep_t_exists "${root}/recent-link" && _sweep_t_exists "${outside}/keep/precious" && _sweep_t_exists "${outside}/precious-file" || ok=0
  [[ "${SWEEP_T_OUT}" != *"nl"$'\n'"name"* ]] || ok=0
  if (( ok )); then
    _pass "sweep: old symlinks unlinked without touching their targets, awkward names removed, log lines stay whole"
  else
    _fail "links and names wrong: rc=${SWEEP_T_RC} out=${SWEEP_T_OUT}"
  fi
}

# A root with the wrong basename is refused and its idle contents survive.
function _sweep_t_refuse_basename {
  local fx root
  _sweep_t_fixture
  /bin/mkdir -p "${fx}/Caches/other/sentinel"
  _sweep_t_age "${fx}/Caches/other/sentinel"
  _sweep_t_run "${fx}/Caches/other"
  if (( SWEEP_T_RC == 2 )) && [[ "${SWEEP_T_OUT}" == *refusing* ]] && _sweep_t_exists "${fx}/Caches/other/sentinel"; then
    _pass "refuses a root with the wrong basename and deletes nothing"
  else
    _fail "wrong basename: rc=${SWEEP_T_RC} out=${SWEEP_T_OUT}"
  fi
}

# A root that is a symlink is refused: the real tree behind it survives.
function _sweep_t_refuse_symlink {
  local fx root
  _sweep_t_fixture
  /bin/mkdir -p "${fx}/real/Caches/tint/sentinel" "${fx}/sym/Caches"
  _sweep_t_age "${fx}/real/Caches/tint/sentinel"
  /bin/ln -s "${fx}/real/Caches/tint" "${fx}/sym/Caches/tint"
  _sweep_t_run "${fx}/sym/Caches/tint"
  if (( SWEEP_T_RC == 2 )) && _sweep_t_exists "${fx}/real/Caches/tint/sentinel"; then
    _pass "refuses a root that is a symlink and deletes nothing"
  else
    _fail "symlink root: rc=${SWEEP_T_RC} out=${SWEEP_T_OUT}"
  fi
}

# A root owned by another user is refused (a sudo run must not pass a
# root-owned tree).
function _sweep_t_refuse_owner {
  local fx root
  _sweep_t_fixture
  /bin/mkdir -p "${root}/sentinel"
  _sweep_t_age "${root}/sentinel"
  SWEEP_T_OWNER=$(( UID + 1 )) _sweep_t_run "${root}"
  if (( SWEEP_T_RC == 2 )) && [[ "${SWEEP_T_OUT}" == *"not owned"* ]] && _sweep_t_exists "${root}/sentinel"; then
    _pass "refuses a root owned by another user and deletes nothing"
  else
    _fail "foreign owner: rc=${SWEEP_T_RC} out=${SWEEP_T_OUT}"
  fi
}

# A root swapped for a symlink after the checks is not followed: the sweep
# aborts and deletes nothing, in the target or in the caller's directory.
function _sweep_t_swapped_root {
  local fx root setup
  _sweep_t_fixture
  /bin/mkdir -p "${fx}/outside/victim" "${fx}/caller"
  : > "${fx}/outside/victim/f"
  : > "${fx}/caller/victim2"
  _sweep_t_age "${fx}/outside"
  _sweep_t_age "${fx}/caller"
  # shellcheck disable=SC2016  # code for the child shell, not expanded here
  setup='builtin cd "${SWEEP_T_CALLER}"
    _sweep_uid_of() {
      if [[ -d "${SWEEP_T_ROOT}" && ! -L "${SWEEP_T_ROOT}" ]]; then
        /bin/mv "${SWEEP_T_ROOT}" "${SWEEP_T_ROOT}.real"
        /bin/ln -s "${SWEEP_T_OUTSIDE}" "${SWEEP_T_ROOT}"
      fi
      print -r -- "${UID}"
    }'
  SWEEP_T_ROOT="${root}" SWEEP_T_OUTSIDE="${fx}/outside" SWEEP_T_CALLER="${fx}/caller" \
    SWEEP_T_SETUP="${setup}" _sweep_t_run "${root}"
  if (( SWEEP_T_RC == 2 )) && [[ "${SWEEP_T_OUT}" == *"changed while opening"* ]] \
     && _sweep_t_exists "${fx}/outside/victim/f" && _sweep_t_exists "${fx}/caller/victim2"; then
    _pass "a root swapped for a symlink before the cd aborts and deletes nothing"
  else
    _fail "swapped root: rc=${SWEEP_T_RC} out=${SWEEP_T_OUT}"
  fi
}

# A dry run reports what would go and deletes nothing, symlinks included.
function _sweep_t_dry_run {
  local fx root
  _sweep_t_fixture
  /bin/mkdir -p "${root}/idle"
  _sweep_t_age "${root}/idle"
  /bin/ln -s "${fx}" "${root}/idle-link"
  /usr/bin/touch -h -t 202001010000 "${root}/idle-link"
  _sweep_t_run "${root}" --dry-run
  if (( SWEEP_T_RC == 0 )) && _sweep_t_exists "${root}/idle" && _sweep_t_exists "${root}/idle-link" \
     && [[ "${SWEEP_T_OUT}" == *"would remove"*idle* && "${SWEEP_T_OUT}" == *"dry_run=1"* ]] && ! _sweep_t_exists "${root}/.sweep.lock"; then
    _pass "dry run: reports what would go, deletes nothing, takes no lock"
  else
    _fail "dry run wrong: rc=${SWEEP_T_RC} out=${SWEEP_T_OUT}"
  fi
}

# A fresh lock held by a live sweep: exit 0, nothing deleted.
function _sweep_t_lock_held {
  local fx root
  _sweep_t_fixture
  /bin/mkdir -p "${root}/idle" "${root}/.sweep.lock"
  _sweep_t_age "${root}/idle"
  print -r -- "$$" > "${root}/.sweep.lock/pid"
  _sweep_t_run "${root}"
  if (( SWEEP_T_RC == 0 )) && _sweep_t_exists "${root}/idle" && [[ "${SWEEP_T_OUT}" == *"holds the lock"* ]]; then
    _pass "a fresh lock with a live pid is respected: exit 0, nothing deleted"
  else
    _fail "live lock: rc=${SWEEP_T_RC} out=${SWEEP_T_OUT}"
  fi
}

# claude-<digits>, cc-socks and _tools are never swept, near-miss names are.
function _sweep_t_exempt {
  local fx root name ok=1
  _sweep_t_fixture
  /bin/mkdir -p "${root}/claude-501/tasks" "${root}/cc-socks" "${root}/_tools/venv" \
    "${root}/claude-501x" "${root}/xclaude-501" "${root}/Claude-4242" "${root}/cc-socksx"
  : > "${root}/claude-9"
  /bin/ln -s "${fx}" "${root}/claude-77"
  for name in claude-501 cc-socks _tools claude-501x xclaude-501 Claude-4242 cc-socksx claude-9; do
    if [[ -d "${root}/${name}" ]]; then : > "${root}/${name}/f"; fi
    _sweep_t_age "${root}/${name}"
  done
  /usr/bin/touch -h -t 202001010000 "${root}/claude-77"
  _sweep_t_run "${root}"
  for name in claude-501/tasks claude-9 claude-77 cc-socks/f _tools/f; do
    _sweep_t_exists "${root}/${name}" || ok=0
  done
  for name in claude-501x xclaude-501 Claude-4242 cc-socksx; do
    ! _sweep_t_exists "${root}/${name}" || ok=0
  done
  [[ "${SWEEP_T_OUT}" == *"exempt=5 "* ]] || ok=0
  if (( ok )); then
    _pass "exempt names (claude-<digits> dir, file and symlink, cc-socks, _tools) survive, near-miss names are removed"
  else
    _fail "exempt wrong: rc=${SWEEP_T_RC} out=${SWEEP_T_OUT}"
  fi
}

# An entry that becomes active between the first scan and the delete is kept.
function _sweep_t_late_activity {
  local fx root setup
  _sweep_t_fixture
  /bin/mkdir -p "${root}/busy" "${root}/quiet"
  _sweep_t_age "${root}/busy"
  _sweep_t_age "${root}/quiet"
  # shellcheck disable=SC2016  # code for the child shell, not expanded here
  setup='_sweep_pre_delete() { if [[ "$1" == busy ]]; then : > "./$1/late"; fi; }'
  SWEEP_T_SETUP="${setup}" _sweep_t_run "${root}"
  if (( SWEEP_T_RC == 0 )) && _sweep_t_exists "${root}/busy/late" && ! _sweep_t_exists "${root}/quiet" \
     && [[ "${SWEEP_T_OUT}" == *"became active"* && "${SWEEP_T_OUT}" == *"removed=1 kept=1 "* ]]; then
    _pass "an entry written to after the first scan is kept, the idle one is removed"
  else
    _fail "late activity: rc=${SWEEP_T_RC} out=${SWEEP_T_OUT}"
  fi
}

# The real main: the hardcoded root under HOME, with startup-file options that
# change globbing, word splitting and errexit.
function _sweep_t_main {
  local fx root script="${SCRIPT_DIR}/bin/scratch-sweep" out rc ok=1
  _sweep_t_fixture
  root="${fx}/Library/Caches/tint"
  /bin/mkdir -p "${root}/idle" "${root}/recent" "${fx}/Caches/tint/elsewhere" "${fx}/zdotdir"
  _sweep_t_age "${root}/idle"
  _sweep_t_age "${fx}/Caches/tint/elsewhere"
  print -r -- 'setopt nobareglobqual ksharrays shwordsplit nomatch errexit' > "${fx}/zdotdir/.zshenv"
  if out="$(HOME="${fx}" ZDOTDIR="${fx}/zdotdir" /bin/zsh "${script}" 2>&1)"; then rc=0; else rc=$?; fi
  (( rc == 0 )) || ok=0
  ! _sweep_t_exists "${root}/idle" || ok=0
  _sweep_t_exists "${root}/recent" && _sweep_t_exists "${fx}/Caches/tint/elsewhere" || ok=0
  if (( ok )); then
    _pass "main: removes the idle entry under HOME, keeps the recent one and any other Caches/tint, under hostile shell options"
  else
    _fail "main wrong: rc=${rc} out=${out}"
  fi
}

# main refuses a relative HOME.
function _sweep_t_main_home {
  local out rc
  if out="$(HOME="relative/home" /bin/zsh "${SCRIPT_DIR}/bin/scratch-sweep" 2>&1)"; then rc=0; else rc=$?; fi
  if (( rc == 2 )); then _pass "main refuses a relative HOME"; else _fail "relative HOME: rc=${rc} out=${out}"; fi
}

function run_scratch_sweep {
  _section "scratch-sweep"

  if [[ ! -f "${SCRIPT_DIR}/bin/scratch-sweep" ]]; then
    _skip "bin/scratch-sweep absent"
    return 0
  fi

  SWEEP_T_BOX="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/scratch-sweep-test.XXXXXX")" || return 1
  SWEEP_T_BOX="${SWEEP_T_BOX:A}"

  _sweep_t_core
  _sweep_t_links_names
  _sweep_t_refuse_basename
  _sweep_t_refuse_symlink
  _sweep_t_refuse_owner
  _sweep_t_swapped_root
  _sweep_t_dry_run
  _sweep_t_lock_held
  _sweep_t_exempt
  _sweep_t_late_activity
  _sweep_t_main
  _sweep_t_main_home

  /bin/rm -rf "${SWEEP_T_BOX}"
}
