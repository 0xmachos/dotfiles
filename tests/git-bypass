#!/bin/zsh
# dotfiles/tests/git-bypass
#
# Behavioural test for claude/hooks/git-bypass-hook, the PreToolUse hook that
# denies, at a real git command position, the forms that switch git hooks or
# signing off: `--no-verify` (abbreviations, `-n`, short-flag clusters),
# hooks.* / core.hooksPath writes and -c overrides, config section edits,
# alias values carrying a bypass, `--no-gpg-sign` and gpgsign=false, env names
# that redirect git's config or switch a hook off, and a faked terminal
# (script, expect, unbuffer, socat, ssh -t to loopback) around git. The quoted
# string of eval, sh -c and env -S is re-scanned to the nesting bound.
#
# Asserts the verdict for each command. Every DENY must carry a one-line reason
# of at most 120 characters, and the main reason families are matched exactly.
# Every PASS must print nothing (a stray hook line would corrupt a later
# verdict). Guards both directions: a tweak denying `git log -n 5` or missing
# `git commit -an` fails here.
#
# Covers, one input each: the deny reason families (-n and --no-verify, signing
# off, a seam variable, a faked terminal, log and push in one command); the
# command positions a bypass is found through (a wrapper, a nested -c string, a
# heredoc body); hooks.* and core.hooksPath writes, -c overrides,
# GIT_CONFIG_KEY_<n> and alias values; the HOME redirect; the closed bugs (a
# redirection after a config read or write, HOME on a non-git command, a
# repeated local, an over-long config key); the PASS guard; and fail-open on
# an unparseable payload.
# Verdict cases run the guard through the pretool-dispatch seam
# (_hook_run_seam in tests/lib). One case runs the hook standalone
# (`/bin/zsh <hook> <<< <json>`) for the stdin and JSON deny path.
#
# Run: ./test git-bypass
#
# ShellCheck: lint with `shellcheck --shell=bash tests/git-bypass`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

# Standalone run: the hook as its own process, JSON on stdin. Echoes stdout.
function _hbg_test_run {
  _json_str "$1"
  /bin/zsh "${SCRIPT_DIR}/claude/hooks/git-bypass-hook" \
    <<< "{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":${REPLY}}}"
}

function _hbg_one {
  # One input, one case. $1 want, $2 command, $3 label, $4 optional exact deny
  # reason. A DENY must carry a one-line reason of at most 120 characters.
  _hook_run_seam "${SCRIPT_DIR}/claude/hooks/git-bypass-hook" Bash "$2"
  if [[ "${HOOK_SEAM_VERDICT}" != "$1" ]]; then
    _fail "$3 — expected $1, got ${HOOK_SEAM_VERDICT}: ${HOOK_SEAM_OUT:0:150}"
  elif [[ "$1" == DENY ]] \
      && [[ "${HOOK_SEAM_REASON}" == *$'\n'* || ${#HOOK_SEAM_REASON} -gt 120 || -z "${HOOK_SEAM_REASON}" ]]; then
    _fail "$3 — reason is not one line of at most 120 characters: ${HOOK_SEAM_REASON:0:150}"
  elif [[ -n "${4:-}" && "${HOOK_SEAM_REASON}" != "$4" ]]; then
    _fail "$3 — reason '${HOOK_SEAM_REASON}'"
  else
    _pass "$1: $3"
  fi
}

# shellcheck disable=SC2016
function run_git_bypass {
  _section "git hook-escape guard"

  # claude/ is gitignored: the hook is absent on a clean clone. Skip, don't die.
  if [[ ! -f "${SCRIPT_DIR}/claude/hooks/git-bypass-hook" ]]; then
    _skip "claude/hooks/git-bypass-hook absent — claude/ not yet synced to this machine"
    return 0
  fi

  if ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
    return
  fi

  # Deny reason families.
  _hbg_one DENY 'git commit -an' 'commit -n in a short-flag cluster' \
    'git commit -n (--no-verify): give the user the exact command to run.'
  local sout sreason
  sout="$(_hbg_test_run 'git commit -m "x" --no-verify')"
  sreason="$(jq -r '.hookSpecificOutput.permissionDecisionReason // empty' <<< "${sout}" 2>/dev/null)"
  if [[ "$(_hook_verdict "${sout}")" == DENY && "${sreason}" == 'git commit --no-verify: give the user the exact command to run.' ]]; then
    _pass "DENY (standalone): commit --no-verify gives the one-line JSON deny object"
  else
    _fail "standalone commit --no-verify — unexpected output: ${sout:0:150}"
  fi
  _hbg_one DENY 'git commit --no-gpg-sign -m x' 'signing switched off' 'unsigned commit: give the user the exact command to run.'
  _hbg_one DENY 'GIT_SIGN_SKIP=1 git push' 'a terminal-only seam variable' \
    'GIT_SIGN_SKIP set in a git command: give the user the exact command to run.'
  _hbg_one DENY 'script -q /dev/null git commit -m x' 'a faked terminal around git' \
    'a pseudo-terminal around git is blocked: give the user the exact command to run.'
  _hbg_one DENY 'git log origin/main..HEAD && git push' 'git log and git push in one command' \
    'git log and git push in one command: run the log alone, read it, then push.'

  # Where a bypass is found.
  _hbg_one DENY 'git push origin main --no-verify' '--no-verify on another subcommand'
  _hbg_one DENY 'git commit --no-veri -m x' 'an --no-verify abbreviation'
  _hbg_one DENY 'a && sudo git commit --no-verify' 'a wrapper after a separator'
  _hbg_one DENY "bash -c \"bash -c 'git commit -n'\"" 'a nested -c string'
  _hbg_one DENY $'bash <<EOF\ngit commit --no-verify -m x\nEOF' 'a heredoc body fed to a shell'

  # Hook paths, overrides and aliases.
  _hbg_one DENY 'git config core.hooksPath /tmp/x' 'a core.hooksPath write'
  _hbg_one DENY 'git -c core.hooksPath=/tmp status' 'a -c core.hooksPath override'
  _hbg_one DENY 'GIT_CONFIG_KEY_0=core.hooksPath GIT_CONFIG_VALUE_0=/tmp/x git status' 'a GIT_CONFIG_KEY_<n> naming core.hooksPath'
  _hbg_one DENY 'git config alias.ci "commit --no-verify"' 'an alias value carrying --no-verify'
  _hbg_one DENY 'HOME=/tmp/x git commit -m x' 'HOME redirected on git'

  # Closed bugs. A read with a redirection is no write, and a write with one
  # still is. HOME on a non-git command beside a git read passes. A repeated
  # local printed a stray name=value line. A very long config key is cut.
  _hbg_one DENY 'git config hooks.repoVisibility x 2>/dev/null' 'a config write followed by a redirection'
  _hbg_one PASS 'git config hooks.repoVisibility 2>/dev/null' 'a config read followed by a redirection'
  _hbg_one PASS 'env -i HOME=$HOME zsh -c true; git status' 'HOME on a non-git command beside a git read'
  _hbg_one PASS 'git add a && git commit -s -m x && git status && git log && git diff' 'five git segments print nothing'
  local longkey
  longkey="hooks.$(printf 'k%.0s' {1..300})"
  _hbg_one DENY "git config ${longkey} x" 'an over-long config key still yields a one-line reason'

  # PASS guard.
  _hbg_one PASS 'git log -n 5' 'log -n is not --no-verify'
  _hbg_one PASS 'git commit -m "no --no-verify"' 'a quoted message that mentions the flag'
  _hbg_one PASS 'git push origin main' 'an ordinary push'

  # Fail-open: an unparseable payload is allowed through.
  if [[ -z "$(printf '%s' 'not json' | /bin/zsh "${SCRIPT_DIR}/claude/hooks/git-bypass-hook")" ]]; then
    _pass "fail-open: an unparseable payload is allowed through"
  else
    _fail "fail-open: an unparseable payload produced a verdict"
  fi
}
