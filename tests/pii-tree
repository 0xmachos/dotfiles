#!/bin/zsh
# dotfiles/tests/pii-tree
#
# Scans EVERY tracked text file at HEAD with the shared pii-scan core
# (denylist + MAC/UUID token detector), not just the hunks a commit stages.
# Added 2026-09-22. Pre-commit sees only staged hunks, so a value that predates
# its denylist pattern passes every later commit; a new denylist entry is
# checked against the whole tree on the next ./test. The pre-push hook runs
# the same tree scan on every pushed tip in a public repository.
#
# Live, like tests/okf: reads the real per-clone denylist and ssh config.
# Without .githooks/pii-patterns the scan degrades to alias-derived patterns
# and warns on stderr (pii-scan's own); a warning, not a failure.
#
# Symlinks and binary files are skipped; a `file <path>` marker line precedes
# each file so a hit is attributable (mirrors the `commit <sha>` markers of the
# pre-push message scan).
#
# Run: ./test pii-tree
#
# ShellCheck: lint with `shellcheck --shell=bash tests/pii-tree`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

function _pii_tree_materialise {
  # $1 = output file, filled with the tracked text files; echoes their count.
  # One grep sorts the text files from the rest, and zsh reads each one with
  # $(<file): no per-file spawn.
  local out="$1" tpath
  local -a tracked candidates texts
  local -i n=0
  # shellcheck disable=SC2296,SC2206  # zsh (0) flag: split on NUL
  tracked=( ${(0)"$(/usr/bin/git -C "${SCRIPT_DIR}" ls-files -z)"} )
  for tpath in "${tracked[@]}"; do
    [[ -f "${tpath}" && ! -L "${tpath}" ]] && candidates+=("${tpath}")
  done
  : > "${out}"
  if (( ${#candidates} )); then
    # grep -I treats a NUL-bearing file as binary and lists no match for it.
    # shellcheck disable=SC2296,SC2206  # zsh (0) flag: split on NUL
    texts=( ${(0)"$(/usr/bin/grep -lI --null '' -- "${candidates[@]}" 2>/dev/null || true)"} )
    for tpath in "${texts[@]}"; do
      print -r -- "file ${tpath}"
      print -r -- "$(<"${tpath}")"
      print
      n+=1
    done >> "${out}"
  fi
  print -r -- "${n}"
}

function run_pii_tree {
  _section "pii-tree: whole tracked tree against the PII scanner"

  local scanner="${SCRIPT_DIR}/.config/git/hooks/pii-scan"
  if [[ ! -x "${scanner}" ]]; then
    _skip "pii-scan absent or not executable at ${scanner}"
    return 0
  fi

  local tmp n rc=0 out
  tmp="$(mktemp "${TMPDIR:-/tmp}/pii-tree.XXXXXX")"
  n="$(cd "${SCRIPT_DIR}" && _pii_tree_materialise "${tmp}")"
  if (( n == 0 )); then
    _fail "no tracked text files were materialised (git ls-files empty?)"
    /bin/rm -f "${tmp}"
    return 0
  fi

  # Run from the repo root: pii-scan reads .pii-allowlist from the INDEX of
  # the repo in cwd.
  out="$(cd "${SCRIPT_DIR}" && "${scanner}" "${tmp}" "Tracked tree at HEAD" 2>&1)" || rc=$?
  /bin/rm -f "${tmp}"
  if (( rc == 0 )); then
    _pass "${n} tracked text files carry no denylist hit or real-looking MAC/UUID token"
  else
    _fail "PII scanner flagged tracked content (rc ${rc}):"$'\n'"${out}"
  fi
}
