#!/bin/zsh
# dotfiles/tests/git-sign
#
# Pins claude/hooks/git-sign-hook (refusal fallback, re-sign nudge), bin/
# git-sign-unpushed, .config/git/hooks/commit-signatures and the pre-push
# gate, the actual boundary. Sandbox repos under $TMPDIR with
# GIT_CONFIG_GLOBAL/SYSTEM nulled and a throwaway ed25519 key: no Secretive.
#
# Cases: the hook's park-and-hand-off context for a compound commit refusal
# (also a \u-escaped `git` in the raw JSON), for a refusal inside a wrapper
# script, silence on an unrelated failure, the re-sign nudge on a commit with
# unsigned debt, and no nudge for an unsigned commit on another branch;
# git-sign-unpushed re-signing a buried unsigned commit (author dates kept,
# pushed base untouched), re-signing through a temporary worktree when the
# tree is dirty, replaying only the unsigned commits with no remote, and
# never rewriting a SHA published on a second remote; the batch signature
# scanner (a forged gpgsig line in a message, a missing object failing
# closed); pre-push blocking an unsigned push, refusing GIT_SIGN_SKIP without
# a terminal, scanning outgoing messages, gating an unsigned annotated tag,
# failing closed on a failed revision walk, not skipping the scan on an
# exported sentinel, not misreading a 300 KB signed commit, not failing on a
# chained hook that ignores a large ref stream, and a repo-local hooksPath
# still reaching the gate through the stub.
#
# GIT_SIGN_SKIP is honoured only with a controlling terminal (pii-scan
# --check-terminal). An agent's tool call has none, a human's interactive
# ./test does, so the refusal side is forced: _gs_push_expect_notty runs
# under tests/lib's _run_no_tty (POSIX setsid) and asserts the refusal LINE,
# not just the verdict.
#
# Run: ./test git-sign
#
# ShellCheck: lint with `shellcheck --shell=bash tests/git-sign`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib
# shellcheck disable=SC2030,SC2031  # deliberate: GIT_CONFIG_* exports are scoped to sandbox subshells so the user's global config never leaks in (and vice versa)

# PII seams: pre-push scans outgoing messages (2026-08-17); without the seams
# every sandbox push reads the real pattern list and live ssh aliases.
# /dev/null patterns = empty list (denylist skipped, token detector active).
# Message cases override per call: `env "${GS_ENV[@]}" PII_HOOK_PATTERNS=…`
# (env last-value-wins).
GS_ENV=(GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
        PII_HOOK_PATTERNS=/dev/null PII_HOOK_SSH_CONFIG=/dev/null)

function _gs_hook {
  # Echo the hook's stdout. $1 event, $2 command, $3 cwd, $4 failure/response
  # text, $5 optional payload field override. Default field is the live
  # payload's: `error` for PostToolUseFailure (Claude Code 2.1.282: only a
  # success carries `tool_response`), else `tool_response`. Pass
  # `tool_response` on a failure case to hit the `.error // .tool_response`
  # legacy fallback.
  local event="$1" field="${5:-}"
  if [[ -z "${field}" ]]; then
    field=tool_response
    [[ "${event}" == PostToolUseFailure ]] && field=error
  fi
  jq -n --arg e "${event}" --arg c "$2" --arg d "${3:-${SCRIPT_DIR}}" --arg r "${4:-}" --arg f "${field}" \
    '{hook_event_name:$e, tool_name:"Bash", cwd:$d,
      tool_input:{command:$c, description:"t"}} + {($f): $r}' \
    | env "${GS_ENV[@]}" /bin/zsh "${SCRIPT_DIR}/claude/hooks/git-sign-hook"
}

function _gs_expect {
  # $1 want (DENY|CONTEXT|PASS), $2 event, $3 cmd, $4 cwd, $5 response, $6
  # label, $7 optional payload field override (see _gs_hook)
  local want="$1" event="$2" cmd="$3" cwd="${4:-}" resp="${5:-}" label="${6:-$3}" field="${7:-}"
  local out got
  out="$(_gs_hook "${event}" "${cmd}" "${cwd}" "${resp}" "${field}")"
  if [[ "${out}" == *'"permissionDecision": "deny"'* ]]; then
    got=DENY
  elif [[ "${out}" == *additionalContext* ]]; then
    got=CONTEXT
  else
    got=PASS
  fi
  if [[ "${got}" == "${want}" ]]; then
    _pass "${want}(${event}): ${label}"
  else
    _fail "${label} — expected ${want}, got ${got}"
  fi
}

function _gs_commit {
  # Unsigned commit in $PWD: message $1, author date $2, committer date $3
  # (defaults to $2). Pass a DIFFERENT $3 for date assertions: equal fixtures
  # make the committer-date check pass vacuously.
  echo "$1" >> f
  git add f
  GIT_AUTHOR_DATE="$2" GIT_COMMITTER_DATE="${3:-$2}" \
    git commit -qn --no-gpg-sign -m "$1"
}

function _gs_commit_signed {
  # Signed commit in $PWD (throwaway key, no Touch ID): message $1, author
  # date $2, committer date $3 (defaults to $2).
  echo "$1" >> f
  git add f
  GIT_AUTHOR_DATE="$2" GIT_COMMITTER_DATE="${3:-$2}" \
    git commit -qn -S -m "$1"
}

function _gs_unsigned_count {
  # Count commits in HEAD's unpushed range lacking a gpgsig header. Same
  # pipeline-free predicate as the code under test: a bare `grep -q '^gpgsig'`
  # under pipefail SIGPIPEs the producer, so a signed commit reads as
  # unsigned. An oracle that disagrees with the code masks defects (2026-08-08).
  local sha out n=0
  for sha in $(git rev-list HEAD --not --remotes); do
    out="$(git cat-file commit "${sha}")"
    [[ $'\n'"${out%%$'\n\n'*}" == *$'\n'gpgsig\ * ]] || n=$(( n + 1 ))
  done
  echo "${n}"
}

# Fixture templates (2026-09-29). A sandbox build is ~30 process spawns at
# ~6 ms each (2026-09-29) and this suite builds 19, most of a 39 s run. Each
# shape is built once per run into ${_GS_TEMPLATES} by run_git_sign (the
# parent shell: builders run in $(...) subshells, so a lazy build there would
# not persist) and copied per call, re-pointing the three absolute paths that
# reference the template (signing key, origin URL, hooksPath). Fixed commit
# dates keep SHAs stable; cases compare SHAs within their own copy only.
typeset -g _GS_TEMPLATES=""

function _gs_build_templates {
  _GS_TEMPLATES="$(mktemp -d "${TMPDIR}git-sign-templates.XXXXXX")"
  mkdir "${_GS_TEMPLATES}/newrepo" "${_GS_TEMPLATES}/prepush"
  _gs_build_newrepo "${_GS_TEMPLATES}/newrepo"
  _gs_build_prepush_repo "${_GS_TEMPLATES}/prepush"
}

function _gs_copy_template {
  # $1 template name, $2 destination sandbox (exists). `cp -R src/. dst/`
  # copies the contents, keeping the key's 0600 mode.
  local name="$1" dest="$2"
  cp -R "${_GS_TEMPLATES}/${name}/." "${dest}/"
  (
    export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
    cd "${dest}/repo" || exit 1
    git config user.signingkey "${dest}/key"
    git remote set-url origin "${dest}/remote.git"
    if [[ -d "${dest}/hooks" ]]; then
      git config core.hooksPath "${dest}/hooks"
    fi
  )
}

function _gs_newrepo {
  # Sandbox repo with a pushed base commit. $1 = sandbox dir. Echoes repo path.
  local sandbox="$1"
  _gs_copy_template newrepo "${sandbox}"
  echo "${sandbox}/repo"
}

function _gs_build_newrepo {
  # The newrepo shape, built from scratch into $1.
  local sandbox="$1"
  (
    export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
    cd "${sandbox}" || exit 1
    ssh-keygen -t ed25519 -N '' -q -f key
    git init --bare -q remote.git
    git -c init.defaultBranch=main init -q repo
    cd repo || exit 1
    git config user.name t
    git config user.email t@example.invalid
    git config gpg.format ssh
    git config user.signingkey "${sandbox}/key"
    git config commit.gpgsign true
    git config core.hooksPath /dev/null
    _gs_commit base '2026-02-01T10:00:00+00:00'
    git remote add origin "${sandbox}/remote.git"
    git push -qu origin main 2>/dev/null
  )
}

function _gs_prepush_repo {
  # Sandbox repo whose core.hooksPath holds ONLY the global pre-push hook: git's
  # real hook path without the pre-commit scanner (gitleaks + PII) on every
  # fixture commit. $1 = sandbox dir.
  local sb="$1"
  _gs_copy_template prepush "${sb}"
  echo "${sb}/repo"
}

function _gs_build_prepush_repo {
  # The prepush shape, built from scratch into $1.
  local sb="$1"
  (
    export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
    export PII_HOOK_PATTERNS=/dev/null PII_HOOK_SSH_CONFIG=/dev/null
    mkdir -p "${sb}/hooks"
    # pii-scan rides along: pre-push resolves it as a sibling (${0:A:h});
    # without it the message gate is command-not-found and every push blocks
    # for the wrong reason.
    cp "${SCRIPT_DIR}/.config/git/hooks/pre-push" \
       "${SCRIPT_DIR}/.config/git/hooks/pii-scan" \
       "${SCRIPT_DIR}/.config/git/hooks/commit-signatures" "${sb}/hooks/"
    chmod 755 "${sb}/hooks/pre-push" "${sb}/hooks/pii-scan" "${sb}/hooks/commit-signatures"
    cd "${sb}" || exit 1
    ssh-keygen -t ed25519 -N '' -q -f key
    git init --bare -q remote.git
    git -c init.defaultBranch=main init -q repo
    cd repo || exit 1
    git config user.name t
    git config user.email t@example.invalid
    git config gpg.format ssh
    git config user.signingkey "${sb}/key"
    git config commit.gpgsign true
    git config core.hooksPath "${sb}/hooks"
    git remote add origin "${sb}/remote.git"
    _gs_commit_signed base '2026-02-01T10:00:00+00:00'
    git push -qu origin main 2>/dev/null
  )
}

function _gs_quad_expect {
  # Drive the global pre-push directly with a crafted ref quad, for cases
  # `git push` cannot produce on demand: a remote_sha the local repo lacks, a
  # re-entry sentinel already exported, a ref stream over the pipe buffer.
  # git hands the hook exactly these quads.
  # $1 want (ALLOWED|BLOCKED), $2 label, $3 repo, $4 quad file or text,
  # rest = extra env assignments.
  local want="$1" label="$2" dir="$3" quad="$4"
  shift 4
  # `|| rc=$?`, never a bare subshell: under the harness's `set -e` a BLOCKED
  # case would abort the suite rather than fail one test.
  #
  # `env -u … "${GS_ENV[@]}"`, options BEFORE assignments: env stops parsing
  # options at the first `VAR=val`, so `env A=1 -u X cmd` execs `-u` and exits
  # 127, and every BLOCKED assertion would pass on a 127 that never reached the
  # hook. Pair each block with an allow-side control.
  local rc=0 got
  if [[ -f "${quad}" ]]; then
    ( cd "${dir}" && env -u GIT_GLOBAL_HOOKS_SEEN "${GS_ENV[@]}" "$@" \
        /bin/zsh "${SCRIPT_DIR}/.config/git/hooks/pre-push" origin "${dir}" < "${quad}" \
    ) >/dev/null 2>&1 || rc=$?
  else
    ( cd "${dir}" && print -r -- "${quad}" \
      | env -u GIT_GLOBAL_HOOKS_SEEN "${GS_ENV[@]}" "$@" \
        /bin/zsh "${SCRIPT_DIR}/.config/git/hooks/pre-push" origin "${dir}" \
    ) >/dev/null 2>&1 || rc=$?
  fi
  if (( rc == 0 )); then got=ALLOWED; else got=BLOCKED; fi
  if [[ "${got}" == "${want}" ]]; then
    _pass "pre-push ${want}: ${label}"
  else
    _fail "pre-push ${label} — expected ${want}, got ${got} (exit ${rc})"
  fi
}

function _gs_push_expect {
  # $1 want (ALLOWED|BLOCKED), $2 label, $3 cwd to run in, rest = command
  local want="$1" label="$2" dir="$3"
  shift 3
  local got
  if ( cd "${dir}" && env "${GS_ENV[@]}" "$@" ) >/dev/null 2>&1; then
    got=ALLOWED
  else
    got=BLOCKED
  fi
  if [[ "${got}" == "${want}" ]]; then
    _pass "pre-push ${want}: ${label}"
  else
    _fail "pre-push ${label} — expected ${want}, got ${got}"
  fi
}

function _gs_push_expect_notty {
  # Like _gs_push_expect, but under tests/lib's _run_no_tty (no controlling
  # terminal however the suite was invoked), for cases where GIT_SIGN_SKIP or
  # PII_HOOK_BYPASS must be REFUSED. $4 = a needle that MUST appear in the
  # output: BLOCKED alone also passes if the shim died for an unrelated reason.
  local want="$1" label="$2" dir="$3" needle="$4"
  shift 4
  local got out
  if out="$( cd "${dir}" && _run_no_tty env "${GS_ENV[@]}" "$@" 2>&1 )"; then
    got=ALLOWED
  else
    got=BLOCKED
  fi
  if [[ "${got}" != "${want}" ]]; then
    _fail "pre-push ${label} — expected ${want}, got ${got}: $(print -r -- "${out}" | /usr/bin/head -c 600)"
    return
  fi
  if [[ -n "${needle}" && "${out}" != *"${needle}"* ]]; then
    _fail "pre-push ${label} — ${want}, but output missing '${needle}': $(print -r -- "${out}" | /usr/bin/head -c 600)"
    return
  fi
  _pass "pre-push ${want}: ${label}"
}

function run_git_sign {
  _section "git-sign hook + git-sign-unpushed"

  # claude/ is gitignored and synced out of band: an absent hook means the sync
  # has not reached this machine. Skip THOSE cases, never the pre-push gate
  # cases (.config/git/hooks/pre-push is tracked).
  _gs_build_templates
  if [[ ! -f "${SCRIPT_DIR}/claude/hooks/git-sign-hook" ]]; then
    _skip "claude/hooks/git-sign-hook absent — claude/ not yet synced (pre-push cases still run)"
  elif ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
  else
    _git_sign_claude_cases
  fi

  _git_sign_resign_cases
  _git_sign_batch_cases
  _git_sign_prepush_cases
  /bin/rm -rf "${_GS_TEMPLATES}"
}

function _git_sign_claude_cases {
  local sandbox repo out resp
  sandbox="$(mktemp -d "${TMPDIR}git-sign-test.XXXXXX")"
  repo="$(_gs_newrepo "${sandbox}")"
  (
    export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
    cd "${repo}" || exit 1
    _gs_commit c1 '2026-02-02T11:00:00+00:00' '2026-03-02T11:00:00+00:00'
    _gs_commit c2 '2026-02-03T12:00:00+00:00' '2026-03-03T12:00:00+00:00'
  )

  # A signing refusal on a compound commit: the context parks the work and
  # hands off to git-sign-unpushed. It never echoes the command or a runnable
  # signing-disabled retry. The payload is raw JSON with `git` spelled git:
  # the hook's raw `*git*` probe cannot see it, so it must still be parsed.
  out="$(printf '%s' '{"hook_event_name":"PostToolUseFailure","tool_name":"Bash","cwd":"'"${repo}"'","tool_input":{"command":"git commit -m x && git push","description":"t"},"error":"Couldn'"'"'t sign message (signer): agent refused operation?"}' \
    | env "${GS_ENV[@]}" /bin/zsh "${SCRIPT_DIR}/claude/hooks/git-sign-hook")"
  if [[ "${out}" == *additionalContext* && "${out}" == *'NO ready-made retry'* && "${out}" == *'git-sign-unpushed'* \
        && "${out}" == *'chains, substitutes, or pushes'* && "${out}" != *'GIT_CONFIG_KEY_0=commit.gpgsign'* \
        && "${out}" != *'git commit -m x'* ]]; then
    _pass "CONTEXT(PostToolUseFailure): a refused compound commit parks the work, names git-sign-unpushed, echoes no retry"
  else
    _fail "compound refusal context malformed — got $(printf '%q' "${out}")"
  fi

  # A refusal with no visible git word (a wrapper script or a quoted shell
  # string hides the git command): the refusal text is the signal (2026-10-10).
  resp='Couldn'"'"'t sign message (signer): agent refused operation?
fatal: failed to write commit object'
  out="$(_gs_hook PostToolUseFailure 'sh .scratch/commit.sh' "${repo}" "${resp}")"
  if [[ "${out}" == *'NO ready-made retry'* && "${out}" == *'inside a script or shell string'* \
        && "${out}" != *'.scratch/commit.sh'* ]]; then
    _pass "CONTEXT(PostToolUseFailure): a refusal inside a wrapper script parks the work, never echoes the script"
  else
    _fail "wrapper-script refusal: ${out}"
  fi

  _gs_expect PASS PostToolUseFailure 'git commit -m x' "${repo}" 'error: pathspec did not match' \
    'an unrelated commit failure is left alone'

  # PostToolUse: nudge to re-sign before stacking more commits (2 unsigned
  # commits above the pushed base).
  _gs_expect CONTEXT PostToolUse 'git commit -m x' "${repo}" '' 'successful commit, unsigned debt present'

  # The nudge scope is what git-sign-unpushed can fix: an unsigned commit on
  # a branch that is not checked out must not trigger it.
  local scoperepo
  scoperepo="$(_gs_newrepo "$(mktemp -d "${TMPDIR}git-sign-scope.XXXXXX")")"
  (
    export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
    cd "${scoperepo}" || exit 1
    git checkout -q -b abandoned
    _gs_commit stray '2026-02-02T11:00:00+00:00'
    git checkout -q main
    _gs_commit_signed work '2026-02-03T12:00:00+00:00'
  )
  _gs_expect PASS PostToolUse 'git commit -m x' "${scoperepo}" '' \
    'another branch does not trigger the re-sign nudge'
  /bin/rm -rf "${scoperepo:h}" "${sandbox}"
}

function _git_sign_resign_cases {
  local n

  # --- Re-sign: an unsigned commit BELOW signed ones rewrites all of them ---
  # Author dates survive (the committer dates differ, so the check is not
  # vacuous) and the pushed base is untouched.
  local costrepo before_dates after_dates
  costrepo="$(_gs_newrepo "$(mktemp -d "${TMPDIR}git-sign-cost.XXXXXX")")"
  (
    export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
    cd "${costrepo}" || exit 1
    _gs_commit deep '2026-02-02T11:00:00+00:00' '2026-03-02T11:00:00+00:00'
    _gs_commit_signed mid '2026-02-03T12:00:00+00:00'
    _gs_commit_signed tip '2026-02-04T13:00:00+00:00'
  )
  before_dates="$(env "${GS_ENV[@]}" git -C "${costrepo}" log --format='%aI' origin/main..HEAD)"
  (cd "${costrepo}" && env "${GS_ENV[@]}" "${SCRIPT_DIR}/bin/git-sign-unpushed" >/dev/null)
  n="$(cd "${costrepo}" && export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null && _gs_unsigned_count)"
  after_dates="$(env "${GS_ENV[@]}" git -C "${costrepo}" log --format='%aI' origin/main..HEAD)"
  if [[ "${n}" == "0" && "${after_dates}" == "${before_dates}" && "$(env "${GS_ENV[@]}" git -C "${costrepo}" rev-parse origin/main)" == \
        "$(env "${GS_ENV[@]}" git -C "${costrepo}" rev-parse 'HEAD~3')" ]]; then
    _pass "git-sign-unpushed clears a buried unsigned commit, keeps author dates and the pushed base"
  else
    _fail "buried re-sign: ${n} unsigned left, dates '${after_dates//$'\n'/ }' vs '${before_dates//$'\n'/ }'"
  fi
  /bin/rm -rf "${costrepo:h}"

  # --- Re-sign: dirty worktree -> temporary worktree, dirty file untouched ---
  local drepo dout dtip_before dtip_after dn
  drepo="$(_gs_newrepo "$(mktemp -d "${TMPDIR}git-sign-dirty.XXXXXX")")"
  (
    export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
    cd "${drepo}" || exit 1
    _gs_commit d1 '2026-02-02T11:00:00+00:00'
    _gs_commit d2 '2026-02-03T12:00:00+00:00'
    echo staged >> f && git add f
    echo dirty >> f
  )
  dtip_before="$(env "${GS_ENV[@]}" git -C "${drepo}" rev-parse HEAD)"
  dout="$(cd "${drepo}" && env "${GS_ENV[@]}" "${SCRIPT_DIR}/bin/git-sign-unpushed" 2>&1)" || dout="FAILED: ${dout}"
  dn="$(cd "${drepo}" && export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null && _gs_unsigned_count)"
  dtip_after="$(env "${GS_ENV[@]}" git -C "${drepo}" rev-parse HEAD)"
  if [[ "${dout}" == *'temporary worktree'* && "${dout}" != FAILED* && "${dn}" == "0" && "${dtip_after}" != "${dtip_before}" \
        && "$(tail -1 "${drepo}/f")" == dirty ]] \
     && ! env "${GS_ENV[@]}" git -C "${drepo}" diff --cached --quiet -- f \
     && ! env "${GS_ENV[@]}" git -C "${drepo}" diff --quiet -- f \
     && [[ "$(env "${GS_ENV[@]}" git -C "${drepo}" worktree list | wc -l | tr -d ' ')" == 1 ]]; then
    _pass "dirty-tree re-sign: signed tip, staged and unstaged edits kept, temporary worktree removed"
  else
    _fail "dirty-tree re-sign: ${dn} unsigned, tip ${dtip_before:0:7} -> ${dtip_after:0:7}: ${dout}"
  fi
  /bin/rm -rf "${drepo:h}"

  # --- No remote: replay must start at the deepest UNSIGNED commit ---
  # `--not --remotes` excludes nothing without a remote, so every commit counts
  # as unpushed; basing the rebase on the deepest *unpushed* commit rebased from
  # --root and re-signed everything (measured 2026-08-08: 2 unsigned tips in a
  # 12-commit history = 12 picks). Built from the prepush template (a SIGNED
  # base commit) with its only remote removed.
  local norepo old_head picks
  norepo="$(_gs_prepush_repo "$(mktemp -d "${TMPDIR}git-sign-noremote.XXXXXX")")"
  (
    export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
    cd "${norepo}" || exit 1
    git remote remove origin || exit 1
    _gs_commit_signed old2 '2026-02-02T10:00:00+00:00'
    _gs_commit_signed old3 '2026-02-03T10:00:00+00:00'
    _gs_commit u1 '2026-02-04T10:00:00+00:00'
    _gs_commit u2 '2026-02-05T10:00:00+00:00'
  )
  old_head="$(env "${GS_ENV[@]}" git -C "${norepo}" rev-parse 'HEAD~2')"
  (cd "${norepo}" && env "${GS_ENV[@]}" "${SCRIPT_DIR}/bin/git-sign-unpushed" >/dev/null)
  # `|| true`: under pipefail a zero-match grep would abort the suite, not fail
  # one assertion.
  picks="$(env "${GS_ENV[@]}" git -C "${norepo}" reflog --all | grep -c 'rebase (pick)' || true)"
  if [[ "${picks}" == "2" && "$(env "${GS_ENV[@]}" git -C "${norepo}" rev-parse 'HEAD~2')" == "${old_head}" ]]; then
    _pass "no remote: only the 2 unsigned commits are replayed, signed history below keeps its SHAs"
  else
    _fail "no remote: expected 2 rebase picks and unchanged signed history, got ${picks} picks"
  fi
  /bin/rm -rf "${norepo:h}"

  # --- Refusing to rewrite a SHA published on a SECOND remote ---
  # Candidates come from HEAD --not --remotes, not merge-base(HEAD,
  # @{upstream})..HEAD, which excludes only the UPSTREAM's history: a commit
  # already pushed to another remote would be rewritten (reproduced 2026-08-08).
  local tworem b_sha
  tworem="$(_gs_newrepo "$(mktemp -d "${TMPDIR}git-sign-tworemote.XXXXXX")")"
  (
    export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
    cd "${tworem}" || exit 1
    git init --bare -q "${tworem:h}/backup.git"
    git remote add backup "${tworem:h}/backup.git"
    _gs_commit B '2026-02-02T10:00:00+00:00'
    git push -q backup main:topic 2>/dev/null
    git fetch -q backup
    _gs_commit C '2026-02-03T10:00:00+00:00'
  )
  b_sha="$(env "${GS_ENV[@]}" git -C "${tworem}" rev-parse 'HEAD^')"
  (cd "${tworem}" && env "${GS_ENV[@]}" "${SCRIPT_DIR}/bin/git-sign-unpushed" >/dev/null 2>&1)
  if env "${GS_ENV[@]}" git -C "${tworem}" merge-base --is-ancestor "${b_sha}" HEAD 2>/dev/null; then
    _pass "commit published on a second remote is not rewritten"
  else
    _fail "rewrote ${b_sha}, which is published on backup/topic"
  fi
  /bin/rm -rf "${tworem:h}"
}

function _git_sign_batch_cases {
  local sandbox repo signed unsigned out rc
  sandbox="$(mktemp -d "${TMPDIR}git-sign-batch.XXXXXX")"
  repo="$(_gs_newrepo "${sandbox}")"
  (
    export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
    cd "${repo}" || exit 1
    _gs_commit_signed signed '2026-02-02T10:00:00+00:00'
    _gs_commit $'unsigned\n\ngpgsig forged message header' '2026-02-03T10:00:00+00:00'
  )
  signed="$(git -C "${repo}" rev-parse 'HEAD^')"
  unsigned="$(git -C "${repo}" rev-parse HEAD)"
  local scanner="${SCRIPT_DIR}/.config/git/hooks/commit-signatures"
  out="$(cd "${repo}" && "${scanner}" <<< "${signed}"$'\n'"${unsigned}"$'\n'"${unsigned}"$'\n'"${signed}")"
  if [[ "${out}" == "${unsigned}" ]]; then
    _pass "batch signatures: deduplicates and distinguishes headers from message text"
  else
    _fail "batch signatures: wrong unsigned commit list"
  fi

  # Real Git's missing-object response has exit 0; the parser must reject it.
  local missing="${signed//?/0}"
  rc=0
  (cd "${repo}" && "${scanner}" <<< "${missing}") >/dev/null 2>&1 || rc=$?
  if (( rc == 2 )); then
    _pass "batch signatures: missing object fails closed"
  else
    _fail "batch signatures: missing object returned ${rc}"
  fi
  /bin/rm -rf "${sandbox}"
}

function _git_sign_prepush_cases {
  # --- pre-push: the actual enforcement boundary ---
  local ppa ppd ppf msgpat
  ppa="$(_gs_prepush_repo "$(mktemp -d "${TMPDIR}git-sign-ppa.XXXXXX")")"
  (
    export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
    cd "${ppa}" || exit 1; _gs_commit u1 '2026-02-03T10:00:00+00:00'
  )
  _gs_push_expect BLOCKED "unsigned commit on the pushed branch" "${ppa}" git push origin main
  # GIT_SIGN_SKIP=1 needs a controlling terminal (pii-scan --check-terminal):
  # without one it is refused, and the push still blocks.
  _gs_push_expect_notty BLOCKED "GIT_SIGN_SKIP=1 is refused without a terminal" "${ppa}" \
    "ignored: no controlling terminal" env GIT_SIGN_SKIP=1 git push origin main
  /bin/rm -rf "${ppa:h}"

  # A signed commit larger than the pipe buffer must not read as unsigned.
  ppd="$(_gs_prepush_repo "$(mktemp -d "${TMPDIR}git-sign-ppd.XXXXXX")")"
  (
    export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
    cd "${ppd}" || exit 1
    # shellcheck disable=SC2034  # read by the zsh pad flag below
    typeset empty=''
    # shellcheck disable=SC2296  # zsh left-pad flag
    print -rn -- "${(l:300000::x:)empty}" > big.txt
    echo tick >> f
    git add f big.txt
    git commit -qn -S -F big.txt
  )
  _gs_push_expect ALLOWED "300KB signed commit is not misread as unsigned" "${ppd}" git push origin main
  /bin/rm -rf "${ppd:h}"

  # --- pre-push outgoing-message PII gate ---
  # A signed commit whose message holds a denylist word. `-n` bypasses
  # commit-msg deliberately: pre-push must catch what the commit-time gate
  # missed. The word is a seam pattern, not a real value.
  ppf="$(_gs_prepush_repo "$(mktemp -d "${TMPDIR}git-sign-ppf.XXXXXX")")"
  msgpat="$(mktemp "${TMPDIR}git-sign-msgpat.XXXXXX")"
  echo "zorblefrobnicate" > "${msgpat}"
  (
    export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
    export PII_HOOK_PATTERNS=/dev/null PII_HOOK_SSH_CONFIG=/dev/null
    cd "${ppf}" || exit 1
    echo m1 >> f; git add f
    git commit -qn -S -m "redeployed zorblefrobnicate to prod"
  )
  _gs_push_expect BLOCKED "PII in an outgoing commit message" "${ppf}" \
    env PII_HOOK_PATTERNS="${msgpat}" git push origin main
  /bin/rm -rf "${ppf:h}" "${msgpat}"

  # --- Gate bypasses (2026-08-08), driven with crafted ref quads ---
  # Each case once passed through the gate; common root cause: the gate
  # trusted a git invocation's *output* without checking its *status*, or
  # matched a pattern too loosely to be a signature. One fixture repo: an
  # unsigned tip commit and an unsigned annotated tag over the signed base.
  local zero=0000000000000000000000000000000000000000
  local ghost=0000000000000000000000000000000000000001
  local gq gqtip gqbase gqtag gqdir
  gq="$(_gs_prepush_repo "$(mktemp -d "${TMPDIR}git-sign-quad.XXXXXX")")"
  gqbase="$(env "${GS_ENV[@]}" git -C "${gq}" rev-parse HEAD)"
  ( cd "${gq}" && _gs_commit unsigned-tip '2026-02-02T10:00:00+00:00' )
  gqtip="$(env "${GS_ENV[@]}" git -C "${gq}" rev-parse HEAD)"
  gqdir="$(env "${GS_ENV[@]}" git -C "${gq}" rev-parse --absolute-git-dir)"
  env "${GS_ENV[@]}" git -C "${gq}" config tag.gpgsign true
  env "${GS_ENV[@]}" git -C "${gq}" -c tag.gpgsign=false tag -a v1 -m unsigned-tag "${gqbase}"
  gqtag="$(env "${GS_ENV[@]}" git -C "${gq}" rev-parse v1)"

  # A failed revision walk must not read as "no unsigned commits". git derives
  # remote_sha from the remote's LIVE advertised refs, not the local
  # remote-tracking cache, so a diverged force-push hands the hook a range
  # whose left side it lacks: `fatal: bad object` → empty output → exit 0.
  _gs_quad_expect BLOCKED "a revision walk that fails is not a silent pass" \
    "${gq}" "refs/heads/main ${gqtip} refs/heads/main ${ghost}"

  # An annotated tag carries its signature in the TAG object, appended after
  # the message rather than as a header, so peeling to commits cannot see it.
  _gs_quad_expect BLOCKED "an unsigned annotated tag over a signed commit is gated" \
    "${gq}" "refs/tags/v1 ${gqtag} refs/tags/v1 ${zero}"

  # Re-entry must suppress the CHAINED hook only, never the scan: the sentinel
  # is exported before the scan runs, so a repo pre-push hook that pushed the
  # same repo inherited it and published unsigned commits unexamined.
  _gs_quad_expect BLOCKED "an already-exported sentinel does not skip the scan" \
    "${gq}" "refs/heads/main ${gqtip} refs/heads/main ${zero}" \
    "GIT_GLOBAL_HOOKS_SEEN=pre-push@${gqdir}"

  # stdin replay to the chained hook must not be a pipeline: under pipefail a
  # repo hook that exits 0 without draining a large ref stream SIGPIPEs the
  # producer and the gate returned 141, blocking a push the repo hook allowed.
  # All-zero local shas (branch deletions) keep it on the replay path with no
  # per-ref git forks. `--absolute-git-dir`, NOT `--git-common-dir`: the latter
  # answers `.git` RELATIVE, so a fixture path built from it outside the repo
  # would write this very repo's `.git/hooks/pre-push`.
  local stream
  mkdir -p "${gqdir}/hooks"
  printf '#!/bin/zsh\nexit 0\n' > "${gqdir}/hooks/pre-push"
  chmod 755 "${gqdir}/hooks/pre-push"
  stream="${gq:h}/stream"
  awk -v z="${zero}" -v b="${gqbase}" \
    'BEGIN{for(i=1;i<=800;i++) printf "refs/heads/b%d %s refs/heads/b%d %s\n", i, z, i, b}' \
    > "${stream}"
  _gs_quad_expect ALLOWED "a chained hook that ignores a 90 KB ref stream still allows the push" \
    "${gq}" "${stream}"
  /bin/rm -rf "${gq:h}"

  # --- A repo-local core.hooksPath must not silently opt out of the gate ---
  # This repo's core.hooksPath=.githooks SHADOWS the global hooks dir, so the
  # global pre-push gate does not fire here unless .githooks/pre-push chains
  # to it (2026-08-08). The fixture below mirrors that layout.
  local shadow
  shadow="$(_gs_prepush_repo "$(mktemp -d "${TMPDIR}git-sign-shadow.XXXXXX")")"
  (
    export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
    export PII_HOOK_PATTERNS=/dev/null PII_HOOK_SSH_CONFIG=/dev/null
    cd "${shadow}" || exit 1
    # Mirror the dotfiles layout: a repo-local hooksPath plus the chaining
    # stub. pii-scan rides along (see _gs_build_prepush_repo); without it the
    # internal push dies at 127 and, under set -e, takes the suite with it.
    mkdir -p .config/git/hooks .githooks
    cp "${SCRIPT_DIR}/.config/git/hooks/pre-push" \
       "${SCRIPT_DIR}/.config/git/hooks/pii-scan" \
       "${SCRIPT_DIR}/.config/git/hooks/commit-signatures" .config/git/hooks/
    cp "${SCRIPT_DIR}/.githooks/pre-push" .githooks/pre-push
    chmod 755 .config/git/hooks/pre-push .config/git/hooks/pii-scan .config/git/hooks/commit-signatures .githooks/pre-push
    git config core.hooksPath .githooks
    _gs_commit shadowed '2026-02-02T10:00:00+00:00'
  )
  _gs_push_expect BLOCKED "repo-local hooksPath still reaches the gate via the stub" \
    "${shadow}" git push origin main
  /bin/rm -rf "${shadow:h}"
}
