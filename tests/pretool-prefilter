#!/bin/zsh
# dotfiles/tests/pretool-prefilter
#
# Checks the prefilter mod (claude/mods/pretool-prefilter, a Claude Code
# function hook) against the zsh guards it fronts. The mod lets a Bash command
# through with no process start when it contains none of its TOKENS, none of
# its SYNTAX characters and no UV_SHAPE, and its cwd names no config root; it
# lets a Write/Edit/NotebookEdit through when writeNeedsDispatch() finds no
# trigger. Anything else runs claude/hooks/pretool-dispatch. The risk is a
# rule too narrow: a call a guard would deny slips past unguarded. So this
# suite
#   1. parses TOKENS out of hooks/register.ts and mirrors the Bash check in
#      zsh (_pf_needs_dispatch, _pf_cwd_needs_dispatch);
#   2. runs a denied command per bypass class through the real dispatcher
#      (must DENY) and the mirror (must dispatch): a plain deny, a backslash
#      rm, decoration inside a token, a publish shape with no literal gh, a
#      letter whose zsh case fold is ASCII, a uv-guard shape no token
#      carries, the bare CLT python path, a token-free command from a cwd in
#      a config root;
#   3. checks that other non-ASCII text and a token-free command pass the
#      dispatcher and skip it in the mod;
#   4. runs a denied write per write guard through the dispatcher (must DENY)
#      and the real writeNeedsDispatch() via node (must dispatch), and a
#      trigger-free write through both (skipped when node cannot import it);
#   5. checks the deployed dispatcher and mod link exist;
#   6. runs the mod's own TypeScript tests via `claude plugin test`.
# Each case feeds one input to the code under test.
# Fixture tokens are assembled at run time (same convention as the hook
# suites). Skips when claude/ is not synced to this machine.
#
# Run: ./test pretool-prefilter
# ShellCheck: lint with `shellcheck --shell=bash tests/pretool-prefilter`.
# This file is sourced, not executed: chmod 644.
#
# shellcheck source=tests/lib
# shellcheck disable=SC2154  # SCRIPT_DIR is set by the sourcing dispatcher

typeset -g PF_MOD='' PF_SRC='' PF_SB=''
typeset -ga PF_TOKENS=()

function _pf_load_tokens {
  # Fills PF_TOKENS from the `const TOKENS` array literal in register.ts: one
  # quoted string per line until the closing bracket.
  local line in=0
  local re="^[[:space:]]*'([^']+)',?[[:space:]]*$"
  PF_TOKENS=()
  while IFS= read -r line; do
    if (( in == 0 )); then
      [[ "${line}" == "const TOKENS"* ]] && in=1
      continue
    fi
    [[ "${line}" == ']'* ]] && break
    [[ "${line}" =~ ${re} ]] || continue
    # shellcheck disable=SC2154  # zsh fills match[] on =~
    PF_TOKENS+=("${match[1]}")
  done < "${PF_SRC}"
}

function _pf_needs_dispatch {
  # Mirrors needsDispatch() in register.ts. $1 = command. 0 = dispatch.
  local cmd="$1" lower stripped tok seq
  # SYNTAX: a control character other than tab, newline and CR, or one of
  # the four letters whose zsh case fold is ASCII (U+0130, U+0131, U+017F,
  # U+212A). Byte-wise under the C locale: the letters as their UTF-8 byte
  # sequences, so the caller's locale does not matter. A NUL is tested first
  # because zsh's =~ stops at one. The mod's lone-surrogate check has no
  # UTF-8 form, so the mod's own tests cover it.
  local LC_ALL=C
  [[ "${cmd}" == *$'\0'* ]] && return 0
  [[ "${cmd}" =~ $'[\x01-\x08\x0b\x0c\x0e-\x1f\x7f]' ]] && return 0
  for seq in $'\xc4\xb0' $'\xc4\xb1' $'\xc5\xbf' $'\xe2\x84\xaa'; do
    [[ "${cmd}" == *"${seq}"* ]] && return 0
  done
  # shellcheck disable=SC2296  # zsh (L) lower-cases
  lower="${(L)cmd}"
  # gh-publish's publish-shape backstop, bounded as the guard bounds it.
  local start=$'(^|[[:space:]\'"(;|&{}`])'
  local publish="${start}(pr([[:space:]'\"-]|create|edit|comment|review|close|reopen|merge|upload|new|revert|transfer)|api([[:space:]'\"-]|graphql))"
  [[ "${lower}" =~ ${publish} ]] && return 0
  # ... and on the guard's own probe text: backslash-newline joined, then
  # quotes and backslashes deleted (gh-publish-hook _gp_joined/_gp_probe).
  local probe="${lower//\\$'\n'/}"
  probe="${probe//[\\\'\"]/}"
  [[ "${probe}" =~ ${publish} ]] && return 0
  # uv-guard's shapes behind its bare pip and venv probe (the mod's UV_SHAPE),
  # on the probe text, then on the stripped text.
  local uv='pip[[:space:][:digit:]]|-[a-z]*m[[:space:]]*(pip|venv)'
  [[ "${probe}" =~ ${uv} ]] && return 0
  # Decoration deleted (quotes, backslashes, $ ( ) backtick, newline), as the
  # mod's DECORATION regex does, then the substring check.
  stripped="${lower//[\\\'\"\$()\`$'\n']/}"
  [[ "${stripped}" =~ ${uv} ]] && return 0
  # shellcheck disable=SC2034  # read through the (L) expansion below
  for tok in "${PF_TOKENS[@]}"; do
    # shellcheck disable=SC2296
    [[ "${stripped}" == *"${(L)tok}"* ]] && return 0
  done
  return 1
}

function _pf_cwd_needs_dispatch {
  # Mirrors cwdNeedsDispatch() in register.ts. $1 = cwd. 0 = dispatch.
  local LC_ALL=C cwd="$1"
  [[ "${cwd}" == *$'\0'* || "${cwd}" =~ $'[^\x20-\x7e]' ]] && return 0
  # shellcheck disable=SC2296  # zsh (L) lower-cases
  [[ "${(L)cwd}" == *.claude* || "${(L)cwd}" == *.codex* || "${(L)cwd}" == *muse* ]]
}

function _pf_bash {
  # $1 = command, $2 = cwd (default /work).
  jq -cn --arg c "$1" --arg d "${2:-/work}" '{tool_name:"Bash", tool_input:{command:$c}, cwd:$d}'
}

function _pf_write_needs_dispatch {
  # Asks the real writeNeedsDispatch() in register.ts. $1 = tool_input JSON,
  # $2 = cwd. 0 = dispatch, 1 = skip, 2 = node could not answer.
  local out
  out="$(printf '%s' "$1" | node "${PF_SB}/write-rule.mjs" "${PF_SRC}" "$2" 2>/dev/null)" || return 2
  [[ "${out}" == 1 ]] && return 0
  [[ "${out}" == 0 ]] && return 1
  return 2
}

function _pf_try_write {
  # $1 = label, $2 = DENY or PASS, $3 = tool, $4 = tool_input JSON, $5 = cwd.
  # DENY: the dispatcher must deny it and the rule must dispatch it. PASS:
  # the dispatcher must pass it and the rule must skip it.
  local label="$1" want="$2" tool="$3" input="$4" cwd="$5" verdict rc=0
  verdict="$(_pf_dispatch "$(jq -cn --arg t "${tool}" --argjson i "${input}" --arg d "${cwd}" '{tool_name:$t, tool_input:$i, cwd:$d}')")"
  [[ "${verdict}" == "${want}" ]] || _pf_flag "dispatcher gives ${verdict}, not ${want}, for ${label}"
  _pf_write_needs_dispatch "${input}" "${cwd}" || rc=$?
  if (( rc == 2 )); then
    _pf_flag "node could not answer for ${label}"
  elif [[ "${want}" == DENY ]] && (( rc != 0 )); then
    _pf_flag "write rule would SKIP a denied write: ${label}"
  elif [[ "${want}" == PASS ]] && (( rc != 1 )); then
    _pf_flag "write rule dispatches a trigger-free write: ${label}"
  fi
}

function _pf_dispatch {
  # $1 = payload; remaining args = VAR=value pairs. Prints the verdict word.
  # The pairs are exported inside the substitution's own subshell, so they
  # reach only the dispatcher and no env process is started.
  local payload="$1" out rc=0
  shift
  out="$(
    local kv
    for kv in "$@"; do
      # shellcheck disable=SC2163  # exports the NAME=value pair itself
      export "${kv}"
    done
    printf '%s' "${payload}" | /bin/zsh "${SCRIPT_DIR}/claude/hooks/pretool-dispatch" 2>/dev/null
  )" || rc=$?
  # The dispatcher's PASS is exit 0 and empty stdout; any other exit status
  # (2 = could not judge) is INVALID here even when stdout is empty.
  if (( rc != 0 )); then
    printf 'INVALID\n'
    return 0
  fi
  _hook_verdict "${out}"
}


typeset -g PF_BAD=''

# A case collects its problems with _pf_flag and reports once with _pf_done.
function _pf_flag {
  PF_BAD+="$1; "
}

function _pf_done {
  if [[ -z "${PF_BAD}" ]]; then
    _pass "$1"
  else
    _fail "$1 — ${PF_BAD}"
  fi
  PF_BAD=''
}

function _pf_try_deny {
  # $1 = label, $2 = Bash command; remaining args = env pairs. The dispatcher
  # must DENY it and the mirror must dispatch it (else the mod skips a deny).
  local label="$1" cmd="$2" verdict
  shift 2
  verdict="$(_pf_dispatch "$(_pf_bash "${cmd}")" "$@")"
  [[ "${verdict}" == DENY ]] || _pf_flag "dispatcher does not deny ${label} (got ${verdict})"
  _pf_needs_dispatch "${cmd}" || _pf_flag "prefilter would SKIP a denied command: ${label}"
}

function _pf_try_pass {
  # $1 = label, $2 = Bash command. The dispatcher must PASS it and the mirror
  # must not dispatch it (the zero-exec path).
  local verdict
  verdict="$(_pf_dispatch "$(_pf_bash "$2")")"
  [[ "${verdict}" == PASS ]] || _pf_flag "dispatcher does not pass $1 (got ${verdict})"
  ! _pf_needs_dispatch "$2" || _pf_flag "prefilter dispatches a token-free command: $1"
}

function _pf_shape {
  _section "pretool-prefilter: deployed mod"
  # The engine loads the mod from ~/.claude/mods/<name>: a missing or stale
  # link is a silent unload (every guard off). Checked only where ~/.claude
  # is deployed from this checkout, like tests/hook-links.
  [[ -x "${HOME}/.claude/hooks/pretool-dispatch" ]] || _pf_flag "\$HOME/.claude/hooks/pretool-dispatch missing or not executable: run ./bittersweet dotfiles"
  if [[ "$(readlink "${HOME}/.claude/settings.json" 2>/dev/null)" == "${SCRIPT_DIR}/claude/settings.json" ]]; then
    if [[ "$(readlink "${HOME}/.claude/mods/pretool-prefilter" 2>/dev/null)" != "${PF_MOD}" || ! -r "${HOME}/.claude/mods/pretool-prefilter/hooks/register.ts" ]]; then
      _pf_flag "\$HOME/.claude/mods/pretool-prefilter is missing or does not link to ${PF_MOD}: run ./bittersweet dotfiles"
    fi
  fi
  _pf_done "the deployed dispatcher is executable and, where ~/.claude is deployed from this checkout, the mod link resolves to this repo's mod"
}

function _pf_cases {
  local gpdir="${PF_SB}/gp" verdict
  local -a gh_env

  _section "pretool-prefilter: denied commands are dispatched, token-free ones are not"

  zf_mkdir -p "${gpdir}/gh"
  print -r -- 'FIXTURE_TOKEN' > "${gpdir}/patterns"
  print -r -- 'Host testalias99' > "${gpdir}/sshcfg"
  : > "${gpdir}/gh/config.yml"
  gh_env=("GH_PUBLISH_PATTERNS=${gpdir}/patterns" "GH_PUBLISH_SSH_CONFIG=${gpdir}/sshcfg" GH_PUBLISH_NO_GITLEAKS=1 GH_PUBLISH_NO_IDENTITY=1 "GH_PUBLISH_OS=7.7:99Z999z" "GH_CONFIG_DIR=${gpdir}/gh")

  _pf_try_deny 'git-bypass: git commit -n' 'git commit -n'
  _pf_done "git commit -n is denied by the dispatcher and dispatched by the prefilter"
  _pf_try_deny 'rm-redirect: backslash rm' '\rm foo.txt'
  _pf_done "a backslash rm is denied by the dispatcher and dispatched by the prefilter"
  # Decoration cannot split a token: the guards delete it before probing.
  # shellcheck disable=SC2016  # literal command text
  _pf_try_deny 'git-bypass: $() inside git' 'gi$()t commit -n'
  _pf_done "a command substitution inside git cannot hide it from the prefilter"
  # The publish-shape backstop needs no literal gh.
  # shellcheck disable=SC2016  # literal command text
  _pf_try_deny 'gh-publish: variable command word, pr create' 'eval "$G pr create -t x --body y"' "${gh_env[@]}"
  _pf_done "a gh publish shape with no literal gh is denied and dispatched"

  # A letter whose zsh case fold is ASCII: git-bypass lowers g<U+0130>t to
  # git. The fold needs a UTF-8 locale in the dispatcher, so the case pins one.
  _pf_try_deny 'git-bypass: U+0130 inside git' $'g\xc4\xb0t commit -n' LC_ALL=en_US.UTF-8
  _pf_done "a letter whose zsh case fold is ASCII cannot hide a token from the prefilter"
  # uv-guard's probe is a bare *pip* and *venv*: a tab after pip is a shape
  # no substring token carries (UV_SHAPE covers it).
  _pf_try_deny 'uv-guard: tab after pip' $'pip\tinstall requests'
  _pf_done "a uv-guard shape that no token carries is denied and dispatched"
  _pf_try_deny 'uv-guard: bare CLT python path' '/usr/bin/python script.py'
  _pf_done "the bare CLT python path is denied and dispatched"
  # config-root judges a whole command when the cwd is under a config root.
  verdict="$(_pf_dispatch "$(_pf_bash 'echo x > settings.json' "${HOME}/.claude")")"
  [[ "${verdict}" == DENY ]] || _pf_flag "dispatcher does not deny a token-free write from a cwd in ~/.claude (got ${verdict})"
  ! _pf_needs_dispatch 'echo x > settings.json' || _pf_flag "the fixture holds a token, so it does not test the cwd rule"
  _pf_cwd_needs_dispatch "${HOME}/.claude" || _pf_flag "prefilter would SKIP a token-free write from a cwd in ~/.claude"
  ! _pf_cwd_needs_dispatch /work || _pf_flag "prefilter dispatches on an ordinary cwd"
  _pf_done "a token-free command from a cwd in a config root is denied and dispatched on the cwd alone"

  _pf_try_pass 'non-ASCII text' $'echo caf\xc3\xa9 \xe2\x80\x94 a\xc2\xa0b'
  _pf_done "other non-ASCII text, a no-break space included, passes the dispatcher and skips it in the prefilter"
  _pf_try_pass 'ls -la' 'ls -la'
  _pf_done "a token-free command passes the dispatcher and skips it in the prefilter"
}

function _pf_write_cases {
  _section "pretool-prefilter: denied writes are dispatched, trigger-free ones are not"
  if ! command -v node >/dev/null 2>&1; then
    _skip "node not on PATH: cannot ask writeNeedsDispatch()"
    return 0
  fi
  print -r -- "import { pathToFileURL } from 'node:url'
const [src, cwd] = process.argv.slice(2)
const m = await import(pathToFileURL(src).href)
let text = ''
for await (const chunk of process.stdin) text += chunk
process.stdout.write(m.writeNeedsDispatch(JSON.parse(text), cwd) ? '1' : '0')" > "${PF_SB}/write-rule.mjs"
  # A node that cannot import TypeScript skips the section rather than
  # failing every case.
  local probe_rc=0
  _pf_write_needs_dispatch '{"file_path":"/tmp/a","content":"x"}' /work || probe_rc=$?
  if (( probe_rc == 2 )); then
    _skip "node $(node --version 2>/dev/null) cannot import register.ts: cannot ask writeNeedsDispatch()"
    return 0
  fi

  # Fixture tokens assembled at run time: the literal would trip the guards
  # on this file's own edits.
  local md5call='hashlib.m' srv='mcp' proxy='mcp'
  md5call+='d5(b"x")'
  srv+='Servers'
  proxy+='-proxy'
  function w { jq -cn --arg p "$1" --arg c "$2" '{file_path:$p, content:$c}'; }

  _pf_try_write 'tmp-guard: Write into /tmp' DENY Write "$(w /tmp/a.txt x)" /work
  _pf_done "a Write into /tmp is denied and dispatched"
  _pf_try_write 'config-root: Write into ~/.claude' DENY Write "$(w "${HOME}/.claude/x.json" '{}')" /work
  _pf_done "a Write into ~/.claude is denied and dispatched"
  _pf_try_write 'config-root: relative Edit from a cwd in ~/.claude' DENY Edit \
    "$(jq -cn '{file_path:"x.json", old_string:"a", new_string:"b"}')" "${HOME}/.claude"
  _pf_done "a relative Edit from a cwd in ~/.claude is denied and dispatched"
  _pf_try_write 'md5-write: an MD5 call in code' DENY Write "$(w /work/a.py "import hashlib
${md5call}")" /work
  _pf_done "an MD5 call in written code is denied and dispatched"
  _pf_try_write 'mcp-secret: a header flag on the proxy in .mcp.json' DENY Write \
    "$(w /work/.mcp.json "{\"${srv}\":{\"a\":{\"command\":\"${proxy}\",\"args\":[\"-H\",\"x-api-key\",\"k\",\"u\"]}}}")" /work
  _pf_done "a proxy header flag in .mcp.json is denied and dispatched"
  # shellcheck disable=SC2016  # literal $Y in the fixture
  _pf_try_write 'mcp-secret: a $VAR in a -c string in settings.json (basename gate)' DENY Write \
    "$(w /work/settings.json '{"a":["-c","x $Y"]}')" /work
  _pf_done "a \$VAR in a -c string in settings.json is denied and dispatched (basename gate, no mcp text)"
  _pf_try_write 'a plain Edit with non-ASCII text' PASS Edit \
    "$(jq -cn --arg n $'caf\xc3\xa9 \xe2\x80\x94 ok' '{file_path:"/work/dir/a.txt", old_string:"a", new_string:$n}')" /work
  _pf_done "a trigger-free Edit passes the dispatcher and skips it in the prefilter"
  unfunction w
}

function _pf_plugin_tests {
  _section "pretool-prefilter: the mod's own tests"
  local out rc=0
  if ! command -v claude >/dev/null 2>&1; then
    _skip "claude CLI not on PATH: cannot run claude plugin test"
    return 0
  fi
  out="$(cd "${PF_MOD}" && claude plugin test . 2>&1)" || rc=$?
  local summary
  summary="$(print -r -- "${out}" | /usr/bin/grep -E '^ *[0-9]+ (pass|fail)$' | tr '\n' ' ')"
  if (( rc == 0 )) && [[ "${out}" == *" 0 fail"* ]]; then
    _pass "claude plugin test: ${summary}"
  else
    _fail "claude plugin test failed (rc ${rc}): ${summary:-$(print -r -- "${out}" | tail -n 3)}"
  fi
}

function run_pretool_prefilter {
  PF_MOD="${SCRIPT_DIR}/claude/mods/pretool-prefilter"
  PF_SRC="${PF_MOD}/hooks/register.ts"

  _section "pretool-prefilter mod"
  if [[ ! -f "${PF_SRC}" || ! -f "${SCRIPT_DIR}/claude/hooks/pretool-dispatch" ]]; then
    _skip "claude/mods/pretool-prefilter or claude/hooks/pretool-dispatch absent — claude/ not yet synced to this machine"
    return 0
  fi
  if ! command -v jq >/dev/null 2>&1; then
    _skip "jq not installed (brew install jq)"
    return 0
  fi

  PF_SB="$(mktemp -d "${TMPDIR:-/tmp}/pretool-prefilter.XXXXXX")"
  trap 'rm -rf -- "${PF_SB}"' EXIT

  zmodload -F zsh/files b:zf_mkdir
  _pf_load_tokens
  _pf_cases
  _pf_write_cases
  _pf_shape
  _pf_plugin_tests
  return 0
}
