#!/bin/zsh
# dotfiles/tests/pretool-prefilter
#
# Checks the prefilter mod (claude/mods/pretool-prefilter, a Claude Code
# function hook) against the zsh guards it fronts. The mod lets a Bash command
# through with no process start when it contains none of its TOKENS and none
# of its SYNTAX characters; anything else, and every Write/Edit/NotebookEdit,
# runs claude/hooks/pretool-dispatch. The risk is a token list too small: a
# command a guard would deny slips past unguarded. So this suite
#   1. parses TOKENS and SYNTAX out of hooks/register.ts and mirrors the
#      check in zsh (_pf_needs_dispatch);
#   2. runs a denied command per bypass class through the real dispatcher
#      (must DENY) and the mirror (must dispatch): a plain deny, a backslash
#      rm, decoration inside a token, a publish shape with no literal gh;
#   3. checks that a lone high byte dispatches under a UTF-8 locale and that a
#      token-free command passes the dispatcher and skips it in the mod;
#   4. checks the deployed dispatcher and mod link exist;
#   5. runs the mod's own TypeScript tests via `claude plugin test`.
# Each case feeds one input to the code under test.
# Fixture tokens are assembled at run time (same convention as the hook
# suites). Skips when claude/ is not synced to this machine.
#
# Run: ./test pretool-prefilter
# ShellCheck: lint with `shellcheck --shell=bash tests/pretool-prefilter`.
# This file is sourced, not executed: chmod 644.
#
# shellcheck source=tests/lib
# shellcheck disable=SC2154  # SCRIPT_DIR is set by the sourcing dispatcher

typeset -g PF_MOD='' PF_SRC='' PF_SB=''
typeset -ga PF_TOKENS=()

function _pf_load_tokens {
  # Fills PF_TOKENS from the `const TOKENS` array literal in register.ts: one
  # quoted string per line until the closing bracket.
  local line in=0
  local re="^[[:space:]]*'([^']+)',?[[:space:]]*$"
  PF_TOKENS=()
  while IFS= read -r line; do
    if (( in == 0 )); then
      [[ "${line}" == "const TOKENS"* ]] && in=1
      continue
    fi
    [[ "${line}" == ']'* ]] && break
    [[ "${line}" =~ ${re} ]] || continue
    # shellcheck disable=SC2154  # zsh fills match[] on =~
    PF_TOKENS+=("${match[1]}")
  done < "${PF_SRC}"
}

function _pf_needs_dispatch {
  # Mirrors needsDispatch() in register.ts. $1 = command. 0 = dispatch.
  local cmd="$1" lower stripped tok
  # Outside printable ASCII (+ tab, newline, CR): dispatch (lower-casing
  # differs between zsh and JS; controls are rare). Same class as SYNTAX;
  # a NUL is tested first because zsh's =~ stops at one. The C locale makes
  # the class byte-wise: under UTF-8 a lone high byte is a regex error, which
  # fell through where the mod dispatches.
  local LC_ALL=C
  [[ "${cmd}" == *$'\0'* ]] && return 0
  [[ "${cmd}" =~ $'[^\t\n\r\x20-\x7e]' ]] && return 0
  # shellcheck disable=SC2296  # zsh (L) lower-cases
  lower="${(L)cmd}"
  # gh-publish's publish-shape backstop, bounded as the guard bounds it.
  local start=$'(^|[[:space:]\'"(;|&{}`])'
  local publish="${start}(pr([[:space:]'\"-]|create|edit|comment|review|close|reopen|merge|upload|new|revert|transfer)|api([[:space:]'\"-]|graphql))"
  [[ "${lower}" =~ ${publish} ]] && return 0
  # ... and on the guard's own probe text: backslash-newline joined, then
  # quotes and backslashes deleted (gh-publish-hook _gp_joined/_gp_probe).
  local probe="${lower//\\$'\n'/}"
  probe="${probe//[\\\'\"]/}"
  [[ "${probe}" =~ ${publish} ]] && return 0
  # Decoration deleted (quotes, backslashes, $ ( ) backtick, newline), as the
  # mod's DECORATION regex does, then the substring check.
  stripped="${lower//[\\\'\"\$()\`$'\n']/}"
  # shellcheck disable=SC2034  # read through the (L) expansion below
  for tok in "${PF_TOKENS[@]}"; do
    # shellcheck disable=SC2296
    [[ "${stripped}" == *"${(L)tok}"* ]] && return 0
  done
  return 1
}

function _pf_bash {
  jq -cn --arg c "$1" '{tool_name:"Bash", tool_input:{command:$c}, cwd:"/work"}'
}

function _pf_dispatch {
  # $1 = payload; remaining args = VAR=value pairs. Prints the verdict word.
  # The pairs are exported inside the substitution's own subshell, so they
  # reach only the dispatcher and no env process is started.
  local payload="$1" out rc=0
  shift
  out="$(
    local kv
    for kv in "$@"; do
      # shellcheck disable=SC2163  # exports the NAME=value pair itself
      export "${kv}"
    done
    printf '%s' "${payload}" | /bin/zsh "${SCRIPT_DIR}/claude/hooks/pretool-dispatch" 2>/dev/null
  )" || rc=$?
  # The dispatcher's PASS is exit 0 and empty stdout; any other exit status
  # (2 = could not judge) is INVALID here even when stdout is empty.
  if (( rc != 0 )); then
    printf 'INVALID\n'
    return 0
  fi
  _hook_verdict "${out}"
}


typeset -g PF_BAD=''

# A case collects its problems with _pf_flag and reports once with _pf_done.
function _pf_flag {
  PF_BAD+="$1; "
}

function _pf_done {
  if [[ -z "${PF_BAD}" ]]; then
    _pass "$1"
  else
    _fail "$1 — ${PF_BAD}"
  fi
  PF_BAD=''
}

function _pf_try_deny {
  # $1 = label, $2 = Bash command; remaining args = env pairs. The dispatcher
  # must DENY it and the mirror must dispatch it (else the mod skips a deny).
  local label="$1" cmd="$2" verdict
  shift 2
  verdict="$(_pf_dispatch "$(_pf_bash "${cmd}")" "$@")"
  [[ "${verdict}" == DENY ]] || _pf_flag "dispatcher does not deny ${label} (got ${verdict})"
  _pf_needs_dispatch "${cmd}" || _pf_flag "prefilter would SKIP a denied command: ${label}"
}

function _pf_try_pass {
  # $1 = label, $2 = Bash command. The dispatcher must PASS it and the mirror
  # must not dispatch it (the zero-exec path).
  local verdict
  verdict="$(_pf_dispatch "$(_pf_bash "$2")")"
  [[ "${verdict}" == PASS ]] || _pf_flag "dispatcher does not pass $1 (got ${verdict})"
  ! _pf_needs_dispatch "$2" || _pf_flag "prefilter dispatches a token-free command: $1"
}

function _pf_shape {
  _section "pretool-prefilter: deployed mod"
  # The engine loads the mod from ~/.claude/mods/<name>: a missing or stale
  # link is a silent unload (every guard off). Checked only where ~/.claude
  # is deployed from this checkout, like tests/hook-links.
  [[ -x "${HOME}/.claude/hooks/pretool-dispatch" ]] || _pf_flag "\$HOME/.claude/hooks/pretool-dispatch missing or not executable: run ./bittersweet dotfiles"
  if [[ "$(readlink "${HOME}/.claude/settings.json" 2>/dev/null)" == "${SCRIPT_DIR}/claude/settings.json" ]]; then
    if [[ "$(readlink "${HOME}/.claude/mods/pretool-prefilter" 2>/dev/null)" != "${PF_MOD}" || ! -r "${HOME}/.claude/mods/pretool-prefilter/hooks/register.ts" ]]; then
      _pf_flag "\$HOME/.claude/mods/pretool-prefilter is missing or does not link to ${PF_MOD}: run ./bittersweet dotfiles"
    fi
  fi
  _pf_done "the deployed dispatcher is executable and, where ~/.claude is deployed from this checkout, the mod link resolves to this repo's mod"
}

function _pf_cases {
  local gpdir="${PF_SB}/gp"
  local -a gh_env

  _section "pretool-prefilter: denied commands are dispatched, token-free ones are not"

  zf_mkdir -p "${gpdir}/gh"
  print -r -- 'FIXTURE_TOKEN' > "${gpdir}/patterns"
  print -r -- 'Host testalias99' > "${gpdir}/sshcfg"
  : > "${gpdir}/gh/config.yml"
  gh_env=("GH_PUBLISH_PATTERNS=${gpdir}/patterns" "GH_PUBLISH_SSH_CONFIG=${gpdir}/sshcfg" GH_PUBLISH_NO_GITLEAKS=1 GH_PUBLISH_NO_IDENTITY=1 "GH_PUBLISH_OS=7.7:99Z999z" "GH_CONFIG_DIR=${gpdir}/gh")

  _pf_try_deny 'git-bypass: git commit -n' 'git commit -n'
  _pf_done "git commit -n is denied by the dispatcher and dispatched by the prefilter"
  _pf_try_deny 'rm-redirect: backslash rm' '\rm foo.txt'
  _pf_done "a backslash rm is denied by the dispatcher and dispatched by the prefilter"
  # Decoration cannot split a token: the guards delete it before probing.
  # shellcheck disable=SC2016  # literal command text
  _pf_try_deny 'git-bypass: $() inside git' 'gi$()t commit -n'
  _pf_done "a command substitution inside git cannot hide it from the prefilter"
  # The publish-shape backstop needs no literal gh.
  # shellcheck disable=SC2016  # literal command text
  _pf_try_deny 'gh-publish: variable command word, pr create' 'eval "$G pr create -t x --body y"' "${gh_env[@]}"
  _pf_done "a gh publish shape with no literal gh is denied and dispatched"

  # A byte outside printable ASCII dispatches, under a UTF-8 caller locale too
  # (a lone high byte is not valid UTF-8 and was a regex error that fell
  # through where the mod dispatches).
  LC_ALL=en_US.UTF-8 _pf_needs_dispatch $'echo \x80x' || _pf_flag "a lone high byte does not dispatch under a UTF-8 locale"
  _pf_done "a lone high byte dispatches under a UTF-8 locale"

  _pf_try_pass 'ls -la' 'ls -la'
  _pf_done "a token-free command passes the dispatcher and skips it in the prefilter"
}

function _pf_plugin_tests {
  _section "pretool-prefilter: the mod's own tests"
  local out rc=0
  if ! command -v claude >/dev/null 2>&1; then
    _skip "claude CLI not on PATH: cannot run claude plugin test"
    return 0
  fi
  out="$(cd "${PF_MOD}" && claude plugin test . 2>&1)" || rc=$?
  local summary
  summary="$(print -r -- "${out}" | /usr/bin/grep -E '^ *[0-9]+ (pass|fail)$' | tr '\n' ' ')"
  if (( rc == 0 )) && [[ "${out}" == *" 0 fail"* ]]; then
    _pass "claude plugin test: ${summary}"
  else
    _fail "claude plugin test failed (rc ${rc}): ${summary:-$(print -r -- "${out}" | tail -n 3)}"
  fi
}

function run_pretool_prefilter {
  PF_MOD="${SCRIPT_DIR}/claude/mods/pretool-prefilter"
  PF_SRC="${PF_MOD}/hooks/register.ts"

  _section "pretool-prefilter mod"
  if [[ ! -f "${PF_SRC}" || ! -f "${SCRIPT_DIR}/claude/hooks/pretool-dispatch" ]]; then
    _skip "claude/mods/pretool-prefilter or claude/hooks/pretool-dispatch absent — claude/ not yet synced to this machine"
    return 0
  fi
  if ! command -v jq >/dev/null 2>&1; then
    _skip "jq not installed (brew install jq)"
    return 0
  fi

  PF_SB="$(mktemp -d "${TMPDIR:-/tmp}/pretool-prefilter.XXXXXX")"
  trap 'rm -rf -- "${PF_SB}"' EXIT

  zmodload -F zsh/files b:zf_mkdir
  _pf_load_tokens
  _pf_cases
  _pf_shape
  _pf_plugin_tests
  return 0
}
