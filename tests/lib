#!/bin/zsh
# dotfiles/tests/lib
#
# Shared helpers for dotfiles test suites. Sourced by ./test and each
# tests/<suite> fragment. Owns colour constants, pass/fail/skip counters,
# and common expectation helpers.
#
# ShellCheck: lint with `shellcheck --shell=bash tests/lib`.
# This file is sourced, not executed — chmod 644.

readonly RED=$'\e[31m'
readonly GREEN=$'\e[32m'
readonly YELLOW=$'\e[33m'
readonly BOLD=$'\e[1m'
readonly RESET=$'\e[0m'

typeset -gi pass_count=0
typeset -gi fail_count=0
typeset -gi skip_count=0

function _pass {
  echo "${GREEN}PASS${RESET}  $1"
  (( pass_count += 1 ))
}

function _fail {
  echo "${RED}FAIL${RESET}  $1"
  (( fail_count += 1 ))
}

function _skip {
  echo "${YELLOW}SKIP${RESET}  $1"
  (( skip_count += 1 ))
}

# Each header carries the wall-clock time the suite reached it. In the
# parallel run that is when the suite started in its worker, not when the
# parent replayed the line, which is the useful number: it shows where the
# queue stalled and lines up with `/usr/bin/log show` timestamps.
function _section {
  echo ""
  echo "$(strftime '%H:%M:%S' "${EPOCHSECONDS}") ${BOLD}── $1 ──${RESET}"
}

# These hooks emit either nothing or one deny object. An allow response,
# malformed JSON, or unrelated output must never satisfy a deny assertion.
function _hook_verdict {
  local out="$1"
  if [[ -z "${out}" ]]; then
    printf 'PASS'
  elif jq -es 'length == 1 and .[0].hookSpecificOutput.permissionDecision == "deny"' \
      >/dev/null 2>&1 <<< "${out}"; then
    printf 'DENY'
  else
    printf 'INVALID'
  fi
}

# Run "$@" detached from any controlling terminal, regardless of whether the
# CALLING process (this test suite) has one or not (2026-09-25, added for the
# git-hook terminal-gated bypass variables: PII_HOOK_BYPASS, MSG_POLICY_SKIP,
# GIT_SIGN_SKIP). A case proving one of those is REFUSED without a terminal
# must be deterministic whether the suite itself runs from an agent's tool
# call (no ctty already) or a human's interactive `./test` at a real
# terminal (a ctty the hook would otherwise inherit) — the latter is the
# gate's primary real-world path, so relying on the suite's own ambient tty
# state is not enough. POSIX::setsid() moves the perl process into a new
# session with no controlling terminal; it fails only when the CALLING
# process is already a process-group leader, which a plain command
# substitution or `( … )` subshell child never is. perl is stock on macOS.
function _run_no_tty {
  /usr/bin/perl -MPOSIX -e 'POSIX::setsid() != -1 or die "setsid: $!"; exec @ARGV or die "exec: $!: $ARGV[0]"' -- "$@"
}

# Print the aggregated summary. Caller decides exit code via $?.
function _print_summary {
  echo ""
  echo "────────────────────────────────────────"
  echo "${GREEN}${pass_count} pass${RESET}, ${RED}${fail_count} fail${RESET}, ${YELLOW}${skip_count} skip${RESET}"
  if (( fail_count > 0 )); then
    return 1
  fi
  return 0
}
