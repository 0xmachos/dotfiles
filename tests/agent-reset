#!/bin/zsh
# tests/agent-reset
#
# Hermetic tests for bin/agent-reset (backup -> verify -> wipe). Covers the
# self-test, the read-only plan, the wipe gates (no verify stamp, running agent
# CLI, tampered archive, changed file without --topup), exit 2 for a skipped
# repo, what a wipe removes and keeps (global state, claude.json, repos, dirty
# and staged work), --repos-only, restore and the delete guard. A synthetic
# $HOME fixture in $TMPDIR, driven through the AGENT_RESET_HOME and
# AGENT_RESET_PS_FILE seams: no real agent state, no network. Fixture repos use
# real git with GIT_CONFIG_GLOBAL pinned inside the fixture (no signing, no
# global hooks, no identity leak).
#
# Sourced by ./test (chmod 644) — never executed, so: return, never exit.
# Lint: shellcheck --shell=bash tests/agent-reset
# shellcheck source=tests/lib

# Counters and helpers (_pass/_fail/_skip/_section) come from tests/lib.
# shellcheck disable=SC2154

_ar_mkfix() {
  # Prints the fixture home. Every value is synthetic (no real hostnames,
  # repo names or tokens).
  local fix
  fix="$(mktemp -d "${TMPDIR:-/tmp}/agent-reset-test.XXXXXX")" || return 1

  # Prefixed builtin: the fixture makes a dozen directories, none spawns mkdir.
  zmodload -F zsh/files b:zf_mkdir

  zf_mkdir -p "${fix}/.claude/projects/-fix-proj/memory" \
              "${fix}/.claude/file-history" \
              "${fix}/.claude/skills" \
              "${fix}/.codex/sessions" \
              "${fix}/.codex/memories" \
              "${fix}/Downloads" \
              "${fix}/liverepo" \
              "${fix}/Dev"

  echo '{"role":"user"}' > "${fix}/.claude/projects/-fix-proj/session.jsonl"
  echo '# fixture memory' > "${fix}/.claude/projects/-fix-proj/memory/MEMORY.md"
  echo 'blob' > "${fix}/.claude/file-history/blob"
  echo 'SECRET=1' > "${fix}/.claude/fake-server.env"
  echo '#!/bin/zsh' > "${fix}/.claude/statusline-command.sh"
  echo '{}' > "${fix}/.claude/history.jsonl"
  echo 'live skill body' > "${fix}/liverepo/skillfile"
  ln -s "${fix}/liverepo/skillfile" "${fix}/.claude/skills/extskill"

  echo '{"token":"fixture"}' > "${fix}/.codex/auth.json"
  echo 'session' > "${fix}/.codex/sessions/s1.jsonl"
  echo 'memory' > "${fix}/.codex/memories/m.md"

  local i
  for i in 1 2 3 4 5 6; do
    echo "zip${i}" > "${fix}/Downloads/claude-backup-${i}.zip"
  done
  echo '# loose instructions' > "${fix}/Downloads/CLAUDE.md"

  cat > "${fix}/gitconfig" <<EOF
[user]
	name = Fixture
	email = fixture@example.invalid
[core]
	# The machine's real ~/.config/git/ignore has *claude* — it would block
	# the fixture's own CLAUDE.md adds (GIT_CONFIG_GLOBAL replaces the config
	# file, not the XDG ignore path).
	excludesFile = /dev/null
	hooksPath = /dev/null
[commit]
	gpgsign = false
[tag]
	gpgsign = false
[init]
	defaultBranch = main
EOF

  # Same git isolation as the script under test; local -x scopes it here.
  local -x GIT_CONFIG_GLOBAL="${fix}/gitconfig" GIT_CONFIG_NOSYSTEM=1

  local repo="${fix}/Dev/fixrepo"
  zf_mkdir -p "${repo}/.claude"
  git -C "${repo}" init -q &&
    echo '# tracked instructions' > "${repo}/CLAUDE.md" &&
    echo '{"mcpServers":{}}' > "${repo}/.mcp.json" &&
    echo '{"hooks":{}}' > "${repo}/.claude/settings.json" &&
    echo 'settings.local.json' > "${repo}/.gitignore" &&
    git -C "${repo}" add CLAUDE.md .mcp.json .gitignore .claude/settings.json &&
    git -C "${repo}" commit -q -m 'fixture' || return 1
  echo '# untracked instructions' > "${repo}/AGENTS.md"
  # Gitignored file in tracked .claude/: git rm leaves it; sweep must delete it.
  echo '{"grants":[]}' > "${repo}/.claude/settings.local.json"

  # Unrelated WORKTREE dirt beside a tracked artifact: the commit is
  # pathspec-limited, the edit stays uncommitted.
  local dirty="${fix}/Dev/dirtyrepo"
  zf_mkdir -p "${dirty}"
  git -C "${dirty}" init -q &&
    echo '# tracked instructions' > "${dirty}/CLAUDE.md" &&
    echo 'v1' > "${dirty}/other.txt" &&
    git -C "${dirty}" add CLAUDE.md other.txt &&
    git -C "${dirty}" commit -q -m 'fixture' || return 1
  echo 'v2' > "${dirty}/other.txt"

  # Unrelated work STAGED beside a tracked artifact: the reset commit records
  # ONLY the artifact; the staged work survives, still staged.
  local staged="${fix}/Dev/stagedrepo"
  zf_mkdir -p "${staged}/.claude"
  git -C "${staged}" init -q &&
    echo '# tracked instructions' > "${staged}/CLAUDE.md" &&
    echo 'skill' > "${staged}/.claude/skill.md" &&
    echo 'v1' > "${staged}/inflight.c" &&
    git -C "${staged}" add CLAUDE.md .claude/skill.md inflight.c &&
    git -C "${staged}" commit -q -m 'fixture' || return 1
  echo 'v2 IN FLIGHT' > "${staged}/inflight.c"
  echo 'brand new' > "${staged}/added.c"
  git -C "${staged}" add inflight.c added.c || return 1

  # No TRACKED artifact (the common case under the machine-global *claude*
  # ignore) + heavy dirt: no commit is made; delete outright, dirt untouched.
  local untr="${fix}/Dev/untrackedrepo"
  zf_mkdir -p "${untr}/.claude"
  git -C "${untr}" init -q &&
    echo 'v1' > "${untr}/src.c" &&
    git -C "${untr}" add src.c &&
    git -C "${untr}" commit -q -m 'fixture' || return 1
  echo '# untracked instructions' > "${untr}/CLAUDE.md"
  echo '{}' > "${untr}/.claude/settings.json"
  echo 'v2 dirty' > "${untr}/src.c"
  echo 'also dirty' > "${untr}/stray.c"

  # Mid-merge: git refuses a pathspec commit, so the repo MUST be skipped —
  # the one dirty state that still blocks.
  local merging="${fix}/Dev/mergerepo"
  zf_mkdir -p "${merging}"
  git -C "${merging}" init -q &&
    echo '# tracked instructions' > "${merging}/CLAUDE.md" &&
    echo 'base' > "${merging}/conflict.txt" &&
    git -C "${merging}" add CLAUDE.md conflict.txt &&
    git -C "${merging}" commit -q -m 'fixture' &&
    git -C "${merging}" checkout -q -b side &&
    echo 'side' > "${merging}/conflict.txt" &&
    git -C "${merging}" commit -q -am 'side' &&
    git -C "${merging}" checkout -q main &&
    echo 'main' > "${merging}/conflict.txt" &&
    git -C "${merging}" commit -q -am 'main' || return 1
  git -C "${merging}" merge side > /dev/null 2>&1  # conflicts on purpose
  [[ -f "${merging}/.git/MERGE_HEAD" ]] || return 1

  # Artifact-dirty: the only dirt is an edited tracked artifact; must proceed
  # (git rm -f), not crash, not skip.
  local modrepo="${fix}/Dev/modrepo"
  zf_mkdir -p "${modrepo}"
  git -C "${modrepo}" init -q &&
    echo '# v1' > "${modrepo}/CLAUDE.md" &&
    git -C "${modrepo}" add CLAUDE.md &&
    git -C "${modrepo}" commit -q -m 'fixture' || return 1
  echo '# v2 uncommitted' >> "${modrepo}/CLAUDE.md"

  # A repo checked out at the home root (the dotfiles/RSP layout): in scope
  # in scope via home-root repo discovery, handled like any ~/Dev repo.
  local homerepo="${fix}/dotfiles"
  zf_mkdir -p "${homerepo}"
  git -C "${homerepo}" init -q &&
    echo '# tracked instructions' > "${homerepo}/CLAUDE.md" &&
    git -C "${homerepo}" add CLAUDE.md &&
    git -C "${homerepo}" commit -q -m 'fixture' || return 1

  # A repo under the ~/Research container: in scope, handled like ~/Dev.
  local researchrepo="${fix}/Research/researchrepo"
  zf_mkdir -p "${researchrepo}"
  git -C "${researchrepo}" init -q &&
    echo '# tracked instructions' > "${researchrepo}/CLAUDE.md" &&
    git -C "${researchrepo}" add CLAUDE.md &&
    git -C "${researchrepo}" commit -q -m 'fixture' || return 1

  # Agent state OUTSIDE every project root: skip-and-report, untouched.
  zf_mkdir -p "${fix}/Desktop/strayrepo"
  echo '# stray instructions' > "${fix}/Desktop/strayrepo/CLAUDE.md"

  # The "${fix}" (HOME itself) project key: HOME must never be discovered as
  # a repo whose artifacts are ~/.claude and ~/.codex wholesale.
  cat > "${fix}/.claude.json" <<EOF
{
  "projects": {
    "${fix}": {
      "mcpServers": {"hm": {"command": "h"}},
      "allowedTools": ["Bash"]
    },
    "${fix}/Dev/fixrepo": {
      "mcpServers": {"m1": {"command": "x"}},
      "allowedTools": ["Bash"],
      "hasTrustDialogAccepted": true
    },
    "${fix}/Dev/dirtyrepo": {
      "allowedTools": ["Read"]
    },
    "${fix}/Desktop/strayrepo": {
      "allowedTools": ["Read"]
    }
  },
  "mcpServers": {"g": {"command": "y"}},
  "oauthAccount": {"id": "fixture"},
  "someTopLevel": 1
}
EOF

  # Canned ps listings for the process gate. The second line of ps-quiet is
  # the named regression: a daemon with "claude" only in an ARGUMENT path must
  # not block the wipe.
  cat > "${fix}/ps-quiet" <<'EOF'
  845 keyagent        keyagent serve --blob /h/Library/Application Support/keyagent/blob.bin
  900 zsh              -zsh
EOF
  cat > "${fix}/ps-busy" <<'EOF'
  845 keyagent        keyagent serve --blob /h/Library/Application Support/keyagent/blob.bin
  999 claude           claude --resume
EOF

  echo "${fix}"
}

_ar_run() {
  # _ar_run <fix> <psfile> <args...>
  local fix="$1" psfile="$2"
  shift 2
  AGENT_RESET_HOME="${fix}" \
  AGENT_RESET_PS_FILE="${psfile}" \
  GIT_CONFIG_GLOBAL="${fix}/gitconfig" \
  GIT_CONFIG_NOSYSTEM=1 \
    ./bin/agent-reset "$@"
}

run_agent_reset() {
  _section "agent-reset"

  if ! command -v python3 > /dev/null 2>&1; then
    _skip "agent-reset: python3 not available"
    return 0
  fi
  if ! command -v git > /dev/null 2>&1; then
    _skip "agent-reset: git not available"
    return 0
  fi

  local fix
  if ! fix="$(_ar_mkfix)"; then
    _fail "agent-reset: fixture build failed"
    return 0
  fi
  local quiet="${fix}/ps-quiet" busy="${fix}/ps-busy"
  local out rc bad
  # Same git isolation as _ar_run, exported once so the repo checks below call
  # git directly instead of through env.
  local -x GIT_CONFIG_GLOBAL="${fix}/gitconfig" GIT_CONFIG_NOSYSTEM=1

  # 1. self-test
  if _ar_run "${fix}" "${quiet}" self-test > /dev/null 2>&1; then
    _pass "self-test passes"
  else
    _fail "self-test failed"
  fi

  # 2. plan is read-only, lists memory dirs, and predicts the wipe-time skip
  local before after
  before="$(find "${fix}" | sort)"
  rc=0
  out="$(_ar_run "${fix}" "${quiet}" plan 2>&1)" || rc=$?
  after="$(find "${fix}" | sort)"
  if [[ ${rc} -eq 0 && "${out}" == *"memory dirs"* \
     && "${before}" == "${after}" \
     && "${out}" == *"action: SKIP: merge in progress"* \
     && "${out}" == *"would be SKIPPED at wipe time"* ]]; then
    _pass "plan is read-only, lists memory dirs, flags the repo wipe would skip"
  else
    _fail "plan wrong (rc=${rc}, fixture changed: $([[ "${before}" == "${after}" ]] && echo no || echo yes))"
  fi

  # 3. backup
  local bdir=""
  bdir="$(_ar_run "${fix}" "${quiet}" backup --strict-downloads 2> /dev/null | tail -1)" || true
  if [[ -f "${bdir}/MANIFEST.json" \
     && "$(find "${bdir}/downloads-manual" -name '*.zip' | wc -l | tr -d ' ')" == "6" ]]; then
    _pass "backup produces MANIFEST.json and ingests six downloads zips"
  else
    _fail "backup wrong (got: ${bdir})"
    return 0
  fi

  # 4. wipe must refuse without a verify stamp
  rc=0
  out="$(_ar_run "${fix}" "${quiet}" wipe "${bdir}" --yes 2>&1)" || rc=$?
  if [[ ${rc} -ne 0 && "${out}" == *"verify"* ]]; then
    _pass "wipe refuses without verify-stamp"
  else
    _fail "wipe did not refuse unverified backup (rc=${rc})"
  fi

  # 5. verify passes and writes the stamp
  if _ar_run "${fix}" "${quiet}" verify "${bdir}" > /dev/null 2>&1 \
      && [[ -f "${bdir}/verify-stamp.json" ]]; then
    _pass "verify passes and writes verify-stamp.json"
  else
    _fail "verify failed on clean backup"
    return 0
  fi

  # 6. process gate: a claude row refuses; the keyagent row alone (ps-quiet)
  #    must not (every later case passing proves it).
  rc=0
  out="$(_ar_run "${fix}" "${busy}" wipe "${bdir}" --yes 2>&1)" || rc=$?
  if [[ ${rc} -ne 0 && "${out}" == *"processes are running"* ]]; then
    _pass "wipe refuses while an agent CLI process runs"
  else
    _fail "process gate did not trigger (rc=${rc})"
  fi

  # 7. tamper detection: corrupt one archive byte in a COPY of the backup
  local tdir="${bdir}-tampered"
  cp -R "${bdir}" "${tdir}"
  rm -f "${tdir}/verify-stamp.json"
  printf '\x00' | dd of="${tdir}/codex.tar.gz" bs=1 seek=12 conv=notrunc 2> /dev/null
  rc=0
  _ar_run "${fix}" "${quiet}" verify "${tdir}" > /dev/null 2>&1 || rc=$?
  if [[ ${rc} -ne 0 ]]; then
    _pass "verify detects a tampered archive"
  else
    _fail "verify passed a tampered archive"
  fi

  # 8. change a file after backup: wipe aborts without --topup
  echo '{"more":true}' >> "${fix}/.claude/history.jsonl"
  rc=0
  out="$(_ar_run "${fix}" "${quiet}" wipe "${bdir}" --yes 2>&1)" || rc=$?
  if [[ ${rc} -ne 0 && "${out}" == *"topup"* ]]; then
    _pass "wipe aborts on changed files without --topup"
  else
    _fail "changed-file gate did not trigger (rc=${rc})"
  fi

  # 9. wipe with --topup. Exit 2, not 0: the mid-merge repo is skipped, and a
  #    wipe leaving ANY repo unreset must never exit 0 (silent-success bug,
  #    2026-08-15). The skipped and out-of-scope repos stay untouched and are
  #    reported loudly.
  rc=0
  out="$(_ar_run "${fix}" "${quiet}" wipe "${bdir}" --yes --topup 2>&1)" || rc=$?
  if [[ ${rc} -eq 0 ]]; then
    _fail "wipe exited 0 despite skipping a repo (silent success)"
    return 0
  elif [[ ${rc} -ne 2 ]]; then
    _fail "wipe failed (rc=${rc}): $(echo "${out}" | tail -3)"
    return 0
  fi
  bad=""
  [[ -f "${fix}/Dev/mergerepo/CLAUDE.md" ]] || bad+=" mid-merge-swept"
  [[ -f "${fix}/Desktop/strayrepo/CLAUDE.md" ]] || bad+=" stray-touched"
  [[ "${out}" == *"merge in progress"* && "${out}" == *"ATTENTION"* ]] || bad+=" skip-not-surfaced"
  [[ "${out}" == *"SKIP (report-only"* ]] || bad+=" stray-not-reported"
  if [[ -z "${bad}" ]]; then
    _pass "wipe exits 2, skips and reports the mid-merge and out-of-scope repos"
  else
    _fail "skip handling wrong:${bad}"
  fi

  # 10. global state: keep-list survives, wipe-list gone, symlink target
  #     intact, codex keep-list, surgical ~/.claude.json rewrite, topup archive
  bad=""
  [[ -f "${fix}/.claude/fake-server.env" && -f "${fix}/.claude/statusline-command.sh" ]] \
    || bad+=" keep-claude"
  [[ ! -e "${fix}/.claude/projects" && ! -e "${fix}/.claude/history.jsonl" \
     && ! -e "${fix}/.claude/file-history" && ! -e "${fix}/.claude/skills" ]] \
    || bad+=" wipe-claude"
  [[ -f "${fix}/liverepo/skillfile" ]] || bad+=" symlink-followed"
  [[ -f "${fix}/.codex/auth.json" && ! -e "${fix}/.codex/sessions" \
     && ! -e "${fix}/.codex/memories" ]] || bad+=" codex"
  ls "${bdir}"/topup-*.tar.gz > /dev/null 2>&1 || bad+=" topup"
  env AGENT_RESET_HOME="${fix}" python3 - "${fix}" <<'EOF' > /dev/null 2>&1 || bad+=" claude.json"
import json, sys
fix = sys.argv[1]
d = json.load(open(fix + "/.claude.json"))
assert d["someTopLevel"] == 1
assert d["mcpServers"] == {"g": {"command": "y"}}
assert d["oauthAccount"] == {"id": "fixture"}
p = d["projects"]
assert set(p) == {fix, fix + "/Dev/fixrepo"}, p
assert p[fix] == {"mcpServers": {"hm": {"command": "h"}}}
assert p[fix + "/Dev/fixrepo"] == {"mcpServers": {"m1": {"command": "x"}}}
EOF
  if [[ -z "${bad}" ]]; then
    _pass "wipe removes only wipe-listed global state and rewrites claude.json surgically"
  else
    _fail "global wipe state wrong:${bad}"
  fi

  # 11. repo reset: neutral commit in clean, artifact-dirty, home-root and
  #     ~/Research repos, .mcp.json kept, gitignored leftover in tracked
  #     .claude/ swept
  local msg neutral="Reset agent instruction state (2026-08 ablation)" r
  bad=""
  for r in fixrepo modrepo; do
    msg="$(git -C "${fix}/Dev/${r}" log -1 --format=%s 2> /dev/null)"
    [[ ! -e "${fix}/Dev/${r}/CLAUDE.md" && "${msg}" == "${neutral}" ]] || bad+=" ${r}"
  done
  msg="$(git -C "${fix}/dotfiles" log -1 --format=%s 2> /dev/null)"
  [[ ! -e "${fix}/dotfiles/CLAUDE.md" && "${msg}" == "${neutral}" ]] || bad+=" home-root"
  msg="$(git -C "${fix}/Research/researchrepo" log -1 --format=%s 2> /dev/null)"
  [[ ! -e "${fix}/Research/researchrepo/CLAUDE.md" && "${msg}" == "${neutral}" ]] \
    || bad+=" research"
  [[ ! -e "${fix}/Dev/fixrepo/AGENTS.md" && -f "${fix}/Dev/fixrepo/.mcp.json" \
     && ! -e "${fix}/Dev/fixrepo/.claude" ]] || bad+=" fixrepo-leftovers"
  if [[ -z "${bad}" ]]; then
    _pass "repos reset with a neutral commit, .mcp.json kept, ignored leftovers swept"
  else
    _fail "repo reset wrong:${bad}"
  fi

  # 12. dirty repos: unrelated worktree edit stays uncommitted, the commit
  #     holds artifacts only, staged work stays staged, a repo with no tracked
  #     artifact gets no commit and its dirt is untouched
  local sfiles srepo="${fix}/Dev/stagedrepo" urepo="${fix}/Dev/untrackedrepo"
  sfiles="$(git -C "${srepo}" show --name-only --format= HEAD | sort | tr '\n' ' ')"
  bad=""
  [[ ! -e "${fix}/Dev/dirtyrepo/CLAUDE.md" ]] || bad+=" dirty-skipped"
  [[ "$(<"${fix}/Dev/dirtyrepo/other.txt")" == "v2" ]] \
    && ! git -C "${fix}/Dev/dirtyrepo" diff --quiet -- other.txt || bad+=" dirty-committed"
  [[ ! -e "${srepo}/CLAUDE.md" && ! -e "${srepo}/.claude" \
     && "${sfiles}" == ".claude/skill.md CLAUDE.md " ]] || bad+=" staged-commit(${sfiles})"
  [[ "$(git -C "${srepo}" diff --cached --name-only | sort | tr '\n' ' ')" \
     == "added.c inflight.c " ]] || bad+=" staged-absorbed"
  [[ ! -e "${urepo}/CLAUDE.md" && ! -e "${urepo}/.claude" ]] || bad+=" untracked-skipped"
  [[ "$(git -C "${urepo}" log --oneline | wc -l | tr -d ' ')" == "1" \
     && "$(<"${urepo}/src.c")" == "v2 dirty" && -f "${urepo}/stray.c" ]] \
    || bad+=" untracked-dirt"
  if [[ -z "${bad}" ]]; then
    _pass "unrelated dirt survives: pathspec-limited commit, staged work kept, no commit without tracked artifacts"
  else
    _fail "dirty repo handling wrong:${bad}"
  fi

  # 13. --repos-only reconcile: resolve the blocker, re-run the in-repo leg
  #     alone. Global state is not re-processed, the first report survives.
  git -C "${fix}/Dev/mergerepo" merge --abort > /dev/null 2>&1
  local claude_json_before
  claude_json_before="$(<"${fix}/.claude.json")"
  rc=0
  out="$(_ar_run "${fix}" "${quiet}" wipe "${bdir}" --yes --topup \
        --repos-only 2>&1)" || rc=$?
  if [[ ${rc} -eq 0 && ! -e "${fix}/Dev/mergerepo/CLAUDE.md" \
     && "${out}" == *"REPOS ONLY"* && "${out}" != *"memory directories"* \
     && "$(<"${fix}/.claude.json")" == "${claude_json_before}" \
     && -f "${fix}/.claude/fake-server.env" \
     && -f "${bdir}/wipe-report.json" ]] \
     && ls "${bdir}"/wipe-report-*.json > /dev/null 2>&1; then
    _pass "--repos-only reconciles the skipped repo, leaves global state alone, keeps the first report"
  else
    _fail "--repos-only reconcile wrong (rc=${rc})"
  fi

  # 14. restore round-trip: bring projects/ back from the archive
  rc=0
  _ar_run "${fix}" "${quiet}" restore "${bdir}" --scope global-claude \
      --path .claude/projects > /dev/null 2>&1 || rc=$?
  if [[ ${rc} -eq 0 \
     && -f "${fix}/.claude/projects/-fix-proj/session.jsonl" \
     && -f "${fix}/.claude/projects/-fix-proj/memory/MEMORY.md" ]]; then
    _pass "restore brings transcripts + memory back from the archive"
  else
    _fail "restore failed (rc=${rc})"
  fi

  # 15. The delete guard refuses a path that IS an allowed root (a wipe never
  #     targets one, so the module is loaded and the guard called directly),
  #     but accepts the agents dir whole and anything below a root.
  if env AGENT_RESET_HOME="${fix}" PYTHONDONTWRITEBYTECODE=1 python3 - <<'EOF' > /dev/null 2>&1
import importlib.machinery, importlib.util
loader = importlib.machinery.SourceFileLoader("agent_reset", "./bin/agent-reset")
spec = importlib.util.spec_from_loader("agent_reset", loader)
m = importlib.util.module_from_spec(spec)
loader.exec_module(m)
assert not m._under_allowed_roots(m.CLAUDE_DIR)
assert not m._under_allowed_roots(m.CODEX_DIR)
assert not m._under_allowed_roots(m.DEV_DIR)
assert m._under_allowed_roots(m.AGENTS_DIR)
assert m._under_allowed_roots(m.CLAUDE_DIR / "projects")
assert m._under_allowed_roots(m.DEV_DIR / "fixrepo" / "CLAUDE.md")
assert not m._under_allowed_roots(m.HOME / "Desktop" / "x")
EOF
  then
    _pass "delete guard refuses an allowed root itself, accepts agents dir and paths below a root"
  else
    _fail "delete guard root handling wrong"
  fi

  rm -rf "${fix}"
}
