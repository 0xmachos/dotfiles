#!/bin/zsh
# Hash the intended app executable, refuse a CFBundleExecutable that escapes
# Contents/MacOS, and leave the clipboard alone when hashing fails.
# shellcheck source=tests/lib
# shellcheck disable=SC2031  # sha uses a local target in isolated subshells

function run_sha {
  _section "SHA-256 file and app hashing"
  local fixture
  fixture="$(mktemp -d "${TMPDIR}sha-test.XXXXXX")"
  local app="${fixture}/Demo.App.app"
  mkdir -p "${app}/Contents/MacOS"
  printf abc > "${app}/Contents/MacOS/actual.binary"
  /usr/libexec/PlistBuddy -c 'Add :CFBundleExecutable string actual.binary' \
    "${app}/Contents/Info.plist" >/dev/null
  local expected='ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad'
  local out
  # An app bundle resolves through CFBundleExecutable and copies the digest.
  if out=$(
    # shellcheck source=.functions/sha disable=SC1091
    source "${SCRIPT_DIR}/.functions/sha"
    # shellcheck disable=SC2329
    pbcopy() { cat > "${fixture}/clipboard"; }
    sha "${app}"
  ) && [[ "${out}" == "${expected}  "* && "$(<"${fixture}/clipboard")" == "${expected}" ]]; then
    _pass "sha: app bundle resolves to its executable and copies the expected digest"
  else
    _fail "sha: failed to hash the app bundle"
  fi
  # A hashing error must neither become pbcopy's success nor clear clipboard.
  print -r -- unchanged > "${fixture}/clipboard"
  if (
    # shellcheck source=.functions/sha disable=SC1091
    source "${SCRIPT_DIR}/.functions/sha"
    # shellcheck disable=SC2329
    pbcopy() { cat > "${fixture}/clipboard"; }
    sha "${fixture}/missing"
  ) >/dev/null 2>&1; then
    _fail "sha: missing file reported success"
  elif [[ "$(<"${fixture}/clipboard")" == unchanged ]]; then
    _pass "sha: missing file fails without changing the clipboard"
  else
    _fail "sha: hashing failure changed the clipboard"
  fi
  # A CFBundleExecutable that leaves Contents/MacOS must be refused, not hashed.
  local escape="${fixture}/Escape.app"
  mkdir -p "${escape}/Contents/MacOS"
  printf abc > "${escape}/Contents/plain"
  /usr/libexec/PlistBuddy -c 'Add :CFBundleExecutable string ../plain' \
    "${escape}/Contents/Info.plist" >/dev/null
  print -r -- unchanged > "${fixture}/clipboard"
  if out=$(
    # shellcheck source=.functions/sha disable=SC1091
    source "${SCRIPT_DIR}/.functions/sha"
    # shellcheck disable=SC2329
    pbcopy() { cat > "${fixture}/clipboard"; }
    sha "${escape}" 2>/dev/null
  ); then
    _fail "sha: executable name escaping Contents/MacOS was hashed"
  elif [[ -z "${out}" && "$(<"${fixture}/clipboard")" == unchanged ]]; then
    _pass "sha: executable name escaping Contents/MacOS is refused without touching the clipboard"
  else
    _fail "sha: refused executable name still produced output or changed the clipboard"
  fi
  /bin/rm -rf "${fixture}"
}
