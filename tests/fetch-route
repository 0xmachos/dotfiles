#!/bin/zsh
# dotfiles/tests/fetch-route
#
# Test for claude/hooks/fetch-route-hook (PreToolUse). The hook denies:
#   - a GitHub host fetch on every matched tool, naming the gh command for
#     that URL's shape
#   - an X status post via WebFetch/Exa, naming X's oEmbed endpoint (allowed
#     via mcp__parallel__web_fetch)
#   - every WebSearch and mcp__parallel__web_search call, naming Exa
# Payloads are stdin JSON (same shape as tests/md5-write); asserts the verdict
# and, for GitHub, the gh command named. Fixture URLs are invented
# (example-org/example-repo), never a real repo or X post.
#
# Run: ./test fetch-route
#
# ShellCheck: lint with `shellcheck --shell=bash tests/fetch-route`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib
# shellcheck disable=SC2016
# SC2016: the '$(id)' fixtures must not expand; the hook must quote them.

function _fr_run_url {
  # WebFetch-shaped single-url payload.
  local tool="$1" url="$2"
  jq -n --arg t "${tool}" --arg u "${url}" '{tool_name:$t, tool_input:{url:$u}}' \
    | /bin/zsh "${SCRIPT_DIR}/claude/hooks/fetch-route-hook"
}

function _fr_run_urls {
  # MCP-shaped urls[] payload.
  local tool="$1"
  shift
  local urls_json
  urls_json="$(printf '%s\n' "$@" | jq -R . | jq -s .)"
  jq -n --arg t "${tool}" --argjson u "${urls_json}" '{tool_name:$t, tool_input:{urls:$u}}' \
    | /bin/zsh "${SCRIPT_DIR}/claude/hooks/fetch-route-hook"
}

function _fr_run_search {
  # Search-shaped payload; tool defaults to WebSearch.
  local query="$1" tool="${2:-WebSearch}"
  jq -n --arg q "${query}" --arg t "${tool}" '{tool_name:$t, tool_input:{query:$q}}' \
    | /bin/zsh "${SCRIPT_DIR}/claude/hooks/fetch-route-hook"
}

function _fr_reason {
  # Deny reason of hook output $1. Non-zero on empty input: callers under
  # errexit capture it with `|| true` so a regression is a FAIL, not an abort.
  printf '%s' "$1" | jq -er '.hookSpecificOutput.permissionDecisionReason' 2>/dev/null
}

function _fr_expect_url {
  local want="$1" tool="$2" url="$3" out got
  local label="${4:-$url}"
  out="$(_fr_run_url "${tool}" "${url}")"
  got="$(_hook_verdict "${out}")"
  if [[ "${got}" == "${want}" ]]; then
    _pass "${want}: ${label}"
  else
    _fail "${label} — expected ${want}, got ${got}"
  fi
}

function _fr_expect_reason_has {
  # Denied AND reason contains a substring (pins the gh command per URL
  # shape). Checks the verdict too: a malformed or PASS response with no
  # reason would otherwise satisfy an empty check.
  local tool="$1" url="$2" substring="$3" out reason verdict
  local label="${4:-$url}"
  out="$(_fr_run_url "${tool}" "${url}")"
  verdict="$(_hook_verdict "${out}")"
  reason="$(_fr_reason "${out}" || true)"
  if [[ "${verdict}" == DENY && "${reason}" == *"${substring}"* ]]; then
    _pass "DENY + reason has '${substring}': ${label}"
  else
    _fail "${label} — expected DENY with reason containing '${substring}', got verdict=${verdict} reason=${reason}"
  fi
}

function run_fetch_route {
  _section "fetch → gh/oEmbed routing hook"

  # claude/ is gitignored and synced out of band: absent hook = skip.
  if [[ ! -f "${SCRIPT_DIR}/claude/hooks/fetch-route-hook" ]]; then
    _skip "claude/hooks/fetch-route-hook absent — claude/ not yet synced to this machine"
    return 0
  fi

  if ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
    return
  fi

  # --- GitHub: every shape gets the right gh command, for every matched tool ---

  local -a tools=(WebFetch mcp__exa__web_fetch_exa mcp__exa__crawling_exa mcp__parallel__web_fetch)
  local tool out mixed_reason
  local -a reason_lines
  for tool in "${tools[@]}"; do
    _fr_expect_url DENY "${tool}" 'https://github.com/example-org/example-repo' "github root denied for ${tool}"
  done

  _fr_expect_reason_has WebFetch 'https://github.com/example-org/example-repo/blob/main/src/foo.py' \
    "gh api 'repos/example-org/example-repo/contents/src/foo.py?ref=main' -H \"Accept: application/vnd.github.raw\"" 'blob'
  _fr_expect_reason_has WebFetch 'https://github.com/example-org/example-repo/tree/main/src' \
    "gh api 'repos/example-org/example-repo/contents/src?ref=main'" 'tree'
  _fr_expect_reason_has WebFetch 'https://github.com/example-org/example-repo/issues/42' \
    "gh issue view '42' -R 'example-org/example-repo' --comments" 'issue'
  _fr_expect_reason_has WebFetch 'https://github.com/example-org/example-repo/issues?q=is%3Aopen' \
    "gh search issues --repo 'example-org/example-repo'" 'issue search'
  _fr_expect_reason_has WebFetch 'https://github.com/example-org/example-repo/pulls?q=is%3Aopen' \
    "gh search prs --repo 'example-org/example-repo'" 'pulls search'
  _fr_expect_reason_has WebFetch 'https://github.com/example-org/example-repo/pull/7' \
    "gh pr view '7' -R 'example-org/example-repo' --comments" 'PR view'
  _fr_expect_reason_has WebFetch 'https://github.com/example-org/example-repo/pull/7' \
    "gh pr diff '7' -R 'example-org/example-repo'" 'PR diff (same reason as PR view)'
  _fr_expect_reason_has WebFetch 'https://github.com/example-org/example-repo/pull/7/files' \
    "gh pr view '7' -R 'example-org/example-repo' --comments" 'PR /files subpage'
  _fr_expect_reason_has WebFetch 'https://github.com/example-org/example-repo/pull/7/commits' \
    "gh pr view '7' -R 'example-org/example-repo' --comments" 'PR /commits subpage'
  _fr_expect_reason_has WebFetch 'https://github.com/example-org/example-repo/pull/7.diff' \
    "gh pr diff '7' -R 'example-org/example-repo'" 'PR .diff'
  _fr_expect_reason_has WebFetch 'https://github.com/example-org/example-repo/pull/7.patch' \
    "gh pr diff '7' -R 'example-org/example-repo'" 'PR .patch'
  _fr_expect_reason_has WebFetch 'https://github.com/example-org/example-repo/commit/deadbeef' \
    "gh api 'repos/example-org/example-repo/commits/deadbeef' -H \"Accept: application/vnd.github.patch\"" 'commit'
  _fr_expect_reason_has WebFetch 'https://github.com/example-org/example-repo/commit/deadbeef.patch' \
    "gh api 'repos/example-org/example-repo/commits/deadbeef' -H \"Accept: application/vnd.github.patch\"" 'commit .patch suffix stripped'
  _fr_expect_reason_has WebFetch 'https://github.com/example-org/example-repo/commit/deadbeef.diff' \
    "gh api 'repos/example-org/example-repo/commits/deadbeef' -H \"Accept: application/vnd.github.patch\"" 'commit .diff suffix stripped'
  _fr_expect_reason_has WebFetch 'https://github.com/example-org/example-repo/releases' \
    "gh release list -R 'example-org/example-repo'" 'releases root'
  _fr_expect_reason_has WebFetch 'https://github.com/example-org/example-repo/releases/tag/v1.0' \
    "gh release view 'v1.0' -R 'example-org/example-repo'" 'release tag'
  _fr_expect_reason_has WebFetch 'https://github.com/example-org/example-repo' \
    "gh repo view 'example-org/example-repo'" 'repo root'
  _fr_expect_reason_has WebFetch 'https://github.com/example-org/example-repo/discussions/3' \
    'gh api graphql' 'discussions'
  _fr_expect_reason_has WebFetch 'https://api.github.com/repos/example-org/example-repo' \
    "gh api 'repos/example-org/example-repo'" 'api.github.com'
  _fr_expect_reason_has WebFetch 'https://raw.githubusercontent.com/example-org/example-repo/main/src/foo.py' \
    "gh api 'repos/example-org/example-repo/contents/src/foo.py?ref=main' -H \"Accept: application/vnd.github.raw\"" 'raw.githubusercontent.com'
  _fr_expect_reason_has WebFetch 'https://raw.githubusercontent.com/example-org/example-repo/main/src/foo.py' \
    'ref may contain slashes' 'raw.githubusercontent.com ambiguity noted'

  # No shape-specific branch: generic gh pointer.
  _fr_expect_reason_has WebFetch 'https://gist.github.com/example-user/deadbeefcafe' 'gh api' 'gist.github.com generic'
  _fr_expect_reason_has WebFetch 'https://gist.githubusercontent.com/example-user/deadbeef/raw/file.py' 'gh api' 'gist.githubusercontent.com generic'
  _fr_expect_reason_has WebFetch 'https://codeload.github.com/example-org/example-repo/zip/refs/heads/main' 'gh api' 'codeload.github.com generic'
  _fr_expect_reason_has WebFetch 'https://objects.githubusercontent.com/example-blob' 'gh api' 'objects.githubusercontent.com generic'
  _fr_expect_reason_has WebFetch 'https://github.com/example-org/example-repo/settings' 'gh api' 'unrecognised github.com shape falls to generic'

  _fr_expect_url DENY WebFetch 'https://GitHub.com/example-org/example-repo' 'host matched case-insensitively'
  _fr_expect_url DENY WebFetch 'https://github.com:443/example-org/example-repo' 'host matched with a port'

  # Not GitHub code hosts: *.github.io, docs.github.com.
  _fr_expect_url PASS WebFetch 'https://example-org.github.io/some-page' 'github.io allowed'
  _fr_expect_url PASS WebFetch 'https://docs.github.com/en/actions' 'docs.github.com allowed'

  # --- URL authority parsing edge cases -------------------------------------
  # Scheme, userinfo, port and trailing-dot handling in _fr_split_url.

  _fr_expect_url PASS WebFetch 'https://github.com:pass@evil.com/o/r' \
    'userinfo before the host must not be mistaken for it — the real host is evil.com, not github.com'
  _fr_expect_url DENY WebFetch 'https://user@github.com/o/r' \
    'a userinfo@ prefix does not hide the real github.com host'
  _fr_expect_url DENY WebFetch 'https://github.com./o/r' \
    'one trailing dot on the host is stripped before matching'
  _fr_expect_url PASS WebFetch 'garbage://github.com/o/r' \
    'a non-http(s) scheme is never routed'
  _fr_expect_url PASS WebFetch 'https://github.com:bad/o/r' \
    'a non-digit port makes the URL unparseable and fails open'

  # --- Shell-quoting in suggested commands ----------------------------------
  # A path segment is arbitrary text, so every dynamic value in a suggested
  # command must be quoted.
  # The reason is "${url} blocked: ${FR_REASON}" (main() labels each denied
  # URL raw), so leak-checks are scoped to the command text after "use "/
  # inside the backticks, not the whole reason.

  local quote_out quote_reason want_quoted cmd_part
  quote_out="$(_fr_run_url WebFetch 'https://github.com/o/$(id)')"
  quote_reason="$(_fr_reason "${quote_out}" || true)"
  want_quoted="'o/\$(id)'"
  if [[ "${quote_reason}" == *"${want_quoted}"* ]]; then
    _pass "a repo name shaped like a command substitution is quoted in the suggested command"
  else
    _fail "expected the quoted form ${want_quoted} in reason: ${quote_reason}"
  fi
  cmd_part="${quote_reason#*use }"
  cmd_part="${cmd_part//"${want_quoted}"/}"
  if [[ "${cmd_part}" != *'$(id)'* ]]; then
    _pass "no unquoted \$(id) leaks into the suggested command outside the quoted form"
  else
    _fail "an unquoted \$(id) leaked into the suggested command: ${quote_reason}"
  fi

  quote_out="$(_fr_run_url WebFetch 'https://x.com/someuser/status/1234567890?s=20&x=1')"
  quote_reason="$(_fr_reason "${quote_out}" || true)"
  cmd_part="${quote_reason#*\`}"
  cmd_part="${cmd_part%%\`*}"
  if [[ "${cmd_part}" == *"'https://x.com/someuser/status/1234567890'"* ]]; then
    _pass "an X status URL's suggested command is quoted with the query string stripped"
  else
    _fail "expected a quoted, query-stripped URL in the suggested command: ${cmd_part}"
  fi
  if [[ "${cmd_part}" != *'s=20'* ]]; then
    _pass "the X status URL's query string does not leak into the suggested command"
  else
    _fail "the query string leaked into the suggested command: ${cmd_part}"
  fi

  # --- api.github.com: query string preserved and quoted --------------------

  _fr_expect_reason_has WebFetch 'https://api.github.com/repos/example-org/example-repo/issues?state=closed' \
    "gh api 'repos/example-org/example-repo/issues?state=closed'" 'api.github.com query string preserved and quoted'

  # urls[] (MCP) shape.
  _fr_expect_url DENY mcp__exa__web_fetch_exa 'https://github.com/example-org/example-repo' 'exa web_fetch denied for github'
  out="$(_fr_run_urls mcp__parallel__web_fetch 'https://github.com/example-org/example-repo')"
  if [[ "$(_hook_verdict "${out}")" == DENY ]]; then
    _pass "DENY: github via urls[] MCP shape"
  else
    _fail "github via urls[] MCP shape not denied"
  fi

  # --- X status posts -----------------------------------------------------

  local -a x_deny_tools=(WebFetch mcp__exa__web_fetch_exa mcp__exa__crawling_exa)
  for tool in "${x_deny_tools[@]}"; do
    _fr_expect_url DENY "${tool}" 'https://x.com/someuser/status/1234567890' "x.com status denied for ${tool}"
    _fr_expect_reason_has "${tool}" 'https://x.com/someuser/status/1234567890' 'mcp__parallel__web_fetch' "X fallback named for ${tool}"
  done
  _fr_expect_url PASS mcp__parallel__web_fetch 'https://x.com/someuser/status/1234567890' 'X status allowed through mcp__parallel__web_fetch'

  # Every status-URL shape and host alias.
  _fr_expect_url DENY WebFetch 'https://twitter.com/someuser/status/1234567890' 'twitter.com status'
  _fr_expect_url DENY WebFetch 'https://www.twitter.com/someuser/status/1234567890' 'www.twitter.com status'
  _fr_expect_url DENY WebFetch 'https://mobile.twitter.com/someuser/status/1234567890' 'mobile.twitter.com status'
  _fr_expect_url DENY WebFetch 'https://mobile.x.com/someuser/status/1234567890' 'mobile.x.com status'
  _fr_expect_url DENY WebFetch 'https://www.x.com/someuser/status/1234567890' 'www.x.com status'
  _fr_expect_url DENY WebFetch 'https://x.com/i/status/1234567890' 'x.com/i/status'
  _fr_expect_url DENY WebFetch 'https://x.com/i/web/status/1234567890' 'x.com/i/web/status'

  _fr_expect_url DENY WebFetch 'https://x.com/someuser/status/1234567890/' 'x.com status with one trailing slash'
  _fr_expect_url DENY WebFetch 'https://x.com/i/status/1234567890/' 'x.com/i/status with one trailing slash'
  _fr_expect_url DENY WebFetch 'https://x.com/i/web/status/1234567890/' 'x.com/i/web/status with one trailing slash'

  _fr_expect_url PASS WebFetch 'https://x.com/someuser' 'x.com profile page allowed'
  _fr_expect_url PASS WebFetch 'https://x.com/search?q=example' 'x.com search allowed'

  # --- WebSearch / mcp__parallel__web_search: denied outright, any query ----

  local ws_tool ws_out ws_reason ws_empty_out ws_want
  ws_want='web search blocked: use mcp__exa__web_search_exa; if Exa fails, stop and tell the user.'
  for ws_tool in WebSearch mcp__parallel__web_search; do
    ws_out="$(_fr_run_search 'whatever the query is' "${ws_tool}")"
    if [[ "$(_hook_verdict "${ws_out}")" == DENY ]]; then
      _pass "DENY: ${ws_tool} denied outright"
    else
      _fail "${ws_tool} was not denied"
    fi
    ws_reason="$(_fr_reason "${ws_out}" || true)"
    if [[ "${ws_reason}" == "${ws_want}" ]]; then
      _pass "${ws_tool} deny reason is the one-line Exa pointer"
    else
      _fail "${ws_tool} deny reason unexpected: ${ws_reason}"
    fi
    if [[ -n "${ws_reason}" && "${ws_reason}" != *$'\n'* && ${#ws_reason} -le 120 ]]; then
      _pass "${ws_tool} deny reason is a single line of ${#ws_reason} chars (<= 120)"
    else
      _fail "${ws_tool} deny reason is not one line under 121 chars: ${ws_reason}"
    fi

    # Unconditional: an empty query is denied too.
    ws_empty_out="$(_fr_run_search '' "${ws_tool}")"
    if [[ "$(_hook_verdict "${ws_empty_out}")" == DENY ]]; then
      _pass "DENY: ${ws_tool} with an empty query still denied"
    else
      _fail "${ws_tool} with an empty query was not denied"
    fi
  done

  # Other tools carrying a query are not search tools: silent allow.
  ws_out="$(_fr_run_search 'q' mcp__exa__web_search_exa)"
  if [[ "$(_hook_verdict "${ws_out}")" == PASS ]]; then
    _pass "PASS: mcp__exa__web_search_exa is never denied by the search rule"
  else
    _fail "mcp__exa__web_search_exa was denied or produced invalid output"
  fi

  # Rule-2 regression: a batch running the per-URL classifier repeatedly in
  # one process must print exactly one JSON object.
  out="$(_fr_run_urls mcp__exa__web_fetch_exa \
    'https://github.com/example-org/example-repo/blob/main/a.py' \
    'https://github.com/example-org/example-repo/blob/main/b.py' \
    'https://github.com/example-org/example-repo/pull/1' \
    'https://github.com/example-org/example-repo/pull/2' \
    'https://raw.githubusercontent.com/example-org/example-repo/main/c.py' \
    'https://raw.githubusercontent.com/example-org/example-repo/main/d.py')"
  if [[ "$(_hook_verdict "${out}")" == DENY ]]; then
    _pass "DENY: repeated same-shape URLs yield one valid JSON verdict"
  else
    _fail "repeated same-shape URLs produced an invalid verdict: ${out}"
  fi
  mixed_reason="$(_fr_reason "${out}" || true)"
  # shellcheck disable=SC2296  # zsh (f) splits on newlines
  reason_lines=("${(@f)mixed_reason}")
  if (( ${#reason_lines[@]} == 6 )); then
    _pass "one reason line per denied URL"
  else
    _fail "expected six reason lines, got ${#reason_lines[@]}: ${mixed_reason}"
  fi

  # --- unrelated URLs -------------------------------------------------------

  _fr_expect_url PASS WebFetch 'https://example.com/whatever' 'unrelated host allowed'
  _fr_expect_url PASS WebFetch 'https://example.com/github.com/not-actually-github' 'github.com only in the path, not the host'

  # --- mixed batch: deny the whole call, name only the offenders -----------

  out="$(_fr_run_urls mcp__exa__web_fetch_exa \
    'https://github.com/example-org/example-repo/blob/main/foo.py' \
    'https://x.com/someuser/status/42' \
    'https://example.com/fine')"
  if [[ "$(_hook_verdict "${out}")" == DENY ]]; then
    _pass "DENY: mixed batch with two offenders and one innocent URL"
  else
    _fail "mixed batch was not denied"
  fi
  mixed_reason="$(_fr_reason "${out}" || true)"
  if [[ "${mixed_reason}" == *'github.com/example-org/example-repo/blob/main/foo.py'* ]]; then
    _pass "mixed batch: github offender named"
  else
    _fail "mixed batch: github offender missing"
  fi
  if [[ "${mixed_reason}" == *'x.com/someuser/status/42'* ]]; then
    _pass "mixed batch: x.com offender named"
  else
    _fail "mixed batch: x.com offender missing"
  fi
  if [[ "${mixed_reason}" != *'example.com/fine'* ]]; then
    _pass "mixed batch: innocent URL NOT named individually"
  else
    _fail "mixed batch: innocent URL leaked into the reason"
  fi
  if [[ "${mixed_reason}" == *'1 other URL(s)'* && "${mixed_reason}" == *'separate call'* ]]; then
    _pass "mixed batch: says how many were fine and to re-issue separately"
  else
    _fail "mixed batch: missing the re-issue footer"
  fi

  out="$(_fr_run_urls mcp__exa__web_fetch_exa 'https://example.com/a' 'https://example.com/b')"
  if [[ "$(_hook_verdict "${out}")" == PASS ]]; then
    _pass "PASS: all-innocent batch"
  else
    _fail "all-innocent batch was denied"
  fi

  # --- fail-open --------------------------------------------------------------
  # Every fail-open path must print nothing AND exit 0: a nonzero exit with
  # empty stdout still reads as a hook error, not a clean allow.

  local fo_out fo_rc

  fo_out="$(printf '%s' '{}' | /bin/zsh "${SCRIPT_DIR}/claude/hooks/fetch-route-hook")"; fo_rc=$?
  if [[ -z "${fo_out}" && "${fo_rc}" -eq 0 ]]; then
    _pass "fail-open: payload with no tool_name allows the fetch (status 0, empty stdout)"
  else
    _fail "fail-open: payload with no tool_name — status ${fo_rc}, stdout: ${fo_out}"
  fi

  fo_out="$(printf '%s' 'not json' | /bin/zsh "${SCRIPT_DIR}/claude/hooks/fetch-route-hook")"; fo_rc=$?
  if [[ -z "${fo_out}" && "${fo_rc}" -eq 0 ]]; then
    _pass "fail-open: unparseable payload allows the fetch (status 0, empty stdout)"
  else
    _fail "fail-open: unparseable payload — status ${fo_rc}, stdout: ${fo_out}"
  fi

  fo_out="$(printf '%s' '' | /bin/zsh "${SCRIPT_DIR}/claude/hooks/fetch-route-hook")"; fo_rc=$?
  if [[ -z "${fo_out}" && "${fo_rc}" -eq 0 ]]; then
    _pass "fail-open: empty payload allows the fetch (status 0, empty stdout)"
  else
    _fail "fail-open: empty payload — status ${fo_rc}, stdout: ${fo_out}"
  fi

  # tool_name present, no url/urls.
  fo_out="$(jq -n '{tool_name:"WebFetch", tool_input:{}}' | /bin/zsh "${SCRIPT_DIR}/claude/hooks/fetch-route-hook")"; fo_rc=$?
  if [[ -z "${fo_out}" && "${fo_rc}" -eq 0 ]]; then
    _pass "fail-open: tool_input with no url/urls allows the fetch (status 0, empty stdout)"
  else
    _fail "fail-open: tool_input with no url/urls — status ${fo_rc}, stdout: ${fo_out}"
  fi
}
