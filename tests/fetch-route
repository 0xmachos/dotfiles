#!/bin/zsh
# dotfiles/tests/fetch-route
#
# Test for claude/hooks/fetch-route-hook (PreToolUse). One input is one case.
# The hook denies:
#   - a GitHub host fetch on the fetch tools, naming the gh command for that
#     URL's shape
#   - an X status post via the Exa tools, naming fetch-post (allowed via
#     mcp__parallel__web_fetch)
#   - every WebSearch call, naming Exa
#   - every WebFetch call, whatever the URL, with one fixed reason
# The cases cover one GitHub shape, the X rule and its allowed tool, the
# search and WebFetch denies, a mixed urls[] batch, shell quoting of the
# suggested command, the userinfo host trap, an unrelated URL, fail-open, and
# two payload shapes that once hid a routed URL (two JSON values, a payload
# past one 64 KiB read). Fixture URLs are invented (example-org/example-repo),
# never a real repo or X post.
#
# Run: ./test fetch-route
#
# ShellCheck: lint with `shellcheck --shell=bash tests/fetch-route`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib
# shellcheck disable=SC2016
# SC2016: the '$(id)' fixture must not expand; the hook must quote it.

typeset -g _FR_HOOK='' _FR_TMP=''

function _fr_run_urls {
  # MCP-shaped urls[] payload for tool $1 and the URLs after it.
  local tool="$1"
  shift
  jq -n --arg t "${tool}" '{tool_name:$t, tool_input:{urls:$ARGS.positional}}' --args "$@" \
    | /bin/zsh "${_FR_HOOK}"
}

function _fr_reason {
  # Deny reason of hook output $1 (empty when there is none).
  printf '%s' "$1" | jq -er '.hookSpecificOutput.permissionDecisionReason' 2>/dev/null || true
}

function _fr_check {
  # $1 = want (PASS or DENY), $2 = hook output, $3 = label, $4 = a substring the
  # reason must hold (optional), $5 = a substring it must not hold (optional).
  local got reason
  got="$(_hook_verdict "$2")"
  reason="$(_fr_reason "$2")"
  if [[ "${got}" == "$1" && "${reason}" == *"${4-}"* && ( -z "${5-}" || "${reason}" != *"${5}"* ) ]]; then
    _pass "$1: $3"
  else
    _fail "$3 — expected $1 with '${4-}', got ${got}: ${reason:0:160}"
  fi
}

function _fr_raw {
  # $1 = label, $2 = wanted verdict, $3 = raw stdin built by printf %b. Also
  # asserts exit status 0 (a nonzero status with empty stdout is a hook error).
  # Stdin is a file, not a pipe: a hook that stops reading early must fail the
  # case, not hang the writer.
  local out rc got inf="${_FR_TMP}/in"
  printf '%b' "$3" > "${inf}"
  out="$(/bin/zsh "${_FR_HOOK}" < "${inf}" 2>/dev/null)"; rc=$?
  got="$(_hook_verdict "${out}")"
  if [[ "${rc}" -eq 0 && "${got}" == "$2" ]]; then
    _pass "$2: $1"
  else
    _fail "$1 — wanted $2, got ${got}, status ${rc}"
  fi
}

function run_fetch_route {
  _section "fetch → gh/oEmbed routing hook"

  _FR_HOOK="${SCRIPT_DIR}/claude/hooks/fetch-route-hook"
  # claude/ is gitignored and synced out of band: absent hook = skip.
  if [[ ! -f "${_FR_HOOK}" ]]; then
    _skip "claude/hooks/fetch-route-hook absent — claude/ not yet synced to this machine"
    return 0
  fi

  if ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
    return
  fi

  _FR_TMP="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/fetch-route-test.XXXXXX")"

  local out gh='https://github.com/example-org/example-repo'

  out="$(_fr_run_urls mcp__exa__web_fetch_exa "${gh}/blob/main/src/foo.py")"
  _fr_check DENY "${out}" 'a GitHub blob URL names its gh api command' \
    "gh api 'repos/example-org/example-repo/contents/src/foo.py?ref=main'"

  out="$(_fr_run_urls mcp__exa__web_fetch_exa 'https://github.com/o/$(id)')"
  _fr_check DENY "${out}" 'a repo name shaped like a command substitution is quoted in the command' \
    "'o/\$(id)'"

  out="$(_fr_run_urls mcp__exa__web_fetch_exa 'https://x.com/someuser/status/1234567890')"
  _fr_check DENY "${out}" 'an X status URL on an Exa tool names mcp__parallel__web_fetch' mcp__parallel__web_fetch
  out="$(_fr_run_urls mcp__parallel__web_fetch 'https://x.com/someuser/status/1234567890')"
  _fr_check PASS "${out}" 'an X status URL on mcp__parallel__web_fetch'

  out="$(jq -cn '{tool_name:"WebSearch", tool_input:{query:"q"}}' | /bin/zsh "${_FR_HOOK}")"
  _fr_check DENY "${out}" 'WebSearch is denied, one Exa line' 'web search blocked: use mcp__exa__web_search_exa'

  out="$(jq -cn --arg u 'https://example.com/whatever' '{tool_name:"WebFetch", tool_input:{url:$u}}' | /bin/zsh "${_FR_HOOK}")"
  _fr_check DENY "${out}" 'WebFetch is denied for any URL' 'WebFetch blocked: use mcp__exa__web_fetch_exa'

  out="$(_fr_run_urls mcp__exa__web_fetch_exa "${gh}/blob/main/foo.py" 'https://example.com/fine')"
  _fr_check DENY "${out}" 'a mixed batch is denied whole, the innocent URL only counted' \
    '1 other URL(s)' 'example.com/fine blocked'

  out="$(_fr_run_urls mcp__exa__web_fetch_exa 'https://github.com:pass@evil.com/o/r')"
  _fr_check PASS "${out}" 'userinfo before the host is not taken for the host'

  out="$(_fr_run_urls mcp__exa__web_fetch_exa 'https://example.com/whatever')"
  _fr_check PASS "${out}" 'an unrelated URL on a fetch tool'

  _fr_raw 'unparseable payload fails open, status 0' PASS 'not json'
  _fr_raw 'two JSON values on stdin do not hide a routed URL' DENY \
    '{}{"tool_name":"mcp__exa__web_fetch_exa","tool_input":{"url":"'"${gh}"'/blob/main/a.py"}}'
  # shellcheck disable=SC2034  # read by the zsh (l) expansion below
  local fr_empty='' fr_pad
  # shellcheck disable=SC2296  # zsh (l) pads the empty parameter to 200000 bytes
  fr_pad="${(l:200000::x:)fr_empty}"
  _fr_raw '200 KB payload is read whole, routed URL after the padding' DENY \
    '{"pad":"'"${fr_pad}"'","tool_name":"mcp__exa__web_fetch_exa","tool_input":{"url":"'"${gh}"'/blob/main/a.py"}}'

  /bin/rm -rf "${_FR_TMP}"
}
