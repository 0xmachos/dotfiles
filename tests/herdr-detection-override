#!/bin/zsh
# dotfiles/tests/herdr-detection-override
#
# Test for bin/herdr-detection-override, which builds the local Herdr detection
# override for Claude Code (the remote manifest plus one rule that marks a pane
# with a running background shell or Monitor as working) and checks that the
# override is built on the current remote manifest.
#
# Every case runs the script as a child process with a clean environment
# (env -i), HOME set to a sandbox that holds a fixture remote manifest, and a
# fake herdr binary through HERDR_BIN_PATH. The fake logs its argv and can fail
# on request. The real HOME, the real herdr binary and the live server are never
# used. Whether Herdr accepts the rule is checked by hand with
# `herdr agent explain --file <screen> --agent claude`, never here.
#
# HERDR_DETECTION_OVERRIDE_TEST_SCRIPT=<path> runs the suite against another copy
# of the script (a mutation check on a scratch copy).
#
# Run: ./test herdr-detection-override
#
# ShellCheck: lint with `shellcheck --shell=bash tests/herdr-detection-override`.
# This file is sourced, not executed: chmod 644.
#
# shellcheck source=tests/lib

typeset -g _HCD_SCRIPT='' _HCD_BOX='' _HCD_FAKE='' _HCD_OUT='' _HCD_ERR=''
typeset -gi _HCD_RC=0

function _hcd_setup {
  local base="${TMPDIR:-/tmp}"
  base="${base%/}"
  _HCD_BOX="$(/usr/bin/mktemp -d "${base}/herdr-detection-override.XXXXXX")"
  _HCD_FAKE="${_HCD_BOX}/fake-herdr"
  cat > "${_HCD_FAKE}" <<'FAKE'
#!/bin/zsh
print -r -- "$*" >> "${FAKE_DIR}/calls.log"
[[ -n ${FAKE_FAIL:-} ]] && exit 1
exit 0
FAKE
  /bin/chmod 755 "${_HCD_FAKE}"
}

# _hcd_remote <version> [id]: write the fixture remote manifest.
function _hcd_remote {
  local d="${_HCD_BOX}/home/.local/state/herdr/agent-detection/remote"
  /bin/mkdir -p "${d}"
  printf 'id = "%s"\nversion = "%s"\n\n[[rules]]\nid = "live_prompt_box"\nstate = "idle"\npriority = 950\n' \
    "${2:-claude}" "$1" > "${d}/claude.toml"
}

function _hcd_reset {
  /bin/rm -rf "${_HCD_BOX:?}/home" "${_HCD_BOX:?}/calls.log"
  /bin/mkdir -p "${_HCD_BOX}/home"
  : > "${_HCD_BOX}/calls.log"
}

# _hcd_run <apply|check|...> [VAR=value ...]: sets _HCD_OUT, _HCD_ERR, _HCD_RC.
function _hcd_run {
  local arg="$1"
  shift
  _HCD_RC=0
  : > "${_HCD_BOX}/calls.log"
  _HCD_OUT="$(env -i PATH=/usr/bin:/bin HOME="${_HCD_BOX}/home" \
    HERDR_BIN_PATH="${_HCD_FAKE}" FAKE_DIR="${_HCD_BOX}" "$@" \
    /bin/zsh "${_HCD_SCRIPT}" "${arg}" 2>"${_HCD_BOX}/stderr")" || _HCD_RC=$?
  _HCD_ERR="$(< "${_HCD_BOX}/stderr")"
}

function _hcd_eq {
  if [[ "$2" == "$3" ]]; then
    _pass "$1"
  else
    _fail "$1 — expected [$2] got [$3]"
  fi
}

function _hcd_has {
  if [[ "$2" == *"$3"* ]]; then
    _pass "$1"
  else
    _fail "$1 — wanted [$3] in [$2]"
  fi
}

function _hcd_override { print -r -- "${_HCD_BOX}/home/.config/herdr/agent-detection/claude.toml"; }
function _hcd_exists {
  # _hcd_exists [path]: yes or no; the override when no path is given.
  if [[ -e "${1:-$(_hcd_override)}" ]]; then print yes; else print no; fi
}
function _hcd_calls { print -r -- "$(< "${_HCD_BOX}/calls.log")"; }

# _hcd_footer_regex <override text>: run the rule's footer regex over sample
# footer lines with perl (the pattern uses only syntax that Rust and Perl share).
function _hcd_footer_regex {
  local re line want
  re="${1#*line_regex = \[\'^}"
  re="^${re%%\']*}"
  local -a cases=(
    "yes|  ⏵⏵ auto mode on · 1 shell"
    "yes|  ⏵⏵ auto mode on · 1 shell, 1 monitor · ← 2 agents"
    "yes|  ⏵⏵ auto mode on (shift+tab to cycle) · 2 shells"
    "yes|  ⏸ plan mode on · 3 monitors"
    "no|  ⏵⏵ auto mode on · 0 shells"
    "no|  ⏵⏵ auto mode on"
    "no|  ⏵⏵ auto mode on · ← 2 agents"
    "no|  ? for shortcuts · 1 shell"
    "no|❯ note: the build prints 1 shell to run"
  )
  for line in "${cases[@]}"; do
    want="${line%%|*}"
    line="${line#*|}"
    if /usr/bin/perl -CSDA -Mutf8 -e 'my $re = shift; exit(($ARGV[0] =~ /$re/) ? 0 : 1)' "${re}" "${line}"; then
      _hcd_eq "footer regex on [${line}]" "${want}" "yes"
    else
      _hcd_eq "footer regex on [${line}]" "${want}" "no"
    fi
  done
}

function run_herdr_detection_override {
  _section "herdr claude detection override"

  _HCD_SCRIPT="${HERDR_DETECTION_OVERRIDE_TEST_SCRIPT:-${SCRIPT_DIR}/bin/herdr-detection-override}"
  if [[ ! -f "${_HCD_SCRIPT}" ]]; then
    _fail "script absent: ${_HCD_SCRIPT}"
    return 0
  fi
  _hcd_setup
  if [[ -z "${_HCD_BOX}" || ! -d "${_HCD_BOX}" ]]; then
    _fail "could not create a sandbox for the suite"
    return 0
  fi
  local ov text

  # apply: base line, the whole remote text, the new rule, one reload
  _hcd_reset
  _hcd_remote 2026.10.11.1
  _hcd_run apply
  ov="$(_hcd_override)"
  _hcd_eq "apply: exit 0" 0 "${_HCD_RC}"
  text="$(< "${ov}")"
  _hcd_eq "apply: first line records the remote version" \
    "# Built from the remote claude manifest version 2026.10.11.1." "${text%%$'\n'*}"
  _hcd_has "apply: keeps the remote rules" "${text}" 'id = "live_prompt_box"'
  _hcd_has "apply: adds the rule" "${text}" 'id = "background_shell_or_monitor_working"'
  _hcd_has "apply: rule is working at priority 960" "${text}" $'state = "working"\npriority = 960'
  _hcd_has "apply: rule reads the bottom 12 lines" "${text}" 'region = "bottom_non_empty_lines(12)"'
  _hcd_has "apply: rule needs a visible working signal" "${text}" 'visible_working = true'
  local g
  for g in '{ contains = ["do you want to proceed?"] }' '{ contains = ["esc to cancel"] }' \
    '{ contains = ["waiting for permission"] }' '{ contains = ["do you want to allow this connection?"] }' \
    '{ contains = ["tab to amend"] }' '{ contains = ["ctrl+e to explain"] }' \
    '{ contains = ["review your answers"] }' '{ contains = ["skip interview and plan immediately"] }' \
    "{ line_regex = ['(?i)^[\\s│]*❯?\\s*[1-3]\\.\\s*(?:yes|no)\\b'] }"; do
    _hcd_has "apply: rule keeps the guard ${g}" "${text}" "${g}"
  done
  _hcd_footer_regex "${text}"
  _hcd_eq "apply: reloads the server once" "server reload-agent-manifests" "$(_hcd_calls)"
  _hcd_eq "apply: only the override is in the directory" "claude.toml" \
    "$(/bin/ls -A "${ov:h}")"
  _hcd_eq "apply: the override is private (mode 600)" "600" \
    "$(/usr/bin/stat -f %Lp "${ov}")"

  # a second apply replaces the file, it does not append
  _hcd_run apply
  _hcd_eq "apply twice: one rule in the file" "1" \
    "$(/usr/bin/grep -c 'id = "background_shell_or_monitor_working"' "${ov}")"

  # check
  _hcd_run check
  _hcd_eq "check: current override exits 0" 0 "${_HCD_RC}"
  _hcd_has "check: says current" "${_HCD_OUT}" "override is current (remote 2026.10.11.1)"
  _hcd_remote 2026.11.01.1
  _hcd_run check
  _hcd_eq "check: older base exits 1" 1 "${_HCD_RC}"
  _hcd_has "check: names both versions" "${_HCD_ERR}" "built on 2026.10.11.1, remote is 2026.11.01.1"
  /bin/rm -f "${ov}"
  _hcd_run check
  _hcd_eq "check: missing override exits 1" 1 "${_HCD_RC}"
  _hcd_has "check: missing override says so" "${_HCD_ERR}" "no override at"
  printf 'id = "claude"\n' > "${ov}"
  _hcd_run check
  _hcd_eq "check: an override with no base line exits 1" 1 "${_HCD_RC}"
  _hcd_has "check: names the missing base line" "${_HCD_ERR}" "no base version line"

  # apply error paths: no override written, no reload
  _hcd_reset
  _hcd_run apply
  _hcd_eq "apply: no remote manifest exits 1" 1 "${_HCD_RC}"
  _hcd_has "apply: no remote manifest says how to fetch" "${_HCD_ERR}" "no remote manifest"
  _hcd_eq "apply: no remote manifest writes nothing" "no" \
    "$(_hcd_exists)"
  _hcd_eq "apply: no remote manifest does not reload" "" "$(_hcd_calls)"

  _hcd_reset
  _hcd_remote 2026.10.11.1 codex
  _hcd_run apply
  _hcd_eq "apply: another agent's manifest exits 1" 1 "${_HCD_RC}"
  _hcd_has "apply: another agent's manifest is named" "${_HCD_ERR}" "is not the claude manifest"
  _hcd_eq "apply: another agent's manifest writes nothing" "no" \
    "$(_hcd_exists)"

  _hcd_reset
  _hcd_remote 2026.10.11.1
  print -r -- 'id = "background_shell_or_monitor_working"' >> "${_HCD_BOX}/home/.local/state/herdr/agent-detection/remote/claude.toml"
  _hcd_run apply
  _hcd_eq "apply: a remote that holds the rule exits 1" 1 "${_HCD_RC}"
  _hcd_has "apply: says the remote has the rule" "${_HCD_ERR}" "already holds the rule"

  _hcd_reset
  /bin/mkdir -p "${_HCD_BOX}/home/.local/state/herdr/agent-detection/remote"
  printf 'id = "claude"\n' > "${_HCD_BOX}/home/.local/state/herdr/agent-detection/remote/claude.toml"
  _hcd_run apply
  _hcd_eq "apply: a manifest with no version exits 1" 1 "${_HCD_RC}"
  _hcd_has "apply: says the version line is missing" "${_HCD_ERR}" "no version line"

  # a failed reload leaves the file and exits 1
  _hcd_reset
  _hcd_remote 2026.10.11.1
  _hcd_run apply FAKE_FAIL=1
  _hcd_eq "apply: failed reload exits 1" 1 "${_HCD_RC}"
  _hcd_has "apply: failed reload says the file was written" "${_HCD_ERR}" "override written, but the server reload failed"
  _hcd_eq "apply: failed reload keeps the file" "yes" \
    "$(_hcd_exists)"

  # sync: rebuild only a stale override that this script wrote
  _hcd_reset
  _hcd_remote 2026.10.11.1
  _hcd_run apply
  _hcd_run sync
  _hcd_eq "sync: a current override exits 0" 0 "${_HCD_RC}"
  _hcd_eq "sync: a current override makes no call" "" "$(_hcd_calls)"
  _hcd_eq "sync: a current override prints nothing" "" "${_HCD_OUT}${_HCD_ERR}"
  _hcd_remote 2026.11.01.1
  _hcd_run sync
  _hcd_eq "sync: a stale override exits 0" 0 "${_HCD_RC}"
  _hcd_has "sync: a stale override is rebuilt on the new remote" \
    "$(< "$(_hcd_override)")" "# Built from the remote claude manifest version 2026.11.01.1."
  _hcd_eq "sync: a stale override reloads the server once" "server reload-agent-manifests" "$(_hcd_calls)"
  _hcd_run sync
  _hcd_eq "sync: after the rebuild it is quiet again" "" "$(_hcd_calls)"

  _hcd_reset
  _hcd_remote 2026.10.11.1
  _hcd_run sync
  _hcd_eq "sync: no override exits 0" 0 "${_HCD_RC}"
  _hcd_eq "sync: no override is never created" "no" "$(_hcd_exists)"
  _hcd_eq "sync: no override makes no call" "" "$(_hcd_calls)"

  _hcd_reset
  _hcd_remote 2026.10.11.1
  /bin/mkdir -p "${_HCD_BOX}/home/.config/herdr/agent-detection"
  printf 'id = "claude"\nversion = "0"\n' > "$(_hcd_override)"
  _hcd_run sync
  _hcd_eq "sync: an override from elsewhere exits 0" 0 "${_HCD_RC}"
  _hcd_eq "sync: an override from elsewhere is left alone" 'id = "claude"'$'\n''version = "0"' "$(< "$(_hcd_override)")"

  _hcd_reset
  _hcd_run sync
  _hcd_eq "sync: no remote manifest exits 0" 0 "${_HCD_RC}"

  # a failed sync is remembered for that remote version only; the failure here
  # (the remote is another agent's) writes nothing, so only the memory stops a retry
  _hcd_reset
  _hcd_remote 2026.10.11.1
  _hcd_run apply
  _hcd_remote 2026.11.01.1 codex
  _hcd_run sync
  _hcd_eq "sync: a failed rebuild exits 1" 1 "${_HCD_RC}"
  _hcd_has "sync: a failed rebuild says why" "${_HCD_ERR}" "is not the claude manifest"
  _hcd_run sync
  _hcd_eq "sync: the same failed version is not retried" 0 "${_HCD_RC}"
  _hcd_eq "sync: the same failed version prints nothing" "" "${_HCD_OUT}${_HCD_ERR}"
  _hcd_has "sync: a failed rebuild keeps the old override" \
    "$(< "$(_hcd_override)")" "version 2026.10.11.1."
  _hcd_remote 2026.12.01.1
  _hcd_run sync
  _hcd_eq "sync: a newer remote retries and succeeds" 0 "${_HCD_RC}"
  _hcd_has "sync: the retry is built on the newest remote" \
    "$(< "$(_hcd_override)")" "version 2026.12.01.1."
  _hcd_eq "sync: success clears the failure memory" "no" \
    "$(_hcd_exists "${_HCD_BOX}/home/Library/Caches/herdr-detection-override/failed")"

  # a failed reload leaves the new file in place; later syncs retry the reload alone
  _hcd_reset
  _hcd_remote 2026.10.11.1
  _hcd_run apply
  _hcd_remote 2026.11.01.1
  _hcd_run sync FAKE_FAIL=1
  _hcd_eq "sync: a failed reload exits 1" 1 "${_HCD_RC}"
  _hcd_has "sync: a failed reload keeps the rebuilt file" \
    "$(< "$(_hcd_override)")" "version 2026.11.01.1."
  _hcd_run sync FAKE_FAIL=1
  _hcd_eq "sync: a reload that keeps failing exits 0" 0 "${_HCD_RC}"
  _hcd_eq "sync: a reload that keeps failing is tried again" "server reload-agent-manifests" "$(_hcd_calls)"
  _hcd_run sync
  _hcd_eq "sync: the retried reload succeeds" "server reload-agent-manifests" "$(_hcd_calls)"
  _hcd_eq "sync: the retried reload clears the failure memory" "no" \
    "$(_hcd_exists "${_HCD_BOX}/home/Library/Caches/herdr-detection-override/failed")"
  _hcd_run sync
  _hcd_eq "sync: after the retry it is quiet again" "" "$(_hcd_calls)"

  # upstream ships the rule: the override has no job left and moves aside
  _hcd_reset
  _hcd_remote 2026.10.11.1
  _hcd_run apply
  _hcd_remote 2026.11.01.1
  print -r -- 'id = "background_shell_or_monitor_working"' >> \
    "${_HCD_BOX}/home/.local/state/herdr/agent-detection/remote/claude.toml"
  _hcd_run sync
  _hcd_eq "sync: a remote that holds the rule exits 0" 0 "${_HCD_RC}"
  _hcd_eq "sync: a remote that holds the rule removes the override" "no" "$(_hcd_exists)"
  _hcd_eq "sync: a remote that holds the rule keeps the old override aside" "yes" \
    "$(_hcd_exists "$(_hcd_override).upstream-has-rule")"
  _hcd_eq "sync: a remote that holds the rule reloads the server" "server reload-agent-manifests" "$(_hcd_calls)"

  # check without a remote manifest names the problem, with no raw shell error
  _hcd_reset
  _hcd_run check
  _hcd_eq "check: no remote manifest exits 1" 1 "${_HCD_RC}"
  _hcd_has "check: no remote manifest says so" "${_HCD_ERR}" "no remote manifest at"
  _hcd_eq "check: no remote manifest prints one line" "1" "$(print -r -- "${_HCD_ERR}" | /usr/bin/wc -l | /usr/bin/tr -d ' ')"

  # usage
  _hcd_run bogus
  _hcd_eq "usage: unknown word exits 2" 2 "${_HCD_RC}"
  _hcd_has "usage: prints usage" "${_HCD_ERR}" "usage: herdr-detection-override apply|check|sync"

  /bin/rm -rf "${_HCD_BOX}"
}
