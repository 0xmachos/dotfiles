#!/bin/zsh
# dotfiles/tests/resume-copy
#
# Pins claude/hooks/resume-copy-hook, the SessionEnd hook that copies
# `claude --resume <session_id>` to the pasteboard when the person quits.
# Feeds SessionEnd JSON on stdin and checks what reaches the pbcopy seam
# (RESUME_COPY_PBCOPY). The stub writes its stdin to a sandbox file, so a
# test run never writes the real pasteboard. The hook emits no verdict, so
# _hook_verdict is not used.
#
# Cases: a copy on prompt_input_exit (byte-exact, no trailing newline), no
# copy for a non-quit reason, no copy for an unsafe session id (the injection
# guard), a handoff marker on the pasteboard keeps it even when a recent
# handoff file exists, and a recent handoff file (3 human prompts after its
# mtime, with peer, /exit, tool-result and junk entries not counted) is copied
# byte-exact.
# The pbpaste seam (RESUME_COPY_PBPASTE) and the handoff root seam
# (RESUME_COPY_HANDOFF_ROOT) keep the run off the real pasteboard and tint.
#
# Run: ./test resume-copy
# ShellCheck: lint with `shellcheck --shell=bash tests/resume-copy`.
# Sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

function _rcp_run {
  # Run the hook with stdin $1 and pbcopy seam $2. Clears the capture file
  # first. Sets the caller's `rc` (hook exit status).
  local payload="$1" pb="$2"
  /bin/rm -f "${rcp_cap}"
  rc=0
  printf '%s' "${payload}" |
    RESUME_COPY_PBCOPY="${pb}" RESUME_COPY_PBPASTE="${rcp_pp}" \
      RESUME_COPY_HANDOFF_ROOT="${rcp_root}" \
      /bin/zsh "${SCRIPT_DIR}/claude/hooks/resume-copy-hook" \
      >/dev/null 2>&1 || rc=$?
}

function _rcp_expect {
  # Assert the last run exited 0 and copied exactly $2, labelled $1.
  local got
  if [[ -f "${rcp_cap}" ]]; then
    # The sentinel keeps a trailing newline that $(...) would strip.
    got="$(/bin/cat "${rcp_cap}"; print -n x)"
    got="${got%x}"
  else
    got="<no copy>"
  fi
  if [[ "${rc}" -eq 0 && "${got}" == "$2" ]]; then
    _pass "$1"
  else
    _fail "$1: expected '${2//$'\n'/\\n}', got '${got//$'\n'/\\n}' (rc=${rc})"
  fi
}

function _rcp_iso {
  # Print epoch $1 as an ISO 8601 UTC timestamp with milliseconds.
  /usr/bin/jq -nr --argjson t "$1" '$t | todate | sub("Z$"; ".500Z")'
}

function _rcp_tx {
  # Write transcript $1: one human prompt before epoch $2, then $3 human
  # prompts after it. The other entries after epoch $2 are not prompts and
  # must not count: a peer message, /exit (origin null), a tool result in
  # the earlier prompt, and a junk line.
  local out="$1" base="$2" n="$3" i
  {
    /usr/bin/jq -cn --arg ts "$(_rcp_iso $(( base - 60 )))" \
      '{type: "user", origin: {kind: "human"}, promptId: "p0", timestamp: $ts,
        message: {role: "user", content: "write a handoff"}}'
    for (( i = 1; i <= n; i++ )); do
      /usr/bin/jq -cn --arg ts "$(_rcp_iso $(( base + 60 * i )))" --arg p "p${i}" \
        '{type: "user", origin: {kind: "human"}, promptId: $p, timestamp: $ts,
          message: {role: "user", content: "next"}}'
    done
    /usr/bin/jq -cn --arg ts "$(_rcp_iso $(( base + 30 )))" \
      '{type: "user", origin: {kind: "peer"}, promptId: "peer1", timestamp: $ts,
        message: {role: "user", content: "note"}}'
    /usr/bin/jq -cn --arg ts "$(_rcp_iso $(( base + 1000 )))" \
      '{type: "user", origin: null, promptId: "exit1", timestamp: $ts,
        message: {role: "user", content: "<command-name>/exit</command-name>"}}'
    /usr/bin/jq -cn --arg ts "$(_rcp_iso $(( base + 40 )))" \
      '{type: "user", promptId: "p0", timestamp: $ts,
        message: {role: "user", content: [{type: "tool_result"}]}}'
    print -r -- 'not json {'
  } > "${out}"
}

function _rcp_handoff {
  # Write handoff file $1: text $2 plus a trailing newline, mtime epoch $3.
  /bin/mkdir -p "${1:h}"
  print -r -- "$2" > "$1"
  /usr/bin/touch -d "$(/usr/bin/jq -nr --argjson t "$3" '$t | todate')" "$1"
}

function _rcp_pl {
  # SessionEnd payload: $1 reason, $2 session_id, $3 transcript_path, $4 agent_id.
  /usr/bin/jq -cn --arg r "$1" --arg s "$2" --arg t "$3" --arg a "$4" '
    {hook_event_name: "SessionEnd", reason: $r, session_id: $s,
     transcript_path: $t, cwd: "/tmp"} + (if $a == "" then {} else {agent_id: $a} end)'
}

function _rcp_nocopy {
  # Assert the last run exited 0 and copied nothing, labelled $1.
  local cap=absent
  [[ -e "${rcp_cap}" ]] && cap=present
  if [[ "${rc}" -eq 0 && "${cap}" == absent ]]; then
    _pass "$1: exit 0, no copy"
  else
    _fail "$1: expected exit 0 and no copy, got rc=${rc}, capture ${cap}"
  fi
}

function run_resume_copy {
  _section "Resume copy hook"

  # Hook absent (clean clone, claude/ not synced): skip, not a regression.
  if [[ ! -f "${SCRIPT_DIR}/claude/hooks/resume-copy-hook" ]]; then
    _skip "claude/hooks/resume-copy-hook absent — claude/ not yet synced to this machine"
    return 0
  fi

  local rcp_sb rcp_cap rcp_pb rcp_pp rcp_clip rcp_root rcp_tp rc got want
  rcp_sb="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/resume-copy-test.XXXXXX")"
  rcp_cap="${rcp_sb}/pasteboard"
  rcp_pb="${rcp_sb}/pbcopy"
  rcp_pp="${rcp_sb}/pbpaste"
  rcp_clip="${rcp_sb}/clip"
  rcp_root="${rcp_sb}/tint"
  rcp_tp="${rcp_sb}/transcript.jsonl"
  /bin/mkdir -p "${rcp_root}"
  print -r -- '{}' > "${rcp_tp}"
  print -rn -- 'unrelated text' > "${rcp_clip}"
  print -rl -- '#!/bin/sh' "exec /bin/cat > '${rcp_cap}'" > "${rcp_pb}"
  print -rl -- '#!/bin/sh' "exec /bin/cat '${rcp_clip}'" > "${rcp_pp}"
  print -rl -- '#!/bin/sh' 'exit 1' > "${rcp_sb}/pbcopy-fail"
  /bin/chmod 755 "${rcp_pb}" "${rcp_pp}" "${rcp_sb}/pbcopy-fail"
  # A new stub can take seconds on its first exec (EDR scan): warm it once.
  print -n '' | "${rcp_pb}"
  "${rcp_pp}" >/dev/null

  # Session id shape, built at runtime (a UUID literal trips the PII scanner).
  local sid="0a1b2c3d-4e5f-6789-abcd-ef01"
  sid+="23456789"

  # 1. prompt_input_exit: the exact command, no trailing newline.
  _rcp_run "$(_rcp_pl prompt_input_exit "${sid}" "${rcp_tp}" "")" "${rcp_pb}"
  want="claude --resume ${sid}"
  if [[ -f "${rcp_cap}" ]]; then
    # The sentinel keeps a trailing newline that $(...) would strip.
    got="$(/bin/cat "${rcp_cap}"; print -n x)"
    got="${got%x}"
  else
    got="<no copy>"
  fi
  if [[ "${rc}" -eq 0 && "${got}" == "${want}" ]]; then
    _pass "prompt_input_exit: copies '${want}' with no trailing newline"
  else
    _fail "prompt_input_exit: expected '${want}', got '${got}' (rc=${rc})"
  fi

  # 2. A non-quit reason: no copy.
  _rcp_run "$(_rcp_pl clear "${sid}" "${rcp_tp}" "")" "${rcp_pb}"
  _rcp_nocopy "reason 'clear'"

  # 3. Unsafe id: no copy.
  # shellcheck disable=SC2016  # literal metacharacters
  _rcp_run "$(_rcp_pl prompt_input_exit 'abcd$(id)ef' "${rcp_tp}" "")" "${rcp_pb}"
  _rcp_nocopy "unsafe id"

  # 4. A handoff marker on the pasteboard wins over a recent handoff file.
  local marker hf base htext
  marker="$(/usr/bin/sed -n "s/^readonly marker='\(.*\)'\$/\1/p" \
    "${SCRIPT_DIR}/claude/hooks/resume-copy-hook")"
  base=1793000000
  hf="${rcp_root}/claude-handoff-${sid}/paste.txt"
  htext="${marker}"$'\n'"Read HANDOFF-Test.md and run its staleness probe."
  print -rn -- "${marker}"$'\n'"another session's handoff" > "${rcp_clip}"
  _rcp_tx "${rcp_tp}" "${base}" 0
  _rcp_handoff "${hf}" "${htext}" "${base}"
  _rcp_run "$(_rcp_pl prompt_input_exit "${sid}" "${rcp_tp}" "")" "${rcp_pb}"
  _rcp_nocopy "marker on the pasteboard and a recent handoff file"
  print -rn -- 'unrelated text' > "${rcp_clip}"

  # 5. Recent handoff: 3 prompts after it copy the file byte-exact.
  _rcp_tx "${rcp_tp}" "${base}" 3
  _rcp_run "$(_rcp_pl prompt_input_exit "${sid}" "${rcp_tp}" "")" "${rcp_pb}"
  _rcp_expect "handoff, 3 prompts after it: copies it, no trailing newline" "${htext}"

  /bin/rm -rf "${rcp_sb}"
  return 0
}
