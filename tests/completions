#!/bin/zsh
# dotfiles/tests/completions
#
# Pins the bittersweet completion to BITTERSWEET_SUBCOMMANDS, and the
# .githooks/pre-commit hook that enforces it, against fixture repos:
#   1. Parity: array keys and dispatch case arms match, both directions (the
#      hook runs this suite to block a commit on drift).
#   2. A staged set larger than the pipe buffer still regenerates, tests,
#      stages and scans the completion file.
#   3. A failing completion test blocks the commit and skips the scan.
#   4. A staged claude/ path blocks the commit before any other step.
# Each case feeds one input to the code under test.
#
# Run: ./test completions
# ShellCheck: lint with `shellcheck --shell=bash tests/completions`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib
# shellcheck disable=SC2030,SC2031  # fixture git environment stays in subshells

function _completions_array_keys {
  # Parses the static array literal; sourcing bittersweet would invoke main().
  /usr/bin/awk '
    /^typeset -ra BITTERSWEET_SUBCOMMANDS=\(/ { in_arr = 1; next }
    in_arr && /^\)/                           { in_arr = 0; next }
    in_arr && /^[[:space:]]*'\''/ {
      sub(/^[[:space:]]*'\''/, "")
      sub(/:.*/, "")
      print
    }
  ' "${SCRIPT_DIR}/bittersweet"
}

function _completions_dispatch_arms {
  # Arm names from main()'s dispatch, excluding the `*)` default.
  /usr/bin/awk '
    /case "\$\{cmd\}" in/ { in_case = 1; next }
    in_case && /^  esac/  { in_case = 0; next }
    in_case && /^    [a-z][a-z0-9-]*\)/ {
      sub(/^    /, "")
      sub(/\).*/, "")
      print
    }
  ' "${SCRIPT_DIR}/bittersweet"
}

function _completions_check_parity {
  local sot_keys arms only_in_sot only_in_arms
  sot_keys="$(_completions_array_keys | /usr/bin/sort -u)"
  arms="$(_completions_dispatch_arms | /usr/bin/sort -u)"

  only_in_sot="$(/usr/bin/comm -23 <(print -r -- "${sot_keys}") <(print -r -- "${arms}"))"
  only_in_arms="$(/usr/bin/comm -13 <(print -r -- "${sot_keys}") <(print -r -- "${arms}"))"

  if [[ -z "${only_in_sot}" && -z "${only_in_arms}" ]]; then
    _pass "BITTERSWEET_SUBCOMMANDS matches dispatch case arms"
    return
  fi

  _fail "BITTERSWEET_SUBCOMMANDS is out of sync with dispatch case arms"
  if [[ -n "${only_in_sot}" ]]; then
    echo "      In SOT but missing dispatch arm:"
    echo "${only_in_sot}" | /usr/bin/sed 's/^/        - /'
  fi
  if [[ -n "${only_in_arms}" ]]; then
    echo "      In dispatch but missing SOT entry:"
    echo "${only_in_arms}" | /usr/bin/sed 's/^/        - /'
  fi
}

function run_completions {
  _section "Bittersweet completion sync"

  _completions_check_parity
  _completions_check_large_commit
  _completions_check_blocked_commit
  _completions_check_claude_untracked
}

# Runs the real hook; every executable it dispatches is a fixture and the
# real repo is never staged.
function _completions_check_large_commit {
  local fixture rc=0
  fixture="$(mktemp -d "${TMPDIR}completion-hook.XXXXXX")"
  if (
    export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
    # A caller committing through a private index (or from a hook) exports
    # these; inherited, they point the fixture's git at the caller's index and
    # objects, and the fixture's `git add` corrupts that index.
    unset GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR
    cd "${fixture}" || exit 1
    git init -q
    git config core.hooksPath /dev/null
    mkdir -p .completions .config/git/hooks .githooks
    cat > bittersweet <<'EOF'
#!/bin/zsh
print generated > .completions/_bittersweet
print generated >> calls
EOF
    cat > ./test <<'EOF'
#!/bin/zsh
print tested >> calls
EOF
    cat > .config/git/hooks/pre-commit <<'EOF'
#!/bin/zsh
print scanned >> calls
EOF
    chmod 755 bittersweet test .config/git/hooks/pre-commit
    print old > .completions/_bittersweet
    # One shared empty blob in the index, not thousands of files.
    local empty i
    empty="$(git hash-object -w --stdin </dev/null)"
    for (( i=1; i<=2000; i++ )); do
      printf '100644 %s\tz-file-%05d-with-a-long-name-to-fill-the-pipe-buffer\n' "${empty}" "${i}"
    done > index-info
    git update-index --index-info < index-info
    git add bittersweet .completions/_bittersweet
    # The stub finds the global hook from its own path, so it runs from a
    # copy inside the fixture, as it does in a real checkout.
    cp "${SCRIPT_DIR}/.githooks/pre-commit" .githooks/pre-commit
    chmod 755 .githooks/pre-commit
    /bin/zsh .githooks/pre-commit >/dev/null
    [[ "$(<calls)" == $'generated\ntested\nscanned' ]] || exit 1
    [[ "$(git show :.completions/_bittersweet)" == generated ]] || exit 1
  ); then
    _pass "large staged changes still regenerate, test, stage and scan completions"
  else
    rc=$?
    _fail "large staged changes skipped completion enforcement (status ${rc})"
  fi
  /bin/rm -rf "${fixture}"
}

# A failing `./test completions` blocks the commit: the hook exits 1 with the
# drift banner and the test output, and never reaches the global scan hook.
function _completions_check_blocked_commit {
  local fixture out rc=0
  fixture="$(mktemp -d "${TMPDIR}completion-block.XXXXXX")"
  out="$(
    export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
    unset GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR
    cd "${fixture}" || exit 99
    git init -q
    git config core.hooksPath /dev/null
    mkdir -p .completions .config/git/hooks .githooks
    cat > bittersweet <<'EOF'
#!/bin/zsh
print generated > .completions/_bittersweet
EOF
    cat > ./test <<'EOF'
#!/bin/zsh
print tested >> calls
print "completion drift detail"
exit 1
EOF
    cat > .config/git/hooks/pre-commit <<'EOF'
#!/bin/zsh
print scanned >> calls
EOF
    chmod 755 bittersweet test .config/git/hooks/pre-commit
    print old > .completions/_bittersweet
    git add bittersweet .completions/_bittersweet
    cp "${SCRIPT_DIR}/.githooks/pre-commit" .githooks/pre-commit
    chmod 755 .githooks/pre-commit
    hook_rc=0
    /bin/zsh .githooks/pre-commit 2>&1 || hook_rc=$?
    print -r -- "hook_rc=${hook_rc}"
    print -r -- "calls=$(<calls)"
  )" || rc=$?
  if (( rc == 0 )) && [[ "${out}" == *'commit blocked'* && "${out}" == *'completion drift detail'* \
        && "${out}" == *'hook_rc=1'* && "${out}" == *'calls=tested' && "${out}" != *scanned* ]]; then
    _pass "a failing completion test blocks the commit and skips the scan"
  else
    _fail "failing completion test did not block the commit (status ${rc}): ${out}"
  fi
  /bin/rm -rf "${fixture}"
}

# A staged claude/ path blocks the commit before any other step runs, even
# when force-added past the ignore file.
function _completions_claude_fixture {
  # Stages a force-added claude/ file and runs the hook. Prints "hook_rc=N"
  # and "calls=...".
  export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
  unset GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR
  git init -q
  git config core.hooksPath /dev/null
  git config user.email t@example.invalid
  git config user.name t
  mkdir -p .config/git/hooks .githooks claude/hooks
  cat > .config/git/hooks/pre-commit <<'EOF2'
#!/bin/zsh
print scanned >> calls
EOF2
  chmod 755 .config/git/hooks/pre-commit
  cp "${SCRIPT_DIR}/.githooks/pre-commit" .githooks/pre-commit
  chmod 755 .githooks/pre-commit
  print x > claude/x
  git add -f claude/x
  local hook_rc=0
  /bin/zsh .githooks/pre-commit 2>&1 || hook_rc=$?
  print -r -- "hook_rc=${hook_rc}"
  print -r -- "calls=$( [[ -e calls ]] && print -r -- "$(<calls)" )"
}

function _completions_check_claude_untracked {
  local fixture out rc=0
  fixture="$(mktemp -d "${TMPDIR}completion-claude.XXXXXX")"
  out="$(cd "${fixture}" && _completions_claude_fixture)" || rc=$?
  if (( rc == 0 )) && [[ "${out}" == *'[❌] claude/ is never tracked: unstage it (git restore --staged claude/)'* \
        && "${out}" == *'hook_rc=1'* && "${out}" == *'calls=' && "${out}" != *scanned* ]]; then
    _pass "a staged claude/ path blocks the commit before the scan"
  else
    _fail "a staged claude/ path did not block the commit (status ${rc}): ${out}"
  fi
  /bin/rm -rf "${fixture}"
}
