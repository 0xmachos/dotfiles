#!/bin/zsh
# dotfiles/tests/okf
#
# Asserts the internals/ Open Knowledge Format (OKF) bundle is conformant and
# its index is in sync with the concept frontmatter.
#
# Two checks:
#   1. Conformance: every non-reserved internals/*.md declares the four
#      frontmatter keys the OKF reference parser requires (type, title,
#      description, timestamp), each with a non-empty value. Reserved files
#      (index.md, log.md) are exempt per OKF SPEC.md sections 6-7.
#   2. Freshness: regenerating the index into $TMPDIR yields a file
#      byte-identical to internals/index.md. Catches a concept whose
#      type/title/description changed without re-running the generator.
#
# Run: ./test okf    (or ./test for the full suite)
#
# ShellCheck: lint with `shellcheck --shell=bash tests/okf`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

# Validate all required scalar fields in one pass. EOF without a closing
# fence must fail, including an empty file (which executes no AWK rules).
function _okf_validate_frontmatter {
  /usr/bin/awk '
    BEGIN { split("type title description timestamp", required, " ") }
    NR == 1 && $0 != "---" { invalid = 1; exit }
    NR == 1 { next }
    $0 == "---" { closed = 1; exit }
    /^[A-Za-z]+:/ {
      key = $0; sub(/:.*/, "", key)
      value = $0; sub(/^[^:]*:[[:space:]]*/, "", value)
      sub(/[[:space:]]*$/, "", value)
      if (value != "" && value != "\"\"" && value != "\047\047" && value !~ /^#/)
        found[key] = 1
    }
    END {
      if (NR == 0 || invalid || !closed) {
        print "missing or unterminated leading frontmatter"
        exit 1
      }
      for (i = 1; i <= 4; i++) {
        if (!found[required[i]]) {
          printf "%s ", required[i]
          missing = 1
        }
      }
      if (missing) { print ""; exit 1 }
    }
  ' "$1"
}


function _okf_check_conformance {
  local bundle="${SCRIPT_DIR}/internals"
  local file name missing ok=1

  for file in "${bundle}"/*.md; do
    [[ -f "${file}" ]] || continue
    name="${file##*/}"
    [[ "${name}" == "index.md" || "${name}" == "log.md" ]] && continue
    if ! missing="$(_okf_validate_frontmatter "${file}")"; then
      _fail "okf: ${name} missing/empty frontmatter: ${missing}"
      ok=0
    fi
  done

  (( ok )) && _pass "Concept docs declare type, title, description, timestamp"
}

function _okf_check_freshness {
  local committed="${SCRIPT_DIR}/internals/index.md"
  local generated
  generated="$(/usr/bin/mktemp "${TMPDIR}okf-index.XXXXXX")"
  # shellcheck disable=SC2064  # expand path now, not on trap
  trap "/bin/rm -f '${generated}'" EXIT

  if ! "${SCRIPT_DIR}/bittersweet" okf-index "${generated}" >/dev/null; then
    _fail "Freshness: \`bittersweet okf-index\` exited non-zero"
    return
  fi

  if /usr/bin/diff -q "${committed}" "${generated}" >/dev/null 2>&1; then
    _pass "internals/index.md matches generator output"
  else
    _fail "internals/index.md is stale — run: bittersweet okf-index"
    /usr/bin/diff "${committed}" "${generated}" | /usr/bin/sed 's/^/      /' | /usr/bin/head -20
  fi
}

function run_okf {
  _section "OKF internals bundle"

  _okf_check_conformance
  _okf_check_freshness
}
