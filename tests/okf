#!/bin/zsh
# dotfiles/tests/okf
#
# Asserts the internals/ Open Knowledge Format (OKF) bundle is conformant and
# its index is in sync with the concept frontmatter.
#   1. Conformance: every internals/*.md except index.md and log.md (reserved,
#      OKF SPEC.md sections 6-7) has non-empty type, title, description and
#      timestamp, the keys the OKF reference parser requires.
#   2. Freshness: regenerating the index into $TMPDIR is byte-identical to
#      internals/index.md.
#
# Run: ./test okf
#
# ShellCheck: lint with `shellcheck --shell=bash tests/okf`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

# One awk run checks every FILE argument and prints "<name> missing/empty
# frontmatter: <problem>" per bad file; status 1 if any is bad. EOF without a
# closing fence fails, and so does an empty file (no AWK rule runs for it).
function _okf_validate_frontmatter {
  /usr/bin/awk '
    function report(msg) {
      print name " missing/empty frontmatter: " msg
      bad = 1
    }
    function finish(   i, missing) {
      if (!started) return
      if (invalid || !closed) {
        report("missing or unterminated leading frontmatter")
        return
      }
      for (i = 1; i <= 4; i++)
        if (!found[required[i]]) missing = missing (missing == "" ? "" : " ") required[i]
      if (missing != "") report(missing)
    }
    BEGIN { split("type title description timestamp", required, " ") }
    FNR == 1 {
      finish()
      started = 1; invalid = 0; closed = 0; done = 0
      delete found
      name = FILENAME; sub(/.*\//, "", name)
      seen[FILENAME] = 1
      if ($0 != "---") { invalid = 1; done = 1 }
      next
    }
    done { next }
    $0 == "---" { closed = 1; done = 1; next }
    /^[A-Za-z]+:/ {
      key = $0; sub(/:.*/, "", key)
      value = $0; sub(/^[^:]*:[[:space:]]*/, "", value)
      sub(/[[:space:]]*$/, "", value)
      if (value != "" && value != "\"\"" && value != "\047\047" && value !~ /^#/)
        found[key] = 1
    }
    END {
      finish()
      for (i = 1; i < ARGC; i++)
        if (!(ARGV[i] in seen)) {
          name = ARGV[i]; sub(/.*\//, "", name)
          report("missing or unterminated leading frontmatter")
        }
      exit bad
    }
  ' "$@"
}

# BUNDLE defaults to internals/; the regression suite passes a fixture.
function _okf_check_conformance {
  local bundle="${1:-${SCRIPT_DIR}/internals}"
  local file name line out rc=0 ok=1
  local -a files=()

  for file in "${bundle}"/*.md; do
    [[ -f "${file}" ]] || continue
    name="${file##*/}"
    [[ "${name}" == "index.md" || "${name}" == "log.md" ]] && continue
    files+=("${file}")
  done

  if (( ${#files} )); then
    out="$(_okf_validate_frontmatter "${files[@]}")" || rc=$?
    if [[ -n "${out}" ]]; then
      while IFS= read -r line; do
        _fail "okf: ${line}"
        ok=0
      done <<< "${out}"
    elif (( rc )); then
      _fail "okf: frontmatter validator exited ${rc} without a report"
      ok=0
    fi
  fi

  if (( ok )); then
    _pass "Concept docs declare type, title, description, timestamp"
  fi
}

function _okf_check_freshness {
  local committed="${SCRIPT_DIR}/internals/index.md"
  local generated
  generated="$(/usr/bin/mktemp "${TMPDIR}okf-index.XXXXXX")"
  # shellcheck disable=SC2064  # expand path now, not on trap
  trap "/bin/rm -f '${generated}'" EXIT

  if ! "${SCRIPT_DIR}/bittersweet" okf-index "${generated}" >/dev/null; then
    _fail "Freshness: \`bittersweet okf-index\` exited non-zero"
    return
  fi

  if /usr/bin/diff -q "${committed}" "${generated}" >/dev/null 2>&1; then
    _pass "internals/index.md matches generator output"
  else
    _fail "internals/index.md is stale — run: bittersweet okf-index"
    /usr/bin/diff "${committed}" "${generated}" | /usr/bin/sed 's/^/      /' | /usr/bin/head -20
  fi
}

function run_okf {
  _section "OKF internals bundle"

  # internals/ is gitignored, so a fresh clone has none: skip, don't abort on
  # the empty glob (2026-09-29).
  if [[ ! -d "${SCRIPT_DIR}/internals" ]]; then
    _skip "internals/ absent — pending out-of-band sync, bundle checks skipped"
    return
  fi

  _okf_check_conformance
  _okf_check_freshness
}
