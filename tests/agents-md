#!/bin/zsh
# dotfiles/tests/agents-md
#
# Guards the one-file agent-guidance design (adopted 2026-09-06 against Claude
# Code 2.1.263, Codex CLI 0.153.4, Muse Code 1.0.3-R2198.1):
#   repo scope    AGENTS.md is the real file; CLAUDE.md is a symlink to it.
#   global scope  claude/global-claude.md is the real file; both
#                 ~/.claude/CLAUDE.md and ~/.codex/AGENTS.md link to it.
# Claude Code needs the CLAUDE.md name through 2.1.263; 2.1.277 (2026-09-18)
# added native AGENTS.md fallback behind a GrowthBook flag
# (tengu_agents_md_mod) not guaranteed on, so the symlink stays. Codex ignores
# CLAUDE.md (project_doc_fallback_filenames defaults to empty). Muse dedupes by
# RESOLVED path, so the symlink loads once with no skipped-candidate warning.
#
# Breakage is invisible otherwise:
#   * the global `*claude*` rule in .config/git/ignore hides CLAUDE.md in every
#     repo, so git never shows the 120000 -> 100644 mode change
#   * Claude Code refuses to write through the symlink (#66559) and its error
#     says to resolve it and pass the real target; an agent that obeys, or a
#     BSD `sed -i`, replaces the link with a copy
#   * every harness still loads something plausible afterwards (Claude the
#     stale copy, Codex and Muse the fresh AGENTS.md)
# Size: Codex truncates past project_doc_max_bytes (32768) silently, mid-file,
# nothing on stderr (openai/codex#7138). Measured 2026-09-06: 32768 B loads
# whole, 32800 B loses its tail. A config.toml cap raise does not travel with a
# repo, so 32768 is the ceiling.
#
# Both files are gitignored: a fresh clone before out-of-band sync has neither,
# and that skips rather than fails. REVIEW.md checks run on a clean clone; the
# rest skips. Regrowth caps fail when a guidance file grows back; they skip with
# claude/ absent. The live check also diffs the ~/.agents/skills copies against
# claude/skills, so a stale copy fails.
#
# Run: ./test agents-md
#
# ShellCheck: lint with `shellcheck --shell=bash tests/agents-md`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

# Codex project_doc_max_bytes default; warn at 75%.
readonly _AGENTS_CAP_BYTES=32768
readonly _AGENTS_WARN_BYTES=24576

# zstat reads a file size without starting a process.
zmodload -F zsh/stat b:zstat

# Byte size of $1.
function _agents_size {
  local -a st
  # A missing file would fail the stat and, under the dispatcher's `set -euo
  # pipefail`, kill the whole ./test run with no summary.
  [[ -f "$1" ]] || { echo 0; return; }
  zstat -A st +size -- "$1"
  echo "${st[1]}"
}

function _agents_check_cap {
  local label="$1" file="$2" size
  size="$(_agents_size "${file}")"

  if (( size >= _AGENTS_CAP_BYTES )); then
    _fail "${label}: ${size} B is at or over Codex's ${_AGENTS_CAP_BYTES} B cap — it truncates silently, mid-file, and the rules near the end go first"
    return
  fi

  _pass "${label}: ${size} B, under the ${_AGENTS_CAP_BYTES} B Codex cap"
  if (( size >= _AGENTS_WARN_BYTES )); then
    echo "      ${YELLOW}warn${RESET}  ${label} is past 75% of the cap — start moving detail into internals/"
  fi
}

# Codex truncates from the END and the result is still a regular file under the
# cap, so the size check cannot see it: assert the last section instead. Move
# the pattern when a new last section is added, or the check stops guarding.
function _agents_check_tail {
  local label="$1" file="$2" pattern="$3"
  if /usr/bin/grep -q "${pattern}" "${file}"; then
    _pass "${label}: tail intact (${pattern} present)"
  else
    _fail "${label}: last section (${pattern}) missing — truncated or partially written, and it is still under the cap so the size check cannot catch it"
  fi
}

# Regrowth caps. Hard fails; the Codex 32768 B check above stays the outer
# ceiling. Format "max_bytes max_lines"; 0 = not checked.
readonly _CAP_GLOBAL="16000 210"
readonly _CAP_AGENTS="12100 212"
readonly _CAP_REVIEW="8000 140"
readonly _CAP_RULE_LINES=60
readonly _CAP_ORCH_LINES=70
readonly _CAP_SKILL_LINES=500

# $1 label, $2 file, $3 "max_bytes max_lines". Reuses _agents_size for bytes.
function _agents_check_regrowth {
  local label="$1" file="$2" max_b="${3%% *}" max_l="${3##* }" bytes lines bad=0
  local content newlines
  [[ -f "${file}" ]] || return 0
  bytes="$(_agents_size "${file}")"
  # Newline count, as `wc -l` gives it. read -d '' slurps the file and returns
  # 1 at EOF.
  IFS= read -rd '' content < "${file}" || true
  newlines="${content//[^$'\n']/}"
  lines="${#newlines}"
  if (( max_b > 0 && bytes > max_b )); then
    _fail "${label}: ${bytes} B over the ${max_b} B regrowth cap"; bad=1
  fi
  if (( max_l > 0 && lines > max_l )); then
    _fail "${label}: ${lines} lines over the ${max_l}-line regrowth cap"; bad=1
  fi
  (( bad )) || _pass "${label}: ${bytes} B / ${lines} lines, within the regrowth cap"
}

# Frontmatter lines of $1 (between the first two '---' fences), empty if none.
function _agents_frontmatter {
  local line n=0
  while IFS= read -r line || [[ -n "${line}" ]]; do
    if (( n++ == 0 )); then
      [[ "${line}" == "---" ]] || return 0
    elif [[ "${line}" =~ ^---[[:space:]]*$ ]]; then
      return 0
    else
      print -r -- "${line}"
    fi
  done < "$1"
}

function _agents_check_rule_file {
  local file="$1" name fm cap
  name="${file:t}"
  fm="$(_agents_frontmatter "${file}")"
  cap="${_CAP_RULE_LINES}"
  [[ "${name}" == orchestration.md ]] && cap="${_CAP_ORCH_LINES}"
  _agents_check_regrowth "rules/${name}" "${file}" "0 ${cap}"

  # `(^|\n)` anchors each pattern to a line start; the space classes exclude \n so a match stays on one line.
  local -r key_re=$'(^|\n)(globs|alwaysApply):'
  local -r scalar_re=$'(^|\n)paths:[ \t\r\f\v]*[^ \t\r\f\v\n#]'
  local -r bare_re=$'(^|\n)paths:[ \t\r\f\v]*(\n|$)'
  local -r item_re=$'(^|\n)[ \t\r\f\v]*-[ \t\r\f\v]+[^ \t\r\f\v\n]'
  if [[ "${fm}" =~ ${key_re} ]]; then
    _fail "rules/${name}: carries a globs:/alwaysApply: key — not Claude Code frontmatter; use paths: as a list"
  else
    _pass "rules/${name}: no globs:/alwaysApply: keys"
  fi
  # paths: must have nothing after the colon on its own line, followed by
  # '- item' lines (block list, any indent). A value on the same line is a
  # scalar or an inline flow value. Shape only; tests/agent-rules parses the
  # YAML.
  if [[ "${fm}" =~ ${scalar_re} ]]; then
    _fail "rules/${name}: paths: is not a block list"
  elif [[ "${fm}" =~ ${bare_re} && ! "${fm}" =~ ${item_re} ]]; then
    _fail "rules/${name}: paths: has no list items"
  else
    _pass "rules/${name}: paths: absent or a block list"
  fi
}

function _agents_check_regrowth_all {
  # null_glob: an empty rules/ or skills/ is a no-op, not a glob error. setopt,
  # not (N) qualifiers, which shellcheck --shell=bash cannot parse.
  setopt local_options null_glob
  local f
  [[ -d "${SCRIPT_DIR}/claude" ]] || {
    _skip "regrowth caps: claude/ absent — pending out-of-band sync"
    return
  }
  _agents_check_regrowth "global-claude.md" "${SCRIPT_DIR}/claude/global-claude.md" "${_CAP_GLOBAL}"
  _agents_check_regrowth "repo AGENTS.md" "${SCRIPT_DIR}/AGENTS.md" "${_CAP_AGENTS}"
  for f in "${SCRIPT_DIR}"/claude/rules/*.md; do
    _agents_check_rule_file "${f}"
  done
  for f in "${SCRIPT_DIR}"/claude/skills/*/SKILL.md; do
    _agents_check_regrowth "skills/${f:h:t}/SKILL.md" "${f}" "0 ${_CAP_SKILL_LINES}"
  done
}

# Review rulebook: tracked and public, so it must stay public-safe and short
# (a reviewer harness injects it whole).
function _agents_check_review {
  local review="${SCRIPT_DIR}/REVIEW.md" heading text
  if [[ ! -f "${review}" ]]; then
    _fail "REVIEW.md missing — reviewers have no rulebook"
    return
  fi
  if /usr/bin/git -C "${SCRIPT_DIR}" ls-files --error-unmatch REVIEW.md >/dev/null 2>&1; then
    _pass "REVIEW.md is tracked"
  else
    _fail "REVIEW.md is not tracked — it is the public rulebook and must be in git"
  fi
  _agents_check_regrowth "REVIEW.md" "${review}" "${_CAP_REVIEW}"
  # Newline-padded text, so a heading matches only as a whole line.
  text=$'\n'"$(<"${review}")"$'\n'
  for heading in 'What to flag' 'Evidence bar' 'Severity' 'Skip' 'Report shape'; do
    if [[ "${text}" == *$'\n'"## ${heading}"$'\n'* ]]; then
      _pass "REVIEW.md: section '${heading}' present"
    else
      _fail "REVIEW.md: section '${heading}' missing"
    fi
  done
  # Tracked file, public repo: no harness or model names. Private names (hosts,
  # nicknames) are the pii-tree suite's job, not this one's.
  if /usr/bin/grep -qiwE 'claude|codex|muse|fable|opus|sonnet|anthropic' "${review}"; then
    _fail "REVIEW.md names a harness or model — it is published; phrase the check as a mechanism"
  else
    _pass "REVIEW.md: no harness or model names"
  fi
}

# A review harness reads the nearest AGENTS.md "Code Review Rules"; the section
# sits near the end, so assert it and its order against the closeout tail.
function _agents_check_review_section {
  local label="$1" file="$2" cr stop
  # `|| true`: the suite runs under set -e/pipefail and a no-match grep is rc 1.
  cr="$(/usr/bin/grep -n '^## Code Review Rules' "${file}" | /usr/bin/head -1 || true)"
  stop="$(/usr/bin/grep -n '^## Before you stop' "${file}" | /usr/bin/head -1 || true)"
  if [[ -z "${cr}" ]]; then
    _fail "${label}: '## Code Review Rules' missing — a review run has no repo invariants to read"
  elif [[ -n "${stop}" && "${cr%%:*}" -gt "${stop%%:*}" ]]; then
    _fail "${label}: '## Code Review Rules' sits after '## Before you stop' — the tail must stay last"
  elif ! /usr/bin/grep -q 'REVIEW\.md' "${file}"; then
    _fail "${label}: Code Review Rules does not point at REVIEW.md"
  else
    _pass "${label}: Code Review Rules present, before the tail, pointing at REVIEW.md"
  fi
}

function _agents_check_repo_scope {
  local repo_agents="${SCRIPT_DIR}/AGENTS.md"
  local repo_claude="${SCRIPT_DIR}/CLAUDE.md"

  # CLAUDE.md is gitignored by the *claude* rule, AGENTS.md by .extra_gitexclude;
  # neither present means pending sync, not damage.
  if [[ ! -e "${repo_agents}" && ! -L "${repo_claude}" && ! -e "${repo_claude}" ]]; then
    _skip "repo: neither AGENTS.md nor CLAUDE.md present — clone pending out-of-band sync"
  else
    if [[ -f "${repo_agents}" && ! -L "${repo_agents}" ]]; then
      _pass "repo: AGENTS.md is a regular file (the single source)"
      _agents_check_cap "repo AGENTS.md" "${repo_agents}"
      _agents_check_tail "repo AGENTS.md" "${repo_agents}" '^## Before you stop'
      _agents_check_review_section "repo AGENTS.md" "${repo_agents}"
    elif [[ -L "${repo_agents}" ]]; then
      _fail "repo: AGENTS.md is a symlink — the direction is inverted; AGENTS.md must be the real file (Codex never reads CLAUDE.md)"
    else
      _fail "repo: AGENTS.md missing — Codex and Muse read no project guidance here"
    fi

    # The check this suite exists for.
    if [[ ! -L "${repo_claude}" ]]; then
      if [[ -e "${repo_claude}" ]]; then
        _fail "repo: CLAUDE.md is a regular file, not a symlink — the link was replaced and the two bodies will now drift silently (fix: rm CLAUDE.md && ln -s AGENTS.md CLAUDE.md)"
      else
        _fail "repo: CLAUDE.md missing — Claude Code reads no project guidance here (it does not read AGENTS.md)"
      fi
    else
      local target
      target="$(readlink "${repo_claude}")"
      if [[ "${target}" != "AGENTS.md" ]]; then
        _fail "repo: CLAUDE.md points at '${target}', expected the relative target 'AGENTS.md'"
      elif [[ ! -e "${repo_claude}" ]]; then
        _fail "repo: CLAUDE.md is a dangling symlink to '${target}'"
      else
        _pass "repo: CLAUDE.md -> AGENTS.md, resolving"
      fi
    fi
  fi
}

function _agents_check_global_source {
  local global_src="${SCRIPT_DIR}/claude/global-claude.md"

  # -f follows symlinks, so test -L separately: an inverted source is otherwise
  # missed wherever the live check skips.
  if [[ -L "${global_src}" ]]; then
    _fail "global: claude/global-claude.md is itself a symlink — the direction is inverted; it must be the real file both ~/.claude/CLAUDE.md and ~/.codex/AGENTS.md point at"
  elif [[ ! -f "${global_src}" ]]; then
    _skip "global: claude/global-claude.md absent — claude/ pending out-of-band sync"
  else
    _agents_check_cap "global-claude.md" "${global_src}"
    _agents_check_tail "global-claude.md" "${global_src}" '^## Machine notes'
  fi
}

# Runs "$@" with SCRIPT_DIR pointing at $1 and sets REPLY to its output. The
# command substitution is a subshell, so the pass and fail counters the
# handler moves never reach the suite totals.
function _agents_run_in {
  # shellcheck disable=SC2034
  local SCRIPT_DIR="$1"
  shift
  REPLY="$("$@" 2>&1)" || true
}

# $1 case name, $2 captured output, $3 colour, $4 PASS, FAIL or SKIP, $5 text.
# The case passes when the output holds that line.
function _agents_expect {
  if [[ "$2" == *"$3$4${RESET}  $5"* ]]; then
    _pass "fixture: $1"
  else
    _fail "fixture: $1: expected a $4 line starting '$5', got: $2"
  fi
}

# The repo-scope and global-source handlers over small fixture trees. Each
# handler runs in a subshell with its own counters, so only the expectation
# reaches the suite totals.
function _agents_fixture_cases {
  local root
  local -r tail=$'## Code Review Rules\nSee REVIEW.md.\n## Before you stop\n'
  root="$(mktemp -d "${TMPDIR}agents-md-fixture.XXXXXX")"
  /bin/mkdir -p "${root}"/{empty,good,copy,missing,other,dangling,inverted,noagents}/claude "${root}"/{gsym,gabsent,gok}/claude

  print -rn -- "${tail}" > "${root}/good/AGENTS.md"
  ln -s AGENTS.md "${root}/good/CLAUDE.md"

  print -rn -- "${tail}" > "${root}/copy/AGENTS.md"
  print -rn -- "${tail}" > "${root}/copy/CLAUDE.md"

  print -rn -- "${tail}" > "${root}/missing/AGENTS.md"

  print -rn -- "${tail}" > "${root}/other/AGENTS.md"
  print -rn -- "${tail}" > "${root}/other/NOTES.md"
  ln -s NOTES.md "${root}/other/CLAUDE.md"

  ln -s AGENTS.md "${root}/dangling/CLAUDE.md"

  print -rn -- "${tail}" > "${root}/inverted/CLAUDE.md"
  ln -s CLAUDE.md "${root}/inverted/AGENTS.md"

  print -rn -- "${tail}" > "${root}/noagents/CLAUDE.md"

  _agents_run_in "${root}/empty" _agents_check_repo_scope
  _agents_expect "repo: neither file present skips" "${REPLY}" "${YELLOW}" SKIP "repo: neither AGENTS.md nor CLAUDE.md present"
  _agents_run_in "${root}/good" _agents_check_repo_scope
  _agents_expect "repo: CLAUDE.md -> AGENTS.md passes" "${REPLY}" "${GREEN}" PASS "repo: CLAUDE.md -> AGENTS.md, resolving"
  if [[ "${REPLY}" == *FAIL* ]]; then
    _fail "fixture: repo: a correct pair reports no failure: ${REPLY}"
  else
    _pass "fixture: repo: a correct pair reports no failure"
  fi
  _agents_run_in "${root}/copy" _agents_check_repo_scope
  _agents_expect "repo: CLAUDE.md as a regular file fails" "${REPLY}" "${RED}" FAIL "repo: CLAUDE.md is a regular file, not a symlink"
  _agents_run_in "${root}/missing" _agents_check_repo_scope
  _agents_expect "repo: CLAUDE.md missing fails" "${REPLY}" "${RED}" FAIL "repo: CLAUDE.md missing"
  _agents_run_in "${root}/other" _agents_check_repo_scope
  _agents_expect "repo: CLAUDE.md pointing elsewhere fails" "${REPLY}" "${RED}" FAIL "repo: CLAUDE.md points at 'NOTES.md', expected the relative target 'AGENTS.md'"
  _agents_run_in "${root}/dangling" _agents_check_repo_scope
  _agents_expect "repo: CLAUDE.md link to an absent AGENTS.md fails" "${REPLY}" "${RED}" FAIL "repo: AGENTS.md missing"
  _agents_expect "repo: dangling CLAUDE.md fails" "${REPLY}" "${RED}" FAIL "repo: CLAUDE.md is a dangling symlink to 'AGENTS.md'"
  _agents_run_in "${root}/inverted" _agents_check_repo_scope
  _agents_expect "repo: AGENTS.md as a symlink fails" "${REPLY}" "${RED}" FAIL "repo: AGENTS.md is a symlink"
  _agents_run_in "${root}/noagents" _agents_check_repo_scope
  _agents_expect "repo: AGENTS.md missing fails" "${REPLY}" "${RED}" FAIL "repo: AGENTS.md missing"

  ln -s elsewhere.md "${root}/gsym/claude/global-claude.md"
  print -rn -- $'## Machine notes\n' > "${root}/gok/claude/global-claude.md"
  _agents_run_in "${root}/gsym" _agents_check_global_source
  _agents_expect "global: a symlinked source fails" "${REPLY}" "${RED}" FAIL "global: claude/global-claude.md is itself a symlink"
  _agents_run_in "${root}/gabsent" _agents_check_global_source
  _agents_expect "global: an absent source skips" "${REPLY}" "${YELLOW}" SKIP "global: claude/global-claude.md absent"
  _agents_run_in "${root}/gok" _agents_check_global_source
  _agents_expect "global: a regular source with its tail passes" "${REPLY}" "${GREEN}" PASS "global-claude.md: tail intact"
  /bin/rm -rf "${root}"
}

function run_agents_md {
  _section "Agent guidance: AGENTS.md / CLAUDE.md single-source"

  local global_src="${SCRIPT_DIR}/claude/global-claude.md"

  _agents_fixture_cases

  # 1. Repo scope.
  _agents_check_repo_scope

  # 2. Global source file.
  _agents_check_global_source

  # 3. Deploy-code parity (hermetic): catches a bittersweet regression where
  #    this repo is not the live deployment.
  local bittersweet="${SCRIPT_DIR}/bittersweet"
  # Single quotes on purpose: match the literal ${SCRIPT_DIR}/${HOME} text.
  # shellcheck disable=SC2016
  if /usr/bin/grep -q '_symlink "${SCRIPT_DIR}/claude/global-claude.md" "${HOME}/.codex/AGENTS.md"' "${bittersweet}"; then
    _pass "bittersweet: ~/.codex/AGENTS.md deploys from claude/global-claude.md"
  else
    _fail "bittersweet: no _symlink deploying claude/global-claude.md to ~/.codex/AGENTS.md — Codex and Claude would drift apart again"
  fi

  # The Claude half deploys via a claude_files map entry, not a _symlink call,
  # so it needs its own guard (a dropped row is invisible where step 4 skips).
  if /usr/bin/grep -q '"claude/global-claude.md:CLAUDE.md"' "${bittersweet}"; then
    _pass "bittersweet: ~/.claude/CLAUDE.md registered in the claude_files map"
  else
    _fail "bittersweet: claude/global-claude.md absent from the claude_files map — Claude Code would lose its global instructions"
  fi

  # shellcheck disable=SC2016
  if /usr/bin/grep -q '"\${SCRIPT_DIR}/claude/global-claude.md"' "${bittersweet}"; then
    _pass "bittersweet: claude/global-claude.md is hardened (sensitive_files)"
  else
    _fail "bittersweet: claude/global-claude.md missing from sensitive_files — it names hosts and must be mode 600"
  fi

  # 3b. Review rulebook and regrowth caps. Before the live gate below, which
  #     returns early: REVIEW.md is tracked, so its checks run on a clean clone.
  _agents_check_review
  _agents_check_regrowth_all

  # 4. Live deployment: gated like tests/hook-links, meaningful only when this
  #    repo is the active deployment.
  if [[ "$(readlink "${HOME}/.claude/settings.json" 2>/dev/null)" != "${SCRIPT_DIR}/claude/settings.json" ]]; then
    _skip "global deployment: ~/.claude not linked to this repo (run: bittersweet dotfiles)"
    return
  fi

  local live
  for live in "${HOME}/.claude/CLAUDE.md" "${HOME}/.codex/AGENTS.md"; do
    if [[ ! -L "${live}" ]]; then
      _fail "global: ${live} is not a symlink — it must link to claude/global-claude.md"
    elif [[ "$(readlink "${live}")" != "${global_src}" ]]; then
      _fail "global: ${live} points at '$(readlink "${live}")', expected ${global_src}"
    elif [[ ! -e "${live}" ]]; then
      _fail "global: ${live} is a dangling symlink"
    else
      _pass "global: ${live} -> claude/global-claude.md"
    fi
  done
  # ~/.agents/skills holds copies of the shared allowlist (a copy has no
  # readlink to compare, so diff against the source; that also catches a stale
  # copy).
  local shared
  if [[ -d "${HOME}/.agents/skills" && ! -L "${HOME}/.agents/skills" ]]; then
    _pass "global: ~/.agents/skills is a real directory"
  else
    _fail "global: ~/.agents/skills must be a real directory of skill copies (run: bittersweet dotfiles)"
  fi
  for shared in git-history-repair zsh-style macos-security-footguns bao-admin swift-conventions rust-conventions npm-conventions python-conventions objc-conventions ci-conventions; do
    if [[ -L "${HOME}/.agents/skills/${shared}" ]]; then
      _fail "global: ~/.agents/skills/${shared} is a symlink; a copy is required (run: bittersweet dotfiles)"
    elif /usr/bin/diff -rq "${SCRIPT_DIR}/claude/skills/${shared}" "${HOME}/.agents/skills/${shared}" >/dev/null 2>&1; then
      _pass "global: ~/.agents/skills/${shared} matches claude/skills/${shared}"
    else
      _fail "global: ~/.agents/skills/${shared} is missing or stale (run: bittersweet dotfiles)"
    fi
  done
}
