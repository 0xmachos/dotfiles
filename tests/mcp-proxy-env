#!/bin/zsh
# dotfiles/tests/mcp-proxy-env
#
# Hermetic suite for bin/mcp-proxy-env: no network, no real mcp-proxy. The
# script runs under the Homebrew venv interpreter with a fake mcp_proxy package
# on PYTHONPATH (written into the per-run sandbox). The fake's
# mcp_proxy.__main__.main() records sys.argv, the URL variable, and the
# kernel argument line of its own process (ps), so the suite can show that the
# URL reaches mcp-proxy without ever appearing in a process argument list.
# The suite skips when the venv interpreter is absent (CI).
#
# Pins:
#   - the URL is read from MCP_PROXY_URL and is the last argument; passthrough
#     arguments keep their order;
#   - the URL is never in argv positions before the last, and never in the
#     ps argument line of the running process (no child process either);
#   - unset variable: exit 78 and the proxy is never called;
#   - a header flag and a "://" argument: exit 64, the proxy is never
#     called, nothing on stdout, and no error text carries the URL or the
#     refused argument.
#
# Set MPE_BIN_OVERRIDE to run a scratch copy of the script (red-path checks).
# Run: ./test mcp-proxy-env
# ShellCheck: lint with `shellcheck --shell=bash tests/mcp-proxy-env`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib
# shellcheck disable=SC2016,SC2329,SC2015  # print never fails

readonly MPE_PY='/opt/homebrew/opt/mcp-proxy/libexec/bin/python'

typeset -g MPE_T='' MPE_BIN='' MPE_FAKE='' MPE_REC='' MPE_OUT='' MPE_ERR=''
typeset -g MPE_URL='' MPE_RC=0
typeset -ga MPE_EXTRA=()

function _mpe_setup {
  zmodload -F zsh/files b:zf_rm b:zf_mkdir
  MPE_T="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/mcp-proxy-env-test.XXXXXX")"
  MPE_BIN="${MPE_BIN_OVERRIDE:-${SCRIPT_DIR}/bin/mcp-proxy-env}"
  MPE_FAKE="${MPE_T}/fake"
  MPE_REC="${MPE_T}/record.json"
  MPE_OUT="${MPE_T}/out"
  MPE_ERR="${MPE_T}/err"
  # Synthetic capability URL, assembled at run time.
  MPE_URL="https://ha.test/""cap-""xk7q"
  zf_mkdir -p "${MPE_FAKE}/mcp_proxy"
  : > "${MPE_FAKE}/mcp_proxy/__init__.py"
  cat > "${MPE_FAKE}/mcp_proxy/__main__.py" <<'PYEOF'
import json
import os
import subprocess
import sys


def main():
    name = "MCP_PROXY_URL"
    ps = subprocess.run(
        ["/bin/ps", "-ww", "-o", "args=", "-p", str(os.getpid())],
        capture_output=True, text=True,
    ).stdout.strip()
    with open(os.environ["FAKE_RECORD"], "w") as fh:
        json.dump({"argv": sys.argv, "env_url": os.environ.get(name), "ps": ps}, fh)
PYEOF
}

function _mpe_teardown {
  [[ -n "${MPE_T}" && -d "${MPE_T}" ]] && zf_rm -rf "${MPE_T}"
  return 0
}

# Run the script under the venv interpreter. The environment starts empty
# (env -i); extra pairs come from MPE_EXTRA, cleared afterwards. A PYTHONPATH
# pair in MPE_EXTRA comes later on the command line and wins.
function _mpe_run {
  MPE_RC=0
  zf_rm -f "${MPE_REC}"
  /usr/bin/env -i \
    PATH="/usr/bin:/bin" TMPDIR="${TMPDIR:-/tmp}" HOME="${MPE_T}" \
    PYTHONPATH="${MPE_FAKE}" FAKE_RECORD="${MPE_REC}" \
    "${MPE_EXTRA[@]}" \
    "${MPE_PY}" "${MPE_BIN}" "$@" > "${MPE_OUT}" 2> "${MPE_ERR}" || MPE_RC=$?
  MPE_EXTRA=()
}

# jq on the record; prints the result (empty when there is no record).
function _mpe_rec {
  [[ -f "${MPE_REC}" ]] || return 0
  jq -c "$1" "${MPE_REC}"
}

function _mpe_called { [[ -f "${MPE_REC}" ]]; }

# True when the file's contents contain the literal string.
function _mpe_file_has {
  local content
  content="$(<"$1")"
  [[ "${content}" == *"$2"* ]]
}

# An error case: expected exit code, mcp-proxy never called, stdout empty,
# stderr non-empty and holding neither the URL nor the offending argument ($3).
function _mpe_expect_refusal {
  local desc="$1" code="$2" bad="${3:-}" ok=1
  [[ "${MPE_RC}" == "${code}" ]] || ok=0
  _mpe_called && ok=0
  [[ ! -s "${MPE_OUT}" ]] || ok=0
  [[ -s "${MPE_ERR}" ]] || ok=0
  _mpe_file_has "${MPE_ERR}" "${MPE_URL}" && ok=0
  if [[ -n "${bad}" ]]; then _mpe_file_has "${MPE_ERR}" "${bad}" && ok=0; fi
  if [[ "${ok}" == 1 ]]; then
    _pass "${desc}"
  else
    _fail "${desc} (rc ${MPE_RC}, called=$(_mpe_called && print yes || print no), stderr: $(<"${MPE_ERR}"))"
  fi
  return 0
}

function _mpe_test_cases {
  _section "mcp-proxy-env"

  # 1. The URL comes from the environment and is the last argument; the
  #    passthrough keeps its order; no argv position before the last holds the
  #    URL; the kernel argument line of the running process has no URL and
  #    names the script.
  MPE_EXTRA=(MCP_PROXY_URL="${MPE_URL}")
  _mpe_run --port 8080 --transport=streamablehttp
  if [[ "${MPE_RC}" == 0 && ! -s "${MPE_OUT}" \
        && "$(_mpe_rec '.argv')" == "[\"mcp-proxy\",\"--port\",\"8080\",\"--transport=streamablehttp\",\"${MPE_URL}\"]" \
        && "$(_mpe_rec '.argv[:-1] | map(contains("ha.test")) | any')" == false \
        && "$(_mpe_rec '.ps | contains("ha.test") or contains("cap-")')" == false \
        && "$(_mpe_rec '.ps')" == *"${MPE_BIN}"* ]]; then
    _pass "URL from the environment is last in argv, absent from earlier positions and from the ps line"
  else
    _fail "URL handling wrong (rc ${MPE_RC}, argv: $(_mpe_rec '.argv'), stderr: $(<"${MPE_ERR}"))"
  fi

  # 2. An unset URL variable is a configuration error: exit 78, the proxy
  #    not called.
  MPE_EXTRA=()
  _mpe_run --transport=streamablehttp
  _mpe_expect_refusal "unset URL variable: exit 78, proxy not called" 78

  # 3. A header flag never goes on the command line. The flag is built at run
  #    time so the suite text holds no literal header flag.
  local hflag='-''H'
  MPE_EXTRA=(MCP_PROXY_URL="${MPE_URL}")
  _mpe_run "${hflag}" x-api-key secretvalue
  _mpe_expect_refusal "header flag: exit 64, proxy not called, value not echoed" 64 "secretvalue"

  # 4. A "://" argument is refused: the URL comes from the environment only.
  MPE_EXTRA=(MCP_PROXY_URL="${MPE_URL}")
  _mpe_run --transport=streamablehttp "http://other.test/p"
  _mpe_expect_refusal "URL argument: exit 64, proxy not called, argument not echoed" 64 "other.test"
}

function run_mcp_proxy_env {
  if [[ ! -x "${MPE_PY}" ]]; then
    _skip "mcp-proxy-env: ${MPE_PY} is missing (mcp-proxy not installed)"
    return
  fi
  if [[ ! -r "${MPE_BIN_OVERRIDE:-${SCRIPT_DIR}/bin/mcp-proxy-env}" ]]; then
    _skip "mcp-proxy-env: bin/mcp-proxy-env is missing"
    return
  fi
  if ! command -v jq >/dev/null 2>&1; then
    _skip "mcp-proxy-env: jq not installed"
    return
  fi

  _mpe_setup
  _mpe_test_cases
  _mpe_teardown
}
