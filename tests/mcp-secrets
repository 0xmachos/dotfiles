#!/bin/zsh
# dotfiles/tests/mcp-secrets
#
# Local gate over the live MCP server configs: fails when an entry passes a
# secret through argv (visible to every local process via ps) or holds one at
# rest. The safe shape is an env-assignment prefix on the exec'd program:
#   sh -c 'API_ACCESS_TOKEN="$KEY" exec mcp-proxy <url>'
# A shell expands a field reference into the child's argv; the prefix hands
# the value over through the environment instead.
#
# Targets (each skipped when absent; CI has none of them):
#   ~/.claude.json            mcpServers at the top and in every projects scope
#   ~/.config/muse/settings.json
#   .mcp.json, .codex/config.toml in every directory one level under ~ and
#   every directory one level under ~/Dev (no deeper, no node_modules, no dot
#   directory other than .codex)
#
# Classes, per server entry:
#   ARGV_FLAG        header or key flag as a word in command or args (also
#                    inside a shell string): -H --header --headers --api-key
#                    --apikey --token --bearer --password
#   ARGV_EXPANSION   a shell runs and an arg still holds $NAME or ${NAME}
#                    after leading NAME=value assignments are stripped
#   HEADERS_LITERAL  http/sse/streamable-http headers value without ${...}
#   LITERAL          token-shaped value in args, env or headers: 32+
#                    alphanumerics, sk- ghp_ gho_ ghs_ xoxb- xoxp-
#                    prefixes, or a JWT. Not applied to url.
#   URL_QUERY        ?key= ?token= api_key= access_token= apikey= in url or
#                    args (case-insensitive)
# TOML applies ARGV_FLAG, ARGV_EXPANSION, LITERAL and URL_QUERY line by line
# inside [mcp_servers.*] tables; it is an approximation, the fixtures pin it.
#
# Output discipline: a finding names the file, the scope, the entry and the
# class, never an argument, value or URL. The scanners emit only those fields.
#
# Every check sits on one line ending "# chk:<CLASS>" so a scratch copy can
# delete one and show its fixture go green.
#
# Fixtures (tests/fixtures/mcp-secrets) hold placeholders such as @SK@; this
# suite builds the token-shaped values at run time, so no literal that looks
# like a secret is ever committed.
#
# Run: ./test mcp-secrets
# ShellCheck: lint with `shellcheck --shell=bash tests/mcp-secrets`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib
# shellcheck disable=SC2016,SC2034,SC2066,SC2076,SC2154,SC2190,SC2296

typeset -g MCS_T='' MCS_FX=''
typeset -g MCS_FLAG_RE='' MCS_LIT_RE='' MCS_URL_RE='' MCS_ASSIGN_RE='' MCS_JQ=''
typeset -ga MCS_FINDINGS=() MCS_SCANNED=() MCS_ABSENT=()

function _mcs_init {
  zmodload -F zsh/files b:zf_rm b:zf_mkdir
  MCS_FX="${SCRIPT_DIR}/tests/fixtures/mcp-secrets"
  # Header/key flags as a whole word, in an argument or inside a shell string.
  MCS_FLAG_RE="(^|[[:space:]\"'])(-H|--headers?|--api-?key|--token|--bearer|--password)(\$|[[:space:]\"'=])"
  # Token shapes: 32+ alphanumerics, known vendor prefixes (not inside a
  # longer word), a JWT.
  MCS_LIT_RE="[A-Za-z0-9]{32,}|(^|[^A-Za-z0-9])(sk-|ghp_|gho_|ghs_|xoxb-|xoxp-)[A-Za-z0-9_-]{8,}|eyJ[A-Za-z0-9_-]{10,}"
  # Lower-case input only (the jq side passes the "i" flag).
  MCS_URL_RE="[?&](key|token|api_key|access_token|apikey)=|(^|[^A-Za-z0-9_-])(api_key|access_token|apikey)="
  # One or more leading NAME=value assignments (double-quoted, single-quoted
  # or bare value) followed by blanks.
  MCS_ASSIGN_RE="[A-Za-z_][A-Za-z0-9_]*=(\\\\?\"[^\"]*\\\\?\"|'[^']*'|[^[:space:]\"']*)[[:space:]]+"
  IFS= read -r -d '' MCS_JQ <<'JQ' || true
def argv: ([.command] + (.args // [])) | map(select(type == "string"));
def strip: sub("^([[:space:]]*[A-Za-z_][A-Za-z0-9_]*=(\"[^\"]*\"|'[^']*'|[^[:space:]\"']*)[[:space:]]+)+"; "");
def base: split("/") | last // "";
def shelly: argv | any(. == "-c" or (base | IN("sh", "bash", "zsh")));
def remote: ((.type // "") | IN("http", "sse", "streamable-http", "streamableHttp")) or (has("url") and (has("command") | not));
def strvals: if type == "object" then [.[] | strings] else [] end;
def findings:
  argv as $a
  | shelly as $sh
  | (
      (if ($a | any(test($flagre))) then "ARGV_FLAG" else empty end),  # chk:ARGV_FLAG
      (if ($sh and ($a | any(strip | test("[$][{]?[A-Za-z_]")))) then "ARGV_EXPANSION" else empty end),  # chk:ARGV_EXPANSION
      (if ($a | any(gsub("[$][{](CLAUDE_PROJECT_DIR|CLAUDE_PLUGIN_ROOT|HOME|PWD)[}]"; "") | test("[$][{][A-Za-z_]"))) then "ARGV_EXPANSION" else empty end),  # chk:ARGV_BRACE
      (if (remote and ((.headers | type) == "object") and (.headers | to_entries | any((.value | tostring) | contains("${") | not))) then "HEADERS_LITERAL" else empty end),  # chk:HEADERS_LITERAL
      (if (($a + (.env | strvals) + (.headers | strvals)) | any(test($litre))) then "LITERAL" else empty end),  # chk:LITERAL
      (if ((([.url] | map(strings)) + $a) | any(strip | test($urlre; "i"))) then "URL_QUERY" else empty end),  # chk:URL_QUERY
      empty
    );
. as $root
| [path(.. | select(type == "object" and ((.mcpServers | type) == "object")))] as $ps
| $ps[] as $p
| ($root | getpath($p)) as $scope
| (($p | map(tostring) | join(" > ")) | if . == "" then "top" else . end) as $label
| $scope.mcpServers | to_entries[]
| select(.value | type == "object")
| .key as $name
| (.value | findings) as $class
| [$label, $name, $class] | @tsv
JQ
}

# Scan one JSON config. Prints one "scope<TAB>entry<TAB>CLASS" line per
# finding; an unparseable file prints one PARSE_ERROR line. Nothing else.
function _mcs_scan_json {
  local file="$1" out try
  # One retry: a config rewritten while the scan reads it can parse once.
  for try in 1 2; do
    if out="$(jq -r --arg flagre "${MCS_FLAG_RE}" --arg litre "${MCS_LIT_RE}" \
        --arg urlre "${MCS_URL_RE}" "${MCS_JQ}" "${file}" 2>/dev/null)"; then
      break
    fi
    if (( try == 2 )); then
      printf 'top\t-\tPARSE_ERROR\n'
      return 0
    fi
    /bin/sleep 0.3
  done
  [[ -z "${out}" ]] || print -r -- "${out}"
  return 0
}

# Emit the findings of one TOML [mcp_servers.<name>] table (dynamic scope:
# reads the caller's name, cmdtext, othertext and urltext).
function _mcs_toml_flush {
  [[ -n "${name}" ]] || return 0
  local stripped="${cmdtext}" shre='"(([^"]*/)?(sh|bash|zsh))"|["'"'"']-c["'"'"']'
  local strip_re="([\"'])((${MCS_ASSIGN_RE})+)"
  local -a hit=()
  # Drop NAME=value prefixes that start a quoted string.
  while [[ "${stripped}" =~ ${strip_re} ]]; do
    stripped="${stripped/"${match[2]}"/}"
  done
  if [[ "${cmdtext}" =~ ${MCS_FLAG_RE} ]]; then hit+=(ARGV_FLAG); fi  # chk:ARGV_FLAG
  if [[ "${cmdtext}" =~ ${shre} && "${stripped}" =~ '[$][{]?[A-Za-z_]' ]]; then hit+=(ARGV_EXPANSION); fi  # chk:ARGV_EXPANSION
  if [[ "${cmdtext} ${othertext}" =~ ${MCS_LIT_RE} ]]; then hit+=(LITERAL); fi  # chk:LITERAL
  if [[ "${(L)stripped} ${(L)urltext}" =~ ${MCS_URL_RE} ]]; then hit+=(URL_QUERY); fi  # chk:URL_QUERY
  local c
  for c in "${hit[@]}"; do
    print -r -- "top"$'\t'"${name}"$'\t'"${c}"
  done
  return 0
}

# Scan one .codex/config.toml. Same output as _mcs_scan_json.
function _mcs_scan_toml {
  local file="$1" line trimmed name='' cmdtext='' othertext='' urltext='' in_arr=0
  local hdr_re='^\[mcp_servers\.["]?([^]."]+)'
  local out
  out="$(
    while IFS= read -r line || [[ -n "${line}" ]]; do
      trimmed="${line##[[:space:]]#}"
      [[ "${trimmed}" == '#'* ]] && continue
      if (( in_arr )); then
        cmdtext+=" ${line}"
        [[ "${line}" == *']'* ]] && in_arr=0
        continue
      fi
      if [[ "${trimmed}" == '['* ]]; then
        _mcs_toml_flush
        name='' cmdtext='' othertext='' urltext=''
        if [[ "${trimmed}" =~ ${hdr_re} ]]; then name="${match[1]}"; fi
        continue
      fi
      [[ -n "${name}" ]] || continue
      case "${trimmed}" in
        command[[:space:]=]*) cmdtext+=" ${line}" ;;
        args[[:space:]=]*)
          cmdtext+=" ${line}"
          [[ "${line#*=}" == *']'* ]] || in_arr=1
          ;;
        url[[:space:]=]*) urltext+=" ${line}" ;;
        *) othertext+=" ${line}" ;;
      esac
    done < "${file}"
    _mcs_toml_flush
  )" || { printf 'top\t-\tPARSE_ERROR\n'; return 0; }
  [[ -z "${out}" ]] || print -rl -- "${(u)${(f)out}[@]}"
  return 0
}

# Findings of $1 (json or toml by extension) into MCS_FINDINGS as
# "file<TAB>scope<TAB>entry<TAB>CLASS", sorted and unique per file.
function _mcs_scan_file {
  local file="$1" out line
  if [[ "${file}" == *.toml ]]; then
    out="$(_mcs_scan_toml "${file}")"
  else
    out="$(_mcs_scan_json "${file}")"
  fi
  MCS_SCANNED+=("${file}")
  for line in "${(@o)${(@u)${(@f)out}}}"; do
    [[ -n "${line}" ]] && MCS_FINDINGS+=("${file}"$'\t'"${line}")
  done
  return 0
}

# Scan every live target under home $1 into MCS_SCANNED / MCS_FINDINGS /
# MCS_ABSENT (named single targets that are missing).
function _mcs_scan_home {
  local home="$1" d f
  MCS_FINDINGS=() MCS_SCANNED=() MCS_ABSENT=()
  for f in "${home}/.claude.json" "${home}/.config/muse/settings.json"; do
    if [[ -f "${f}" ]]; then _mcs_scan_file "${f}"; else MCS_ABSENT+=("${f}"); fi
  done
  # Every directory one level under the home and one level under ~/Dev: a
  # repo checkout is never named here (the list would rot and the name would
  # be published).
  local -a dirs=("${home}"/*(/N) "${home}"/Dev/*(/N))
  for d in "${dirs[@]}"; do
    [[ "${d:t}" == node_modules ]] && continue
    [[ -f "${d}/.mcp.json" ]] && _mcs_scan_file "${d}/.mcp.json"
    [[ -f "${d}/.codex/config.toml" ]] && _mcs_scan_file "${d}/.codex/config.toml"
  done
  return 0
}

# Copy fixture $1 into the sandbox $2 with placeholders replaced by values
# built here from parts.
function _mcs_materialize {
  local src="$1" dest="$2" body k
  local tail='Zq7Lm2Xv9Kp4' alnum='' i
  for i in {1..8}; do alnum+='Ab3x'; done
  local -A sub=(
    ALNUM32 "${alnum}"
    SK "sk-${tail}"
    GHP "ghp_${tail}"
    GHO "gho_${tail}"
    GHS "ghs_${tail}"
    XOXB "xoxb-${tail}"
    XOXP "xoxp-${tail}"
    JWT "eyJ${tail}${tail}"
  )
  body="$(<"${src}")"
  for k in "${(@k)sub}"; do
    body="${body//@${k}@/${sub[${k}]}}"
  done
  print -r -- "${body}" > "${dest}"
}

# Expect the scanner output for fixture $2 to equal the entry/class list in
# the remaining args ("name CLASS" each); "none" means no findings.
function _mcs_expect_fixture {
  local label="$1" file="$2"
  shift 2
  local -a want=() got=()
  local line
  [[ "$1" == none ]] || want=("${(@o)@}")
  MCS_FINDINGS=() MCS_SCANNED=()
  _mcs_scan_file "${file}"
  for line in "${MCS_FINDINGS[@]}"; do
    local -a f=("${(@ps:\t:)line}")
    got+=("${f[3]} ${f[4]}")
  done
  got=("${(@o)got}")
  if [[ "${(j:|:)got}" == "${(j:|:)want}" ]]; then
    _pass "fixture ${label}: ${#got} finding(s) as expected"
  else
    _fail "fixture ${label}: expected [${(j:, :)want}] got [${(j:, :)got}]"
  fi
}

function run_mcp_secrets {
  _section "MCP secrets gate (fixtures, then live configs)"

  if ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
    return 0
  fi

  _mcs_init
  MCS_T="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/mcp-secrets-test.XXXXXX")"
  local t="${MCS_T}" f

  for f in clean.json bad-argv-flag.json bad-argv-expansion.json bad-argv-both.json bad-argv-brace.json bad-headers-literal.json \
      bad-literal.json bad-url-query.json clean.toml bad.toml; do
    if [[ ! -f "${MCS_FX}/${f}" ]]; then
      _fail "fixture ${f} is missing"
      continue
    fi
    _mcs_materialize "${MCS_FX}/${f}" "${t}/${f}"
  done

  # --- fixtures: clean must pass, each bad must fail with its class ---
  _mcs_expect_fixture clean.json "${t}/clean.json" none
  _mcs_expect_fixture bad-argv-flag.json "${t}/bad-argv-flag.json" \
    'f-H ARGV_FLAG' 'f-header ARGV_FLAG' 'f-headers ARGV_FLAG' 'f-api-key ARGV_FLAG' \
    'f-apikey ARGV_FLAG' 'f-token ARGV_FLAG' 'f-bearer ARGV_FLAG' 'f-password ARGV_FLAG' \
    'f-in-shell ARGV_FLAG' 'f-project ARGV_FLAG'
  _mcs_expect_fixture bad-argv-expansion.json "${t}/bad-argv-expansion.json" \
    'e-sh ARGV_EXPANSION' 'e-brace ARGV_EXPANSION' 'e-bash ARGV_EXPANSION' \
    'e-wrapped ARGV_EXPANSION' 'e-after-prefix ARGV_EXPANSION' 'e-env-prefix-late ARGV_EXPANSION'
  # The original pattern: a header flag plus a field expansion in one shell
  # string, and a bare URL field expansion.
  _mcs_expect_fixture bad-argv-both.json "${t}/bad-argv-both.json" \
    'b-header-and-expansion ARGV_FLAG' 'b-header-and-expansion ARGV_EXPANSION' \
    'b-url-expansion ARGV_EXPANSION'
  # Claude Code expands ${NAME} in args itself, so no shell is needed.
  _mcs_expect_fixture bad-argv-brace.json "${t}/bad-argv-brace.json" \
    'c-port ARGV_EXPANSION' 'c-stdio-flag-brace ARGV_EXPANSION' 'c-no-type ARGV_EXPANSION' \
    'c-project ARGV_EXPANSION'
  _mcs_expect_fixture bad-headers-literal.json "${t}/bad-headers-literal.json" \
    'h-http HEADERS_LITERAL' 'h-sse HEADERS_LITERAL' 'h-streamable HEADERS_LITERAL' \
    'h-mixed HEADERS_LITERAL'
  _mcs_expect_fixture bad-literal.json "${t}/bad-literal.json" \
    'l-alnum-arg LITERAL' 'l-alnum-env LITERAL' 'l-sk LITERAL' 'l-ghp LITERAL' 'l-gho LITERAL' \
    'l-ghs LITERAL' 'l-xoxb LITERAL' 'l-xoxp LITERAL' 'l-jwt LITERAL' \
    'l-header LITERAL'
  _mcs_expect_fixture bad-url-query.json "${t}/bad-url-query.json" \
    'u-key URL_QUERY' 'u-token URL_QUERY' 'u-apikey URL_QUERY' 'u-api-underscore URL_QUERY' \
    'u-access URL_QUERY' 'u-upper URL_QUERY' 'u-arg URL_QUERY'
  _mcs_expect_fixture clean.toml "${t}/clean.toml" none
  _mcs_expect_fixture bad.toml "${t}/bad.toml" \
    't-flag ARGV_FLAG' 't-expand ARGV_EXPANSION' 't-multiline ARGV_EXPANSION' \
    't-literal LITERAL' 't-literal-env LITERAL' 't-url URL_QUERY'

  # Not JSON: reported as PARSE_ERROR, never a pass.
  print -r -- '{ not json' > "${t}/broken.json"
  _mcs_expect_fixture 'unparseable json' "${t}/broken.json" '- PARSE_ERROR'

  # --- output discipline: no finding line carries a value, flag or URL ---
  local -a all=()
  for f in bad-argv-flag.json bad-argv-expansion.json bad-headers-literal.json bad-literal.json \
      bad-url-query.json bad.toml; do
    MCS_FINDINGS=() MCS_SCANNED=()
    _mcs_scan_file "${t}/${f}"
    all+=("${MCS_FINDINGS[@]}")
  done
  local blob="${(F)all}" leaked=0 needle
  for needle in 'Ab3xAb3x' 'Zq7Lm2Xv9Kp4' 'x-api-key' 'https://' 'short' 'EXA_API_KEY' 'plainvalue'; do
    if [[ "${blob}" == *"${needle}"* ]]; then
      leaked=1
      _fail "output discipline: a finding line carries fixture content (needle ${needle})"
    fi
  done
  (( leaked )) || _pass "output discipline: finding lines hold file, scope, entry and class only"

  # --- target walk, against a sandbox home ---
  local h="${t}/home"
  zf_mkdir -p "${h}/.config/muse" "${h}/dotfiles/.codex" "${h}/second-repo" \
    "${h}/Dev/proj" "${h}/Dev/node_modules" "${h}/Dev/.hidden" "${h}/Dev/deep/inner" \
    "${h}/Dev/tomlrepo/.codex" "${h}/Dev/cleanrepo"
  cp "${t}/bad-argv-flag.json" "${h}/.claude.json"
  cp "${t}/bad-literal.json" "${h}/.config/muse/settings.json"
  cp "${t}/bad.toml" "${h}/dotfiles/.codex/config.toml"
  cp "${t}/bad-url-query.json" "${h}/Dev/proj/.mcp.json"
  cp "${t}/bad-url-query.json" "${h}/Dev/node_modules/.mcp.json"
  cp "${t}/bad-url-query.json" "${h}/Dev/.hidden/.mcp.json"
  cp "${t}/bad-url-query.json" "${h}/Dev/deep/inner/.mcp.json"
  cp "${t}/bad.toml" "${h}/Dev/tomlrepo/.codex/config.toml"
  cp "${t}/clean.json" "${h}/Dev/cleanrepo/.mcp.json"
  _mcs_scan_home "${h}"
  local blob2="${(F)MCS_FINDINGS}" want_file ok
  for want_file in "${h}/.claude.json" "${h}/.config/muse/settings.json" \
      "${h}/dotfiles/.codex/config.toml" "${h}/Dev/proj/.mcp.json" \
      "${h}/Dev/tomlrepo/.codex/config.toml"; do
    if [[ "${blob2}" == *"${want_file}"$'\t'* ]]; then
      _pass "walk: finding reported for ${want_file#"${h}"/}"
    else
      _fail "walk: no finding for ${want_file#"${h}"/}"
    fi
  done
  ok=1
  for want_file in "${h}/Dev/node_modules" "${h}/Dev/.hidden" "${h}/Dev/deep" "${h}/Dev/cleanrepo"; do
    [[ "${blob2}" == *"${want_file}"* ]] && ok=0
  done
  if (( ok )); then
    _pass "walk: node_modules, dot dirs, deeper dirs and a clean repo give no finding"
  else
    _fail "walk: a skipped or clean directory produced a finding"
  fi
  if (( ${#MCS_SCANNED[@]} == 6 )); then
    _pass "walk: scanned exactly the 6 present targets"
  else
    _fail "walk: scanned ${#MCS_SCANNED[@]} targets, expected 6"
  fi

  # An absent home gives no finding and records the named targets as absent.
  _mcs_scan_home "${t}/nohome"
  if (( ${#MCS_FINDINGS[@]} == 0 && ${#MCS_SCANNED[@]} == 0 && ${#MCS_ABSENT[@]} == 2 )); then
    _pass "walk: an empty home scans nothing and reports two absent named targets"
  else
    _fail "walk: empty home gave ${#MCS_FINDINGS[@]} findings, ${#MCS_SCANNED[@]} scanned, ${#MCS_ABSENT[@]} absent"
  fi

  # The reporter, run against the sandbox home in a subshell (its counters
  # are discarded): findings print as FAIL lines naming file, scope, entry and
  # class, with no value, flag or URL in them.
  local rep
  rep="$(_mcs_report "${h}")"
  if [[ "${rep}" == *FAIL*"~/.claude.json"*"f-token: ARGV_FLAG"* ]] \
      && [[ "${rep}" == *"projects > /work/p"*"f-project: ARGV_FLAG"* ]] \
      && [[ "${rep}" != *"x-api-key"* && "${rep}" != *"Zq7Lm2Xv9Kp4"* && "${rep}" != *"https://"* ]]; then
    _pass "report: a finding prints as FAIL with file, scope, entry and class only"
  else
    _fail "report: a finding did not print as expected"
  fi

  zf_rm -rf -- "${t}"

  # --- live configs ---
  _mcs_report "${HOME}"
}

# Scan home $1 and report each target: SKIP for an absent named target, FAIL
# per finding, PASS per clean file.
function _mcs_report {
  local home="$1" f line
  local -a parts
  _mcs_scan_home "${home}"
  for f in "${MCS_ABSENT[@]}"; do
    _skip "live: ${f/#${home}/~} absent"
  done
  if (( ${#MCS_SCANNED[@]} == 0 )); then
    _skip "live: no MCP config on this machine"
    return 0
  fi
  for line in "${MCS_FINDINGS[@]}"; do
    parts=("${(@ps:\t:)line}")
    _fail "live: ${parts[1]/#${home}/~} [${parts[2]}] entry ${parts[3]}: ${parts[4]}"
  done
  for f in "${MCS_SCANNED[@]}"; do
    if [[ "${(F)MCS_FINDINGS}" == *"${f}"$'\t'* ]]; then continue; fi
    _pass "live: ${f/#${home}/~} clean"
  done
  return 0
}
