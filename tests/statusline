#!/bin/zsh
# dotfiles/tests/statusline
#
# Feeds stdin JSON to claude/statusline-command and claude/subagent-statusline;
# asserts rendered text, ANSI colours and the exit code. Claude Code discards
# the whole status line on non-zero exit (2026-09-24: a trailing
# `[ -n "$x" ] && printf` with x empty).
#
# Hermetic: HOME is a $TMPDIR sandbox with a fresh FX cache of 1 (curl never
# fires, £ equals USD) and a settings.json with autoCompactWindow.
# STATUSLINE_NOW pins the clock; STATUSLINE_OSASCRIPT swaps the notification
# for a stub logging its argv. current_dir is a non-repo dir, so the git
# segment (cached in /tmp) stays out.
#
# Thresholds mirror claude/statusline-command; change both together.
#
# Run: ./test statusline
# ShellCheck: shellcheck --shell=bash tests/statusline
# Sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

# tests/lib owns RED/GREEN/YELLOW/BOLD/RESET, with the same escapes the scripts
# emit; these are the ones it lacks.
readonly _SL_DIM=$'\e[2m'
readonly _SL_CYAN=$'\e[36m'
readonly _SL_MAGENTA=$'\e[35m'

typeset -g _SL_SB="" _SL_NOW="" _SL_OUT="" _SL_RC=0

# _sl_json <jq filter> — the base payload with the filter applied
function _sl_json {
  jq -cn --arg cwd "${_SL_SB}/work" --argjson now "${_SL_NOW}" "
    {workspace: {current_dir: \$cwd},
     model: {id: \"claude-opus-5-5[1m]\", display_name: \"Opus 5.5 (1M context)\"},
     cost: {total_cost_usd: 0, total_duration_ms: 0},
     context_window: {current_usage: {input_tokens: 0,
       cache_creation_input_tokens: 0, cache_read_input_tokens: 0}}}
    | $1"
}

# _sl_run <cols> <payload> [NAME=value ...] — sets _SL_OUT and _SL_RC.
# `|| _SL_RC=$?` keeps a non-zero exit from tripping set -e; every run then
# fails loudly on it (an exit-1 run can still print the text an assertion
# wants, or an empty line a "hidden" assertion accepts).
# GIT_CEILING_DIRECTORIES stops git discovery at the sandbox, so a TMPDIR
# inside a checkout cannot pull in a real repo (or write its /tmp cache).
# _run_no_tty (tests/lib, setsid) matches production: no controlling terminal
# (ps shows TTY ??, 2026-09-29). With one, zsh rewrites COLUMNS from the tty
# size even with all stdio redirected (56/142 failed from a real terminal;
# repro: script -q /dev/null zsh -c 'stty cols 80; ./test statusline' —
# script's own pty is 0x0, which zsh ignores).
function _sl_run {
  local cols="$1" payload="$2"
  shift 2
  _SL_RC=0
  _SL_OUT="$(printf '%s' "${payload}" | _run_no_tty env -u CLAUDE_CODE_AUTO_COMPACT_WINDOW \
    -u GIT_DIR -u GIT_WORK_TREE GIT_CEILING_DIRECTORIES="${_SL_SB}" \
    HOME="${_SL_SB}" COLUMNS="${cols}" STATUSLINE_NOW="${_SL_NOW}" \
    STATUSLINE_OSASCRIPT="${_SL_SB}/osascript-stub" "$@" \
    /bin/zsh "${SCRIPT_DIR}/claude/statusline-command" 2>"${_SL_SB}/stderr")" || _SL_RC=$?
  if (( _SL_RC != 0 )); then
    _fail "statusline-command exited ${_SL_RC} at ${cols} cols on $(printf '%q' "${payload}"): $(head -3 "${_SL_SB}/stderr")"
  fi
}

function _sl_plain {
  printf '%s' "$1" | sed $'s/\e\\[[0-9;]*m//g'
}

# _sl_line <n> — line n of the last output
function _sl_line {
  sed -n "${1}p" <<< "${_SL_OUT}"
}

function _sl_expect_has {
  local label="$1" haystack="$2" needle="$3"
  if [[ "${haystack}" == *"${needle}"* ]]; then
    _pass "${label}"
  else
    _fail "${label} — wanted $(printf '%q' "${needle}") in $(printf '%q' "${haystack}")"
  fi
}

# _sl_expect_hidden <label> — the usage row is gone AND the rest survived:
# the whole output is exactly the calm two rows, so a blank bar can't pass
function _sl_expect_hidden {
  _sl_expect_eq "$1" "$(_sl_plain "${_SL_OUT}")" $'work Opus\n░░░░░░░░░░ 0K'
}

function _sl_expect_eq {
  local label="$1" got="$2" want="$3"
  if [[ "${got}" == "${want}" ]]; then
    _pass "${label}"
  else
    _fail "${label} — got $(printf '%q' "${got}"), want $(printf '%q' "${want}")"
  fi
}

function _sl_setup {
  _SL_SB="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/statusline-test.XXXXXX")"
  _SL_NOW="$(date +%s)"
  mkdir -p "${_SL_SB}/Library/Caches/statusline" "${_SL_SB}/.claude" "${_SL_SB}/work"
  printf '1' > "${_SL_SB}/Library/Caches/statusline/usd-gbp"
  printf '{"autoCompactWindow":500000}' > "${_SL_SB}/.claude/settings.json"
  # shellcheck disable=SC2016  # $@ belongs to the stub, not this shell
  printf '#!/bin/zsh\nprint -r -- "$@" >> %q\n' "${_SL_SB}/osascript.log" \
    > "${_SL_SB}/osascript-stub"
  chmod 755 "${_SL_SB}/osascript-stub"
}

# ── (1) exit 0 everywhere ──────────────────────────────────────────────────
function _sl_exit_codes {
  local cols name payload
  local -A payloads=(
    [calm]="$(_sl_json '.')"
    [busy]="$(_sl_json "
      .rate_limits = {five_hour: {used_percentage: 85, resets_at: (\$now + 7260)},
                      seven_day: {used_percentage: 80, resets_at: (\$now + 259260)}}
      | .cost = {total_cost_usd: 25, total_duration_ms: 7200000, total_api_duration_ms: 3000000}
      | .context_window.current_usage.cache_read_input_tokens = 450000
      | .effort = {level: \"high\"} | .thinking = {enabled: false}
      | .prompt_cache = {warm: true, caching_observed: true, expires_at: (\$now + 1800),
                         hit_ratio: 0.96, recache_tokens_if_cold: 1000}")"
    [no-rate-limits]="$(_sl_json '.prompt_cache = {warm: false, caching_observed: true}')"
    [no-prompt-cache]="$(_sl_json '.rate_limits.five_hour = {used_percentage: 60}')"
    [expired]="$(_sl_json '.prompt_cache = {warm: false, caching_observed: true,
      recache_tokens_if_cold: 142000}')"
    [empty-input]=""
  )
  for name in calm busy no-rate-limits no-prompt-cache expired empty-input; do
    payload="${payloads[${name}]}"
    for cols in 140 80 50 30; do
      _sl_run "${cols}" "${payload}"
      if (( _SL_RC == 0 )) && [[ -n "${_SL_OUT}" ]]; then
        _pass "exit 0 with output: ${name} at ${cols} cols"
      else
        _fail "${name} at ${cols} cols — rc ${_SL_RC}, output $(printf '%q' "${_SL_OUT}")"
      fi
    done
  done

  # Tier edges, each side. Plain shapes: full 10-cell bar; medium 5-cell;
  # compact one labelled line; tiny tokens only
  _sl_tier_case 100 $'work Opus\n░░░░░░░░░░ 0K'
  _sl_tier_case 99 $'work Opus\n░░░░░ 0K'
  _sl_tier_case 70 $'work Opus\n░░░░░ 0K'
  _sl_tier_case 69 'work · Opus · 0K'
  _sl_tier_case 45 'work · Opus · 0K'
  _sl_tier_case 44 '0K'
}

function _sl_tier_case {
  # <cols> <expected plain output>
  _sl_run "$1" "$(_sl_json '.')"
  _sl_expect_eq "tier edge at $1 cols" "$(_sl_plain "${_SL_OUT}")" "$2"
}

# ── (2) context colour bands and bar fill ──────────────────────────────────
# One case per call, not a multi-variable for loop: shellcheck's bash parser
# rejects zsh's `for a b in` outright, and a parse error cannot be disabled.
function _sl_ctx_case {
  # <tokens> <colour> <label> — tokens split over all three current_usage
  # fields, so the sum is tested
  _sl_run 30 "$(_sl_json ".context_window.current_usage = {input_tokens: 1000,
    cache_creation_input_tokens: 2000, cache_read_input_tokens: ($1 - 3000)}")"
  # The whole tiny-tier output, so a dropped reset fails too
  _sl_expect_eq "context $1 tokens → $3 in its band" "${_SL_OUT}" "$2$3${RESET}"
}

function _sl_context {
  _sl_ctx_case 199999 "${GREEN}" 199K
  _sl_ctx_case 200000 "${YELLOW}" 200K
  _sl_ctx_case 399999 "${YELLOW}" 399K
  _sl_ctx_case 400000 "${RED}" 400K
  # Millions truncate to hundredths before rounding to tenths: 1,150,001 is
  # 1.1M, 1,260,000 is 1.3M, 1,050,000 is 1.1M
  _sl_ctx_case 1000000 "${RED}" 1.0M
  _sl_ctx_case 1049999 "${RED}" 1.0M
  _sl_ctx_case 1050000 "${RED}" 1.1M
  _sl_ctx_case 1150001 "${RED}" 1.1M
  _sl_ctx_case 1260000 "${RED}" 1.3M
  _sl_ctx_case 9999999 "${RED}" 10.0M

  local p250k
  p250k="$(_sl_json '.context_window.current_usage.cache_read_input_tokens = 250000')"
  _sl_run 140 "${p250k}"
  _sl_expect_has "bar max from settings (500K): 250K half full" "$(_sl_line 2)" "█████░░░░░"
  printf '{"autoCompactWindow":1000000}' > "${_SL_SB}/.claude/settings.json"
  _sl_run 140 "${p250k}"
  _sl_expect_has "bar max from settings (1M): 250K a quarter full" "$(_sl_line 2)" "██░░░░░░░░"
  _sl_run 140 "${p250k}" CLAUDE_CODE_AUTO_COMPACT_WINDOW=250000
  _sl_expect_has "bar max from env beats settings" "$(_sl_line 2)" "██████████"
  _sl_run 140 "${p250k}" CLAUDE_CODE_AUTO_COMPACT_WINDOW=junk
  _sl_expect_has "junk env → 500K fallback" "$(_sl_line 2)" "█████░░░░░"
  printf '{"autoCompactWindow":"junk"}' > "${_SL_SB}/.claude/settings.json"
  _sl_run 140 "${p250k}"
  _sl_expect_has "junk settings → 500K fallback" "$(_sl_line 2)" "█████░░░░░"
  printf '{"autoCompactWindow":50000}' > "${_SL_SB}/.claude/settings.json"
  _sl_run 140 "${p250k}"
  _sl_expect_has "below-range settings → 500K fallback" "$(_sl_line 2)" "█████░░░░░"
  printf '{"autoCompactWindow":2000000}' > "${_SL_SB}/.claude/settings.json"
  _sl_run 140 "${p250k}"
  _sl_expect_has "above-range settings → 500K fallback" "$(_sl_line 2)" "█████░░░░░"
  # Range edges 100K and 1M are inclusive. 50K tokens so the 100K edge doesn't
  # saturate: 99,999 falls back to 500K (one cell), 100,000 is honoured (five)
  local p50k
  p50k="$(_sl_json '.context_window.current_usage.input_tokens = 50000')"
  _sl_barmax_case "${p50k}" 99999 "█░░░░░░░░░"
  _sl_barmax_case "${p50k}" 100000 "█████░░░░░"
  _sl_barmax_case "${p250k}" 1000000 "██░░░░░░░░"
  _sl_barmax_case "${p250k}" 1000001 "█████░░░░░"
  printf '{"autoCompactWindow":500000}' > "${_SL_SB}/.claude/settings.json"
  _sl_run 140 "$(_sl_json '.context_window.current_usage.input_tokens = 750000')"
  _sl_expect_eq "bar clamps at 10 cells past the max" \
    "$(_sl_plain "$(_sl_line 2)")" "██████████ 750K"
}

function _sl_barmax_case {
  # <payload> <autoCompactWindow> <expected bar>
  printf '{"autoCompactWindow":%s}' "$2" > "${_SL_SB}/.claude/settings.json"
  _sl_run 140 "$1"
  _sl_expect_has "bar max edge $2" "$(_sl_line 2)" "$3"
}

# ── (3) usage visibility and pace ──────────────────────────────────────────
# shellcheck disable=SC2016  # $now in these filters is a jq variable
function _sl_usage {
  local plain
  # Average-rate cases: an empty ledger, so no recent rate stands in
  _sl_usage_reset
  # No resets_at: pace cannot compute, so visibility is threshold-only
  _sl_run 140 "$(_sl_json '.rate_limits.five_hour = {used_percentage: 49}')"
  _sl_expect_hidden "5h 49% hidden"
  _sl_run 140 "$(_sl_json '.rate_limits.five_hour = {used_percentage: 50}')"
  _sl_expect_has "5h 50% shown yellow" "$(_sl_line 3)" "${YELLOW}${BOLD}50%"
  _sl_run 140 "$(_sl_json '.rate_limits.seven_day = {used_percentage: 74}')"
  _sl_expect_hidden "7d 74% hidden"

  # 7d 75% with 1d left: elapsed ~86% is ahead of usage, so no pace
  _sl_run 140 "$(_sl_json '.rate_limits.seven_day = {used_percentage: 75, resets_at: ($now + 86460)}')"
  _sl_expect_has "7d 75% shown red" "$(_sl_line 3)" "${RED}${BOLD}75%"
  _sl_expect_eq "7d 75% carries its countdown, no pace" "$(_sl_plain "$(_sl_line 3)")" "7d 75% · 1d"

  # 5h turns red at 80, not 79; 75% elapsed (1h 15m left), so both run out.
  # Out-in = (100 - used) x elapsed / used; the cut rounds up to the next 10%.
  _sl_run 140 "$(_sl_json '.rate_limits.five_hour = {used_percentage: 79, resets_at: ($now + 4500)}')"
  _sl_expect_has "5h 79% yellow" "$(_sl_line 3)" "${YELLOW}${BOLD}79%"
  _sl_expect_eq "5h 79%: out in, resets in, fewer tokens" "$(_sl_plain "$(_sl_line 3)")" \
    "5h 79% · out in 59m · resets in 1h 15m · use 30% fewer tokens"
  _sl_run 140 "$(_sl_json '.rate_limits.five_hour = {used_percentage: 80, resets_at: ($now + 4500)}')"
  _sl_expect_has "5h 80% red" "$(_sl_line 3)" "${RED}${BOLD}80%"
  _sl_expect_eq "5h 80%: out in, resets in, fewer tokens" "$(_sl_plain "$(_sl_line 3)")" \
    "5h 80% · out in 56m · resets in 1h 15m · use 30% fewer tokens"
  _sl_run 80 "$(_sl_json '.rate_limits.five_hour = {used_percentage: 80, resets_at: ($now + 4500)}')"
  _sl_expect_has "medium tier: 5h detail in brackets" "$(_sl_plain "$(_sl_line 2)")" \
    "5h 80% (out in 56m, resets in 1h 15m, use 30% fewer tokens)"

  # Run-out rule: usage share must exceed elapsed share (5h = 18000s)
  _sl_run 140 "$(_sl_json '.rate_limits.five_hour = {used_percentage: 60, resets_at: ($now + 7201)}')"
  _sl_expect_eq "5h 60% at 59.99% elapsed: shown" "$(_sl_plain "$(_sl_line 3)")" \
    "5h 60% · out in 1h 59m · resets in 2h 0m · use 10% fewer tokens"
  _sl_run 140 "$(_sl_json '.rate_limits.five_hour = {used_percentage: 60, resets_at: ($now + 7200)}')"
  _sl_expect_hidden "5h 60% at exactly 60% elapsed: lasts to the reset, hidden"
  _sl_run 140 "$(_sl_json '.rate_limits.five_hour = {used_percentage: 90, resets_at: ($now + 600)}')"
  _sl_expect_hidden "5h 90% with 10m left: hidden, it lasts"
  # Below 50% stays hidden even when pace warns (30% used, 10% elapsed)
  _sl_run 140 "$(_sl_json '.rate_limits.five_hour = {used_percentage: 30, resets_at: ($now + 16200)}')"
  _sl_expect_hidden "5h under 50% hidden despite pace"
  # 50% used in the first 30 minutes: no grace period, it shows
  _sl_run 140 "$(_sl_json '.rate_limits.five_hour = {used_percentage: 50, resets_at: ($now + 16200)}')"
  _sl_expect_eq "5h 50% early" "$(_sl_plain "$(_sl_line 3)")" \
    "5h 50% · out in 30m · resets in 4h 30m · use 90% fewer tokens"
  # A cut already on a multiple of 10 stays put: 50% used, 8000s elapsed, 10000s
  # left → exactly 20%
  _sl_run 140 "$(_sl_json '.rate_limits.five_hour = {used_percentage: 50, resets_at: ($now + 10000)}')"
  _sl_expect_eq "5h cut of exactly 20% stays 20" "$(_sl_plain "$(_sl_line 3)")" \
    "5h 50% · out in 2h 13m · resets in 2h 46m · use 20% fewer tokens"

  # 7d pace boundary at exactly 25% elapsed: 10 ahead shows yellow, 9 hides
  _sl_run 140 "$(_sl_json '.rate_limits.seven_day = {used_percentage: 35, resets_at: ($now + 453600)}')"
  plain="$(_sl_plain "$(_sl_line 3)")"
  _sl_expect_eq "7d 10 points ahead shows ⇡10" "${plain}" "7d 35% ⇡10"
  _sl_expect_has "7d pace 10 ahead is yellow" "$(_sl_line 3)" "${YELLOW}⇡10${RESET}"
  _sl_run 140 "$(_sl_json '.rate_limits.seven_day = {used_percentage: 34, resets_at: ($now + 453600)}')"
  _sl_expect_hidden "7d 9 points ahead stays hidden"
}

# 5h recent rate: a least-squares fit through the ledger samples in the last
# 30 minutes (and in this window) plus the live value, once the oldest is at
# least 10 minutes old, replaces the window average
# shellcheck disable=SC2016  # $now in these filters is a jq variable
function _sl_recent_rate {
  local u="${_SL_SB}/Library/Caches/statusline/usage"
  _sl_usage_reset
  mkdir -p "${u}"
  # Late burst: 55% at 60% elapsed hides on the average, but 35 → 55 in the
  # last 20 minutes is 1%/min: 45 points left last 45m, cut 62.5% → 70
  printf '%s 35\n' $(( _SL_NOW - 1200 )) > "${u}/five"
  _sl_run 140 "$(_sl_json '.rate_limits.five_hour = {used_percentage: 55, resets_at: ($now + 7200)}')"
  _sl_expect_eq "recent rate: late burst shows" "$(_sl_plain "$(_sl_line 3)")" \
    "5h 55% · out in 45m · resets in 2h 0m · use 70% fewer tokens"
  # Fit, not end points: 30, 45, 50, 55 then 60 live, 5 minutes apart, is
  # 1.4%/min (the ends alone say 1.5%/min, out in 26m): 40 points last 28m
  printf '%s 30\n%s 45\n%s 50\n%s 55\n' $(( _SL_NOW - 1200 )) $(( _SL_NOW - 900 )) \
    $(( _SL_NOW - 600 )) $(( _SL_NOW - 300 )) > "${u}/five"
  _sl_run 140 "$(_sl_json '.rate_limits.five_hour = {used_percentage: 60, resets_at: ($now + 7200)}')"
  _sl_expect_eq "recent rate: fitted through every sample" "$(_sl_plain "$(_sl_line 3)")" \
    "5h 60% · out in 28m · resets in 2h 0m · use 80% fewer tokens"
  # Eased off: the average runs out (80% at 40% elapsed) but nothing was used
  # in the last 20 minutes
  printf '%s 80\n' $(( _SL_NOW - 1200 )) > "${u}/five"
  _sl_run 140 "$(_sl_json '.rate_limits.five_hour = {used_percentage: 80, resets_at: ($now + 10800)}')"
  _sl_expect_hidden "recent rate: eased off hides"
  # Under 10 minutes of history: the average decides (55% at 60% elapsed)
  printf '%s 40\n' $(( _SL_NOW - 300 )) > "${u}/five"
  _sl_run 140 "$(_sl_json '.rate_limits.five_hour = {used_percentage: 55, resets_at: ($now + 7200)}')"
  _sl_expect_hidden "recent rate: under 10 minutes falls back to the average"
  # A sample from before this window began (95% last window) is ignored, so
  # the average decides: 60% in the first 1000s
  printf '%s 95\n' $(( _SL_NOW - 1500 )) > "${u}/five"
  _sl_run 140 "$(_sl_json '.rate_limits.five_hour = {used_percentage: 60, resets_at: ($now + 17000)}')"
  _sl_expect_eq "recent rate: last window's samples ignored" "$(_sl_plain "$(_sl_line 3)")" \
    "5h 60% · out in 11m · resets in 4h 43m · use 100% fewer tokens"
  _sl_usage_reset
}

# ── (4) countdown units ────────────────────────────────────────────────────
function _sl_countdown_case {
  # <window key> <label> <used> <seconds to reset> <expected> — the countdown
  # must END the row, so a "2h 1m" can't satisfy "2h"
  local row
  _sl_run 140 "$(_sl_json ".rate_limits.$1 = {used_percentage: $3, resets_at: (\$now + $4)}")"
  row="$(_sl_plain "$(_sl_line 3)")"
  if [[ "${row}" == *" · $5" ]]; then
    _pass "$2 countdown $4s → $5"
  else
    _fail "$2 countdown $4s — wanted row ending ' · $5', got $(printf '%q' "${row}")"
  fi
}

# shellcheck disable=SC2016  # $now in these filters is a jq variable
function _sl_countdowns {
  _sl_usage_reset
  # 5h at 100%: already out, so only the reset remains; once the reset has
  # passed there is no forecast, so the row is the bare percentage
  _sl_run 140 "$(_sl_json '.rate_limits.five_hour = {used_percentage: 100, resets_at: ($now + 7260)}')"
  _sl_expect_eq "5h 100%: out, resets in" "$(_sl_plain "$(_sl_line 3)")" "5h 100% · out · resets in 2h 1m"
  _sl_run 140 "$(_sl_json '.rate_limits.five_hour = {used_percentage: 100, resets_at: ($now + 0)}')"
  _sl_expect_eq "5h reset passed: bare percentage" "$(_sl_plain "$(_sl_line 3)")" "5h 100%"
  _sl_countdown_case seven_day 7d 80 259260 3d
  _sl_countdown_case seven_day 7d 80 86400 1d
  _sl_countdown_case seven_day 7d 80 86399 23h
  _sl_countdown_case seven_day 7d 80 46860 13h
  _sl_countdown_case seven_day 7d 80 2970 49m
}

# ── (5, 6) effort badge and model name ─────────────────────────────────────
function _sl_identity {
  local opus='.model = {id: "claude-opus-5-5[1m]", display_name: "Opus 5.5 (1M context)"}'
  local fable='.model = {id: "claude-fable-5-1[1m]", display_name: "Fable 5.1 (1M context)"}'

  _sl_run 140 "$(_sl_json "${opus} | .effort.level = \"medium\"")"
  _sl_expect_has "Opus 5.5 medium is its default: dim" "$(_sl_line 1)" "${_SL_DIM}◆ med${RESET}"
  _sl_run 140 "$(_sl_json "${opus} | .effort.level = \"high\"")"
  _sl_expect_has "Opus 5.5 high: coloured, ↑" "$(_sl_line 1)" "${_SL_MAGENTA}▲ high ↑${RESET}"
  _sl_run 140 "$(_sl_json "${opus} | .effort.level = \"low\"")"
  _sl_expect_has "Opus 5.5 low: coloured, ↓" "$(_sl_line 1)" "${_SL_CYAN}▽ low ↓${RESET}"
  _sl_run 140 "$(_sl_json "${fable} | .effort.level = \"high\"")"
  _sl_expect_has "Fable high is its default: dim" "$(_sl_line 1)" "${_SL_DIM}▲ high${RESET}"
  _sl_run 140 "$(_sl_json "${fable} | .effort.level = \"medium\"")"
  _sl_expect_has "Fable medium: coloured, ↓" "$(_sl_line 1)" "${YELLOW}◆ med ↓${RESET}"
  _sl_run 140 "$(_sl_json "${fable} | .effort.level = \"xhigh\"")"
  _sl_expect_has "Fable xhigh: coloured, ↑" "$(_sl_line 1)" "${_SL_MAGENTA}▲▲ xhigh ↑${RESET}"
  _sl_run 140 "$(_sl_json "${fable} | .effort.level = \"max\"")"
  _sl_expect_has "Fable max: red, ↑" "$(_sl_line 1)" "${RED}▲▲▲ max ↑${RESET}"

  _sl_run 140 "$(_sl_json "${opus}")"
  _sl_expect_eq "no effort field → no badge; model → Opus" "$(_sl_plain "$(_sl_line 1)")" "work Opus"
  _sl_run 140 "$(_sl_json "${fable}")"
  _sl_expect_eq "Fable 5.1 (1M context) → Fable" "$(_sl_plain "$(_sl_line 1)")" "work Fable"
}

# Directory name is the last path component: basename semantics, including a
# trailing slash, and "/" for a path of slashes only
function _sl_cwd_case {
  # <current_dir> <expected row 1>
  _sl_run 140 "$(jq -cn --arg cwd "$1" '{workspace: {current_dir: $cwd}, model: {id: "claude-opus-5-5[1m]", display_name: "Opus 5.5 (1M context)"}}')"
  _sl_expect_eq "directory name of $(printf '%q' "$1")" "$(_sl_plain "$(_sl_line 1)")" "$2"
}

