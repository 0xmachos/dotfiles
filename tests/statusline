function _sl_expired {
  local u="${_SL_SB}/Library/Caches/statusline/usage"
  _sl_usage_reset

  # 142K × $4/MTok (Opus 5.5) × 2 (1h write) = $1.136; FX is 1 in the sandbox
  _sl_run 140 "$(_sl_json "${_SL_EXPIRED}")"
  _sl_expect_eq "expired: whole line replaced (1h TTL)" "$(_sl_plain "${_SL_OUT}")" \
    $'Cache Expired!\n142K tokens to Opus Med is £1.14'
  _sl_expect_has "expired: row 1 bold red" "$(_sl_line 1)" "${BOLD}${RED}Cache Expired!${RESET}"
  _sl_run 140 "$(_sl_json "${_SL_EXPIRED} | .prompt_cache.ttl = \"5m\"")"
  _sl_expect_eq "expired: 5m TTL writes at 1.25×" "$(_sl_plain "$(_sl_line 2)")" \
    "142K tokens to Opus Med is £0.71"
  # Token label: t / 1e6 rounds straight to a tenth (1,150,001 is 1.2M here, 1.1M
  # in the context bar); half-even on exact halves (1.25M is 1.2M)
  _sl_expired_case 1150000 1 "1.1M tokens to Opus Med is £9.20"
  _sl_expired_case 1150001 1 "1.2M tokens to Opus Med is £9.20"
  _sl_expired_case 1250000 1 "1.2M tokens to Opus Med is £10.00"
  _sl_expired_case 1260000 1 "1.3M tokens to Opus Med is £10.08"
  _sl_expired_case 1000000 1 "1.0M tokens to Opus Med is £8.00"
  _sl_expired_case 999999 1 "999K tokens to Opus Med is £8.00"
  # Fractional FX: 10.00 × 0.8145 = 8.145 rounds down (binary), 9.20 × 0.8145 = 7.49
  _sl_expired_case 1250000 0.8145 "1.2M tokens to Opus Med is £8.14"
  _sl_expired_case 1150000 0.8145 "1.1M tokens to Opus Med is £7.49"
  printf "1" > "${_SL_SB}/Library/Caches/statusline/usd-gbp"
  _sl_run 140 "$(_sl_json "${_SL_EXPIRED} | .model = {id: \"claude-fable-5-1\", display_name: \"Fable 5.1\"}
    | .effort.level = \"xhigh\"")"
  _sl_expect_eq "expired: Fable price and effort label" "$(_sl_plain "$(_sl_line 2)")" \
    "142K tokens to Fable XHigh is £2.84"
  _sl_run 140 "$(_sl_json "${_SL_EXPIRED} | .model = {id: \"claude-new-9\", display_name: \"New\"}")"
  _sl_expect_eq "expired: unknown model → tokens only" "$(_sl_plain "$(_sl_line 2)")" \
    "142K tokens to New Med"
  _sl_run 80 "$(_sl_json "${_SL_EXPIRED}")"
  _sl_expect_eq "expired: medium tier takes over too" "$(_sl_plain "$(_sl_line 1)")" "Cache Expired!"
  _sl_run 50 "$(_sl_json "${_SL_EXPIRED}")"
  _sl_expect_eq "expired: compact tier unchanged" "$(_sl_plain "${_SL_OUT}")" "work · Opus · 0K"
  _sl_run 140 "$(_sl_json "${_SL_EXPIRED} | .prompt_cache.warm = true
    | .prompt_cache.expires_at = (\$now + 600)")"
  _sl_expect_has "warm cache: normal rows" "$(_sl_plain "$(_sl_line 1)")" "work Opus"

  # Seeded ledger: 5h went 20 → 10 (a reset) → 30, with $1 spent after the
  # reset: 20 points per dollar, so $1.136 → ~23%
  mkdir -p "${u}"
  printf '%s 20\n%s 10\n' $(( _SL_NOW - 7000 )) $(( _SL_NOW - 3000 )) > "${u}/five"
  printf '%s 5.0\n%s 1.0\n' $(( _SL_NOW - 3500 )) $(( _SL_NOW - 1000 )) > "${u}/spend"
  _sl_run 140 "$(_sl_json "${_SL_EXPIRED} | .rate_limits.five_hour.used_percentage = 30")"
  _sl_expect_eq "expired: learned rate → % of 5h" "$(_sl_plain "$(_sl_line 2)")" \
    "142K tokens to Opus Med is £1.14 (~23% of 5h)"
  _sl_run 140 "$(_sl_json "${_SL_EXPIRED} | .rate_limits.five_hour.used_percentage = 10.5")"
  _sl_expect_eq "expired: under a point of signal → no %" "$(_sl_plain "$(_sl_line 2)")" \
    "142K tokens to Opus Med is £1.14"
  # Percent of 5h: 1.125 × 20 = 22.5 rounds half to even (22); 0.04 × 20 is under 1
  _sl_expired_case 140625 1 "140K tokens to Opus Med is £1.12 (~22% of 5h)" 30
  _sl_expired_case 156250 1 "156K tokens to Opus Med is £1.25 (~25% of 5h)" 30
  _sl_expired_case 5000 1 "5K tokens to Opus Med is £0.04 (<1% of 5h)" 30

  # A session's first render only sets its baseline; the next appends the delta
  _sl_usage_reset
  _sl_run 140 "$(_sl_json '.session_id = "rec" | .cost.total_cost_usd = 3
    | .rate_limits.five_hour.used_percentage = 40')"
  _sl_expect_eq "ledger: first render records no spend" "$([[ -f "${u}/spend" ]] && echo yes || echo no)" "no"
  _sl_run 140 "$(_sl_json '.session_id = "rec" | .cost.total_cost_usd = 3.5
    | .rate_limits.five_hour.used_percentage = 41')"
  _sl_expect_eq "ledger: second render appends the delta" "$(cat "${u}/spend" 2>/dev/null)" "${_SL_NOW} 0.500000"
  _sl_expect_eq "ledger: 5h sample recorded" "$(cat "${u}/five" 2>/dev/null)" "${_SL_NOW} 41"

  # A resumed session's counter restarts below its last value: all fresh spend
  _sl_run 140 "$(_sl_json '.session_id = "rec" | .cost.total_cost_usd = 0.25
    | .rate_limits.five_hour.used_percentage = 41')"
  _sl_expect_eq "ledger: restarted counter counts in full" "$(tail -1 "${u}/spend")" "${_SL_NOW} 0.250000"
  # The 5h sample is taken at most once a minute: the renders above fall in it
  _sl_expect_eq "ledger: a fresh 5h file takes no second sample" \
    "$(wc -l < "${u}/five" | tr -d ' ')" "1"

  # Deltas print to six places
  _sl_run 140 "$(_sl_json '.session_id = "rec" | .cost.total_cost_usd = 0.3734567
    | .rate_limits.five_hour.used_percentage = 41')"
  _sl_expect_eq "ledger: delta rounds to six places" "$(tail -1 "${u}/spend")" "${_SL_NOW} 0.123457"
  # Costs in exponent notation (jq prints 1.5E-7), and a delta that rounds to
  # 0.000000 is not appended
  local before after
  _sl_run 140 "$(_sl_json '.session_id = "exp" | .cost.total_cost_usd = 1.5e-7
    | .rate_limits.five_hour.used_percentage = 41')"
  _sl_run 140 "$(_sl_json '.session_id = "exp" | .cost.total_cost_usd = 0.0000035
    | .rate_limits.five_hour.used_percentage = 41')"
  _sl_expect_eq "ledger: exponent-notation baseline, delta 3.35e-6" "$(tail -1 "${u}/spend")" "${_SL_NOW} 0.000003"
  before="$(wc -l < "${u}/spend" | tr -d ' ')"
  _sl_run 140 "$(_sl_json '.session_id = "exp" | .cost.total_cost_usd = 0.00000365
    | .rate_limits.five_hour.used_percentage = 41')"
  after="$(wc -l < "${u}/spend" | tr -d ' ')"
  _sl_expect_eq "ledger: a delta that prints 0.000000 is not appended" "${after}" "${before}"

  _sl_ledger_prune
  _sl_ledger_concurrent
  _sl_usage_reset
}

# _sl_touch_old <file> <seconds before _SL_NOW> — backdate an mtime
function _sl_touch_old {
  /usr/bin/touch -t "$(date -r $(( _SL_NOW - $2 )) +%Y%m%d%H%M.%S)" "$1"
}

function _sl_ledger_prune {
  local u="${_SL_SB}/Library/Caches/statusline/usage"
  _sl_usage_reset
  mkdir -p "${u}"
  # Lines 7h and 5h old; a 5h sample over a minute old, so this render ticks
  printf '%s 9.0\n%s 1.0\n' $(( _SL_NOW - 25200 )) $(( _SL_NOW - 18000 )) > "${u}/spend"
  printf '%s 50\n%s 20\n' $(( _SL_NOW - 25200 )) $(( _SL_NOW - 18000 )) > "${u}/five"
  _sl_touch_old "${u}/five" 120
  printf '1' > "${u}/last-pr"
  printf '1' > "${u}/last-stale"
  printf '1' > "${u}/last-fresh"
  _sl_touch_old "${u}/last-stale" 345600
  _sl_run 140 "$(_sl_json '.session_id = "pr" | .cost.total_cost_usd = 2
    | .rate_limits.five_hour.used_percentage = 30')"
  _sl_expect_eq "prune: spend keeps only the last 6h" "$(cat "${u}/spend")" \
    "$(( _SL_NOW - 18000 )) 1.0"$'\n'"${_SL_NOW} 1.000000"
  _sl_expect_eq "prune: 5h samples keep only the last 6h" "$(cat "${u}/five")" \
    "$(( _SL_NOW - 18000 )) 20"$'\n'"${_SL_NOW} 30"
  _sl_expect_eq "prune: no temp files left" "$(/bin/ls "${u}" | /usr/bin/grep -c prune)" "0"
  _sl_expect_eq "sweep: 4-day-old session baseline removed" \
    "$([[ -f "${u}/last-stale" ]] && echo kept || echo gone)" "gone"
  _sl_expect_eq "sweep: recent session baseline kept" \
    "$([[ -f "${u}/last-fresh" ]] && echo kept || echo gone)" "kept"
  # An append during the prune survives. Deterministic, unlike the concurrent
  # case below (40 parallel runs never lost a line against a rewrite-in-place
  # prune, 2026-09-25).
  _sl_usage_reset
  mkdir -p "${u}"
  printf '%s 1.0\n' $(( _SL_NOW - 600 )) > "${u}/spend"
  printf '%s 10\n' $(( _SL_NOW - 600 )) > "${u}/five"
  _sl_touch_old "${u}/five" 120
  printf '1' > "${u}/last-pr"
  # shellcheck disable=SC2016  # $1 belongs to the hook, not this shell
  printf '#!/bin/zsh\n[[ $1 == */spend ]] && print -r -- "%s 7.0" >> "$1"\nexit 0\n' "${_SL_NOW}" \
    > "${_SL_SB}/prune-hook"
  chmod 755 "${_SL_SB}/prune-hook"
  _sl_run 140 "$(_sl_json '.session_id = "pr" | .cost.total_cost_usd = 2
    | .rate_limits.five_hour.used_percentage = 30')" STATUSLINE_PRUNE_HOOK="${_SL_SB}/prune-hook"
  _sl_expect_eq "prune: an append during the prune is kept" \
    "$(awk '{ s += $2 } END { printf "%.1f", s }' "${u}/spend")" "9.0"
}

# Eight sessions render at once, each with a baseline, each ticking the prune:
# no appended line may be lost
function _sl_ledger_concurrent {
  local u="${_SL_SB}/Library/Caches/statusline/usage" i rcs=""
  _sl_usage_reset
  mkdir -p "${u}"
  printf '%s 0.5\n' $(( _SL_NOW - 600 )) > "${u}/spend"
  printf '%s 10\n' $(( _SL_NOW - 600 )) > "${u}/five"
  _sl_touch_old "${u}/five" 120
  for i in 1 2 3 4 5 6 7 8; do
    printf '1' > "${u}/last-c${i}"
    ( _sl_json ".session_id = \"c${i}\" | .cost.total_cost_usd = 2
        | .rate_limits.five_hour.used_percentage = 20" \
      | _run_no_tty env HOME="${_SL_SB}" COLUMNS=140 STATUSLINE_NOW="${_SL_NOW}" \
        GIT_CEILING_DIRECTORIES="${_SL_SB}" STATUSLINE_OSASCRIPT="${_SL_SB}/osascript-stub" \
        /bin/zsh "${SCRIPT_DIR}/claude/statusline-command" >/dev/null 2>&1
      print -r -- $? > "${_SL_SB}/rc-c${i}" ) &
  done
  wait
  for i in 1 2 3 4 5 6 7 8; do rcs+="$(cat "${_SL_SB}/rc-c${i}")"; done
  _sl_expect_eq "concurrent: every run exits 0" "${rcs}" "00000000"
  _sl_expect_eq "concurrent: seeded line plus all eight deltas kept" \
    "$(awk '{ n++; s += $2 } END { printf "%d %.2f", n, s }' "${u}/spend")" "9 8.50"
  _sl_expect_eq "concurrent: no temp files left" "$(/bin/ls "${u}" | /usr/bin/grep -c prune)" "0"
}

# ── (9) cache_alert ────────────────────────────────────────────────────────
function _sl_alert_payload {
  # <session_id or null> <warm> <seconds left> <recache tokens>
  _sl_json ".session_id = $1 | .prompt_cache = {warm: $2, caching_observed: true,
    expires_at: (\$now + $3), hit_ratio: 0.95, recache_tokens_if_cold: $4}"
}

function _sl_alert_markers {
  /usr/bin/find "${_SL_SB}/Library/Caches/statusline" -maxdepth 1 -name 'cache-alert-*' \
    | wc -l | tr -d ' '
}

function _sl_alert_silent {
  # <label> <session_id or null> <warm> <seconds left> <recache tokens>
  /usr/bin/find "${_SL_SB}/Library/Caches/statusline" -maxdepth 1 -name 'cache-alert-*' \
    -exec /bin/rm -rf {} +
  _sl_run 140 "$(_sl_alert_payload "$2" "$3" "$4" "$5")"
  _sl_expect_eq "cache_alert silent: $1" "$(_sl_alert_markers)" "0"
}

function _sl_cache_alert {
  local log="${_SL_SB}/osascript.log" i marker
  marker="${_SL_SB}/Library/Caches/statusline/cache-alert-s1-$(( _SL_NOW + 240 ))"

  _sl_run 140 "$(_sl_alert_payload '"s1"' true 240 160000)"
  if [[ -d "${marker}" ]]; then
    _pass "cache_alert claims its marker (4m left, 160K tokens)"
  else
    _fail "cache_alert marker ${marker} not created"
  fi
  # The osascript call is backgrounded; give it up to 2s to land
  for (( i = 0; i < 20; i++ )); do
    [[ -s "${log}" ]] && break
    sleep 0.1
  done
  _sl_expect_has "cache_alert posts the message" "$(cat "${log}" 2>/dev/null)" \
    "work · Opus — cache goes cold in 4m (160K tokens to re-cache)"

  _sl_run 140 "$(_sl_alert_payload '"s1"' true 240 160000)"
  sleep 0.5
  _sl_expect_eq "cache_alert fires once per session+expires_at" \
    "$(/usr/bin/grep -c 'cache goes cold' "${log}" 2>/dev/null)" "1"

  _sl_alert_silent "more than 5 min left" '"s2"' true 301 160000
  _sl_alert_silent "under 150K re-cache tokens" '"s3"' true 240 149999
  _sl_alert_silent "cache not warm" '"s4"' false 240 160000
  _sl_alert_silent "already expired" '"s5"' true 0 160000
  _sl_alert_silent "no session_id" null true 240 160000
  _sl_run 140 "$(_sl_alert_payload '"s6"' true 300 150000)"
  _sl_expect_eq "cache_alert claims at exactly 5 min / 150K" "$(_sl_alert_markers)" "1"

  # Delivery is backgrounded, so settle first. Expected: the s1 and s6
  # boundary alerts only. Timing can only hide an extra notification (a false
  # pass under load), never invent one.
  for (( i = 0; i < 20; i++ )); do
    [[ -f "${log}" ]] && (( $(/usr/bin/grep -c 'cache goes cold' "${log}") >= 2 )) && break
    sleep 0.1
  done
  sleep 1
  _sl_expect_eq "cache_alert delivered exactly twice (s1 once, s6 boundary)" \
    "$(/usr/bin/grep -c 'cache goes cold' "${log}" 2>/dev/null)" "2"
}

# ── (10) subagent-statusline ───────────────────────────────────────────────
function _sl_subagent {
  local script="${SCRIPT_DIR}/claude/subagent-statusline" out rc line id content
  local payload
  payload="$(jq -cn '{columns: 100, tasks: [
    {id: "a", name: "Explore", status: "running", description: "d", model: "sonnet", effort: "high", tokenCount: 199999},
    {id: "b", name: "Explore", status: "running", tokenCount: 200000},
    {id: "c", name: "Explore", status: "completed", tokenCount: 400000},
    {id: "d", name: "Explore", status: "running"},
    {id: "e", name: "Explore", status: "running", tokenCount: 399999},
    {id: "f", name: "Explore", effort: "max"},
    {id: "g", name: "Explore", status: "failed"},
    {id: "h", name: "Explore", tokenCount: 1150001},
    {id: "i", name: "Explore", tokenCount: 1260000},
    {id: "j", name: "Explore", description: "tab\there \"q\" back\\slash é\nnext", tokenCount: "junk"},
    {id: "k\nk\u001fk", name: "Explore"},
    {id: 7, name: "Explore"}]}')"
  rc=0
  out="$(printf '%s' "${payload}" | /bin/zsh "${script}" 2>/dev/null)" || rc=$?
  _sl_expect_eq "subagent: exit 0 with tasks" "${rc}" "0"
  # Ids round-trip byte for byte, including a newline and a unit separator
  # inside one, and a numeric id comes back as its string, as `jq -r .id` gave
  _sl_expect_eq "subagent: exactly one row per task id" \
    "$(jq -r '.id | @json' <<< "${out}" 2>/dev/null | sort | tr '\n' ' ')" \
    '"7" "a" "b" "c" "d" "e" "f" "g" "h" "i" "j" "k\nk\u001fk" '
  _sl_expect_eq "subagent: one JSON object per output line" \
    "$(jq -c . <<< "${out}" 2>/dev/null | wc -l | tr -d ' ')" "12"
  while IFS= read -r line; do
    if ! jq -e 'has("id") and has("content")' <<< "${line}" >/dev/null 2>&1; then
      _fail "subagent: row is not JSON with id + content: $(printf '%q' "${line}")"
      continue
    fi
    id="$(jq -r .id <<< "${line}")"
    content="$(jq -r .content <<< "${line}")"
    case "${id}" in
      a) _sl_expect_has "subagent: 199,999 tokens green" "${content}" "${GREEN}199K${RESET}"
         # Whole row once, at >= 90 cols: status, description, model, badge
         _sl_expect_eq "subagent: full row at 100 cols" "${content}" \
           "${_SL_CYAN}Explore${RESET} ${_SL_DIM}·${RESET} ${_SL_CYAN}running${RESET} ${_SL_DIM}·${RESET} ${_SL_DIM}d${RESET} ${_SL_DIM}·${RESET} ${_SL_DIM}sonnet${RESET} ${_SL_DIM}·${RESET} ${_SL_MAGENTA}▲ high${RESET} ${_SL_DIM}·${RESET} ${GREEN}199K${RESET}" ;;
      b) _sl_expect_has "subagent: 200,000 tokens yellow" "${content}" "${YELLOW}200K${RESET}" ;;
      c) _sl_expect_has "subagent: 400,000 tokens red" "${content}" "${RED}400K${RESET}"
         _sl_expect_has "subagent: completed status green" "${content}" "${GREEN}completed${RESET}" ;;
      e) _sl_expect_has "subagent: 399,999 tokens yellow" "${content}" "${YELLOW}399K${RESET}" ;;
      f) _sl_expect_has "subagent: max effort badge red" "${content}" "${RED}▲▲▲ max${RESET}" ;;
      g) _sl_expect_has "subagent: failed status red" "${content}" "${RED}failed${RESET}" ;;
      d) _sl_expect_eq "subagent: no tokenCount → no token segment" \
           "$(_sl_plain "${content}")" "Explore · running" ;;
      # Millions truncate to hundredths before rounding to tenths (the bc
      # scale=2 figure): 1,150,001 is 1.1M, not 1.2M; 1,260,000 is 1.3M
      h) _sl_expect_has "subagent: 1,150,001 tokens → 1.1M" "${content}" "${RED}1.1M${RESET}" ;;
      i) _sl_expect_has "subagent: 1,260,000 tokens → 1.3M" "${content}" "${RED}1.3M${RESET}" ;;
      # Field transport is lossless for tabs, quotes, backslashes and
      # non-ASCII; a newline inside a description is flattened to a space
      # (a status row is one line); a non-numeric tokenCount drops the segment
      j) _sl_expect_eq "subagent: tab, quote, backslash, é and newline in description" \
           "${content}" \
           "${_SL_CYAN}Explore${RESET} ${_SL_DIM}·${RESET} ${_SL_DIM}tab"$'\t'"here \"q\" back\\slash é next${RESET}" ;;
      k*|7) : ;;  # id round-trip is asserted on the sorted id list above
      *) _fail "subagent: unexpected id ${id}" ;;
    esac
  done <<< "${out}"

  # Rows travel to the serialiser on stdin, so a batch far past ARG_MAX still
  # renders every row
  local big
  big="$(jq -cn '{columns: 40, tasks: [{id: "x", name: ("x" * 600000)}, {id: "y", name: ("y" * 600000)}]}')"
  rc=0
  out="$(printf '%s' "${big}" | /bin/zsh "${script}" 2>/dev/null)" || rc=$?
  _sl_expect_eq "subagent: two 600 KB rows → exit 0, both ids" \
    "${rc}:$(jq -r .id <<< "${out}" 2>/dev/null | tr '\n' ' ')" "0:x y "

  local shape
  for shape in '' '{}' '{"columns":100}' '{"columns":100,"tasks":[]}'; do
    rc=0
    out="$(printf '%s' "${shape}" | /bin/zsh "${script}" 2>/dev/null)" || rc=$?
    _sl_expect_eq "subagent: exit 0, no rows on $(printf '%q' "${shape}")" "${rc}:${out}" "0:"
  done
}

# ── (11) no per-render spawns for text and arithmetic ─────────────────────
# Every render used to start cat, basename, stat, cut, bc, awk, date and mkdir
# processes; builtins do that work now. Shims for those names on PATH log any
# call, then run the real tool, so a regression shows up as a logged name. No
# STATUSLINE_NOW: the clock must come from the shell, not from `date`. The
# script must load zsh/stat and zsh/files by feature name only: a bare
# `zmodload zsh/stat` shadows the external stat (and `zsh/files` mkdir, mv, rm)
# for everything that runs after it.
function _sl_run_spawn {
  # <payload> — HOME sandbox, shims first on PATH, real clock
  printf '%s' "$1" | _run_no_tty env -u CLAUDE_CODE_AUTO_COMPACT_WINDOW \
    -u GIT_DIR -u GIT_WORK_TREE -u STATUSLINE_NOW GIT_CEILING_DIRECTORIES="${_SL_SB}" \
    HOME="${_SL_SB}" COLUMNS=140 PATH="${_SL_SB}/shims:${PATH}" \
    STATUSLINE_OSASCRIPT="${_SL_SB}/osascript-stub" \
    /bin/zsh "${SCRIPT_DIR}/claude/statusline-command" >/dev/null 2>"${_SL_SB}/stderr" || \
    _fail "spawn test: statusline-command exited non-zero: $(head -3 "${_SL_SB}/stderr")"
}

function _sl_spawns {
  local shims="${_SL_SB}/shims" log="${_SL_SB}/shims.log" name real line base=""
  local _SL_NOW
  _SL_NOW="$(date +%s)"
  mkdir -p "${shims}"
  : > "${log}"
  for name in cat basename date stat cut bc awk mkdir; do
    real="$(command -v "${name}")"
    printf '#!/bin/zsh\nprint -r -- "%s $*" >> %q\nexec %q "$@"\n' "${name}" "${log}" "${real}" \
      > "${shims}/${name}"
    chmod 755 "${shims}/${name}"
  done
  _sl_usage_reset
  printf '1' > "${_SL_SB}/Library/Caches/statusline/usd-gbp"
  # A fresh 5h sample file keeps the once-a-minute prune (find, mv, awk filter,
  # rm) out of the run: those stay external by design
  mkdir -p "${_SL_SB}/Library/Caches/statusline/usage"
  printf '%s 55\n' "${_SL_NOW}" > "${_SL_SB}/Library/Caches/statusline/usage/five"
  # shellcheck disable=SC2016  # $now is a jq variable
  base='.session_id = "sp" | .effort.level = "high"
    | .rate_limits = {five_hour: {used_percentage: 55.4, resets_at: ($now + 7200)},
                      seven_day: {used_percentage: 80, resets_at: ($now + 200000)}}
    | .prompt_cache = {warm: true, caching_observed: true, expires_at: ($now + 1800), hit_ratio: 0.8765}'
  # First render sets the ledger baseline, the second records a delta; the
  # long-mantissa cost keeps the pound conversion off its bc fallback window
  _sl_run_spawn "$(_sl_json "${base} | .cost.total_cost_usd = 3.4156250000000003")"
  _sl_run_spawn "$(_sl_json "${base} | .cost.total_cost_usd = 3.5156250000000003")"
  # Over a million tokens (context label), and the root directory (basename)
  _sl_run_spawn "$(_sl_json "${base} | .context_window.current_usage.cache_read_input_tokens = 1260000")"
  _sl_run_spawn "$(jq -cn '{workspace: {current_dir: "/"}, model: {id: "claude-opus-5-5[1m]", display_name: "Opus 5.5"}}')"
  # Expired-cache rows: label, dollars, pounds (no spend ledger, so the
  # sort-and-awk rate lookup, which stays external, does not run)
  /bin/rm -f "${_SL_SB}/Library/Caches/statusline/usage/spend"
  _sl_run_spawn "$(_sl_json "${_SL_EXPIRED} | .prompt_cache.recache_tokens_if_cold = 1260000 | .prompt_cache.ttl = \"5m\"")"
  # Cache alert: marker claim and message
  _sl_run_spawn "$(_sl_json ".session_id = \"spa\" | .prompt_cache = {warm: true, caching_observed: true,
    expires_at: (\$now + 240), hit_ratio: 0.5, recache_tokens_if_cold: 60000}")"
  line="$(tr '\n' ',' < "${log}")"
  _sl_expect_eq "no cat/basename/date/stat/cut/bc/awk/mkdir spawned by a render" "${line}" ""
  _sl_usage_reset

  # Static: modules load by feature name, and no BSD stat call is left
  local bad="" l
  while IFS= read -r l; do
    [[ "${l}" == \#* ]] && continue
    [[ "${l}" == *zmodload*zsh/stat* || "${l}" == *zmodload*zsh/files* ]] || continue
    [[ "${l}" == *"zmodload -F zsh/stat b:zstat"* || "${l}" == *"zmodload -F zsh/files b:zf_mkdir"* ]] || bad+="${l}; "
  done < "${SCRIPT_DIR}/claude/statusline-command"
  _sl_expect_eq "zsh/stat and zsh/files are loaded by feature name only" "${bad}" ""
  _sl_expect_eq "no 'stat -f' in the script but the fallback path" \
    "$(/usr/bin/grep -c 'stat -f' "${SCRIPT_DIR}/claude/statusline-command")" "1"
}

# ── (12) module-load failure falls back to the external commands ──────────
# STATUSLINE_NO_MODULES empties zsh's module path, so every zmodload in the
# script fails. The lines, the ledger and the cache-alert claim must come out the
# same as with the builtins.
function _sl_no_modules {
  local u="${_SL_SB}/Library/Caches/statusline/usage" a p p1 p2
  _sl_usage_reset
  printf '0.8141' > "${_SL_SB}/Library/Caches/statusline/usd-gbp"
  # shellcheck disable=SC2016  # $now is a jq variable
  p1="$(_sl_json '.effort.level = "high" | .cost.total_cost_usd = 1.2345
      | .context_window.current_usage.cache_read_input_tokens = 1260000
      | .rate_limits.five_hour = {used_percentage: 55.4, resets_at: ($now + 7200)}
      | .prompt_cache = {hit_ratio: 0.545, warm: true, caching_observed: true, expires_at: ($now + 1800)}')"
  p2="$(_sl_json "${_SL_EXPIRED} | .prompt_cache.recache_tokens_if_cold = 1260000")"
  for p in "${p1}" "${p2}"; do
    _sl_run 140 "${p}"
    a="${_SL_OUT}"
    _sl_run 140 "${p}" STATUSLINE_NO_MODULES=1
    _sl_expect_eq "no modules: same output as with them ($(_sl_plain "$(_sl_line 1)"))" "${_SL_OUT}" "${a}"
  done

  # The seam really disables the modules: the clock falls back to `date`
  : > "${_SL_SB}/shims.log"
  STATUSLINE_NO_MODULES=1 _sl_run_spawn "$(_sl_json '.')"
  _sl_expect_has "no modules: the clock comes from date" "$(cat "${_SL_SB}/shims.log")" "date +%s"

  # Ledger: baseline, then a delta, then a fresh 5h file takes no second sample
  _sl_run 140 "$(_sl_json '.session_id = "nm" | .cost.total_cost_usd = 1 | .rate_limits.five_hour.used_percentage = 40')" STATUSLINE_NO_MODULES=1
  _sl_run 140 "$(_sl_json '.session_id = "nm" | .cost.total_cost_usd = 1.5 | .rate_limits.five_hour.used_percentage = 41')" STATUSLINE_NO_MODULES=1
  _sl_expect_eq "no modules: ledger delta recorded" "$(cat "${u}/spend" 2>/dev/null)" "${_SL_NOW} 0.500000"
  _sl_run 140 "$(_sl_json '.session_id = "nm" | .cost.total_cost_usd = 1.75 | .rate_limits.five_hour.used_percentage = 41')" STATUSLINE_NO_MODULES=1
  _sl_expect_eq "no modules: one 5h sample a minute" "$(wc -l < "${u}/five" | tr -d ' ')" "1"

  # Cache alert claims its marker through the fallback mkdir
  /usr/bin/find "${_SL_SB}/Library/Caches/statusline" -maxdepth 1 -name 'cache-alert-*' \
    -exec /bin/rm -rf {} +
  _sl_run 140 "$(_sl_alert_payload '"nm1"' true 240 160000)" STATUSLINE_NO_MODULES=1
  _sl_expect_eq "no modules: cache_alert claims its marker" "$(_sl_alert_markers)" "1"
  _sl_run 140 "$(_sl_alert_payload '"nm1"' true 240 160000)" STATUSLINE_NO_MODULES=1
  _sl_expect_eq "no modules: the claim is still once only" "$(_sl_alert_markers)" "1"
  printf '1' > "${_SL_SB}/Library/Caches/statusline/usd-gbp"
  _sl_usage_reset
}

# ── guard liveness marker ───────────────────────────────────────────────────
# The pretool-prefilter mod writes Caches/statusline/guards-<session_id>;
# a missing marker after the 15 s grace is GUARDS OFF in red on every width.
function _sl_expect_lacks {
  local label="$1" haystack="$2" needle="$3"
  if [[ "${haystack}" != *"${needle}"* ]]; then
    _pass "${label}"
  else
    _fail "${label} — did not want $(printf '%q' "${needle}") in $(printf '%q' "${haystack}")"
  fi
}

function _sl_guards {
  local marker="${_SL_SB}/Library/Caches/statusline/guards-sess-1"
  local sess='.session_id = "sess-1"'
  local off="${RED}${BOLD}GUARDS OFF${RESET}"
  /bin/rm -f "${marker}"
  _sl_run 140 "$(_sl_json "${sess} | .cost.total_duration_ms = 20000")"
  _sl_expect_has "guards: no marker after the grace → GUARDS OFF (full)" "$(_sl_line 1)" "${off}"
  _sl_run 80 "$(_sl_json "${sess} | .cost.total_duration_ms = 20000")"
  _sl_expect_has "guards: GUARDS OFF (medium)" "$(_sl_line 1)" "${off}"
  _sl_run 50 "$(_sl_json "${sess} | .cost.total_duration_ms = 20000")"
  _sl_expect_has "guards: GUARDS OFF (compact)" "$(_sl_line 1)" "${off}"
  _sl_run 30 "$(_sl_json "${sess} | .cost.total_duration_ms = 20000")"
  _sl_expect_has "guards: GUARDS OFF (tiny)" "$(_sl_line 1)" "${off}"
  _sl_run 140 "$(_sl_json "${sess} | .cost.total_duration_ms = 15000")"
  _sl_expect_has "guards: exactly at the grace → shown" "$(_sl_line 1)" "${off}"
  _sl_run 140 "$(_sl_json "${sess} | .cost.total_duration_ms = 14999")"
  _sl_expect_lacks "guards: inside the grace → hidden" "${_SL_OUT}" "GUARDS OFF"
  _sl_run 140 "$(_sl_json "${sess} | .cost.total_duration_ms = 20000.5")"
  _sl_expect_has "guards: a fractional duration is truncated, not an error" "$(_sl_line 1)" "${off}"
  _sl_run 140 "$(_sl_json ".cost.total_duration_ms = 20000")"
  _sl_expect_lacks "guards: no session id → hidden" "${_SL_OUT}" "GUARDS OFF"
  printf 'pretool-prefilter\n' > "${marker}"
  _sl_run 140 "$(_sl_json "${sess} | .cost.total_duration_ms = 20000")"
  _sl_expect_lacks "guards: fresh marker → hidden (full)" "${_SL_OUT}" "GUARDS OFF"
  _sl_run 50 "$(_sl_json "${sess} | .cost.total_duration_ms = 20000")"
  _sl_expect_lacks "guards: fresh marker → hidden (compact)" "${_SL_OUT}" "GUARDS OFF"
  # The mod rewrites the marker every 30 s: one older than 60 s (two beats) is a
  # marker from a dead process (same session id resumed, or a crash), not
  # proof of a live load.
  _sl_touch_old "${marker}" 61
  _sl_run 140 "$(_sl_json "${sess} | .cost.total_duration_ms = 20000")"
  _sl_expect_has "guards: marker older than 60 s → GUARDS OFF" "$(_sl_line 1)" "${off}"
  _sl_touch_old "${marker}" 59
  _sl_run 140 "$(_sl_json "${sess} | .cost.total_duration_ms = 20000")"
  _sl_expect_lacks "guards: marker 59 s old → hidden" "${_SL_OUT}" "GUARDS OFF"
  /bin/rm -f "${marker}"
}

function run_statusline {
  _section "Claude Code status lines"

  # claude/ is gitignored and synced out of band: absent scripts skip
  if [[ ! -f "${SCRIPT_DIR}/claude/statusline-command" \
        || ! -f "${SCRIPT_DIR}/claude/subagent-statusline" ]]; then
    _skip "claude/statusline-command or subagent-statusline absent — claude/ not yet synced to this machine"
    return 0
  fi

  if ! [[ -x "$(command -v jq)" && -x /opt/homebrew/bin/jq && -x "$(command -v bc)" ]]; then
    _skip "jq (at /opt/homebrew/bin) or bc not installed"
    return 0
  fi

  # Remove the sandbox even if a set -e abort ends the run early, setup
  # included (empty _SL_SB is a no-op)
  _SL_SB=""
  trap '[[ -n "${_SL_SB}" ]] && /bin/rm -rf "${_SL_SB}"' EXIT
  _sl_setup
  _sl_exit_codes
  _sl_context
  _sl_usage
  _sl_recent_rate
  _sl_countdowns
  _sl_identity
  _sl_cwd
  _sl_economics
  _sl_expired
  _sl_cache_alert
  _sl_guards
  _sl_subagent
  _sl_spawns
  _sl_no_modules
  /bin/rm -rf "${_SL_SB}"
  trap - EXIT
}
