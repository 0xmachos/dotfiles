#!/bin/zsh
# dotfiles/tests/statusline
#
# Feeds stdin JSON to claude/statusline-command and claude/subagent-statusline.
# One case per contract: the exit-0 contract (Claude Code discards the whole
# status line on non-zero exit: a trailing `[ -n "$x" ] && printf` with x
# empty, junk times and counts, a newline inside a field, empty input), the
# arithmetic fallbacks (the bc rounding window, half-even hit ratio, the
# token label, exponent form, and the same row with the zsh modules missing),
# the FX fetch back-off, the cached detached-HEAD git row, the spend ledger
# (a delta, and an empty baseline that must not land as spend), its destructive
# prune and sweeps, orphan recovery and a concurrent append, the cache-alert
# marker, message and once-only delivery, the herdr label set and the hung-hc
# deadline, the GUARDS OFF signal (shown, and hidden by a fresh marker) and
# subagent row parsing (ids and odd characters, a batch past ARG_MAX).
# Colours, tier layouts, labels and per-model tables are not asserted here.
#
# Hermetic: HOME is a $TMPDIR sandbox with a fresh FX cache of 1 (curl never
# fires, £ equals USD) and a settings.json with autoCompactWindow.
# STATUSLINE_NOW pins the clock; STATUSLINE_OSASCRIPT swaps the notification
# for a stub logging its argv. current_dir is "." by default, so the git
# segment and its checksum stay out; only the git cases use a repo.
# CLAUDE_CODE_AUTO_COMPACT_WINDOW is 500000 by default (no settings.json
# read).
#
# Run: ./test statusline
# ShellCheck: shellcheck --shell=bash tests/statusline
# Sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib
# shellcheck disable=SC2296,SC2298  # zsh parameter flags, ${~pat} and ${(f)...}

typeset -g _SL_SB="" _SL_NOW="" _SL_OUT="" _SL_BASE="" _SL_HC_T=t4
typeset -gi _SL_RC=0

# Builtins for file work: no process start per call. The fallbacks run the
# external command when the module is missing.
# shellcheck disable=SC2329  # the fallbacks are called by name
function _sl_load_builtins {
  if ! zmodload -F zsh/files b:zf_mkdir b:zf_chmod b:zf_mv b:zf_rm 2>/dev/null; then
    function zf_mkdir { /bin/mkdir "$@"; }
    function zf_chmod { /bin/chmod "$@"; }
    function zf_mv { /bin/mv "$@"; }
    function zf_rm { /bin/rm "$@"; }
  fi
}

# _sl_json_build <jq filter> — the base payload with the filter applied
function _sl_json_build {
  jq -cn --argjson now "${_SL_NOW}" "
    {workspace: {current_dir: \".\"},
     model: {id: \"claude-opus-5-5[1m]\", display_name: \"Opus 5.5 (1M context)\"},
     cost: {total_cost_usd: 0, total_duration_ms: 0},
     context_window: {current_usage: {input_tokens: 0,
       cache_creation_input_tokens: 0, cache_read_input_tokens: 0}}}
    | $1"
}

# _sl_json <jq filter> — the identity filter reuses the built base: no jq call
function _sl_json {
  if [[ "$1" == . && -n "${_SL_BASE}" ]]; then
    print -r -- "${_SL_BASE}"
  else
    _sl_json_build "$1"
  fi
}

# _sl_run <cols> <payload> [NAME=value ...] — sets _SL_OUT and _SL_RC.
# `|| _SL_RC=$?` keeps a non-zero exit from tripping set -e; every run then
# fails loudly on it (an exit-1 run can still print the text an assertion
# wants).
# GIT_CEILING_DIRECTORIES stops git discovery at the sandbox, so a TMPDIR
# inside a checkout cannot pull in a real repo (or write its /tmp cache).
# _run_no_tty (tests/lib, setsid) matches production: no controlling terminal
# (ps shows TTY ??, 2026-09-29). With one, zsh rewrites COLUMNS from the tty
# size even with all stdio redirected.
function _sl_run {
  local cols="$1" payload="$2"
  shift 2
  _SL_RC=0
  # The environment is set inside the command substitution's own subshell, so
  # no `env` process is started and nothing leaks into the suite's shell.
  _SL_OUT="$(
    unset GIT_DIR GIT_WORK_TREE HC_TERMINAL_ID HC_TERMINAL_SOCKET
    export CLAUDE_CODE_AUTO_COMPACT_WINDOW=500000
    export GIT_CEILING_DIRECTORIES="${_SL_SB}" HOME="${_SL_SB}" COLUMNS="${cols}" \
      STATUSLINE_NOW="${_SL_NOW}" STATUSLINE_OSASCRIPT="${_SL_SB}/osascript-stub"
    # shellcheck disable=SC2163  # each extra argument is a NAME=value pair
    if (( $# )); then export "$@"; fi
    printf '%s' "${payload}" | _run_no_tty /bin/zsh "${SCRIPT_DIR}/claude/statusline-command" \
      2>"${_SL_SB}/stderr")" || _SL_RC=$?
  if (( _SL_RC != 0 )); then
    _fail "statusline-command exited ${_SL_RC} at ${cols} cols on $(printf '%q' "${payload}"): $(head -3 "${_SL_SB}/stderr")"
  fi
}

# Pure zsh: these run inside $( ) on most assertions, so no sed process.
function _sl_plain {
  setopt localoptions extendedglob
  print -r -- "${1//$'\e'\[[0-9;]#m/}"
}

# _sl_line <n> — line n of the last output
function _sl_line {
  local -a rows=("${(@f)_SL_OUT}")
  print -r -- "${rows[$1]-}"
}

function _sl_expect_has {
  local label="$1" haystack="$2" needle="$3"
  if [[ "${haystack}" == *"${needle}"* ]]; then
    _pass "${label}"
  else
    _fail "${label} — wanted $(printf '%q' "${needle}") in $(printf '%q' "${haystack}")"
  fi
}

function _sl_expect_lacks {
  local label="$1" haystack="$2" needle="$3"
  if [[ "${haystack}" != *"${needle}"* ]]; then
    _pass "${label}"
  else
    _fail "${label} — did not want $(printf '%q' "${needle}") in $(printf '%q' "${haystack}")"
  fi
}

function _sl_expect_eq {
  local label="$1" got="$2" want="$3"
  if [[ "${got}" == "${want}" ]]; then
    _pass "${label}"
  else
    _fail "${label} — got $(printf '%q' "${got}"), want $(printf '%q' "${want}")"
  fi
}

# Zsh helpers that replace wc, tail, ls | grep and find | wc. Each sets REPLY.
# _sl_lines <file>: line count, 0 for an empty or missing file
function _sl_lines {
  local t=""
  local -a rows
  { t="$(<"$1")"; } 2>/dev/null || t=""
  if [[ -z "${t}" ]]; then
    REPLY=0
  else
    rows=("${(@f)t}")
    REPLY=${#rows}
  fi
}

# _sl_last <file>: the last line, empty for a missing file
function _sl_last {
  local -a rows=()
  { rows=("${(@f)$(<"$1")}"); } 2>/dev/null || rows=()
  REPLY="${rows[-1]-}"
}

# _sl_kg <path>: k if the path exists, g if it is gone
function _sl_kg {
  if [[ -e "$1" ]]; then REPLY=k; else REPLY=g; fi
}

# _sl_glob_names <pattern>: leaf names that match, space-separated
function _sl_glob_names {
  setopt localoptions nullglob
  local -a m
  # shellcheck disable=SC2206  # the pattern is meant to expand
  m=( ${~1} )
  REPLY="${(j: :)${m:t}}"
}

# _sl_rm_glob <pattern>: remove every match, files or directories
function _sl_rm_glob {
  setopt localoptions nullglob
  local -a m
  # shellcheck disable=SC2206  # the pattern is meant to expand
  m=( ${~1} )
  (( ${#m} == 0 )) || zf_rm -rf -- "${m[@]}"
}

# _sl_touch_old <file> <seconds before _SL_NOW> — backdate an mtime
function _sl_touch_old {
  local ts
  strftime -s ts '%Y%m%d%H%M.%S' $(( _SL_NOW - $2 ))
  /usr/bin/touch -t "${ts}" "$1"
}

function _sl_usage_reset {
  zf_rm -rf -- "${_SL_SB}/Library/Caches/statusline/usage"
}

function _sl_setup {
  _SL_SB="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/statusline-test.XXXXXX")"
  _SL_NOW="${EPOCHSECONDS}"
  zf_mkdir -p -- "${_SL_SB}/Library/Caches/statusline" "${_SL_SB}/.claude"
  printf '1' > "${_SL_SB}/Library/Caches/statusline/usd-gbp"
  printf '{"autoCompactWindow":500000}' > "${_SL_SB}/.claude/settings.json"
  # shellcheck disable=SC2016  # $@ belongs to the stub, not this shell
  printf '#!/bin/zsh\nprint -r -- "$@" >> %q\n' "${_SL_SB}/osascript.log" \
    > "${_SL_SB}/osascript-stub"
  zf_chmod 755 "${_SL_SB}/osascript-stub"
  # First exec in the foreground: the EDR scan of a new file can outlast the
  # bounded wait after a backgrounded call
  "${_SL_SB}/osascript-stub" warm-up >/dev/null 2>&1 || :
  : > "${_SL_SB}/osascript.log"
  _SL_BASE="$(_sl_json_build '.')"
}


# ── exit 0 everywhere ──────────────────────────────────────────────────────
function _sl_exit_codes {
  # Strings and floats where the script does arithmetic: an ISO time in a
  # reset or expiry, a count with letters, a fraction, an exponent, and a
  # newline inside the directory (it would shift every field read after it).
  # Each used to abort the script (rc 1, a blank status line). One payload
  # holds them all: any abort fails the run.
  local junk
  junk="$(jq -cn --arg cwd $'/tmp/a\nb' '{
    workspace: {current_dir: $cwd}, session_id: "s-junk", transcript_path: "/x\ny",
    model: {id: "claude-opus-5-5[1m]", display_name: "Opus\n5.5"},
    rate_limits: {five_hour: {used_percentage: 55, resets_at: "2026-10-22T10:00:00Z"},
                  seven_day: {used_percentage: "80", resets_at: null}},
    prompt_cache: {warm: true, caching_observed: true, expires_at: "2026-10-22T10:00:00Z",
                   hit_ratio: "0.9", recache_tokens_if_cold: "lots"},
    context_window: {current_usage: {input_tokens: "12abc", cache_creation_input_tokens: 150000.5,
                                     cache_read_input_tokens: 1e5}, total_input_tokens: 0.5},
    cost: {total_cost_usd: "free", total_duration_ms: 7200000.9}}')"
  _sl_run 140 "${junk}"
  if (( _SL_RC == 0 )) && [[ -n "${_SL_OUT}" ]]; then
    _pass "exit 0 with output: junk times, junk counts, floats and a newline in the directory"
  else
    _fail "junk payload — rc ${_SL_RC}, output $(printf '%q' "${_SL_OUT}")"
  fi
  _sl_run 140 ""
  if (( _SL_RC == 0 )) && [[ -n "${_SL_OUT}" ]]; then
    _pass "exit 0 with output: empty input"
  else
    _fail "empty input — rc ${_SL_RC}, output $(printf '%q' "${_SL_OUT}")"
  fi
}

# ── arithmetic fallbacks ───────────────────────────────────────────────────
function _sl_arith {
  local c="${_SL_SB}/Library/Caches/statusline" a row
  # One render: usd_to_gbp truncates the product to four decimals before %.2f
  # rounds, so 1.2345 × 0.8141 = 1.0050 shows £1.00 (bc decides inside the
  # rounding window, where float maths gives £1.01); the hit ratio scales as
  # exact decimal digits, then %.0f rounds half to even (.545 → 54); the
  # token label truncates to hundredths before rounding to tenths (1,150,001
  # is 1.1M).
  printf '0.8141' > "${c}/usd-gbp"
  a="$(_sl_json '.cost.total_cost_usd = 1.2345 | .prompt_cache = {hit_ratio: 0.545}
    | .context_window.current_usage.cache_read_input_tokens = 1150001')"
  _sl_run 140 "${a}"
  row="$(_sl_plain "$(_sl_line 2)")"
  _sl_expect_eq "arithmetic: £1.00 in the bc window, 54% half-even, 1.1M truncated" "${row}" "██████████ 1.1M · £1.00 · ♻️54%"
  # Exponent form (jq prints 1.5E-7, which bc would read as a hex digit): the
  # cost and the hit ratio take the bc fallback.
  printf '1' > "${c}/usd-gbp"
  _sl_run 140 "$(_sl_json '.cost.total_cost_usd = 1.5e-7 | .prompt_cache = {hit_ratio: 1e-7}')"
  _sl_expect_has "arithmetic: exponent-form cost and ratio render as £0.00 and 0%" \
    "$(_sl_plain "$(_sl_line 2)")" "£0.00"
  # The same row with every zsh module missing (the externals take over).
  printf '0.8141' > "${c}/usd-gbp"
  _sl_run 140 "${a}" STATUSLINE_NO_MODULES=1
  _sl_expect_eq "arithmetic: the same row with the zsh modules missing" \
    "$(_sl_plain "$(_sl_line 2)")" "${row}"
  printf '1' > "${c}/usd-gbp"
}

# ── FX fetch back-off ──────────────────────────────────────────────────────
function _sl_fx_fetch {
  # A rate older than a day is fetched again. A failed fetch keeps the last
  # rate and stamps usd-gbp.failed, so the next render inside the hour does
  # not call curl again. A curl stub first on PATH logs each call and fails,
  # as curl does offline.
  local cache="${_SL_SB}/Library/Caches/statusline/usd-gbp"
  local shim="${_SL_SB}/curl-shim" log="${_SL_SB}/curl.log"
  zf_mkdir -p -- "${shim}"
  # shellcheck disable=SC2016  # $@ belongs to the stub, not this shell
  printf '#!/bin/zsh\nprint -r -- "$@" >> %q\nexit 6\n' "${log}" > "${shim}/curl"
  zf_chmod 755 "${shim}/curl"
  : > "${log}"
  printf '0.5' > "${cache}"
  _sl_touch_old "${cache}" 90000
  zf_rm -f -- "${cache}.failed"
  _sl_run 140 "$(_sl_json '.cost.total_cost_usd = 2')" PATH="${shim}:${PATH}"
  _sl_run 140 "$(_sl_json '.cost.total_cost_usd = 2')" PATH="${shim}:${PATH}"
  _sl_lines "${log}"
  _sl_expect_eq "FX: a failed fetch keeps the last rate (£1.00) and curl runs once inside the hour" \
    "$(_sl_plain "$(_sl_line 2)")|${REPLY}" "░░░░░░░░░░ 0K · £1.00|1"
  zf_rm -f -- "${cache}.failed"
  printf '1' > "${cache}"
}

# ── git segment cache ──────────────────────────────────────────────────────
function _sl_git {
  # A detached HEAD has no branch, so no segment, on a cached read too. The
  # cache once joined its fields on tabs, which IFS dropped before an empty
  # branch: the cached render showed the staged count as a branch named "1".
  # The cache file is seeded (empty branch, 1 staged, 0 modified), so no git
  # process runs.
  local r="${_SL_SB}/repo" key payload
  zf_mkdir -p -- "${r}"
  key="$(printf '%s' "${r}" | cksum)"
  printf '\x1f1\x1f0' > "${_SL_SB}/Library/Caches/statusline/git-${key%% *}"
  payload="$(jq -cn --arg cwd "${r}" '{workspace: {current_dir: $cwd},
    model: {id: "claude-opus-5-5[1m]", display_name: "Opus 5.5 (1M context)"}}')"
  _sl_run 140 "${payload}"
  _sl_expect_eq "git segment: a cached detached HEAD keeps the empty branch" \
    "$(_sl_plain "$(_sl_line 1)")" "repo Opus"
}

# ── spend ledger: writes, prune, sweeps, orphans ───────────────────────────
function _sl_ledger_writes {
  local u="${_SL_SB}/Library/Caches/statusline/usage"
  _sl_usage_reset
  zf_mkdir -p -- "${u}"
  # A session's baseline is 3; the next render appends the delta to six places
  printf '3' > "${u}/last-rec"
  _sl_run 140 "$(_sl_json '.session_id = "rec" | .cost.total_cost_usd = 3.3734567
    | .rate_limits.five_hour.used_percentage = 41')"
  _sl_last "${u}/spend"
  _sl_expect_eq "ledger: a render appends the delta, rounded to six places" "${REPLY}" "${_SL_NOW} 0.373457"
  # An empty baseline (a write cut short) is reset, not read as 0: the
  # whole session cost must not land in spend as one render's delta
  _sl_usage_reset
  zf_mkdir -p -- "${u}"
  : > "${u}/last-rec"
  _sl_run 140 "$(_sl_json '.session_id = "rec" | .cost.total_cost_usd = 9.5
    | .rate_limits.five_hour.used_percentage = 41')"
  _sl_kg "${u}/spend"
  _sl_expect_eq "ledger: an empty baseline is reset, no spend line" "${REPLY}" "g"
  _sl_usage_reset
}
function _sl_ledger_prune {
  local u="${_SL_SB}/Library/Caches/statusline/usage" c="${_SL_SB}/Library/Caches/statusline"
  local f got
  _sl_usage_reset
  zf_mkdir -p -- "${u}"
  # The daily sweep in the prune also removes cache-state hand-offs: a warm
  # session rewrites its own every render, so an old one is a dead session's
  printf '1 2 x\n' > "${c}/cache-state-stale"
  printf '1 2 x\n' > "${c}/cache-state-fresh"
  _sl_touch_old "${c}/cache-state-stale" 90000
  : > "${c}/git-stale"
  _sl_touch_old "${c}/git-stale" 90000
  # Lines 7h, 21601 s, 21599 s and 5h old; a 5h sample over a minute old, so
  # this render ticks
  printf '%s 9.0\n%s 4.0\n%s 2.0\n%s 1.0\n' $(( _SL_NOW - 25200 )) $(( _SL_NOW - 21601 )) \
    $(( _SL_NOW - 21599 )) $(( _SL_NOW - 18000 )) > "${u}/spend"
  printf '%s 50\n%s 20\n' $(( _SL_NOW - 25200 )) $(( _SL_NOW - 18000 )) > "${u}/five"
  _sl_touch_old "${u}/five" 120
  printf '1' > "${u}/last-pr"
  printf '1' > "${u}/last-stale"
  printf '1' > "${u}/last-fresh"
  # The last-* sweep is 48 h: 49 h old goes, 47 h old stays
  _sl_touch_old "${u}/last-stale" 176400
  _sl_touch_old "${u}/last-fresh" 169200
  # 24 h sweeps: 25 h old goes, 23 h old stays
  printf 'x\n' > "${c}/guards-stale"
  printf 'x\n' > "${c}/guards-fresh"
  # The hc marker sweep is 48 h: 49 h old goes, 47 h old stays
  printf 'x none\n' > "${c}/hc-cache-stale"
  printf 'x none\n' > "${c}/hc-cache-fresh"
  _sl_touch_old "${c}/hc-cache-stale" 176400
  _sl_touch_old "${c}/hc-cache-fresh" 169200
  _sl_touch_old "${c}/guards-stale" 90000
  _sl_touch_old "${c}/guards-fresh" 82800
  _sl_touch_old "${c}/cache-state-fresh" 82800
  _sl_run 140 "$(_sl_json '.session_id = "pr" | .cost.total_cost_usd = 2
    | .rate_limits.five_hour.used_percentage = 30')"
  got=""
  for f in last-stale last-fresh; do _sl_kg "${u}/${f}"; got+="${REPLY}"; done
  for f in cache-state-stale cache-state-fresh guards-stale guards-fresh git-stale hc-cache-stale hc-cache-fresh; do
    _sl_kg "${c}/${f}"; got+="${REPLY}"
  done
  _sl_expect_eq "prune and sweeps: spend and 5h samples cut at 6h, old baselines, hand-offs and caches removed, newer kept" \
    "$(<"${u}/spend")|$(<"${u}/five")|${got}" \
    "$(( _SL_NOW - 21599 )) 2.0"$'\n'"$(( _SL_NOW - 18000 )) 1.0"$'\n'"${_SL_NOW} 1.000000|$(( _SL_NOW - 18000 )) 20"$'\n'"${_SL_NOW} 30|gkgkgkggk"
  zf_rm -f -- "${c}/hc-cache-fresh" "${c}/cache-state-fresh" "${c}/guards-fresh"
  # An append during the prune survives. Deterministic: the hook appends
  # between the prune's rename and its rewrite.
  _sl_usage_reset
  zf_mkdir -p -- "${u}"
  printf '%s 1.0\n' $(( _SL_NOW - 600 )) > "${u}/spend"
  printf '%s 10\n' $(( _SL_NOW - 600 )) > "${u}/five"
  _sl_touch_old "${u}/five" 120
  printf '1' > "${u}/last-pr"
  # shellcheck disable=SC2016  # $1 belongs to the hook, not this shell
  printf '#!/bin/zsh\n[[ $1 == */spend ]] && print -r -- "%s 7.0" >> "$1"\nexit 0\n' "${_SL_NOW}" \
    > "${_SL_SB}/prune-hook"
  zf_chmod 755 "${_SL_SB}/prune-hook"
  _sl_run 140 "$(_sl_json '.session_id = "pr" | .cost.total_cost_usd = 2
    | .rate_limits.five_hour.used_percentage = 30')" STATUSLINE_PRUNE_HOOK="${_SL_SB}/prune-hook"
  _sl_expect_eq "prune: an append during the prune is kept" \
    "$(awk '{ s += $2 } END { printf "%.1f", s }' "${u}/spend")" "9.0"
}

# A run that died between the prune's rename and its append left
# `<ledger>.prune.<pid>` holding the whole ledger. The next prune folds every
# orphan older than a minute back in, oldest first, drops their lines past the
# 6h cut, and removes the file; one under a minute old may be a live pruner's
# rename, so it is left alone.
function _sl_ledger_orphans {
  local u="${_SL_SB}/Library/Caches/statusline/usage"
  _sl_usage_reset
  zf_mkdir -p -- "${u}"
  printf '%s 1.0\n' $(( _SL_NOW - 18000 )) > "${u}/spend"
  printf '%s 20\n' $(( _SL_NOW - 18000 )) > "${u}/five"
  _sl_touch_old "${u}/five" 120
  printf '1' > "${u}/last-pr"
  # Two spend orphans, the older one (by mtime) first in the result; a 7h line
  # in each is dropped. One fresh orphan stays.
  printf '%s 9.0\n%s 3.0\n' $(( _SL_NOW - 25200 )) $(( _SL_NOW - 10000 )) > "${u}/spend.prune.111"
  printf '%s 2.0\n' $(( _SL_NOW - 7200 )) > "${u}/spend.prune.222"
  printf '%s 5.0\n' $(( _SL_NOW - 3600 )) > "${u}/spend.prune.333"
  _sl_touch_old "${u}/spend.prune.111" 300
  _sl_touch_old "${u}/spend.prune.222" 120
  _sl_touch_old "${u}/spend.prune.333" 30
  _sl_run 140 "$(_sl_json '.session_id = "pr" | .cost.total_cost_usd = 2
    | .rate_limits.five_hour.used_percentage = 30')"
  _sl_glob_names "${u}/*prune*"
  _sl_expect_eq "orphans: spend lines folded back oldest first with the 6h cut, folded files removed, the fresh one kept" \
    "$(<"${u}/spend")|${REPLY}" \
    "$(( _SL_NOW - 10000 )) 3.0"$'\n'"$(( _SL_NOW - 7200 )) 2.0"$'\n'"$(( _SL_NOW - 18000 )) 1.0"$'\n'"${_SL_NOW} 1.000000|spend.prune.333"
  _sl_usage_reset
}

# ── cache alert: marker claim, notification, hand-off, sweep ───────────────
function _sl_alert_payload {
  # <session_id or null> <warm> <seconds left> <recache tokens>
  _sl_json ".session_id = $1 | .prompt_cache = {warm: $2, caching_observed: true,
    expires_at: (\$now + $3), hit_ratio: 0.95, recache_tokens_if_cold: $4}"
}

function _sl_cache_alert {
  local c="${_SL_SB}/Library/Caches/statusline" log="${_SL_SB}/osascript.log" i marker got gone
  marker="${c}/cache-alert-s1-$(( _SL_NOW + 240 ))-300"
  # Old alert markers go with the delivery: a 25 h old one is swept, a 23 h
  # old one kept
  zf_mkdir -p -- "${c}/cache-alert-old-1-900" "${c}/cache-alert-recent-1-900"
  _sl_touch_old "${c}/cache-alert-old-1-900" 90000
  _sl_touch_old "${c}/cache-alert-recent-1-900" 82800

  _sl_run 140 "$(_sl_alert_payload '"s1"' true 240 160000)"
  # The osascript call is backgrounded; give it up to 10 s to land. zselect
  # (loaded by ./test) is a 100 ms sleep with no process start. The sweep
  # runs after the notification, in the same backgrounded group.
  for (( i = 0; i < 100; i++ )); do
    [[ -s "${log}" && ! -d "${c}/cache-alert-old-1-900" ]] && break
    zselect -t 10 || :
  done
  _sl_kg "${c}/cache-alert-old-1-900"
  gone="${REPLY}"
  _sl_kg "${c}/cache-alert-recent-1-900"
  got="${gone}${REPLY}"
  [[ -d "${marker}" ]] && got+=" marker"
  [[ "$(<"${log}")" == *". · Opus — cache goes cold in 4m (160K tokens to re-cache)"* ]] && got+=" message"
  _sl_expect_eq "cache_alert: claims its marker, posts the message, hands off the state, sweeps 25 h old markers" \
    "${got}|$(<"${c}/cache-state-s1")" \
    "gk marker message|$(( _SL_NOW + 240 )) 160000 . · Opus"

  _sl_run 140 "$(_sl_alert_payload '"s1"' true 240 160000)"
  zselect -t 50 || :
  _sl_expect_eq "cache_alert fires once per session+expires_at" \
    "$(print -r -- "$(<"${log}")" | /usr/bin/grep -c 'cache goes cold')" "1"
  _sl_rm_glob "${c}/cache-alert-*"
}

# ── herdr-core terminal label ──────────────────────────────────────────────
# The status line sets the terminal label `dotfiles.cache` (cold, or minutes
# left in the last 20, or removed with `dotfiles.cache=`) through a stub hc
# that logs its argv. The stub sits at $HOME/.local/bin/hc, the sandbox HOME.
function _sl_hc_stub {
  # <exit code> — write the stub; first exec in the foreground (EDR scan)
  zf_mkdir -p -- "${_SL_SB}/.local/bin"
  # shellcheck disable=SC2016  # $@ belongs to the stub, not this shell
  printf '#!/bin/zsh\nprint -r -- "$@" >> %q\nexit %d\n' "${_SL_SB}/hc.log" "$1" \
    > "${_SL_SB}/.local/bin/hc"
  zf_chmod 755 "${_SL_SB}/.local/bin/hc"
  "${_SL_SB}/.local/bin/hc" warm-up >/dev/null 2>&1 || :
  : > "${_SL_SB}/hc.log"
}

# _sl_hc_run <session> <warm> <seconds left> — one run in terminal $_SL_HC_T;
# waits for the backgrounded call, or about 1.5 s for none.
function _sl_hc_run {
  local i
  : > "${_SL_SB}/hc.log"
  _sl_run 140 "$(_sl_json ".session_id = \"$1\" | .prompt_cache = {warm: $2, caching_observed: true,
    expires_at: (\$now + $3), hit_ratio: 0.95, recache_tokens_if_cold: 142000}")" \
    HC_TERMINAL_ID="${_SL_HC_T}" HC_TERMINAL_SOCKET="${_SL_SB}/hc.sock"
  for (( i = 0; i < 50; i++ )); do
    [[ -s "${_SL_SB}/hc.log" ]] && break
    zselect -t 3 || :
  done
  zselect -t 10 || :
}

function _sl_hc_log { print -r -- "$(<"${_SL_SB}/hc.log")"; }

function _sl_hc_label {
  local want="label t4" c="${_SL_SB}/Library/Caches/statusline" i s dead marked
  _sl_hc_stub 0
  _sl_hc_run h1 true 1140
  _sl_expect_eq "hc: 19 min left sets the label 19m" "$(_sl_hc_log)" "${want} dotfiles.cache=19m"

  # A hung hc dies at the alarm: the stub records its pid, then becomes a
  # 30 s sleep. The deadline is 1 s here (STATUSLINE_HC_DEADLINE).
  # shellcheck disable=SC2016  # $$ belongs to the stub, not this shell
  printf '#!/bin/zsh\nprint -r -- $$ > %q\nexec /bin/sleep 30\n' "${_SL_SB}/hc.pid" \
    > "${_SL_SB}/.local/bin/hc"
  "${_SL_SB}/.local/bin/hc" >/dev/null 2>&1 &
  zselect -t 50 || :
  kill "$!" 2>/dev/null || :
  zf_rm -f -- "${_SL_SB}/hc.pid" "${c}/hc-cache-t4"
  s=$SECONDS
  _sl_run 140 "$(_sl_json '.session_id = "h10" | .prompt_cache = {warm: false, caching_observed: true,
    recache_tokens_if_cold: 142000}')" HC_TERMINAL_ID=t4 STATUSLINE_HC_DEADLINE=1
  for (( i = 0; i < 50; i++ )); do
    [[ -s "${_SL_SB}/hc.pid" ]] && ! kill -0 "$(<"${_SL_SB}/hc.pid")" 2>/dev/null && break
    zselect -t 20 || :
  done
  dead=alive marked=no
  if [[ -s "${_SL_SB}/hc.pid" ]] && ! kill -0 "$(<"${_SL_SB}/hc.pid")" 2>/dev/null; then dead=dead; fi
  if [[ -e "${c}/hc-cache-t4" ]]; then marked=yes; fi
  _sl_expect_eq "hc: a hung hc does not hold the status line, is killed at the deadline and writes no marker" \
    "$(( SECONDS - s < 3 )):${dead}:${marked}" "1:dead:no"
  zf_rm -f -- "${_SL_SB}/.local/bin/hc"
}

# ── guard liveness marker ───────────────────────────────────────────────────
# The pretool-prefilter mod writes Caches/statusline/guards-<session_id>;
# a missing marker after the 15 s grace is GUARDS OFF in red on every width.
function _sl_guards {
  local marker="${_SL_SB}/Library/Caches/statusline/guards-sess-1"
  local sess='.session_id = "sess-1"'
  local off="${RED}${BOLD}GUARDS OFF${RESET}"
  zf_rm -f -- "${marker}"
  _sl_run 140 "$(_sl_json "${sess} | .cost.total_duration_ms = 20000")"
  _sl_expect_has "guards: no marker after the grace → GUARDS OFF" "$(_sl_line 1)" "${off}"
  printf 'pretool-prefilter\n' > "${marker}"
  _sl_run 140 "$(_sl_json "${sess} | .cost.total_duration_ms = 20000")"
  _sl_expect_lacks "guards: fresh marker → hidden" "${_SL_OUT}" "GUARDS OFF"
  zf_rm -f -- "${marker}"
}

# ── subagent-statusline ────────────────────────────────────────────────────
function _sl_subagent {
  local script="${SCRIPT_DIR}/claude/subagent-statusline" out rc payload big
  payload="$(jq -cn '{columns: 100, tasks: [
    {id: "a", name: "Explore", status: "running", tokenCount: 199999},
    {id: "j", name: "Explore", description: "tab\there \"q\" back\\slash é\nnext", tokenCount: "junk"},
    {id: "k\nk\u001fk", name: "Explore"},
    {id: 7, name: "Explore"}]}')"
  rc=0
  out="$(printf '%s' "${payload}" | /bin/zsh "${script}" 2>/dev/null)" || rc=$?
  # Ids round-trip byte for byte, including a newline and a unit separator
  # inside one, and a numeric id comes back as its string. Field transport is
  # lossless for tabs, quotes, backslashes and non-ASCII; a newline inside a
  # description is flattened to a space (a status row is one line); a
  # non-numeric tokenCount drops the segment.
  _sl_expect_eq "subagent: exit 0, one row per task id, odd characters kept, newline flattened" \
    "${rc}:$(jq -rs '[.[] | .id | @json] | sort | join(" ")' <<< "${out}" 2>/dev/null)|$(jq -r 'select(.id == "j") | .content' <<< "${out}" 2>/dev/null)" \
    '0:"7" "a" "j" "k\nk\u001fk"|'$'\e[36m'"Explore${RESET} "$'\e[2m'"·${RESET} "$'\e[2m'"tab"$'\t'"here \"q\" back\\slash é next${RESET}"

  # Rows travel to the serialiser on stdin, so a batch far past ARG_MAX still
  # renders every row
  big="$(jq -cn '{columns: 40, tasks: [{id: "x", name: ("x" * 600000)}, {id: "y", name: ("y" * 600000)}]}')"
  rc=0
  out="$(printf '%s' "${big}" | /bin/zsh "${script}" 2>/dev/null)" || rc=$?
  _sl_expect_eq "subagent: two 600 KB rows → exit 0, both ids" \
    "${rc}:$(jq -rs 'map(.id) | join(" ")' <<< "${out}" 2>/dev/null)" "0:x y"
}

function run_statusline {
  _section "Claude Code status lines"

  # claude/ is gitignored and synced out of band: absent scripts skip
  if [[ ! -f "${SCRIPT_DIR}/claude/statusline-command" \
        || ! -f "${SCRIPT_DIR}/claude/subagent-statusline" ]]; then
    _skip "claude/statusline-command or subagent-statusline absent — claude/ not yet synced to this machine"
    return 0
  fi

  if ! [[ -x "$(command -v jq)" && -x /opt/homebrew/bin/jq && -x "$(command -v bc)" ]]; then
    _skip "jq (at /opt/homebrew/bin) or bc not installed"
    return 0
  fi

  _sl_load_builtins
  # Remove the sandbox even if a set -e abort ends the run early, setup
  # included (empty _SL_SB is a no-op)
  _SL_SB=""
  trap '[[ -n "${_SL_SB}" ]] && /bin/rm -rf "${_SL_SB}"' EXIT
  _sl_setup
  _sl_exit_codes
  _sl_arith
  _sl_fx_fetch
  _sl_git
  _sl_ledger_writes
  _sl_ledger_prune
  _sl_ledger_orphans
  _sl_cache_alert
  _sl_hc_label
  _sl_guards
  _sl_subagent
  /bin/rm -rf "${_SL_SB}"
  trap - EXIT
}
