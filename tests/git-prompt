#!/bin/zsh
# dotfiles/tests/git-prompt
#
# Checks _git_prompt_branch (.zshrc RPROMPT) on one fixture layout built from
# plain files: a subdirectory of a linked worktree whose .git file names a
# relative gitdir with a detached HEAD. That covers the walk up to the .git
# file, the gitdir resolved from the file's folder, and the short hash. No git
# process runs.
#
# Run: ./test git-prompt
# ShellCheck: lint with `shellcheck --shell=bash tests/git-prompt`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib
# shellcheck disable=SC2154  # _git_prompt is set by the sourced _git_prompt_branch

# _git_prompt_case — prints the prompt for the layout
function _git_prompt_case {
  (
    local fixture
    fixture="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/git-prompt.XXXXXX")" || return 1
    trap '/bin/rm -rf -- "${fixture}"' EXIT
    # shellcheck disable=SC1090,SC1091
    source <(/usr/bin/awk '
      /^function _git_prompt_branch / { block = 1 }
      block { print }
      /^}$/ { block = 0 }
    ' "${SCRIPT_DIR}/.zshrc")
    /bin/mkdir -p "${fixture}/r/.git/worktrees/wt" "${fixture}/wt/sub"
    print -r -- 'gitdir: ../r/.git/worktrees/wt' > "${fixture}/wt/.git"
    print -r -- 'a1b2c3d4e5f60718293a4b5c6d7e8f9012345678' > "${fixture}/r/.git/worktrees/wt/HEAD"
    # The relative gitdir must resolve from the .git file's dir, not the cwd.
    cd "${fixture}/wt/sub" || return 1
    _git_prompt_branch
    print -r -- "${_git_prompt}"
  )
}

function run_git_prompt {
  _section ".zshrc prompt: git branch without git"

  local out expected
  out="$(_git_prompt_case)"
  expected="(a1b2c3d)"
  if [[ "${out}" == "${expected}" ]]; then
    _pass "relative-gitdir worktree subdirectory with detached HEAD shows the short hash"
  else
    _fail "git prompt: expected '${expected}', got '${out}'"
  fi
}
