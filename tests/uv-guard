#!/bin/zsh
# dotfiles/tests/uv-guard
#
# Behavioural test for claude/hooks/uv-guard-hook (PreToolUse, Bash and Monitor:
# denies pip install, python -m pip/venv, virtualenv, conda, mamba, pyenv and
# the literal /usr/bin/python3, and points at uv). One input per case. Covers:
# DENY for pip install (with the deny reason that names uv and offers no
# bypass), python -m venv, conda and the CLT interpreter by literal path; DENY
# for the quoted command word and a shell -c string (bypass spellings); no
# override (an exported UV_GUARD_SKIP exempts nothing, process path); PASS for
# a command under `uv run` and for the one sanctioned CLT use, bin/agent-reset
# (the false-positive guards); and fail-open on an unparseable payload.
#
# Run: ./test uv-guard
#
# ShellCheck: lint with `shellcheck --shell=bash tests/uv-guard`.
# This file is sourced, not executed - chmod 644.
#
# shellcheck source=tests/lib

# Seam run: the guard sourced the dispatcher's way; $1 = want, $2 = command.
function _uv_guard_expect {
  local want="$1" cmd="$2" label="${3:-$2}"
  _hook_run_seam "${SCRIPT_DIR}/claude/hooks/uv-guard-hook" Bash "${cmd}"
  if [[ "${HOOK_SEAM_VERDICT}" == "${want}" ]]; then
    _pass "${want}: ${label}"
  else
    _fail "${label} - expected ${want}, got ${HOOK_SEAM_VERDICT} (${HOOK_SEAM_OUT:0:120})"
  fi
}

function run_uv_guard {
  _section "uv guard hook (pip, venv, conda, CLT python)"

  # claude/ syncs out of band: an absent hook is pending sync, so skip.
  if [[ ! -f "${SCRIPT_DIR}/claude/hooks/uv-guard-hook" ]]; then
    _skip "claude/hooks/uv-guard-hook absent - claude/ not yet synced to this machine"
    return 0
  fi
  if ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
    return 0
  fi

  local out

  # 1. pip install denies, and the reason names uv and offers no bypass.
  _hook_run_seam "${SCRIPT_DIR}/claude/hooks/uv-guard-hook" Bash 'pip install requests'
  if [[ "${HOOK_SEAM_VERDICT}" == DENY && "${HOOK_SEAM_REASON}" == *"uv sync, uv run, uv add"* \
     && "${HOOK_SEAM_REASON}" == *"per-project uv.toml"* && "${HOOK_SEAM_REASON}" == *"the user approves"* \
     && "${HOOK_SEAM_REASON}" != *SKIP* && "${HOOK_SEAM_REASON}" != *bypass* && "${HOOK_SEAM_REASON}" != *override* ]]; then
    _pass "DENY: pip install, reason names uv sync, uv run, uv add and the uv.toml route, no bypass"
  else
    _fail "pip install: ${HOOK_SEAM_VERDICT} ${HOOK_SEAM_OUT:0:200}"
  fi

  # 2 to 4. Other tools denied: python -m venv, conda, the CLT interpreter.
  _uv_guard_expect DENY 'python3 -m venv .venv'
  _uv_guard_expect DENY 'conda install numpy'
  _uv_guard_expect DENY '/usr/bin/python3 script.py' 'CLT interpreter by literal path'

  # 5 and 6. Bypass spellings: a quoted command word, a shell -c string.
  _uv_guard_expect DENY '"pip" install x' 'quoted command word'
  _uv_guard_expect DENY "bash -lc 'cd d && python3 -m venv .v'" 'bash -lc string'

  # 7. No override: an exported UV_GUARD_SKIP exempts nothing. Process path
  # through the hook's own jq.
  out="$(jq -n --arg c 'pip install x' '{tool_name:"Bash", tool_input:{command:$c}}' \
    | env UV_GUARD_SKIP=1 /bin/zsh "${SCRIPT_DIR}/claude/hooks/uv-guard-hook")"
  if [[ "$(_hook_verdict "${out}")" == DENY ]]; then
    _pass "DENY: an exported UV_GUARD_SKIP exempts nothing (process path)"
  else
    _fail "an exported UV_GUARD_SKIP exempted the command"
  fi

  # 8 and 9. PASS: anything under uv run, and the sanctioned CLT use.
  _uv_guard_expect PASS 'uv run pip install x' 'pip inside uv run'
  _uv_guard_expect PASS '/usr/bin/python3 bin/agent-reset self-test' 'the sanctioned CLT use'

  # 10. Fail-open: an unparseable payload allows the command.
  if [[ -z "$(printf '%s' 'not json' | /bin/zsh "${SCRIPT_DIR}/claude/hooks/uv-guard-hook")" ]]; then
    _pass "fail-open: unparseable payload allowed through"
  else
    _fail "fail-open: unparseable payload produced a verdict"
  fi
}
