#!/bin/zsh
# dotfiles/tests/message-policy
#
# Hermetic suite for the public-repo message policy (added 2026-09-22):
# pre-push Layer 3 (trailers, empty commits, long bodies), Layer 4 (tracked-
# tree PII scan of every pushed tip), commit-msg fast feedback, and the shared
# repo-visibility resolver. Each case runs in a throwaway repo whose
# core.hooksPath holds copies of the global hooks: no pre-commit scanner, no
# real denylist. PII_HOOK_PATTERNS points at a fixture list and
# REPO_VISIBILITY_FORCE fixes visibility per call; public cases must block,
# private must allow, every block paired with its allow-side control (as
# tests/git-sign).
#
# MSG_POLICY_SKIP=1 is honoured only with a controlling terminal (2026-09-25;
# pii-scan --check-terminal). _tty variants run under /usr/bin/script -q
# /dev/null (a real pty) and expect the bypass to work; _notty variants use
# tests/lib's _run_no_tty (POSIX setsid) and assert the refusal LINE, not just
# the verdict: a non-interactive caller has no controlling terminal, an
# interactive `./test` does.
#
# Run: ./test message-policy
# ShellCheck: lint with `shellcheck --shell=bash tests/message-policy`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib
# shellcheck disable=SC2016,SC2329,SC2030,SC2031

typeset -ga MP_ENV=(GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
                    PII_HOOK_SSH_CONFIG=/dev/null)

function _mp_repo {
  # Sandbox with a pushed base commit and the global hooks copied into a
  # private hooksPath. $1 = sandbox dir, $2 = fixture pattern file.
  local sb="$1" patterns="$2"
  (
    export "${MP_ENV[@]}" PII_HOOK_PATTERNS="${patterns}" REPO_VISIBILITY_FORCE=private
    mkdir -p "${sb}/hooks"
    cp "${SCRIPT_DIR}/.config/git/hooks/pre-push" \
       "${SCRIPT_DIR}/.config/git/hooks/commit-msg" \
       "${SCRIPT_DIR}/.config/git/hooks/pii-scan" \
       "${SCRIPT_DIR}/.config/git/hooks/commit-signatures" \
       "${SCRIPT_DIR}/.config/git/hooks/repo-visibility" "${sb}/hooks/"
    chmod 755 "${sb}"/hooks/*
    cd "${sb}" || exit 1
    ssh-keygen -t ed25519 -N '' -q -f key
    git init --bare -q remote.git
    git -c init.defaultBranch=main init -q repo
    cd repo || exit 1
    git config user.name t
    git config user.email t@example.invalid
    git config gpg.format ssh
    git config user.signingkey "${sb}/key"
    git config commit.gpgsign true
    git config core.hooksPath "${sb}/hooks"
    git remote add origin "${sb}/remote.git"
    print base > base.txt
    git add base.txt
    git commit -q -m 'Add base file'
    git push -qu origin main 2>/dev/null
  )
  echo "${sb}/repo"
}

function _mp_commit {
  # $1 repo, $2 message (may be multi-line), rest = files to touch (none =
  # --allow-empty). Skips the commit-msg hook so pre-push cases test pre-push
  # alone.
  local dir="$1" msg="$2"
  shift 2
  (
    cd "${dir}" || exit 1
    export "${MP_ENV[@]}"
    local f
    for f in "$@"; do print "$RANDOM" >> "${f}"; git add "${f}"; done
    if (( $# )); then
      git -c core.hooksPath=/dev/null commit -q -m "${msg}"
    else
      git -c core.hooksPath=/dev/null commit -q --allow-empty -m "${msg}"
    fi
  )
}

function _mp_push_check {
  # Core of the push helpers. $1 mode (plain|tty|notty), $2 needle that MUST
  # appear in the hook output (may be empty), $3 want (ALLOWED|BLOCKED),
  # $4 label, $5 repo, $6 visibility, rest = extra env. --dry-run still runs
  # pre-push with the real ref quads but never advances the sandbox remote, so
  # one local commit serves every variant of a scenario: a real push would
  # leave the next ALLOWED case with nothing new to push and no outgoing range
  # to judge.
  local mode="$1" needle="$2" want="$3" label="$4" dir="$5" vis="$6"
  shift 6
  local -a run=()
  case "${mode}" in
    tty) run=(/usr/bin/script -q /dev/null) ;;
    notty) run=(_run_no_tty) ;;
  esac
  local got out
  if out="$( cd "${dir}" && "${run[@]}" env "${MP_ENV[@]}" PII_HOOK_PATTERNS="${MP_PATTERNS}" \
         REPO_VISIBILITY_FORCE="${vis}" "$@" git push --dry-run -q origin main </dev/null 2>&1 )"; then
    got=ALLOWED
  else
    got=BLOCKED
  fi
  if [[ "${got}" != "${want}" ]]; then
    _fail "pre-push ${label} (${vis}) — expected ${want}, got ${got}: $(print -r -- "${out}" | /usr/bin/head -c 600)"
    return
  fi
  if [[ -n "${needle}" && "${out}" != *"${needle}"* ]]; then
    _fail "pre-push ${label} (${vis}) — ${want}, but output missing '${needle}': $(print -r -- "${out}" | /usr/bin/head -c 600)"
    return
  fi
  _pass "pre-push ${want} (${vis}): ${label}"
}

function _mp_push_expect {
  # $1 want (ALLOWED|BLOCKED), $2 label, $3 repo, $4 visibility, rest = extra env.
  _mp_push_check plain '' "$@"
}

function _mp_push_expect_tty {
  # Push under /usr/bin/script -q /dev/null so the pre-push hook has a
  # controlling terminal. For MSG_POLICY_SKIP=1 cases where the bypass is
  # HONOURED.
  _mp_push_check tty '' "$@"
}

function _mp_push_expect_notty {
  # Push under _run_no_tty (no controlling terminal). For MSG_POLICY_SKIP=1
  # cases where the bypass is REFUSED. $5 = needle that MUST appear in the hook
  # output: BLOCKED alone would also pass if the shim died for an unrelated
  # reason.
  local needle="$5"
  _mp_push_check notty "${needle}" "${@[1,4]}" "${@[6,-1]}"
}

function _mp_reset_to_remote {
  # The remote never advances (dry-run pushes), so origin/main needs no fetch.
  ( cd "$1" && export "${MP_ENV[@]}" && git reset -q --hard origin/main )
}

function _mp_commitmsg_check {
  # Core of the commit-msg helpers: drives the hook directly. $1 mode
  # (plain|tty|notty), $2 needle that MUST appear in the hook output (may be
  # empty), $3 want (PASS|DENY), $4 label, $5 repo, $6 visibility, $7 message
  # text, $8 = "staged" to stage a file first, $9 = extra KEY=VALUE env, e.g.
  # MSG_POLICY_SKIP=1 (optional).
  local mode="$1" needle="$2" want="$3" label="$4" dir="$5" vis="$6" text="$7" staged="${8:-}" extra="${9:-}"
  local -a run=()
  case "${mode}" in
    tty) run=(/usr/bin/script -q /dev/null) ;;
    notty) run=(_run_no_tty) ;;
  esac
  local rc=0 got out
  print -r -- "${text}" > "${MP_MSGFILE}"
  out="$(
    cd "${dir}" || exit 1
    export "${MP_ENV[@]}" PII_HOOK_PATTERNS="${MP_PATTERNS}" REPO_VISIBILITY_FORCE="${vis}"
    # SC2163: zsh export takes a scalar holding a literal NAME=value (verified
    # 2026-09-25); shellcheck's bash model does not know the idiom.
    # shellcheck disable=SC2163
    [[ -n "${extra}" ]] && export "${extra}"
    unset GIT_GLOBAL_HOOKS_SEEN
    git reset -q
    if [[ "${staged}" == staged ]]; then print "$RANDOM" >> staged.txt; git add staged.txt; fi
    "${run[@]}" /bin/zsh "${dir%/repo}/hooks/commit-msg" "${MP_MSGFILE}" </dev/null 2>&1
  )" || rc=$?
  if (( rc == 0 )); then got=PASS; else got=DENY; fi
  if [[ "${got}" != "${want}" ]]; then
    _fail "commit-msg ${label} (${vis}) — expected ${want}, got ${got} (exit ${rc}): $(print -r -- "${out}" | /usr/bin/head -c 600)"
    return
  fi
  if [[ -n "${needle}" && "${out}" != *"${needle}"* ]]; then
    _fail "commit-msg ${label} (${vis}) — ${want}, but output missing '${needle}': $(print -r -- "${out}" | /usr/bin/head -c 600)"
    return
  fi
  _pass "commit-msg ${want} (${vis}): ${label}"
}

function _mp_commitmsg_expect {
  # $1 want (PASS|DENY), $2 label, $3 repo, $4 visibility, $5 message text,
  # $6 = "staged" to stage a file first, $7 = extra KEY=VALUE env (optional).
  _mp_commitmsg_check plain '' "$@"
}

function _mp_commitmsg_expect_tty {
  # The hook runs under /usr/bin/script -q /dev/null (controlling terminal):
  # MSG_POLICY_SKIP=1 is HONOURED.
  _mp_commitmsg_check tty '' "$@"
}

function _mp_commitmsg_expect_notty {
  # The hook runs under _run_no_tty: MSG_POLICY_SKIP=1 is REFUSED. $8 = needle
  # that MUST appear in the hook output: DENY alone would also pass if the shim
  # died for an unrelated reason.
  local needle="${8:-}"
  _mp_commitmsg_check notty "${needle}" "${@[1,7]}"
}

function _mp_visibility_expect {
  # $1 want, $2 label, $3 repo, rest = env for the resolver.
  local want="$1" label="$2" dir="$3"
  shift 3
  local got
  got="$( cd "${dir}" && env "${MP_ENV[@]}" "$@" /bin/zsh "${SCRIPT_DIR}/.config/git/hooks/repo-visibility" 2>/dev/null )"
  if [[ "${got}" == "${want}" ]]; then
    _pass "repo-visibility ${want}: ${label}"
  else
    _fail "repo-visibility ${label} — expected ${want}, got '${got}'"
  fi
}

function run_message_policy {
  _section "public-repo message policy: repo-visibility, commit-msg, pre-push layers 3+4"

  local sb repo long_body i
  sb="$(mktemp -d "${TMPDIR:-/tmp}/message-policy.XXXXXX")"
  typeset -g MP_PATTERNS="${sb}/patterns" MP_MSGFILE="${sb}/commit-msg.txt"
  # Fixture denylist: one made-up token, assembled at runtime so no literal
  # here looks like a real entry.
  print -r -- "fixture$(print -n 'host')token" > "${MP_PATTERNS}"
  repo="$(_mp_repo "${sb}" "${MP_PATTERNS}")"

  # --- repo-visibility resolver ---
  _mp_visibility_expect private 'explicit git config wins' "${repo}" \
      GIT_CONFIG_PARAMETERS="'hooks.repoVisibility=private'"
  _mp_visibility_expect public 'explicit git config public' "${repo}" \
      GIT_CONFIG_PARAMETERS="'hooks.repoVisibility=public'"
  _mp_visibility_expect unknown 'local path origin resolves to unknown' "${repo}"
  _mp_visibility_expect public 'force seam' "${repo}" REPO_VISIBILITY_FORCE=public
  # github.com origin via gh fixtures answering private / public / failure.
  print -r -- '#!/bin/sh
printf "true\n"' > "${sb}/gh-private"
  print -r -- '#!/bin/sh
printf "false\n"' > "${sb}/gh-public"
  print -r -- '#!/bin/sh
exit 1' > "${sb}/gh-broken"
  chmod 755 "${sb}"/gh-*
  _mp_visibility_expect private 'github origin, gh says private' "${repo}" \
      GIT_CONFIG_PARAMETERS="'remote.origin.url=git@github.com:o/r.git'" REPO_VISIBILITY_GH="${sb}/gh-private"
  _mp_visibility_expect public 'github origin, gh says public' "${repo}" \
      GIT_CONFIG_PARAMETERS="'remote.origin.url=https://github.com/o/r'" REPO_VISIBILITY_GH="${sb}/gh-public"
  _mp_visibility_expect unknown 'github origin, gh fails -> unknown (callers treat as public)' "${repo}" \
      GIT_CONFIG_PARAMETERS="'remote.origin.url=https://x@github.com/o/r.git'" REPO_VISIBILITY_GH="${sb}/gh-broken"

  # --- pre-push Layer 3: trailer ---
  _mp_commit "${repo}" $'Add a file\n\nLedger-Event: true' a.txt
  _mp_push_expect BLOCKED 'Ledger-Event trailer' "${repo}" public
  _mp_push_expect BLOCKED 'Ledger-Event trailer, visibility unknown counts as public' "${repo}" unknown
  _mp_push_expect ALLOWED 'Ledger-Event trailer in a private repo' "${repo}" private
  _mp_push_expect_notty BLOCKED 'Ledger-Event trailer with MSG_POLICY_SKIP=1 is refused without a terminal' "${repo}" public \
    'ignored: no controlling terminal' MSG_POLICY_SKIP=1
  _mp_reset_to_remote "${repo}"

  _mp_commit "${repo}" $'Add a file\n\nClaude-Session: https://example.invalid/session_x' a.txt
  _mp_push_expect BLOCKED 'Claude-Session trailer' "${repo}" public
  _mp_reset_to_remote "${repo}"

  # --- pre-push Layer 3: empty commit ---
  _mp_commit "${repo}" 'Record an event with no diff'
  _mp_push_expect BLOCKED 'empty commit' "${repo}" public
  _mp_push_expect ALLOWED 'empty commit in a private repo' "${repo}" private
  _mp_push_expect_tty ALLOWED 'empty commit with MSG_POLICY_SKIP=1 (with a terminal)' "${repo}" public MSG_POLICY_SKIP=1
  _mp_push_expect_notty BLOCKED 'empty commit with MSG_POLICY_SKIP=1 is refused without a terminal' "${repo}" public \
    'ignored: no controlling terminal' MSG_POLICY_SKIP=1
  _mp_reset_to_remote "${repo}"

  # --- pre-push Layer 3: body length ---
  long_body=""
  for i in {1..130}; do long_body+="word${i} "; done
  _mp_commit "${repo}" $'Add a file\n\n'"${long_body}" a.txt
  _mp_push_expect BLOCKED '130-word body' "${repo}" public
  _mp_push_expect ALLOWED '130-word body in a private repo' "${repo}" private
  _mp_push_expect ALLOWED '130-word body with hooks.maxBodyWords=200' "${repo}" public \
      GIT_CONFIG_PARAMETERS="'hooks.maxBodyWords=200'"
  _mp_reset_to_remote "${repo}"

  _mp_commit "${repo}" $'Add a file\n\nOne short line about what changed.' a.txt
  _mp_push_expect ALLOWED 'short body' "${repo}" public
  _mp_reset_to_remote "${repo}"

  # --- pre-push Layer 4: tracked-tree scan ---
  _mp_commit "${repo}" 'Add a clean config line' b.txt
  _mp_push_expect ALLOWED 'clean tracked tree' "${repo}" public
  _mp_reset_to_remote "${repo}"

  print -r -- "value=fixture$(print -n 'host')token" >> "${repo}/b.txt"
  _mp_commit "${repo}" 'Add a config line' b.txt
  _mp_push_expect BLOCKED 'tracked file carries a denylisted value' "${repo}" public
  _mp_push_expect ALLOWED 'tracked file carries a denylisted value, hooks.treeScan=false defers' "${repo}" public \
      GIT_CONFIG_PARAMETERS="'hooks.treeScan=false'"
  _mp_push_expect ALLOWED 'tracked file carries a denylisted value, private repo' "${repo}" private
  _mp_reset_to_remote "${repo}"

  # --- commit-msg fast feedback ---
  _mp_commitmsg_expect DENY 'Ledger-Event trailer' "${repo}" public $'Add x\n\nLedger-Event: true' staged
  _mp_commitmsg_expect PASS 'Ledger-Event trailer, private repo' "${repo}" private $'Add x\n\nLedger-Event: true' staged
  _mp_commitmsg_expect DENY 'Claude-Session trailer' "${repo}" public $'Add x\n\nClaude-Session: https://example.invalid/session_x' staged
  _mp_commitmsg_expect PASS 'Claude-Session trailer, private repo' "${repo}" private $'Add x\n\nClaude-Session: https://example.invalid/session_x' staged
  _mp_commitmsg_expect DENY '130-word body' "${repo}" public $'Add x\n\n'"${long_body}" staged
  _mp_commitmsg_expect PASS '130-word body with hooks.maxBodyWords=200' "${repo}" public $'Add x\n\n'"${long_body}" staged \
      GIT_CONFIG_PARAMETERS="'hooks.maxBodyWords=200'"
  _mp_commitmsg_expect PASS 'short message' "${repo}" public $'Add x\n\nOne line.' staged
  # commit-msg cannot tell --allow-empty from a message amend, so nothing
  # staged passes here; pre-push Layer 3 owns the empty-commit rule.
  _mp_commitmsg_expect PASS 'nothing staged passes here (amend shape; pre-push owns empties)' "${repo}" public 'Reword a subject'

  _mp_commitmsg_expect_tty PASS 'Ledger-Event trailer with MSG_POLICY_SKIP=1 (with a terminal)' \
      "${repo}" public $'Add x\n\nLedger-Event: true' staged MSG_POLICY_SKIP=1
  _mp_commitmsg_expect_notty DENY 'Ledger-Event trailer with MSG_POLICY_SKIP=1 is refused without a terminal' \
      "${repo}" public $'Add x\n\nLedger-Event: true' staged MSG_POLICY_SKIP=1 'ignored: no controlling terminal'
  _mp_commitmsg_expect_notty DENY '130-word body with MSG_POLICY_SKIP=1 is refused without a terminal' \
      "${repo}" public $'Add x\n\n'"${long_body}" staged MSG_POLICY_SKIP=1 'ignored: no controlling terminal'

  /bin/rm -rf "${sb}"
}
