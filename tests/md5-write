#!/bin/zsh
# dotfiles/tests/md5-write
#
# Behavioural test for claude/hooks/md5-write-hook, the PreToolUse hook that
# DENIES a write putting MD5 into a file. One input per case. Covers: DENY for
# an MD5 call site, with the deny reason (replacement, offending line, "NOT
# made", no agent override, no skip token); DENY for a real call after a URL
# line (a URL is not a comment); no override (the old skip token in content
# and in the environment exempts nothing, read through the hook's own jq from
# a NotebookEdit payload); PASS for MD5 in a comment and for a prose file (the
# false-positive guards); and fail-open on an unparseable payload.
# The MD5 fixtures are built at run time from a split word, so this file does
# not trip the hook it tests.
#
# Run: ./test md5-write
#
# ShellCheck: lint with `shellcheck --shell=bash tests/md5-write`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

function _md5_write_expect {
  # Seam run: the guard sourced the dispatcher's way. $1 = want, $2 = path,
  # $3 = content, $4 = label.
  local want="$1" file="$2" content="$3" label="$4"
  _hook_run_seam "${SCRIPT_DIR}/claude/hooks/md5-write-hook" Write "" "${file}" "${content}"
  if [[ "${HOOK_SEAM_VERDICT}" == "${want}" ]]; then
    _pass "${want}: ${label}"
  else
    _fail "${label} - expected ${want}, got ${HOOK_SEAM_VERDICT} (${HOOK_SEAM_OUT:0:120})"
  fi
}

function run_md5_write {
  _section "MD5-in-a-write hook"

  # claude/ is gitignored and synced out of band: an absent hook is pending
  # sync, not a regression.
  if [[ ! -f "${SCRIPT_DIR}/claude/hooks/md5-write-hook" ]]; then
    _skip "claude/hooks/md5-write-hook absent — claude/ not yet synced to this machine"
    return 0
  fi

  if ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
    return
  fi

  # An exported bypass would turn every DENY into PASS with the suite green.
  unset MD5_GUARD_SKIP

  local reason out word='md'
  word+='5'
  local call="h = hashlib.${word}(d)"

  # 1. An MD5 call site denies, and the reason is complete.
  _hook_run_seam "${SCRIPT_DIR}/claude/hooks/md5-write-hook" Write "" /x/a.py "${call}"
  reason="${HOOK_SEAM_REASON}"
  if [[ "${HOOK_SEAM_VERDICT}" == DENY && "${reason}" == *"hashlib.sha256"* \
     && "${reason}" == *"${call}"* && "${reason}" == *"NOT made"* \
     && "${reason}" == *"no agent override"* && "${reason}" == *"hand the user"* \
     && "${reason}" != *MD5_GUARD_SKIP* ]]; then
    _pass "DENY: call site, reason names the replacement, the line, the block, no override"
  else
    _fail "call site: ${HOOK_SEAM_VERDICT} ${reason:0:200}"
  fi

  # 2. A real call after a URL line is still caught: `://` is not a comment.
  _md5_write_expect DENY /x/a.js $'const u = "https://x/y";\ncrypto.createHash("'"${word}"$'")' 'real call on the line after a URL'

  # 3. No override (2026-10-09): the old skip token in the content and
  # exported in the environment exempts nothing. NotebookEdit payload through
  # the hook's own jq.
  out="$(jq -n --arg f /x/a.ipynb --arg c $'# MD5_GUARD_SKIP\n'"${call}" \
    '{tool_name:"NotebookEdit", tool_input:{notebook_path:$f, new_source:$c}}' \
    | env MD5_GUARD_SKIP=1 /bin/zsh "${SCRIPT_DIR}/claude/hooks/md5-write-hook")"
  if [[ "$(_hook_verdict "${out}")" == DENY ]]; then
    _pass "DENY: the skip token in content and in the environment is no override (NotebookEdit, process path)"
  else
    _fail "the skip token exempted a NotebookEdit write: ${out:0:120}"
  fi

  # 4. PASS: MD5 named in a comment after clean code.
  _md5_write_expect PASS /x/a.py "h = hashlib.sha256(d)  # was hashlib.${word}" 'MD5 named in a trailing comment'

  # 5. PASS: a prose file discusses MD5.
  _md5_write_expect PASS /x/a.md "Never write hashlib.${word} here." 'markdown discussing MD5'

  # 6. Fail-open: an unparseable payload allows the write, never a verdict.
  if [[ -z "$(printf '%s' 'not json' | /bin/zsh "${SCRIPT_DIR}/claude/hooks/md5-write-hook")" ]]; then
    _pass "fail-open: unparseable payload allows the write"
  else
    _fail "fail-open: unparseable payload produced a verdict"
  fi
}
