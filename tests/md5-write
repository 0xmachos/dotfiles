#!/bin/zsh
# dotfiles/tests/md5-write
#
# Behavioural test for claude/md5-write-hook — the PostToolUse hook that
# reports MD5 cryptography written into a file through Edit or Write. Feeds
# tool payloads as stdin JSON and asserts the verdict: BLOCK (a decision is
# emitted) for MD5 call sites in source, QUIET for the SHA-256 equivalents,
# for prose files, for a file that names the guard, and for a variable or
# filename that merely contains md5.
#
# The two exemptions are the point of this suite. They are what keep an
# advisory hook from crying wolf, and neither is a path allowlist: prose file
# extensions are skipped, and content carrying the literal MD5_GUARD_SKIP is
# skipped, which is how this hook and its own test exempt themselves without
# anything to maintain.
#
# Run: ./test md5-write    (or ./test for the full suite)
#
# ShellCheck: lint with `shellcheck --shell=bash tests/md5-write`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

function _md5_write_run {
  # Echo the hook's stdout for a Write of content $2 to path $1.
  jq -n --arg f "$1" --arg c "$2" \
    '{tool_name:"Write", tool_input:{file_path:$f, content:$c}}' \
    | /bin/zsh "${SCRIPT_DIR}/claude/md5-write-hook"
}

function _md5_write_run_edit {
  # Same, as an Edit (new_string rather than content).
  jq -n --arg f "$1" --arg c "$2" \
    '{tool_name:"Edit", tool_input:{file_path:$f, old_string:"x", new_string:$c}}' \
    | /bin/zsh "${SCRIPT_DIR}/claude/md5-write-hook"
}

function _md5_write_verdict {
  # BLOCK only for well-formed JSON whose decision is exactly "block".
  local out="$1" decision
  [[ -n "${out}" ]] || { printf 'QUIET'; return 0; }
  decision="$(printf '%s' "${out}" | jq -er '.decision' 2>/dev/null)" \
    || { printf 'MALFORMED'; return 0; }
  case "${decision}" in
    block) printf 'BLOCK' ;;
    *)     printf 'BAD:%s' "${decision}" ;;
  esac
}

function _md5_write_expect {
  # NOT `path`. In zsh `path` is tied to `PATH` as an array, so `local path=`
  # replaces PATH with that one value for the life of the function — every
  # command in here then fails "command not found", including jq, several
  # frames away from the assignment. Cost an hour on 2026-09-04.
  local want="$1" file="$2" content="$3" label="${4:-$2}" out got
  out="$(_md5_write_run "${file}" "${content}")"
  got="$(_md5_write_verdict "${out}")"
  if [[ "${got}" == "${want}" ]]; then
    _pass "${want}: ${label}"
  else
    _fail "${label} — expected ${want}, got ${got}"
  fi
}

function run_md5_write {
  _section "MD5-in-a-write hook"

  # claude/ is gitignored and synced out of band — absent hook means the sync
  # hasn't reached this machine, not a regression. Skip, don't die.
  if [[ ! -f "${SCRIPT_DIR}/claude/md5-write-hook" ]]; then
    _skip "claude/md5-write-hook absent — claude/ not yet synced to this machine"
    return 0
  fi

  if ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
    return
  fi

  # A session-wide export of the bypass would turn every BLOCK case into QUIET
  # and the suite would still report green.
  unset MD5_GUARD_SKIP

  # MD5 call sites across the languages used here → BLOCK.
  _md5_write_expect BLOCK /x/a.py 'h = hashlib.md5(data).hexdigest()' 'python hashlib.md5'
  _md5_write_expect BLOCK /x/a.py 'h = hashlib.new("md5", data)' 'python hashlib.new md5'
  _md5_write_expect BLOCK /x/a.swift 'let d = Insecure.MD5.hash(data: raw)' 'swift CryptoKit Insecure.MD5'
  _md5_write_expect BLOCK /x/a.js "crypto.createHash('md5').update(x)" 'node createHash md5'
  _md5_write_expect BLOCK /x/a.java 'MessageDigest.getInstance("MD5")' 'java MessageDigest MD5'
  _md5_write_expect BLOCK /x/a.rb 'Digest::MD5.hexdigest(s)' 'ruby Digest::MD5'
  _md5_write_expect BLOCK /x/a.c 'CC_MD5(buf, len, out);' 'CommonCrypto CC_MD5'
  _md5_write_expect BLOCK /x/a.c 'EVP_md5()' 'openssl EVP_md5'
  _md5_write_expect BLOCK /x/a.go 'h := md5.New()' 'go md5.New'
  # Single quotes are the point: the fixture is literal file content.
  # shellcheck disable=SC2016
  _md5_write_expect BLOCK /x/a.sh 'md5sum "$f" > sums.txt' 'shell md5sum in a script'
  _md5_write_expect BLOCK /x/a.sh 'cd /tmp && md5 file' 'shell md5 after a separator'

  # The SHA-256 spellings → QUIET.
  _md5_write_expect QUIET /x/a.py 'h = hashlib.sha256(data).hexdigest()' 'python hashlib.sha256'
  _md5_write_expect QUIET /x/a.swift 'let d = SHA256.hash(data: raw)' 'swift CryptoKit SHA256'
  _md5_write_expect QUIET /x/a.js "crypto.createHash('sha256').update(x)" 'node createHash sha256'
  # Single quotes are the point: the fixture is literal file content.
  # shellcheck disable=SC2016
  _md5_write_expect QUIET /x/a.sh 'shasum -a 256 "$f" > sums.txt' 'shell shasum -a 256'

  # Exemption 1: prose discusses MD5, code uses it.
  _md5_write_expect QUIET /x/a.md 'Never write hashlib.md5 here.' 'markdown discussing MD5'
  _md5_write_expect QUIET /x/a.markdown 'Insecure.MD5 is banned.' 'markdown long extension'
  _md5_write_expect QUIET /x/a.txt 'md5sum notes' 'plain text'
  _md5_write_expect QUIET /x/NOTES.RST 'CC_MD5 appears here' 'rst, uppercase path'

  # Exemption 2: content naming the guard exempts itself. This is how the hook
  # and this suite avoid reporting on themselves, with no path list to rot.
  _md5_write_expect QUIET /x/a.py '# MD5_GUARD_SKIP: vendor publishes md5 only
h = hashlib.md5(d)' 'content naming the guard'

  # Words that merely contain md5 → QUIET. A narrow call-site match is what
  # makes the hook usable at all.
  _md5_write_expect QUIET /x/a.py 'md5_path = "/tmp/x"' 'variable named md5_path'
  _md5_write_expect QUIET /x/a.py 'p = "md5.txt"' 'filename containing md5'
  _md5_write_expect QUIET /x/a.py 'def _md5_guard_split(s): pass' 'function name containing md5'
  _md5_write_expect QUIET /x/a.py '# we replaced MD5 with SHA-256 last year' 'a comment about MD5'

  # Edit payloads carry new_string rather than content.
  local out got
  out="$(_md5_write_run_edit /x/a.py 'h = hashlib.md5(d)')"
  got="$(_md5_write_verdict "${out}")"
  if [[ "${got}" == BLOCK ]]; then
    _pass "BLOCK: Edit payload (new_string) is scanned"
  else
    _fail "Edit payload — expected BLOCK, got ${got}"
  fi

  # Only the new text is scanned, never the file on disk — otherwise every
  # edit to a file with pre-existing MD5 reports the same finding forever.
  out="$(_md5_write_run_edit /x/a.py 'h = hashlib.sha256(d)')"
  got="$(_md5_write_verdict "${out}")"
  if [[ "${got}" == QUIET ]]; then
    _pass "QUIET: a clean Edit is not judged by the file on disk"
  else
    _fail "clean Edit — expected QUIET, got ${got}"
  fi

  # The reason must name the fix and be valid JSON carrying the matched line.
  out="$(_md5_write_run /x/a.py 'h = hashlib.md5(d)')"
  if [[ "$(printf '%s' "${out}" | jq -er '.reason' 2>/dev/null)" == *"shasum -a 256"* ]]; then
    _pass "reason names shasum -a 256"
  else
    _fail "reason does not mention shasum -a 256"
  fi
  if [[ "$(printf '%s' "${out}" | jq -er '.reason' 2>/dev/null)" == *hashlib.md5* ]]; then
    _pass "reason quotes the offending line"
  else
    _fail "reason does not quote the offending line"
  fi

  # Content with a double quote and a backslash must not break the JSON. jq
  # builds it precisely because the matched lines are arbitrary file content.
  out="$(_md5_write_run /x/a.py 'h = hashlib.md5(b"a\"b\\c")')"
  if [[ "$(_md5_write_verdict "${out}")" == BLOCK ]]; then
    _pass "BLOCK: quotes and backslashes in the matched line stay valid JSON"
  else
    _fail "quotes/backslashes in content produced invalid JSON"
  fi

  # Malformed and irrelevant payloads must stay silent, never block.
  if [[ -z "$(printf '%s' '{}' | /bin/zsh "${SCRIPT_DIR}/claude/md5-write-hook")" ]]; then
    _pass "fail-open: payload with no content stays silent"
  else
    _fail "fail-open: payload with no content produced a verdict"
  fi
  if [[ -z "$(printf '%s' 'not json' | /bin/zsh "${SCRIPT_DIR}/claude/md5-write-hook")" ]]; then
    _pass "fail-open: unparseable payload stays silent"
  else
    _fail "fail-open: unparseable payload produced a verdict"
  fi
}
