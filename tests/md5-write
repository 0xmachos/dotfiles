#!/bin/zsh
# dotfiles/tests/md5-write
#
# Behavioural test for claude/hooks/md5-write-hook — the PreToolUse hook that DENIES
# a write putting MD5 into a file. Feeds tool payloads as stdin JSON and
# asserts the verdict: DENY for MD5 call sites in source, including content that
# names the old skip token (the hook has no override); PASS for SHA-256, MD5 in
# a comment, prose files, and words that merely contain md5.
#
# The hook blocks, so a false positive costs work: two exemptions (comments,
# prose files), no path allowlist (a path list rots and would have to name this
# suite).
#
# Run: ./test md5-write    (or ./test for the full suite)
#
# ShellCheck: lint with `shellcheck --shell=bash tests/md5-write`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

function _md5_write_run {
  # Hook stdout for a Write of content $2 to path $1.
  jq -n --arg f "$1" --arg c "$2" \
    '{tool_name:"Write", tool_input:{file_path:$f, content:$c}}' \
    | /bin/zsh "${SCRIPT_DIR}/claude/hooks/md5-write-hook"
}

function _md5_write_run_edit {
  # Same, as an Edit (new_string, not content).
  jq -n --arg f "$1" --arg c "$2" \
    '{tool_name:"Edit", tool_input:{file_path:$f, old_string:"x", new_string:$c}}' \
    | /bin/zsh "${SCRIPT_DIR}/claude/hooks/md5-write-hook"
}

function _md5_write_run_notebook {
  # Same, as a NotebookEdit (notebook_path and new_source).
  jq -n --arg f "$1" --arg c "$2" \
    '{tool_name:"NotebookEdit", tool_input:{notebook_path:$f, new_source:$c}}' \
    | /bin/zsh "${SCRIPT_DIR}/claude/hooks/md5-write-hook"
}

function _md5_write_run_skip {
  # Same as _md5_write_run, with MD5_GUARD_SKIP=$1 in the hook's environment.
  jq -n --arg f "$2" --arg c "$3" \
    '{tool_name:"Write", tool_input:{file_path:$f, content:$c}}' \
    | env MD5_GUARD_SKIP="$1" /bin/zsh "${SCRIPT_DIR}/claude/hooks/md5-write-hook"
}

function _md5_write_expect {
  # NOT `path`: in zsh it is tied to PATH, so `local path=` replaces PATH and
  # every command (jq included) then fails "command not found".
  local want="$1" file="$2" content="$3" label="${4:-$2}" runner="${5:-_md5_write_run}" out got
  out="$("${runner}" "${file}" "${content}")"
  got="$(_hook_verdict "${out}")"
  if [[ "${got}" == "${want}" ]]; then
    _pass "${want}: ${label}"
  else
    _fail "${label} — expected ${want}, got ${got}"
  fi
}

function run_md5_write {
  _section "MD5-in-a-write hook"

  # claude/ is gitignored and synced out of band: an absent hook is pending
  # sync, not a regression.
  if [[ ! -f "${SCRIPT_DIR}/claude/hooks/md5-write-hook" ]]; then
    _skip "claude/hooks/md5-write-hook absent — claude/ not yet synced to this machine"
    return 0
  fi

  if ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
    return
  fi

  # An exported bypass would turn every DENY into PASS with the suite green.
  unset MD5_GUARD_SKIP

  # MD5 call sites → DENY.
  _md5_write_expect DENY /x/a.py 'h = hashlib.md5(data).hexdigest()' 'python hashlib.md5'
  _md5_write_expect DENY /x/a.py 'h = hashlib.new("md5", data)' 'python hashlib.new md5'
  _md5_write_expect DENY /x/a.swift 'let d = Insecure.MD5.hash(data: raw)' 'swift CryptoKit Insecure.MD5'
  _md5_write_expect DENY /x/a.js "crypto.createHash('md5').update(x)" 'node createHash md5'
  _md5_write_expect DENY /x/a.java 'MessageDigest.getInstance("MD5")' 'java MessageDigest MD5'
  _md5_write_expect DENY /x/a.rb 'Digest::MD5.hexdigest(s)' 'ruby Digest::MD5'
  _md5_write_expect DENY /x/a.c 'CC_MD5(buf, len, out);' 'CommonCrypto CC_MD5'
  _md5_write_expect DENY /x/a.c 'EVP_md5()' 'openssl EVP_md5'
  _md5_write_expect DENY /x/a.go 'h := md5.New()' 'go md5.New'
  # Single quotes are the point: the fixture is literal file content.
  # shellcheck disable=SC2016
  _md5_write_expect DENY /x/a.sh 'md5sum "$f" > sums.txt' 'shell md5sum in a script'
  _md5_write_expect DENY /x/a.sh 'cd /tmp && md5 file' 'shell md5 after a separator'

  # SHA-256 spellings → PASS.
  _md5_write_expect PASS /x/a.py 'h = hashlib.sha256(data).hexdigest()' 'python hashlib.sha256'
  _md5_write_expect PASS /x/a.swift 'let d = SHA256.hash(data: raw)' 'swift CryptoKit SHA256'
  _md5_write_expect PASS /x/a.js "crypto.createHash('sha256').update(x)" 'node createHash sha256'
  # shellcheck disable=SC2016
  _md5_write_expect PASS /x/a.sh 'shasum -a 256 "$f" > sums.txt' 'shell shasum -a 256'
  _md5_write_expect PASS /x/a.java 'MessageDigest.getInstance("SHA-256")' 'java SHA-256'

  # Exemption 1: comments are stripped before matching, so `# never use
  # md5sum` is not blocked.
  _md5_write_expect PASS /x/a.sh '# never use md5sum here' 'hash comment naming md5sum'
  _md5_write_expect PASS /x/a.py '# do not call hashlib.md5 any more' 'hash comment naming a call site'
  _md5_write_expect PASS /x/a.js "// avoid createHash('md5')" 'slash comment naming a call site'
  _md5_write_expect PASS /x/a.py 'h = hashlib.sha256(d)  # was hashlib.md5' 'trailing comment after clean code'
  # A URL is not a comment: `://` survives the strip, so a real call on the
  # next line is still caught.
  _md5_write_expect PASS /x/a.js 'const u = "https://x//y";' 'URL only'
  _md5_write_expect DENY /x/a.js 'const u = "https://x/y";
crypto.createHash("md5")' 'URL on one line, a real call on the next'

  # Exemption 2: prose files discuss MD5, code uses it.
  _md5_write_expect PASS /x/a.md 'Never write hashlib.md5 here.' 'markdown discussing MD5'
  _md5_write_expect PASS /x/a.markdown 'Insecure.MD5 is banned.' 'markdown long extension'
  _md5_write_expect PASS /x/a.txt 'md5sum notes' 'plain text'
  _md5_write_expect PASS /x/NOTES.RST 'CC_MD5 appears here' 'rst, uppercase path'
  _md5_write_expect PASS /x/a.adoc 'hashlib.md5 is banned.' 'asciidoc'

  # No override (2026-10-09): content that names the old skip token is judged
  # like any other content. The token in a comment, in code and in a string
  # all still deny.
  _md5_write_expect DENY /x/a.py '# MD5_GUARD_SKIP: vendor publishes md5 only
h = hashlib.md5(d)' 'skip token in a comment no longer exempts the content'
  _md5_write_expect DENY /x/a.py 'MD5_GUARD_SKIP = 1
h = hashlib.md5(d)' 'skip token in code no longer exempts the content'
  _md5_write_expect DENY /x/a.sh 'MD5_GUARD_SKIP=1 md5sum f' 'skip token as a command prefix no longer exempts the content'
  _md5_write_expect DENY /x/a.js 'const s = "MD5_GUARD_SKIP"; crypto.createHash("md5")' 'skip token in a string no longer exempts the content'
  _md5_write_expect DENY /x/a.py '# MD5_GUARD_SKIP
h = hashlib.md5(d)' 'skip token in an Edit payload no longer exempts the content' _md5_write_run_edit
  _md5_write_expect DENY /x/a.ipynb '# MD5_GUARD_SKIP
h = hashlib.md5(d)' 'skip token in a NotebookEdit payload no longer exempts the content' _md5_write_run_notebook

  # Words that merely contain md5 → PASS (the call-site match must stay narrow).
  _md5_write_expect PASS /x/a.py 'md5_path = "/tmp/x"' 'variable named md5_path'
  _md5_write_expect PASS /x/a.py 'p = "md5.txt"' 'filename containing md5'
  _md5_write_expect PASS /x/a.py 'def _md5_guard_split(s): pass' 'function name containing md5'

  # The old skip variable exported in the hook's own environment exempts
  # nothing, set or empty (2026-10-09).
  local skip_out
  skip_out="$(_md5_write_run_skip 1 /x/a.py 'h = hashlib.md5(d)')"
  if [[ "$(_hook_verdict "${skip_out}")" == DENY ]]; then
    _pass "DENY: exported MD5_GUARD_SKIP=1 no longer exempts the write"
  else
    _fail "exported MD5_GUARD_SKIP=1 still exempts the write"
  fi
  skip_out="$(_md5_write_run_skip '' /x/a.py 'h = hashlib.md5(d)')"
  if [[ "$(_hook_verdict "${skip_out}")" == DENY ]]; then
    _pass "DENY: exported empty MD5_GUARD_SKIP exempts nothing"
  else
    _fail "exported empty MD5_GUARD_SKIP exempted the write"
  fi

  # Edit payloads carry new_string, not content.
  _md5_write_expect DENY /x/a.py 'h = hashlib.md5(d)' 'Edit payload (new_string) is scanned' _md5_write_run_edit

  # Only the new text is scanned, never the file on disk, or the edit that
  # removes existing MD5 would be blocked too.
  _md5_write_expect PASS /x/a.py 'h = hashlib.sha256(d)' 'a clean Edit is not judged by the file on disk' _md5_write_run_edit

  # NotebookEdit payloads carry new_source and notebook_path, not content and
  # file_path. The path decides the prose exemption, so a prose notebook_path
  # passes and a code one is denied with its path in the reason.
  _md5_write_expect DENY /x/a.ipynb 'h = hashlib.md5(d)' 'NotebookEdit payload (new_source) is scanned' _md5_write_run_notebook
  _md5_write_expect PASS /x/a.md 'h = hashlib.md5(d)' 'NotebookEdit notebook_path is read for the prose exemption' _md5_write_run_notebook

  # The deny reason names the fix and the escape hatch, quotes the offending
  # line, and says the write did not happen.
  local out reason
  out="$(_md5_write_run /x/a.py 'h = hashlib.md5(d)')"
  reason="$(printf '%s' "${out}" | jq -er '.hookSpecificOutput.permissionDecisionReason' 2>/dev/null)"
  if [[ "${reason}" == *"hashlib.sha256"* ]]; then
    _pass "deny reason names the SHA-256 replacement"
  else
    _fail "deny reason does not name the replacement"
  fi
  if [[ "${reason}" == *"h = hashlib.md5(d)"* ]]; then
    _pass "deny reason quotes the offending line"
  else
    _fail "deny reason does not quote the offending line"
  fi
  if [[ "${reason}" == *"NOT made"* ]]; then
    _pass "deny reason says the write did not happen"
  else
    _fail "deny reason does not say the write was blocked"
  fi
  if [[ "${reason}" == *"no agent override"* && "${reason}" == *"hand the user"* \
     && "${reason}" != *MD5_GUARD_SKIP* ]]; then
    _pass "deny reason says no agent override and names no skip token"
  else
    _fail "deny reason does not say no agent override, or still names MD5_GUARD_SKIP"
  fi
  out="$(_md5_write_run_notebook /x/a.ipynb 'h = hashlib.md5(d)')"
  reason="$(printf '%s' "${out}" | jq -er '.hookSpecificOutput.permissionDecisionReason' 2>/dev/null)" || reason=""
  if [[ "${reason}" == *"into /x/a.ipynb"* ]]; then
    _pass "NotebookEdit deny reason names the notebook_path"
  else
    _fail "NotebookEdit deny reason does not name the notebook_path"
  fi

  # A double quote and a backslash in content must not break the JSON.
  _md5_write_expect DENY /x/a.py 'h = hashlib.md5(b"a\"b\\c")' 'quotes and backslashes in the matched line stay valid JSON'

  # Malformed and irrelevant payloads allow the write (fail-open).
  if [[ -z "$(printf '%s' '{}' | /bin/zsh "${SCRIPT_DIR}/claude/hooks/md5-write-hook")" ]]; then
    _pass "fail-open: payload with no content allows the write"
  else
    _fail "fail-open: payload with no content produced a verdict"
  fi
  if [[ -z "$(printf '%s' 'not json' | /bin/zsh "${SCRIPT_DIR}/claude/hooks/md5-write-hook")" ]]; then
    _pass "fail-open: unparseable payload allows the write"
  else
    _fail "fail-open: unparseable payload produced a verdict"
  fi
}
