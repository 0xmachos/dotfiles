#!/bin/zsh
# dotfiles/tests/container-tmp
#
# Behavioural test for claude/hooks/container-tmp-hook — the PreToolUse hook that
# denies Apple `container` builds/mounts rooted in tmp paths (home-scoped file
# sharing silently shares them as empty).
# Feeds commands plus a cwd; asserts DENY for tmp-rooted build contexts/cwds
# and -v/--mount sources, PASS for $HOME paths, guest paths, docker commands
# and lookalikes.
# Since 2026-10-24 the verdict cases run the guard through the pretool-dispatch
# seam (_hook_run_seam in tests/lib: sourced in a subshell, HOOK_PRE_* set,
# DENY<US>reason), the path live sessions use, at about 5 ms a case instead
# of about 50 ms and 6 execs. These cases stay standalone (`/bin/zsh <hook>`
# with JSON on stdin): a few DENY and PASS verdicts for the process path, the
# deny-reason text as the JSON carries it, the malformed-JSON and empty-payload
# fail-open path, the exported HOOK_PRE_DISPATCH=1 case (a standalone hook must
# not skip) and the case where stdin differs from HOOK_PRE_COMMAND.
#
# Run: ./test container-tmp
# ShellCheck: lint with `shellcheck --shell=bash tests/container-tmp`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

# Standalone run: the hook as its own process, JSON on stdin. Echoes stdout.
function _container_tmp_run {
  # $1 = command, $2 = cwd (default $HOME).
  jq -n --arg c "$1" --arg d "${2:-${HOME}}" \
    '{tool_name:"Bash", tool_input:{command:$c}, cwd:$d}' \
    | /bin/zsh "${SCRIPT_DIR}/claude/hooks/container-tmp-hook"
}

# Seam run: the guard sourced the dispatcher's way; the verdict lands in
# HOOK_SEAM_VERDICT and the reason in HOOK_SEAM_REASON.
function _container_tmp_expect {
  local want="$1" cmd="$2" cwd="${3:-}" label="${4:-$2}"
  _hook_run_seam "${SCRIPT_DIR}/claude/hooks/container-tmp-hook" Bash "${cmd}" '' '' "${cwd}"
  if [[ "${HOOK_SEAM_VERDICT}" == "${want}" ]]; then
    _pass "${want}: ${label}"
  else
    _fail "${label} — expected ${want}, got ${HOOK_SEAM_VERDICT} (${HOOK_SEAM_OUT:0:120})"
  fi
}

# Standalone verdict check, kept for a few cases per verdict.
function _container_tmp_expect_standalone {
  local want="$1" cmd="$2" cwd="${3:-}" label="${4:-$2}" out got
  out="$(_container_tmp_run "${cmd}" "${cwd}")"
  got="$(_hook_verdict "${out}")"
  if [[ "${got}" == "${want}" ]]; then
    _pass "${want} (standalone): ${label}"
  else
    _fail "standalone ${label} — expected ${want}, got ${got}"
  fi
}

function _container_tmp_seam {
  # $1 = command, $2 = cwd, $3 = stdin text. Sources the guard the way
  # pretool-dispatch does: HOOK_PRE_* plain variables inside a function, so the
  # guard sees ":file" in ZSH_EVAL_CONTEXT. Echoes the guard's stdout.
  /bin/zsh -c '
    function _drive {
      HOOK_PRE_DISPATCH=1
      HOOK_PRE_COMMAND="$1"
      HOOK_PRE_CWD="$2"
      local guard="$3"
      set --
      source "${guard}"
    }
    _drive "$@"' _ "$1" "$2" "${SCRIPT_DIR}/claude/hooks/container-tmp-hook" <<< "$3"
}

function run_container_tmp {
  _section "container tmp-path hook"

  # claude/ is gitignored: an absent hook is a skip.
  if [[ ! -f "${SCRIPT_DIR}/claude/hooks/container-tmp-hook" ]]; then
    _skip "claude/hooks/container-tmp-hook absent — claude/ not yet synced to this machine"
    return 0
  fi

  if ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
    return
  fi

  # Tmp-rooted build context → DENY.
  _container_tmp_expect DENY 'container build -t x /tmp/ctx'
  _container_tmp_expect DENY 'container build -t x /private/tmp/claude-501/s/scratchpad'
  _container_tmp_expect DENY 'container build -f /var/folders/ab/x/Dockerfile .'
  # Implicit context resolved against a tmp cwd → DENY.
  _container_tmp_expect DENY 'container build -t x .' /private/tmp/claude-501/s \
    'container build . (cwd in scratchpad)'
  _container_tmp_expect DENY 'container build -t x .' /tmp \
    'container build . (cwd /tmp)'
  # cd into tmp inside a compound command → DENY.
  _container_tmp_expect DENY 'cd /tmp/ctx && container build .'
  # Tmp-rooted bind-mount sources → DENY.
  _container_tmp_expect DENY 'container run -v /tmp/data:/data img'
  _container_tmp_expect DENY 'container run --volume=/private/tmp/x:/x img'
  _container_tmp_expect DENY 'container run --mount type=bind,source=/var/folders/ab/x,target=/y img'
  _container_tmp_expect DENY 'container create -v /tmp/d:/d img'

  # $HOME paths, guest paths, docker, lookalikes → PASS.
  _container_tmp_expect PASS 'container build -t x .' "${HOME}/Dev/x" \
    "container build . (cwd under \$HOME)"
  _container_tmp_expect PASS "container build -t x ${HOME}/proj/ctx"
  _container_tmp_expect PASS "container run -v ${HOME}/data:/data img"
  _container_tmp_expect PASS 'container run img cat /tmp/foo'   # guest path, no mount
  _container_tmp_expect PASS 'container run img ls /var/folders'
  _container_tmp_expect PASS 'docker run -v /tmp/x:/x img'      # Docker shares /tmp fine
  _container_tmp_expect PASS 'container ls -a'
  _container_tmp_expect PASS 'container system start'
  _container_tmp_expect PASS 'echo container build /tmp/x'      # not a command position
  _container_tmp_expect PASS 'container run -v /tmpfoo:/x img'  # /tmpfoo is not tmp-rooted

  # The skip token is only text now: the command is checked as usual.
  _container_tmp_expect DENY 'CONTAINER_TMP_SKIP=1 container build -t x /tmp/ctx' '' \
    'CONTAINER_TMP_SKIP=1 is no override'
  _container_tmp_expect DENY 'export CONTAINER_TMP_SKIP=1; container build -t x /tmp/ctx' '' \
    'exported CONTAINER_TMP_SKIP=1 is no override'

  # Wrappers before the container word are walked past → DENY.
  _container_tmp_expect DENY 'sudo container build /tmp/x'
  _container_tmp_expect DENY 'sudo -u root container build /tmp/x'
  _container_tmp_expect DENY 'sudo -Eu root container build /tmp/x'
  _container_tmp_expect DENY 'doas container build /tmp/x'
  _container_tmp_expect DENY 'env FOO=1 container build /tmp/x'
  _container_tmp_expect DENY 'env -i -u FOO FOO=1 /usr/local/bin/container build /tmp/x'
  _container_tmp_expect DENY 'nice -n 5 container build /tmp/x'
  _container_tmp_expect DENY 'nice -5 container build /tmp/x'
  _container_tmp_expect DENY 'nohup container build /tmp/x'
  _container_tmp_expect DENY 'command container build /tmp/x'
  _container_tmp_expect DENY 'exec container build /tmp/x'
  _container_tmp_expect DENY 'time container build /tmp/x'
  _container_tmp_expect DENY 'timeout 30 container build /tmp/x'
  _container_tmp_expect DENY 'timeout -k 5 30 container build /tmp/x'
  _container_tmp_expect DENY 'gtimeout --signal TERM 30 container build /tmp/x'
  _container_tmp_expect DENY 'caffeinate -i container build /tmp/x'
  _container_tmp_expect DENY 'arch -arm64 container build /tmp/x'
  _container_tmp_expect DENY 'chronic container build /tmp/x'
  _container_tmp_expect DENY 'ionice -c 3 container build /tmp/x'
  _container_tmp_expect DENY 'watch -n 5 container build /tmp/x'
  _container_tmp_expect DENY 'stdbuf -oL container build /tmp/x'
  _container_tmp_expect DENY 'sudo nice nohup env A=1 timeout 5 container build /tmp/x' '' \
    'stacked wrappers'
  _container_tmp_expect DENY 'sudo container run -v /tmp/d:/d img'
  _container_tmp_expect DENY 'cd /tmp/ctx && sudo container build .' '' \
    'cd then a wrapped container build'

  # sh -c / bash -c / zsh -c strings are re-scanned, up to depth 3 → DENY.
  _container_tmp_expect DENY 'sh -c "container build /tmp/x"'
  _container_tmp_expect DENY "bash -c 'container build /tmp/x'"
  _container_tmp_expect DENY 'zsh -lc "cd /tmp && container build ."'
  _container_tmp_expect DENY 'sudo bash -c "container run -v /tmp/d:/d img"'
  _container_tmp_expect DENY "sh -c 'echo hi; container build /tmp/x'"
  _container_tmp_expect DENY "env -S 'container build /tmp/x'"
  _container_tmp_expect DENY "sh -c \"sh -c 'bash -c \\\"container build /tmp/x\\\"'\"" '' \
    'sh -c nested to depth 3'

  # Wrappers and shell strings that hold no tmp-rooted container call → PASS.
  _container_tmp_expect PASS 'sudo container ls'
  _container_tmp_expect PASS "sudo container build ${HOME}/x"
  _container_tmp_expect PASS 'sh -c "container ls"'
  _container_tmp_expect PASS 'sh -c "echo container build /tmp/x"'
  _container_tmp_expect PASS 'nice echo container build /tmp/x'
  _container_tmp_expect PASS 'echo "container build /tmp/x; ls"' '' \
    'quoted text holding ; is one segment'
  _container_tmp_expect PASS 'sudo env FOO=1 docker build /tmp/x'
  _container_tmp_expect PASS 'timeout 5 container run img ls /tmp'
  _container_tmp_expect PASS 'sh -c "container build ." ; cd /tmp' '' \
    'cd after the sh -c does not change its cwd'
  _container_tmp_expect PASS 'env cd /tmp && container build .' "${HOME}/Dev/x" \
    'a wrapped cd changes no cwd'
  # Declared gap: a string nested deeper than 3 levels is not scanned.
  _container_tmp_expect PASS "sh -c \"sh -c 'sh -c \\\"sh -c \\\\\\\"container build /tmp/x\\\\\\\"\\\"'\"" '' \
    'sh -c nested to depth 4 (declared gap)'

  # The deny reason names the fix (move under $HOME).
  _hook_run_seam "${SCRIPT_DIR}/claude/hooks/container-tmp-hook" Bash 'container build /tmp/ctx'
  if [[ "${HOOK_SEAM_VERDICT}" == DENY && "${HOOK_SEAM_REASON}" == *HOME* ]]; then
    _pass "deny reason names \$HOME fix"
  else
    _fail "deny reason does not mention \$HOME (${HOOK_SEAM_VERDICT}: ${HOOK_SEAM_OUT:0:120})"
  fi

  # Dispatcher seam: the command and cwd come from HOOK_PRE_COMMAND and
  # HOOK_PRE_CWD, and a deny is the bare line DENY<US>reason, not JSON.
  local us=$'\x1f' benign deny_payload seam
  _hook_run_seam "${SCRIPT_DIR}/claude/hooks/container-tmp-hook" Bash \
    'container build -t x /tmp/ctx' '' '' /work
  if [[ "${HOOK_SEAM_VERDICT}" == DENY && "${HOOK_SEAM_OUT}" == "DENY${us}"*'is under a tmp dir'* \
        && "${HOOK_SEAM_OUT}" != *hookSpecificOutput* ]]; then
    _pass "dispatcher seam: tmp build context prints a DENY line from HOOK_PRE_COMMAND"
  else
    _fail "dispatcher seam: expected a DENY line, got: ${HOOK_SEAM_OUT:0:200}"
  fi
  _hook_run_seam "${SCRIPT_DIR}/claude/hooks/container-tmp-hook" Bash \
    'container build -t x .' '' '' /private/tmp/s
  if [[ "${HOOK_SEAM_VERDICT}" == DENY && "${HOOK_SEAM_OUT}" == "DENY${us}"*'is under a tmp dir'* ]]; then
    _pass "dispatcher seam: implicit context resolves against HOOK_PRE_CWD"
  else
    _fail "dispatcher seam: tmp cwd was not denied, got: ${HOOK_SEAM_OUT:0:200}"
  fi

  # Process path, kept standalone: the verdict through stdin JSON and jq.
  _container_tmp_expect_standalone DENY 'container build -t x /tmp/ctx'
  _container_tmp_expect_standalone DENY 'container build -t x .' /private/tmp/claude-501/s \
    'container build . (cwd in scratchpad)'
  _container_tmp_expect_standalone DENY 'container run -v /tmp/data:/data img'
  _container_tmp_expect_standalone DENY 'sudo bash -c "container run -v /tmp/d:/d img"'
  _container_tmp_expect_standalone PASS 'container build -t x .' "${HOME}/Dev/x" \
    "container build . (cwd under \$HOME)"
  _container_tmp_expect_standalone PASS 'container ls -a'
  _container_tmp_expect_standalone PASS 'docker run -v /tmp/x:/x img'
  _container_tmp_expect_standalone PASS 'echo container build /tmp/x'

  # The deny reason as the JSON carries it.
  if [[ "$(_container_tmp_run 'container build /tmp/ctx')" == *HOME* ]]; then
    _pass "deny reason names \$HOME fix (standalone JSON)"
  else
    _fail "deny reason does not mention \$HOME (standalone JSON)"
  fi

  # Malformed JSON and an empty payload fail open without a deny.
  seam="$(/bin/zsh "${SCRIPT_DIR}/claude/hooks/container-tmp-hook" <<< '{not json' 2>/dev/null)" || :
  if [[ "$(_hook_verdict "${seam}")" != DENY ]]; then
    _pass "standalone: malformed JSON fails open"
  else
    _fail "standalone: malformed JSON was denied: ${seam:0:200}"
  fi
  seam="$(/bin/zsh "${SCRIPT_DIR}/claude/hooks/container-tmp-hook" <<< '' 2>/dev/null)" || :
  if [[ -z "${seam}" ]]; then
    _pass "standalone: empty payload passes silently"
  else
    _fail "standalone: empty payload printed: ${seam:0:200}"
  fi

  # An exported HOOK_PRE_DISPATCH=1 must not skip the standalone hook: it has
  # no ":file" in ZSH_EVAL_CONTEXT, so the stdin payload still decides.
  benign="$(jq -n '{tool_name:"Bash", tool_input:{command:"container build /tmp/ctx"}, cwd:"/work"}')"
  seam="$(HOOK_PRE_DISPATCH=1 HOOK_PRE_COMMAND='container ls' /bin/zsh \
    "${SCRIPT_DIR}/claude/hooks/container-tmp-hook" <<< "${benign}")" || :
  if [[ "$(_hook_verdict "${seam}")" == DENY ]]; then
    _pass "standalone: exported HOOK_PRE_DISPATCH=1 is no override"
  else
    _fail "standalone: exported HOOK_PRE_DISPATCH=1 skipped the hook: ${seam:0:200}"
  fi

  # Stdin is not read under the seam: a deny payload on stdin, a clean
  # HOOK_PRE_COMMAND, and the guard stays silent.
  deny_payload="${benign}"
  benign="$(jq -n '{tool_name:"Bash", tool_input:{command:"container ls"}, cwd:"/work"}')"
  seam="$(_container_tmp_seam 'container ls' /work "${deny_payload}")"
  if [[ -z "${seam}" ]]; then
    _pass "dispatcher seam: a clean HOOK_PRE_COMMAND passes and stdin is ignored"
  else
    _fail "dispatcher seam: expected no output, got: ${seam:0:200}"
  fi
}
