#!/bin/zsh
# dotfiles/tests/container-tmp
#
# Behavioural test for claude/hooks/container-tmp-hook — the PreToolUse hook that
# denies Apple `container` builds/mounts rooted in tmp paths (home-scoped file
# sharing silently shares them as empty).
# Feeds commands plus a cwd as stdin JSON; asserts DENY for tmp-rooted build
# contexts/cwds and -v/--mount sources, PASS for $HOME paths, guest paths,
# docker commands and lookalikes.
#
# Run: ./test container-tmp
# ShellCheck: lint with `shellcheck --shell=bash tests/container-tmp`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

function _container_tmp_run {
  # $1 = command, $2 = cwd (default $HOME).
  jq -n --arg c "$1" --arg d "${2:-${HOME}}" \
    '{tool_name:"Bash", tool_input:{command:$c}, cwd:$d}' \
    | /bin/zsh "${SCRIPT_DIR}/claude/hooks/container-tmp-hook"
}

function _container_tmp_expect {
  local want="$1" cmd="$2" cwd="${3:-}" label="${4:-$2}" out got
  out="$(_container_tmp_run "${cmd}" "${cwd}")"
  got="$(_hook_verdict "${out}")"
  if [[ "${got}" == "${want}" ]]; then
    _pass "${want}: ${label}"
  else
    _fail "${label} — expected ${want}, got ${got}"
  fi
}

function _container_tmp_seam {
  # $1 = command, $2 = cwd, $3 = stdin text. Sources the guard the way
  # pretool-dispatch does: HOOK_PRE_* plain variables inside a function, so the
  # guard sees ":file" in ZSH_EVAL_CONTEXT. Echoes the guard's stdout.
  /bin/zsh -c '
    function _drive {
      HOOK_PRE_DISPATCH=1
      HOOK_PRE_COMMAND="$1"
      HOOK_PRE_CWD="$2"
      local guard="$3"
      set --
      source "${guard}"
    }
    _drive "$@"' _ "$1" "$2" "${SCRIPT_DIR}/claude/hooks/container-tmp-hook" <<< "$3"
}

function run_container_tmp {
  _section "container tmp-path hook"

  # claude/ is gitignored: an absent hook is a skip.
  if [[ ! -f "${SCRIPT_DIR}/claude/hooks/container-tmp-hook" ]]; then
    _skip "claude/hooks/container-tmp-hook absent — claude/ not yet synced to this machine"
    return 0
  fi

  if ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
    return
  fi

  # Tmp-rooted build context → DENY.
  _container_tmp_expect DENY 'container build -t x /tmp/ctx'
  _container_tmp_expect DENY 'container build -t x /private/tmp/claude-501/s/scratchpad'
  _container_tmp_expect DENY 'container build -f /var/folders/ab/x/Dockerfile .'
  # Implicit context resolved against a tmp cwd → DENY.
  _container_tmp_expect DENY 'container build -t x .' /private/tmp/claude-501/s \
    'container build . (cwd in scratchpad)'
  _container_tmp_expect DENY 'container build -t x .' /tmp \
    'container build . (cwd /tmp)'
  # cd into tmp inside a compound command → DENY.
  _container_tmp_expect DENY 'cd /tmp/ctx && container build .'
  # Tmp-rooted bind-mount sources → DENY.
  _container_tmp_expect DENY 'container run -v /tmp/data:/data img'
  _container_tmp_expect DENY 'container run --volume=/private/tmp/x:/x img'
  _container_tmp_expect DENY 'container run --mount type=bind,source=/var/folders/ab/x,target=/y img'
  _container_tmp_expect DENY 'container create -v /tmp/d:/d img'

  # $HOME paths, guest paths, docker, lookalikes → PASS.
  _container_tmp_expect PASS 'container build -t x .' "${HOME}/Dev/x" \
    "container build . (cwd under \$HOME)"
  _container_tmp_expect PASS "container build -t x ${HOME}/proj/ctx"
  _container_tmp_expect PASS "container run -v ${HOME}/data:/data img"
  _container_tmp_expect PASS 'container run img cat /tmp/foo'   # guest path, no mount
  _container_tmp_expect PASS 'container run img ls /var/folders'
  _container_tmp_expect PASS 'docker run -v /tmp/x:/x img'      # Docker shares /tmp fine
  _container_tmp_expect PASS 'container ls -a'
  _container_tmp_expect PASS 'container system start'
  _container_tmp_expect PASS 'echo container build /tmp/x'      # not a command position
  _container_tmp_expect PASS 'container run -v /tmpfoo:/x img'  # /tmpfoo is not tmp-rooted
  _container_tmp_expect PASS 'CONTAINER_TMP_SKIP=1 container build -t x /tmp/ctx' '' \
    'CONTAINER_TMP_SKIP=1 override'

  # The deny reason names the fix (move under $HOME).
  if [[ "$(_container_tmp_run 'container build /tmp/ctx')" == *HOME* ]]; then
    _pass "deny reason names \$HOME fix"
  else
    _fail "deny reason does not mention \$HOME"
  fi

  # Dispatcher seam: the command and cwd come from HOOK_PRE_COMMAND and
  # HOOK_PRE_CWD (stdin carries a different payload and is not read), and a
  # deny is the bare line DENY<US>reason, not JSON.
  local us=$'\x1f' benign deny_payload seam
  benign="$(jq -n '{tool_name:"Bash", tool_input:{command:"container ls"}, cwd:"/work"}')"
  deny_payload="$(jq -n '{tool_name:"Bash", tool_input:{command:"container build /tmp/ctx"}, cwd:"/work"}')"
  seam="$(_container_tmp_seam 'container build -t x /tmp/ctx' /work "${benign}")"
  if [[ "${seam}" == "DENY${us}"*'is under a tmp dir'* && "${seam}" != *hookSpecificOutput* ]]; then
    _pass "dispatcher seam: tmp build context prints a DENY line from HOOK_PRE_COMMAND"
  else
    _fail "dispatcher seam: expected a DENY line, got: ${seam:0:200}"
  fi
  seam="$(_container_tmp_seam 'container build -t x .' /private/tmp/s "${benign}")"
  if [[ "${seam}" == "DENY${us}"*'is under a tmp dir'* ]]; then
    _pass "dispatcher seam: implicit context resolves against HOOK_PRE_CWD"
  else
    _fail "dispatcher seam: tmp cwd was not denied, got: ${seam:0:200}"
  fi
  seam="$(_container_tmp_seam 'container ls' /work "${deny_payload}")"
  if [[ -z "${seam}" ]]; then
    _pass "dispatcher seam: a clean HOOK_PRE_COMMAND passes and stdin is ignored"
  else
    _fail "dispatcher seam: expected no output, got: ${seam:0:200}"
  fi
}
