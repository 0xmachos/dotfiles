#!/bin/zsh
# dotfiles/tests/container-tmp
#
# Behavioural test for claude/hooks/container-tmp-hook, the PreToolUse hook that
# denies Apple `container` builds/mounts rooted in tmp paths (home-scoped file
# sharing silently shares them as empty). One input per case. Covers: DENY for
# a tmp-rooted build context (with the deny reason that names the $HOME fix)
# and for a bind-mount source; DENY through a wrapper and a nested shell
# string (2026-10-09); no override (the old skip token is only text); PASS for
# a guest path that is not a mount (the false-positive guard); and fail-open
# on malformed JSON.
#
# Run: ./test container-tmp
# ShellCheck: lint with `shellcheck --shell=bash tests/container-tmp`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

# Seam run: the guard sourced the dispatcher's way. $1 = want, $2 = command.
function _container_tmp_expect {
  local want="$1" cmd="$2" label="${3:-$2}"
  _hook_run_seam "${SCRIPT_DIR}/claude/hooks/container-tmp-hook" Bash "${cmd}"
  if [[ "${HOOK_SEAM_VERDICT}" == "${want}" ]]; then
    _pass "${want}: ${label}"
  else
    _fail "${label} — expected ${want}, got ${HOOK_SEAM_VERDICT} (${HOOK_SEAM_OUT:0:120})"
  fi
}

function run_container_tmp {
  _section "container tmp-path hook"

  # claude/ is gitignored: an absent hook is a skip.
  if [[ ! -f "${SCRIPT_DIR}/claude/hooks/container-tmp-hook" ]]; then
    _skip "claude/hooks/container-tmp-hook absent — claude/ not yet synced to this machine"
    return 0
  fi

  if ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
    return
  fi

  local out

  # 1. A tmp-rooted build context denies, and the reason names the $HOME fix.
  _hook_run_seam "${SCRIPT_DIR}/claude/hooks/container-tmp-hook" Bash 'container build -t x /tmp/ctx'
  if [[ "${HOOK_SEAM_VERDICT}" == DENY && "${HOOK_SEAM_REASON}" == *'is under a tmp dir'* \
     && "${HOOK_SEAM_REASON}" == *HOME* ]]; then
    _pass "DENY: tmp build context, reason names the \$HOME fix"
  else
    _fail "tmp build context: ${HOOK_SEAM_VERDICT} ${HOOK_SEAM_OUT:0:120}"
  fi

  # 2. A tmp-rooted bind-mount source denies.
  _container_tmp_expect DENY 'container run -v /tmp/data:/data img'

  # 3. A wrapper and a nested shell string are walked (2026-10-09).
  _container_tmp_expect DENY 'sudo bash -c "container build /tmp/x"' 'wrapper plus a shell string'

  # 4. No override: the old skip token is only text.
  _container_tmp_expect DENY 'CONTAINER_TMP_SKIP=1 container build -t x /tmp/ctx' 'CONTAINER_TMP_SKIP=1 is no override'

  # 5. A guest path is not a bind mount.
  _container_tmp_expect PASS 'container run img cat /tmp/foo' 'guest path, no mount'

  # 6. Fail-open: malformed JSON on stdin never denies.
  out="$(/bin/zsh "${SCRIPT_DIR}/claude/hooks/container-tmp-hook" <<< '{not json' 2>/dev/null)" || :
  if [[ "$(_hook_verdict "${out}")" != DENY ]]; then
    _pass "fail-open: malformed JSON is not denied"
  else
    _fail "fail-open: malformed JSON was denied: ${out:0:200}"
  fi
}
