#!/bin/zsh
# dotfiles/tests/rm-redirect
#
# Behavioural test for claude/hooks/rm-redirect-hook (PreToolUse): feeds commands
# to the hook as stdin JSON and asserts the verdict. Rationale for each
# class is in that hook's own header.
#
# Contract (2026-09-25): plain rm/unlink/shred/gshred at ANY command position
# PASSES (the shell alias already trashes it). DENY is only the forms that
# skip the alias: a quoted or escaped rm-family word; a wrapper that execs
# its target directly; find/gfind/fd/fdfind with an rm-family target; a bare
# rm-family word in a heredoc body fed to a shell not reached through
# sudo/doas; `git clean -f`/`--force` without `-n`/`--dry-run`.
#
# Run: ./test rm-redirect
# ShellCheck: lint with `shellcheck --shell=bash tests/rm-redirect`.
# This file is sourced, not executed — chmod 644.
#
# SC2016: fixtures are literal strings handed to jq --arg; `$d`/`$f`/`$SHELL`
# must stay unexpanded, as a Bash tool call would carry them.
# shellcheck disable=SC2016
#
# shellcheck source=tests/lib

function _rm_redirect_run {
  # Echo the hook's stdout for Bash command $1.
  jq -n --arg c "$1" '{tool_name:"Bash", tool_input:{command:$c}}' \
    | /bin/zsh "${SCRIPT_DIR}/claude/hooks/rm-redirect-hook"
}

function _rm_redirect_expect {
  # Optional $4/$5: a fragment the hook output must contain and the label for
  # that second check, made on the same hook run. Optional $6: how many runs to
  # allow before a wrong verdict counts (default 1; the hook's 0.3 s deadline
  # fails open under load, so a near-cap DENY gets retries).
  local want="$1" cmd="$2" label="${3:-$2}" frag="${4:-}" fraglabel="${5:-}" tries="${6:-1}" out got
  local -i rc t
  for (( t = 1; t <= tries; t++ )); do
    rc=0
    out="$(_rm_redirect_run "${cmd}")" || rc=$?
    got="$(_hook_verdict "${out}")" || got=INVALID
    [[ "${got}" == "${want}" ]] && break
  done
  if [[ "${got}" == "${want}" ]]; then
    _pass "${want}: ${label}"
  else
    _fail "${label} — expected ${want}, got ${got}"
  fi
  # The hook exits 0 for every verdict; a nonzero status is recorded, not fatal.
  (( rc == 0 )) || _fail "${label} — hook exited ${rc}"
  [[ -n "${frag}" ]] || return 0
  if [[ "${out}" == *"${frag}"* ]]; then
    _pass "${fraglabel}"
  else
    _fail "${fraglabel} — output lacks: ${frag}"
  fi
}

function _rm_redirect_lines_command {
  # REPLY = a command of $1 lines: `\rm x` first, then one-character lines.
  local -a rm_redirect_lines=('\rm x')
  local -i k
  for (( k = 1; k < $1; k++ )); do rm_redirect_lines+=(a); done
  # shellcheck disable=SC2296
  REPLY="${(F)rm_redirect_lines}"
}

function _rm_redirect_bytes_command {
  # REPLY = a command of exactly $1 characters: `\rm x` first, then 8000-
  # character lines (under the per-line cap) cut to length. The last character
  # is not a newline, which `$(...)` would strip.
  # shellcheck disable=SC2034
  local rm_redirect_none='' rm_redirect_filler
  # shellcheck disable=SC2296
  rm_redirect_filler="${(l:8000::a:)rm_redirect_none}"
  local -a rm_redirect_lines=('\rm x')
  local -i k
  for (( k = 1; k <= 66; k++ )); do rm_redirect_lines+=("${rm_redirect_filler}"); done
  # shellcheck disable=SC2296
  local rm_redirect_all="${(F)rm_redirect_lines}"
  REPLY="${rm_redirect_all[1,$1-1]}a"
}

function _rm_redirect_calls_command {
  # REPLY = a command whose `\rm x` is tokeniser call number $1 + 1: $1 lines of
  # `echo 'rm'` (each quoted, so each takes the tokeniser) ahead of it.
  local -a rm_redirect_call_lines
  local -i k
  for (( k = 1; k <= $1; k++ )); do rm_redirect_call_lines+=("echo 'rm'"); done
  rm_redirect_call_lines+=('\rm x')
  # shellcheck disable=SC2296
  REPLY="${(F)rm_redirect_call_lines}"
}

function _rm_redirect_make_copy {
  # Copy the hook to $1/hook with ONE literal changed: $2 becomes $3. Returns 1
  # (and says why) when the copy is unchanged or lacks the new literal, so a
  # drifted pattern cannot give a green case. The hook reads no file relative
  # to its own path, so the copy runs the same as the original.
  local dir="$1" old="$2" new="$3" body changed
  body="$(<"${SCRIPT_DIR}/claude/hooks/rm-redirect-hook")" || body=''
  changed="${body/"${old}"/"${new}"}"
  if [[ -z "${body}" || "${changed}" == "${body}" || "${changed}" != *"${new}"* ]]; then
    _fail "hook copy: literal not found or not changed: ${old}"
    return 1
  fi
  print -r -- "${changed}" > "${dir}/hook"
}

function _rm_redirect_run_copy {
  # Echo the stdout of the hook copy $1/hook for Bash command $2.
  jq -n --arg c "$2" '{tool_name:"Bash", tool_input:{command:$c}}' | /bin/zsh "$1/hook"
}

function _rm_redirect_copy_expect {
  # Run hook copy $1/hook on command $3 and assert verdict $2, labelled $4.
  local out got
  out="$(_rm_redirect_run_copy "$1" "$3")" || out=''
  got="$(_hook_verdict "${out}")" || got=INVALID
  if [[ "${got}" == "$2" ]]; then
    _pass "$2: $4"
  else
    _fail "$4 - expected $2, got ${got}"
  fi
}

function run_rm_redirect {
  _section "rm → trash redirect hook"

  # claude/ is gitignored and synced out of band: an absent hook skips.
  if [[ ! -f "${SCRIPT_DIR}/claude/hooks/rm-redirect-hook" ]]; then
    _skip "claude/hooks/rm-redirect-hook absent — claude/ not yet synced to this machine"
    return 0
  fi

  if ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
    return
  fi

  # Bare rm-family word at any command position → PASS (the alias handles it;
  # a deny would only add a permission round-trip).
  _rm_redirect_expect PASS 'rm -rf foo'
  _rm_redirect_expect PASS 'rm foo.txt'
  _rm_redirect_expect PASS 'rm -rf ~/Documents/x/.ruff_cache'
  _rm_redirect_expect PASS 'a && rm b'
  _rm_redirect_expect PASS 'a; rm b'
  _rm_redirect_expect PASS '(rm foo)'
  _rm_redirect_expect PASS $'rm -rf a\nls' 'rm -rf a<NL>ls (multiline)'
  _rm_redirect_expect PASS 'time rm foo.txt'          # guards against over-including `time` as a bypass wrapper
  _rm_redirect_expect PASS 'unlink foo'
  _rm_redirect_expect PASS 'shred foo'
  _rm_redirect_expect PASS 'gshred foo'

  # 2026-09-25: a re-declared `local segment match` in the per-line loop
  # leaks the previous line's values to stdout on the SECOND qualifying line,
  # which _hook_verdict reads as INVALID, not PASS.
  _rm_redirect_expect PASS $'rm -rf a\nrm -rf b' 'two qualifying lines, both PASS'

  # Escape hatches and non-rm command words → PASS, unchanged.
  _rm_redirect_expect PASS '/bin/rm foo'
  _rm_redirect_expect PASS 'sudo rm -rf /Library/x'
  _rm_redirect_expect PASS 'sudo find /tmp -delete'    # sudo escapes by design, same as sudo rm
  _rm_redirect_expect PASS 'git rm foo'
  _rm_redirect_expect PASS 'docker rm c1'
  _rm_redirect_expect PASS 'npm rm pkg'
  _rm_redirect_expect PASS 'echo rm'
  _rm_redirect_expect PASS 'cd /tmp/rm-stuff && ls'
  _rm_redirect_expect PASS 'trash foo'
  _rm_redirect_expect PASS 'builtin rm foo'            # rm is not a zsh builtin — inert
  _rm_redirect_expect PASS 'find . -exec mv {} /tmp \;'      # non-rm -exec target
  _rm_redirect_expect PASS 'find . -exec /bin/rm {} +'       # explicit-path escape, same as top-level /bin/rm
  _rm_redirect_expect PASS $'cat <<EOF > script.sh\nrm foo\nEOF' 'heredoc writing rm into a file it does not execute'

  # sudo/doas escape EVERY class, not just top-level rm (hook header, "sudo/doas
  # are a documented, deliberate, blanket escape").
  _rm_redirect_expect PASS 'sudo git clean -fdx'                       'sudo escapes git clean too'
  _rm_redirect_expect PASS $'sudo bash <<EOF\nrm foo\nEOF'             'sudo escapes a heredoc-to-shell body too'
  _rm_redirect_expect PASS $'sudo -s <<EOF\nrm foo\nEOF'               'bare sudo -s heredoc: sudo itself is the consumer'

  # A path-qualified rm-family word (2026-09-25) is the escape EVERYWHERE:
  # after a BYPASS wrapper, xargs, or in a shell heredoc body.
  _rm_redirect_expect PASS 'xargs -0 /bin/rm'                          'xargs with the /bin/rm escape'
  _rm_redirect_expect PASS 'command /bin/rm foo'                       'command with the /bin/rm escape'
  _rm_redirect_expect PASS $'bash <<EOF\n/bin/rm foo\nEOF'             'heredoc body: the /bin/rm escape applies there too'

  # command -v/-V is a lookup, not an invocation — never execs anything.
  _rm_redirect_expect PASS 'command -v rm'
  _rm_redirect_expect PASS 'command -V gshred'

  # A path-qualified word skips alias lookup, so quoting or escaping it
  # changes nothing.
  _rm_redirect_expect PASS '"/bin/rm" foo'              'quoted absolute path'
  _rm_redirect_expect PASS '\/bin/rm foo'               'escaped absolute path'

  # fd/fdfind -x/-X/--exec/--exec-batch, PASS side: non-rm target and the
  # /bin/-qualified escape.
  _rm_redirect_expect PASS 'fd -e tmp -x mv {} /tmp'    'fd -x with a non-rm target'
  _rm_redirect_expect PASS 'fd -x /bin/rm'              'fd -x with the /bin/rm escape'

  # env -S is NOT a declared gap (2026-09-25): it splits its string argument
  # and execs the result, the same BYPASS class as `env rm f`, so it DENIES.
  _rm_redirect_expect DENY 'env -S "rm f"'
  _rm_redirect_expect DENY "env -S 'FOO=1 rm f'"        'env -S with a leading VAR= inside the string'
  _rm_redirect_expect PASS 'env -S "python3 x"'         'env -S with a non-rm-family string'

  # Declared gap (hook header, "Declared gaps"): tested, not silently skipped.
  _rm_redirect_expect PASS 'unalias rm; rm -rf x'       'declared gap: alias redefinition is not tracked'

  # The {}-tokeniser fix cuts both ways: `{ cmd; }` still isolates its content.
  _rm_redirect_expect PASS '{ rm foo; }'                'brace group: bare rm inside still PASSes'

  # A heredoc fed to a non-shell consumer stays data, decorated form or not.
  _rm_redirect_expect PASS $'python3 - <<EOF\n\\rm x\nEOF' 'non-shell heredoc consumer: decorated rm inside is still data'

  # Decorated (quoted/escaped) rm-family word → DENY: it suppresses alias
  # lookup. Explicit labels: _pass/_fail print via zsh's builtin echo, which
  # interprets a leading \r/\u (cosmetic only).
  # The deny message must name the replacement tool (decorated form: bare rm
  # PASSes).
  _rm_redirect_expect DENY '\rm foo.txt' 'backslash-escaped rm' \
    trash 'deny reason names trash'
  _rm_redirect_expect DENY '"rm" foo.txt'
  _rm_redirect_expect DENY "'rm' foo.txt"
  _rm_redirect_expect DENY '\unlink foo.txt' 'backslash-escaped unlink'
  _rm_redirect_expect DENY '"shred" foo.txt'
  _rm_redirect_expect DENY "\$'rm' foo.txt" 'ANSI-C quoted rm'

  # `$'` inside a DOUBLE-quoted string is two literal characters, not ANSI-C
  # quoting (2026-09-25): zsh prints `echo "cost: $'"` verbatim, and a later
  # `\rm` on the line is unaffected.
  _rm_redirect_expect DENY $'echo "cost: $\x27"; \\rm foo' 'unbalanced ANSI-C marker inside a double-quoted string'

  # The whole-command pre-filter matches a STRIPPED copy (2026-09-25): a
  # mid-word decoration splits the letters in the raw text, so a raw-only
  # check would exit early and PASS a real bypass.
  _rm_redirect_expect DENY 'r"m" foo'  'mid-word quote decoration reaches the pre-filter'
  _rm_redirect_expect DENY 'r\m foo'   'mid-word backslash decoration reaches the pre-filter'

  # The per-line length cap runs BEFORE the per-line quote/escape strip
  # (2026-09-25): an oversized line must not burn time ahead of a later short
  # line carrying the decorated form.
  # shellcheck disable=SC2034
  local rm_redirect_empty='' rm_redirect_oversized_probe
  # shellcheck disable=SC2296
  rm_redirect_oversized_probe="echo \"${(l:72000::w:)rm_redirect_empty}\""$'\n''\rm x'
  _rm_redirect_expect DENY "${rm_redirect_oversized_probe}" 'an oversized quoted line must not shadow a later short DENY'

  # The byte budget counts MATCHING lines only (2026-09-25): non-matching lines
  # ahead of a short real match must not exhaust it. The filler word holds no
  # "rm", "unlink", "shred", "find" or "clean" substring. 34 lines of 8005
  # characters (under RM_LINE_CAP) total 272170, past the 262144 budget, in few
  # enough lines to finish well inside the hook's 0.3 s deadline.
  # shellcheck disable=SC2034
  local -a rm_redirect_budget_lines
  local -i rm_redirect_bi
  for (( rm_redirect_bi = 1; rm_redirect_bi <= 34; rm_redirect_bi++ )); do
    # shellcheck disable=SC2296
    rm_redirect_budget_lines+=("echo ${(l:8000::z:)rm_redirect_empty}")
  done
  local rm_redirect_budget_probe
  # shellcheck disable=SC2296
  rm_redirect_budget_probe="${(F)rm_redirect_budget_lines}"$'\n''\rm x'
  _rm_redirect_expect DENY "${rm_redirect_budget_probe}" 'non-matching lines ahead of a match must not exhaust the budget'

  # Fail-open size caps (hook header, "Fail-open by convention"): 4000 raw
  # lines and 524288 characters. At the cap the command is scanned and DENIEs;
  # one past it PASSes without a scan. The just-under cases get 3 runs, since
  # the 0.3 s deadline also fails open under load.
  _rm_redirect_lines_command 4000
  _rm_redirect_expect DENY "${REPLY}" '4000 lines, at the line cap, still scanned' '' '' 3
  _rm_redirect_lines_command 4001
  _rm_redirect_expect PASS "${REPLY}" '4001 lines, past the line cap, fails open'
  _rm_redirect_bytes_command 524288
  _rm_redirect_expect DENY "${REPLY}" '524288 characters, at the byte cap, still scanned' '' '' 3
  _rm_redirect_bytes_command 524289
  _rm_redirect_expect PASS "${REPLY}" '524289 characters, past the byte cap, fails open'

  # Hook copies with one literal changed reach the branches the real deadline
  # hides. A deadline already in the past fails open at once. A deadline pushed
  # out to 600 s leaves the 700-call tokeniser cap (a backstop for a missing
  # zsh/datetime) as the only limit: call 700 is scanned, call 701 fails open.
  local rm_redirect_copy_dir
  rm_redirect_copy_dir="$(mktemp -d "${TMPDIR:-/tmp}/rm-redirect-copy.XXXXXX")"
  if _rm_redirect_make_copy "${rm_redirect_copy_dir}" 'EPOCHREALTIME + 0.3' 'EPOCHREALTIME - 600'; then
    _rm_redirect_copy_expect "${rm_redirect_copy_dir}" PASS '\rm foo' 'deadline already passed: a command that DENYs fails open'
  fi
  if _rm_redirect_make_copy "${rm_redirect_copy_dir}" 'EPOCHREALTIME + 0.3' 'EPOCHREALTIME + 600'; then
    _rm_redirect_calls_command 699
    _rm_redirect_copy_expect "${rm_redirect_copy_dir}" DENY "${REPLY}" 'tokeniser call 700, at the cap, still scanned'
    _rm_redirect_calls_command 700
    _rm_redirect_copy_expect "${rm_redirect_copy_dir}" PASS "${REPLY}" 'tokeniser call 701, past the cap, fails open'
  fi
  /bin/rm -rf "${rm_redirect_copy_dir}"

  # TWO heredoc introducers on a line (2026-09-25) run the per-heredoc block
  # of _rm_redirect_scan_heredocs (`hdch`, `hconsumer_raw`) twice; a
  # re-declared bare local there leaks the first heredoc's values.
  _rm_redirect_expect DENY $'bash <<A; bash <<B\nrm foo\nA\nls\nB' 'two heredocs on one line, shell consumer'
  _rm_redirect_expect PASS $'cat <<A; cat <<B\nrm foo\nA\nls\nB'  'two heredocs on one line, non-shell consumer'

  # Wrapper that execs its target directly → DENY.
  _rm_redirect_expect DENY 'command rm foo'
  _rm_redirect_expect DENY 'env rm foo'
  _rm_redirect_expect DENY 'env -u FOO rm foo'         # operand-flag walk
  _rm_redirect_expect DENY 'nice rm foo'
  _rm_redirect_expect DENY 'nohup rm foo'
  # Per-class deny text (2026-09-25): each class names a rewrite that works,
  # not a generic "use plain rm".
  _rm_redirect_expect DENY 'echo foo | xargs rm' 'echo foo | xargs rm' \
    'xargs trash' 'xargs deny reason says xargs trash'
  _rm_redirect_expect DENY 'xargs -0 rm < list'
  _rm_redirect_expect DENY '( exec rm foo )'
  _rm_redirect_expect DENY 'xargs -I{} rm {}'          # {} must not fracture the segment into a bare "rm"
  _rm_redirect_expect DENY 'gtimeout 5 rm foo'
  _rm_redirect_expect DENY 'noglob rm foo'
  _rm_redirect_expect DENY '\time rm foo'              'decorated time is BYPASS, unlike bare time'
  _rm_redirect_expect DENY 'builtin command rm foo'    'builtin falls through to command'
  _rm_redirect_expect DENY 'builtin exec rm foo'       'builtin falls through to exec'
  _rm_redirect_expect DENY 'command time rm f'         'RM_WRAPPER blames command, not time' \
    'command rm' 'command time rm f blames command in the reason text'
  _rm_redirect_expect DENY 'time command rm f'         'RM_WRAPPER blames command even when time comes first' \
    'command rm' 'time command rm f blames command in the reason text'

  # find/gfind → DENY.
  _rm_redirect_expect DENY "find . -name '*.tmp' -delete" "find . -name '*.tmp' -delete" \
    '-exec trash {} +' 'find deny reason says -exec trash {} +'
  _rm_redirect_expect DENY 'find . -exec rm {} \;'
  _rm_redirect_expect DENY 'find . -exec rm {} +'
  _rm_redirect_expect DENY 'gfind . -delete'

  # fd/fdfind → DENY (2026-09-25 — same -exec-target class as find).
  _rm_redirect_expect DENY 'fd -e tmp -x rm' 'fd -e tmp -x rm' \
    '-x trash' 'fd deny reason says -x trash'
  # fd's -x and -X differ (per-match vs batched exec) and match
  # case-sensitively (2026-09-25); the reason must name the flag typed.
  _rm_redirect_expect DENY 'fd -X rm' 'fd -X rm' \
    '-X rm' 'fd -X deny reason says -X, not -x'
  _rm_redirect_expect DENY 'fd --exec rm {}'
  _rm_redirect_expect DENY 'fdfind -x gshred'

  # nocorrect/coproc/repeat (2026-09-25) are transparent prefixes, like bare
  # `time`: PASS bare, DENY when the rm-family word is decorated. `repeat`'s
  # numeric operand must not resolve as the command word.
  _rm_redirect_expect PASS 'nocorrect rm foo'
  _rm_redirect_expect PASS 'coproc rm foo'
  _rm_redirect_expect PASS 'repeat 3 rm foo'
  _rm_redirect_expect DENY 'nocorrect \rm foo'  'nocorrect before a decorated rm'
  _rm_redirect_expect DENY 'coproc \rm foo'     'coproc before a decorated rm'
  _rm_redirect_expect DENY 'repeat 3 \rm foo'   'repeat before a decorated rm, past the numeric operand'

  # git clean -f without -n → DENY; git clean -n / git rm → PASS.
  _rm_redirect_expect DENY 'git clean -fdx' 'git clean -fdx' \
    'git clean -n' 'git clean deny reason says git clean -n'
  _rm_redirect_expect DENY 'git clean --force'
  _rm_redirect_expect DENY 'git -C x clean -f'
  _rm_redirect_expect PASS 'git clean -n'
  _rm_redirect_expect PASS 'git clean -f -n'

  # A heredoc body fed to a shell has no alias → DENY even for the bare word.
  _rm_redirect_expect DENY $'bash <<EOF\nrm foo\nEOF' 'bash heredoc body: bare rm'

  # 2026-09-25: ssh, su and a $-word consumer are also shell consumers.
  _rm_redirect_expect DENY $'ssh host <<EOF\nrm foo\nEOF'        'ssh heredoc body has no alias either'
  _rm_redirect_expect DENY $'su - someone <<EOF\nrm foo\nEOF'   'su heredoc body has no alias either'
  _rm_redirect_expect DENY $'$SHELL <<EOF\nrm foo\nEOF'         'dynamic $-word consumer fails toward scanning'

  # A remote ssh command line is a declared gap (hook header, "Declared
  # gaps"): the remote alias table is invisible to the hook.
  _rm_redirect_expect PASS 'ssh host rm -rf /tmp/x'  'declared gap: a remote command line is not this shell'

  # A decorated form inside `{ cmd; }` still denies; the {}-fix only protects
  # the literal xargs -I{} shape.
  _rm_redirect_expect DENY '{ \rm foo; }'               'brace group: decorated rm inside still DENIEs'

  # Reserved words and `!` are transparent prefixes (2026-09-25); otherwise
  # "do"/"then" resolved as RM_WORD and the body was never inspected.
  _rm_redirect_expect DENY 'for d in a b; do find $d -delete; done'      'do is transparent, not the command word'
  _rm_redirect_expect DENY 'for f in *; do \rm $f; done'                'do before a decorated rm'
  _rm_redirect_expect DENY 'if true; then command rm f; fi'             'then is transparent'
  _rm_redirect_expect DENY 'while read f; do env rm $f; done < list'    'do before an env-wrapped rm'
  _rm_redirect_expect DENY '! \rm foo'                                  '! is transparent'

  # 2026-09-25: with a re-declared `local segment match`, the FIRST line's
  # values reach stdout ahead of the deny JSON: INVALID, not DENY.
  _rm_redirect_expect DENY $'rm -rf build\nfind . -name "*.o" -delete' 'two qualifying lines, second DENIEs'

  # Backslash-newline joins into one logical line in a real shell
  # (2026-09-25), so a wrapped find/git-clean/xargs form must still DENY.
  _rm_redirect_expect DENY $'find . -name "*.pyc" \\\n  -delete'       'backslash-newline continuation: find -delete'
  _rm_redirect_expect DENY $'find . \\\n  -name "*.pyc" \\\n  -delete'  'three-line continuation: inner join loop runs twice'
  _rm_redirect_expect DENY $'git clean \\\n  -fdx'                     'backslash-newline continuation: git clean -fdx'
  _rm_redirect_expect DENY $'echo foo | xargs \\\n  rm'                'backslash-newline continuation: xargs rm'

  # A continuation needs an ODD trailing backslash run outside a comment
  # (2026-09-25): `echo foo\\`<NL> prints `foo\` and the next line stands
  # alone (EVEN, no join); `# note \`<NL> is a comment (no join). Three
  # backslashes (ODD) still join.
  _rm_redirect_expect DENY $'echo foo\\\\\n\\rm x'         'even trailing backslash count: no join, next line stands alone'
  _rm_redirect_expect DENY $'# note \\\n\\rm x'             'comment ending in backslash: no join, next line stands alone'
  _rm_redirect_expect DENY $'echo hi # trailing \\\n\\rm x' 'trailing comment ending in backslash: no join'
  _rm_redirect_expect DENY $'find . -name x\\\\\\\n  -delete' 'odd run of three backslashes still joins'

  # Malformed/empty stdin → PASS (fail-open), matching every other hook.
  if [[ -z "$(printf '' | /bin/zsh "${SCRIPT_DIR}/claude/hooks/rm-redirect-hook")" ]]; then
    _pass "PASS: empty stdin (fail-open)"
  else
    _fail "empty stdin did not fail open"
  fi
  if [[ -z "$(printf 'not json' | /bin/zsh "${SCRIPT_DIR}/claude/hooks/rm-redirect-hook")" ]]; then
    _pass "PASS: malformed stdin (fail-open)"
  else
    _fail "malformed stdin did not fail open"
  fi

  # rc=0 on a DENY too (hook header, "Fail-open by convention").
  if /usr/bin/jq -n --arg c '\rm foo' '{tool_name:"Bash", tool_input:{command:$c}}' \
      | /bin/zsh "${SCRIPT_DIR}/claude/hooks/rm-redirect-hook" > /dev/null; then
    _pass "DENY still exits 0"
  else
    _fail "a DENY verdict must not exit nonzero"
  fi

  # Case variants at a command position DENY: the alias is case-sensitive,
  # the filesystem is not (2026-09-29). Path-qualified and non-command-position
  # variants stay PASS.
  _rm_redirect_expect DENY 'RM foo'
  _rm_redirect_expect DENY 'Rm -rf foo'
  _rm_redirect_expect DENY 'UNLINK foo'
  _rm_redirect_expect DENY 'Shred foo'
  _rm_redirect_expect DENY 'a && RM b'                   'case variant after &&'
  _rm_redirect_expect DENY $'ls\nRM b'                   'case variant on a later line'
  _rm_redirect_expect PASS '/bin/RM foo'                 'path-qualified case variant'
  _rm_redirect_expect PASS 'echo RM foo'                 'case variant as an argument'
  _rm_redirect_expect PASS 'RMDIR foo'                   'non-rm-family word in capitals'

  # Deny text is one line, at most 120 characters, of the form
  # "<what is blocked>: <what to use instead>." (2026-09-29).
  local shape reason
  for shape in '\rm foo' 'RM foo' 'xargs rm' 'command rm foo' 'find . -delete' \
               'find . -exec rm {} +' 'fd -X rm' 'fd --exec rm' 'git clean -fdx' \
               $'bash <<EOF\nrm x\nEOF' 'nocorrect \rm foo' 'env rm foo'; do
    reason="$(_rm_redirect_run "${shape}" | jq -r '.hookSpecificOutput.permissionDecisionReason // empty')" || reason=''
    if [[ -n "${reason}" && "${reason}" != *$'\n'* && ${#reason} -le 120 \
          && "${reason}" == *': '* && "${reason}" == *. ]]; then
      _pass "deny text is one short line (${#reason} chars): ${shape//$'\n'/<NL>}"
    else
      _fail "deny text not one short line (${#reason} chars): ${shape//$'\n'/<NL>}: ${reason}"
    fi
  done

  # Multi-line commands run every hook loop more than once; output must be
  # empty (PASS) or one JSON object (DENY), never stray "name=value" lines
  # from a re-executed untyped local.
  _rm_redirect_expect PASS $'echo "a"\necho \'b\'\nrm c\nrm d'          'quoted lines then plain rm lines: segment loop twice'
  _rm_redirect_expect PASS $'cat <<A <<B\nx\nA\ny\nB\nrm q\nrm r'       'two heredocs then plain rm lines'
  _rm_redirect_expect PASS $'echo "rm a"; echo "rm b"\necho "unlink c"\nls'  'quoted rm words on several lines'
  _rm_redirect_expect DENY $'echo "a"\necho \'b\'\nfind . -name x\nRM c'  'quoted lines then a case-variant deny'
  _rm_redirect_expect DENY $'cat <<A <<B\nx\nA\ny\nB\n\\rm q'          'two heredocs then a decorated deny'
}
