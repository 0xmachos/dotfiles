#!/bin/zsh
# dotfiles/tests/rm-redirect
#
# Behavioural test for claude/hooks/rm-redirect-hook (PreToolUse): feeds commands
# to the hook and asserts the verdict. Rationale for each class is in that
# hook's own header.
#
# Contract: plain rm/unlink/shred/gshred at ANY command position PASSES (the
# shell alias already trashes it). DENY is only the forms that skip the alias:
# a quoted, escaped, mid-word-decorated or case-variant rm-family word; a
# path-qualified one; a wrapper that execs its target directly, sudo and doas
# included; find/gfind/fd/fdfind with an rm-family target; a bare rm-family
# word in a heredoc body or sh/bash/zsh/dash/ksh -c string (child shells have
# no alias table); `git clean -f`/`--force` without `-n`/`--dry-run`.
#
# Covers, one input each: every deny class with the fragment its reason must
# carry (decorated word, path-qualified word, xargs, sudo, find, fd, git clean,
# heredoc body, -c string, case variant); the closed parser bugs (a second
# qualifying line, a backslash-newline join, the byte budget); the PASS guard
# for bare rm and for rm-family words as arguments; the fail-open contract
# (line cap, deadline, malformed stdin); and an exported HOOK_PRE_DISPATCH that
# must not make a standalone hook skip.
# Verdict cases run the guard through the pretool-dispatch seam
# (_hook_run_seam in tests/lib). The hook copy with one literal changed and the
# oversized commands go through the seam too (the command is a variable, not
# argv or stdin).
#
# Run: ./test rm-redirect
# ShellCheck: lint with `shellcheck --shell=bash tests/rm-redirect`.
# This file is sourced, not executed — chmod 644.
#
# SC2016: fixtures are literal strings handed to jq --arg; `$d`/`$f`/`$SHELL`
# must stay unexpanded, as a Bash tool call would carry them.
# shellcheck disable=SC2016
#
# shellcheck source=tests/lib

# Wrong results collected by _rm_redirect_check, reported by _rm_redirect_finish.
typeset -g RMR_T_BAD=''

function _rm_redirect_check {
  # Seam verdict of command $2 against wanted verdict $1. Optional $3: a
  # fragment the deny reason must contain. Optional $4: how many runs to allow
  # before a wrong verdict counts (default 1; the hook's 0.3 s deadline fails
  # open under load, so a near-cap DENY gets retries). A miss is added to
  # RMR_T_BAD.
  local want="$1" cmd="$2" frag="${3:-}" tries="${4:-1}" got=''
  local -i t
  for (( t = 1; t <= tries; t++ )); do
    _hook_run_seam "${SCRIPT_DIR}/claude/hooks/rm-redirect-hook" Bash "${cmd}"
    got="${HOOK_SEAM_VERDICT}"
    [[ "${got}" == "${want}" ]] && break
  done
  if [[ "${got}" != "${want}" ]]; then
    RMR_T_BAD+=" [${cmd:0:50} want ${want} got ${got}]"
  elif [[ -n "${frag}" && "${HOOK_SEAM_REASON}" != *"${frag}"* ]]; then
    RMR_T_BAD+=" [${cmd:0:50} reason lacks: ${frag}]"
  fi
}

function _rm_redirect_finish {
  # Report the collected misses as one case labelled $1, then reset.
  if [[ -z "${RMR_T_BAD}" ]]; then
    _pass "$1"
  else
    _fail "$1 —${RMR_T_BAD}"
  fi
  RMR_T_BAD=''
}

function _rm_redirect_one {
  # One input, one case: _rm_redirect_check with labelled result.
  # $1 want, $2 command, $3 label, $4 reason fragment, $5 tries.
  _rm_redirect_check "$1" "$2" "${4:-}" "${5:-1}"
  _rm_redirect_finish "$1: $3"
}

function _rm_redirect_lines_command {
  # REPLY = a command of $1 lines: `\rm x` first, then one-character lines.
  local -a rm_redirect_lines=('\rm x')
  local -i k
  for (( k = 1; k < $1; k++ )); do rm_redirect_lines+=(a); done
  # shellcheck disable=SC2296
  REPLY="${(F)rm_redirect_lines}"
}

function _rm_redirect_make_copy {
  # Copy the hook to $1/hook with ONE literal changed: $2 becomes $3. Returns 1
  # (and says why) when the copy is unchanged or lacks the new literal, so a
  # drifted pattern cannot give a green case. The hook reads no file relative
  # to its own path, so the copy runs the same as the original.
  local dir="$1" old="$2" new="$3" body changed
  body="$(<"${SCRIPT_DIR}/claude/hooks/rm-redirect-hook")" || body=''
  changed="${body/"${old}"/"${new}"}"
  if [[ -z "${body}" || "${changed}" == "${body}" || "${changed}" != *"${new}"* ]]; then
    _fail "hook copy: literal not found or not changed: ${old}"
    return 1
  fi
  print -r -- "${changed}" > "${dir}/hook"
}

function _rm_redirect_copy_check {
  # Run hook copy $1/hook through the seam on command $3. A verdict other
  # than $2 is added to RMR_T_BAD.
  _hook_run_seam "$1/hook" Bash "$3"
  [[ "${HOOK_SEAM_VERDICT}" == "$2" ]] || RMR_T_BAD+=" [$4: want $2 got ${HOOK_SEAM_VERDICT}]"
}

function run_rm_redirect {
  _section "rm → trash redirect hook"

  # claude/ is gitignored and synced out of band: an absent hook skips.
  if [[ ! -f "${SCRIPT_DIR}/claude/hooks/rm-redirect-hook" ]]; then
    _skip "claude/hooks/rm-redirect-hook absent — claude/ not yet synced to this machine"
    return 0
  fi

  if ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
    return
  fi

  # Deny classes: one input each, with the reason fragment it must carry.
  _rm_redirect_one DENY '\rm foo.txt' 'a backslash-escaped rm skips the alias' trash
  _rm_redirect_one DENY '/bin/rm foo' 'a path-qualified rm is the real binary' 'exact /bin/rm command for their own terminal'
  _rm_redirect_one DENY 'echo foo | xargs rm' 'xargs cannot see the alias' 'xargs trash'
  _rm_redirect_one DENY 'sudo rm foo' 'sudo is a bypass wrapper' 'exact command'
  _rm_redirect_one DENY "find . -name '*.tmp' -delete" 'find -delete' '-exec trash {} +'
  _rm_redirect_one DENY 'fd -X rm' 'fd -X with an rm target' '-X rm'
  _rm_redirect_one DENY 'git clean -fdx' 'git clean -f without -n' 'git clean -n'
  _rm_redirect_one DENY $'bash <<EOF\nrm foo\nEOF' 'a bare rm in a shell heredoc body'
  _rm_redirect_one DENY "bash -c 'rm foo'" 'a bare rm in a bash -c string'
  _rm_redirect_one DENY 'RM foo' 'a case variant (the filesystem is case-insensitive)'

  # Closed parser bugs.
  _rm_redirect_one DENY $'rm -rf build\nfind . -name "*.o" -delete' 'a denying second qualifying line (a repeated local leaked name=value)'
  _rm_redirect_one DENY $'find . -name "*.pyc" \\\n  -delete' 'a backslash-newline join'
  # shellcheck disable=SC2034
  local rm_redirect_empty='' rm_redirect_budget_probe
  # shellcheck disable=SC2034
  local -a rm_redirect_budget_lines
  local -i rm_redirect_bi
  for (( rm_redirect_bi = 1; rm_redirect_bi <= 34; rm_redirect_bi++ )); do
    # shellcheck disable=SC2296
    rm_redirect_budget_lines+=("echo ${(l:8000::z:)rm_redirect_empty}")
  done
  # shellcheck disable=SC2296
  rm_redirect_budget_probe="${(F)rm_redirect_budget_lines}"$'\n''\rm x'
  # 34 non-matching lines pass the 262144 byte budget: they must not hide a
  # later deny. The scan sits near the 0.3 s deadline, so it gets retries.
  _rm_redirect_one DENY "${rm_redirect_budget_probe}" 'non-matching lines past the byte budget do not shadow a later deny' '' 3

  # PASS guard.
  _rm_redirect_one PASS 'rm -rf foo' 'bare rm (the shell alias trashes it)'
  _rm_redirect_one PASS 'git rm foo' 'rm as a git argument'
  _rm_redirect_one PASS 'git clean -n' 'git clean with -n'

  # Fail-open contract.
  _rm_redirect_lines_command 4001
  _rm_redirect_one PASS "${REPLY}" '4001 lines, past the line cap, fails open'
  local rm_redirect_copy_dir
  rm_redirect_copy_dir="$(mktemp -d "${TMPDIR:-/tmp}/rm-redirect-copy.XXXXXX")"
  if _rm_redirect_make_copy "${rm_redirect_copy_dir}" 'EPOCHREALTIME + 0.3' 'EPOCHREALTIME - 600'; then
    _rm_redirect_copy_check "${rm_redirect_copy_dir}" PASS '\rm foo' 'deadline already passed'
    _rm_redirect_finish "PASS: a deadline already passed fails open"
  fi
  /bin/rm -rf "${rm_redirect_copy_dir}"
  local rm_redirect_out rm_redirect_got
  if [[ -z "$(printf 'not json' | /bin/zsh "${SCRIPT_DIR}/claude/hooks/rm-redirect-hook")" ]]; then
    _pass "PASS: malformed stdin fails open"
  else
    _fail "malformed stdin did not fail open"
  fi

  # An exported HOOK_PRE_DISPATCH must not make a standalone hook skip its
  # stdin: ZSH_EVAL_CONTEXT lacks :file when the hook is exec'd, so the
  # command comes from the JSON, not from HOOK_PRE_COMMAND.
  rm_redirect_out="$(jq -n --arg c '\rm foo' '{tool_name:"Bash", tool_input:{command:$c}}' \
    | HOOK_PRE_DISPATCH=1 HOOK_PRE_COMMAND='ls' /bin/zsh "${SCRIPT_DIR}/claude/hooks/rm-redirect-hook")" || rm_redirect_out=''
  rm_redirect_got="$(_hook_verdict "${rm_redirect_out}")" || rm_redirect_got=INVALID
  if [[ "${rm_redirect_got}" == DENY ]]; then
    _pass "DENY (standalone): an exported HOOK_PRE_DISPATCH does not skip the stdin path"
  else
    _fail "exported HOOK_PRE_DISPATCH skipped a standalone run — got ${rm_redirect_got}"
  fi
}
