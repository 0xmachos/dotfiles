#!/bin/zsh
# dotfiles/tests/hook-links
#
# Guards deploy skew between claude/settings.json and ~/.claude/: every
# ~/.claude/<file> that settings.json invokes as a command (PreToolUse /
# PostToolUse hooks + statusline commands) must be
#   1. registered for deploy (hermetic, always runs): a hooks/<name> file must
#      exist in claude/hooks/, which install_dotfiles links per file; any other
#      file needs a bittersweet claude_files entry;
#   2. present in ~/.claude/ (environment-gated: runs only when
#      ~/.claude/settings.json links back to claude/settings.json).
# Motivating bug (2026-06): ssh-redirect-hook was in settings.json, the map and
# the repo but `bittersweet dotfiles` was not re-run, so every tool call logged
# `/bin/zsh: can't open input file: ~/.claude/ssh-redirect-hook`. Map and
# settings agreed, so only check 2 catches it.
#
# Settings are read with `jq … < file`, not `jq … file`: the Documents TCC
# grant is on /bin/zsh's signing identity, not jq's.
#
# Run: ./test hook-links
# ShellCheck: lint with `shellcheck --shell=bash tests/hook-links`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

# Reads the ~/.claude commands out of settings file $1 into the global array
# _HLK_DESTS (deduped) and checks each is registered for deploy against repo
# root $2 (claude/hooks/ files) and bittersweet file $3 (claude_files map).
# Returns 1 when there are no commands to check.
function _hlk_check_registration {
  local settings="$1" root="$2" bittersweet="$3"

  # Deduped; `|| true` absorbs grep's exit 1 on no match under pipefail.
  local -A seen
  local ref dest
  _HLK_DESTS=()
  while IFS= read -r ref; do
    [[ -z "${ref}" ]] && continue
    dest="${ref#*/.claude/}"
    [[ -n "${seen[${dest}]+_}" ]] && continue
    seen[${dest}]=1
    _HLK_DESTS+=("${dest}")
  done < <(jq -r '.. | objects | .command // empty' < "${settings}" \
            | /usr/bin/grep -oE '[~]/\.claude/(hooks/)?[A-Za-z0-9._-]+' || true)

  if (( ${#_HLK_DESTS[@]} == 0 )); then
    # No commands at all = minimal not-yet-synced config (skip); commands but
    # no ~/.claude match = extraction regression (fail).
    if [[ "$(jq '[.. | objects | .command // empty] | length' < "${settings}")" == "0" ]]; then
      _skip "settings.json configures no hook commands — claude/ not yet synced"
    else
      _fail "No ~/.claude command references found in settings.json (extraction broke?)"
    fi
    return 1
  fi

  # 1. Registration parity. A script a third-party installer writes straight
  # into ~/.claude/hooks/ (herdr's integration) has no repo copy to register;
  # check 2 still requires it to be present.
  local -a third_party=(hooks/herdr-agent-state.sh)
  for dest in "${_HLK_DESTS[@]}"; do
    if (( ${third_party[(Ie)${dest}]} )); then
      _pass "third-party: ${dest} is installed by its own tool, not deployed from claude/"
    elif [[ "${dest}" == hooks/* ]]; then
      if [[ -f "${root}/claude/${dest}" ]]; then
        _pass "registered: ${dest} in claude/hooks/"
      else
        _fail "${dest} invoked by settings.json but absent from claude/hooks/"
      fi
    elif /usr/bin/grep -qE "\"claude/[^\"]+:${dest}\"" "${bittersweet}"; then
      _pass "registered: ${dest} in bittersweet claude_files map"
    else
      _fail "${dest} invoked by settings.json but absent from bittersweet claude_files map — add it"
    fi
  done
}

# $1 case name, $2 captured output, $3 colour, $4 PASS, FAIL or SKIP, $5 text.
# The case passes when the output holds that line.
function _hlk_expect {
  if [[ "$2" == *"$3$4${RESET}  $5"* ]]; then
    _pass "fixture: $1"
  else
    _fail "fixture: $1: expected a $4 line starting '$5', got: $2"
  fi
}

# The registration check over small settings files. The check runs in a
# subshell, so only the expectation reaches the suite totals.
function _hlk_fixture_cases {
  local root out
  root="$(mktemp -d "${TMPDIR}hook-links-fixture.XXXXXX")"
  /bin/mkdir -p "${root}/claude/hooks"
  : > "${root}/claude/hooks/present-hook"
  : > "${root}/bittersweet"

  print -r -- '{"hooks":{"PreToolUse":[{"hooks":[{"type":"command","command":"/usr/bin/true"}]}]}}' > "${root}/no-match.json"
  print -r -- '{"env":{}}' > "${root}/no-commands.json"
  print -r -- '{"hooks":{"PreToolUse":[{"hooks":[{"type":"command","command":"~/.claude/hooks/present-hook"}]}]}}' > "${root}/present.json"
  print -r -- '{"hooks":{"PreToolUse":[{"hooks":[{"type":"command","command":"~/.claude/hooks/absent-hook"}]}]}}' > "${root}/absent.json"

  out="$(_hlk_check_registration "${root}/no-match.json" "${root}" "${root}/bittersweet" 2>&1)" || true
  _hlk_expect "commands without a ~/.claude reference fail" "${out}" "${RED}" FAIL "No ~/.claude command references found"
  out="$(_hlk_check_registration "${root}/no-commands.json" "${root}" "${root}/bittersweet" 2>&1)" || true
  _hlk_expect "settings without commands skip" "${out}" "${YELLOW}" SKIP "settings.json configures no hook commands"
  out="$(_hlk_check_registration "${root}/present.json" "${root}" "${root}/bittersweet" 2>&1)" || true
  _hlk_expect "a hook present in claude/hooks/ passes" "${out}" "${GREEN}" PASS "registered: hooks/present-hook in claude/hooks/"
  out="$(_hlk_check_registration "${root}/absent.json" "${root}" "${root}/bittersweet" 2>&1)" || true
  _hlk_expect "a hook absent from claude/hooks/ fails" "${out}" "${RED}" FAIL "hooks/absent-hook invoked by settings.json but absent from claude/hooks/"
  /bin/rm -rf "${root}"
}

function run_hook_links {
  _section "Claude settings → ~/.claude link deployment"

  if ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
    return
  fi

  local settings="${SCRIPT_DIR}/claude/settings.json"
  local bittersweet="${SCRIPT_DIR}/bittersweet"

  _hlk_fixture_cases

  # claude/ is gitignored; without its settings.json there is nothing to check.
  if [[ ! -f "${settings}" ]]; then
    _skip "claude/settings.json absent — claude/ not yet synced to this machine"
    return
  fi

  local dest
  _hlk_check_registration "${settings}" "${SCRIPT_DIR}" "${bittersweet}" || return 0

  # 2. Deployment: gated on ~/.claude/settings.json linking back here; else
  #    the symlinks live elsewhere (fresh checkout, CI, container).
  if [[ "$(readlink "${HOME}/.claude/settings.json" 2>/dev/null)" != "${settings}" ]]; then
    _skip "deployment: ~/.claude not linked to this repo (run: bittersweet dotfiles)"
    return
  fi

  for dest in "${_HLK_DESTS[@]}"; do
    # -e follows the symlink, so a dangling link fails too.
    if [[ -e "${HOME}/.claude/${dest}" ]]; then
      _pass "deployed: ~/.claude/${dest}"
    else
      _fail "missing/broken: ~/.claude/${dest} — run: bittersweet dotfiles"
    fi
  done
}
