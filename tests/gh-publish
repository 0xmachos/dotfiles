    'a newline inside a command substitution separates commands'
  _gp_test_expect DENY $'gh --repo "o\nr" issue create --title t --body x' \
    'a global flag value that spans a newline does not hide the verb after it'
  _gp_test_expect DENY $'echo \'a\n<<X\'\ngh issue create -t t --body raw\nX' \
    'a << inside a multi-line quoted value does not open a heredoc that hides the next line'
  _gp_test_expect PASS $'cat <<X\ngh issue create -t t --body raw\nX' \
    'a real heredoc body that only mentions a publish stays data'
  _gp_test_expect DENY $'git commit -m "note about <<X\nmore text"\ngh issue create -t t --body raw\nX' \
    'a << in a multi-line commit message does not hide the publish that follows'

  # --- Declarations inside loops: a command that drives each loop twice
  # still yields one valid deny object (or nothing at all).
  _gp_test_expect DENY 'gh pr create -df -dd --title t --body x' 'two short-flag clusters in one command'
  _gp_test_expect DENY 'gh api repos/o/r/issues -f a=1 -f b=2 -H x:y' 'several api flags in one command'
  _gp_test_expect DENY $'cat <<A\nx\nA\ncat <<B\ny\nB\ngh issue create -t t --body x' \
    'two heredocs before a publish'

  # --- Standalone process path ----------------------------------------------
  # The hook as its own process: JSON on stdin, the hook's own jq, the deny
  # object. Two DENY and two PASS verdicts, then the cases that need stdin or
  # the process environment.
  _gp_test_expect_standalone DENY 'gh issue create -t t --body inline' 'inline --body'
  _gp_test_expect_standalone PASS 'ls -la' 'non-gh command'

  # An exported HOOK_PRE_DISPATCH=1 must not make a standalone hook skip: it
  # reads stdin, since ZSH_EVAL_CONTEXT lacks :file when exec'd. The seam
  # variables here say Read with no command, so a hook that trusted them
  # would let the inline body through.
  local gp_env_out
  gp_env_out="$( (export HOOK_PRE_DISPATCH=1 HOOK_PRE_TOOL=Read HOOK_PRE_COMMAND=''
    _gp_test_run 'gh issue create -t t --body inline') )"
  if [[ "$(_hook_verdict "${gp_env_out}")" == DENY ]]; then
    _pass "DENY (standalone): an exported HOOK_PRE_DISPATCH=1 does not skip the hook"
  else
    _fail "an exported HOOK_PRE_DISPATCH=1 made the standalone hook skip"
  fi

  # Empty, malformed and non-Bash payloads fail open (stdin and jq path).
  local gp_payload gp_label
  local -a gp_payloads=('' 'not json' '{}' '{"tool_name":"Read","tool_input":{"command":"gh issue create --body x"}}')
  local -a gp_labels=('empty payload' 'unparseable payload' 'payload with no tool' 'non-Bash tool')
  local -i gp_i
  for (( gp_i=1; gp_i<=${#gp_payloads}; gp_i++ )); do
    gp_payload="${gp_payloads[gp_i]}"
    gp_label="${gp_labels[gp_i]}"
    gp_env_out="$(printf '%s' "${gp_payload}" \
      | HOME="${_gp_dir}/home" GH_PUBLISH_PATTERNS="${_gp_dir}/patterns" \
        GH_PUBLISH_SSH_CONFIG="${_gp_dir}/sshcfg" GH_PUBLISH_NO_GITLEAKS=1 \
        GH_PUBLISH_NO_IDENTITY=1 GH_CONFIG_DIR="${_gp_dir}/gh" \
        /bin/zsh "${SCRIPT_DIR}/claude/hooks/gh-publish-hook")"
    if [[ -z "${gp_env_out}" ]]; then
      _pass "fail-open (standalone): ${gp_label} allowed through"
    else
      _fail "fail-open: ${gp_label} produced a verdict"
    fi
  done

  # Under the seam the deny text is plain lines after DENY<US>, no JSON.
  _gp_test_seam 'gh issue create -t t --body inline'
  if [[ "${HOOK_SEAM_VERDICT}" == DENY && "${HOOK_SEAM_OUT}" == $'DENY\x1f'* && "${HOOK_SEAM_OUT}" != *'{'* ]]; then
    _pass "seam: a denied command prints DENY<US>reason and no JSON"
  else
    _fail "seam: expected DENY<US>reason, got: ${HOOK_SEAM_OUT:0:120}"
  fi

  /bin/rm -rf "${_gp_dir}"
  trap - EXIT
}
