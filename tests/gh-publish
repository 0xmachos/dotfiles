#!/bin/zsh
# dotfiles/tests/gh-publish
#
# Behavioural test for claude/hooks/gh-publish-hook, the PreToolUse gate on public
# GitHub writes (gh issue/pr/release create|edit|comment, gh api writes).
# One input is one case. Commands go through the guard and the test asserts
# DENY vs PASS. The cases cover:
#   - the review sidecar: an inline body, a missing sidecar, a sidecar stale
#     after an edit, and a sidecar that matches the file but not the bytes read
#   - one content deny per layer: PII token, SSH alias, hard-wrap, bare
#     @-mention, a missing issue '## Environment' section, a wrong macOS
#     version
#   - the body-file size cap, fail-closed reads (denylist, gitleaks error)
#   - a gh api write, a joined --body-file=~/ path, an alias that expands to a
#     publish, an env-var prefix that is no bypass
#   - the command-position tokeniser: a dynamic command word, an sh -c string
#     and a heredoc a shell reads
#   - false-positive guards: a reviewed body, a read, a gh api GET
#   - the hook as its own process: the exported HOOK_PRE_DISPATCH=1 case (a
#     standalone hook must not skip) and fail-open on unparseable JSON
# Fixture tokens are assembled at run time: no PII- or secret-shaped literal
# (same convention as tests/pii-hook).
# Seams: GH_PUBLISH_PATTERNS / GH_PUBLISH_SSH_CONFIG inject the PII/ssh
# sources; GH_PUBLISH_NO_GITLEAKS disables gitleaks outside its own case.
# The verdict cases run the guard through the pretool-dispatch seam
# (_hook_run_seam in tests/lib: sourced in a subshell, HOOK_PRE_* set,
# DENY<US>reason). The suite seams (HOME, GH_PUBLISH_*) go to the helper as
# leading NAME=value words and the deny text is read from HOOK_SEAM_REASON.
# tests/test-helpers mocks _gp_test_run and _hook_run_seam, then calls
# _gp_test_expect: keep both names.
#
# Run: ./test gh-publish
# ShellCheck: lint with `shellcheck --shell=bash tests/gh-publish`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib
# shellcheck disable=SC2154  # SCRIPT_DIR is set by the sourcing dispatcher
# shellcheck disable=SC2016  # fixtures are literal command text, never expanded here

function _gp_test_run {
  # Hook stdout for Bash command $1; $2 optionally overrides the pattern file,
  # $3 the NO_GITLEAKS seam, $4 the NO_IDENTITY seam (defaults isolate both).
  # GH_PUBLISH_GH points at a gh stub, so alias resolution never starts gh.
  # HOME points into the sandbox so the hook's body snapshots (under
  # ~/Library/Caches/gh-publish) never touch the real home.
  jq -n --arg c "$1" '{tool_name:"Bash", tool_input:{command:$c}}' \
    | HOME="${_gp_dir}/home" \
      GH_PUBLISH_PATTERNS="${2:-${_gp_dir}/patterns}" \
      GH_PUBLISH_SSH_CONFIG="${_gp_dir}/sshcfg" \
      GH_PUBLISH_NO_GITLEAKS="${3-1}" \
      GH_PUBLISH_NO_IDENTITY="${4-1}" \
      GH_PUBLISH_OS="7.7:99Z999z" \
      GH_PUBLISH_GH="${_gp_dir}/stubbin/gh" \
      /bin/zsh "${SCRIPT_DIR}/claude/hooks/gh-publish-hook"
}

function _gp_test_seam {
  # Seam run of the guard for Bash command $1, with the same sandbox seams and
  # argument defaults as _gp_test_run. The verdict lands in HOOK_SEAM_VERDICT
  # and the deny text in HOOK_SEAM_REASON. Never call this inside $(...).
  # ${_gp_dir-}: test-helpers calls the expect functions with no sandbox.
  _hook_run_seam \
    HOME="${_gp_dir-}/home" \
    GH_PUBLISH_PATTERNS="${2:-${_gp_dir-}/patterns}" \
    GH_PUBLISH_SSH_CONFIG="${_gp_dir-}/sshcfg" \
    GH_PUBLISH_NO_GITLEAKS="${3-1}" \
    GH_PUBLISH_NO_IDENTITY="${4-1}" \
    GH_PUBLISH_OS="7.7:99Z999z" \
    GH_PUBLISH_GH="${_gp_dir-}/stubbin/gh" \
    -- "${SCRIPT_DIR}/claude/hooks/gh-publish-hook" Bash "$1"
}

function _gp_test_inject_expect {
  # $1 = verdict, $2 = Bash command, $3 = zsh function definition run before
  # the guard is sourced (it shadows a builtin), $4 = label. Fault injection
  # for reads the suite cannot provoke from a real file. The definition is
  # evaluated here, so the seam subshell inherits it, and removed afterwards.
  local want="$1" cmd="$2" inject="$3" label="$4"
  eval "${inject}"
  _gp_test_seam "${cmd}"
  unfunction sysread 2>/dev/null || :
  unset gp_calls gp_chunk 2>/dev/null || :
  if [[ "${HOOK_SEAM_VERDICT}" == "${want}" ]]; then
    _pass "${want}: ${label}"
  else
    _fail "${label} — expected ${want}, got ${HOOK_SEAM_VERDICT}"
  fi
}

function _gp_repeat {
  # REPLY = string $2 repeated $1 times, by doubling. Pure zsh, so it starts no
  # process and counts bytes the same under any locale.
  local -i n="$1"
  local unit="$2"
  REPLY=''
  while (( n > 0 )); do
    (( n & 1 )) && REPLY+="${unit}"
    unit+="${unit}"
    n=$(( n >> 1 ))
  done
}

function _gp_test_review_all {
  # Write a hash-bound review sidecar for every body file in "$@" with ONE
  # shasum call. No fixture path holds a newline or two spaces in a row, so
  # each output line is "<hash>  <path>".
  local sums line
  sums="$(shasum -a 256 "$@")"
  while IFS= read -r line; do
    printf 'reviewed-by: test 2026-08-03 sha256:%s\n' "${line%% *}" > "${line#*  }.reviewed"
  done <<< "${sums}"
}

function _gp_test_expect {
  # $1 want, $2 command, $3 label; optional $4 pattern file, $5 NO_GITLEAKS,
  # $6 NO_IDENTITY, $7 a substring the deny reason must hold.
  local want="$1" cmd="$2" label="$3"
  _gp_test_seam "${cmd}" "${4:-}" "${5-1}" "${6-1}"
  if [[ "${HOOK_SEAM_VERDICT}" == "${want}" && "${HOOK_SEAM_REASON}" == *"${7-}"* ]]; then
    _pass "${want}: ${label}"
  else
    _fail "${label} — expected ${want} with '${7-}', got ${HOOK_SEAM_VERDICT} (${HOOK_SEAM_OUT:0:120})"
  fi
}

function run_gh_publish {
  _section "gh publish gate hook"

  # claude/ is gitignored: an absent hook skips the suite, not a regression.
  if [[ ! -f "${SCRIPT_DIR}/claude/hooks/gh-publish-hook" ]]; then
    _skip "claude/hooks/gh-publish-hook absent — claude/ not yet synced to this machine"
    return 0
  fi

  if ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
    return
  fi

  local _gp_dir
  _gp_dir="$(mktemp -d "${TMPDIR:-/tmp}/gh-publish-test.XXXXXX")"
  trap '/bin/rm -rf "${_gp_dir}"' EXIT

  local fixture_token fixture_alias
  fixture_token="FIXTURE_$(printf 'P%s' II)_TOKEN"
  fixture_alias="testalias$(( 90 + 9 ))"
  printf '%s\n' "${fixture_token}" > "${_gp_dir}/patterns"
  printf 'Host %s\n' "${fixture_alias}" > "${_gp_dir}/sshcfg"

  # gh stub (GH_PUBLISH_GH, the hook's only gh call is `gh alias list`): one
  # alias that expands to a real publish.
  mkdir -p "${_gp_dir}/stubbin"
  cat > "${_gp_dir}/stubbin/gh" <<'STUB'
#!/bin/sh
printf '%s\n' 'ghpubtest: issue create --body x'
STUB
  chmod +x "${_gp_dir}/stubbin/gh"

  # Every body fixture is made here, hashed with one shasum call and given its
  # .reviewed sidecar. stale.md is edited after the sidecar pass.
  local -a gp_bodies=()
  mkdir -p "${_gp_dir}/home/tint/x"

  # A clean, reviewed, env-carrying body.
  printf 'One full-width paragraph, no wrapping at all.\n\n## Environment\n\n- test hardware, test OS build\n' \
    > "${_gp_dir}/good.md"
  cp "${_gp_dir}/good.md" "${_gp_dir}/stale.md"
  cp "${_gp_dir}/good.md" "${_gp_dir}/nosidecar.md"
  # PR and comment bodies do not need an Environment section.
  printf 'No env section here, one line.\n' > "${_gp_dir}/noenv.md"
  printf 'Contains %s in prose.\n\n## Environment\n\n- b\n' "${fixture_token}" > "${_gp_dir}/pii.md"
  printf 'Mentions %s host.\n\n## Environment\n\n- b\n' "${fixture_alias}" > "${_gp_dir}/alias.md"
  printf 'This paragraph is wrapped\nacross two lines badly.\n\n## Environment\n\n- b\n' > "${_gp_dir}/wrap.md"
  printf 'Please ping @octocat about this.\n\n## Environment\n\n- b\n' > "${_gp_dir}/mention.md"
  printf 'Body.\n\n## Environment\n\n- MacBook, macOS 6.6 (88X8888)\n' > "${_gp_dir}/wrongos.md"
  # Body-file size cap fixtures, byte-exact: one byte over 128 KiB, and
  # exactly 128 KiB.
  _gp_repeat 131072 a; print -rn -- "${REPLY}" > "${_gp_dir}/atcap.md"
  _gp_repeat 131073 a; print -rn -- "${REPLY}" > "${_gp_dir}/overcap.md"
  # A leading ~/ in a body path is the hook's HOME (the sandbox home here).
  printf 'One line body under the sandbox home.\n' > "${_gp_dir}/home/tint/x/issue.md"

  gp_bodies=("${_gp_dir}"/{good,stale,noenv,pii,alias,wrap,mention,wrongos,atcap,overcap}.md "${_gp_dir}/home/tint/x/issue.md")
  _gp_test_review_all "${gp_bodies[@]}"
  # Edit after review: the sidecar above no longer matches this body. The
  # append is its own paragraph, so a wrap deny cannot mask a broken hash check.
  printf '\nEdited after review.\n' >> "${_gp_dir}/stale.md"

  # --- DENY: review artifact ----------------------------------------------
  _gp_test_expect DENY 'gh issue create -t t --body "inline body"' 'inline --body names the sidecar workflow' '' 1 1 '.reviewed'
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/nosidecar.md" 'missing .reviewed sidecar'
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/stale.md" 'sidecar stale after a post-review edit'

  # --- DENY: one content layer each ------------------------------------------
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/pii.md" 'PII token in body'
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/alias.md" 'SSH alias in body'
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/wrap.md" 'hard-wrapped paragraph'
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/mention.md" 'bare @-mention'
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/noenv.md" 'issue create without an Environment section' '' 1 1 '## Environment'
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/wrongos.md" 'env macOS version does not match the live version'
  _gp_test_expect DENY 'gh api repos/o/r/issues -f title=x' 'gh api write via -f'

  # --- DENY: size cap, fail-closed reads ------------------------------------
  # An over-cap body also denies through the "could not be read in full"
  # branch, so only the reason text tells the cap branch from that fallback.
  _gp_test_expect DENY "gh pr create -t t --body-file ${_gp_dir}/overcap.md" 'body file over the 128 KiB cap' '' 1 1 'over 128 KiB'
  # The sidecar hash is of the bytes scanned: a read that adds a byte denies.
  _gp_test_inject_expect DENY "gh pr create -t t --body-file ${_gp_dir}/atcap.md" \
    'function sysread { builtin sysread "$@"; local r=$?; (( r == 0 )) && gp_chunk+=X; return r; }' \
    'a sidecar that matches the file but not the bytes read'
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/good.md" \
    'unreadable pattern list fails closed' "${_gp_dir}/does-not-exist"
  # A gitleaks ERROR (exit not 0/9) fails closed, distinct from a secret hit.
  # gitleaks resolves by absolute path: GH_PUBLISH_GITLEAKS reaches it.
  printf '#!/bin/zsh\nexit 3\n' > "${_gp_dir}/stubbin/gitleaks"
  chmod +x "${_gp_dir}/stubbin/gitleaks"
  _hook_run_seam \
    HOME="${_gp_dir}/home" \
    GH_PUBLISH_GITLEAKS="${_gp_dir}/stubbin/gitleaks" \
    GH_PUBLISH_PATTERNS="${_gp_dir}/patterns" \
    GH_PUBLISH_SSH_CONFIG="${_gp_dir}/sshcfg" \
    GH_PUBLISH_NO_GITLEAKS='' GH_PUBLISH_NO_IDENTITY=1 \
    GH_PUBLISH_OS="7.7:99Z999z" \
    -- "${SCRIPT_DIR}/claude/hooks/gh-publish-hook" Bash \
    "gh issue create -t t --body-file ${_gp_dir}/good.md"
  if [[ "${HOOK_SEAM_VERDICT}" == DENY && "${HOOK_SEAM_REASON}" == *'gitleaks error'* ]]; then
    _pass "DENY: gitleaks error exit fails closed"
  else
    _fail "gitleaks error exit did not fail closed"
  fi

  # --- DENY: bypass attempts ---------------------------------------------------
  # Only an unquoted separate-word ~/ is the shell's home. A joined form
  # reaches gh with a literal ~: the reviewed home file exists and no ./~ file
  # does, so the hook must not vet $HOME/<path> in its place.
  _gp_test_expect DENY 'gh pr create -t t --body-file=~/tint/x/issue.md' 'a joined --body-file=~/<path> is not expanded'
  _gp_test_expect DENY 'gh ghpubtest' 'an alias that expands to an inline-body publish'
  _gp_test_expect DENY "GH_PUBLISH_BYPASS=1 gh issue create -t t --body inline" \
    'an env-var prefix has no special effect, the inline body still denies'
  _gp_test_expect DENY '${G:-gh} issue create -t t --body x' 'a dynamic command word denies via the backstop'
  _gp_test_expect DENY 'sh -c "gh issue create -t t --body inline"' 'a publish inside an sh -c string fails closed'
  _gp_test_expect DENY $'bash <<\'EOF\'\ngh issue create -t t --body x\nEOF' 'a heredoc fed to bash is scanned as commands'

  # --- PASS: false-positive guards ---------------------------------------------
  _gp_test_expect PASS "gh issue create -t t --body-file ${_gp_dir}/good.md" 'a reviewed body with an Environment section'
  _gp_test_expect PASS 'gh issue view 268 --repo o/r' 'gh issue view (read)'
  _gp_test_expect PASS 'gh api -X GET repos/o/r/issues -f state=open' 'an explicit -X GET with fields is a read'

  # --- The hook as its own process ----------------------------------------------
  # An exported HOOK_PRE_DISPATCH=1 must not make a standalone hook skip: it
  # reads stdin, since ZSH_EVAL_CONTEXT lacks :file when exec'd. The seam
  # variables here say Read with no command, so a hook that trusted them
  # would let the inline body through.
  local gp_env_out
  gp_env_out="$( (export HOOK_PRE_DISPATCH=1 HOOK_PRE_TOOL=Read HOOK_PRE_COMMAND=''
    _gp_test_run 'gh issue create -t t --body inline') )"
  if [[ "$(_hook_verdict "${gp_env_out}")" == DENY ]]; then
    _pass "DENY (standalone): an exported HOOK_PRE_DISPATCH=1 does not skip the hook"
  else
    _fail "an exported HOOK_PRE_DISPATCH=1 made the standalone hook skip"
  fi

  gp_env_out="$(printf '%s' 'not json' \
    | HOME="${_gp_dir}/home" GH_PUBLISH_PATTERNS="${_gp_dir}/patterns" \
      GH_PUBLISH_SSH_CONFIG="${_gp_dir}/sshcfg" GH_PUBLISH_NO_GITLEAKS=1 \
      GH_PUBLISH_NO_IDENTITY=1 /bin/zsh "${SCRIPT_DIR}/claude/hooks/gh-publish-hook")"
  if [[ -z "${gp_env_out}" ]]; then
    _pass "fail-open (standalone): an unparseable payload is allowed through"
  else
    _fail "fail-open: an unparseable payload produced a verdict"
  fi

  /bin/rm -rf "${_gp_dir}"
  trap - EXIT
}
