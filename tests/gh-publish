#!/bin/zsh
# dotfiles/tests/gh-publish
#
# Behavioural test for claude/gh-publish-hook — the PreToolUse gate on public
# GitHub writes (gh issue/pr/release create|edit|comment, gh api writes).
# Feeds commands as stdin JSON and asserts DENY vs PASS across the five check
# layers: secrets (gitleaks), PII denylist + SSH aliases, hard-wrap, .reviewed
# sidecar, and the issue '## Environment' section.
#
# Fixture tokens are assembled at run time so this file never contains a
# PII-shaped or secret-shaped literal (same convention as tests/pii-hook).
# The PII/ssh sources are injected via the hook's GH_PUBLISH_PATTERNS /
# GH_PUBLISH_SSH_CONFIG seams; gitleaks is disabled via GH_PUBLISH_NO_GITLEAKS
# except in the dedicated gitleaks cases.
#
# Run: ./test gh-publish    (or ./test for the full suite)
#
# ShellCheck: lint with `shellcheck --shell=bash tests/gh-publish`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib
# shellcheck disable=SC2154  # SCRIPT_DIR is set by the sourcing dispatcher

function _gp_test_run {
  # Hook stdout for Bash command $1; $2 optionally overrides the pattern file,
  # $3 the NO_GITLEAKS seam, $4 the NO_IDENTITY seam (defaults isolate both).
  jq -n --arg c "$1" '{tool_name:"Bash", tool_input:{command:$c}}' \
    | GH_PUBLISH_PATTERNS="${2:-${_gp_dir}/patterns}" \
      GH_PUBLISH_SSH_CONFIG="${_gp_dir}/sshcfg" \
      GH_PUBLISH_NO_GITLEAKS="${3-1}" \
      GH_PUBLISH_NO_IDENTITY="${4-1}" \
      GH_PUBLISH_OS="7.7:99Z999z" \
      /bin/zsh "${SCRIPT_DIR}/claude/gh-publish-hook"
}

function _gp_test_review {
  # Write a hash-bound review sidecar for body file $1.
  printf 'reviewed-by: test 2026-08-03 sha256:%s\n' \
    "$(shasum -a 256 "$1" | cut -d' ' -f1)" > "$1.reviewed"
}

function _gp_test_expect {
  local want="$1" cmd="$2" label="$3" out got
  out="$(_gp_test_run "${cmd}" "${4:-}" "${5-1}" "${6-1}")"
  got="$(_hook_verdict "${out}")"
  if [[ "${got}" == "${want}" ]]; then
    _pass "${want}: ${label}"
  else
    _fail "${label} — expected ${want}, got ${got}"
  fi
}

function _gp_test_reason_has {
  local cmd="$1" needle="$2" label="$3"
  if [[ "$(_gp_test_run "${cmd}")" == *"${needle}"* ]]; then
    _pass "reason names ${label}"
  else
    _fail "deny reason for '${label}' does not mention '${needle}'"
  fi
}

function run_gh_publish {
  _section "gh publish gate hook"

  # claude/ is gitignored and synced out of band — absent hook means the sync
  # hasn't reached this machine, not a regression. Skip, don't die.
  if [[ ! -f "${SCRIPT_DIR}/claude/gh-publish-hook" ]]; then
    _skip "claude/gh-publish-hook absent — claude/ not yet synced to this machine"
    return 0
  fi

  if ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
    return
  fi

  local _gp_dir
  _gp_dir="$(mktemp -d "${TMPDIR:-/tmp}/gh-publish-test.XXXXXX")"
  trap '/bin/rm -rf "${_gp_dir}"' EXIT

  # Runtime-assembled fixtures: the PII token and ssh alias never appear
  # verbatim in this file.
  local fixture_token fixture_alias
  fixture_token="FIXTURE_$(printf 'P%s' II)_TOKEN"
  fixture_alias="testalias$(( 90 + 9 ))"
  printf '%s\n' "${fixture_token}" > "${_gp_dir}/patterns"
  printf 'Host %s\n' "${fixture_alias}" > "${_gp_dir}/sshcfg"

  # A clean, reviewed, env-carrying body.
  printf 'One full-width paragraph, no wrapping at all.\n\n## Environment\n\n- test hardware, test OS build\n' \
    > "${_gp_dir}/good.md"
  _gp_test_review "${_gp_dir}/good.md"

  # --- PASS: reads, non-gh, proper publishes ------------------------------
  _gp_test_expect PASS 'ls -la' 'non-gh command'
  _gp_test_expect PASS 'gh issue view 268 --repo o/r' 'gh issue view (read)'
  _gp_test_expect PASS 'gh issue list' 'gh issue list (read)'
  _gp_test_expect PASS 'gh api repos/o/r/issues/268' 'gh api read'
  _gp_test_expect PASS 'gh repo clone o/r' 'gh repo clone'
  _gp_test_expect PASS "gh issue create -t t --body-file ${_gp_dir}/good.md" \
    'issue create: reviewed body with env section'
  _gp_test_expect PASS "gh issue edit 5 --add-label bug" 'issue edit: label only'
  _gp_test_expect PASS 'gh issue create --web' 'issue create --web (human flow)'
  _gp_test_expect PASS "GH_PUBLISH_BYPASS=1 gh issue create -t t --body inline" \
    'bypass prefix'

  # PR and comment bodies do not need an Environment section.
  printf 'No env section here, one line.\n' > "${_gp_dir}/noenv.md"
  _gp_test_review "${_gp_dir}/noenv.md"
  _gp_test_expect PASS "gh pr create -t t --body-file ${_gp_dir}/noenv.md" \
    'pr create: no env section required'
  _gp_test_expect PASS "gh issue comment 5 --body-file ${_gp_dir}/noenv.md" \
    'issue comment: no env section required'

  # --- DENY: review-artifact layer ----------------------------------------
  _gp_test_expect DENY 'gh issue create -t t --body "inline body"' 'inline --body'
  _gp_test_expect DENY 'gh release create v1 --notes "inline notes"' 'inline --notes'
  _gp_test_expect DENY 'gh release create v1 --generate-notes' '--generate-notes'
  _gp_test_expect DENY 'gh issue create -t t' 'create with editor flow (no body-file)'
  _gp_test_expect DENY 'gh issue comment 5' 'comment with editor flow'
  cp "${_gp_dir}/good.md" "${_gp_dir}/nosidecar.md"
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/nosidecar.md" \
    'missing .reviewed sidecar'

  # --- DENY: content layers ------------------------------------------------
  printf 'Contains %s in prose.\n\n## Environment\n\n- b\n' "${fixture_token}" \
    > "${_gp_dir}/pii.md"
  _gp_test_review "${_gp_dir}/pii.md"
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/pii.md" \
    'PII token in body'

  printf 'Mentions %s host.\n\n## Environment\n\n- b\n' "${fixture_alias}" \
    > "${_gp_dir}/alias.md"
  _gp_test_review "${_gp_dir}/alias.md"
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/alias.md" \
    'SSH alias in body'

  _gp_test_expect DENY \
    "gh issue edit 5 --title 'about ${fixture_token}'" 'PII token in title'

  printf 'This paragraph is wrapped\nacross two lines badly.\n\n## Environment\n\n- b\n' \
    > "${_gp_dir}/wrap.md"
  _gp_test_review "${_gp_dir}/wrap.md"
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/wrap.md" \
    'hard-wrapped paragraph'

  # Wrapped text inside a code fence is fine.
  printf 'Intro line.\n\n\x60\x60\x60\nwrapped\ninside fence\n\x60\x60\x60\n\n## Environment\n\n- b\n' \
    > "${_gp_dir}/fence.md"
  _gp_test_review "${_gp_dir}/fence.md"
  _gp_test_expect PASS "gh issue create -t t --body-file ${_gp_dir}/fence.md" \
    'wrap inside code fence tolerated'

  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/noenv.md" \
    'issue create without env section'

  # --- Review binding and GFM footguns -------------------------------------
  # The append must form its own paragraph (leading blank line): appended
  # prose directly after the env bullet trips the WRAP check and would mask a
  # broken hash check — found by mutation testing 2026-08-03.
  cp "${_gp_dir}/good.md" "${_gp_dir}/stale.md"
  _gp_test_review "${_gp_dir}/stale.md"
  printf '\nEdited after review.\n' >> "${_gp_dir}/stale.md"
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/stale.md" \
    'sidecar stale after post-review edit'

  printf 'Please ping @octocat about this.\n\n## Environment\n\n- b\n' \
    > "${_gp_dir}/mention.md"
  _gp_test_review "${_gp_dir}/mention.md"
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/mention.md" \
    'bare @-mention'

  printf 'The \x60@property\x60 decorator and <a@b.com> are fine.\n\n## Environment\n\n- b\n' \
    > "${_gp_dir}/mentionok.md"
  _gp_test_review "${_gp_dir}/mentionok.md"
  _gp_test_expect PASS "gh issue create -t t --body-file ${_gp_dir}/mentionok.md" \
    'backticked mention and email tolerated'

  {
    printf 'Log dump below.\n\n\x60\x60\x60\n'
    local i
    for i in {1..70}; do printf 'log line %d\n' "${i}"; done
    printf '\x60\x60\x60\n\n## Environment\n\n- b\n'
  } > "${_gp_dir}/biglog.md"
  _gp_test_review "${_gp_dir}/biglog.md"
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/biglog.md" \
    'oversized fence outside <details>'

  {
    printf '<details><summary>log</summary>\n\n\x60\x60\x60\n'
    for i in {1..70}; do printf 'log line %d\n' "${i}"; done
    printf '\x60\x60\x60\n</details>\n\n## Environment\n\n- b\n'
  } > "${_gp_dir}/biglogok.md"
  _gp_test_review "${_gp_dir}/biglogok.md"
  _gp_test_expect PASS "gh issue create -t t --body-file ${_gp_dir}/biglogok.md" \
    'oversized fence collapsed in <details>'

  if [[ -n "${USER:-}" && "${USER}" != *[^[:alnum:]_-]* ]]; then
    printf 'Log at /Users/%s/Library/Logs/x.log\n\n## Environment\n\n- b\n' \
      "${USER}" > "${_gp_dir}/ident.md"
    _gp_test_review "${_gp_dir}/ident.md"
    _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/ident.md" \
      'runtime identity watchlist catches USER' '' 1 ''
  else
    _skip "USER unset or regex-unsafe — identity-watchlist case skipped"
  fi

  # --- Identifier tokens and env ground truth ------------------------------
  local real_uuid real_mac
  real_uuid="$(uuidgen | tr '[:upper:]' '[:lower:]')"
  real_mac="$(printf '0a%s1b%s2c%s3d%s4e%s5f' : : : : :)"
  printf 'Quarantine entry %s seen.\n\n## Environment\n\n- b\n' "${real_uuid}" \
    > "${_gp_dir}/uuid.md"
  _gp_test_review "${_gp_dir}/uuid.md"
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/uuid.md" \
    'real-shaped UUID in body'

  printf 'Interface at %s reported.\n\n## Environment\n\n- b\n' "${real_mac}" \
    > "${_gp_dir}/mac.md"
  _gp_test_review "${_gp_dir}/mac.md"
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/mac.md" \
    'real-shaped MAC in body'

  printf 'Placeholder %s and %s pass.\n\n## Environment\n\n- b\n' \
    '00000000-0000-0000-0000-000000000000' 'aa:bb:cc:dd:ee:ff' \
    > "${_gp_dir}/placeholder.md"
  _gp_test_review "${_gp_dir}/placeholder.md"
  _gp_test_expect PASS "gh issue create -t t --body-file ${_gp_dir}/placeholder.md" \
    'documentation placeholders tolerated'

  printf 'Body.\n\n## Environment\n\n- MacBook, macOS 6.6 (88X8888)\n' \
    > "${_gp_dir}/wrongos.md"
  _gp_test_review "${_gp_dir}/wrongos.md"
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/wrongos.md" \
    'env macOS version does not match live sw_vers'

  printf 'Body.\n\n## Environment\n\n- MacBook, macOS 7.7 (99Z999z)\n' \
    > "${_gp_dir}/rightos.md"
  _gp_test_review "${_gp_dir}/rightos.md"
  _gp_test_expect PASS "gh issue create -t t --body-file ${_gp_dir}/rightos.md" \
    'env macOS version matches live sw_vers'

  # --- DENY: escape hatches and fail-closed --------------------------------
  _gp_test_expect DENY 'gh api repos/o/r/issues -f title=x' 'gh api POST via -f'
  _gp_test_expect DENY 'gh api -X PATCH repos/o/r/issues/5 -f body=x' 'gh api PATCH'
  _gp_test_expect DENY 'cd /tmp && gh issue create -t t --body x' \
    'gh after && separator'
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/good.md" \
    'unreadable pattern list fails closed' "${_gp_dir}/does-not-exist"

  # --- Secrets layer (gitleaks), skipped when not installed ----------------
  if command -v gitleaks &>/dev/null; then
    local tok_prefix="ghp_"
    local tok_body
    tok_body="$(openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 36)"
    printf 'Log excerpt: token=%s%s\n\n## Environment\n\n- b\n' \
      "${tok_prefix}" "${tok_body}" > "${_gp_dir}/secret.md"
    _gp_test_review "${_gp_dir}/secret.md"
    _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/secret.md" \
      'gitleaks catches a token shape' '' ''
  else
    _skip "gitleaks not installed — secrets-layer case skipped"
  fi

  # --- Review-round regressions (adversarial review 2026-08-03) ------------
  # F1: backslash continuation must be joined before parsing.
  _gp_test_expect DENY "gh issue edit 5 \\"$'\n'"  --body-file ${_gp_dir}/pii.md" \
    'continued edit --body-file is scanned (F1)'
  _gp_test_expect PASS "gh issue create -t t \\"$'\n'"  --body-file ${_gp_dir}/good.md" \
    'continued create with clean body passes (F1)'

  # F2: joined short flags.
  _gp_test_expect DENY "gh issue edit 5 -b${fixture_token}" \
    'joined -bBODY inline is denied (F2)'
  _gp_test_expect DENY "gh issue create -t${fixture_token} --body-file ${_gp_dir}/good.md" \
    'joined -tTITLE is PII-scanned (F2)'

  # F3: leading global flags before the subcommand.
  _gp_test_expect DENY 'gh -R o/r issue create -t t --body x' \
    'global -R before subcommand still dispatched (F3)'

  # F4/F5: gh api option values must not steal the path; graphql is covered.
  _gp_test_expect DENY "gh api -H 'Accept: application/vnd.github+json' repos/o/r/issues -f title=x" \
    'gh api with -H header before path (F4)'
  _gp_test_expect DENY "gh api graphql -f query=x" 'gh api graphql write (F5)'

  # F6: pr review publishes a body.
  _gp_test_expect DENY 'gh pr review 5 --approve --body lgtm' \
    'pr review inline body denied (F6)'
  _gp_test_expect PASS 'gh pr review 5 --approve' \
    'bare pr review --approve passes (F6)'

  # F8: an emptied PII denylist must fail closed even with ssh aliases present.
  : > "${_gp_dir}/empty-patterns"
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/good.md" \
    'empty PII denylist fails closed despite ssh aliases (F8)' \
    "${_gp_dir}/empty-patterns"

  # F10: a directory as --body-file must deny, not slip through unhashed.
  mkdir -p "${_gp_dir}/dirbody.md"
  printf 'r\n' > "${_gp_dir}/dirbody.md.reviewed"
  _gp_test_expect DENY "gh pr create -t t --body-file ${_gp_dir}/dirbody.md" \
    'directory body-file denied (F10)'

  # P1/P2/P4/P5: legitimate markdown must not deny.
  printf -- '- top item\n  - nested item\n    continuation is a wrap though\n\n## Environment\n\n- b\n' \
    > "${_gp_dir}/nested.md"
  _gp_test_review "${_gp_dir}/nested.md"
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/nested.md" \
    'wrapped list continuation still denied (P1 guard)'
  printf -- '- top item\n  - nested item\n  - second nested\n\n## Environment\n\n- b\n' \
    > "${_gp_dir}/nested2.md"
  _gp_test_review "${_gp_dir}/nested2.md"
  _gp_test_expect PASS "gh issue create -t t --body-file ${_gp_dir}/nested2.md" \
    'nested bullets pass (P1)'

  printf '<details>\n<summary>Full log</summary>\n\nOne line inside.\n\n</details>\n\n## Environment\n\n- b\n' \
    > "${_gp_dir}/details.md"
  _gp_test_review "${_gp_dir}/details.md"
  _gp_test_expect PASS "gh issue create -t t --body-file ${_gp_dir}/details.md" \
    'multi-line details/summary block passes (P2)'

  printf 'Intro.\n\n~~~\nwrapped\ninside tilde fence\n~~~\n\n## Environment\n\n- b\n' \
    > "${_gp_dir}/tilde.md"
  _gp_test_review "${_gp_dir}/tilde.md"
  _gp_test_expect PASS "gh issue create -t t --body-file ${_gp_dir}/tilde.md" \
    'tilde fence recognised (P4)'

  printf 'Setext Title\n============\n\nOne paragraph line.\n\n## Environment\n\n- b\n' \
    > "${_gp_dir}/setext.md"
  _gp_test_review "${_gp_dir}/setext.md"
  _gp_test_expect PASS "gh issue create -t t --body-file ${_gp_dir}/setext.md" \
    'setext heading underline passes (P5)'

  # --- Coverage round 2: parse forms, error paths, seams -------------------
  # Equals-joined flag forms; discriminators chosen so a parse failure flips
  # the verdict (an unparsed -t= on edit would PASS, not DENY differently).
  _gp_test_expect DENY "gh issue create --title=${fixture_token} --body-file ${_gp_dir}/good.md" \
    '--title= equals form is PII-scanned'
  _gp_test_expect DENY "gh issue edit 5 -t=${fixture_token}" \
    '-t= joined equals form is PII-scanned'
  _gp_test_reason_has "gh issue create -t t --body-file=${_gp_dir}/pii.md" \
    'PII pattern hit' '--body-file= equals form resolves the file'
  _gp_test_expect DENY 'gh api -XPOST repos/o/r/issues' '-XPOST joined method'
  _gp_test_expect DENY $'cd /tmp\ngh issue create -t t --body x' \
    'gh on a later real-newline line'

  # Release happy path: notes-file + sidecar, no env section required.
  _gp_test_expect PASS "gh release create v1.0 --notes-file ${_gp_dir}/noenv.md" \
    'release create with reviewed notes-file'

  # Env build-string branch in isolation (product version correct).
  printf 'Body.\n\n## Environment\n\n- MacBook, macOS 7.7 (88X8888)\n' \
    > "${_gp_dir}/wrongbuild.md"
  _gp_test_review "${_gp_dir}/wrongbuild.md"
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/wrongbuild.md" \
    'env build string does not match live build'

  # Invalid ERE in the denylist must fail closed, not silently disable.
  printf 'a{3,1}\n' > "${_gp_dir}/bad-regex"
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/good.md" \
    'invalid ERE in denylist fails closed' "${_gp_dir}/bad-regex"

  # A gitleaks ERROR (exit not 0/9) must fail closed — distinct from a
  # finding. gitleaks is resolved by absolute path (2026-09-25 restore), so
  # a PATH-prepended stub alone no longer reaches it — GH_PUBLISH_GITLEAKS
  # is the seam that does (kept alongside the PATH override for belt/braces).
  mkdir -p "${_gp_dir}/stubbin"
  printf '#!/bin/zsh\nexit 3\n' > "${_gp_dir}/stubbin/gitleaks"
  chmod +x "${_gp_dir}/stubbin/gitleaks"
  local out
  out="$(jq -n --arg c "gh issue create -t t --body-file ${_gp_dir}/good.md" \
      '{tool_name:"Bash", tool_input:{command:$c}}' \
    | PATH="${_gp_dir}/stubbin:${PATH}" \
      GH_PUBLISH_GITLEAKS="${_gp_dir}/stubbin/gitleaks" \
      GH_PUBLISH_PATTERNS="${_gp_dir}/patterns" \
      GH_PUBLISH_SSH_CONFIG="${_gp_dir}/sshcfg" \
      GH_PUBLISH_NO_GITLEAKS='' GH_PUBLISH_NO_IDENTITY=1 \
      GH_PUBLISH_OS="7.7:99Z999z" \
      /bin/zsh "${SCRIPT_DIR}/claude/gh-publish-hook")"
  if [[ "${out}" == *'gitleaks error'* ]]; then
    _pass "DENY: gitleaks error exit fails closed"
  else
    _fail "gitleaks error exit did not fail closed"
  fi

  # Session-env bypass form (the string-prefix form is tested above).
  out="$(jq -n --arg c 'gh issue create -t t --body inline' \
      '{tool_name:"Bash", tool_input:{command:$c}}' \
    | GH_PUBLISH_BYPASS=1 GH_PUBLISH_PATTERNS="${_gp_dir}/patterns" \
      GH_PUBLISH_SSH_CONFIG="${_gp_dir}/sshcfg" \
      /bin/zsh "${SCRIPT_DIR}/claude/gh-publish-hook")"
  if [[ "${out}" != *permissionDecision* ]]; then
    _pass "PASS: session-env bypass"
  else
    _fail "session-env GH_PUBLISH_BYPASS=1 did not bypass"
  fi

  # Hostname half of the identity watchlist (guarded: needs scutil + a
  # regex-safe local hostname).
  local host_ident
  host_ident="$(scutil --get LocalHostName 2>/dev/null)"
  if [[ -n "${host_ident}" && "${host_ident}" != *[^[:alnum:]._-]* ]]; then
    printf 'Seen on %s today.\n\n## Environment\n\n- b\n' "${host_ident}" \
      > "${_gp_dir}/hostident.md"
    _gp_test_review "${_gp_dir}/hostident.md"
    _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/hostident.md" \
      'runtime identity watchlist catches hostname' '' 1 ''
  else
    _skip "no regex-safe LocalHostName — hostname-watchlist case skipped"
  fi

  # Deny reasons must teach the fix.
  _gp_test_reason_has 'gh issue create -t t --body x' '.reviewed' 'the sidecar workflow'
  _gp_test_reason_has "gh issue create -t t --body-file ${_gp_dir}/noenv.md" \
    '## Environment' 'the env-section shape'

  # --- Command-position tokeniser hardening (2026-09-25 restore) ----------
  # md5-guard-hook's normaliser + command-position walk closes the gaps the
  # 2026-08-03 archive left open: quoting/escaping around the gh
  # word, wrapper words, shell reserved words, and gh reachable only through
  # a command substitution. Each fixture below uses an inline --body, which
  # this hook already denies outright — so a DENY here proves gh was
  # actually reached and dispatched, not that some unrelated check tripped.
  _gp_test_expect DENY '"gh" issue create -t t --body inline' \
    'quoted gh command word is still recognised'
  _gp_test_expect DENY 'g\h issue create -t t --body inline' \
    'escaped gh command word is still recognised'
  _gp_test_expect DENY 'command gh issue create -t t --body inline' \
    'gh seen through the command wrapper'
  _gp_test_expect DENY 'env gh issue create -t t --body inline' \
    'gh seen through the env wrapper'
  _gp_test_expect DENY 'timeout 30 gh issue create -t t --body inline' \
    'gh seen through timeout N'
  _gp_test_expect DENY 'if true; then gh issue create -t t --body inline; fi' \
    'gh seen through an if/then reserved word'
  _gp_test_expect DENY '! gh issue create -t t --body inline' \
    'gh seen through a leading ! negation'
  # shellcheck disable=SC2016  # single-quoted literal fixture text, never expanded by this shell — it travels to jq --arg unmodified
  _gp_test_expect DENY 'echo "$(gh issue create -t t --body inline)"' \
    'gh inside a nested command substitution, even inside double quotes'
  # shellcheck disable=SC2016  # single-quoted literal fixture text, never expanded by this shell — it travels to jq --arg unmodified
  _gp_test_expect DENY 'echo `gh issue create -t t --body inline`' \
    'gh inside a backtick command substitution'

  # The next four are fail-closed on content this tokeniser cannot resolve
  # to real gh arguments (an eval/sh -c string, xargs, a variable command
  # word) — denied on sight, never scanned, per the dedicated reason text.
  _gp_test_expect DENY 'eval "gh issue create -t t --body inline"' \
    'gh publish verb inside an eval argument fails closed'
  _gp_test_reason_has 'eval "gh issue create -t t --body inline"' \
    'run gh directly so the body can be checked' 'the eval fail-closed reason'
  _gp_test_expect DENY 'sh -c "gh issue create -t t --body inline"' \
    'gh publish verb inside an sh -c string fails closed'
  _gp_test_expect DENY 'echo x | xargs gh issue create -t t --body inline' \
    'gh publish verb after xargs fails closed'
  # shellcheck disable=SC2016  # single-quoted literal fixture text, never expanded by this shell — it travels to jq --arg unmodified
  _gp_test_expect DENY 'G=gh; $G issue create -t t --body inline' \
    'gh publish verb as a variable command word fails closed'

  # A script FILE (not a -c string) handed to bash/sh/zsh is an accepted,
  # documented gap, not a fail-closed case — must not over-deny.
  _gp_test_expect PASS 'bash /tmp/does-not-exist-review-script.sh' \
    'bash running a script file (not -c) is an accepted gap, not denied'

  # --- Assignments, continuations and comments (2026-09-25 restore) -----
  # _gp_classify_segment's VAR=value skip must not require a
  # slash-free value — that exclusion let exactly these two spellings land
  # the assignment itself as the command word and skip every check.
  _gp_test_expect DENY 'GH_REPO=owner/repo gh issue create -t t --body x' \
    'GH_REPO=owner/repo assignment prefix does not mask gh'
  _gp_test_expect DENY 'PATH=/usr/bin gh issue create -t t --body x' \
    'PATH=/usr/bin assignment prefix does not mask gh'
  _gp_test_expect DENY 'FOO=a/b BAR=baz gh issue create -t t --body x' \
    'second-position assignment prefix with a slash-shaped value'

  # A backslash-newline continuation must be removed entirely (real
  # shell semantics), not replaced with a space — a continuation landing
  # inside the command word itself, or inside a verb, must still resolve.
  _gp_test_expect DENY "g\\"$'\n'"h issue create -t t --body x" \
    'mid-word continuation in the command word resolves to gh'
  _gp_test_expect DENY "gh issue cre\\"$'\n'"ate -t t --body x" \
    'mid-word continuation inside the verb resolves to create'

  # An unquoted, word-start '#' begins a comment — the hook must not
  # scan past it, but must still check anything gh-shaped BEFORE it, and
  # must not treat a gh publish visible only inside a comment as reachable.
  _gp_test_expect PASS "gh issue create -t t --body-file ${_gp_dir}/good.md # -b inline" \
    'trailing comment after a reviewed body-file publish is not denied'
  _gp_test_expect DENY 'gh issue create -t t --body x # comment' \
    'inline body before a trailing comment is still denied'
  _gp_test_expect PASS 'echo done # gh issue create --body x' \
    'a gh publish visible only inside a comment is never run, so not denied'
  # shellcheck disable=SC2016  # single-quoted literal fixture text, never expanded by this shell — it travels to jq --arg unmodified
  _gp_test_expect DENY 'echo ${#x}; gh issue create -t t --body x' \
    '${#x} array-length form is not mistaken for a word-start # comment'

  # --- Verb-list broadening (close/reopen/merge, gist, release upload) ----
  _gp_test_expect DENY 'gh issue close 5 --comment done' \
    'issue close with inline --comment text'
  _gp_test_expect DENY 'gh pr reopen 5 -c done' \
    'pr reopen with inline -c text'
  _gp_test_expect DENY 'gh pr merge 5 --subject done' \
    'pr merge with inline --subject text'
  _gp_test_expect PASS 'gh issue close 5' \
    'issue close with no text needs no review'
  _gp_test_expect DENY 'gh gist create notes.md' \
    'gh gist create denied outright'
  _gp_test_expect DENY 'gh release upload v1 asset.zip' \
    'gh release upload denied outright'
  _gp_test_expect DENY \
    'gh api -X PUT repos/o/r/contents/path/to/file.md -f message=m -f content=c' \
    'gh api PUT to a contents path'

  # --- Reads still pass, including through a command substitution --------
  # shellcheck disable=SC2016  # single-quoted literal fixture text, never expanded by this shell — it travels to jq --arg unmodified
  _gp_test_expect PASS 'echo "$(gh issue view 268 --repo o/r)"' \
    'gh issue view inside a command substitution is not over-blocked'
  _gp_test_expect PASS 'gh pr list' 'gh pr list (read)'

  # --- Dispatch dequoting and the literal-arguments rule (2026-09-25) ---
  # Dispatch must de-quote every word before matching subcommand/verb,
  # and must skip gh's global -R/--repo/--hostname wherever it sits before
  # the verb, not only at the very front.
  _gp_test_expect DENY 'gh "issue" create -t t --body x' \
    'quoted "issue" subcommand word is still recognised'
  _gp_test_expect DENY 'gh issue "create" -t t --body x' \
    'quoted "create" verb word is still recognised'
  _gp_test_expect DENY 'gh issue --repo o/r create -t t --body x' \
    'global --repo BETWEEN subcommand and verb is still skipped'

  # Opaque command words — a variable command word matched by
  # "contains $" not "starts with $", sh/bash/zsh/dash/ksh with ANY
  # single-dash flag cluster containing c (not only the exact word -c), and
  # the eval/opaque-context probe must also catch a gh api WRITE shape.
  # shellcheck disable=SC2016  # single-quoted literal fixture text, never expanded by this shell — it travels to jq --arg unmodified
  _gp_test_expect DENY 'G=gh; $G issue create -t t --body x' \
    'variable command word still resolves via the opaque-context probe'
  _gp_test_expect DENY 'sh -lc "gh issue create -t t --body x"' \
    'combined -lc flag cluster is opaque, not an accepted script-file gap'
  _gp_test_expect DENY 'eval "gh api repos/o/r/issues -f title=x"' \
    'gh api write shape inside an eval argument fails closed'

  # A real gh publish must run alone, with literal
  # arguments. A dynamic value the hook cannot see the resolved content of,
  # and a same-call rewrite of the reviewed file before gh reads it, both
  # deny even though the body-file/sidecar checks alone would not catch
  # them. The CONTROL alongside each proves the same call, run genuinely
  # solo with a literal path, still passes.
  # shellcheck disable=SC2016  # single-quoted literal fixture text, never expanded by this shell — it travels to jq --arg unmodified
  _gp_test_expect DENY "gh pr create -t \"\$SECRET\" --body-file ${_gp_dir}/good.md" \
    'a live $SECRET in the title denies even with a clean reviewed body'
  _gp_test_expect DENY "printf 'x' > ${_gp_dir}/noenv.md; gh pr comment 1 --body-file ${_gp_dir}/noenv.md" \
    'a same-call rewrite of the reviewed file before gh reads it denies'
  _gp_test_expect PASS "gh pr comment 1 --body-file ${_gp_dir}/noenv.md" \
    'the same reviewed body-file publish, run genuinely solo, still passes (control)'

  # release new (create alias), gist edit (not just create), and a
  # positional asset argument on release create (an unreviewed upload, same
  # as gh release upload).
  _gp_test_expect DENY 'gh release new v1 --notes x' \
    'release new is the create alias, so inline --notes still denies'
  _gp_test_expect DENY 'gh gist edit abc --filename x file.md' \
    'gh gist edit denied outright, same as gist create'
  _gp_test_expect DENY "gh release create v1 --notes-file ${_gp_dir}/noenv.md asset.zip" \
    'a positional asset after the tag on release create denies'

  # An explicit GET method is a read even when field flags are present.
  _gp_test_expect PASS 'gh api -X GET repos/o/r/issues -f state=open' \
    'explicit -X GET with fields is still a read'
  _gp_test_expect PASS 'gh api --method GET repos/o/r/issues -f state=open' \
    'explicit --method GET with fields is still a read'

  # Reads stay allowed, including in forms not previously exercised.
  _gp_test_expect PASS 'gh issue view 5' 'gh issue view'
  _gp_test_expect PASS 'gh pr list' 'gh pr list'
  _gp_test_expect PASS 'gh api repos/o/r/issues' 'gh api read'
  _gp_test_expect PASS 'gh search issues x' 'gh search is a read'
  _gp_test_expect PASS 'ls -la' 'non-gh command'
  # shellcheck disable=SC2016  # single-quoted literal fixture text, never expanded by this shell — it travels to jq --arg unmodified
  _gp_test_expect PASS 'git commit -m "gh issue create --body x"' \
    'quoted data in a non-opaque command stays data, not a command'
  _gp_test_expect PASS 'echo done # gh issue create --body x' \
    'a gh publish visible only inside a comment is not run'

  # --- Dynamic command word backstop (2026-09-25) ------------------------
  # ${G}/${G:-gh}/$(echo gh) each land their literal "gh" text on
  # the far side of a command-position split this tokeniser itself
  # introduces (`${`/`}` and `$(`/`)` are split points regardless of
  # context), so neither resulting segment alone ever resolves to a literal
  # gh word or looks like a publish call on its own. The coarse backstop
  # denies when NO segment anywhere dispatched a real gh command, the whole
  # RAW command still textually resembles a publish call, and the command
  # contains a live (unquoted/double-quoted) $ or backtick anywhere.
  # shellcheck disable=SC2016  # single-quoted literal fixture text, never expanded by this shell — it travels to jq --arg unmodified
  _gp_test_expect DENY '${G} issue create -t t --body x' \
    'brace-expansion dynamic command word denies via the backstop'
  # shellcheck disable=SC2016  # single-quoted literal fixture text, never expanded by this shell — it travels to jq --arg unmodified
  _gp_test_expect DENY '${G:-gh} issue create -t t --body x' \
    'default-value brace expansion dynamic command word denies via the backstop'
  # shellcheck disable=SC2016  # single-quoted literal fixture text, never expanded by this shell — it travels to jq --arg unmodified
  _gp_test_expect DENY '$(echo gh) issue create -t t --body x' \
    'command-substitution dynamic command word denies via the backstop'

  # The backstop must NOT fire once a real gh call was already found and
  # dispatched normally (even a bare read, and even alongside an unrelated
  # live expansion elsewhere in the same call), when there is no live
  # expansion anywhere in the command, or when the only $ present is inert
  # (single-quoted).
  # shellcheck disable=SC2016  # single-quoted literal fixture text, never expanded by this shell — it travels to jq --arg unmodified
  _gp_test_expect PASS 'echo $HOME; gh pr list' \
    'a real dispatched gh read elsewhere in the call suppresses the backstop'
  # shellcheck disable=SC2016  # single-quoted literal fixture text, never expanded by this shell — it travels to jq --arg unmodified
  _gp_test_expect PASS 'gh issue view $N' \
    'a live expansion inside an already-dispatched gh read does not trigger the backstop'
  _gp_test_expect PASS 'git commit -m "gh issue create --body x"' \
    'no live expansion at all does not trigger the backstop'
  _gp_test_expect PASS "echo '\$x issue create'" \
    'a single-quoted, inert $ does not trigger the backstop'
  _gp_test_expect PASS 'gh pr list | head' \
    'a real dispatched gh read piped to another command suppresses the backstop'

  # --- Quoted flags, joined -R, aliases, --attach, discussions (2026-09-25)
  # A quoted flag spelling must still match — de-quote BEFORE matching,
  # not only when extracting an already-matched flag's value.
  _gp_test_expect DENY 'gh issue edit 5 "--body" "unreviewed text"' \
    'quoted --body flag still recognised as inline'
  _gp_test_expect DENY 'gh api repos/o/r/issues "-f" title=x' \
    'quoted -f flag still recognised as a field write'

  # The joined -R<value> short-flag form must be skipped the same as
  # the separate `-R <value>` form.
  _gp_test_expect DENY 'gh -Ro/r issue create -t t --body x' \
    'joined -Ro/r global flag is still skipped before the subcommand'

  # `issue new`/`pr new` are create aliases too, same as `release new`.
  _gp_test_expect DENY 'gh issue new -t t --body x' \
    'issue new is the create alias, so inline --body still denies'
  _gp_test_expect DENY 'gh pr new -t t --body x' \
    'pr new is the create alias, so inline --body still denies'

  # --attach uploads a file with no scanning path in this hook, on both
  # a fresh publish (edit) and a reply (comment).
  _gp_test_expect DENY 'gh issue edit 5 --attach ./login.png' \
    '--attach on issue edit denies outright'
  _gp_test_expect DENY 'gh issue comment 5 --attach ./login.png' \
    '--attach on issue comment denies outright'

  # gh discussion is a write-capable preview group with no scanning
  # path at all — every verb except the two reads (list, view) denies.
  _gp_test_expect DENY \
    'gh discussion create --repo o/r --title t --category General --body x' \
    'gh discussion create denies outright, no scanning path exists'

  # The dynamic-command-word backstop must stay armed even when a real
  # gh READ was already dispatched earlier in the same compound call — only
  # a dispatched PUBLISH may suppress it.
  # shellcheck disable=SC2016  # single-quoted literal fixture text, never expanded by this shell — it travels to jq --arg unmodified
  _gp_test_expect DENY 'gh pr list; ${G:-gh} issue create -t t --body x' \
    'a dispatched gh READ does not suppress the backstop for a later dynamic word'

  # New PASS coverage: reads must stay allowed through all of the above.
  _gp_test_expect PASS 'gh discussion list --repo o/r' \
    'gh discussion list is a read'
  _gp_test_expect PASS 'gh issue view 5 "--json" title' \
    'a quoted read-only flag does not turn a read into anything else'
  _gp_test_expect PASS 'gh -Ro/r pr list' \
    'joined -Ro/r global flag before a read verb still passes'

  /bin/rm -rf "${_gp_dir}"
  trap - EXIT
}
