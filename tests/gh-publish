#!/bin/zsh
# dotfiles/tests/gh-publish
#
# Behavioural test for claude/hooks/gh-publish-hook, the PreToolUse gate on public
# GitHub writes (gh issue/pr/release create|edit|comment, gh api writes).
# Commands go in as stdin JSON; asserts DENY vs PASS across the five layers:
# secrets (gitleaks), PII denylist + SSH aliases, hard-wrap, .reviewed
# sidecar, issue '## Environment' section.
# Fixture tokens are assembled at run time: no PII- or secret-shaped literal
# (same convention as tests/pii-hook).
# Seams: GH_PUBLISH_PATTERNS / GH_PUBLISH_SSH_CONFIG inject the PII/ssh
# sources; GH_PUBLISH_NO_GITLEAKS disables gitleaks outside its own cases.
# Since 2026-10-24 the verdict cases run the guard through the pretool-dispatch
# seam (_hook_run_seam in tests/lib: sourced in a subshell, HOOK_PRE_* set,
# DENY<US>reason), the path live sessions use. The suite seams (HOME,
# GH_CONFIG_DIR, GH_PUBLISH_*) go to the helper as leading NAME=value words and
# the deny text is read from HOOK_SEAM_REASON, not from JSON. This guard still
# starts a child per DENY (gh alias, sw_vers, shasum), so the gain is smaller
# than for a pure-zsh guard. These cases stay standalone (the hook as its own
# process, JSON on stdin) through _gp_test_run: a few DENY and PASS verdicts,
# the exported HOOK_PRE_DISPATCH=1 case (a standalone hook must not skip, as
# ZSH_EVAL_CONTEXT lacks :file), and the empty, malformed and non-Bash payloads
# (stdin and jq path). tests/test-helpers mocks _gp_test_run and
# _hook_run_seam, then calls _gp_test_expect: keep both names.
#
# Run: ./test gh-publish
# ShellCheck: lint with `shellcheck --shell=bash tests/gh-publish`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib
# shellcheck disable=SC2154  # SCRIPT_DIR is set by the sourcing dispatcher

function _gp_test_run {
  # Hook stdout for Bash command $1; $2 optionally overrides the pattern file,
  # $3 the NO_GITLEAKS seam, $4 the NO_IDENTITY seam (defaults isolate both).
  # GH_CONFIG_DIR (2026-09-25) points at the sandbox gh config below, so alias
  # resolution never reads the real ~/.config/gh.
  # HOME points into the sandbox so the hook's body snapshots (under
  # ~/Library/Caches/gh-publish) never touch the real home.
  jq -n --arg c "$1" '{tool_name:"Bash", tool_input:{command:$c}}' \
    | HOME="${_gp_dir}/home" \
      GH_PUBLISH_PATTERNS="${2:-${_gp_dir}/patterns}" \
      GH_PUBLISH_SSH_CONFIG="${_gp_dir}/sshcfg" \
      GH_PUBLISH_NO_GITLEAKS="${3-1}" \
      GH_PUBLISH_NO_IDENTITY="${4-1}" \
      GH_PUBLISH_OS="7.7:99Z999z" \
      GH_CONFIG_DIR="${_gp_dir}/gh" \
      GH_PUBLISH_GH="${_gp_dir}/stubbin/gh" \
      /bin/zsh "${SCRIPT_DIR}/claude/hooks/gh-publish-hook"
}

function _gp_test_seam {
  # Seam run of the guard for Bash command $1, with the same sandbox seams and
  # argument defaults as _gp_test_run. The verdict lands in HOOK_SEAM_VERDICT
  # and the deny text in HOOK_SEAM_REASON. Never call this inside $(...).
  # ${_gp_dir-}: test-helpers calls the expect functions with no sandbox.
  _hook_run_seam \
    HOME="${_gp_dir-}/home" \
    GH_PUBLISH_PATTERNS="${2:-${_gp_dir-}/patterns}" \
    GH_PUBLISH_SSH_CONFIG="${_gp_dir-}/sshcfg" \
    GH_PUBLISH_NO_GITLEAKS="${3-1}" \
    GH_PUBLISH_NO_IDENTITY="${4-1}" \
    GH_PUBLISH_OS="7.7:99Z999z" \
    GH_CONFIG_DIR="${_gp_dir-}/gh" \
    GH_PUBLISH_GH="${_gp_dir-}/stubbin/gh" \
    -- "${SCRIPT_DIR}/claude/hooks/gh-publish-hook" Bash "$1"
}

function _gp_test_inject_expect {
  # $1 = verdict, $2 = Bash command, $3 = zsh function definition run before
  # the guard is sourced (it shadows a builtin), $4 = label. Fault injection
  # for reads the suite cannot provoke from a real file. The definition is
  # evaluated here, so the seam subshell inherits it, and removed afterwards.
  local want="$1" cmd="$2" inject="$3" label="$4"
  eval "${inject}"
  _gp_test_seam "${cmd}"
  unfunction sysread 2>/dev/null || :
  unset gp_calls gp_chunk 2>/dev/null || :
  if [[ "${HOOK_SEAM_VERDICT}" == "${want}" ]]; then
    _pass "${want}: ${label}"
  else
    _fail "${label} — expected ${want}, got ${HOOK_SEAM_VERDICT}"
  fi
}

function _gp_repeat {
  # REPLY = string $2 repeated $1 times, by doubling. Pure zsh, so it starts no
  # process and counts bytes the same under any locale.
  local -i n="$1"
  local unit="$2"
  REPLY=''
  while (( n > 0 )); do
    (( n & 1 )) && REPLY+="${unit}"
    unit+="${unit}"
    n=$(( n >> 1 ))
  done
}

function _gp_test_review_all {
  # Write a hash-bound review sidecar for every body file in "$@" with ONE
  # shasum call (one call per body before 2026-11-04). No fixture path holds a
  # newline or two spaces in a row, so each output line is "<hash>  <path>".
  local sums line
  sums="$(shasum -a 256 "$@")"
  while IFS= read -r line; do
    printf 'reviewed-by: test 2026-08-03 sha256:%s\n' "${line%% *}" > "${line#*  }.reviewed"
  done <<< "${sums}"
}

function _gp_test_expect {
  local want="$1" cmd="$2" label="$3"
  _gp_test_seam "${cmd}" "${4:-}" "${5-1}" "${6-1}"
  if [[ "${HOOK_SEAM_VERDICT}" == "${want}" ]]; then
    _pass "${want}: ${label}"
  else
    _fail "${label} — expected ${want}, got ${HOOK_SEAM_VERDICT} (${HOOK_SEAM_OUT:0:120})"
  fi
}

function _gp_test_expect_standalone {
  # The same check through the hook as its own process (JSON on stdin, the
  # hook's jq, the deny object), kept for a few cases per verdict.
  local want="$1" cmd="$2" label="$3" out got
  out="$(_gp_test_run "${cmd}" "${4:-}" "${5-1}" "${6-1}")"
  got="$(_hook_verdict "${out}")"
  if [[ "${got}" == "${want}" ]]; then
    _pass "${want} (standalone): ${label}"
  else
    _fail "standalone ${label} — expected ${want}, got ${got}"
  fi
}

function _gp_test_terse {
  # Deny text for command $1: one line per violation, at most 120 characters
  # each, no numbering, no header line and no closing paragraph.
  local cmd="$1" label="$2" reason line bad='' seen=$'\n'
  _gp_test_seam "${cmd}"
  if [[ "${HOOK_SEAM_VERDICT}" != DENY ]]; then
    _fail "terse deny text: ${label} — expected one valid DENY, got ${HOOK_SEAM_VERDICT}"
    return
  fi
  reason="${HOOK_SEAM_REASON}"
  while IFS= read -r line; do
    if [[ -z "${line}" ]]; then
      bad="an empty line"
    elif (( ${#line} > 120 )); then
      bad="a line of ${#line} characters"
    elif [[ "${line}" == [0-9]*'. '* || "${line}" == *'blocked:' || "${line}" == *'really wanted'* ]]; then
      bad="a numbered, header or closing line: ${line}"
    fi
    # Quoted, so a glob character in a line matches as text.
    [[ "${seen}" == *$'\n'"${line}"$'\n'* ]] && bad="a repeated line: ${line}"
    seen+="${line}"$'\n'
  done <<< "${reason}"
  if [[ -z "${bad}" ]]; then
    _pass "terse deny text: ${label}"
  else
    _fail "terse deny text: ${label} — ${bad}"
  fi
}

function _gp_test_reason_has {
  local cmd="$1" needle="$2" label="$3"
  _gp_test_seam "${cmd}"
  if [[ "${HOOK_SEAM_VERDICT}" == DENY && "${HOOK_SEAM_REASON}" == *"${needle}"* ]]; then
    _pass "reason names ${label}"
  else
    _fail "deny reason for '${label}' does not mention '${needle}'"
  fi
}

function run_gh_publish {
  _section "gh publish gate hook"

  # claude/ is gitignored: an absent hook skips the suite, not a regression.
  if [[ ! -f "${SCRIPT_DIR}/claude/hooks/gh-publish-hook" ]]; then
    _skip "claude/hooks/gh-publish-hook absent — claude/ not yet synced to this machine"
    return 0
  fi

  if ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
    return
  fi

  local _gp_dir
  _gp_dir="$(mktemp -d "${TMPDIR:-/tmp}/gh-publish-test.XXXXXX")"
  trap '/bin/rm -rf "${_gp_dir}"' EXIT

  local fixture_token fixture_alias
  fixture_token="FIXTURE_$(printf 'P%s' II)_TOKEN"
  fixture_alias="testalias$(( 90 + 9 ))"
  printf '%s\n' "${fixture_token}" > "${_gp_dir}/patterns"
  printf 'Host %s\n' "${fixture_alias}" > "${_gp_dir}/sshcfg"

  # Sandbox gh config (2026-09-25), the only thing `gh alias list` reads:
  # co (safe read alias, pr checkout, matches the live default), ghpubtest
  # (expands to a real publish, must deny),
  # ghpubtestsh (shell alias, `!`, always denied), postbody (expansion ends on
  # a flag needing an operand: a trailing --help/-h is not help until resolved).
  mkdir -p "${_gp_dir}/gh"
  {
    printf 'aliases:\n'
    printf '    co: pr checkout\n'
    printf '    ghpubtest: issue create --body x\n'
    printf '    ghpubtestsh: "!echo hi"\n'
    printf '    postbody: issue create --title t --body\n'
    printf '    pubhome: pr create -t t --body-file ~/tint/x/issue.md\n'
    printf '    pubhomeq: pr create -t t --body-file "~/tint/x/issue.md"\n'
    printf '    pubfile: pr create -t t --body-file\n'
  } > "${_gp_dir}/gh/config.yml"

  # gh stub (GH_PUBLISH_GH, the hook's only gh call is `gh alias list`): prints
  # what real gh printed for the sandbox config above, so the alias cases run
  # the hook's real parser without starting gh. A shell alias comes out
  # single-quoted, as gh prints it.
  mkdir -p "${_gp_dir}/stubbin"
  cat > "${_gp_dir}/stubbin/gh" <<'STUB'
#!/bin/sh
printf '%s\n' \
  'co: pr checkout' \
  'ghpubtest: issue create --body x' \
  "ghpubtestsh: '!echo hi'" \
  'postbody: issue create --title t --body' \
  'pubfile: pr create -t t --body-file' \
  'pubhome: pr create -t t --body-file ~/tint/x/issue.md' \
  'pubhomeq: pr create -t t --body-file "~/tint/x/issue.md"'
STUB
  chmod +x "${_gp_dir}/stubbin/gh"

  # Every body fixture is made here, hashed with one shasum call and given its
  # .reviewed sidecar at the end of the block. A body that a case must leave
  # without a sidecar, or edit after review, gets that treatment after the
  # sidecar pass or in its case.
  local -a gp_bodies=()
  local gp_nl=$'\n' gp_e2=$'\xc3\xa9' gp_n
  mkdir -p "${_gp_dir}/home/tint/x"

  # A clean, reviewed, env-carrying body.
  printf 'One full-width paragraph, no wrapping at all.\n\n## Environment\n\n- test hardware, test OS build\n' \
    > "${_gp_dir}/good.md"
  gp_bodies+=("${_gp_dir}/good.md")

  # PR and comment bodies do not need an Environment section.
  printf 'No env section here, one line.\n' > "${_gp_dir}/noenv.md"
  gp_bodies+=("${_gp_dir}/noenv.md")

  printf 'Contains %s in prose.\n\n## Environment\n\n- b\n' "${fixture_token}" \
    > "${_gp_dir}/pii.md"
  printf 'Mentions %s host.\n\n## Environment\n\n- b\n' "${fixture_alias}" \
    > "${_gp_dir}/alias.md"
  printf 'This paragraph is wrapped\nacross two lines badly.\n\n## Environment\n\n- b\n' \
    > "${_gp_dir}/wrap.md"
  printf 'Intro line.\n\n\x60\x60\x60\nwrapped\ninside fence\n\x60\x60\x60\n\n## Environment\n\n- b\n' \
    > "${_gp_dir}/fence.md"
  # stale.md is edited after the sidecar pass (see "Review binding").
  cp "${_gp_dir}/good.md" "${_gp_dir}/stale.md"
  printf 'Please ping @octocat about this.\n\n## Environment\n\n- b\n' \
    > "${_gp_dir}/mention.md"
  printf 'The \x60@property\x60 decorator and <a@b.com> are fine.\n\n## Environment\n\n- b\n' \
    > "${_gp_dir}/mentionok.md"
  gp_bodies+=("${_gp_dir}"/{pii,alias,wrap,fence,stale,mention,mentionok}.md)

  # A comment body that is exactly one `@dependabot <command>` line passes the
  # bare-mention rule (backticks would make Dependabot ignore the command). The
  # review sidecar, PII and wrap checks still apply; anything else still denies.
  # One file per body: depgood1..3, depbad1..5, dep (reviewed), depnosc (no
  # sidecar), depbt (backticked).
  local -a gp_dep_good=('rebase' 'squash and merge' 'ignore this major version')
  for (( gp_n=1; gp_n<=${#gp_dep_good}; gp_n++ )); do
    printf '@dependabot %s\n' "${gp_dep_good[gp_n]}" > "${_gp_dir}/depgood${gp_n}.md"
    gp_bodies+=("${_gp_dir}/depgood${gp_n}.md")
  done
  local -a gp_dep_bad
  # shellcheck disable=SC2016  # the backticks are literal fixture text
  gp_dep_bad=('@dependabot rebase @octocat' \
              '@dependabot frobnicate' \
              '@dependabot rebase\n\nthanks' \
              'please @dependabot rebase' \
              '@dependabot merge`touch x`')
  for (( gp_n=1; gp_n<=${#gp_dep_bad}; gp_n++ )); do
    printf '%b\n' "${gp_dep_bad[gp_n]}" > "${_gp_dir}/depbad${gp_n}.md"
    gp_bodies+=("${_gp_dir}/depbad${gp_n}.md")
  done
  printf '@dependabot rebase\n' > "${_gp_dir}/dep.md"
  printf '@dependabot rebase\n' > "${_gp_dir}/depnosc.md"
  gp_bodies+=("${_gp_dir}/dep.md")

  {
    printf 'Log dump below.\n\n\x60\x60\x60\n'
    for gp_n in {1..70}; do printf 'log line %d\n' "${gp_n}"; done
    printf '\x60\x60\x60\n\n## Environment\n\n- b\n'
  } > "${_gp_dir}/biglog.md"
  {
    printf '<details><summary>log</summary>\n\n\x60\x60\x60\n'
    for gp_n in {1..70}; do printf 'log line %d\n' "${gp_n}"; done
    printf '\x60\x60\x60\n</details>\n\n## Environment\n\n- b\n'
  } > "${_gp_dir}/biglogok.md"
  gp_bodies+=("${_gp_dir}"/{biglog,biglogok}.md)

  # Body-file size cap fixtures, byte-exact, built in pure zsh by doubling
  # (_gp_repeat: no head, tr or 70000-argument printf, and the byte count never
  # depends on the locale). The multibyte bodies repeat the two-byte e-acute.
  _gp_repeat 131072 a; print -rn -- "${REPLY}" > "${_gp_dir}/atcap.md"
  _gp_repeat 131073 a; print -rn -- "${REPLY}" > "${_gp_dir}/overcap.md"
  _gp_repeat 200000 "${gp_nl}"; print -rn -- "x${REPLY}" > "${_gp_dir}/newlinepad.md"
  _gp_repeat 70000 "${gp_e2}"; print -rn -- "${REPLY}" > "${_gp_dir}/multibyte-over.md"
  _gp_repeat 65536 "${gp_e2}"; print -rn -- "${REPLY}" > "${_gp_dir}/multibyte-atcap.md"
  gp_bodies+=("${_gp_dir}"/{atcap,overcap,newlinepad,multibyte-over,multibyte-atcap}.md)

  # A leading ~/ in the body path is the hook's HOME (the sandbox home here).
  printf 'One line body under the sandbox home.\n' > "${_gp_dir}/home/tint/x/issue.md"
  gp_bodies+=("${_gp_dir}/home/tint/x/issue.md")

  local gp_ident_ok='' gp_host_ok='' gp_host_ident gp_real_uuid gp_real_mac
  if [[ -n "${USER:-}" && "${USER}" != *[^[:alnum:]_-]* ]]; then
    gp_ident_ok=1
    printf 'Log at /Users/%s/Library/Logs/x.log\n\n## Environment\n\n- b\n' \
      "${USER}" > "${_gp_dir}/ident.md"
    gp_bodies+=("${_gp_dir}/ident.md")
  fi
  gp_real_uuid="$(uuidgen | tr '[:upper:]' '[:lower:]')"
  gp_real_mac="$(printf '0a%s1b%s2c%s3d%s4e%s5f' : : : : :)"
  printf 'Quarantine entry %s seen.\n\n## Environment\n\n- b\n' "${gp_real_uuid}" \
    > "${_gp_dir}/uuid.md"
  printf 'Interface at %s reported.\n\n## Environment\n\n- b\n' "${gp_real_mac}" \
    > "${_gp_dir}/mac.md"
  printf 'Placeholder %s and %s pass.\n\n## Environment\n\n- b\n' \
    '00000000-0000-0000-0000-000000000000' 'aa:bb:cc:dd:ee:ff' \
    > "${_gp_dir}/placeholder.md"
  printf 'Body.\n\n## Environment\n\n- MacBook, macOS 6.6 (88X8888)\n' \
    > "${_gp_dir}/wrongos.md"
  printf 'Body.\n\n## Environment\n\n- MacBook, macOS 7.7 (99Z999z)\n' \
    > "${_gp_dir}/rightos.md"
  printf 'Body.\n\n## Environment\n\n- MacBook, macOS 7.7 (88X8888)\n' \
    > "${_gp_dir}/wrongbuild.md"
  gp_bodies+=("${_gp_dir}"/{uuid,mac,placeholder,wrongos,rightos,wrongbuild}.md)

  # Fixed fake token (no secret value), joined at run time: the prefix, then
  # 36 letters and digits. Only the gitleaks case reads it.
  local gp_have_gitleaks=''
  if command -v gitleaks &>/dev/null; then
    gp_have_gitleaks=1
    printf 'Log excerpt: token=%s%s%s\n\n## Environment\n\n- b\n' \
      'ghp_' 'Zr8Kq2Lm5Vx9Tb3N' 'c7Hd1Wf4Gj6Sp0Ay2Eu5' > "${_gp_dir}/secret.md"
    gp_bodies+=("${_gp_dir}/secret.md")
  fi

  printf -- '- top item\n  - nested item\n    continuation is a wrap though\n\n## Environment\n\n- b\n' \
    > "${_gp_dir}/nested.md"
  printf -- '- top item\n  - nested item\n  - second nested\n\n## Environment\n\n- b\n' \
    > "${_gp_dir}/nested2.md"
  printf '<details>\n<summary>Full log</summary>\n\nOne line inside.\n\n</details>\n\n## Environment\n\n- b\n' \
    > "${_gp_dir}/details.md"
  printf 'Intro.\n\n~~~\nwrapped\ninside tilde fence\n~~~\n\n## Environment\n\n- b\n' \
    > "${_gp_dir}/tilde.md"
  printf 'Setext Title\n============\n\nOne paragraph line.\n\n## Environment\n\n- b\n' \
    > "${_gp_dir}/setext.md"
  gp_bodies+=("${_gp_dir}"/{nested,nested2,details,tilde,setext}.md)

  # Hostname half of the identity watchlist (needs scutil + a regex-safe
  # local hostname).
  gp_host_ident="$(scutil --get LocalHostName 2>/dev/null)"
  if [[ -n "${gp_host_ident}" && "${gp_host_ident}" != *[^[:alnum:]._-]* ]]; then
    gp_host_ok=1
    printf 'Seen on %s today.\n\n## Environment\n\n- b\n' "${gp_host_ident}" \
      > "${_gp_dir}/hostident.md"
    gp_bodies+=("${_gp_dir}/hostident.md")
  fi

  # Deny-text family: a wrapped paragraph (the line cap matters because the
  # model reads the text).
  printf 'Wrapped line one of a paragraph\nand its second line.\n\n## Environment\n\n- test hardware, test OS build\n' > "${_gp_dir}/wrapped.md"
  gp_bodies+=("${_gp_dir}/wrapped.md")

  _gp_test_review_all "${gp_bodies[@]}"
  # Edit after review: the sidecar above no longer matches this body.
  printf '\nEdited after review.\n' >> "${_gp_dir}/stale.md"

  # --- PASS: reads, non-gh, proper publishes ------------------------------
  _gp_test_expect PASS 'ls -la' 'non-gh command'
  _gp_test_expect PASS 'gh issue view 268 --repo o/r' 'gh issue view (read)'
  _gp_test_expect PASS 'gh api repos/o/r/issues/268' 'gh api read'
  _gp_test_expect PASS "gh issue create -t t --body-file ${_gp_dir}/good.md" \
    'issue create: reviewed body with env section'
  _gp_test_expect PASS "gh issue edit 5 --add-label bug" 'issue edit: label only'
  _gp_test_expect PASS 'gh issue create --web' 'issue create --web (human flow)'
  _gp_test_expect DENY "GH_PUBLISH_BYPASS=1 gh issue create -t t --body inline" \
    'an env-var prefix on the command line has no special effect any more, inline body still denies'

  # PR and comment bodies do not need an Environment section (noenv.md).
  _gp_test_expect PASS "gh pr create -t t --body-file ${_gp_dir}/noenv.md" \
    'pr create: no env section required'

  # --- DENY: review-artifact layer ----------------------------------------
  _gp_test_expect DENY 'gh issue create -t t --body "inline body"' 'inline --body'
  _gp_test_expect DENY 'gh release create v1 --notes "inline notes"' 'inline --notes'
  _gp_test_expect DENY 'gh release create v1 --generate-notes' '--generate-notes'
  _gp_test_expect DENY 'gh issue create -t t' 'create with editor flow (no body-file)'
  cp "${_gp_dir}/good.md" "${_gp_dir}/nosidecar.md"
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/nosidecar.md" \
    'missing .reviewed sidecar'

  # --- DENY: content layers ------------------------------------------------
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/pii.md" \
    'PII token in body'

  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/alias.md" \
    'SSH alias in body'

  _gp_test_expect DENY \
    "gh issue edit 5 --title 'about ${fixture_token}'" 'PII token in title'

  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/wrap.md" \
    'hard-wrapped paragraph'

  _gp_test_expect PASS "gh issue create -t t --body-file ${_gp_dir}/fence.md" \
    'wrap inside code fence tolerated'

  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/noenv.md" \
    'issue create without env section'

  # --- Review binding and GFM footguns -------------------------------------
  # stale.md is edited after the sidecar pass above. The append forms its own
  # paragraph (leading blank line): prose directly
  # after the env bullet trips WRAP and would mask a broken hash check
  # (mutation testing 2026-08-03).
  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/stale.md" \
    'sidecar stale after post-review edit'

  _gp_test_expect DENY "gh issue create -t t --body-file ${_gp_dir}/mention.md" \
    'bare @-mention'

  _gp_test_expect PASS "gh issue create -t t --body-file ${_gp_dir}/mentionok.md" \
    'backticked mention and email tolerated'

  # A comment body that is exactly one `@dependabot <command>` line passes the
  # bare-mention rule (the fixtures are made with the others, above). The review
  # sidecar, PII and wrap checks still apply; anything else still denies.
  for (( gp_n=1; gp_n<=${#gp_dep_good}; gp_n++ )); do
    _gp_test_expect PASS "gh pr comment 2 -R o/r --body-file ${_gp_dir}/depgood${gp_n}.md" \
      "pr comment: a bare Dependabot command ${gp_dep_good[gp_n]}"
  done
  _gp_test_expect DENY "gh pr comment 2 -R o/r --body-file ${_gp_dir}/depnosc.md" \
    'a Dependabot command still needs its review sidecar'
  _gp_test_expect DENY "gh issue comment 2 -R o/r --body-file ${_gp_dir}/dep.md" \
    'an issue comment with a Dependabot command still denies'
  _gp_test_expect DENY "gh pr review 2 -R o/r --body-file ${_gp_dir}/dep.md" \
    'a pr review with a Dependabot command still denies'
  for (( gp_n=1; gp_n<=${#gp_dep_bad}; gp_n++ )); do
    _gp_test_expect DENY "gh pr comment 2 -R o/r --body-file ${_gp_dir}/depbad${gp_n}.md" \
