    _skip 'gh not installed — alias --help resolution cases skipped'
  fi

  # --- Unterminated heredocs still execute their own live expansions
  # (2026-09-25). A heredoc with no closing delimiter is still executed by a
  # real shell as though EOF closed it: an unquoted body still expands
  # $(...) and backticks; a quoted delimiter stays inert either way.
  # shellcheck disable=SC2016  # literal fixture text, not a shell expansion here — it travels to jq --arg unmodified
  _gp_test_expect DENY $'cat <<EOF\n$(gh issue create --title t --body x)' \
    'an unterminated heredoc body still expands a $(...) inside it'
  # shellcheck disable=SC2016  # literal fixture text, not a shell expansion here — it travels to jq --arg unmodified
  _gp_test_expect DENY $'cat <<EOF\n`gh issue create --title t --body x`' \
    'an unterminated heredoc body still expands a backtick command substitution inside it'
  _gp_test_expect PASS $'cat <<\x27EOF\x27\n$(gh issue create --title t --body x)' \
    'a quoted heredoc delimiter stays inert even when the heredoc never terminates'

  # --- Browser mode does not hide a separate publish in the same call
  # (2026-09-25). --web exempts only the --web call itself; it must not
  # suppress scanning of an unrelated unreviewed publish in the same command.
  # shellcheck disable=SC2016  # literal fixture text, not a shell expansion here — it travels to jq --arg unmodified
  _gp_test_expect DENY 'gh issue create --web; ${G:-gh} issue create --title t --body x' \
    '--web does not suppress a later dynamic-command-word publish in the same call'
  _gp_test_expect DENY $'gh issue create --web; cat <<EOF\n$(gh issue create --title t --body x)\nEOF' \
    '--web does not suppress a later heredoc publish in the same call'
  # shellcheck disable=SC2016  # literal fixture text, not a shell expansion here — it travels to jq --arg unmodified
  _gp_test_expect DENY '${G:-gh} issue create --title t --body x; gh issue create --web' \
    'the same still denies with --web coming second'

  # --- gh api: short-flag clusters and every documented flag (2026-09-25).
  # A write = method not absent-or-GET, or any field-like token (single-dash
  # cluster containing f/F, or long --field/--raw-field/--input), never the
  # endpoint path. Other documented api flags (help/api.txt) are ignored:
  # none of -i/-H/-p/-q/-t/--hostname/--cache/--paginate/--silent/--slurp/
  # --verbose/--allow-escape-sequences contains f/F or a field long prefix.
  _gp_test_expect DENY 'gh api repos/o/r/issues -if title=x' \
    'a short-flag cluster -if is a field flag'
  _gp_test_expect DENY 'gh api repos/o/r/issues -iF title=x' \
    'a short-flag cluster -iF is a field flag'
  _gp_test_expect PASS 'gh api repos/o/r/issues -i' \
    '-i alone (no f/F) is not field-like'
  _gp_test_expect DENY "gh api -t '{{.number}}' repos/o/r/issues -f title=x" \
    '-t/--template no longer steals the endpoint slot from -f'
  _gp_test_expect PASS "gh api -t '{{.number}}' repos/o/r/issues" \
    '-t alone with no field flag is still a read'
  _gp_test_expect PASS 'gh api repos/o/r/issues -H "Accept: x"' \
    '-H/--header is ignored'
  _gp_test_expect PASS 'gh api repos/o/r/issues -q .foo' \
    '-q/--jq is ignored'
  _gp_test_expect PASS 'gh api repos/o/r/issues -p corsair' \
    '-p/--preview is ignored'
  _gp_test_expect PASS 'gh api repos/o/r/issues --hostname example.com' \
    '--hostname is ignored'
  _gp_test_expect PASS 'gh api repos/o/r/issues --cache 60m' \
    '--cache is ignored'
  _gp_test_expect PASS 'gh api repos/o/r/issues --paginate' \
    '--paginate is ignored'
  _gp_test_expect PASS 'gh api repos/o/r/issues --silent' \
    '--silent is ignored'
  _gp_test_expect PASS 'gh api repos/o/r/issues --slurp' \
    '--slurp is ignored'
  _gp_test_expect PASS 'gh api repos/o/r/issues --verbose' \
    '--verbose is ignored'
  _gp_test_expect PASS 'gh api repos/o/r/issues --allow-escape-sequences' \
    '--allow-escape-sequences is ignored'
  _gp_test_expect DENY 'gh api repos/o/r/issues --raw-field title=x' \
    'long form --raw-field denies'
  _gp_test_expect DENY "gh api repos/o/r/issues --field title=x" \
    'long form --field denies'
  _gp_test_expect DENY 'gh api repos/o/r/issues --input -' \
    'long form --input denies'
  _gp_test_expect DENY 'gh api repos/o/r/issues -X DELETE' \
    'an explicit non-GET method denies even with zero field-like tokens'
  _gp_test_expect DENY 'gh api repos/o/r/issues -iXPOST' \
    'a cluster ending in X with an attached value sets the method (POST)'
  _gp_test_expect DENY 'gh api repos/o/r/issues -iX POST' \
    'a cluster ending in bare X consumes the next token as the method'
  _gp_test_expect PASS 'gh api repos/o/r/issues -iXGET' \
    'the cluster form of an explicit GET is still a read'
  _gp_test_expect DENY 'eval "gh api repos/o/r/issues -if title=x"' \
    'an api short-flag cluster write shape inside an eval argument fails closed'

  # --- Braces are text mid-argument, not a command boundary (2026-09-25).
  # {owner}/{repo}/{branch} are documented gh api syntax (help/api.txt) and
  # text elsewhere: braces bound a command only as a standalone word (brace
  # group, `{ cmd; }`), never embedded in an argument.
  _gp_test_expect DENY 'gh api repos/{owner}/{repo}/issues -f title=x' \
    'an unquoted {owner}/{repo} endpoint no longer fragments the command'
  # shellcheck disable=SC2016  # literal fixture text, not a shell expansion here — it travels to jq --arg unmodified
  _gp_test_expect DENY '${G:-gh} issue create --title t --body x' \
    'a dynamic command word built from ${G:-gh} still denies once its closing brace is no longer a split point'
  _gp_test_expect PASS 'gh issue view repos/{owner}/{repo}' \
    'unquoted braces mid-argument on an unrelated read do not fragment the command'
  _gp_test_expect DENY $'bash /dev/null{txt} <<EOF\ngh issue create --title t --body x\nEOF' \
    'a brace in a heredoc-introducing line no longer breaks shell-consumer resolution'

  # --- Root and group-only help reads (2026-09-25). `gh --help`/`gh -h`
  # (no subcommand) and `gh <group> --help`/`-h` (no verb) are help reads. A
  # group-level --help/-h is a read once it appears in flag position, as in
  # real cobra, even with trailing text (`gh issue -h create` prints help);
  # root help still requires nothing else on the line.
  _gp_test_expect PASS 'gh --help' 'gh --help (root help)'
  _gp_test_expect PASS 'gh -h' 'gh -h (root help)'
  _gp_test_expect PASS 'gh issue --help' 'gh issue --help (group help, no verb)'
  _gp_test_expect PASS 'gh pr -h' 'gh pr -h (group help, no verb)'
  _gp_test_expect PASS 'gh release --help' 'gh release --help (group help, no verb)'
  _gp_test_expect PASS 'gh issue' 'a bare gh issue with no verb at all still passes'
  _gp_test_expect PASS 'gh issue --help extra' \
    'group help stays exempt even with trailing text after it'
  _gp_test_expect PASS 'gh issue -h create' \
    'a group-level -h before a would-be verb is still a help read'


  # --- Deny text: one line per violation, no numbering, no closing paragraph,
  # each line at most 120 characters, and a multi-violation deny is still one
  # valid JSON object.
  printf 'Wrapped line one of a paragraph\nand its second line.\n\n## Environment\n\n- test hardware, test OS build\n' > "${_gp_dir}/wrapped.md"
  printf 'A token %s here.\n' "$(printf '%s-%s-%s-%s-%s' 12345678 1234 1234 1234 123456789abc)" > "${_gp_dir}/tok.md"
  printf 'Thanks @someone for this.\n' > "${_gp_dir}/mention.md"
  printf 'Has %s in the text.\n' "${fixture_token}" > "${_gp_dir}/piiline.md"
  printf 'Body with no reviewed sidecar.\n' > "${_gp_dir}/nosidecar.md"
  printf 'Body whose sidecar is stale.\n' > "${_gp_dir}/stale.md"
  printf 'reviewed-by: test sha256:%s\n' "$(printf '%064d' 0)" > "${_gp_dir}/stale.md.reviewed"
  printf 'Env with a wrong build.\n\n## Environment\n\n- macOS 1.0 (11A111)\n' > "${_gp_dir}/wrongenv.md"
  local _gp_f
  for _gp_f in wrapped tok mention piiline wrongenv; do
    _gp_test_review "${_gp_dir}/${_gp_f}.md"
  done
  local _gp_long_flag='--a-very-long-flag-name-that-is-not-real'
  local _gp_terse_cmd
  # shellcheck disable=SC2016  # literal fixture text, not a shell expansion here
  for _gp_terse_cmd in \
      'gh issue create -t t --body x' \
      'gh issue create -t t' \
      'gh pr create --fill -Z --body x' \
      "gh pr create -t t ${_gp_long_flag} v" \
      "gh release create v1 ${_gp_long_flag} v" \
      "gh issue comment 5 ${_gp_long_flag} v" \
      "gh release edit v1 ${_gp_long_flag}=v" \
      'gh pr create -t t --body-file /nonexistent/file.md' \
      "gh pr create -t t --body-file ${_gp_dir}/nosidecar.md" \
      "gh pr create -t t --body-file ${_gp_dir}/stale.md" \
      "gh pr create -t t --body-file ${_gp_dir}/wrapped.md" \
      "gh pr create -t t --body-file ${_gp_dir}/tok.md" \
      "gh pr create -t t --body-file ${_gp_dir}/mention.md" \
      "gh pr create -t t --body-file ${_gp_dir}/piiline.md" \
      "gh issue create -t t --body-file ${_gp_dir}/noenv.md" \
      "gh issue create -t t --body-file ${_gp_dir}/wrongenv.md" \
      "gh pr create -t ${fixture_token} --body-file ${_gp_dir}/good.md" \
      'gh api repos/o/r/issues -f title=x' \
      'gh pr create -t t --body-file f.md ; ls' \
      'gh pr create --attach f.png -t t' \
      'gh issue create -e' \
      'gh release upload v1 asset.zip' \
      'gh release create v1 asset.zip --notes-file f.md' \
      'gh gist create f.txt' \
      'gh discussion create' \
      'gh issue transfer 5 o/r' \
      'gh issue frobnicate 5' \
      'gh pr frobnicate 5' \
      'gh release frobnicate v1' \
      'gh frobnicate' \
      'eval "gh issue create -t t --body x"' \
      '${G:-gh} issue create -t t --body x' ; do
    _gp_test_terse "${_gp_terse_cmd}" "${_gp_terse_cmd:0:60}"
  done
  _gp_test_terse 'gh pr create --fill -Z --body x' 'several violations stay one line each'
  _gp_test_terse $'gh pr create -t t --body x\ngh pr create -t t --body x' 'a repeated violation is reported once'
  local _gp_multi
  _gp_multi="$(_gp_test_run 'gh pr create --fill -Z --body x' | jq -r '.hookSpecificOutput.permissionDecisionReason' | wc -l | tr -d ' ')"
  if (( _gp_multi >= 3 )); then
    _pass "a command with several violations reports one line for each"
  else
    _fail "a command with several violations reported ${_gp_multi} line(s), expected at least 3"
  fi

  # --- gh api graphql: a query without a mutation is a read (with or
  # without --paginate); any mutation, an unreadable query or a dynamic
  # value still denies.
  _gp_test_expect DENY "gh api graphql -f query='mutation { x }'" 'graphql mutation denies'
  _gp_test_expect DENY "gh api graphql --paginate -f query='mutation { x }'" 'graphql mutation with --paginate denies'
  _gp_test_expect DENY "gh api graphql -f query='MUTATION{ x }'" 'the mutation token is matched case-insensitively'
  _gp_test_expect DENY $'gh api graphql -f query=\'query A { a }\nmutation B { b }\'' \
    'a mutation on a later line of the query text denies'
  _gp_test_expect PASS "gh api graphql -f query='query { viewer { login } }'" 'graphql query is a read'
  _gp_test_expect PASS "gh api graphql --paginate -f query='query { viewer { login } }'" \
    'graphql query with --paginate is a read'
  _gp_test_expect PASS "gh api graphql -F owner=o -f query='query(\$owner: String!) { a }'" \
    'graphql query with a variable field is a read'
  _gp_test_expect PASS "gh api graphql -f query='{ viewer { login } }' --jq .data.viewer" \
    'graphql shorthand query with --jq is a read'
  _gp_test_expect PASS "gh api graphql -X POST -f query='query { a }'" 'graphql query with an explicit POST is a read'
  _gp_test_expect PASS 'gh api graphql -f query=x' 'graphql query text without a mutation token is a read'
  _gp_test_expect DENY 'gh api graphql -f query=@q.graphql' 'graphql query read from a file cannot be checked'
  _gp_test_expect DENY 'gh api graphql -F query=@q.graphql' 'graphql query read from a file via -F cannot be checked'
  _gp_test_expect DENY 'gh api graphql --input q.json' 'graphql --input cannot be checked'
  _gp_test_expect DENY 'gh api graphql -f owner=o' 'graphql with no query field is not proven to be a read'
  # shellcheck disable=SC2016  # literal fixture text, not a shell expansion here
  _gp_test_expect DENY 'gh api graphql -f query="$Q"' 'graphql query from a variable cannot be checked'
  _gp_test_expect DENY "gh api graphql -X DELETE -f query='query { a }'" 'graphql with a non-POST method denies'
  _gp_test_expect DENY "gh api repos/o/r/issues -f query='query { a }'" 'a query field on a REST endpoint is still a write'
  _gp_test_expect DENY "gh api graphql -f query='query { a }' -f query='mutation { b }'" \
    'a second query field with a mutation denies'
  _gp_test_expect DENY "gh api graphql -if query='query { a }'" 'a flag cluster on graphql fails closed'

  # --- Arguments and commands across newlines. A newline inside a quoted
  # value stays in the argument, so a later flag is still seen; elsewhere it
  # separates commands; a backslash-newline joins lines only when the
  # backslash is not itself escaped.
  _gp_test_expect DENY $'gh pr create --title "$(cat <<\'EOF\'\nx\nEOF\n)" --body "raw"' \
    'a flag after a multi-line command substitution argument is seen'
  _gp_test_expect DENY $'gh pr create --title t \\\n --body "raw"' \
    'a continuation line carries a flag that is seen'
  _gp_test_expect DENY $'gh pr create --title "a\nb" --body "raw"' \
    'a flag after a multi-line double-quoted value is seen'
  _gp_test_reason_has $'gh pr create --title "a\nb" --body "raw"' 'inline body text' \
    'an inline body after a multi-line title'
  _gp_test_expect DENY $'gh pr create --title \'a\nb\' --body "raw"' \
    'a flag after a multi-line single-quoted value is seen'
  _gp_test_expect DENY $'gh api repos/o/r/issues --jq \'.a\n.b\' -f title=x' \
    'a field flag after a multi-line single-quoted value is seen'
  _gp_test_expect DENY $'gh api repos/o/r/issues --jq ".a\n.b" -X POST' \
    'a method flag after a multi-line double-quoted value is seen'
  _gp_test_expect DENY $'gh api repos/o/r/issues --jq \'.a\n.b\' -q .c --input f' \
    'an input flag after a multi-line value is seen'
  _gp_test_expect PASS $'gh api repos/o/r/issues --jq \'.a\n.b\'' \
    'a multi-line quoted value on a read stays a read'
  _gp_test_expect PASS $'gh pr list --search "a\nb"' 'a multi-line quoted search on a list stays a read'
  _gp_test_expect PASS $'gh issue edit 5 --title "a\nb" --add-label x' \
    'a multi-line title does not split the command'
  _gp_test_expect DENY $'gh issue edit 5 --title "a\nb '"${fixture_token}"$'" --add-label x' \
    'the second line of a multi-line title is scanned'
  _gp_test_expect DENY $'echo a\\\\\ngh issue create -t t --body x' \
    'an escaped backslash before a newline does not join the next command onto the line'
  _gp_test_expect DENY $'gh issue create -t t \\\n--body x' \
    'a single backslash before a newline joins the lines'
  _gp_test_expect DENY $'gh pr list # note\ngh issue create -t t --body x' \
    'a comment ends at its own line'
  _gp_test_expect DENY $'echo "$(true\ngh issue create -t t --body x)"' \
    'a newline inside a command substitution separates commands'
  _gp_test_expect DENY $'echo `true\ngh issue create -t t --body x`' \
    'a newline inside backticks separates commands'
  _gp_test_expect DENY $'gh --repo "o\nr" issue create --title t --body x' \
    'a global flag value that spans a newline does not hide the verb after it'
  _gp_test_expect DENY $'echo \'a\n<<X\'\ngh issue create -t t --body raw\nX' \
    'a << inside a multi-line quoted value does not open a heredoc that hides the next line'
  _gp_test_expect PASS $'cat <<X\ngh issue create -t t --body raw\nX' \
    'a real heredoc body that only mentions a publish stays data'
  _gp_test_expect DENY $'git commit -m "note about <<X\nmore text"\ngh issue create -t t --body raw\nX' \
    'a << in a multi-line commit message does not hide the publish that follows'

  # --- Declarations inside loops: a command that drives each loop twice
  # still yields one valid deny object (or nothing at all).
  _gp_test_expect DENY 'gh pr create -df -dd --title t --body x' 'two short-flag clusters in one command'
  _gp_test_expect DENY 'gh pr create --title=t --repo=o/r --body=x' 'two --flag=value forms in one command'
  _gp_test_expect DENY 'gh api repos/o/r/issues -f a=1 -f b=2 -H x:y' 'several api flags in one command'
  _gp_test_expect DENY $'cat <<A\nx\nA\ncat <<B\ny\nB\ngh issue create -t t --body x' \
    'two heredocs before a publish'
  _gp_test_expect PASS $'cat <<A\nx\nA\ncat <<B\ny\nB\ngh pr list' 'two heredocs before a read leave no output'
  _gp_test_expect PASS 'gh pr list; gh pr view 1; gh issue list; gh issue view 2' \
    'several read segments leave no output'

  /bin/rm -rf "${_gp_dir}"
  trap - EXIT
}
