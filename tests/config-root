#!/bin/zsh
# dotfiles/tests/config-root
#
# Behavioural test for claude/hooks/config-root-hook, the PreToolUse hook that
# denies writes into the live agent config directories (~/.claude, ~/.codex,
# ~/.config/muse) and points at the dotfiles copy. One input per case. Covers:
#   DENY: a path tool under a root (with the one-line deny reason, a `..` out
#         of an allowed directory, a relative path and a notebook_path through
#         the hook's own jq); Bash writes (redirect, heredoc redirect, cp, mv,
#         rm -rf, a mass delete of an allowed directory, sed -i, curl -o,
#         git clone); a cd or the payload cwd inside a root; a wrapper and a
#         shell string
#   PASS: an allowed prefix, a read, a root used only as a copy source, a
#         message that names a path in heredoc data, the repo copy under
#         dotfiles (the false-positive guards)
#   fail-open: an unparseable payload and a HOME that is not an absolute path
# Both directions are pinned (`cat ~/.claude/x` must pass, `cp a ~/.claude/x`
# must deny). The hook is lexical, so every case runs with a fake HOME
# (/Users/tester) that is never touched on disk.
#
# Run: ./test config-root
#
# ShellCheck: lint with `shellcheck --shell=bash tests/config-root`.
# This file is sourced, not executed - chmod 644.
#
# shellcheck source=tests/lib
# shellcheck disable=SC2016,SC2088  # literal $ and ~ in fixtures: they are the hook's input

typeset -g CR_HOME=/Users/tester
typeset -g CR_HOOK_REL=claude/hooks/config-root-hook

function _cr_hook {
  # Print the path of the hook under test.
  printf '%s' "${SCRIPT_DIR}/${CR_HOOK_REL}"
}

function _cr_check_seam {
  # Check HOOK_SEAM_VERDICT against $1. $2 = label.
  if [[ "${HOOK_SEAM_VERDICT}" == "$1" ]]; then
    _pass "$1: $2"
  else
    _fail "$2 - expected $1, got ${HOOK_SEAM_VERDICT} (${HOOK_SEAM_OUT:0:120})"
  fi
}

function _cr_seam {
  # Seam run of the hook for tool $1, command $2, path $3, working directory
  # $4 (default /work; empty stays empty). HOME is the fake CR_HOME.
  _hook_run_seam HOME="${CR_HOME}" -- "$(_cr_hook)" "$1" "$2" "$3" '' "${4-/work}"
}

function _cr_expect {
  # $1 = DENY or PASS, $2 = command, $3 = label (default the command).
  _cr_seam Bash "$2" ''
  _cr_check_seam "$1" "${3:-$2}"
}

function _cr_expect_in {
  # $1 = DENY or PASS, $2 = working directory, $3 = command.
  _cr_seam Bash "$3" '' "$2"
  _cr_check_seam "$1" "$3 (cwd ${2:-<empty>})"
}

function _cr_expect_path {
  # $1 = DENY or PASS, $2 = tool, $3 = path, $4 = directory.
  _cr_seam "$2" '' "$3" "${4-/work}"
  _cr_check_seam "$1" "$2 $3${4:+ (cwd $4)}"
}

function run_config_root {
  _section "live agent config write guard hook"

  # claude/ is gitignored, so the hook is absent on a clean clone and in CI.
  if [[ ! -f "$(_cr_hook)" ]]; then
    _skip "${CR_HOOK_REL} absent - claude/ not yet synced to this machine"
    return 0
  fi
  if ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
    return
  fi

  local out want_reason
  want_reason='live agent config blocked: edit the dotfiles copy (claude/, .codex/, .config/muse/), then ./bittersweet dotfiles.'

  # 1. A path tool under a root denies, and the reason is the one-line message.
  _cr_seam Write '' /Users/tester/.claude/settings.json
  if [[ "${HOOK_SEAM_VERDICT}" == DENY && "${HOOK_SEAM_REASON}" == "${want_reason}" \
     && "${HOOK_SEAM_REASON}" != *$'\n'* && "${HOOK_SEAM_REASON}" != *[Bb]ypass* \
     && "${HOOK_SEAM_REASON}" != *SKIP* ]]; then
    _pass "DENY: Write under ~/.claude, one-line reason that names the dotfiles copy, no bypass"
  else
    _fail "Write under ~/.claude: ${HOOK_SEAM_VERDICT} ${HOOK_SEAM_OUT:0:200}"
  fi

  # 2. A NotebookEdit notebook_path, $HOME spelling, through the hook's own jq.
  out="$(jq -cn '{tool_name:"NotebookEdit", tool_input:{notebook_path:"$HOME/.codex/n.ipynb", content:"x"}, cwd:"/work"}' \
    | HOME="${CR_HOME}" /bin/zsh "$(_cr_hook)")"
  if [[ "$(_hook_verdict "${out}")" == DENY \
     && "$(jq -r '.hookSpecificOutput.permissionDecisionReason' <<< "${out}")" == "${want_reason}" ]]; then
    _pass "DENY: NotebookEdit notebook_path \$HOME/.codex (process path, JSON deny)"
  else
    _fail "NotebookEdit notebook_path \$HOME/.codex: ${out:0:200}"
  fi

  # 3 to 5. Traversal out of an allowed directory, the muse root, a relative
  # path joined to the cwd.
  _cr_expect_path DENY Write /Users/tester/.claude/projects/../settings.json
  _cr_expect_path DENY Write '~/.config/muse/settings.json'
  _cr_expect_path DENY Write settings.json /Users/tester/.claude

  # 6 to 14. Bash writes and deletes into a root.
  _cr_expect DENY 'echo hi > ~/.claude/x'
  _cr_expect DENY 'cat > ~/.claude/CLAUDE.md <<EOF
body
EOF' 'heredoc redirect'
  _cr_expect DENY 'cp a ~/.claude/x'
  _cr_expect DENY 'mv ~/.claude/x /work/x' 'a move removes its source'
  _cr_expect DENY 'rm -rf ~/.claude'
  _cr_expect DENY 'rm -rf ~/.claude/projects' 'the allowed directory itself is a mass delete'
  _cr_expect DENY 'sed -i.bak s/a/b/ ~/.claude/CLAUDE.md'
  _cr_expect DENY 'curl -o ~/.claude/x https://example.invalid/a'
  _cr_expect DENY 'git clone https://example.invalid/r.git ~/.claude/r'

  # 15 and 16. A cd into a root, and the payload cwd inside a root.
  _cr_expect DENY 'cd ~/.claude && rm settings.json'
  _cr_expect_in DENY /Users/tester/.claude 'rm x'

  # 17 and 18. A shell string and a wrapper.
  _cr_expect DENY 'sh -c "echo hi > ~/.claude/x"'
  _cr_expect DENY 'sudo -u root rm ~/.claude/b'

  # 19 to 23. False-positive guards: an allowed prefix, a read, a root as a
  # copy source, heredoc data in a commit message, the repo copy.
  _cr_expect_path PASS Write /Users/tester/.claude/projects/-Users-x/memory/m.md
  _cr_expect PASS 'cat ~/.claude/settings.json'
  _cr_expect PASS 'cp ~/.claude/settings.json /work/' 'cp reads the source'
  _cr_expect PASS $'git commit -m "$(cat <<\'EOF\'\nCopy to ~/.claude/x\nrm ~/.claude/y\nEOF\n)"' 'heredoc body is data'
  _cr_expect_path PASS Write /Users/tester/dotfiles/claude/settings.json

  # 24. Fail-open: an unparseable payload produces no output.
  if [[ -z "$(printf '%s' 'not json' | HOME="${CR_HOME}" /bin/zsh "$(_cr_hook)" 2>/dev/null)" ]]; then
    _pass "fail-open: unparseable payload produces no output"
  else
    _fail "fail-open: unparseable payload produced output"
  fi

  # 25. A HOME that is not an absolute path fails open.
  _hook_run_seam HOME= -- "$(_cr_hook)" Bash 'rm ~/.claude/x' '' '' /work
  _cr_check_seam PASS "HOME='' (empty) fails open"
}
