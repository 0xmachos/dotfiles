#!/bin/zsh
# dotfiles/tests/muse-exec
#
# Behavioural test for claude/hooks/muse-exec-hook (PreToolUse guard on headless
# `muse exec`). One input is one case. The cases cover:
#   - PASS: muse exec only as data, --help, a compliant run with the verify
#     reminder env var written across backslash-continued lines, and a heredoc
#     body a non-shell consumer reads
#   - DENY: one command that breaks the timeout, open-stdin, --sandbox and
#     env-var rules at once (the reason names each rule and the canonical
#     form), open stdin with --provider echo, --prompt-file /dev/stdin, a
#     wrapper before the muse word, a heredoc a shell reads, an unquoted
#     heredoc delimiter that expands $(...), and a shell consumer behind a
#     2>&1 redirect
#   - no override: an exported MUSE_EXEC_GUARD_SKIP=1, with the hook run as a
#     process (JSON on stdin)
#   - fail-open on unparseable JSON, and the dispatcher seam (the sourced hook
#     reads HOOK_PRE_COMMAND and ignores stdin)
# The verdict cases run the guard through the pretool-dispatch seam
# (_hook_run_seam in tests/lib: sourced in a subshell, HOOK_PRE_* set,
# DENY<US>reason).
#
# Run: ./test muse-exec
# ShellCheck: lint with `shellcheck --shell=bash tests/muse-exec`.
# This file is sourced, not executed — chmod 644.
#
# File-level disables: SC2016 (fixtures are literal strings; $PWD and env
# assignments must stay unexpanded, as a Bash tool call carries them raw).
# shellcheck disable=SC2016
#
# shellcheck source=tests/lib

function _muse_exec_expect {
  # Seam run: the guard sourced the dispatcher's way. The verdict lands in
  # HOOK_SEAM_VERDICT and the deny reason in HOOK_SEAM_REASON.
  local want="$1" cmd="$2" label="${3:-$2}"
  _hook_run_seam "${SCRIPT_DIR}/claude/hooks/muse-exec-hook" Bash "${cmd}"
  if [[ "${HOOK_SEAM_VERDICT}" == "${want}" ]]; then
    _pass "${want}: ${label}"
  else
    _fail "${label} — expected ${want}, got ${HOOK_SEAM_VERDICT} (${HOOK_SEAM_OUT:0:120})"
  fi
}

function _muse_exec_seam {
  # $1 = command, $2 = stdin text. Sources the hook the way pretool-dispatch
  # does: HOOK_PRE_* plain variables inside a function, so the hook sees
  # ":file" in ZSH_EVAL_CONTEXT. Echoes the hook's stdout.
  /bin/zsh -c '
    function _drive {
      HOOK_PRE_DISPATCH=1
      HOOK_PRE_COMMAND="$1"
      local guard="$2"
      set --
      source "${guard}"
    }
    _drive "$@"' _ "$1" "${SCRIPT_DIR}/claude/hooks/muse-exec-hook" <<< "$2"
}

function run_muse_exec {
  _section "muse exec guard hook"

  # claude/ is gitignored: an absent hook is a skip, not a failure.
  if [[ ! -f "${SCRIPT_DIR}/claude/hooks/muse-exec-hook" ]]; then
    _skip "claude/hooks/muse-exec-hook absent — claude/ not yet synced to this machine"
    return 0
  fi

  if ! [[ -x "$(command -v jq)" ]]; then
    _skip "jq not installed (brew install jq)"
    return
  fi

  _muse_exec_expect PASS "grep 'muse exec' file.txt" 'muse exec mentioned inside a grep pattern'
  _muse_exec_expect PASS 'muse exec --help' 'muse exec --help is read-only'
  _muse_exec_expect PASS 'muse skills list' 'a different muse subcommand'
  # Lines split before the tokeniser: unfolded, a `\`-continued muse exec put
  # its < /dev/null and flags on a different segment and was wrongly denied.
  _muse_exec_expect PASS $'MUSE_EXPERIMENTAL_VERIFY_REMINDER=0 timeout 1800 command muse exec \\\n  --prompt-file prompt.md \\\n  --workspace "$PWD" \\\n  < /dev/null > out.txt 2> err.txt &' \
    'canonical form with the env var, across backslash-continued lines'
  # A python heredoc whose docstring quotes `muse exec` must not be denied.
  _muse_exec_expect PASS \
    $'python3 - <<\'EOF\'\ndoc = """run `timeout 1800 muse exec --prompt-file f --workspace\n"$PWD" < /dev/null`"""\nEOF' \
    'a heredoc body for python3 is data'

  # One command that breaks every rule: the deny names each of them.
  local reason
  _hook_run_seam "${SCRIPT_DIR}/claude/hooks/muse-exec-hook" Bash \
    'timeout 90 muse-bin-2 exec --sandbox --workspace "$PWD"'
  reason="${HOOK_SEAM_REASON}"
  if [[ "${HOOK_SEAM_VERDICT}" == DENY && "${reason}" == *"120 seconds"* \
      && "${reason}" == *"stdin is not closed"* && "${reason}" == *"--sandbox"* \
      && "${reason}" == *"MUSE_EXPERIMENTAL_VERIFY_REMINDER"* \
      && "${reason}" == *'Canonical form: timeout 1800 muse exec'* ]]; then
    _pass "DENY: a short timeout, open stdin, --sandbox and no env var, each named with the canonical form"
  else
    _fail "combined deny — ${HOOK_SEAM_VERDICT}: ${reason:0:200}"
  fi
  _muse_exec_expect DENY 'timeout 60 muse exec --provider echo --workspace "$PWD"' \
    'echo provider still needs closed stdin'
  _muse_exec_expect DENY 'timeout 1800 muse exec --prompt-file /dev/stdin --workspace "$PWD" < /dev/null' \
    '--prompt-file /dev/stdin'
  _muse_exec_expect DENY 'env VAR=0 muse exec --sandbox --workspace "$PWD" < /dev/null' \
    'a wrapper before the muse word is seen through'
  _muse_exec_expect DENY $'sh <<EOF\ntimeout 90 muse exec --workspace "$PWD"\nEOF' \
    'a heredoc body fed to sh is scanned as commands'
  _muse_exec_expect DENY $'cat <<EOF\n$(timeout 60 muse exec hi)\nEOF' \
    'an unquoted heredoc delimiter still expands $(...)'
  _muse_exec_expect DENY $'bash 2>&1 <<EOF\ntimeout 60 muse exec hi\nEOF' \
    'the & in 2>&1 is a redirection, so bash stays the heredoc consumer'

  # An exported MUSE_EXEC_GUARD_SKIP=1 overrides nothing: the hook as a
  # process, JSON on stdin.
  local out
  out="$(jq -n --arg c 'timeout 90 muse exec --sandbox --workspace "$PWD"' '{tool_name:"Bash", tool_input:{command:$c}}' \
    | MUSE_EXEC_GUARD_SKIP=1 /bin/zsh "${SCRIPT_DIR}/claude/hooks/muse-exec-hook")"
  if [[ "$(_hook_verdict "${out}")" == DENY ]]; then
    _pass "DENY: an exported MUSE_EXEC_GUARD_SKIP=1 no longer overrides (standalone)"
  else
    _fail "an exported MUSE_EXEC_GUARD_SKIP=1 overrides the hook: $(_hook_verdict "${out}")"
  fi

  if [[ -z "$(printf '%s' 'not json' | /bin/zsh "${SCRIPT_DIR}/claude/hooks/muse-exec-hook")" ]]; then
    _pass "fail-open: unparseable payload allowed through"
  else
    _fail "fail-open: unparseable payload produced a verdict"
  fi

  # Dispatcher seam: the command comes from HOOK_PRE_COMMAND, stdin is ignored.
  local us=$'\x1f' seam
  seam="$(_muse_exec_seam 'timeout 90 muse exec --workspace /w < /dev/null' \
    '{"tool_name":"Bash","tool_input":{"command":"muse skills list"}}')"
  if [[ "${seam}" == "DENY${us}"*'muse exec was not run'* && "${seam}" != *hookSpecificOutput* ]]; then
    _pass "dispatcher seam: a violating HOOK_PRE_COMMAND prints a DENY line, stdin ignored"
  else
    _fail "dispatcher seam: expected a DENY line, got: ${seam:0:200}"
  fi
}
