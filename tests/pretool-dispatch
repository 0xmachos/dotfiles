#!/bin/zsh
# dotfiles/tests/pretool-dispatch
#
# Behavioural test for claude/hooks/pretool-dispatch, the single PreToolUse
# process that sources the guards (gh-publish-hook
# git-bypass-hook muse-exec-hook rm-redirect-hook ssh-redirect-hook
# sudo-askpass-hook container-tmp-hook tmp-guard-hook config-root-hook md5-write-hook uv-guard-hook
# test-guard-hook) in forked
# subshells. Each case feeds one input (one payload) to the dispatcher and
# checks one outcome. Three parts:
#   1. Fault injection: a sandbox COPY of the dispatcher beside stub guards
#      (it finds its guards in its own directory). Guard order, an unrouted
#      tool, input the dispatcher cannot judge (exit 2), a stub that fails or
#      prints a JSON deny itself, joined deny reasons, a SIGTERM, a crash
#      inside the dispatcher, a missing guard file with a repeated readonly,
#      option and variable isolation under a hostile startup file, the seam
#      variables a guard is handed, and no environment override of the guard
#      directory. Every failure must deny.
#   2. The real guards through the real dispatcher: a deny on the Bash and
#      Write routes, a Monitor call denied as Bash, a benign pass, and an
#      exported HOOK_PRE_DISPATCH=1 not turning a standalone guard into a skip.
#   3. Registration shape: env loads the prefilter and git-sign-post mods,
#      and no settings entry registers the dispatcher, a standalone guard or
#      git-sign-hook (each would run every guard twice).
# Verdicts go through _hook_verdict (PASS, DENY, INVALID).
#
# Run: ./test pretool-dispatch
# ShellCheck: lint with `shellcheck --shell=bash tests/pretool-dispatch`.
# This file is sourced, not executed: chmod 644.
#
# shellcheck source=tests/lib

typeset -g PTD_SB=''
typeset -g PTD_BOX=''
typeset -g PTD_OUT=''
typeset -g PTD_DISPATCHER=''
typeset -g PTD_BAD=''
typeset -gi PTD_RC=0

typeset -ga PTD_BASH=(gh-publish-hook git-bypass-hook muse-exec-hook rm-redirect-hook ssh-redirect-hook sudo-askpass-hook container-tmp-hook tmp-guard-hook config-root-hook mcp-secret-hook uv-guard-hook test-guard-hook)
typeset -ga PTD_ALL=("${PTD_BASH[@]}" md5-write-hook)

function _ptd_bash {
  jq -cn --arg c "$1" '{tool_name:"Bash", tool_input:{command:$c}, cwd:"/work"}'
}

function _ptd_monitor {
  jq -cn --arg c "$1" '{tool_name:"Monitor", tool_input:{description:"watch", timeout_ms:60000, command:$c}, cwd:"/work"}'
}

function _ptd_write {
  jq -cn --arg p "$1" --arg c "$2" '{tool_name:"Write", tool_input:{file_path:$p, content:$c}, cwd:"/work"}'
}

# A case collects its problems with _ptd_flag and reports once with _ptd_done.
function _ptd_flag {
  PTD_BAD+="$1; "
}

function _ptd_done {
  if [[ -z "${PTD_BAD}" ]]; then
    _pass "$1"
  else
    _fail "$1 — ${PTD_BAD}"
  fi
  PTD_BAD=''
}

function _ptd_new_box {
  # A sandbox with a COPY of the dispatcher and a benign marker-writing stub
  # for each guard. Sets PTD_BOX.
  local name="$1" g
  PTD_BOX="${PTD_SB}/${name}"
  zf_mkdir -p "${PTD_BOX}/tmp"
  print -r -- "${PTD_DISPATCHER}" > "${PTD_BOX}/pretool-dispatch"
  for g in "${PTD_ALL[@]}"; do
    _ptd_stub "${g}" ''
  done
}

function _ptd_stub {
  # $1 = guard name, $2 = body run after the marker line.
  # shellcheck disable=SC2016  # the stub's own text, expanded when it is sourced
  printf '#!/bin/zsh\nprint -r -- %s >> "${PTD_MARKER}"\n%s\n' "$1" "$2" > "${PTD_BOX}/$1"
}

function _ptd_export_pairs {
  # Exports each NAME=value argument. Callers run it in a subshell, so the
  # pairs reach only that run's dispatcher and no env process starts.
  local kv
  for kv in "$@"; do
    # shellcheck disable=SC2163  # exports the NAME=value pair itself
    export "${kv}"
  done
}

function _ptd_run {
  # $1 = payload, remaining args = VAR=value pairs for the dispatcher's
  # environment. Runs the box's dispatcher from the box directory. Sets
  # PTD_OUT (stdout), PTD_RC, and leaves stderr in <box>/stderr.
  local payload="$1"
  shift
  : > "${PTD_BOX}/marker"
  PTD_RC=0
  PTD_OUT="$(cd "${PTD_BOX}" && _ptd_export_pairs "PTD_MARKER=${PTD_BOX}/marker" "TMPDIR=${PTD_BOX}/tmp/" "$@" \
    && printf '%s' "${payload}" | /bin/zsh "${PTD_BOX}/pretool-dispatch" 2>"${PTD_BOX}/stderr")" || PTD_RC=$?
}

function _ptd_marker {
  # The marker file's lines on one line, space separated.
  local -a lines
  # shellcheck disable=SC2296  # zsh (@f) splits on newlines
  lines=("${(@f)$(<"${PTD_BOX}/marker")}")
  print -r -- "${lines[*]}"
}

function _ptd_reason {
  jq -r '.hookSpecificOutput.permissionDecisionReason' <<< "${PTD_OUT}"
}

function _ptd_has {
  # $1 = haystack, $2 = needle: status 0 when contained.
  [[ "$1" == *"$2"* ]]
}

function _ptd_want {
  # $1 = PASS or DENY, $2 = what: flags a problem unless the last run exited
  # 0 with that verdict.
  local got
  got="$(_hook_verdict "${PTD_OUT}")"
  if [[ "${got}" != "$1" || ${PTD_RC} -ne 0 ]]; then
    _ptd_flag "$2: expected $1 with exit 0, got ${got} with exit ${PTD_RC}: ${PTD_OUT:0:120}"
  fi
}

function _ptd_want_blocked {
  # $1 = what: flags a problem unless the last run exited 2, printed no
  # verdict and ran no guard.
  if [[ ${PTD_RC} -ne 2 || -n "${PTD_OUT}" || -s "${PTD_BOX}/marker" ]]; then
    _ptd_flag "$1: rc=${PTD_RC} out=${PTD_OUT:0:80} marker=$(_ptd_marker)"
  fi
}

# --- real-guard helpers ----------------------------------------------------

function _ptd_real {
  # $1 = payload; remaining args = VAR=value pairs. Real dispatcher.
  local payload="$1"
  shift
  PTD_RC=0
  PTD_OUT="$(_ptd_export_pairs "$@" \
    && printf '%s' "${payload}" | /bin/zsh "${SCRIPT_DIR}/claude/hooks/pretool-dispatch" 2>/dev/null)" || PTD_RC=$?
}

function _ptd_run_guard {
  # $1 = guard, $2 = payload; remaining args = VAR=value pairs. Runs the
  # guard on its own, outside the dispatcher, and prints its stdout.
  local g="$1" payload="$2"
  shift 2
  (
    _ptd_export_pairs "$@"
    printf '%s' "${payload}" | /bin/zsh "${SCRIPT_DIR}/claude/hooks/${g}" 2>/dev/null
  ) || true
}

function _ptd_try_deny {
  # $1 = payload, $2 = needle in the dispatched reason, $3 = what, remaining
  # args = VAR=value pairs. Flags a problem unless the real dispatcher denies.
  local payload="$1" needle="$2" what="$3" reason
  shift 3
  _ptd_real "${payload}" "$@"
  if [[ "$(_hook_verdict "${PTD_OUT}")" != DENY || ${PTD_RC} -ne 0 ]]; then
    _ptd_flag "${what}: expected DENY with exit 0, got $(_hook_verdict "${PTD_OUT}") with exit ${PTD_RC}"
    return
  fi
  reason="$(_ptd_reason)"
  if [[ -n "${needle}" ]] && ! _ptd_has "${reason}" "${needle}"; then
    _ptd_flag "${what}: reason lacks '${needle}': ${reason:0:120}"
  fi
}

# --- the suite ---------------------------------------------------------------

function _ptd_fault_injection {
  local marker
  local -a left
  # One payload for every case that only needs a Bash call to run the guards.
  local hi
  hi="$(_ptd_bash 'echo hi')"

  _section "pretool-dispatch: fault injection (stub guards)"

  # Order, clean run, no leftovers.
  _ptd_new_box all-nine
  _ptd_run "${hi}"
  _ptd_want PASS 'a Bash call with passing stubs'
  [[ "$(_ptd_marker)" == "${PTD_BASH[*]}" ]] || _ptd_flag "guard order: $(_ptd_marker)"
  left=("${PTD_BOX}"/tmp/*(N))
  (( ${#left} == 0 )) || _ptd_flag "a run left files in TMPDIR: ${left[*]}"
  [[ ! -s "${PTD_BOX}/stderr" ]] || _ptd_flag "a clean run wrote to stderr: $(<"${PTD_BOX}/stderr")"
  _ptd_done "Bash runs the guards in the listed order, passes, leaves no capture file and no stderr"

  # A tool the matcher sends but the route table lacks means the two disagree:
  # a configuration bug, denied loudly, no guard run.
  _ptd_run "$(jq -cn '{tool_name:"Read", tool_input:{file_path:"/x/a"}, cwd:"/work"}')"
  _ptd_want DENY 'an unrouted tool'
  _ptd_has "$(_ptd_reason)" 'no guard route for tool Read' || _ptd_flag "reason does not name the tool"
  [[ ! -s "${PTD_BOX}/marker" ]] || _ptd_flag "a guard ran"
  _ptd_done "an unrouted tool is denied, naming the tool, and runs no guard"

  # Input the dispatcher cannot judge: the blocking status, never a pass.
  _ptd_run 'not json'
  _ptd_want_blocked 'malformed JSON'
  _ptd_done "malformed JSON exits 2 and runs no guard"
  # A literal NUL ends `read -d ''` early: the part before it must not be
  # judged on its own.
  _ptd_run $'{"tool_name":"Bash","tool_input":{"command":"ls"}}\0{"tool_name":"Bash","tool_input":{"command":"md5 x"}}'
  _ptd_want_blocked 'a literal NUL'
  _ptd_done "a literal NUL in the payload exits 2 and nothing after it is judged"

  # A failing stub is an ERROR, which denies, and the later guards still run.
  _ptd_new_box exit1
  _ptd_stub muse-exec-hook 'exit 1'
  _ptd_run "${hi}"
  _ptd_want DENY 'a stub that exits 1'
  _ptd_has "$(_ptd_reason)" 'guard muse-exec-hook failed (exit 1); command not run unguarded' || _ptd_flag "reason: $(_ptd_reason)"
  [[ "$(_ptd_marker)" == "${PTD_BASH[*]}" ]] || _ptd_flag "the guards after the failing stub did not all run: $(_ptd_marker)"
  _ptd_done "a stub that exits non-zero denies, names the guard and its status, and the other guards still run"

  # Only DENY<US>reason counts: a JSON deny printed by a stub is an ERROR.
  local j1='{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"a"}}'
  _ptd_new_box own-json
  _ptd_stub ssh-redirect-hook "print -r -- '${j1}'"
  _ptd_run "${hi}"
  _ptd_want DENY 'a stub that prints a JSON deny'
  _ptd_has "$(_ptd_reason)" 'guard ssh-redirect-hook failed' || _ptd_flag "not reported as a failure: $(_ptd_reason)"
  _ptd_done "a JSON deny printed by a stub is a guard failure, not a pass-through"

  # Reasons join in guard order, a reason survives the JSON round trip, and a
  # deny and an error share one object.
  _ptd_new_box reasons
  _ptd_stub git-bypass-hook "printf 'DENY\\x1fAAA'"
  # shellcheck disable=SC2016  # the stub's own printf, not this shell's
  _ptd_stub ssh-redirect-hook 'printf "DENY\x1fline1\nsay \"hi\" \\\\ end"'
  _ptd_stub container-tmp-hook 'exit 4'
  _ptd_run "${hi}"
  _ptd_want DENY 'two denies and an error'
  [[ "$(_ptd_reason)" == $'AAA | line1\nsay "hi" \\ end | guard container-tmp-hook failed (exit 4); command not run unguarded: no diagnostic' ]] || _ptd_flag "reason: $(_ptd_reason)"
  _ptd_done "deny reasons and errors join in guard order in one deny object, with newline, quote and backslash intact"

  _ptd_new_box sigterm
  # shellcheck disable=SC2016  # the stub's own text
  _ptd_stub muse-exec-hook 'kill -TERM $$; /bin/sleep 2'
  _ptd_run "${hi}"
  left=("${PTD_BOX}"/tmp/*(N))
  if [[ ${PTD_RC} -eq 2 && -z "${PTD_OUT}" && -s "${PTD_BOX}/stderr" && ${#left} -eq 0 && "$(_ptd_marker)" == 'gh-publish-hook git-bypass-hook muse-exec-hook' ]]; then
    _pass "a SIGTERM mid-run exits 2 (not 143), stops, and removes the capture file"
  else
    _fail "SIGTERM mid-run — rc=${PTD_RC} out=${PTD_OUT} left=${left[*]} marker=$(_ptd_marker)"
  fi

  # A fatal shell error inside the dispatcher itself (an unset variable under
  # set -u, injected into a copy) must end in the blocking status, not 1.
  _ptd_new_box crash
  # shellcheck disable=SC2016  # literal dispatcher text
  if [[ "$(/usr/bin/grep -c '^  local f_tool=' "${PTD_BOX}/pretool-dispatch")" == 1 ]]; then
    # shellcheck disable=SC2016
    /usr/bin/sed -i '' 's|^  local f_tool=|  : "${NOPE_UNSET_VARIABLE}"; local f_tool=|' "${PTD_BOX}/pretool-dispatch"
    _ptd_run "${hi}"
    left=("${PTD_BOX}"/tmp/*(N))
    if [[ ${PTD_RC} -eq 2 && -z "${PTD_OUT}" && ${#left} -eq 0 && "$(<"${PTD_BOX}/stderr")" == *'aborted unexpectedly'* && ! -s "${PTD_BOX}/marker" ]]; then
      _pass "a fatal error inside the dispatcher exits 2 (not 1), runs no guard and removes the capture file"
    else
      _fail "dispatcher crash — rc=${PTD_RC} out=${PTD_OUT} left=${left[*]} stderr=$(<"${PTD_BOX}/stderr")"
    fi
  else
    _fail "dispatcher crash case: the injection point in pretool-dispatch moved"
  fi

  # A guard file that is missing denies and does not stop the rest, and a
  # repeated top-level readonly in the guards is no failure (they run in a
  # function-local scope).
  _ptd_new_box missing
  zf_rm -f "${PTD_BOX}/ssh-redirect-hook"
  _ptd_stub muse-exec-hook 'readonly JQ=/usr/bin/jq'
  _ptd_stub gh-publish-hook 'readonly JQ=/usr/bin/jq'
  _ptd_stub git-bypass-hook 'readonly JQ=/usr/bin/jq'
  _ptd_run "${hi}"
  _ptd_want DENY 'a missing guard file'
  [[ "$(_ptd_reason)" == 'guard ssh-redirect-hook failed'* && "$(_ptd_reason)" != *' | '* ]] || _ptd_flag "reason: $(_ptd_reason)"
  [[ "$(_ptd_marker)" == "${PTD_BASH[*]:s/ssh-redirect-hook /}" ]] || _ptd_flag "the other guards did not all run: $(_ptd_marker)"
  _ptd_done "a missing guard file denies and names that guard only, the other guards run despite a repeated readonly"

  # A stub's options, cwd, umask and variables do not reach the next guard, and
  # a hostile startup file does not change the options the guards run under.
  _ptd_new_box isolation
  zf_mkdir -p "${PTD_BOX}/zd"
  print -r -- 'setopt extendedglob ksharrays errexit nounset kshglob shwordsplit' > "${PTD_BOX}/zd/.zshenv"
  # shellcheck disable=SC2016  # the stub's own text
  _ptd_stub gh-publish-hook 'setopt extendedglob kshglob shwordsplit; cd /; umask 000; typeset -g LEAK=1; trap "print trap >> ${PTD_MARKER}" EXIT'
  # shellcheck disable=SC2016  # the stub's own text
  _ptd_stub git-bypass-hook 'print -r -- "opts=$([[ -o extendedglob ]] && print on || print off)$([[ -o kshglob ]] && print on || print off)$([[ -o shwordsplit ]] && print on || print off)$([[ -o ksharrays ]] && print on || print off)$([[ -o errexit ]] && print on || print off)$([[ -o nounset ]] && print on || print off) pwd=${PWD:t} umask=$(umask) leak=${LEAK-unset}" >> "${PTD_MARKER}"'
  _ptd_run "${hi}" "ZDOTDIR=${PTD_BOX}/zd"
  _ptd_want PASS 'a startup file sets ksharrays, errexit and nounset'
  marker="$(<"${PTD_BOX}/marker")"
  _ptd_has "${marker}" 'opts=offoffoffoffoffoff pwd=isolation umask=077 leak=unset' || _ptd_flag "isolation: ${marker//$'\n'/ }"
  [[ "${marker}" == *"${PTD_BASH[-1]}" ]] || _ptd_flag "the run did not complete under that startup file"
  _ptd_done "a stub's options, cwd, umask and variables do not reach the next guard, and a hostile startup file changes nothing"

  # What a guard is handed: tool, path, joined content, trailing newlines
  # removed, the payload on stdin, nothing exported.
  _ptd_new_box seam
  # shellcheck disable=SC2016  # the stub's own text
  _ptd_stub md5-write-hook 'print -rn -- "${HOOK_PRE_DISPATCH}|${HOOK_PRE_TOOL}|${HOOK_PRE_PATH}|${HOOK_PRE_CONTENT}|${HOOK_PRE_COMMAND}|${HOOK_PRE_CWD}|" > "${PTD_BOX_OUT}"; print -rn -- "$(cat)" > "${PTD_BOX_OUT}.stdin"; [[ "$(/usr/bin/env)" == *HOOK_PRE_* ]] && print exported >> "${PTD_BOX_OUT}.leak"; true'
  _ptd_run "$(jq -cn '{tool_name:"Edit", tool_input:{file_path:"/x/p q.txt", old_string:"o", new_string:"N1\nN2\n\n", content:"C"}, cwd:"/some dir/"}')" "PTD_BOX_OUT=${PTD_BOX}/seam.out"
  _ptd_want PASS 'an Edit call whose stub records its seam variables'
  [[ "$(<"${PTD_BOX}/seam.out")" == $'1|Edit|/x/p q.txt|C\nN1\nN2||/some dir/|' ]] || _ptd_flag "Edit seam: $(<"${PTD_BOX}/seam.out")"
  _ptd_has "$(<"${PTD_BOX}/seam.out.stdin")" '"tool_name":"Edit"' || _ptd_flag "the stub did not get the payload on stdin"
  [[ ! -e "${PTD_BOX}/seam.out.leak" ]] || _ptd_flag "the seam variables are exported to a guard's children"
  _ptd_done "a guard gets tool, path, joined content and cwd with trailing newlines removed, the payload on stdin, and nothing exported"

  # A Monitor command reaches its guards as a Bash command.
  _ptd_new_box seam-monitor
  # shellcheck disable=SC2016  # the stub's own text
  _ptd_stub gh-publish-hook 'print -rn -- "${HOOK_PRE_TOOL}|${HOOK_PRE_COMMAND}|${HOOK_PRE_PATH}|${HOOK_PRE_CWD}|" > "${PTD_BOX_OUT}"; print -rn -- "$(cat)" > "${PTD_BOX_OUT}.stdin"'
  _ptd_run "$(_ptd_monitor $'echo a\nls "b c"\n\n')" "PTD_BOX_OUT=${PTD_BOX}/seam.out"
  _ptd_want PASS 'a Monitor call whose stub records its seam variables'
  [[ "$(<"${PTD_BOX}/seam.out")" == $'Bash|echo a\nls "b c"||/work|' ]] || _ptd_flag "Monitor seam: $(<"${PTD_BOX}/seam.out")"
  _ptd_has "$(<"${PTD_BOX}/seam.out.stdin")" '"tool_name":"Monitor"' || _ptd_flag "the stub payload does not name the Monitor tool"
  _ptd_done "a Monitor command reaches the Bash guards as the Bash tool, while the payload still names Monitor"

  # No environment can redirect the guard directory.
  _ptd_new_box env-override
  zf_mkdir -p "${PTD_BOX}/elsewhere"
  _ptd_run "${hi}" "GUARD_DIR=${PTD_BOX}/elsewhere" "HOOK_GUARD_DIR=${PTD_BOX}/elsewhere" "PRETOOL_DISPATCH_DIR=${PTD_BOX}/elsewhere" "ROUTES=Bash:"
  _ptd_want PASS 'guard-directory and route environment variables are set'
  [[ "$(_ptd_marker)" == "${PTD_BASH[*]}" ]] || _ptd_flag "the guards did not come from the dispatcher's own directory: $(_ptd_marker)"
  _ptd_done "no environment variable redirects the guard directory or the route table"
}

function _ptd_real_guards {
  _section "pretool-dispatch: the real guards through the real dispatcher"

  # A deny on the Bash route and on the Write route, with the guard's reason.
  _ptd_try_deny "$(_ptd_bash 'git commit -n')" 'git commit -n (--no-verify)' 'git-bypass-hook on the Bash route'
  _ptd_done "the real dispatcher denies git commit -n with the guard's reason"
  _ptd_try_deny "$(_ptd_write /tmp/x body)" 'write to /tmp blocked' 'tmp-guard-hook on the Write route'
  _ptd_done "the real dispatcher denies a Write into /tmp with the guard's reason"

  # A Monitor call is denied as the same Bash call is: the dispatcher hands
  # the Bash-only guards (here git-bypass-hook) the Bash tool.
  _ptd_try_deny "$(_ptd_monitor 'git commit --no-verify -m x')" 'git commit --no-verify' 'a Monitor call'
  _ptd_done "the real dispatcher denies a Monitor git commit --no-verify"

  # A call that must never be denied.
  _ptd_real "$(_ptd_bash 'ls -la')"
  _ptd_want PASS 'ls -la'
  _ptd_done "ls -la passes every Bash guard"

  # The seam must only work while a guard is being sourced: an exported
  # HOOK_PRE_DISPATCH=1 (reachable through ~/.zshenv, which no guard blocks)
  # must not turn a standalone guard into a skip, nor its deny into text.
  local seam_out
  seam_out="$(_ptd_run_guard git-bypass-hook "$(_ptd_bash 'git commit -n')" HOOK_PRE_DISPATCH=1 HOOK_PRE_TOOL=Bash HOOK_PRE_COMMAND=ls HOOK_PRE_PATH=/x/ok HOOK_PRE_CONTENT=ok HOOK_PRE_CWD=/work)"
  [[ "$(_hook_verdict "${seam_out}")" == DENY ]] || _ptd_flag "got $(_hook_verdict "${seam_out}"): ${seam_out:0:80}"
  _ptd_done "a standalone guard still denies with HOOK_PRE_DISPATCH=1 in its environment"
}

function _ptd_dirs_ok {
  # $1 = a CLAUDE_CODE_PLUGIN_DIRS value. True when it starts with the
  # prefilter mod then the git-sign-post mod, and every further entry is
  # `~/.claude/mods/<name>`, all joined by `:`. The leading `~` is literal:
  # Claude Code expands it, not the shell.
  local re='^~/\.claude/mods/pretool-prefilter:~/\.claude/mods/git-sign-post(:~/\.claude/mods/[A-Za-z0-9_-]+)*$'
  [[ "${1-}" =~ ${re} ]] || return 1
  # No entry twice: a repeated mod would load twice.
  # shellcheck disable=SC2296  # zsh split flag
  local -a entries=("${(@s.:.)1}")
  # shellcheck disable=SC2296  # zsh unique flag
  local -a uniq=("${(@u)entries}")
  (( ${#entries} == ${#uniq} ))
}

function _ptd_settings_shape {
  # $1 = settings file (default: the repo copy). Pins the registration shape:
  # the mods carry the guards, so env loads the prefilter and git-sign-post
  # mods and no settings entry registers the dispatcher, a standalone guard or
  # git-sign-hook (a leftover entry runs the same work twice per call). The
  # dirs start with `~` (Claude Code expands it there, not `$HOME`), so the
  # file names no home directory and serves every Mac.
  local settings="${1:-${SCRIPT_DIR}/claude/settings.json}"
  _section "pretool-dispatch: settings registration shape"

  if [[ ! -f "${settings}" ]]; then
    _skip "claude/settings.json absent: claude/ not yet synced to this machine"
    return 0
  fi

  local n dirs base
  n="$(jq -r '[.hooks.PreToolUse[]? | select(any(.hooks[]?; (.command | tostring | endswith("/pretool-dispatch"))))] | length' "${settings}")"
  [[ "${n}" == 0 ]] || _ptd_flag "${n} PreToolUse entries register the dispatcher, expected 0 (the mod runs it too: every guard twice)"

  n="$(jq -r '[.hooks[]?[]? | .hooks[]? | select(.command | tostring | endswith("/git-sign-hook"))] | length' "${settings}")"
  [[ "${n}" == 0 ]] || _ptd_flag "${n} settings entries register git-sign-hook, expected 0 (the mod runs it too: every nudge twice)"

  dirs="$(jq -r '.env.CLAUDE_CODE_PLUGIN_DIRS // "ABSENT"' "${settings}")"
  _ptd_dirs_ok "${dirs}" || _ptd_flag "env.CLAUDE_CODE_PLUGIN_DIRS is '${dirs}', expected the prefilter and git-sign-post mods first, then only ~/.claude/mods/<name> entries"

  while IFS= read -r base; do
    [[ -n "${base}" ]] || continue
    # shellcheck disable=SC2076  # literal substring match against the joined list
    [[ " ${PTD_ALL[*]} " == *" ${base} "* ]] && _ptd_flag "standalone guard entry remains in PreToolUse: ${base}"
  done < <(jq -r '.hooks.PreToolUse[]? | .hooks[]? | .command | tostring | split("/") | last' "${settings}")
  _ptd_done "the mods carry the guards: no settings entry registers the dispatcher, git-sign-hook or a standalone guard, and the plugin dirs are well-formed"
}

function run_pretool_dispatch {
  # claude/ is gitignored and synced out of band: an absent dispatcher is
  # pending sync, not a regression.
  if [[ ! -f "${SCRIPT_DIR}/claude/hooks/pretool-dispatch" ]]; then
    _section "pretool-dispatch"
    _skip "claude/hooks/pretool-dispatch absent: claude/ not yet synced to this machine"
    return 0
  fi
  if ! [[ -x "$(command -v jq)" ]]; then
    _section "pretool-dispatch"
    _skip "jq not installed (brew install jq)"
    return 0
  fi

  PTD_SB="$(mktemp -d "${TMPDIR:-/tmp}/pretool-dispatch-test.XXXXXX")"
  zmodload -F zsh/files b:zf_mkdir b:zf_rm
  PTD_DISPATCHER="$(<"${SCRIPT_DIR}/claude/hooks/pretool-dispatch")"
  trap '/bin/rm -rf "${PTD_SB}"' EXIT

  _ptd_fault_injection

  local g missing=0
  for g in "${PTD_ALL[@]}"; do
    [[ -r "${SCRIPT_DIR}/claude/hooks/${g}" ]] || missing=1
  done
  if (( missing )); then
    _section "pretool-dispatch: the real guards through the real dispatcher"
    _skip "a guard file is absent: claude/ not fully synced to this machine"
  else
    _ptd_real_guards
  fi

  _ptd_settings_shape
}
