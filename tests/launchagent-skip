#!/bin/zsh
# dotfiles/tests/launchagent-skip
#
# Checks the per-host LaunchAgent skip file (_launchagent_skipped in
# bittersweet). install_launchagents and load_launchagents run against a
# fixture HOME with stub launchctl, sudo and get_sudo; sed, plutil, mv, chmod
# and xattr are real. A listed label must keep its existing plist byte for byte
# and get no launchctl call. An unlisted label installs and loads as before.
# The sudo stub records its arguments and runs nothing, so the suite sees the
# daemon steps: a listed daemon label gets no sudo call that names it.
# The real ~/Library/LaunchAgents and launchd are never touched.
# install_scripts runs with the same recording sudo stub: every write in it
# goes through sudo, so nothing reaches /usr/local/bin. A listed jump label
# gets no sudo call that names its program.
#
# BITTERSWEET_UNDER_TEST points the suite at another copy of bittersweet (used
# to prove the suite goes red when the skip check is broken).
#
# Run: ./test launchagent-skip
# ShellCheck: lint with `shellcheck --shell=bash tests/launchagent-skip`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck disable=SC2329  # stubs called by sourced code

# _launchagent_skip_case MODE
#   MODE: listed (the skip file names container-start), daemon (the skip file
#   names the jump-system daemon), unlisted (the skip file names no real
#   agent), absent (no skip file at the given path).
#   The fixture starts with a foreign container-start plist.
#   Prints six tab-separated fields: rc; the container-start plist (foreign =
#   unchanged, repo = replaced, missing); any launchctl call naming
#   container-start (yes/no); a bootstrap of container-start (yes/no);
#   scratch-sweep installed and bootstrapped (yes/no); the jump-system daemon
#   (yes = plist copy and bootstrap both asked of sudo, no = no sudo call
#   names it, part = any other mix).
function _launchagent_skip_case {
  local mode="$1"
  (
    local fixture
    fixture="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/la-skip.XXXXXX")" || return 1
    trap '/bin/rm -rf -- "${fixture}"' EXIT
    export HOME="${fixture}/home"
    local agents="${HOME}/Library/LaunchAgents"
    local calls="${fixture}/launchctl-calls" skip="${fixture}/skip"
    local sudo_calls="${fixture}/sudo-calls"
    /bin/mkdir -p "${agents}"
    : > "${calls}"
    : > "${sudo_calls}"
    print -r -- 'foreign plist bytes' > "${agents}/com.0xmachos.container-start.plist"
    case "${mode}" in
      listed) print -l -- '# owned by another repo on this host' 'com.0xmachos.container-start' > "${skip}" ;;
      daemon) print -l -- '# this host must not run it' 'com.0xmachos.jump-system' > "${skip}" ;;
      unlisted) print -l -- '# nothing real' 'com.0xmachos.not-an-agent' > "${skip}" ;;
    esac
    # shellcheck disable=SC2030,SC2031  # each case sets it in its own subshell
    export LAUNCHAGENT_SKIP_FILE="${skip}"
    # shellcheck disable=SC1090,SC1091
    source <(/usr/bin/awk '
      /^function / || /^typeset -ra LAUNCHAGENT_PLISTS=\(/ { block = 1 }
      block { print }
      /^}$/ || /^\)$/ { block = 0 }
    ' "${BITTERSWEET_UNDER_TEST:-${SCRIPT_DIR}/bittersweet}")
    get_sudo() { :; }
    sudo() { print -r -- "$*" >> "${sudo_calls}"; return 0; }
    launchctl() {
      print -r -- "$*" >> "${calls}"
      [[ "$1" == print ]] && print -r -- $'\tIIOEnableOOP => 1'
      return 0
    }
    local rc=0
    { install_launchagents && load_launchagents; } > /dev/null 2>&1 || rc=$?
    local cs_file="${agents}/com.0xmachos.container-start.plist" cs=missing
    if [[ -f "${cs_file}" ]]; then
      if [[ "$(<"${cs_file}")" == 'foreign plist bytes' ]]; then cs=foreign; else cs=repo; fi
    fi
    local cs_any=no cs_boot=no ss=no
    /usr/bin/grep -q 'container-start' "${calls}" && cs_any=yes
    /usr/bin/grep -q '^bootstrap .*com\.0xmachos\.container-start\.plist$' "${calls}" && cs_boot=yes
    if [[ -f "${agents}/com.0xmachos.scratch-sweep.plist" ]] \
       && /usr/bin/grep -q '^bootstrap .*com\.0xmachos\.scratch-sweep\.plist$' "${calls}"; then
      ss=yes
    fi
    local daemon=part
    if ! /usr/bin/grep -q 'jump-system' "${sudo_calls}"; then
      daemon=no
    elif /usr/bin/grep -q '^cp .*/LaunchDaemons/com\.0xmachos\.jump-system\.plist /Library/LaunchDaemons/com\.0xmachos\.jump-system\.plist$' "${sudo_calls}" \
         && /usr/bin/grep -q '^launchctl bootstrap system /Library/LaunchDaemons/com\.0xmachos\.jump-system\.plist$' "${sudo_calls}"; then
      daemon=yes
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "${rc}" "${cs}" "${cs_any}" "${cs_boot}" "${ss}" "${daemon}"
  )
}

# _launchagent_skip_scripts_case MODE
#   MODE: both (the skip file names both jump labels), user (jump-user only),
#   absent (no skip file).
#   Prints four tab-separated fields: rc; jump-user copied (yes = rm and cp
#   asked of sudo, no = no sudo call names the program, part); jump-system
#   likewise; scratch-sweep copied (yes/no).
function _launchagent_skip_scripts_case {
  local mode="$1"
  (
    local fixture
    fixture="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/la-skip-scripts.XXXXXX")" || return 1
    trap '/bin/rm -rf -- "${fixture}"' EXIT
    local skip="${fixture}/skip" sudo_calls="${fixture}/sudo-calls"
    : > "${sudo_calls}"
    case "${mode}" in
      both) print -l -- 'com.0xmachos.jump-user' 'com.0xmachos.jump-system' > "${skip}" ;;
      user) print -l -- 'com.0xmachos.jump-user' > "${skip}" ;;
    esac
    # shellcheck disable=SC2030,SC2031  # each case sets it in its own subshell
    export LAUNCHAGENT_SKIP_FILE="${skip}"
    # shellcheck disable=SC1090,SC1091
    source <(/usr/bin/awk '
      /^function / || /^typeset -ra LAUNCHAGENT_PLISTS=\(/ { block = 1 }
      block { print }
      /^}$/ || /^\)$/ { block = 0 }
    ' "${BITTERSWEET_UNDER_TEST:-${SCRIPT_DIR}/bittersweet}")
    get_sudo() { :; }
    _bin_target_is_foreign() { return 1; }
    _retire_bao_mcp_link() { :; }
    sudo() { print -r -- "$*" >> "${sudo_calls}"; return 0; }
    local rc=0
    install_scripts > /dev/null 2>&1 || rc=$?
    local name state
    local -a states=()
    for name in jump-user jump-system scratch-sweep; do
      state=part
      if ! /usr/bin/grep -q "/usr/local/bin/${name}\$" "${sudo_calls}"; then
        state=no
      elif /usr/bin/grep -q "^rm -f /usr/local/bin/${name}\$" "${sudo_calls}" \
           && /usr/bin/grep -q "^cp .*/bin/${name} /usr/local/bin/${name}\$" "${sudo_calls}"; then
        state=yes
      fi
      states+=("${state}")
    done
    printf '%s\t%s\t%s\t%s\n' "${rc}" "${states[1]}" "${states[2]}" "${states[3]}"
  )
}

function run_launchagent_skip {
  _section "bittersweet launchagents: per-host skip file"

  local scripts_out
  scripts_out="$(_launchagent_skip_scripts_case both)"
  if [[ "${scripts_out}" == $'0\tno\tno\tyes' ]]; then
    _pass "install_scripts: both jump labels listed, no sudo call names either program; other programs still install"
  else
    _fail "install_scripts both: expected '0 no no yes', got '${scripts_out}'"
  fi
  scripts_out="$(_launchagent_skip_scripts_case user)"
  if [[ "${scripts_out}" == $'0\tno\tyes\tyes' ]]; then
    _pass "install_scripts: only the listed jump program is skipped"
  else
    _fail "install_scripts user: expected '0 no yes yes', got '${scripts_out}'"
  fi
  scripts_out="$(_launchagent_skip_scripts_case absent)"
  if [[ "${scripts_out}" == $'0\tyes\tyes\tyes' ]]; then
    _pass "install_scripts: with no skip file both jump programs install as before"
  else
    _fail "install_scripts absent: expected '0 yes yes yes', got '${scripts_out}'"
  fi

  local out mode
  out="$(_launchagent_skip_case listed)"
  if [[ "${out}" == $'0\tforeign\tno\tno\tyes\tyes' ]]; then
    _pass "a listed label keeps its plist byte for byte and gets no launchctl call; other agents and the daemon still install and load"
  else
    _fail "listed: expected '0 foreign no no yes yes', got '${out}'"
  fi

  out="$(_launchagent_skip_case daemon)"
  if [[ "${out}" == $'0\trepo\tyes\tyes\tyes\tno' ]]; then
    _pass "a listed daemon label gets no sudo call that names it; the agents still install and load"
  else
    _fail "daemon: expected '0 repo yes yes yes no', got '${out}'"
  fi

  for mode in unlisted absent; do
    out="$(_launchagent_skip_case "${mode}")"
    if [[ "${out}" == $'0\trepo\tyes\tyes\tyes\tyes' ]]; then
      _pass "${mode} skip file: container-start and the daemon install and load as before"
    else
      _fail "${mode}: expected '0 repo yes yes yes yes', got '${out}'"
    fi
  done
}
