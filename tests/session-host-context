#!/bin/zsh
# dotfiles/tests/session-host-context
#
# Behavioural test for claude/session-host-context — the SessionStart hook
# that injects live host identity (hostname, macOS version+build, running
# Claude Code version) into session context, as one line. Feeds SessionStart
# payloads as stdin JSON and asserts stdout text and exit code directly:
# this hook never emits a hookSpecificOutput deny verdict (only PreToolUse
# hooks do), so _hook_verdict, built for parsing those, does not apply here.
#
# The hook resolves scutil/sw_vers/readlink by absolute path, not PATH, so
# the PATH-prefix stubbing pattern (tests/git-sign) cannot intercept them.
# This suite instead uses the SESSION_HOST_CONTEXT_SCUTIL/_SW_VERS/_READLINK
# env-seam overrides the hook itself defines — the same seam style AGENTS.md
# names for other hook suites (GH_PUBLISH_*, PII_HOOK_*).
#
# The hosts/<host>.md mechanism, present in the pre-2026-09-25 version of
# this hook, is dropped entirely as of the 2026-09-25 restore — see the
# "mechanism is gone, not inert" case below, which asserts a
# hosts/<host>.md file present on disk has no effect.
#
# Run: ./test session-host-context    (or ./test for the full suite)
#
# ShellCheck: lint with `shellcheck --shell=bash tests/session-host-context`.
# This file is sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

function _shc_run {
  # Echo the hook's stdout for stdin payload $1, with any extra `env`
  # arguments ($2...) applied around the call (VAR=value or -u VAR forms).
  local payload="$1"
  shift
  printf '%s' "${payload}" \
    | env "$@" /bin/zsh "${SCRIPT_DIR}/claude/session-host-context" || true
}

function _shc_expect_exit0 {
  # Run the hook with stdin payload $1 (remaining args are `env` arguments)
  # and assert it exits 0, labelled $2.
  local payload="$1" label="$2" got=0
  shift 2
  printf '%s' "${payload}" \
    | env "$@" /bin/zsh "${SCRIPT_DIR}/claude/session-host-context" >/dev/null \
    || got=$?
  if [[ "${got}" -eq 0 ]]; then
    _pass "${label}: exit 0"
  else
    _fail "${label}: expected exit 0, got ${got}"
  fi
}

function run_session_host_context {
  _section "Session host context hook"

  # The hook file may be absent (a clean clone, or claude/ not yet synced):
  # that is not a regression. Skip, don't die.
  if [[ ! -f "${SCRIPT_DIR}/claude/session-host-context" ]]; then
    _skip "claude/session-host-context absent — claude/ not yet synced to this machine"
    return 0
  fi

  local stub_dir out got
  stub_dir="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/session-host-context-test.XXXXXX")"

  # A stub scutil emitting a mixed-case hostname, so the lowercasing
  # assertion has something to bite on.
  {
    print -r -- '#!/bin/sh'
    print -r -- 'echo "TestHost-Mixed"'
  } > "${stub_dir}/scutil"
  chmod 755 "${stub_dir}/scutil"

  # A stub scutil that fails outright, for the "unknown" fallback.
  {
    print -r -- '#!/bin/sh'
    print -r -- 'exit 1'
  } > "${stub_dir}/scutil-fail"
  chmod 755 "${stub_dir}/scutil-fail"

  # sw_vers stubs mimic the real no-flag form (three tab-separated
  # ProductName/ProductVersion/BuildVersion lines) since the hook now makes
  # one sw_vers call, not two flagged ones: a pre-release (letter-ending
  # build), a release (digit-ending build), and one that fails.
  {
    print -r -- '#!/bin/sh'
    print -r -- 'printf "ProductName:\t\tmacOS\nProductVersion:\t\t26.5\nBuildVersion:\t\t26A5378n\n"'
  } > "${stub_dir}/sw_vers-seed"
  chmod 755 "${stub_dir}/sw_vers-seed"
  {
    print -r -- '#!/bin/sh'
    print -r -- 'printf "ProductName:\t\tmacOS\nProductVersion:\t\t27.0\nBuildVersion:\t\t26A428\n"'
  } > "${stub_dir}/sw_vers-release"
  chmod 755 "${stub_dir}/sw_vers-release"
  {
    print -r -- '#!/bin/sh'
    print -r -- 'exit 1'
  } > "${stub_dir}/sw_vers-fail"
  chmod 755 "${stub_dir}/sw_vers-fail"

  # readlink stub returning a fake versions/ path.
  {
    print -r -- '#!/bin/sh'
    print -r -- 'echo "/fake/versions/9.9.9/cli.js"'
  } > "${stub_dir}/readlink-fake"
  chmod 755 "${stub_dir}/readlink-fake"
  # readlink stub that resolves nothing (empty), for the "neither present" case.
  {
    print -r -- '#!/bin/sh'
    print -r -- 'exit 1'
  } > "${stub_dir}/readlink-fail"
  chmod 755 "${stub_dir}/readlink-fail"

  # --- resume / fork: silent, exit 0 -----------------------------------
  out="$(_shc_run '{"source":"resume"}')"
  if [[ -z "${out}" ]]; then
    _pass "resume (compact JSON): empty stdout"
  else
    _fail "resume (compact JSON): expected empty stdout, got: ${out}"
  fi
  _shc_expect_exit0 '{"source":"resume"}' "resume"

  out="$(_shc_run '{"source": "resume"}')"
  if [[ -z "${out}" ]]; then
    _pass "resume (spaced JSON): empty stdout"
  else
    _fail "resume (spaced JSON): expected empty stdout, got: ${out}"
  fi

  out="$(_shc_run '{"source":"fork"}')"
  if [[ -z "${out}" ]]; then
    _pass "fork: empty stdout"
  else
    _fail "fork: expected empty stdout, got: ${out}"
  fi
  _shc_expect_exit0 '{"source":"fork"}' "fork"

  # --- regression: a stripped PATH must not defeat the resume skip -------
  # Regression, 2026-09-25: the pre-2026-09-25 version read stdin via a bare
  # `cat`, so a hostile/stripped PATH made `cat` fail, left `input` empty,
  # and let the resume/fork skip fall through silently (double injection).
  # Stdin is now read via the `read` builtin, which has no PATH dependency
  # at all.
  out="$(_shc_run '{"source":"resume"}' 'PATH=/nonexistent')"
  if [[ -z "${out}" ]]; then
    _pass "resume under a stripped PATH: empty stdout (PATH-independent stdin read)"
  else
    _fail "resume under a stripped PATH: expected empty stdout, got: ${out}"
  fi
  _shc_expect_exit0 '{"source":"resume"}' "resume under a stripped PATH" 'PATH=/nonexistent'

  # --- regression: HOME and CLAUDE_CODE_EXECPATH both unset must still
  # exit 0 (fail-open even with set -u; the readlink fallback path
  # references $HOME) ------------------------------------------------------
  _shc_expect_exit0 '{"source":"startup"}' "HOME and CLAUDE_CODE_EXECPATH both unset" \
    -u HOME -u CLAUDE_CODE_EXECPATH

  # --- startup / clear / compact / no source: fire, exit 0, ONE line ----
  local payload
  for payload in '{}' '{"source":"startup"}' '{"source":"clear"}' '{"source":"compact"}'; do
    out="$(_shc_run "${payload}")"
    if [[ -n "${out}" && "${out}" == 'Host: '* && "${out}" != *$'\n'* ]]; then
      _pass "${payload}: non-empty single-line stdout starting 'Host: '"
    else
      _fail "${payload}: expected a single 'Host: ...' line, got: ${out}"
    fi
  done
  _shc_expect_exit0 '{"source":"startup"}' "startup"

  # --- hostname lowercased -----------------------------------------------
  out="$(_shc_run '{"source":"startup"}' "SESSION_HOST_CONTEXT_SCUTIL=${stub_dir}/scutil")"
  if [[ "${out}" == *"Host: testhost-mixed"* ]]; then
    _pass "mixed-case hostname is lowercased in output"
  else
    _fail "mixed-case hostname not lowercased, got: ${out}"
  fi

  # --- scutil failure -> unknown fallback --------------------------------
  out="$(_shc_run '{"source":"startup"}' "SESSION_HOST_CONTEXT_SCUTIL=${stub_dir}/scutil-fail")"
  if [[ "${out}" == *"Host: unknown"* ]]; then
    _pass "scutil failure falls back to 'unknown'"
  else
    _fail "scutil failure did not fall back to 'unknown', got: ${out}"
  fi

  # --- OS segment: seed vs release vs failure, one sw_vers call ----------
  out="$(_shc_run '{"source":"startup"}' "SESSION_HOST_CONTEXT_SW_VERS=${stub_dir}/sw_vers-seed")"
  if [[ "${out}" == *"macOS 26.5 (26A5378n, seed)"* ]]; then
    _pass "letter-ending build gets pre-release seed phrasing"
  else
    _fail "letter-ending build missing seed phrasing, got: ${out}"
  fi

  out="$(_shc_run '{"source":"startup"}' "SESSION_HOST_CONTEXT_SW_VERS=${stub_dir}/sw_vers-release")"
  if [[ "${out}" == *"macOS 27.0 (26A428)"* && "${out}" != *"seed"* ]]; then
    _pass "digit-ending build gets plain macOS segment, no seed phrasing"
  else
    _fail "digit-ending build phrasing wrong, got: ${out}"
  fi

  out="$(_shc_run '{"source":"startup"}' "SESSION_HOST_CONTEXT_SW_VERS=${stub_dir}/sw_vers-fail")"
  if [[ "${out}" != *"macOS "* ]]; then
    _pass "sw_vers failure omits the macOS segment"
  else
    _fail "sw_vers failure should omit the macOS segment, got: ${out}"
  fi
  _shc_expect_exit0 '{"source":"startup"}' "sw_vers failure" \
    "SESSION_HOST_CONTEXT_SW_VERS=${stub_dir}/sw_vers-fail"

  # --- Claude Code version: EXECPATH, readlink fallback, neither --------
  out="$(_shc_run '{"source":"startup"}' 'CLAUDE_CODE_EXECPATH=/x/versions/2.9.9')"
  if [[ "${out}" == *"Claude Code 2.9.9"* ]]; then
    _pass "CLAUDE_CODE_EXECPATH version is printed"
  else
    _fail "CLAUDE_CODE_EXECPATH version not printed, got: ${out}"
  fi

  out="$(_shc_run '{"source":"startup"}' -u CLAUDE_CODE_EXECPATH "SESSION_HOST_CONTEXT_READLINK=${stub_dir}/readlink-fake")"
  if [[ "${out}" == *"Claude Code 9.9.9"* ]]; then
    _pass "readlink fallback version is printed when EXECPATH is unset"
  else
    _fail "readlink fallback version not printed, got: ${out}"
  fi

  # --- regression: EXECPATH set but without "versions/" must still fall
  # back to readlink, not omit the version outright. Regression, 2026-09-25:
  # a global npm/Homebrew EXECPATH shape (e.g. .../claude-code/cli.js)
  # previously short-circuited the readlink fallback because it only ran
  # when EXECPATH was *unset*.
  out="$(_shc_run '{"source":"startup"}' \
    'CLAUDE_CODE_EXECPATH=/opt/homebrew/lib/node_modules/@anthropic-ai/claude-code/cli.js' \
    "SESSION_HOST_CONTEXT_READLINK=${stub_dir}/readlink-fake")"
  if [[ "${out}" == *"Claude Code 9.9.9"* ]]; then
    _pass "EXECPATH without 'versions/' falls back to readlink"
  else
    _fail "EXECPATH without 'versions/' did not fall back to readlink, got: ${out}"
  fi

  out="$(_shc_run '{"source":"startup"}' -u CLAUDE_CODE_EXECPATH "SESSION_HOST_CONTEXT_READLINK=${stub_dir}/readlink-fail")"
  if [[ "${out}" != *"Claude Code"* ]]; then
    _pass "neither EXECPATH nor readlink: Claude Code segment omitted"
  else
    _fail "Claude Code segment should be omitted, got: ${out}"
  fi
  _shc_expect_exit0 '{"source":"startup"}' "no version resolvable" \
    -u CLAUDE_CODE_EXECPATH "SESSION_HOST_CONTEXT_READLINK=${stub_dir}/readlink-fail"

  # --- regression: the hosts/<host>.md mechanism is gone, not inert -------
  # Regression, 2026-09-25: the pre-2026-09-25 version's cat step read and
  # appended ~/.claude/hosts/<host>.md with no provenance check. Dropped entirely —
  # a file at that path (even one that would have matched the stubbed
  # hostname) must never appear in the output.
  local sandbox_home
  sandbox_home="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/session-host-context-home.XXXXXX")"
  mkdir -p "${sandbox_home}/.claude/hosts"
  echo "Injected host note — should never appear." > "${sandbox_home}/.claude/hosts/testhost-mixed.md"
  out="$(_shc_run '{"source":"startup"}' "HOME=${sandbox_home}" "SESSION_HOST_CONTEXT_SCUTIL=${stub_dir}/scutil")"
  if [[ "${out}" != *"Injected host note"* && "${out}" != *$'\n'* ]]; then
    _pass "hosts/<host>.md content is never read (mechanism dropped)"
  else
    _fail "hosts/<host>.md content leaked into output, got: ${out}"
  fi
  _shc_expect_exit0 '{"source":"startup"}' "hosts/<host>.md present but unused" \
    "HOME=${sandbox_home}" "SESSION_HOST_CONTEXT_SCUTIL=${stub_dir}/scutil"
  /bin/rm -rf "${sandbox_home}"

  # --- real common-path output stays at or under the 150-byte target (no
  # stubs — the actual scutil/sw_vers/EXECPATH this Mac has). Measured with
  # `wc -c` (bytes), not `${#out}` (zsh counts characters under a UTF-8
  # locale, and the "·" separator is 2 bytes but 1 character — the two
  # metrics disagree by a few bytes on this hook's own output). -----------
  out="$(_shc_run '{"source":"startup"}')"
  got="$(printf '%s' "${out}" | /usr/bin/wc -c | tr -d ' ')"
  if [[ "${out}" == 'Host: '* && "${out}" != *$'\n'* && ${got} -le 150 ]]; then
    _pass "real common-path output is one line, ${got} bytes (<= 150)"
  else
    _fail "real common-path output failed the one-line/150-byte check (${got} bytes): ${out}"
  fi

  # --- worst-case stubbed output stays comfortably under the documented
  # 10,000-char harness output cap (characters, matching the cap's own
  # unit — not the byte metric above), with enough margin below the cap
  # that a shape regression (a duplicated segment, an unbounded hostname)
  # would trip this case well before the cap itself would: the exact
  # string is deterministic from the stubs above, so this checks it
  # directly rather than against a loose bound the real content could
  # never approach. Not a live trip of the harness's own truncation
  # behaviour, which needs an actual session — a regression guard on this
  # hook's own output shape only. ----------------------------------------
  local big_out big_len long_host expected_big_out
  long_host="$(/usr/bin/python3 -c "print('x' * 200)")"
  {
    print -r -- '#!/bin/sh'
    print -r -- "echo \"${long_host}\""
  } > "${stub_dir}/scutil-long"
  chmod 755 "${stub_dir}/scutil-long"
  big_out="$(_shc_run '{"source":"startup"}' \
    "SESSION_HOST_CONTEXT_SCUTIL=${stub_dir}/scutil-long" \
    "SESSION_HOST_CONTEXT_SW_VERS=${stub_dir}/sw_vers-seed" \
    'CLAUDE_CODE_EXECPATH=/x/versions/2026.99.99-a-very-long-pre-release-suffix')"
  expected_big_out="Host: ${long_host} · macOS 26.5 (26A5378n, seed) · Claude Code 2026.99.99-a-very-long-pre-release-suffix"
  big_len=${#big_out}
  if [[ "${big_out}" == "${expected_big_out}" && ${big_len} -lt 1000 ]]; then
    _pass "worst-case stubbed output matches exactly (${big_len} chars, well under the 10,000-char cap)"
  else
    _fail "worst-case stubbed output changed shape (${big_len} chars): ${big_out}"
  fi

  # --- regression: a newline embedded in a probed value must not turn the
  # one-line output contract into two lines. Not reachable today
  # (LocalHostName is RFC-1034-restricted; $CLAUDE_CODE_EXECPATH is this
  # installation's own path) but the hook strips at the first newline in
  # both, so this guards that behaviour directly. --------------------------
  {
    print -r -- '#!/bin/sh'
    print -r -- 'echo "firstline"'
    print -r -- 'echo "second line · macOS should not appear"'
  } > "${stub_dir}/scutil-newline"
  chmod 755 "${stub_dir}/scutil-newline"
  out="$(_shc_run '{"source":"startup"}' "SESSION_HOST_CONTEXT_SCUTIL=${stub_dir}/scutil-newline")"
  if [[ "${out}" == 'Host: firstline'* && "${out}" != *$'\n'* ]]; then
    _pass "a newline in the scutil probe's output is truncated to one line"
  else
    _fail "a newline in the scutil probe's output was not truncated, got: ${out}"
  fi

  out="$(_shc_run '{"source":"startup"}' $'CLAUDE_CODE_EXECPATH=/x/versions/2.9.9\nevil/cli.js')"
  if [[ "${out}" == *'Claude Code 2.9.9'* && "${out}" != *$'\n'* ]]; then
    _pass "a newline in CLAUDE_CODE_EXECPATH is truncated to one line"
  else
    _fail "a newline in CLAUDE_CODE_EXECPATH was not truncated, got: ${out}"
  fi

  /bin/rm -rf "${stub_dir}"
}
