#!/bin/zsh
# dotfiles/tests/session-host-context
#
# Pins claude/hooks/session-host-context, the SessionStart hook that prints one line
# of host identity (hostname, macOS version+build, Claude Code version, clock,
# and a worktree note when the cwd is in a linked git worktree).
# Feeds SessionStart JSON on stdin and asserts stdout and exit code directly;
# the hook emits no hookSpecificOutput verdict, so _hook_verdict is not used.
#
# The hook calls scutil/sw_vers/readlink by absolute path, so PATH-prefix
# stubs (tests/git-sign) cannot intercept them; the suite uses the hook's
# SESSION_HOST_CONTEXT_SCUTIL/_SW_VERS/_READLINK/_DATE/_PAPERCUT/_REX_PLIST/
# _REX_CHECKED seams (as GH_PUBLISH_*, PII_HOOK_*). Every run points the
# optional probes at missing paths by default, so a papercut CLI, a Rex install
# or a clock on the host never changes the exact-line assertions.
#
# Cases: one full stubbed line with every segment in order (the Papercuts CLI
# runs in the payload cwd, a path with a space, inside a linked worktree); a
# resume payload under a stripped PATH prints nothing and never runs the
# Papercuts CLI; every probe failing with HOME and CLAUDE_CODE_EXECPATH unset
# still prints "Host: unknown" and exits 0; a newline in a probed value keeps
# the line single; a submodule .git file is not a worktree; zero open
# papercuts and an equal Rex build omit their segments; a release build gets
# no seed phrasing, a never-checked Rex build is named, and a
# hosts/<host>.md file in HOME is never read.
#
# Run: ./test session-host-context
# ShellCheck: lint with `shellcheck --shell=bash tests/session-host-context`.
# Sourced, not executed — chmod 644.
#
# shellcheck source=tests/lib

function _shc_run {
  # Run the hook with stdin $1; $2... are VAR=value, -u VAR or -C dir, applied
  # in order. Sets the caller's `out` (stdout) and `rc` (hook exit status).
  local payload="$1"
  shift
  rc=0
  # shellcheck disable=SC2034  # out is read by the caller
  out="$(
    typeset -x SESSION_HOST_CONTEXT_PAPERCUT=/nonexistent/papercut
    typeset -x SESSION_HOST_CONTEXT_DATE=/nonexistent/date
    typeset -x SESSION_HOST_CONTEXT_REX_PLIST=/nonexistent/Info.plist
    while (( $# > 0 )); do
      case "$1" in
        -u) unset "$2"; shift 2 ;;
        -C) cd "$2" || exit 99; shift 2 ;;
        *) typeset -x "${1%%=*}=${1#*=}"; shift ;;
      esac
    done
    printf '%s' "${payload}" | /bin/zsh "${SCRIPT_DIR}/claude/hooks/session-host-context"
  )" || rc=$?
}

function _shc_mkstub {
  # $1 = stub path, $2... = script lines (shebang added). Caller chmods.
  local f="$1" l
  shift
  { print -r -- '#!/bin/sh'; for l in "$@"; do print -r -- "${l}"; done; } > "${f}"
}

function _shc_mkdate {
  # $1 = stub path, $2 = output for +%Z, $3 = output for +%z. Caller chmods.
  # shellcheck disable=SC2016  # the stub body is a literal script: $1 must not expand here
  _shc_mkstub "$1" 'case "$1" in' "  +%Z) echo \"$2\" ;;" "  +%z) echo \"$3\" ;;" 'esac'
}

function run_session_host_context {
  _section "Session host context hook"

  # Hook absent (clean clone, claude/ not synced): skip, not a regression.
  if [[ ! -f "${SCRIPT_DIR}/claude/hooks/session-host-context" ]]; then
    _skip "claude/hooks/session-host-context absent — claude/ not yet synced to this machine"
    return 0
  fi

  local stub_dir out rc got
  stub_dir="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/session-host-context-test.XXXXXX")"
  local pc_rec="${stub_dir}/pc-cwd.txt" pc_dir="${stub_dir}/proj dir"
  mkdir -p "${pc_dir}"

  # Mixed-case hostname, so the lowercasing assertion has something to bite on.
  _shc_mkstub "${stub_dir}/scutil" 'echo "TestHost-Mixed"'
  _shc_mkstub "${stub_dir}/scutil-fail" 'exit 1'
  # A newline in a probed value must not make the one-line output two lines.
  _shc_mkstub "${stub_dir}/scutil-newline" 'echo "firstline"' 'echo "second line · macOS should not appear"'
  # sw_vers stubs mimic the real no-flag three-line form: pre-release
  # (letter-ending build), release (digit), failing.
  _shc_mkstub "${stub_dir}/sw_vers-seed" \
    'printf "ProductName:\t\tmacOS\nProductVersion:\t\t26.5\nBuildVersion:\t\t26A5378n\n"'
  _shc_mkstub "${stub_dir}/sw_vers-release" \
    'printf "ProductName:\t\tmacOS\nProductVersion:\t\t27.0\nBuildVersion:\t\t26A428\n"'
  _shc_mkstub "${stub_dir}/sw_vers-fail" 'exit 1'
  _shc_mkstub "${stub_dir}/readlink-fail" 'exit 1'
  # Stubbed `papercut count`.
  _shc_mkstub "${stub_dir}/pc-zero" 'echo "0 0 -"'
  _shc_mkstub "${stub_dir}/pc-record" "pwd -P > '${pc_rec}'" 'echo "3 1 2026-09-20"'
  _shc_mkdate "${stub_dir}/date-bst" BST +0100
  chmod 755 "${stub_dir}"/*(.)

  # Fixtures: a linked worktree (a path with a space), a submodule, Rex files.
  local wt_sub="${stub_dir}/wt-sub" rex_dir="${stub_dir}/rex"
  local wt_seg='Worktree: commit on this branch, rebase onto main if it moved, land with git merge --ff-only from the main checkout, never a PR (internals/worktrees.md)'
  mkdir -p "${wt_sub}" "${rex_dir}"
  print -r -- "gitdir: ${stub_dir}/repo/.git/worktrees/feature" > "${pc_dir}/.git"
  print -r -- "gitdir: ${stub_dir}/repo/.git/modules/sub" > "${wt_sub}/.git"
  print -r -- '<?xml version="1.0" encoding="UTF-8"?>' '<plist version="1.0"><dict>' \
    '<key>CFBundleShortVersionString</key>' '<string>1.2.3</string>' \
    '<key>CFBundleVersion</key>' '	<string>4242</string>' '</dict></plist>' > "${rex_dir}/Info.plist"
  print -r -- '4100' > "${rex_dir}/checked-old"
  printf '  4242  \n\n' > "${rex_dir}/checked-equal-space"
  local rex_p="${rex_dir}/Info.plist"

  # Clean base for the omit cases: the Host segment only, no other probe.
  local -a base=(-u TERM_PROGRAM -u TERM_PROGRAM_VERSION -u CLAUDE_CODE_EXECPATH
    "SESSION_HOST_CONTEXT_SCUTIL=${stub_dir}/scutil"
    "SESSION_HOST_CONTEXT_SW_VERS=${stub_dir}/sw_vers-fail"
    "SESSION_HOST_CONTEXT_READLINK=${stub_dir}/readlink-fail")
  local want

  # 1. Every segment, in order, one exact line. The Papercuts stub runs in
  # the payload cwd (a path with a space), which is a linked worktree.
  /bin/rm -f "${pc_rec}"
  _shc_run '{"source":"startup","cwd":"'"${pc_dir}"'"}' "${base[@]}" \
    "SESSION_HOST_CONTEXT_SW_VERS=${stub_dir}/sw_vers-seed" \
    'CLAUDE_CODE_EXECPATH=/x/versions/2.1.286' \
    TERM_PROGRAM=ghostty TERM_PROGRAM_VERSION=1.3.2-main+0081d4530 \
    "SESSION_HOST_CONTEXT_DATE=${stub_dir}/date-bst" \
    "SESSION_HOST_CONTEXT_PAPERCUT=${stub_dir}/pc-record" \
    "SESSION_HOST_CONTEXT_REX_PLIST=${rex_p}" "SESSION_HOST_CONTEXT_REX_CHECKED=${rex_dir}/checked-old"
  want="Host: testhost-mixed · macOS 26.5 (26A5378n, seed) · Claude Code 2.1.286 · Terminal: Ghostty 1.3.2-main · Clock: Europe/London, BST (UTC+01:00) · ${wt_seg} · Papercuts: 3 open (1 for this repo, oldest 2026-09-20) · Rex: build 4242 not ledger-checked (last 4100), run the rex-ledger-check skill"
  got=""
  [[ -f "${pc_rec}" ]] && got="$(<"${pc_rec}")"
  if [[ "${rc}" -eq 0 && "${out}" == "${want}" && "${got}" == "${pc_dir:A}" ]]; then
    _pass "full line: every segment in order, Papercuts CLI ran in the payload cwd"
  else
    _fail "full line: stub ran in '${got}', want '${pc_dir:A}'; rc=${rc}; out: ${out}"
  fi

  # 2. resume under a stripped PATH: silent, and the Papercuts CLI never runs.
  # The hook reads stdin with the `read` builtin; a bare `cat` would fail
  # here, leave `input` empty and double-inject.
  /bin/rm -f "${pc_rec}"
  _shc_run '{"source":"resume","cwd":"'"${pc_dir}"'"}' 'PATH=/nonexistent' \
    "SESSION_HOST_CONTEXT_PAPERCUT=${stub_dir}/pc-record"
  if [[ "${rc}" -eq 0 && -z "${out}" && ! -e "${pc_rec}" ]]; then
    _pass "resume under a stripped PATH: empty stdout, Papercuts CLI not run"
  else
    _fail "resume under a stripped PATH: rc=${rc}, got: ${out}"
  fi

  # 3. Every probe fails, HOME and CLAUDE_CODE_EXECPATH unset: fail open.
  _shc_run '{"source":"startup"}' "${base[@]}" -u HOME \
    "SESSION_HOST_CONTEXT_SCUTIL=${stub_dir}/scutil-fail"
  if [[ "${rc}" -eq 0 && "${out}" == 'Host: unknown' ]]; then
    _pass "every probe failing, HOME unset: exit 0, 'Host: unknown' only"
  else
    _fail "every probe failing: expected exit 0 and 'Host: unknown', got rc=${rc}: ${out}"
  fi

  # 4. A newline in a probed value must not make the output two lines. Not
  # reachable today; the hook strips at the first newline in each.
  _shc_run '{"source":"startup"}' "${base[@]}" \
    "SESSION_HOST_CONTEXT_SCUTIL=${stub_dir}/scutil-newline" \
    $'CLAUDE_CODE_EXECPATH=/x/versions/2.9.9\nevil/cli.js' $'TERM_PROGRAM=ghostty\nevil'
  if [[ "${rc}" -eq 0 && "${out}" == 'Host: firstline · Claude Code 2.9.9 · Terminal: Ghostty' ]]; then
    _pass "a newline in the scutil, EXECPATH and TERM_PROGRAM values is cut to one line"
  else
    _fail "a newline in a probed value was not cut to one line, got: ${out}"
  fi

  # 5. A submodule .git file (modules/, not worktrees/) is not a worktree.
  _shc_run '{"source":"startup","cwd":"'"${wt_sub}"'"}' "${base[@]}"
  if [[ "${rc}" -eq 0 && "${out}" == 'Host: testhost-mixed' ]]; then
    _pass "worktree: a submodule .git file adds no Worktree segment"
  else
    _fail "worktree: a submodule .git file should add no segment, got: ${out}"
  fi

  # 6. Zero open papercuts omit the segment.
  _shc_run '{"source":"startup"}' "${base[@]}" "SESSION_HOST_CONTEXT_PAPERCUT=${stub_dir}/pc-zero"
  if [[ "${rc}" -eq 0 && "${out}" == 'Host: testhost-mixed' ]]; then
    _pass "papercuts: total 0 omits the segment"
  else
    _fail "papercuts: total 0 should omit the segment, got: ${out}"
  fi

  # 7. A Rex build equal to the checked one (newline and spaces) omits the segment.
  _shc_run '{"source":"startup"}' "${base[@]}" \
    "SESSION_HOST_CONTEXT_REX_PLIST=${rex_p}" "SESSION_HOST_CONTEXT_REX_CHECKED=${rex_dir}/checked-equal-space"
  if [[ "${rc}" -eq 0 && "${out}" == 'Host: testhost-mixed' ]]; then
    _pass "rex: an equal checked build omits the segment"
  else
    _fail "rex: an equal checked build should omit the segment, got: ${out}"
  fi

  # 8. A release build gets no seed phrasing, a never-checked Rex build is
  # named, and a hosts/<host>.md file in HOME is never read (mechanism gone).
  local sandbox_home
  sandbox_home="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/session-host-context-home.XXXXXX")"
  mkdir -p "${sandbox_home}/.claude/hosts"
  echo "Injected host note — should never appear." > "${sandbox_home}/.claude/hosts/testhost-mixed.md"
  _shc_run '{"source":"startup"}' "${base[@]}" "HOME=${sandbox_home}" \
    "SESSION_HOST_CONTEXT_SW_VERS=${stub_dir}/sw_vers-release" \
    "SESSION_HOST_CONTEXT_REX_PLIST=${rex_p}" "SESSION_HOST_CONTEXT_REX_CHECKED=${rex_dir}/nonexistent"
  want='Host: testhost-mixed · macOS 27.0 (26A428) · Rex: build 4242 not ledger-checked (never checked), run the rex-ledger-check skill'
  if [[ "${rc}" -eq 0 && "${out}" == "${want}" ]]; then
    _pass "release build has no seed phrasing, Rex never-checked is named, hosts/<host>.md is not read"
  else
    _fail "release build, Rex never-checked, hosts file: expected '${want}', got: ${out}"
  fi
  /bin/rm -rf "${sandbox_home}"

  /bin/rm -rf "${stub_dir}"
}
