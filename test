#!/usr/bin/env zsh
# dotfiles/test
#
# Dispatcher for tests/<name> suites (extensionless, sourced — not executed),
# so pass/fail/skip counters aggregate into one summary.
#
# Usage:
#   ./test                       # all suites, in parallel
#   ./test -j N                  # N workers; -j 1 = serial, one shell
#   ./test --time                # ...and a per-suite wall-time table
#   ./test <suite>               # one suite
#   ./test --help                # lists suites
#
# Parallel by default since 2026-09-29: suites write only under $TMPDIR and
# read real $HOME read-only, so they are order-independent.
# Each worker is `./test <suite>` with DOTFILES_TEST_CHILD set: it sources
# tests/lib and its one suite and writes counters to a file, no summary. The
# parent replays child output in SUITES order, sums the counters into the one
# summary, and turns a child that died without reporting (a stray `exit`, a
# `set -e` abort) into a FAIL naming the suite and exit code.

set -euo pipefail

# $EPOCHREALTIME is 0 until this module is loaded.
zmodload zsh/datetime

# Only with a tty: over non-tty SSH TERM is unset, tput exits 2, and -e would
# abort before the first suite.
if [[ -t 1 && -n "${TERM:-}" ]]; then
  /usr/bin/tput sgr0
fi

# A non-login shell (ssh host 'cmd', launchd) has no Homebrew on PATH, so
# gh/jq/shellcheck read as "not installed" and their suites skip.
if [[ -d /opt/homebrew/bin && ":${PATH}:" != *:/opt/homebrew/bin:* ]]; then
  export PATH="/opt/homebrew/bin:${PATH}"
fi

readonly SCRIPT_DIR="${0:A:h}"
cd "${SCRIPT_DIR}"

# SC1091: the source path holds a variable; `source=` names the target for -x.
# shellcheck source=tests/lib disable=SC1091
source "${SCRIPT_DIR}/tests/lib"

readonly -a SUITES=(shellcheck test-helpers sha sidebar extensions plutil linkage completions okf agents-md agent-rules jump brew-upgrade-selected rm-redirect ssh-redirect git-sign gh-auth container-tmp container-sandbox md5-guard md5-write gh-publish hook-links pii-hook agent-reset bao-mcp-env papercut pii-tree message-policy statusline fetch-route muse-exec session-host-context lint-hook git-bypass tmp-guard scratch-sweep sudo-askpass pretool-dispatch)

# Per-clone suites: one name per line in .extra_test_suites (gitignored via
# .extra*), for private tools that must not be named in the tracked SUITES.
# A listed suite whose file is absent is SKIPPED under `./test`, but an
# explicit `./test <name>` still fails. SUITES stays fail-closed: a missing
# mandatory suite aborts the run. Malformed lines (not [a-z0-9-]) abort even
# under `./test`, so a typo cannot silently drop a suite.
typeset -a EXTRA_SUITES=()
function _load_extra_suites {
  local registry="${SCRIPT_DIR}/.extra_test_suites" line
  [[ -f "${registry}" ]] || return 0
  while IFS= read -r line || [[ -n "${line}" ]]; do
    [[ -z "${line}" || "${line}" == \#* ]] && continue
    if [[ ! "${line}" =~ ^[a-z0-9-]+$ ]]; then
      echo "[FAIL] .extra_test_suites: malformed suite name '${line}'"
      exit 1
    fi
    EXTRA_SUITES+=("${line}")
  done < "${registry}"
}
_load_extra_suites

# Per-suite wall seconds, filled by both full runs, printed by --time.
typeset -A SUITE_SECONDS=()
typeset -a SUITE_ORDER=()

function _usage {
  echo "Usage: ./test [-j N] [--time] [suite [arg]]"
  echo "Suites: ${SUITES[*]}"
  (( ${#EXTRA_SUITES[@]} )) && echo "Extra (per-clone): ${EXTRA_SUITES[*]}"
  echo "  -j N    workers for the full run (default 4; 1 = serial, one shell)"
  echo "  --time  print per-suite wall time after the full run"
}

function _run_suite {
  local suite="$1"
  shift
  # shellcheck source=/dev/null
  source "${SCRIPT_DIR}/tests/${suite}"
  "run_${suite//-/_}" "$@"
}

# Four workers, not hw.ncpu: the suites are bound by process-spawn latency,
# not CPU (2026-09-29: 200 spawns of /usr/bin/true took 1.2 s serially; eight
# such loops in parallel gained only 1.8x). Same day: serial 163 s, -j 2 120 s,
# -j 4 71 s, -j 10 129 s. Override with -j N or TEST_JOBS.
function _default_jobs {
  echo 4
}

# Serial full run (-j 1): every suite sourced into this shell.
function _run_all_serial {
  local s t0
  for s in "${SUITES[@]}"; do
    t0="${EPOCHREALTIME}"
    _run_suite "${s}"
    SUITE_SECONDS[${s}]="$(( EPOCHREALTIME - t0 ))"
    SUITE_ORDER+=("${s}")
  done
  for s in "${EXTRA_SUITES[@]}"; do
    if [[ -f "${SCRIPT_DIR}/tests/${s}" ]]; then
      t0="${EPOCHREALTIME}"
      _run_suite "${s}"
      SUITE_SECONDS[${s}]="$(( EPOCHREALTIME - t0 ))"
      SUITE_ORDER+=("${s}")
    else
      _section "${s}"
      _skip "${s}: listed in .extra_test_suites but tests/${s} is absent on this clone"
    fi
  done
}

# Parallel full run: one child per suite via xargs -P. Output goes to
# <work>/<suite>.out, exit code to .rc, counters to .counts. An absent extra
# suite is skipped inline at its position, where the serial run reports it.
function _run_all_parallel {
  local jobs="$1" work s rc p f k secs
  local -a runnable=()
  work="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-test.XXXXXX")"
  # EXIT covers normal return (a trap set in a function fires when it returns);
  # INT/TERM cover Ctrl-C in the poll loop, else the work dir stays in $TMPDIR.
  # shellcheck disable=SC2064  # expand now: the path never changes
  trap "/bin/rm -rf '${work}'" EXIT
  # shellcheck disable=SC2064  # expand now: the path never changes
  trap "/bin/rm -rf '${work}'; exit 130" INT TERM
  for s in "${SUITES[@]}"; do runnable+=("${s}"); done
  for s in "${EXTRA_SUITES[@]}"; do
    [[ -f "${SCRIPT_DIR}/tests/${s}" ]] && runnable+=("${s}")
  done

  # -I{} runs one child per line; passing work dir and script path as argv
  # keeps the child command free of quoting. stderr joins .out too.
  # shellcheck disable=SC2016  # the child shell expands $1..$3, not this one
  printf '%s\n' "${runnable[@]}" \
    | /usr/bin/xargs -P "${jobs}" -I{} /bin/zsh -c \
        'DOTFILES_TEST_CHILD="$1" "$2" "$3" > "$1/$3.out" 2>&1; echo $? > "$1/$3.rc"' \
        _ "${work}" "${SCRIPT_DIR}/test" {} &
  local xargs_pid=$!

  for s in "${SUITES[@]}" "${EXTRA_SUITES[@]}"; do
    if (( ${runnable[(Ie)${s}]} == 0 )); then
      _section "${s}"
      _skip "${s}: listed in .extra_test_suites but tests/${s} is absent on this clone"
      continue
    fi
    until [[ -f "${work}/${s}.rc" ]]; do
      if ! kill -0 "${xargs_pid}" 2>/dev/null && [[ ! -f "${work}/${s}.rc" ]]; then
        break
      fi
      sleep 0.1
    done
    [[ -f "${work}/${s}.out" ]] && cat "${work}/${s}.out"
    rc="$(cat "${work}/${s}.rc" 2>/dev/null || echo none)"
    if [[ -f "${work}/${s}.counts" ]]; then
      read -r p f k secs < "${work}/${s}.counts"
      # `: $(( ))`, not `(( ))`: a zero result would read as failure under -e.
      : $(( pass_count += p, fail_count += f, skip_count += k ))
      SUITE_SECONDS[${s}]="${secs}"
      SUITE_ORDER+=("${s}")
    else
      _fail "${s}: suite aborted (exit ${rc}) before reporting its counters"
    fi
  done
  wait "${xargs_pid}" || true
}

function _print_times {
  local s
  echo ""
  echo "${BOLD}── Suite times ──${RESET}"
  for s in "${SUITE_ORDER[@]}"; do
    printf '%7.1fs  %s\n' "${SUITE_SECONDS[${s}]}" "${s}"
  done | /usr/bin/sort -rn
}

# Child mode: run the one suite, hand the counters back through a file.
function _child_main {
  local suite="$1" t0="${EPOCHREALTIME}"
  _run_suite "${suite}"
  printf '%d %d %d %.1f\n' "${pass_count}" "${fail_count}" "${skip_count}" \
    "$(( EPOCHREALTIME - t0 ))" > "${DOTFILES_TEST_CHILD}/${suite}.counts"
  return $(( fail_count > 0 ))
}

function main {
  local jobs="${TEST_JOBS:-}" show_time=0
  while (( $# )); do
    case "$1" in
      -j)  jobs="${2:-}"; shift 2 ;;
      -j*) jobs="${1#-j}"; shift ;;
      --time) show_time=1; shift ;;
      -h|--help)
        _usage
        exit 0
        ;;
      --) shift; break ;;
      -*)
        echo "[FAIL] Unknown option: $1"
        _usage
        exit 1
        ;;
      *) break ;;
    esac
  done
  if [[ -n "${jobs}" && ! "${jobs}" =~ ^[1-9][0-9]*$ ]]; then
    echo "[FAIL] -j needs a positive integer, got '${jobs}'"
    exit 1
  fi
  [[ -z "${jobs}" ]] && jobs="$(_default_jobs)"

  local filter="${1:-all}"
  local t_start="${EPOCHREALTIME}" mode

  case "${filter}" in
    all)
      # Print first: the parallel parent is silent until the first suite in
      # SUITES order finishes, which reads as a hang. Children never get here.
      mode="${jobs} workers"; (( jobs == 1 )) && mode="serial"
      echo "./test started $(strftime '%Y-%m-%d %H:%M:%S' "${EPOCHSECONDS}") (${mode})"
      if (( jobs == 1 )); then
        _run_all_serial
      else
        _run_all_parallel "${jobs}"
      fi
      ;;
    *)
      # (Ie): 1-based index of an exact match, 0 if missing.
      if (( ${SUITES[(Ie)${filter}]} == 0 && ${EXTRA_SUITES[(Ie)${filter}]} == 0 )); then
        echo "[FAIL] Unknown suite: ${filter}"
        _usage
        exit 1
      fi
      if [[ ! -f "${SCRIPT_DIR}/tests/${filter}" ]]; then
        echo "[FAIL] Suite ${filter} is registered but tests/${filter} is absent"
        exit 1
      fi
      shift
      if [[ -n "${DOTFILES_TEST_CHILD:-}" ]]; then
        _child_main "${filter}"
        return
      fi
      _run_suite "${filter}" "$@"
      ;;
  esac

  if (( show_time )); then
    _print_times
    printf '%7.1fs  wall (%d workers)\n' "$(( EPOCHREALTIME - t_start ))" "${jobs}"
  fi
  _print_summary
}

main "$@"
