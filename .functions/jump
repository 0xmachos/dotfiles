#!/usr/bin/env zsh
# dotfiles/.functions/jump

function jump {
  # jump
  #   Update macOS, Homebrew, LaTeX packages & XProtect
  #   Run XProtect scan

  local -r SUDO_BINARY="/usr/bin/sudo"
  local -r SWUPDATE_BINARY="/usr/sbin/softwareupdate"
  local -r BREW_BINARY="/opt/homebrew/bin/brew"
  local -r TLMGR_BINARY="/Library/TeX/texbin/tlmgr"
  local -r XPROTECT_BINARY="/usr/bin/xprotect"
  local -r XPROTECT_APP="/Library/Apple/System/Library/CoreServices/XProtect.app/Contents/MacOS/XProtect"
  local -r CLAUDE_BINARY="${HOME}/.local/bin/claude"
  local -r MUSE_BINARY="${HOME}/.local/bin/muse"

  # Accumulate failures across the update steps so `jump` exits non-zero when any
  # step failed (honest status for `jump && …`). Advisory checks (brew doctor,
  # the IIO reminder) and skipped-because-absent binaries do NOT set this.
  local rc=0


  ## macOS ##
  if ! [[ -x "${SWUPDATE_BINARY}" ]]; then
    echo "Cannot execute /usr/sbin/softwareupdate"
    return 1
  fi

  echo "[🍎] Updating macOS..."
  # Apple Silicon requires volume owner auth, not sudo
  # https://support.apple.com/guide/deployment/dep24dbdcf9e/web
  "${SWUPDATE_BINARY}" --install --all --include-config-data || rc=1


  ## Homebrew ##
  if [[ -x "${BREW_BINARY}" ]]; then
    echo "[🍺] Updating Homebrew..."
    if "${BREW_BINARY}" update; then
      # HOMEBREW_NO_ASK disables Homebrew 6.0's default "ask" mode, which
      # prompts before upgrading dependents when run in an interactive TTY.
      # jump runs unattended, so suppress it. (launchd jump-user has no TTY
      # and is already unaffected.)
      HOMEBREW_NO_ASK=1 "${BREW_BINARY}" upgrade || rc=1
      "${BREW_BINARY}" cleanup || rc=1
      "${BREW_BINARY}" autoremove || rc=1
      "${BREW_BINARY}" doctor   # advisory — non-zero on benign warnings
    else
      echo "[❌] Failed to update Homebrew"
      rc=1
    fi
  fi



  ## Claude Code ##
  # Native installer (not Homebrew): symlink at ~/.local/bin/claude into
  # ~/.local/share/claude/versions/. User-writable — no sudo.
  if [[ -x "${CLAUDE_BINARY}" ]]; then
    echo "[🤖] Updating Claude Code..."
    "${CLAUDE_BINARY}" update || rc=1
  fi


  ## Muse Code ##
  # Meta's own installer, not Homebrew: ~/.local/bin/muse is a bash launcher
  # that downloads and SHA-256-verifies muse-bin-<version> beside itself.
  # User-writable — no sudo.
  #
  # There is no `muse update` subcommand. MUSE_LAUNCHER_INSTALL=1 is the
  # launcher's own install-and-exit path: it updates the binary and exits 0
  # without starting the TUI. It refreshes the BINARY only — the launcher
  # script updates itself on a normal interactive `muse` launch, at most
  # hourly.
  #
  # MUSE_LOGIN=0 blocks the device sign-in flow, which would otherwise stall
  # this function on a Meta URL and a user code with a 15-minute deadline.
  # The launcher reads a bearer token only from ~/.config/muse/auth.json, and
  # this Mac's file carries metadata alone (storage: keychain, no access_token
  # key — checked 2026-09-04), so downloads go out unauthenticated and
  # device_login is the launcher's fallback if the download host ever denies
  # them. Sign-in stays `muse`'s own job.
  #
  # In a terminal the launcher prints and clears any pending
  # .muse-update-notice, so an upgrade shows as "Muse Code updated X -> Y".
  #
  # Verified against launcher_version=2 (Muse Code 1.0.2-R2040.1), 2026-09-04.
  if [[ -x "${MUSE_BINARY}" ]]; then
    echo "[🎨] Updating Muse Code..."
    MUSE_LAUNCHER_INSTALL=1 MUSE_LOGIN=0 "${MUSE_BINARY}" || rc=1
  fi


  ## LaTeX ##
  # GPG repo verification disabled: gnupg not installed, SHA-512 checksums
  # and HTTPS transport still protect package integrity. See TODOs.md.
  if [[ -x "${TLMGR_BINARY}" ]]; then
    "${SUDO_BINARY}" --prompt="[⚠️ ] Password required to run tlmgr: " -v
    echo "[📝] Updating LaTeX..."
    "${SUDO_BINARY}" "${TLMGR_BINARY}" --verify-repo=none update --self || rc=1
    "${SUDO_BINARY}" "${TLMGR_BINARY}" --verify-repo=none update --all || rc=1
  fi


  ## Local extras (gitignored, sourced if present) ##
  # Per-host updaters or one-offs that aren't part of the canonical update
  # set live in dotfiles/.extra/jump. The whole .extra/ directory is matched
  # by .gitignore's .extra* rule, so anything inside it stays local. The
  # sourced file runs inside this function's scope and may use ${SUDO_BINARY}.
  local -r EXTRA_JUMP="${HOME}/Documents/Projects/dotfiles/.extra/jump"
  if [[ -r "${EXTRA_JUMP}" ]]; then
    # shellcheck disable=SC1090
    source "${EXTRA_JUMP}"
  fi


  ## XProtect ##
  if [[ -x "${XPROTECT_BINARY}" ]]; then
    echo "[🛡️] Updating XProtect..."
    "${SUDO_BINARY}" --prompt="[⚠️ ] Password required to update XProtect: " -v
    "${SUDO_BINARY}" "${XPROTECT_BINARY}" update --prerelease || rc=1
  fi

  if [[ -x "${XPROTECT_APP}" ]]; then
    echo "[🔍] Running XProtect scan in the background..."
    "${XPROTECT_APP}" &
  fi


  ## ImageIO OOP ##
  if [[ "$(launchctl getenv IIOEnableOOP)" != "1" ]]; then
    echo "[❌] IIOEnableOOP not set in launchd — GUI apps parsing images in-process"
    echo "    Run: launchctl setenv IIOEnableOOP 1"
    echo "    Or:  bittersweet launchagents"
  fi

  return "${rc}"
}
