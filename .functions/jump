#!/usr/bin/env zsh
# dotfiles/.functions/jump

function jump {
  # jump
  #   Update macOS, Homebrew, LaTeX packages & XProtect
  #   Run XProtect scan

  local -r SUDO_BINARY="/usr/bin/sudo"
  local -r SWUPDATE_BINARY="/usr/sbin/softwareupdate"
  local -r BREW_BINARY="/opt/homebrew/bin/brew"
  local -r TLMGR_BINARY="/Library/TeX/texbin/tlmgr"
  local -r XPROTECT_BINARY="/usr/bin/xprotect"
  local -r XPROTECT_APP="/Library/Apple/System/Library/CoreServices/XProtect.app/Contents/MacOS/XProtect"
  local -r CLAUDE_BINARY="${HOME}/.local/bin/claude"
  local -r MUSE_BINARY="${HOME}/.local/bin/muse"

  # rc accumulates step failures so `jump && …` gets an honest status. Advisory
  # checks (brew doctor, the IIO reminder) and absent binaries do not set it.
  local rc=0


  ## macOS ##
  if ! [[ -x "${SWUPDATE_BINARY}" ]]; then
    echo "Cannot execute /usr/sbin/softwareupdate"
    return 1
  fi

  echo "[🍎] Updating macOS..."
  # Apple Silicon requires volume owner auth, not sudo
  # https://support.apple.com/guide/deployment/dep24dbdcf9e/web
  "${SWUPDATE_BINARY}" --install --all --include-config-data || rc=1


  ## Homebrew ##
  if [[ -x "${BREW_BINARY}" ]]; then
    echo "[🍺] Updating Homebrew..."
    if "${BREW_BINARY}" update; then
      # HOMEBREW_NO_ASK: Homebrew 6.0's default "ask" mode prompts before
      # upgrading dependents on an interactive TTY; suppressed because jump
      # runs unattended. launchd jump-user has no TTY and is unaffected.
      # brew_upgrade_selected: a bare `brew upgrade`, unless the gitignored
      # .extra/jump-pre holds casks back (see .functions/brew_upgrade_selected).
      HOMEBREW_NO_ASK=1 brew_upgrade_selected "${BREW_BINARY}" || rc=1
      "${BREW_BINARY}" cleanup || rc=1
      "${BREW_BINARY}" autoremove || rc=1
      "${BREW_BINARY}" doctor   # advisory — non-zero on benign warnings
    else
      echo "[❌] Failed to update Homebrew"
      rc=1
    fi
  fi



  ## Claude Code ##
  # Native installer, not Homebrew: ~/.local/bin/claude symlinks into
  # ~/.local/share/claude/versions/. User-writable, no sudo.
  if [[ -x "${CLAUDE_BINARY}" ]]; then
    echo "[🤖] Updating Claude Code..."
    "${CLAUDE_BINARY}" update || rc=1
  fi


  ## Muse Code ##
  # Meta's own installer, not Homebrew: ~/.local/bin/muse is a bash launcher
  # that downloads and SHA-256-verifies muse-bin-<version> beside itself.
  # User-writable, no sudo.
  # No `muse update` subcommand: MUSE_LAUNCHER_INSTALL=1 is the launcher's
  # install-and-exit path (updates the binary, exits 0, no TUI). The launcher
  # script itself updates on a normal interactive launch, at most hourly.
  # MUSE_LOGIN=0 blocks the device sign-in flow (a Meta URL and user code,
  # 15-minute deadline). The launcher reads a bearer token only from
  # ~/.config/muse/auth.json, which holds metadata alone (storage: keychain,
  # no access_token key; checked 2026-09-04), so downloads go out
  # unauthenticated and device_login is the fallback if the host denies them.
  # Sign-in stays `muse`'s own job.
  # Herdr labels a pane by the foreground process: a shell whose first
  # non-flag argument is named `muse` reads as a Muse session. So the launcher
  # is sourced by a `bash -c` shell, where Herdr stops at `-c` and sees no
  # agent. Keep the launcher path out of the script slot of argv: never
  # `bash "${MUSE_BINARY}"`. The path is shifted off so the launcher sees no
  # arguments, as in a direct run. Sourcing needs the install path to use no
  # `$0`, no `$@`, and no top-level `local` or `return`: it reads only
  # BASH_SOURCE[0], which is the same when sourced.
  # In a terminal the launcher prints and clears any pending
  # .muse-update-notice ("Muse Code updated X -> Y").
  # Verified against launcher_version=3, 2026-10-19.
  if [[ -x "${MUSE_BINARY}" ]]; then
    echo "[🎨] Updating Muse Code..."
    # shellcheck disable=SC2016 # "$launcher" belongs to the inner bash
    MUSE_LAUNCHER_INSTALL=1 MUSE_LOGIN=0 /usr/bin/env bash -c 'launcher=$1; shift; . "$launcher"' jump-launcher "${MUSE_BINARY}" || rc=1
  fi


  ## LaTeX ##
  # GPG repo verification disabled: gnupg not installed, SHA-512 checksums
  # and HTTPS transport still protect package integrity.
  if [[ -x "${TLMGR_BINARY}" ]]; then
    "${SUDO_BINARY}" --prompt="[⚠️ ] Password required to run tlmgr: " -v
    echo "[📝] Updating LaTeX..."
    "${SUDO_BINARY}" "${TLMGR_BINARY}" --verify-repo=none update --self || rc=1
    "${SUDO_BINARY}" "${TLMGR_BINARY}" --verify-repo=none update --all || rc=1
  fi


  ## Local extras (gitignored, sourced if present) ##
  # Per-host updaters live in dotfiles/.extra/jump (gitignored by the .extra*
  # rule). Sourced inside this function's scope; may use ${SUDO_BINARY}.
  # A step that must tell a busy lock (exit 75) from a failure runs through
  # `jump_step <description> <command...> || rc=1` (see .functions/jump_step):
  # 75 is a logged skip, any other non-zero is [FAIL].
  local -r EXTRA_JUMP="${HOME}/dotfiles/.extra/jump"
  if [[ -r "${EXTRA_JUMP}" ]]; then
    # shellcheck disable=SC1090
    source "${EXTRA_JUMP}"
  fi


  ## XProtect ##
  if [[ -x "${XPROTECT_BINARY}" ]]; then
    echo "[🛡️] Updating XProtect..."
    "${SUDO_BINARY}" --prompt="[⚠️ ] Password required to update XProtect: " -v
    "${SUDO_BINARY}" "${XPROTECT_BINARY}" update --prerelease || rc=1
  fi

  if [[ -x "${XPROTECT_APP}" ]]; then
    echo "[🔍] Running XProtect scan in the background..."
    "${XPROTECT_APP}" &
  fi


  ## ImageIO OOP ##
  # Read the gui domain, not `launchctl getenv`: getenv asks the caller's own
  # domain, which is Background in an SSH-started shell (for example a pane
  # of a terminal multiplexer started over SSH), so it reads empty while the
  # GUI apps have the value.
  local gui_env
  gui_env="$(launchctl print "gui/${UID}" 2>/dev/null)" || gui_env=""
  if [[ -z "${gui_env}" ]]; then
    echo "[⚠️ ] No GUI login session: cannot check IIOEnableOOP"
  elif ! grep -Eq '^[[:space:]]+IIOEnableOOP => 1$' <<< "${gui_env}"; then
    echo "[❌] IIOEnableOOP not set in launchd — GUI apps parsing images in-process"
    echo "    Run: launchctl kickstart gui/${UID}/com.0xmachos.imageio-oop"
    echo "    Or:  bittersweet launchagents"
  fi

  return "${rc}"
}
