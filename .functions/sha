#!/usr/bin/env zsh
# dotfiles/.functions/sha

function sha {
  local target="${1:?sha requires a path to a file or .app bundle}"
  local executable output digest

  if [[ "${target%/}" == *.app ]]; then
    target="${target%/}"
    # An app's executable can differ from its display name, including dots.
    executable=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' \
      "${target}/Contents/Info.plist") || return
    if [[ -z "${executable}" || "${executable}" == */* || "${executable}" == . || "${executable}" == .. ]]; then
      print -u2 -- "sha: invalid CFBundleExecutable in ${target}/Contents/Info.plist"
      return 1
    fi
    target="${target}/Contents/MacOS/${executable}"
  fi

  output=$(/usr/bin/shasum -a 256 -- "${target}") || return
  print -r -- "${output}"
  digest="${output%% *}"
  print -r -- "${digest}" | pbcopy
}
