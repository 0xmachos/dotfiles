#!/usr/bin/env zsh
# dotfiles/.functions/muse
#
# Launch Meta's Muse Code the way Claude Code runs here: no approval prompts
# and no OS sandbox ("auto mode"). Muse has no settings key for either, and
# its own binary strings say the bypass flags are fixed at launch, so
# persistence has to be a launcher wrapper (the same shape as the retired
# codex alias). Verified against Muse Code 1.0.2 help text, 2026-09-03.
#
#   muse                     # interactive TUI, prompts off, sandbox off
#   muse "fix the tests"     # same, with an opening prompt
#   muse resume --last       # same: resume reopens the interactive TUI
#   muse exec ...            # untouched: headless runs pick their own
#   muse skills list         #   posture (--disable-approval / --yolo)
#   MUSE_AUTO_SKIP=1 muse    # escape hatch: stock defaults for one launch
#
# Flags added for an interactive launch:
#   --approval-mode never   nothing stops for approval
#   --disable-sandbox       no Seatbelt; file tools may write anywhere and
#                           the network is full egress (it overrides
#                           --sandbox-network)
# Deliberately NOT --yolo: that also trusts the workspace for the run, so a
# fork/PR checkout's AGENTS.md, rules and skills would load unreviewed.
# Trust stays a one-time per-workspace answer (~/.config/muse/trust.json).
#
# Routing: any known subcommand anywhere in argv passes through unchanged;
# everything else is an interactive launch. The subcommand list is from
# `muse --help` plus the flag-gated `plugins`; extend it when Muse grows one.
# `resume` is deliberately NOT in that list: it reopens the TUI, so it needs
# the same posture as a fresh launch, and root options parse on either side
# of the subcommand (verified against `muse resume --help`, 2026-09-03).
#
# Caveats (2026-09-03): Muse runs its shell tool with a cleared environment,
# so the rm→trash alias does not apply inside a session — deletions are
# real. The Claude Code guard hooks are not ported yet. The combined launch
# was not exercised by the author's own harness (its classifier refused to
# run muse with the sandbox off); flag semantics are from the help text
# and dev.meta.ai/docs/muse-code/permissions.
#
# Headless runs (2026-09-25, Muse 1.3.0-R3401.1): `exec` gets
# MUSE_EXPERIMENTAL_VERIFY_REMINDER=0 unless the caller set it. The built-in
# verify-reminder is a second model pass after the answer, and exec holds
# stdout until it finishes, so a caller's timeout can kill a run that had
# already answered. Interactive launches keep the reminder. Verified by
# session log: with the variable at 0 no verify-reminder child starts and
# the end-of-turn gate is gone.

function muse {
  local arg
  if [[ "${MUSE_AUTO_SKIP:-0}" == 1 ]]; then
    command muse "$@"
    return
  fi
  for arg in "$@"; do
    case "${arg}" in
      exec)
        MUSE_EXPERIMENTAL_VERIFY_REMINDER="${MUSE_EXPERIMENTAL_VERIFY_REMINDER:-0}" \
          command muse "$@"
        return
        ;;
      config|export|trace|skills|sandbox|schema|serve|session-message|auth|login|logout|init|plugins)
        command muse "$@"
        return
        ;;
    esac
  done
  command muse --approval-mode never --disable-sandbox "$@"
}
