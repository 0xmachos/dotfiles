#!/usr/bin/env zsh
# dotfiles/.functions/muse
#
# Launches Muse Code under the built-in `:auto-review` permission profile
# (since 2026-10-13, Muse Code 1.4.6; before that `--approval-mode never
# --disable-sandbox`). The profile keeps the Seatbelt sandbox on: the whole
# disk is readable, writes go only to the workspace and temp directories,
# `.git`/`.muse`/`.agents` stay read-only, and local commands reach the
# network through the proxy. Approval is on request, and an AI reviewer
# decides eligible actions before a human is asked.
#
#   muse, muse "prompt", muse resume --last   # interactive: profile added
#   muse exec ..., muse skills list           # known subcommand: untouched
#                                             # (headless picks its own posture:
#                                             # --disable-approval / --yolo)
#   muse --permission-profile :ask-me         # own posture flag: untouched
#   MUSE_AUTO_SKIP=1 muse                     # escape hatch: stock defaults
#
# A posture flag in argv (--permission-profile, --approval-mode,
# --disable-approval, --disable-sandbox, --yolo) skips the added profile:
# Muse refuses --permission-profile with --approval-mode, and rejects a
# repeated --permission-profile. --disable-sandbox leaves any profile
# recorded but not enforced.
# Not --yolo: it also trusts the workspace, so a fork/PR checkout's AGENTS.md,
# rules and skills would load unreviewed. Trust stays a one-time per-workspace
# answer (~/.config/muse/trust.json).
#
# Routing: a known subcommand anywhere in argv passes through; anything else is
# interactive. List = `muse --help` plus the flag-gated `plugins`; extend it
# when Muse grows one. `resume` is deliberately absent: it reopens the TUI, and
# root options parse either side of the subcommand (`muse resume --help`,
# 2026-09-03).
#
# Caveats (2026-09-03): Muse's shell tool runs with a cleared environment, so
# the rm->trash alias does not apply and deletions are real. No guard hooks
# are ported. The combined launch was never exercised; flag semantics are from
# the help text and dev.meta.ai/docs/muse-code/permissions.
#
# Headless (2026-09-25, Muse 1.3.0-R3401.1): `exec` gets
# MUSE_EXPERIMENTAL_VERIFY_REMINDER=0 unless the caller set it. The reminder is
# a second model pass after the answer and exec holds stdout until it ends, so
# a caller's timeout can kill a run that already answered. Interactive keeps
# it. Session log confirms: at 0 no verify-reminder child starts and the
# end-of-turn gate is gone.

function muse {
  local arg
  if [[ "${MUSE_AUTO_SKIP:-0}" == 1 ]]; then
    command muse "$@"
    return
  fi
  for arg in "$@"; do
    case "${arg}" in
      exec)
        MUSE_EXPERIMENTAL_VERIFY_REMINDER="${MUSE_EXPERIMENTAL_VERIFY_REMINDER:-0}" \
          command muse "$@"
        return
        ;;
      config|export|trace|model-profile|skills|voice|sandbox|schema|serve|session-message|mcp|auth|login|logout|init|plugins)
        command muse "$@"
        return
        ;;
    esac
  done
  for arg in "$@"; do
    case "${arg}" in
      --permission-profile|--permission-profile=*|--approval-mode|--approval-mode=*|--disable-approval|--disable-sandbox|--yolo)
        command muse "$@"
        return
        ;;
    esac
  done
  command muse --permission-profile :auto-review "$@"
}
