#!/bin/zsh
# dotfiles/bin/urlscan
# Wrapper for urlscan-cli. bao-mcp-env reads kv/mcp/urlscan (field
# URLSCAN_API_KEY) through this Mac's Claude AppRole and exports it; no
# 1Password, no Touch ID. The key never enters argv.

set -euo pipefail

exec /usr/local/bin/bao-mcp-env mcp/urlscan /opt/homebrew/bin/urlscan "$@"
