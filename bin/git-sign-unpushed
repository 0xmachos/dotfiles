#!/bin/zsh
# git-sign-unpushed — re-sign the current branch's unpushed commits.
#
# Counterpart to claude/git-sign-hook: commits made while the screen was
# locked are unsigned; run this inside the repo, screen unlocked, worktree
# clean. Re-signing is a rewrite: every re-signed commit gets a new SHA. Only
# the UNPUSHED range is touched, so claude/git-sign-hook's push gate holds
# pushes until this has run and no force-push is ever needed.
#
# Taps: Secretive prompts per signature (three signs = three taps, 2026-08-06).
# "Stay unlocked" on the FIRST prompt collapses the batch to one tap, but that
# window signs silently for any process until it expires: opt in each time,
# keep it short.
#
# Cost: a rewrite invalidates every descendant and a rebase replay re-signs
# each replayed commit (commit.gpgsign is honoured without -S, measured
# 2026-08-08). One tap for the deepest unsigned commit plus one per commit
# above it, signed or not; commits below it keep their SHAs. An unsigned
# commit at the base of a 5-commit range = 5 taps; alone at the tip = 1.
#
# Committer dates: a bare `--amend` stamps "now" (GitHub shows the committer
# date) and the rebase replay re-stamps commits 2..N before --exec runs, so
# both are needed: --committer-date-is-author-date pins the replay, the
# GIT_COMMITTER_DATE wrapper (reads %cI of the replayed commit) pins the amend.
# Author == committer keeps timestamps exactly.
# LIMITATION: author dates always survive, but on the REBASE path a committer
# date that differed from its author date is NORMALISED to the author date
# (the flag overwrites it before the wrapper reads it). Only the amend fast
# path preserves it. Deliberate: git's idiom for stable dates through a
# replay. tests/git-sign fixtures set author != committer to pin this.

set -euo pipefail
IFS=$'\n\t'

function die {
  print -u2 "[❌] $1"
  exit 1
}

# Shared with pre-push: one framed cat-file batch, header-only signature
# presence checks, nonzero on any unreadable object. :A so a deployed symlink
# still finds its checkout's helper.
SIGNATURE_SCAN="${0:A:h:h}/.config/git/hooks/commit-signatures"

# True when $1 is reachable from a remote-tracking ref. Walk status is captured
# separately: an unreadable range must never permit a rewrite.
function _is_published {
  local unpublished
  unpublished="$(git rev-list -1 "$1" --not --remotes 2>/dev/null)" \
    || die "cannot determine whether $1 is already published"
  [[ -z "${unpublished}" ]]
}

# Candidates ALWAYS come from `HEAD --not --remotes`, never from
# `merge-base(HEAD, @{upstream})..HEAD`: that form excludes only the upstream's
# history, so a commit published on a SECOND remote was rewritten (2026-08-08:
# origin/main at A, unsigned B pushed to backup/topic, unsigned C local; the
# rebase started at A and rewrote B). A published commit has all its ancestors
# published, so nothing above an unpublished commit can be published.
typeset -ga RANGE=(HEAD --not --remotes)

# Fast path: HEAD is the only unsigned commit, so amend in place. The rebase's
# failure modes (stopped rebase, detached state) are the expensive part.
function _amend_head {
  _is_published HEAD && die "HEAD is already published on a remote — refusing to amend it"
  GIT_COMMITTER_DATE="$(git show -s --format=%cI HEAD)" \
    git commit --amend --no-edit -n -S \
    || die "amend failed to sign — is the machine unlocked? (Secretive refuses while locked)"
  local unsigned head_sha
  head_sha="$(git rev-parse HEAD)" || die "cannot read HEAD after amend"
  unsigned="$("${SIGNATURE_SCAN}" <<< "${head_sha}")" || die "cannot inspect HEAD after amend"
  if [[ -n "${unsigned}" ]]; then
    die "HEAD still unsigned after amend — inspect: git log -1 --format='%h %G? %s'"
  fi
  echo "[✅] Re-signed:"
  git log --no-walk --format='  %h %s' HEAD
}

function _resign_by_rebase {
  local -a ulist=("$@")

  # Rebase from the parent of the DEEPEST UNSIGNED commit, not the pushed base:
  # commits below it are signed already. With NO remote every commit counts as
  # unpushed (2026-08-08: two unsigned at the tip of 12 rebased from --root
  # re-signed all 12, 10 wasted taps). rev-list is newest-first: last = deepest.
  local deepest_unsigned rebase_base
  deepest_unsigned="${ulist[-1]}"
  if git rev-parse -q --verify "${deepest_unsigned}^" >/dev/null 2>&1; then
    rebase_base="$(git rev-parse "${deepest_unsigned}^")"
  else
    rebase_base="--root"
  fi

  local -a rebase_range
  if [[ "${rebase_base}" == "--root" ]]; then
    rebase_range=(HEAD)
  else
    rebase_range=("${rebase_base}..HEAD")
  fi

  # A plain rebase linearises merges (and signing during merge replay has had
  # bugs): refuse. Scoped to the replayed commits; a merge below the deepest
  # unsigned commit must not block.
  local merges
  merges="$(git rev-list --merges "${rebase_range[@]}")" || die "cannot inspect replay range"
  if [[ -n "${merges}" ]]; then
    die "merge commits in the replay range — re-sign manually with --rebase-merges"
  fi

  # A second rebase would detach HEAD under whoever owns the first.
  local gitdir
  gitdir="$(git rev-parse --git-dir)"
  if [[ -d "${gitdir}/rebase-merge" || -d "${gitdir}/rebase-apply" ]]; then
    die "a rebase is already in progress — finish it (git rebase --continue) or abort it first"
  fi

  # Publication check for the whole replay range in two walks; both must
  # succeed before any history is rewritten.
  local replay unpublished s
  local -a replay_commits
  local -A unpublished_set=()
  # shellcheck disable=SC2034  # used by zsh newline split below
  replay="$(git rev-list "${rebase_range[@]}")" || die "cannot read replay range"
  unpublished="$(git rev-list "${rebase_range[@]}" --not --remotes)" \
    || die "cannot check replay publication status"
  # shellcheck disable=SC2296
  replay_commits=("${(@f)replay}")
  # shellcheck disable=SC2296,SC2066  # zsh explicitly splits on newlines
  for s in "${(@f)unpublished}"; do
    [[ -z "${s}" ]] || unpublished_set[${s}]=1
  done
  for s in "${replay_commits[@]}"; do
    [[ -n "${unpublished_set[${s}]:-}" ]] \
      || die "refusing to rewrite ${s} — already reachable from a remote-tracking ref"
  done

  echo "[ℹ️ ] Replaying ${#replay_commits} commit(s) — expect one Touch ID tap each."

  # The exec skips commits that still carry a signature (untouched ancestry
  # fast-forwards and keeps its SHA; ECDSA is randomised, so a needless re-sign
  # would churn it). A commit invalidated by an earlier rewrite replays WITHOUT
  # its old signature, so the presence test still catches it.
  # shellcheck disable=SC2016  # deliberate: $(…) must expand per replayed commit inside rebase's shell, not here
  local -a rebase_args=(
    --committer-date-is-author-date
    --exec 'git cat-file commit HEAD | awk "/^\$/{exit} /^gpgsig /{f=1} END{exit !f}" || GIT_COMMITTER_DATE="$(git show -s --format=%cI HEAD)" git commit --amend --no-edit -n -S'
  )
  if [[ "${rebase_base}" == "--root" ]]; then
    rebase_args+=(--root)
  else
    rebase_args+=("${rebase_base}")
  fi

  if ! git rebase "${rebase_args[@]}"; then
    print -u2 "[❌] Rebase stopped. If signing failed mid-run (Secretive can drop"
    print -u2 "     rapid back-to-back requests — maxgoedjen/secretive#577), retry:"
    print -u2 "       git commit --amend --no-edit -n -S && git rebase --continue"
    print -u2 "     or abort with: git rebase --abort"
    exit 1
  fi

  local remaining unsigned
  remaining="$(git rev-list "${RANGE[@]}")" || die "cannot read unpushed range after rebase"
  unsigned="$("${SIGNATURE_SCAN}" <<< "${remaining}")" || die "cannot inspect commits after rebase"
  if [[ -n "${unsigned}" ]]; then
    die "unsigned commits remain after rebase — inspect: git log --format='%h %G? %s' ${RANGE[*]}"
  fi
  echo "[✅] Re-signed:"
  git log --format='  %h %s' "${RANGE[@]}"
}

function main {
  git rev-parse --show-toplevel &>/dev/null || die "not inside a git repository"
  git symbolic-ref -q HEAD >/dev/null || die "detached HEAD — check out a branch first"
  if ! { git diff --quiet && git diff --cached --quiet; }; then
    die "worktree not clean — commit or stash first (rebase refuses a dirty tree)"
  fi

  local revs
  revs="$(git rev-list "${RANGE[@]}")" || die "revision walk failed for unpushed range"
  if [[ -z "${revs}" ]]; then
    echo "[✅] No unpushed commits — nothing to re-sign"
    return 0
  fi

  local unsigned
  unsigned="$("${SIGNATURE_SCAN}" <<< "${revs}")" || die "cannot inspect unpushed commit objects"
  if [[ -z "${unsigned}" ]]; then
    echo "[✅] All unpushed commits are signed — nothing to do"
    return 0
  fi

  local sha
  local -a ulist=()
  while IFS= read -r sha; do ulist+=("${sha}"); done <<< "${unsigned}"
  echo "[ℹ️ ] Unsigned commits to re-sign:"
  git log --no-walk --format='  %h %s' "${ulist[@]}"

  if (( ${#ulist} == 1 )) && [[ "${ulist[1]}" == "$(git rev-parse HEAD)" ]]; then
    _amend_head
    return 0
  fi

  _resign_by_rebase "${ulist[@]}"
}

main "$@"
