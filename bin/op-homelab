#!/bin/zsh
# dotfiles/bin/op-homelab
# Run op authenticated as the homelab-scoped 1Password Service Account
# (0xmachos-claude-mbp) instead of the desktop-app integration. For
# unattended use (Remote Control sessions, LaunchAgents) where nobody can
# approve a Touch ID prompt.
#
# Token: login Keychain item (service op-sa-claude-mbp). Copy the ops_ token
# to the clipboard, then store/rotate with:
#   security add-generic-password -U -s op-sa-claude-mbp -a 0xmachos-claude-mbp -w "$(pbpaste)" ~/Library/Keychains/login.keychain-db
# NB: add-generic-password's -w TAKES a value (unlike find-generic-password's
# boolean -w), so the keychain path must stay positional — a bare "-w <path>"
# silently stores the path as the token. Only $(pbpaste) reaches shell history.
#
# Never export OP_SERVICE_ACCOUNT_TOKEN ambiently — it overrides the
# desktop-app biometric auth path for every op call in that environment.
# Prefer `op-homelab run`/`inject` over `read`: run/inject deliver secrets
# to the child process environment; read prints them to stdout (and into
# Claude Code transcripts).

set -euo pipefail
IFS=$'\n\t'

readonly KEYCHAIN_SERVICE="op-sa-claude-mbp"
readonly KEYCHAIN_ACCOUNT="0xmachos-claude-mbp"
readonly LOGIN_KEYCHAIN="${HOME}/Library/Keychains/login.keychain-db"
readonly STORE_HINT="security add-generic-password -U -s ${KEYCHAIN_SERVICE} -a ${KEYCHAIN_ACCOUNT} -w \"\$(pbpaste)\" ${LOGIN_KEYCHAIN}"

token=""
if ! token="$(/usr/bin/security find-generic-password -s "${KEYCHAIN_SERVICE}" \
    -a "${KEYCHAIN_ACCOUNT}" -w "${LOGIN_KEYCHAIN}" 2>/dev/null)"; then
  # Rerun for diagnostics only — distinguish "item not found" from
  # keychain access/tool failures (locked keychain, wrong path, etc.)
  keychain_err="$(/usr/bin/security find-generic-password -s "${KEYCHAIN_SERVICE}" \
    -a "${KEYCHAIN_ACCOUNT}" -w "${LOGIN_KEYCHAIN}" 2>&1 1>/dev/null || true)"
  if [[ "${keychain_err}" == *"could not be found"* ]]; then
    echo "[❌] No service-account token in login Keychain (${KEYCHAIN_SERVICE})" >&2
    echo "     Store it: ${STORE_HINT}" >&2
  else
    echo "[❌] Keychain lookup failed (not a missing item): ${keychain_err}" >&2
  fi
  exit 1
fi
readonly token

if [[ -z "${token}" ]]; then
  echo "[❌] SA token item ${KEYCHAIN_SERVICE} is present but empty — op would" >&2
  echo "     otherwise fall through to desktop biometric auth (authorization" >&2
  echo "     timeout in an unattended session). Store it: ${STORE_HINT}" >&2
  exit 1
fi

# op run hands the child op's whole environment plus the resolved op://
# values — including OP_SERVICE_ACCOUNT_TOKEN itself (confirmed empirically
# 2026-07-11). Interpose env -u after `--` so children get the resolved
# secrets but not the vault-unlocking token.
args=("$@")
if [[ "${1:-}" == "run" ]]; then
  sep="${args[(i)--]}"
  if (( sep < ${#args} )); then
    # shellcheck disable=SC2296 # zsh-only ${(@)arr[a,b]} slice flags — no bash equivalent
    args=("${(@)args[1,sep]}" /usr/bin/env -u OP_SERVICE_ACCOUNT_TOKEN "${(@)args[sep+1,-1]}")
  fi
fi

op_status=0
OP_SERVICE_ACCOUNT_TOKEN="${token}" /opt/homebrew/bin/op "${args[@]}" || op_status=$?

# op exits 1 for auth and non-auth failures alike, and buffering stderr to
# classify would break live log streaming for long-running MCP children —
# so the hint stays conditional rather than classified.
if (( op_status != 0 )); then
  echo "[⚠️] op exited ${op_status}. If this was an auth error the token is expired or revoked." >&2
  echo "     Rotate: 1password.com → Developer → Service accounts → ${KEYCHAIN_ACCOUNT} → Rotate Token," >&2
  echo "     then re-store: ${STORE_HINT}" >&2
fi
exit "${op_status}"
