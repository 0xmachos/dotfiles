#!/bin/zsh
# dotfiles/bin/op-homelab
# Runs op as a scoped 1Password Service Account instead of the desktop-app
# integration, for unattended use (Remote Control sessions, LaunchAgents) where
# nobody can approve a Touch ID prompt.
#
# Keychain item names are private wiring, kept out of this tracked file, in
# ~/Library/Application Support/op-homelab/keychain-item, two lines:
#   service=<keychain service name>
#   account=<keychain account name>
# The ops_ token is the login Keychain item under those names; copy it to the
# clipboard, then store/rotate with the store hint this script prints.
#
# Never export OP_SERVICE_ACCOUNT_TOKEN ambiently: it overrides the desktop-app
# biometric path for every op call. Prefer `op-homelab run`/`inject` over
# `read`: run/inject put secrets in the child's environment, read prints them
# to stdout (and into agent transcripts).

set -euo pipefail
IFS=$'\n\t'

readonly ITEM_FILE="${HOME}/Library/Application Support/op-homelab/keychain-item"
if [[ ! -r "${ITEM_FILE}" ]]; then
  echo "[❌] Keychain item names file missing or unreadable: ${ITEM_FILE}" >&2
  echo "     Create it (0600) with two lines: service=<name> and account=<name>" >&2
  exit 1
fi
KEYCHAIN_SERVICE="$(/usr/bin/sed -n 's/^service=//p' "${ITEM_FILE}" | /usr/bin/head -n 1)"
KEYCHAIN_ACCOUNT="$(/usr/bin/sed -n 's/^account=//p' "${ITEM_FILE}" | /usr/bin/head -n 1)"
if [[ -z "${KEYCHAIN_SERVICE}" || -z "${KEYCHAIN_ACCOUNT}" ]]; then
  echo "[❌] ${ITEM_FILE} must hold service=<name> and account=<name>" >&2
  exit 1
fi
readonly KEYCHAIN_SERVICE KEYCHAIN_ACCOUNT
readonly LOGIN_KEYCHAIN="${HOME}/Library/Keychains/login.keychain-db"
# add-generic-password's -w TAKES a value (find-generic-password's is boolean),
# so the keychain path stays positional: a bare "-w <path>" stores the path as
# the token. Only $(pbpaste) reaches shell history.
readonly STORE_HINT="security add-generic-password -U -s ${KEYCHAIN_SERVICE} -a ${KEYCHAIN_ACCOUNT} -w \"\$(pbpaste)\" ${LOGIN_KEYCHAIN}"

token=""
if ! token="$(/usr/bin/security find-generic-password -s "${KEYCHAIN_SERVICE}" \
    -a "${KEYCHAIN_ACCOUNT}" -w "${LOGIN_KEYCHAIN}" 2>/dev/null)"; then
  # Rerun for diagnostics only: "item not found" vs a keychain/tool failure.
  keychain_err="$(/usr/bin/security find-generic-password -s "${KEYCHAIN_SERVICE}" \
    -a "${KEYCHAIN_ACCOUNT}" -w "${LOGIN_KEYCHAIN}" 2>&1 1>/dev/null || true)"
  if [[ "${keychain_err}" == *"could not be found"* ]]; then
    echo "[❌] No service-account token in login Keychain (${KEYCHAIN_SERVICE})" >&2
    echo "     Store it: ${STORE_HINT}" >&2
  else
    echo "[❌] Keychain lookup failed (not a missing item): ${keychain_err}" >&2
  fi
  exit 1
fi
readonly token

if [[ -z "${token}" ]]; then
  echo "[❌] SA token item ${KEYCHAIN_SERVICE} is present but empty — op would" >&2
  echo "     otherwise fall through to desktop biometric auth (authorization" >&2
  echo "     timeout in an unattended session). Store it: ${STORE_HINT}" >&2
  exit 1
fi

# op run hands the child its whole environment plus the resolved op:// values,
# OP_SERVICE_ACCOUNT_TOKEN included (confirmed 2026-07-11), so interpose
# env -u after `--`: children get the secrets but not the token.
args=("$@")
if [[ "${1:-}" == "run" ]]; then
  sep="${args[(i)--]}"
  if (( sep < ${#args} )); then
    # shellcheck disable=SC2296 # zsh-only ${(@)arr[a,b]} slice flags — no bash equivalent
    args=("${(@)args[1,sep]}" /usr/bin/env -u OP_SERVICE_ACCOUNT_TOKEN "${(@)args[sep+1,-1]}")
  fi
fi

op_status=0
OP_SERVICE_ACCOUNT_TOKEN="${token}" /opt/homebrew/bin/op "${args[@]}" || op_status=$?

# op exits 1 for auth and non-auth failures alike, and buffering stderr to
# classify would break live log streaming for long-running MCP children, so
# the hint stays conditional.
if (( op_status != 0 )); then
  echo "[⚠️] op exited ${op_status}. If this was an auth error the token is expired or revoked." >&2
  echo "     Rotate: 1password.com → Developer → Service accounts → ${KEYCHAIN_ACCOUNT} → Rotate Token," >&2
  echo "     then re-store: ${STORE_HINT}" >&2
fi
exit "${op_status}"
