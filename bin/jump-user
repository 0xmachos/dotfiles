#!/usr/bin/env zsh
# dotfiles/bin/jump-user
#
# User-level updater for Homebrew, Claude Code and Muse Code, plus per-host
# extras from .extra/jump-user if present. Run by LaunchAgent
# com.0xmachos.jump-user; also fine by hand.
#
#   Usage: jump-user [--delay N]

set -uo pipefail

LOG_FILE="${HOME}/Library/Logs/jump.log"

function run_and_log {
  local description="$1"
  shift
  local output rc
  if output=$("$@" 2>&1); then
    rc=0
    logger -t "com.0xmachos.jump" "[OK] ${description}"
  else
    rc=$?
    logger -t "com.0xmachos.jump" "[FAIL] ${description}"
    # No errexit and the redirect's status never reaches rc, so an unwritable
    # LOG_FILE would drop all detail while syslog still shows [FAIL]: report
    # the write failure to syslog, the sink that cannot fail.
    if ! {
      echo "[$(date '+%Y-%m-%d %H:%M:%S')] [FAIL] ${description}"
      echo "${output}"
      echo ""
    } >> "${LOG_FILE}" 2>/dev/null; then
      logger -t "com.0xmachos.jump" "[FAIL] cannot write ${LOG_FILE} — detail for '${description}' lost"
    fi
  fi
  return "${rc}"
}

# brew vulns (Homebrew >= 6.0) exits 1 for findings and scan errors alike, so
# split on the "Found N vulnerabilities" line, printed only when a scan
# completes with findings. Findings log as [VULN], not a broken scan.
function run_vulns_scan {
  local brew_binary="$1"
  local output scan_status tag rc
  output=$("${brew_binary}" vulns --severity high 2>&1)
  scan_status=$?
  if [[ "${scan_status}" -eq 0 ]]; then
    logger -t "com.0xmachos.jump" "[OK] brew vulns"
    return 0
  fi
  if grep -q '^Found .* vulnerabilit' <<< "${output}"; then
    tag="VULN"; rc=0   # vulnerabilities found — logged, not a scan failure
  else
    tag="FAIL"; rc=1   # scan itself broke — a real failure
  fi
  logger -t "com.0xmachos.jump" "[${tag}] brew vulns"
  # Same silent-redirect hazard as run_and_log (see there).
  if ! {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [${tag}] brew vulns --severity high"
    echo "${output}"
    echo ""
  } >> "${LOG_FILE}" 2>/dev/null; then
    logger -t "com.0xmachos.jump" "[FAIL] cannot write ${LOG_FILE} — brew vulns detail lost"
  fi
  return "${rc}"
}

function check_internet_connection {
  local -a domains=("captive.apple.com" "google.com" "flightywifi.com")
  local domain reachability

  # $1 is a test fixture command; main passes none, so launchd always uses
  # /usr/sbin/scutil.
  for domain in "${domains[@]}"; do
    if reachability=$("${1:-/usr/sbin/scutil}" -r "${domain}") \
        && [[ $'\n'"${reachability}" == *$'\n'Reachable* ]]; then
      return 0
    fi
  done

  logger -t "com.0xmachos.jump" "[FAIL] jump-user: not connected to the internet"
  return 1
}

function main {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --delay)
        sleep "$2"
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done

  if ! check_internet_connection; then
    return 1
  fi

  # launchd does not source .zshrc
  eval "$(/opt/homebrew/bin/brew shellenv)"

  local -r BREW_BINARY="/opt/homebrew/bin/brew"

  if ! [[ -x "${BREW_BINARY}" ]]; then
    logger -t "com.0xmachos.jump" "[FAIL] jump-user: brew not found"
    return 1
  fi

  local rc=0
  run_and_log "brew update"     "${BREW_BINARY}" update     || rc=1
  run_and_log "brew upgrade"    "${BREW_BINARY}" upgrade    || rc=1
  run_and_log "brew cleanup"    "${BREW_BINARY}" cleanup    || rc=1
  run_and_log "brew autoremove" "${BREW_BINARY}" autoremove || rc=1
  # brew doctor exits non-zero on benign warnings: logged, not folded into rc.
  run_and_log "brew doctor"     "${BREW_BINARY}" doctor

  # OSV.dev scan; only GitHub/GitLab/Codeberg-sourced formulae are checked.
  # Not gated on command existence: if brew vulns disappears, the run logs
  # [FAIL] rather than silently skipping.
  run_vulns_scan "${BREW_BINARY}" || rc=1

  ## Claude Code ##
  # Native installer: ~/.local/bin/claude symlinks into
  # ~/.local/share/claude/versions/. Runs as the user, never from jump-system
  # (root-owned files would break later updates).
  local -r CLAUDE_BINARY="${HOME}/.local/bin/claude"
  if [[ -x "${CLAUDE_BINARY}" ]]; then
    run_and_log "claude update" "${CLAUDE_BINARY}" update || rc=1
  fi

  ## Muse Code ##
  # Meta's installer: ~/.local/bin/muse is a bash launcher that downloads and
  # SHA-256-verifies muse-bin-<version> beside itself. Runs as the user, never
  # from jump-system.
  #
  # No `muse update` subcommand: MUSE_LAUNCHER_INSTALL=1 is the launcher's
  # install-and-exit path (updates the binary, reports any update notice,
  # exits 0 without the TUI). Verified against launcher_version="2"
  # (Muse Code 1.0.2-R2040.1), 2026-09-04.
  # Binary only: the launcher script refreshes itself from api.meta.ai on an
  # interactive launch, at most hourly. MUSE_SYNC_UPDATE=1 is not used to
  # cover that: it execs the app binary afterwards.
  #
  # MUSE_LOGIN=0 blocks device sign-in. The launcher reads a bearer token only
  # from ~/.config/muse/auth.json, which holds metadata alone (storage:
  # keychain, no access_token key; checked 2026-09-04), so downloads are
  # unauthenticated. Without a TTY it declines device_login anyway; the flag
  # states the intent and makes a gated download fail as a plain HTTP error.
  # Sign-in stays `muse`'s own job.
  #
  # An upgrade writes .muse-update-notice; report_update_notice keeps it unless
  # stderr is a TTY, so a launchd run leaves the "Muse Code updated X -> Y"
  # line for the next interactive launch. run_and_log records only [OK].
  #
  # The launcher returns 0 if it cannot get its install-directory lock, so a
  # concurrent update from an open Muse session is a silent no-op, not a
  # failure.
  local -r MUSE_BINARY="${HOME}/.local/bin/muse"
  if [[ -x "${MUSE_BINARY}" ]]; then
    run_and_log "muse update" \
      /usr/bin/env MUSE_LAUNCHER_INSTALL=1 MUSE_LOGIN=0 "${MUSE_BINARY}" || rc=1
  fi

  ## Local extras (gitignored, sourced if present) ##
  # Per-host updaters live in dotfiles/.extra/jump-user (.gitignore's .extra*
  # rule keeps it local). Runs as the user in main's scope; may use run_and_log.
  local -r EXTRA_JUMP_USER="${HOME}/dotfiles/.extra/jump-user"
  if [[ -r "${EXTRA_JUMP_USER}" ]]; then
    # shellcheck disable=SC1090
    source "${EXTRA_JUMP_USER}"
  fi

  return "${rc}"
}

main "$@"
