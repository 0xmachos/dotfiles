#!/usr/bin/env zsh
# dotfiles/bin/npm-audit-check
#
# Audits npm projects for vulnerabilities and verifies package signatures, for
# every project with a package-lock.json under ~/Documents/Projects/. Called
# from jump-user via run_and_log or interactively. Production vulnerabilities
# and signature failures are errors; dev-only vulnerabilities warn.
#
# Usage: npm-audit-check
#
# ShellCheck: Use `shellcheck --shell=bash` (no native Zsh support).

set -uo pipefail
IFS=$'\n\t'

readonly NPM_BINARY="/opt/homebrew/bin/npm"
readonly PROJECTS_DIR="${HOME}/Documents/Projects"

function audit_project {
  local project_dir="$1"
  local project_name="${project_dir##*/}"
  local failures=0

  echo "── ${project_name} ──"

  local prod_rc=0
  "${NPM_BINARY}" audit --omit=dev --package-lock-only \
    --prefix="${project_dir}" 2>&1 || prod_rc=$?

  if (( prod_rc != 0 )); then
    echo "[ERROR] Production deps: known vulnerabilities"
    (( failures += 1 ))
  fi

  if (( prod_rc == 0 )); then
    local all_rc=0
    "${NPM_BINARY}" audit --package-lock-only \
      --prefix="${project_dir}" 2>&1 || all_rc=$?

    if (( all_rc != 0 )); then
      echo "[WARN] Dev deps: known vulnerabilities"
    fi
  fi

  # --userconfig=/dev/null drops the ~/.npmrc install-time hardening
  # (min-release-age, prefer-offline) for this audit only: those make npm
  # re-resolve the tree and abort with ETARGET on a freshly-updated package,
  # a false signature failure.
  if [[ -d "${project_dir}/node_modules" ]]; then
    local sig_rc=0
    "${NPM_BINARY}" audit signatures \
      --prefix="${project_dir}" --userconfig=/dev/null 2>&1 || sig_rc=$?

    if (( sig_rc != 0 )); then
      echo "[ERROR] Signature verification failed"
      (( failures += 1 ))
    fi
  else
    echo "[SKIP] Signatures: no node_modules (run npm install first)"
  fi

  echo ""
  return "${failures}"
}

function main {
  if ! [[ -x "${NPM_BINARY}" ]]; then
    echo "[FAIL] npm not found at ${NPM_BINARY}"
    return 1
  fi

  # A missing/unreadable projects dir is an error, NOT "no projects" (clean
  # pass): find would return nothing and the empty-lockfiles branch below would
  # report a false success.
  if [[ ! -d "${PROJECTS_DIR}" || ! -r "${PROJECTS_DIR}" ]]; then
    echo "[FAIL] Projects directory missing or unreadable: ${PROJECTS_DIR}"
    return 1
  fi

  local lockfiles=()
  local lockfile
  while IFS= read -r lockfile; do
    lockfiles+=("${lockfile}")
  done < <(/usr/bin/find "${PROJECTS_DIR}" -maxdepth 4 \
            -type d -name node_modules -prune -o \
            -name "package-lock.json" -type f -print 2>/dev/null | /usr/bin/sort)

  if (( ${#lockfiles[@]} == 0 )); then
    echo "No npm projects found under ${PROJECTS_DIR}"
    return 0
  fi

  echo "Scanning ${#lockfiles[@]} npm project(s)"
  echo ""

  local total_failures=0
  for lockfile in "${lockfiles[@]}"; do
    local project_dir="${lockfile%/package-lock.json}"
    local project_rc=0
    audit_project "${project_dir}" || project_rc=$?
    (( total_failures += project_rc ))
  done

  if (( total_failures > 0 )); then
    echo "${total_failures} check(s) failed"
    return 1
  fi

  echo "All checks passed"
}

main "$@"
