#!/bin/zsh
# dotfiles/bin/vt
# Wrapper for virustotal-cli. bao-mcp-env reads kv/mcp/vt (field VTCLI_APIKEY)
# through this Mac's Claude AppRole and exports it; no 1Password, no Touch ID.
# The key goes in VTCLI_APIKEY (vt-cli's env override for --apikey), never in
# argv, which any local process can read.

set -euo pipefail

exec /usr/local/bin/bao-mcp-env mcp/vt /opt/homebrew/bin/vt "$@"
