#!/bin/sh
#
# bao-mcp-env — launch a command with env vars from an OpenBao KV v2 secret.
#
# Usage: bao-mcp-env <kv-subpath> <command> [args...]
#   kv-subpath  path under the kv/ mount, e.g. mcp/example-service
#   command     binary to exec with the secret's fields in its environment
#
# Laptop port of the server-side loader; only the connection config differs:
# address from the untracked credential dir (addr, one line), listener cert
# chained to the step-ca root that `step ca bootstrap` wrote locally, AppRole
# creds in ~/Library/Application Support/openbao/claude/ (0600).
# Exports every field of the secret verbatim (kv/mcp/* keys are literal env-var
# names, so no per-server logic). Like `op run --env-file`: per-process env
# only, nothing on disk, never launchctl setenv.
# Re-authenticates every call (reusable SecretID). The token is revoked BEFORE
# exec (an EXIT trap would die with the process image) and BAO_TOKEN unset, so
# the command never inherits it.
#
# 2026-10-10: refuses (exit 65) to exec when any field of the secret would
# reach the command's argv. ps(1) shows every process's argv to every local
# user, so a field passed as an argument is readable for the process's whole
# life; an environment variable is not. Two checks run over the command and
# its arguments after the secret is read and the token is revoked, before the
# eval and exec. (1) A `$F` or `${F}` reference to any field name F in an
# argument is refused, after stripping NAME=VALUE assignment prefixes (bare,
# "double" or 'single' quoted) from the START of that argument: the safe shape
# is NAME="$F" exec prog ..., where the shell hands $F to prog as environment.
# A prefix that is not at the start (`exec env X="$F" prog`) is refused. A
# value holding command substitution is never stripped. (2) A field VALUE of 8
# or more characters appearing as a substring of any argument (a pasted
# literal) is refused. Shorter values (ports, short hosts) are skipped on
# purpose: they would match ordinary text. Field names are not special-cased.
# The message names the field and the fix, never the value.

# SC2016: the single-quoted $ strings are literal patterns and a jq program.
# SC2295: the blank set in the unquoted bracket pattern is deliberate.
# shellcheck disable=SC2016,SC2295
set -eu

# Seams (tests/bao-mcp-env): BAO_MCP_ENV_BAO, BAO_MCP_ENV_JQ. CRED_DIR has
# none: tests point HOME at a fixture so the path construction runs unmodified.
BAO="${BAO_MCP_ENV_BAO:-/opt/homebrew/bin/bao}"
JQ="${BAO_MCP_ENV_JQ:-$(command -v jq || echo /opt/homebrew/bin/jq)}"
export BAO_CACERT="${HOME}/.step/certs/root_ca.crt"

if [ "$#" -lt 2 ]; then
    echo "usage: bao-mcp-env <kv-subpath> <command> [args...]" >&2
    exit 64
fi

path="$1"
shift

CRED_DIR="${HOME}/Library/Application Support/openbao/claude"

if [ ! -r "$CRED_DIR/role_id" ] || [ ! -r "$CRED_DIR/secret_id" ]; then
    echo "bao-mcp-env: AppRole credentials missing or unreadable in $CRED_DIR" >&2
    exit 1
fi

# The address is private wiring: beside the credentials, never in this file.
if [ ! -r "$CRED_DIR/addr" ]; then
    echo "bao-mcp-env: server address file missing or unreadable: $CRED_DIR/addr" >&2
    exit 1
fi
# First line only: IFS= and -r keep leading/trailing
# blanks and backslashes verbatim; `|| :` because read returns 1 at EOF (an
# empty file, or a last line with no newline, which it still stores). The
# empty default covers a read that fails without assigning (addr is a
# directory), so the https:// check below refuses it rather than `set -u`.
BAO_ADDR=""
IFS= read -r BAO_ADDR < "$CRED_DIR/addr" || :
case "$BAO_ADDR" in
    https://*) ;;
    *) echo "bao-mcp-env: $CRED_DIR/addr must hold one https:// URL" >&2; exit 1 ;;
esac
export BAO_ADDR

# Credentials go by @file, not value: argv is readable via ps(1) for the call's
# lifetime. bao loads a value from a file when it begins with "@".
if ! BAO_TOKEN="$("$BAO" write -field=token auth/approle/login \
    role_id="@$CRED_DIR/role_id" secret_id="@$CRED_DIR/secret_id" 2>/dev/null)"; then
    echo "bao-mcp-env: AppRole login failed (server sealed/down, or overlay path broken?)" >&2
    exit 1
fi
export BAO_TOKEN

if ! secret_json="$("$BAO" kv get -format=json -mount=kv "$path")"; then
    "$BAO" token revoke -self >/dev/null 2>&1 || true
    echo "bao-mcp-env: read of kv/$path failed" >&2
    exit 1
fi

"$BAO" token revoke -self >/dev/null 2>&1 || true
unset BAO_TOKEN

# @sh single-quotes each value; keys are validated so a malformed kv entry
# fails loudly instead of reaching eval.
exports="$(printf '%s' "$secret_json" | "$JQ" -r '
    .data.data | to_entries[]
    | if (.key | test("^[A-Za-z_][A-Za-z0-9_]*$")) then .
      else error("invalid env var name: \(.key)") end
    | "export \(.key)=\(.value | @sh)"')"

# --- argv refusal (see header). Helper variables carry a _bme_ prefix: a
# plain name could collide with a variable the caller exported, and the
# assignment would then change what the child sees. The check runs before the
# eval, so a field can never shadow a helper. -------------------------------
_bme_nl='
'
_bme_tab="$(printf '\t')"

_bme_refuse() {
    echo "bao-mcp-env: field $1 would reach argv; pass it as an env prefix (NAME=\"\$$1\" exec ...)" >&2
    exit 65
}

# Sets _bme_stripped to $1 without leading blanks and NAME=VALUE prefixes. A
# prefix it cannot parse safely stays in place, so the caller errs toward
# refusing.
_bme_strip_assignments() {
    _bme_s="$1"
    while :; do
        case "$_bme_s" in
            ' '*|"$_bme_tab"*|"$_bme_nl"*) _bme_s="${_bme_s#?}"; continue ;;
        esac
        case "$_bme_s" in
            [A-Za-z_]*=*) ;;
            *) break ;;
        esac
        case "${_bme_s%%=*}" in *[!A-Za-z0-9_]*) break ;; esac
        _bme_rest="${_bme_s#*=}"
        case "$_bme_rest" in
            \"*)
                _bme_body="${_bme_rest#\"}"
                case "$_bme_body" in *\"*) ;; *) break ;; esac
                _bme_val="${_bme_body%%\"*}"
                _bme_tail="${_bme_body#*\"}" ;;
            \'*)
                _bme_body="${_bme_rest#\'}"
                case "$_bme_body" in *\'*) ;; *) break ;; esac
                _bme_val="${_bme_body%%\'*}"
                _bme_tail="${_bme_body#*\'}" ;;
            *)
                _bme_val="${_bme_rest%%[ ${_bme_tab}${_bme_nl}]*}"
                _bme_tail="${_bme_rest#"$_bme_val"}" ;;
        esac
        case "$_bme_val" in *'$('*|*'`'*) break ;; esac
        case "$_bme_tail" in
            ''|' '*|"$_bme_tab"*|"$_bme_nl"*) ;;
            *) break ;;
        esac
        _bme_s="$_bme_tail"
    done
    _bme_stripped="$_bme_s"
}

# True when $1 holds $2 as $F or ${F...}. A longer name ($FOO for field F) is
# another variable and does not count.
_bme_refs_field() {
    for _bme_pre in '$' '${'; do
        _bme_t="$1"
        while :; do
            case "$_bme_t" in *"$_bme_pre$2"*) ;; *) break ;; esac
            _bme_t="${_bme_t#*"$_bme_pre$2"}"
            case "$_bme_t" in
                [A-Za-z0-9_]*) ;;
                *) return 0 ;;
            esac
        done
    done
    return 1
}

_bme_names="$(printf '%s' "$secret_json" | "$JQ" -r '.data.data | keys[]')"
for _bme_fld in $_bme_names; do
    _bme_fval="$(printf '%s' "$secret_json" | "$JQ" -r --arg k "$_bme_fld" '.data.data[$k] | tostring')"
    for _bme_arg in "$@"; do
        _bme_strip_assignments "$_bme_arg"
        if _bme_refs_field "$_bme_stripped" "$_bme_fld"; then
            _bme_refuse "$_bme_fld"
        fi
        if [ "${#_bme_fval}" -ge 8 ]; then
            case "$_bme_arg" in *"$_bme_fval"*) _bme_refuse "$_bme_fld" ;; esac
        fi
    done
done

eval "$exports"

exec "$@"
