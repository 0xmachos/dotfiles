#!/bin/zsh
# dotfiles/bin/scratch-sweep
#
# Deletes idle scratch under ~/Library/Caches/claude-tmp. Run daily by the
# com.0xmachos.scratch-sweep LaunchAgent; safe to run by hand.
#
#   scratch-sweep [--dry-run]
#
# Unit of deletion: each top-level entry under the root. An entry is idle when
# nothing inside it (the entry itself included) was modified in the last 14
# days. One recent file deep in a tree keeps the whole tree. Only writes count:
# a tree that is read every day but never modified is still swept. An idle
# entry is removed with `/bin/rm -rf --`: real deletion on purpose, since the
# shell's rm alias moves files to the Trash and would not free the space. A
# top-level symlink is removed with `/bin/rm -f --` once its own mtime is idle;
# it is never followed, and neither is a symlink inside an entry, so nothing
# outside the root is ever touched. Entries whose names start with a dot are
# handled like any other, except the sweep's own lock.
#
# Age is measured in seconds (`find -mtime -1209600s`), so there is no whole-day
# rounding: an entry idle for 13 days 23 hours is kept, one idle for 14 days is
# swept. The bare-day form `-mtime -14` was measured to agree on this macOS
# (2026-09-29), but the seconds form does not depend on how find rounds days.
#
# Exempt entries, never swept whatever their age:
#   - claude-<digits>: the per-uid directory the tool that owns this root
#     creates for itself. That tool validates and manages the directory and
#     refuses one that is a symlink or has another owner, so the sweep must
#     neither delete nor replace it.
#   - .sweep.lock: the sweep's own lock.
#
# Safety, because this runs unattended and deletes recursively:
#   - The root is hardcoded to ${HOME}/Library/Caches/claude-tmp. No argument or
#     environment variable other than HOME changes it, so nothing an agent can
#     type turns this into a recursive delete of an arbitrary directory. An
#     unset, empty or relative HOME is refused.
#   - _sweep_root_dir, which the tests drive with a fixture root, refuses any
#     root that is not an absolute path ending in Caches/claude-tmp, that
#     contains a . or .. component, that is a symlink, that is not a directory,
#     or that is not owned by the invoking uid ($UID, not "some user": a sudo
#     run has a different HOME and must not pass a root-owned tree).
#   - The root is entered with `cd -P` and the resulting $PWD must equal the
#     physical path that was validated (its parents resolved, its own name
#     not); on any mismatch (the root was swapped for a symlink between the
#     check and the cd) the sweep aborts and never falls through to the
#     caller's directory. From then on the sweep names
#     entries only as `./<name>`, so every delete acts through the directory it
#     entered, not through a path that could be re-pointed. Entries are listed
#     with the zsh glob `*(DN)`, so a leading dash, spaces, glob characters or a
#     newline in a name are inert. Names are never given a trailing slash
#     (`rm -rf link/` would follow the link), and every command takes `--`.
#   - A scan that reports any error (an unreadable subdirectory) is treated as
#     "not idle": an entry is deleted only after a clean scan found nothing new.
#   - Immediately before deleting, the entry is scanned again; one that became
#     active since the first scan is kept. This narrows the race, it cannot
#     close it: a write landing between that scan and the rm still loses.
#   - One instance at a time: a `.sweep.lock` directory holding the owner's pid.
#     A lock is stale when its pid no longer exists, or when it is older than 60
#     minutes (the running sweep touches it after every entry, so a live run
#     never ages out). A stale lock is replaced; two runs that both find the
#     same stale lock may race for it, which is harmless because each sweep is
#     safe on its own. A lock that cannot be taken at all (a root without write
#     permission) or that is stale but cannot be replaced (it cannot be
#     emptied) is reported as "cannot take the lock" with exit 1, never as a
#     lock held by another sweep.
#     `kill -0` also fails with EPERM, so a dead owner's pid reused by another
#     user's process reads as gone and the lock is replaced early; the outcome is
#     the same harmless second sweep.
#   - A missing root is a normal state (nothing to do, exit 0); nothing is created
#     except the lock.
#
# Exit status: 0 on success, on a missing root and when another sweep holds the
# lock; 1 when any entry could not be scanned or removed (the other entries are
# still processed), the lock path is not a directory or the lock cannot be
# taken; 2 on a refused root, a bad argument or an unusable HOME.
# Stdout carries one line per deletion and a closing summary (launchd routes it
# to ~/Library/Logs/scratch-sweep.log); refusals go to stderr.
#
# launchd has no PATH: every binary is called by absolute path. It is a
# launchd-driven script, so it accumulates an exit status across entries rather
# than using `set -e`. Deployed as a root-owned copy in /usr/local/bin by
# `./bittersweet scripts`: launchd cannot execute a program under ~/Documents.
#
# ShellCheck: lint with `shellcheck --shell=bash bin/scratch-sweep`.
# Test: ./test scratch-sweep

emulate -L zsh
set -uo pipefail
umask 077

readonly SWEEP_IDLE_SECONDS=1209600   # 14 days
readonly SWEEP_LOCK_NAME=.sweep.lock
readonly SWEEP_LOCK_STALE_MIN=60
readonly SWEEP_EXEMPT_RE='^claude-[0-9]+$'

typeset -ga SWEEP_NAMES=()
typeset -g SWEEP_PHYS=''
typeset -gi SWEEP_REMOVED=0 SWEEP_KEPT=0 SWEEP_SKIPPED=0 SWEEP_FAILED=0 SWEEP_EXEMPT=0

function _sweep_log {
  print -r -- "$(/bin/date '+%Y-%m-%dT%H:%M:%S%z') $*"
}

function _sweep_q {
  # Shell-quote $1 so a name with a newline or control character stays on one
  # log line.
  # shellcheck disable=SC2296
  print -rn -- "${(q+)1}"
}

function _sweep_uid_of {
  # Owner uid of $1. A function so the tests can substitute another owner.
  /usr/bin/stat -f %u "$1" 2>/dev/null
}

function _sweep_pre_delete {
  # Called once per entry, between the first scan and the last-moment re-scan.
  # Does nothing; the tests redefine it to make an entry busy at that instant.
  return 0
}

function _sweep_check_root {
  # Validate $1. Returns 0 when the root is usable and exists (SWEEP_PHYS is set
  # to its physical path), 3 when it is valid but absent, 2 when refused.
  local root="$1" reason='' owner=''
  SWEEP_PHYS=''
  while [[ "${root}" == */ && "${root}" != / ]]; do
    root="${root%/}"
  done
  if [[ "${root}" != /* ]]; then
    reason='not an absolute path'
  elif [[ "${root:t}" != claude-tmp || "${root:h:t}" != Caches ]]; then
    reason='not a Caches/claude-tmp directory'
  elif [[ "${root}/" == */../* || "${root}/" == */./* ]]; then
    reason='contains a . or .. component'
  elif [[ -L "${root}" ]]; then
    reason='is a symlink'
  elif [[ ! -e "${root}" ]]; then
    return 3
  elif [[ ! -d "${root}" ]]; then
    reason='is not a directory'
  else
    owner="$(_sweep_uid_of "${root}")"
    if [[ "${owner}" != "${UID}" ]]; then
      reason='is not owned by the current user'
    fi
  fi
  if [[ -n "${reason}" ]]; then
    print -u2 -r -- "scratch-sweep: refusing root $(_sweep_q "${root}"): ${reason}"
    return 2
  fi
  # Resolve the parent only: a final component that turns into a symlink after
  # the checks above must make the cd -P below land elsewhere and abort, not be
  # quietly followed here.
  SWEEP_PHYS="${root:h:A}/${root:t}"
  return 0
}

function _sweep_lock_stale {
  # Is the lock at $1 stale? True when its pid is gone or when it is older than
  # the stale limit.
  local lock="$1" holder='' fresh=''
  if [[ -r "${lock}/pid" ]]; then
    { holder="$(<"${lock}/pid")"; } 2>/dev/null
  fi
  if [[ "${holder}" =~ ^[0-9]+$ ]] && ! kill -0 "${holder}" 2>/dev/null; then
    return 0
  fi
  fresh="$(/usr/bin/find -P "${lock}" -maxdepth 0 -mmin "-${SWEEP_LOCK_STALE_MIN}" -print 2>/dev/null)"
  [[ -z "${fresh}" ]]
}

function _sweep_lock {
  # Take ./.sweep.lock (the working directory is the root). Returns 0 when the
  # lock is taken, 1 when another live sweep holds it (or the lock path is not
  # a directory), 2 when it can be neither taken nor replaced. A lock whose pid
  # is gone or that is older than the stale limit is replaced.
  local lock="./${SWEEP_LOCK_NAME}"
  if /bin/mkdir -- "${lock}" 2>/dev/null; then
    print -r -- "$$" > "${lock}/pid"
    return 0
  fi
  if [[ ! -e "${lock}" && ! -L "${lock}" ]]; then
    # mkdir failed and nothing is there: no permission to create it.
    return 2
  fi
  if [[ ! -d "${lock}" || -L "${lock}" ]]; then
    return 1
  fi
  if _sweep_lock_stale "${lock}"; then
    /bin/rm -f -- "${lock}/pid"
    /bin/rmdir -- "${lock}" 2>/dev/null
    if /bin/mkdir -- "${lock}" 2>/dev/null; then
      print -r -- "$$" > "${lock}/pid"
      return 0
    fi
    # The replacement failed. Another sweep that got there first holds a live
    # lock now (held); one that is still stale could not be removed (stuck).
    if [[ -d "${lock}" && ! -L "${lock}" ]] && _sweep_lock_stale "${lock}"; then
      return 2
    fi
  fi
  return 1
}

function _sweep_unlock {
  /bin/rm -f -- "./${SWEEP_LOCK_NAME}/pid"
  /bin/rmdir -- "./${SWEEP_LOCK_NAME}" 2>/dev/null
  return 0
}

function _sweep_list_names {
  # Fill SWEEP_NAMES with the top-level names of the working directory (the
  # root), dotfiles included, symlinks unresolved. The lock and the owning
  # tool's claude-<digits> directory are not entries: the second is counted.
  local name=''
  local -a found
  SWEEP_NAMES=()
  found=(*(DN))
  for name in "${found[@]}"; do
    if [[ "${name}" == "${SWEEP_LOCK_NAME}" ]]; then
      continue
    fi
    if [[ "${name}" =~ ${SWEEP_EXEMPT_RE} ]]; then
      (( SWEEP_EXEMPT += 1 ))
      continue
    fi
    SWEEP_NAMES+=("${name}")
  done
  return 0
}

function _sweep_recent {
  # Is anything in ./$1 (itself included, symlinks not followed) newer than the
  # idle limit? Returns 0 when something is, 1 when nothing is, 2 when the scan
  # failed and found nothing.
  local recent=''
  local -i scan_rc=0
  recent="$(/usr/bin/find -P "./$1" -mtime "-${SWEEP_IDLE_SECONDS}s" -print -quit 2>/dev/null)"
  scan_rc=$?
  if [[ -n "${recent}" ]]; then
    return 0
  fi
  if (( scan_rc != 0 )); then
    return 2
  fi
  return 1
}

function _sweep_entry {
  # Consider ./$1 of the working directory. $2 is 1 for a dry run.
  local name="$1" dry="$2"
  local -i scan_rc=0
  if [[ -z "${name}" || "${name}" == . || "${name}" == .. || "${name}" == */* ]]; then
    _sweep_log "skipped $(_sweep_q "${name}"): unexpected entry name"
    (( SWEEP_SKIPPED += 1 ))
    return 0
  fi
  if [[ ! -e "./${name}" && ! -L "./${name}" ]]; then
    return 0
  fi

  _sweep_recent "${name}"
  scan_rc=$?
  if (( scan_rc == 0 )); then
    (( SWEEP_KEPT += 1 ))
    return 0
  fi
  if (( scan_rc == 2 )); then
    _sweep_log "failed to scan $(_sweep_q "${name}"): kept"
    (( SWEEP_FAILED += 1 ))
    return 1
  fi

  if (( dry )); then
    _sweep_log "would remove $(_sweep_q "${name}")"
    (( SWEEP_REMOVED += 1 ))
    return 0
  fi

  _sweep_pre_delete "${name}"
  _sweep_recent "${name}"
  scan_rc=$?
  if (( scan_rc == 0 )); then
    _sweep_log "kept $(_sweep_q "${name}"): became active during the sweep"
    (( SWEEP_KEPT += 1 ))
    return 0
  fi
  if (( scan_rc == 2 )); then
    _sweep_log "failed to scan $(_sweep_q "${name}"): kept"
    (( SWEEP_FAILED += 1 ))
    return 1
  fi

  if [[ -L "./${name}" ]]; then
    /bin/rm -f -- "./${name}" 2>/dev/null
  else
    /bin/rm -rf -- "./${name}" 2>/dev/null
  fi
  if [[ -e "./${name}" || -L "./${name}" ]]; then
    _sweep_log "failed to remove $(_sweep_q "${name}")"
    (( SWEEP_FAILED += 1 ))
    return 1
  fi
  _sweep_log "removed $(_sweep_q "${name}")"
  (( SWEEP_REMOVED += 1 ))
  return 0
}

function _sweep_process {
  # Sweep every entry of the working directory ($1 is 1 for a dry run). Returns
  # 1 when any entry failed.
  local name=''
  local -i rc=0
  _sweep_list_names
  for name in "${SWEEP_NAMES[@]}"; do
    if ! _sweep_entry "${name}" "$1"; then
      rc=1
    fi
    if (( ! $1 )); then
      /usr/bin/touch -- "./${SWEEP_LOCK_NAME}" 2>/dev/null
    fi
  done
  _sweep_log "summary: removed=${SWEEP_REMOVED} kept=${SWEEP_KEPT} exempt=${SWEEP_EXEMPT} skipped=${SWEEP_SKIPPED} failed=${SWEEP_FAILED} dry_run=$1"
  return "${rc}"
}

function _sweep_leave {
  # Return to directory $1 (the caller's), best effort: if it is gone there is
  # nothing to restore and the sweep is already finished.
  builtin cd -- "$1" 2>/dev/null || return 0
}

function _sweep_enter {
  # cd into physical root $1 and prove it is the directory that was validated.
  # Returns 0 in the root; on any failure returns 1 with the working directory
  # restored, so the caller can never run a relative delete elsewhere.
  local phys="$1" here="${PWD}"
  if ! builtin cd -P -- "${phys}" 2>/dev/null; then
    print -u2 -r -- "scratch-sweep: refusing root $(_sweep_q "${phys}"): cannot enter it"
    return 1
  fi
  if [[ "${PWD}" != "${phys}" || "$(_sweep_uid_of .)" != "${UID}" ]]; then
    print -u2 -r -- "scratch-sweep: refusing root $(_sweep_q "${phys}"): changed while opening"
    _sweep_leave "${here}"
    return 1
  fi
  return 0
}

function _sweep_root_dir {
  # Sweep root $1; $2 is --dry-run or empty. The tests call this directly with
  # a fixture root; main calls it with the hardcoded one.
  local root="$1" mode="${2:-}" here="${PWD}"
  local -i dry=0 rc=0 check_rc=0 lock_rc=0
  if [[ "${mode}" == --dry-run ]]; then dry=1; fi
  SWEEP_REMOVED=0; SWEEP_KEPT=0; SWEEP_SKIPPED=0; SWEEP_FAILED=0; SWEEP_EXEMPT=0

  _sweep_check_root "${root}"
  check_rc=$?
  if (( check_rc == 3 )); then
    _sweep_log "nothing to do: root does not exist"
    return 0
  fi
  if (( check_rc != 0 )); then
    return 2
  fi
  if ! _sweep_enter "${SWEEP_PHYS}"; then
    return 2
  fi

  if (( dry )); then
    _sweep_process "${dry}"
    rc=$?
    _sweep_leave "${here}"
    return "${rc}"
  fi
  _sweep_lock
  lock_rc=$?
  if (( lock_rc == 2 )); then
    _sweep_log "cannot take the lock: nothing done"
    _sweep_leave "${here}"
    return 1
  fi
  if (( lock_rc != 0 )); then
    if [[ -L "./${SWEEP_LOCK_NAME}" || ( -e "./${SWEEP_LOCK_NAME}" && ! -d "./${SWEEP_LOCK_NAME}" ) ]]; then
      _sweep_log "lock path is not a directory: nothing done"
      rc=1
    else
      _sweep_log "another sweep holds the lock: nothing done"
      rc=0
    fi
    _sweep_leave "${here}"
    return "${rc}"
  fi
  _sweep_process "${dry}"
  rc=$?
  _sweep_unlock
  _sweep_leave "${here}"
  return "${rc}"
}

function main {
  local arg='' mode=''
  for arg in "$@"; do
    case "${arg}" in
      --dry-run) mode=--dry-run ;;
      *)
        print -u2 -r -- "usage: scratch-sweep [--dry-run]"
        return 2
        ;;
    esac
  done
  if [[ -z "${HOME:-}" || "${HOME}" != /* ]]; then
    print -u2 -r -- "scratch-sweep: HOME is unset or not absolute"
    return 2
  fi
  _sweep_root_dir "${HOME}/Library/Caches/claude-tmp" "${mode}"
}

# Sourced by the tests: define the functions, run nothing.
if [[ "${ZSH_EVAL_CONTEXT}" == toplevel ]]; then
  main "$@"
  exit $?
fi
