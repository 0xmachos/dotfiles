#!/bin/zsh
# dotfiles/bin/scratch-sweep
#
# Deletes idle scratch under ~/Library/Caches/claude-tmp. Run daily by the
# com.0xmachos.scratch-sweep LaunchAgent; safe to run by hand.
#
#   scratch-sweep [--dry-run]
#
# Unit: each top-level entry of the root, dotfiles included. Idle = nothing in
# it (itself included) modified in 14 days; one recent file deep keeps the
# tree, and reads do not count. Idle entries go via `/bin/rm -rf --` (real
# deletion: the shell's rm alias trashes, which frees no space); a top-level
# symlink via `/bin/rm -f --`. Symlinks are never followed.
# Age is in seconds (`find -mtime -1209600s`): no day rounding, 13 days 23 hours
# is kept. Bare `-mtime -14` agreed on this macOS (2026-09-29) but leaves the
# rounding to find.
# Never swept: claude-<digits> (the per-uid directory of the tool owning the
# root; it refuses a symlink or another owner) and .sweep.lock.
#
# Safety (unattended recursive delete):
#   - Root hardcoded to ${HOME}/Library/Caches/claude-tmp; only HOME moves it,
#     and an unset, empty or relative HOME is refused.
#   - _sweep_root_dir (the tests drive it with a fixture root) refuses a root
#     that is not absolute, does not end in Caches/claude-tmp, has a . or ..
#     component, is a symlink or not a directory, or is not owned by $UID (a
#     sudo run has a different HOME and must not pass a root-owned tree).
#   - `cd -P` into the root, then $PWD must equal the validated physical path
#     (parents resolved, own name not); on mismatch (root swapped for a symlink
#     after the check) abort, never fall through to the caller's directory.
#     Entries are then named `./<name>`, listed with glob `*(DN)` (odd names
#     inert), never given a trailing slash (`rm -rf link/` follows), and every
#     command takes `--`.
#   - A scan error (unreadable subdirectory) means "not idle".
#   - The entry is scanned again just before deletion and kept if it became
#     active. This narrows the race, it cannot close it: a write between that
#     scan and the rm still loses.
#   - Lock: `.sweep.lock` directory holding the owner's pid, stale when the pid
#     is gone or the lock is over 60 minutes old (a live run touches it after
#     every entry). A stale lock is replaced; two runs racing for it is
#     harmless. A lock that cannot be taken (no write permission) or replaced
#     (cannot be emptied) is "cannot take the lock", exit 1, not "held".
#   - A missing root is normal (exit 0); nothing is created except the lock.
#
# Exit: 0 on success, missing root, or lock held by another sweep; 1 when any
# entry could not be scanned or removed (the rest are still processed), the lock
# path is not a directory, or the lock cannot be taken; 2 on a refused root, a
# bad argument or an unusable HOME.
# Stdout: one line per deletion plus a summary (launchd routes it to
# ~/Library/Logs/scratch-sweep.log); refusals go to stderr.
# launchd has no PATH, so binaries are called by absolute path, and the exit
# status accumulates across entries instead of `set -e`. Deployed as a
# root-owned copy in /usr/local/bin by `./bittersweet scripts`: launchd cannot
# execute a program under ~/Documents.
#
# ShellCheck: lint with `shellcheck --shell=bash bin/scratch-sweep`.
# Test: ./test scratch-sweep

emulate -L zsh
set -uo pipefail
umask 077

readonly SWEEP_IDLE_SECONDS=1209600   # 14 days
readonly SWEEP_LOCK_NAME=.sweep.lock
readonly SWEEP_LOCK_STALE_MIN=60
readonly SWEEP_EXEMPT_RE='^claude-[0-9]+$'

typeset -ga SWEEP_NAMES=()
typeset -g SWEEP_PHYS=''
typeset -gi SWEEP_REMOVED=0 SWEEP_KEPT=0 SWEEP_SKIPPED=0 SWEEP_FAILED=0 SWEEP_EXEMPT=0

function _sweep_log {
  print -r -- "$(/bin/date '+%Y-%m-%dT%H:%M:%S%z') $*"
}

function _sweep_q {
  # Quote $1 so a newline or control character in a name stays on one log line.
  # shellcheck disable=SC2296
  print -rn -- "${(q+)1}"
}

function _sweep_uid_of {
  # Owner uid of $1; a seam so the tests can substitute another owner.
  /usr/bin/stat -f %u "$1" 2>/dev/null
}

function _sweep_pre_delete {
  # Seam, once per entry between the first scan and the re-scan; the tests
  # redefine it to make an entry busy at that instant.
  return 0
}

function _sweep_check_root {
  # Validate $1: 0 usable (SWEEP_PHYS set to its physical path), 3 valid but
  # absent, 2 refused.
  local root="$1" reason='' owner=''
  SWEEP_PHYS=''
  while [[ "${root}" == */ && "${root}" != / ]]; do
    root="${root%/}"
  done
  if [[ "${root}" != /* ]]; then
    reason='not an absolute path'
  elif [[ "${root:t}" != claude-tmp || "${root:h:t}" != Caches ]]; then
    reason='not a Caches/claude-tmp directory'
  elif [[ "${root}/" == */../* || "${root}/" == */./* ]]; then
    reason='contains a . or .. component'
  elif [[ -L "${root}" ]]; then
    reason='is a symlink'
  elif [[ ! -e "${root}" ]]; then
    return 3
  elif [[ ! -d "${root}" ]]; then
    reason='is not a directory'
  else
    owner="$(_sweep_uid_of "${root}")"
    if [[ "${owner}" != "${UID}" ]]; then
      reason='is not owned by the current user'
    fi
  fi
  if [[ -n "${reason}" ]]; then
    print -u2 -r -- "scratch-sweep: refusing root $(_sweep_q "${root}"): ${reason}"
    return 2
  fi
  # Resolve the parent only: a final component turned symlink after the checks
  # must make the later cd -P land elsewhere and abort, not be followed here.
  SWEEP_PHYS="${root:h:A}/${root:t}"
  return 0
}

function _sweep_lock_stale {
  # True when the pid is gone or the lock is older than the stale limit.
  local lock="$1" holder='' fresh=''
  if [[ -r "${lock}/pid" ]]; then
    { holder="$(<"${lock}/pid")"; } 2>/dev/null
  fi
  # kill -0 also fails with EPERM: a dead owner's pid reused by another user's
  # process reads as gone, so the lock is replaced early (a harmless second
  # sweep).
  if [[ "${holder}" =~ ^[0-9]+$ ]] && ! kill -0 "${holder}" 2>/dev/null; then
    return 0
  fi
  fresh="$(/usr/bin/find -P "${lock}" -maxdepth 0 -mmin "-${SWEEP_LOCK_STALE_MIN}" -print 2>/dev/null)"
  [[ -z "${fresh}" ]]
}

function _sweep_lock {
  # Take ./.sweep.lock (cwd is the root): 0 taken, 1 a live sweep holds it (or
  # the path is not a directory), 2 neither takeable nor replaceable.
  local lock="./${SWEEP_LOCK_NAME}"
  if /bin/mkdir -- "${lock}" 2>/dev/null; then
    print -r -- "$$" > "${lock}/pid"
    return 0
  fi
  if [[ ! -e "${lock}" && ! -L "${lock}" ]]; then
    # mkdir failed and nothing is there: no permission to create it.
    return 2
  fi
  if [[ ! -d "${lock}" || -L "${lock}" ]]; then
    return 1
  fi
  if _sweep_lock_stale "${lock}"; then
    /bin/rm -f -- "${lock}/pid"
    /bin/rmdir -- "${lock}" 2>/dev/null
    if /bin/mkdir -- "${lock}" 2>/dev/null; then
      print -r -- "$$" > "${lock}/pid"
      return 0
    fi
    # Replacement failed: a live lock now is another sweep's (held); one still
    # stale could not be removed (stuck).
    if [[ -d "${lock}" && ! -L "${lock}" ]] && _sweep_lock_stale "${lock}"; then
      return 2
    fi
  fi
  return 1
}

function _sweep_unlock {
  /bin/rm -f -- "./${SWEEP_LOCK_NAME}/pid"
  /bin/rmdir -- "./${SWEEP_LOCK_NAME}" 2>/dev/null
  return 0
}

function _sweep_list_names {
  # Fill SWEEP_NAMES with the root's top-level names, dotfiles included,
  # symlinks unresolved. The lock and claude-<digits> are not entries; the
  # latter is counted.
  local name=''
  local -a found
  SWEEP_NAMES=()
  found=(*(DN))
  for name in "${found[@]}"; do
    if [[ "${name}" == "${SWEEP_LOCK_NAME}" ]]; then
      continue
    fi
    if [[ "${name}" =~ ${SWEEP_EXEMPT_RE} ]]; then
      (( SWEEP_EXEMPT += 1 ))
      continue
    fi
    SWEEP_NAMES+=("${name}")
  done
  return 0
}

function _sweep_recent {
  # 0 when anything in ./$1 (itself included, symlinks not followed) is newer
  # than the idle limit, 1 when nothing is, 2 when the scan failed and found
  # nothing.
  local recent=''
  local -i scan_rc=0
  recent="$(/usr/bin/find -P "./$1" -mtime "-${SWEEP_IDLE_SECONDS}s" -print -quit 2>/dev/null)"
  scan_rc=$?
  if [[ -n "${recent}" ]]; then
    return 0
  fi
  if (( scan_rc != 0 )); then
    return 2
  fi
  return 1
}

function _sweep_entry {
  # Consider ./$1; $2 is 1 for a dry run.
  local name="$1" dry="$2"
  local -i scan_rc=0
  if [[ -z "${name}" || "${name}" == . || "${name}" == .. || "${name}" == */* ]]; then
    _sweep_log "skipped $(_sweep_q "${name}"): unexpected entry name"
    (( SWEEP_SKIPPED += 1 ))
    return 0
  fi
  if [[ ! -e "./${name}" && ! -L "./${name}" ]]; then
    return 0
  fi

  _sweep_recent "${name}"
  scan_rc=$?
  if (( scan_rc == 0 )); then
    (( SWEEP_KEPT += 1 ))
    return 0
  fi
  if (( scan_rc == 2 )); then
    _sweep_log "failed to scan $(_sweep_q "${name}"): kept"
    (( SWEEP_FAILED += 1 ))
    return 1
  fi

  if (( dry )); then
    _sweep_log "would remove $(_sweep_q "${name}")"
    (( SWEEP_REMOVED += 1 ))
    return 0
  fi

  _sweep_pre_delete "${name}"
  _sweep_recent "${name}"
  scan_rc=$?
  if (( scan_rc == 0 )); then
    _sweep_log "kept $(_sweep_q "${name}"): became active during the sweep"
    (( SWEEP_KEPT += 1 ))
    return 0
  fi
  if (( scan_rc == 2 )); then
    _sweep_log "failed to scan $(_sweep_q "${name}"): kept"
    (( SWEEP_FAILED += 1 ))
    return 1
  fi

  if [[ -L "./${name}" ]]; then
    /bin/rm -f -- "./${name}" 2>/dev/null
  else
    /bin/rm -rf -- "./${name}" 2>/dev/null
  fi
  if [[ -e "./${name}" || -L "./${name}" ]]; then
    _sweep_log "failed to remove $(_sweep_q "${name}")"
    (( SWEEP_FAILED += 1 ))
    return 1
  fi
  _sweep_log "removed $(_sweep_q "${name}")"
  (( SWEEP_REMOVED += 1 ))
  return 0
}

function _sweep_process {
  # Sweep every entry ($1 is 1 for a dry run); 1 when any entry failed.
  local name=''
  local -i rc=0
  _sweep_list_names
  for name in "${SWEEP_NAMES[@]}"; do
    if ! _sweep_entry "${name}" "$1"; then
      rc=1
    fi
    if (( ! $1 )); then
      /usr/bin/touch -- "./${SWEEP_LOCK_NAME}" 2>/dev/null
    fi
  done
  _sweep_log "summary: removed=${SWEEP_REMOVED} kept=${SWEEP_KEPT} exempt=${SWEEP_EXEMPT} skipped=${SWEEP_SKIPPED} failed=${SWEEP_FAILED} dry_run=$1"
  return "${rc}"
}

function _sweep_leave {
  # Return to the caller's directory $1, best effort: if it is gone there is
  # nothing to restore.
  builtin cd -- "$1" 2>/dev/null || return 0
}

function _sweep_enter {
  # cd into physical root $1 and prove it is the validated directory. On any
  # failure return 1 with the cwd restored, so no relative delete runs
  # elsewhere.
  local phys="$1" here="${PWD}"
  if ! builtin cd -P -- "${phys}" 2>/dev/null; then
    print -u2 -r -- "scratch-sweep: refusing root $(_sweep_q "${phys}"): cannot enter it"
    return 1
  fi
  if [[ "${PWD}" != "${phys}" || "$(_sweep_uid_of .)" != "${UID}" ]]; then
    print -u2 -r -- "scratch-sweep: refusing root $(_sweep_q "${phys}"): changed while opening"
    _sweep_leave "${here}"
    return 1
  fi
  return 0
}

function _sweep_root_dir {
  # Sweep root $1; $2 is --dry-run or empty. The tests call it with a fixture
  # root, main with the hardcoded one.
  local root="$1" mode="${2:-}" here="${PWD}"
  local -i dry=0 rc=0 check_rc=0 lock_rc=0
  if [[ "${mode}" == --dry-run ]]; then dry=1; fi
  SWEEP_REMOVED=0; SWEEP_KEPT=0; SWEEP_SKIPPED=0; SWEEP_FAILED=0; SWEEP_EXEMPT=0

  _sweep_check_root "${root}"
  check_rc=$?
  if (( check_rc == 3 )); then
    _sweep_log "nothing to do: root does not exist"
    return 0
  fi
  if (( check_rc != 0 )); then
    return 2
  fi
  if ! _sweep_enter "${SWEEP_PHYS}"; then
    return 2
  fi

  if (( dry )); then
    _sweep_process "${dry}"
    rc=$?
    _sweep_leave "${here}"
    return "${rc}"
  fi
  _sweep_lock
  lock_rc=$?
  if (( lock_rc == 2 )); then
    _sweep_log "cannot take the lock: nothing done"
    _sweep_leave "${here}"
    return 1
  fi
  if (( lock_rc != 0 )); then
    if [[ -L "./${SWEEP_LOCK_NAME}" || ( -e "./${SWEEP_LOCK_NAME}" && ! -d "./${SWEEP_LOCK_NAME}" ) ]]; then
      _sweep_log "lock path is not a directory: nothing done"
      rc=1
    else
      _sweep_log "another sweep holds the lock: nothing done"
      rc=0
    fi
    _sweep_leave "${here}"
    return "${rc}"
  fi
  _sweep_process "${dry}"
  rc=$?
  _sweep_unlock
  _sweep_leave "${here}"
  return "${rc}"
}

function main {
  local arg='' mode=''
  for arg in "$@"; do
    case "${arg}" in
      --dry-run) mode=--dry-run ;;
      *)
        print -u2 -r -- "usage: scratch-sweep [--dry-run]"
        return 2
        ;;
    esac
  done
  if [[ -z "${HOME:-}" || "${HOME}" != /* ]]; then
    print -u2 -r -- "scratch-sweep: HOME is unset or not absolute"
    return 2
  fi
  _sweep_root_dir "${HOME}/Library/Caches/claude-tmp" "${mode}"
}

# Sourced by the tests: define the functions, run nothing.
if [[ "${ZSH_EVAL_CONTEXT}" == toplevel ]]; then
  main "$@"
  exit $?
fi
