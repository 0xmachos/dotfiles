#!/usr/bin/env zsh
# dotfiles/bin/jump-system
#
# System-level updater for macOS, LaTeX (tlmgr) and XProtect. Runs as root from
# LaunchDaemon com.0xmachos.jump-system; can also be run manually with sudo.

set -uo pipefail

# Root logs only to /var/log, a root-owned directory. In a user-writable one
# (~/Library/Logs) the final path component is attacker-controlled and
# touch/chown/append follow symlinks, so a planted symlink would turn root's
# chown into a user-to-root escalation; a check-then-write guard races.
# jump-user keeps its own ~/Library/Logs/jump.log; both write syslog under tag
# com.0xmachos.jump, which correlates them:
#   log show --predicate 'eventMessage CONTAINS "com.0xmachos.jump"'
# Not readonly: tests source this script and point LOG_FILE at a temp file, as
# bin/jump-user does.
LOG_FILE="/var/log/jump.log"

function run_and_log {
  local description="$1"
  shift
  local output rc
  if output=$("$@" 2>&1); then
    rc=0
    logger -t "com.0xmachos.jump" "[OK] ${description}"
  else
    rc=$?
    logger -t "com.0xmachos.jump" "[FAIL] ${description}"
    # No errexit, so a failed redirect is silent and its status never reaches
    # rc. Report an unwritable LOG_FILE to syslog, the sink that cannot fail,
    # or every failure detail is lost while syslog still shows [FAIL].
    if ! {
      echo "[$(date '+%Y-%m-%d %H:%M:%S')] [FAIL] ${description}"
      echo "${output}"
      echo ""
    } >> "${LOG_FILE}" 2>/dev/null; then
      logger -t "com.0xmachos.jump" "[FAIL] cannot write ${LOG_FILE} — detail for '${description}' lost"
    fi
  fi
  return "${rc}"
}

function check_internet_connection {
  local -a domains=("captive.apple.com" "google.com" "flightywifi.com")
  local domain reachability

  # Optional $1 is a test fixture command; main passes none, so launchd always
  # runs /usr/sbin/scutil.
  for domain in "${domains[@]}"; do
    if reachability=$("${1:-/usr/sbin/scutil}" -r "${domain}") \
        && [[ $'\n'"${reachability}" == *$'\n'Reachable* ]]; then
      return 0
    fi
  done

  logger -t "com.0xmachos.jump" "[FAIL] jump-system: not connected to the internet"
  return 1
}

function main {
  if ! check_internet_connection; then
    return 1
  fi

  local -r SWUPDATE_BINARY="/usr/sbin/softwareupdate"
  local -r TLMGR_BINARY="/Library/TeX/texbin/tlmgr"
  local -r XPROTECT_BINARY="/usr/bin/xprotect"
  local -r XPROTECT_APP="/Library/Apple/System/Library/CoreServices/XProtect.app/Contents/MacOS/XProtect"

  # Accumulate step failures: otherwise main exits with only the LAST step's
  # status and masks an earlier failure.
  local rc=0

  ## macOS ##
  if [[ -x "${SWUPDATE_BINARY}" ]]; then
    run_and_log "softwareupdate" "${SWUPDATE_BINARY}" --install --all --include-config-data --no-restart || rc=1
  fi

  ## LaTeX ##
  # GPG repo verification off: gnupg not installed; SHA-512 checksums and HTTPS
  # still protect package integrity.
  if [[ -x "${TLMGR_BINARY}" ]]; then
    run_and_log "tlmgr update --self" "${TLMGR_BINARY}" --verify-repo=none update --self || rc=1
    run_and_log "tlmgr update --all"  "${TLMGR_BINARY}" --verify-repo=none update --all || rc=1
  fi

  ## XProtect ##
  if [[ -x "${XPROTECT_BINARY}" ]]; then
    run_and_log "xprotect update" "${XPROTECT_BINARY}" update --prerelease || rc=1
  fi

  if [[ -x "${XPROTECT_APP}" ]]; then
    run_and_log "XProtect scan" "${XPROTECT_APP}" || rc=1
  fi

  return "${rc}"
}

main "$@"
