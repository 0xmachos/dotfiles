#!/usr/bin/env zsh
# dotfiles/bin/jump-system
#
# jump-system
#   System-level update script (runs as root via LaunchDaemon)
#   Updates: macOS, LaTeX (tlmgr), XProtect
#   Designed to be run by LaunchDaemon com.0xmachos.jump-system
#   Can also be run manually with sudo

set -uo pipefail

# Root logs only to /var/log, a root-owned directory.
#
# Earlier revisions pointed this at the console user's ~/Library/Logs/jump.log
# so both drivers shared one file. That directory is user-writable, so the
# final path component is attacker-controlled, and touch/chown/append all
# follow symlinks: a symlink planted there redirected root's chown onto any
# file on disk — a user-to-root escalation. No check-then-write guard fixes
# that safely (it races), so root simply never touches a user-writable path.
#
# jump-user keeps its own ~/Library/Logs/jump.log. The two are correlated
# through syslog, which both drivers already write via the com.0xmachos.jump
# tag: log show --predicate 'eventMessage CONTAINS "com.0xmachos.jump"'
# Not readonly: tests source this script and redirect LOG_FILE to a temp file,
# and bin/jump-user declares its own the same way.
LOG_FILE="/var/log/jump.log"

function run_and_log {
  local description="$1"
  shift
  local output rc
  if output=$("$@" 2>&1); then
    rc=0
    logger -t "com.0xmachos.jump" "[OK] ${description}"
  else
    rc=$?
    logger -t "com.0xmachos.jump" "[FAIL] ${description}"
    # A failed redirect is silent here: there is no errexit, and the redirect's
    # status does not reach rc. An unwritable LOG_FILE would discard every
    # failure detail while syslog still showed [FAIL], so report the write
    # failure itself to the sink that cannot fail.
    if ! {
      echo "[$(date '+%Y-%m-%d %H:%M:%S')] [FAIL] ${description}"
      echo "${output}"
      echo ""
    } >> "${LOG_FILE}" 2>/dev/null; then
      logger -t "com.0xmachos.jump" "[FAIL] cannot write ${LOG_FILE} — detail for '${description}' lost"
    fi
  fi
  return "${rc}"
}

function check_internet_connection {
  local -a domains=("captive.apple.com" "google.com" "flightywifi.com")
  local all_domains_not_reachable=true

  for domain in "${domains[@]}"; do
    if /usr/sbin/scutil -r "${domain}" | grep '^Reachable' >/dev/null; then
      all_domains_not_reachable=false
    fi
  done

  if [[ "${all_domains_not_reachable}" = "true" ]]; then
    logger -t "com.0xmachos.jump" "[FAIL] jump-system: not connected to the internet"
    return 1
  fi
}

function main {
  if ! check_internet_connection; then
    return 1
  fi

  local -r SWUPDATE_BINARY="/usr/sbin/softwareupdate"
  local -r TLMGR_BINARY="/Library/TeX/texbin/tlmgr"
  local -r XPROTECT_BINARY="/usr/bin/xprotect"
  local -r XPROTECT_APP="/Library/Apple/System/Library/CoreServices/XProtect.app/Contents/MacOS/XProtect"

  # Accumulate step failures — main runs steps sequentially, so without this it
  # would exit with only the LAST step's status and mask an earlier failure.
  local rc=0

  ## macOS ##
  if [[ -x "${SWUPDATE_BINARY}" ]]; then
    run_and_log "softwareupdate" "${SWUPDATE_BINARY}" --install --all --include-config-data --no-restart || rc=1
  fi

  ## LaTeX ##
  # GPG repo verification disabled: gnupg not installed, SHA-512 checksums
  # and HTTPS transport still protect package integrity. See TODOs.md.
  if [[ -x "${TLMGR_BINARY}" ]]; then
    run_and_log "tlmgr update --self" "${TLMGR_BINARY}" --verify-repo=none update --self || rc=1
    run_and_log "tlmgr update --all"  "${TLMGR_BINARY}" --verify-repo=none update --all || rc=1
  fi

  ## XProtect ##
  if [[ -x "${XPROTECT_BINARY}" ]]; then
    run_and_log "xprotect update" "${XPROTECT_BINARY}" update --prerelease || rc=1
  fi

  if [[ -x "${XPROTECT_APP}" ]]; then
    run_and_log "XProtect scan" "${XPROTECT_APP}" || rc=1
  fi

  return "${rc}"
}

main "$@"
